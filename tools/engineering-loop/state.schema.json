{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chinese Study Hub persistent execution checkpoint v1",
  "type": "object",
  "required": ["schemaVersion", "runId", "taskId", "mode", "phase", "sourceRevision", "repairs", "nonce", "events", "consumedComments", "writerPid", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string" },
    "taskId": { "type": "string", "pattern": "^(T[0-9]{3}|D001)$" },
    "mode": { "enum": ["live", "dry-github", "dry-local", "local-simulation"] },
    "phase": { "enum": ["QUEUED", "HANDOFF_CREATING", "SOURCE_WAIT", "DEVELOP_READY", "DEVELOPING", "PUBLISHING", "REVIEW_WAIT", "REPAIR_READY", "MERGE_WAIT", "SSOT_WAIT", "CACHE_SYNCING", "DONE", "BLOCKED"] },
    "repairs": { "type": "integer", "minimum": 0, "maximum": 2 },
    "sourceRevision": { "type": "string" },
    "nonce": { "type": "string" },
    "writerPid": { "type": ["integer", "null"] },
    "reviewerPid": { "type": ["integer", "null"] },
    "commitSha": { "type": ["string", "null"] },
    "branch": { "type": ["string", "null"] },
    "issue": { "type": ["integer", "null"] },
    "pr": { "type": ["integer", "null"] },
    "evidence": { "type": "array" },
    "events": { "type": "array" },
    "consumedComments": { "type": "array", "items": { "type": "integer" } },
    "createdAt": { "type": "string" },
    "updatedAt": { "type": "string" }
  }
}
