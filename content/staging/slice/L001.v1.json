  "blocks": [
    {
      "id": "l001-draft-v1-b1",
      "type": "teaching",
      "title": "Chào một người mới",
      "text": "你好 là một lời chào. Đọc riêng dạng từ điển nǐ hǎo; cách thể hiện hai thanh 3 trong lời nói phải học cùng mẫu âm được duyệt. Bản nháp này chưa chấm phát âm.",
      "hanzi": "你好",
      "pinyin": "nǐ hǎo",
      "meaning": "Xin chào.",
      "readingMinutes": 2
    },
    {
      "id": "l001-draft-v1-e1-block",
      "type": "exercise",
      "exerciseVersionId": "l001-draft-v1-e1"
    },
    {
      "id": "l001-draft-v1-b3",
      "type": "teaching",
      "title": "Nói tên của mình",
      "text": "Mẫu mới: 我叫 + tên. 我 là tôi, 叫 dùng để nói mình được gọi bằng tên gì. Trong ví dụ 我叫安, 安 là tên riêng minh họa bổ trợ, chưa xác minh là mục từ HSK1 và không tính vào coverage.",
      "hanzi": "我叫安。",
      "pinyin": "wǒ jiào Ān",
      "meaning": "Tôi tên là An.",
      "readingMinutes": 2
    },
    {
      "id": "l001-draft-v1-e2-block",
      "type": "exercise",
      "exerciseVersionId": "l001-draft-v1-e2"
    },
    {
      "id": "l001-draft-v1-b5",
      "type": "teaching",
      "title": "Đoạn hội thoại tự viết",
      "text": "A: 你好！我叫安。你呢？ B: 你好！我叫安。 你呢？ là một cách hỏi lại ngắn trong ngữ cảnh đang giới thiệu. Hai người trong ví dụ cùng tên chỉ để tránh thêm mục từ; khi tự luyện, thay bằng tên mình. Không coi câu mẫu là đề thi chính thức.",
      "hanzi": "你呢？",
      "pinyin": "nǐ ne",
      "meaning": "Còn bạn thì sao?",
      "readingMinutes": 2
    }
  ],
