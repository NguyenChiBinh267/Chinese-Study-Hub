  "blocks": [
    {
      "id": "l002-draft-v1-b1",
      "type": "teaching",
      "title": "Một mẫu nói về điều mình thích",
      "text": "我喜欢茶 có nghĩa tôi thích trà. Dùng 喜欢 để nói điều mình thích; đây là mẫu chính của bài. Mục 喜欢 và 茶 có locator HSK1; diễn giải ngữ pháp tiếng Việt và đáp án vẫn chưa được người có năng lực duyệt.",
      "hanzi": "我喜欢茶。",
      "pinyin": "wǒ xǐ huan chá",
      "meaning": "Tôi thích trà.",
      "readingMinutes": 2
    },
    {
      "id": "l002-draft-v1-e1-block",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v1-e1"
    },
    {
      "id": "l002-draft-v1-b3",
      "type": "teaching",
      "title": "Thêm việc làm và hỏi lại",
      "text": "我喜欢喝茶 diễn tả thích việc uống trà. 喝 nghĩa là uống. Cụm 你呢？ đã gặp ở L001 dùng để hỏi lại trong ngữ cảnh này; không coi nó là một câu hỏi tự đủ trong mọi tình huống.",
      "hanzi": "我喜欢喝茶。你呢？",
      "pinyin": "wǒ xǐ huan hē chá. nǐ ne",
      "meaning": "Tôi thích uống trà. Còn bạn?",
      "readingMinutes": 2
    },
    {
      "id": "l002-draft-v1-e2-block",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v1-e2"
