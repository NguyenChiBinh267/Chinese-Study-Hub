  "blocks": [
    {
      "id": "f02-draft-v1-b1",
      "type": "teaching",
      "title": "Cùng chữ cái, khác thanh",
      "text": "Pinyin không chỉ có phần chữ. mā, má, mǎ, mà có cùng m + a nhưng thanh khác nhau và có thể chỉ những từ khác nghĩa. Bài này kiểm tra ký hiệu viết; chưa có audio tham chiếu để kiểm tra nghe hoặc phát âm.",
      "hanzi": "妈 麻 马 骂",
      "pinyin": "mā má mǎ mà",
      "meaning": "mẹ · cây gai · ngựa · mắng",
      "readingMinutes": 2
    },
    {
      "id": "f02-draft-v1-b2",
      "type": "teaching",
      "title": "Bốn dấu thanh cơ bản",
      "text": "Thanh 1 dùng dấu ngang ā; thanh 2 dùng dấu sắc á; thanh 3 dùng dấu ǎ; thanh 4 dùng dấu huyền à. Số tương ứng là 1, 2, 3, 4. Đây là ký hiệu pinyin, không bảo đảm phát âm giống các dấu tiếng Việt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "f02-draft-v1-e1-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e1"
    },
    {
      "id": "f02-draft-v1-e2-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e2"
    },
    {
      "id": "f02-draft-v1-e3-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e3"
    },
    {
      "id": "f02-draft-v1-e4-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e4"
    },
    {
      "id": "f02-draft-v1-b7",
      "type": "teaching",
      "title": "Thanh nhẹ không phải thanh đầy đủ thứ năm",
      "text": "Trong ví dụ 吗 ma, âm tiết không mang dấu thanh từ điển và được đọc thanh nhẹ trong cách dùng này. Ô nhập nhận ma, ma0 hoặc ma5; 0/5 là quy ước ghi thanh nhẹ ở đây. Không gán một đường nét cố định thứ năm như bốn thanh đầy đủ.",
      "hanzi": "吗",
      "pinyin": "ma",
      "meaning": "trợ từ nghi vấn",
      "readingMinutes": 2
    },
    {
      "id": "f02-draft-v1-e5-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e5"
    },
    {
      "id": "f02-draft-v1-b9",
      "type": "teaching",
      "title": "Đặt dấu ở đâu?",
      "text": "Trong âm tiết có a hoặc e thì dấu đặt ở a hoặc e. Với ou, đặt ở o; khi không có các trường hợp đó thì đặt trên nguyên âm cuối. Ví dụ hǎo đặt ở a, liú đặt ở u, guì đặt ở i. Với ü phải giữ hai chấm; thanh 3 của nü được viết nǚ. Các ví dụ đặt dấu là minh họa ký hiệu bổ trợ, không thêm mục từ HSK.",
      "hanzi": "女",
      "pinyin": "nǚ",
      "meaning": "nữ",
      "readingMinutes": 2
    },
    {
      "id": "f02-draft-v1-e6-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e6"
    },
    {
      "id": "f02-draft-v1-b11",
      "type": "teaching",
      "title": "Thanh từ điển và lời nói",
      "text": "Pinyin trên thẻ ghi dạng từ điển. Trong câu, thanh có thể biến đổi theo ngữ cảnh; chẳng hạn chuỗi thanh 3 có quy tắc biến điệu. Ta chưa chấm biến điệu, độ chuẩn hay phát âm từ bài chữ. Khi chưa có audio được duyệt, nghe/phát âm vẫn là CHƯA ĐÁNH GIÁ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "f02-draft-v1-e7-block",
      "type": "exercise",
      "exerciseVersionId": "f02-draft-v1-e7"
    },
