  "blocks": [
    {
      "id": "l002-draft-v2-b1",
      "type": "teaching",
      "title": "Nói về điều mình thích",
      "text": "Hội thoại ngắn gốc dùng những từ đã đối chiếu ở HSK1. A nói thích trà và hỏi lại; B nói thích uống trà. Nghĩa tiếng Việt và cách dạy ngữ pháp vẫn chờ người có năng lực duyệt.",
      "hanzi": "A：我喜欢茶。你呢？\nB：我喜欢喝茶。",
      "pinyin": "A: wǒ xǐ huan chá. nǐ ne?\nB: wǒ xǐ huan hē chá.",
      "meaning": "A: Tôi thích trà. Còn bạn?\nB: Tôi thích uống trà.",
      "readingMinutes": 2
    },
    {
      "id": "l002-draft-v2-b2",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v2-e1"
    },
    {
      "id": "l002-draft-v2-b3",
      "type": "teaching",
      "title": "Mẫu người + 喜欢 + điều mình thích",
      "text": "Mẫu chính là 我喜欢…; phía sau có thể là 茶 trong câu đã học. Ở ví dụ tiếp theo, 喝茶 là cụm chỉ việc uống trà. Hai ví dụ đều thuộc cùng mẫu về sở thích; chưa chấm cách diễn đạt tự do.",
      "hanzi": "我喜欢茶。\n我喜欢喝茶。",
      "pinyin": "wǒ xǐ huan chá.\nwǒ xǐ huan hē chá.",
      "meaning": "Tôi thích trà.\nTôi thích uống trà.",
      "readingMinutes": 2
    },
    {
      "id": "l002-draft-v2-b4",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v2-e2"
    },
    {
      "id": "l002-draft-v2-b5",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v2-e3"
    },
    {
      "id": "l002-draft-v2-b6",
      "type": "exercise",
      "exerciseVersionId": "l002-draft-v2-e4"
    },
    {
      "id": "l002-draft-v2-b7",
      "type": "teaching",
      "title": "Giữ ngữ cảnh khi hỏi lại",
      "text": "你呢？ đã gặp ở L001. Trong cuộc trò chuyện về sở thích, nó mời người kia nói sở thích của họ. Không tự suy ra người kia cũng thích trà nếu họ chưa trả lời.",
      "hanzi": "我喜欢茶。你呢？",
      "pinyin": "wǒ xǐ huan chá. nǐ ne?",
      "meaning": "Tôi thích trà. Còn bạn?",
      "readingMinutes": 2
    },
    {
