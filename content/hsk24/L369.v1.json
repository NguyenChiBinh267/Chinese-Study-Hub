  "blocks": [
    {
      "id": "l369-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 课本 kèběn: sách giáo khoa; 故意 gùyì: cố ý; 范围 fànwéi: phạm vi. Không suy ra thói quen cả năm từ một tuần.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l369-t0",
      "type": "teaching",
      "title": "校园 · khuôn viên trường",
      "text": "校园 là khu vực trường, không phải một lớp hoặc phòng riêng. 校园里 thường nêu vị trí trong khuôn viên.",
      "hanzi": "校园里有很多树。",
      "pinyin": "Xiàoyuán lǐ yǒu hěn duō shù.",
      "meaning": "Trong khuôn viên có nhiều cây.",
      "readingMinutes": 1
    },
    {
      "id": "l369-t1",
      "type": "teaching",
      "title": "校长 · hiệu trưởng",
      "text": "校长 là người đứng đầu trường theo bài, 长 đọc zhǎng không phải cháng. Không tự là giáo viên môn đang học.",
      "hanzi": "校长今天跟学生见面。",
      "pinyin": "Xiàozhǎng jīntiān gēn xuésheng jiàn miàn.",
      "meaning": "Hôm nay hiệu trưởng gặp học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l369-t2",
      "type": "teaching",
      "title": "节 · tiết; lượng từ tiết học",
      "text": "节 trong 一节课 đếm tiết học, khác 节日 ngày lễ. Không dùng 页 đếm tiết.",
      "hanzi": "上午有三节课。",
      "pinyin": "Shàngwǔ yǒu sān jié kè.",
      "meaning": "Buổi sáng có ba tiết.",
      "readingMinutes": 1
    },
    {
      "id": "l369-t3",
      "type": "teaching",
      "title": "忘记 · quên",
      "text": "忘记 nói không nhớ việc/thông tin, 忘记带书 là quên mang. Chưa có bằng chứng quên nếu chỉ đoán không thấy đồ.",
      "hanzi": "我忘记带课本了。",
      "pinyin": "Wǒ wàngjì dài kèběn le.",
      "meaning": "Tôi quên mang sách giáo khoa.",
      "readingMinutes": 1
    },
    {
      "id": "l369-t4",
      "type": "teaching",
      "title": "迟到 · đến muộn",
      "text": "迟到 là đến sau giờ quy định; không dùng 晚点 trong mọi ngữ cảnh học sinh. 迟到了未必故意不认真.",
      "hanzi": "他今天上课迟到了。",
      "pinyin": "Tā jīntiān shàng kè chídào le.",
      "meaning": "Hôm nay cậu ấy đến lớp muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l369-t5",
      "type": "teaching",
      "title": "注意 · chú ý",
      "text": "注意 có thể nhận đối tượng như 时间、通知; không phải chỉ nhìn mà chắc đã hiểu. 注意到 thường nói nhận ra.",
      "hanzi": "请注意上课时间。",
      "pinyin": "Qǐng zhùyì shàng kè shíjiān.",
      "meaning": "Hãy chú ý giờ vào học.",
      "readingMinutes": 1
    },
    {
      "id": "l369-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一节课也没迟到 nhấn mạnh không đến muộn buổi nào trong phạm vi kể. Không suy ra cả năm không muộn chỉ từ tuần này; 没 phủ định sự kiện quá khứ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l369-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "校长在校园里跟学生见面，请大家注意上课时间。小林这周一节课也没迟到，但今天忘记带课本。他借同学的书看，没有把忘记带书说成没有上课。",
      "pinyin": "Xiàozhǎng zài xiàoyuán lǐ gēn xuésheng jiàn miàn, qǐng dàjiā zhùyì shàng kè shíjiān. Xiǎo Lín zhè zhōu yì jié kè yě méi chídào, dàn jīntiān wàngjì dài kèběn. Tā jiè tóngxué de shū kàn, méiyǒu bǎ wàngjì dài shū shuō chéng méiyǒu shàng kè.",
      "meaning": "Hiệu trưởng nhắc giờ học. Lâm tuần này không muộn tiết nào nhưng hôm nay quên sách và mượn bạn; quên sách không có nghĩa nghỉ học.",
      "readingMinutes": 2
    },
    {
