  "blocks": [
    {
      "id": "l357-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 阅读 yuèdú: đọc hiểu; 投入 tóurù: công sức投入; 是否 shìfǒu: có hay không; 进步 jìnbù: tiến bộ. Nội dung không cấp mastery từ số phút học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l357-t0",
      "type": "teaching",
      "title": "数学 · toán học",
      "text": "数学 là môn toán, không đồng nghĩa mọi số liệu. 学数学说 học môn, 做数学题说 làm bài toán.",
      "hanzi": "我下午有数学课。",
      "pinyin": "Wǒ xiàwǔ yǒu shùxué kè.",
      "meaning": "Chiều tôi có giờ toán.",
      "readingMinutes": 1
    },
    {
      "id": "l357-t1",
      "type": "teaching",
      "title": "水平 · trình độ/mức độ",
      "text": "水平 là mức độ năng lực hoặc chất lượng theo tiêu chí; 很高 chỉ đánh giá, chưa có điểm đo nếu không đưa bằng chứng.",
      "hanzi": "我想了解自己的中文水平。",
      "pinyin": "Wǒ xiǎng liǎojiě zìjǐ de Zhōngwén shuǐpíng.",
      "meaning": "Tôi muốn tìm hiểu trình độ tiếng Trung của mình.",
      "readingMinutes": 1
    },
    {
      "id": "l357-t2",
      "type": "teaching",
      "title": "提高 · nâng cao",
      "text": "提高 là nâng mức lên, có thể là động từ có tân ngữ 提高水平. 想提高 không tự chứng minh đã tăng.",
      "hanzi": "我想提高阅读水平。",
      "pinyin": "Wǒ xiǎng tígāo yuèdú shuǐpíng.",
      "meaning": "Tôi muốn nâng trình độ đọc.",
      "readingMinutes": 1
    },
    {
      "id": "l357-t3",
      "type": "teaching",
      "title": "认真 · nghiêm túc/cẩn thận",
      "text": "认真 mô tả thái độ/cách làm; 认真地练习 và 学得认真 khác vị trí 地/得. Làm chăm không tự là làm đúng.",
      "hanzi": "她做题很认真。",
      "pinyin": "Tā zuò tí hěn rènzhēn.",
      "meaning": "Cô ấy làm bài rất cẩn thận.",
      "readingMinutes": 1
    },
    {
      "id": "l357-t4",
      "type": "teaching",
      "title": "练 · luyện/tập",
      "text": "练 là động từ tập kỹ năng như 练口语, khác 链 là mắt xích. 练了不等于独立掌握.",
      "hanzi": "我每天练十分钟。",
      "pinyin": "Wǒ měi tiān liàn shí fēnzhōng.",
      "meaning": "Tôi tập mười phút mỗi ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l357-t5",
      "type": "teaching",
      "title": "要求 · yêu cầu/đòi hỏi",
      "text": "要求 có thể danh từ tiêu chí hoặc động từ yêu cầu. 看清要求 trước làm để biết nhiệm vụ, chưa là đã đáp ứng.",
      "hanzi": "请先看清楚要求。",
      "pinyin": "Qǐng xiān kàn qīngchu yāoqiú.",
      "meaning": "Hãy đọc rõ yêu cầu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l357-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对我来说 nêu quan điểm/đối tượng đánh giá; 对我来说难 không phải mọi người đều thấy khó. 提高水平 cần bằng chứng trước/sau, không lấy câu nói muốn học làm thành tích.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l357-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "对小林来说，数学不太难，中文阅读却需要多练。他想提高水平，先认真看要求，再每天练十分钟。老师说：练习时间是投入，还要看新题做得怎样，才知道是否进步。",
      "pinyin": "Duì Xiǎo Lín lái shuō, shùxué bú tài nán, Zhōngwén yuèdú què xūyào duō liàn. Tā xiǎng tígāo shuǐpíng, xiān rènzhēn kàn yāoqiú, zài měi tiān liàn shí fēnzhōng. Lǎoshī shuō: Liànxí shíjiān shì tóurù, hái yào kàn xīn tí zuò de zěnyàng, cái zhīdào shìfǒu jìnbù.",
      "meaning": "Lâm thấy toán không khó lắm nhưng cần tập đọc tiếng Trung. Cậu dự định xem yêu cầu và luyện mười phút/ngày; thầy nhắc thời gian tập chưa tự chứng minh tiến bộ trên bài mới.",
      "readingMinutes": 2
    },
    {
