  "blocks": [
    {
      "id": "l470-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 申请 shēnqǐng: đăng ký/đề nghị; 代表 dàibiǎo: đại diện; 一笔 yì bǐ: lượng từ cho khoản tiền.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l470-t0",
      "type": "teaching",
      "title": "奖 · giải thưởng",
      "text": "奖 là danh từ giải hoặc động từ khen thưởng; bài dùng danh từ 得奖. Nhận diện chữ 奖 trong 奖; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她在比赛中得了奖。",
      "pinyin": "Tā zài bǐsài zhōng dé le jiǎng.",
      "meaning": "Cô đoạt giải trong cuộc thi.",
      "readingMinutes": 1
    },
    {
      "id": "l470-t1",
      "type": "teaching",
      "title": "奖金 · tiền thưởng",
      "text": "奖金 là tiền thưởng, khác 奖 còn có thể không phải tiền.",
      "hanzi": "奖金由小组共同使用。",
      "pinyin": "Jiǎngjīn yóu xiǎozǔ gòngtóng shǐyòng.",
      "meaning": "Tiền thưởng do nhóm sử dụng chung.",
      "readingMinutes": 1
    },
    {
      "id": "l470-t2",
      "type": "teaching",
      "title": "奖学金 · học bổng",
      "text": "奖学金 là khoản hỗ trợ/khen thưởng học tập theo điều kiện cụ thể; ví dụ hư cấu không bảo đảm ai đủ điều kiện thật.",
      "hanzi": "她获得了奖学金。",
      "pinyin": "Tā huòdé le jiǎngxuéjīn.",
      "meaning": "Cô nhận học bổng.",
      "readingMinutes": 1
    },
    {
      "id": "l470-t3",
      "type": "teaching",
      "title": "交 · nộp, giao",
      "text": "交 trong 交材料 là nộp/giao, khác 交流 là trao đổi hai chiều.",
      "hanzi": "请按时交材料。",
      "pinyin": "Qǐng ànshí jiāo cáiliào.",
      "meaning": "Hãy nộp hồ sơ đúng hạn.",
      "readingMinutes": 1
    },
    {
      "id": "l470-t4",
      "type": "teaching",
      "title": "叫作 · gọi là",
      "text": "叫作 đưa tên gọi của một thứ; không phải gọi ai đến làm việc.",
      "hanzi": "这项活动叫作读书周。",
      "pinyin": "Zhè xiàng huódòng jiàozuò dúshūzhōu.",
      "meaning": "Hoạt động này gọi là tuần đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l470-t5",
      "type": "teaching",
      "title": "举例 · nêu ví dụ",
      "text": "举例 là động từ, thường dùng 举例说明; khác 例子 là danh từ.",
      "hanzi": "老师举例说明申请方法。",
      "pinyin": "Lǎoshī jǔlì shuōmíng shēnqǐng fāngfǎ.",
      "meaning": "Thầy nêu ví dụ giải thích cách đăng ký.",
      "readingMinutes": 1
    },
    {
      "id": "l470-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "选 + người + 当/做 + vai trò nêu lựa chọn ai giữ vai trò: 同学们选小林当代表. Khác đơn thuần 选择一本书. Bài chỉ luyện 选……当……, chưa chấp nhận toàn bộ các biến thể trong hàng nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l470-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校办一项叫作“读书周”的活动。老师举例说明交材料的方法，也介绍一项虚构的奖学金。小林在阅读比赛中得奖，小组获得了一笔奖金。同学们选小林当代表，先记录大家的建议，再共同决定奖金怎么使用。",
      "pinyin": "Xuéxiào bàn yí xiàng jiàozuò “dúshūzhōu” de huódòng. Lǎoshī jǔlì shuōmíng jiāo cáiliào de fāngfǎ, yě jièshào yí xiàng xūgòu de jiǎngxuéjīn. Xiǎo Lín zài yuèdú bǐsài zhōng dé jiǎng, xiǎozǔ huòdé le yì bǐ jiǎngjīn. Tóngxuémen xuǎn Xiǎo Lín dāng dàibiǎo, xiān jìlù dàjiā de jiànyì, zài gòngtóng juédìng jiǎngjīn zěnme shǐyòng.",
      "meaning": "Tuần đọc sách có hướng dẫn nộp hồ sơ và ví dụ học bổng hư cấu. Lâm đoạt giải, nhóm có tiền thưởng. Nhóm chọn Lâm làm đại diện ghi góp ý rồi cùng quyết cách dùng tiền.",
      "readingMinutes": 2
    },
    {
