  "blocks": [
    {
      "id": "l439-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 通向 tōngxiàng: dẫn tới; 随便 suíbiàn: tùy tiện; 起飞 qǐfēi: cất cánh; 至少 zhìshǎo: ít nhất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l439-t0",
      "type": "teaching",
      "title": "电动车 · xe điện",
      "text": "电动车 trong bài là xe điện cá nhân; phải dựa quy định địa phương, không mặc định được lên cao tốc.",
      "hanzi": "他骑电动车去车站。",
      "pinyin": "Tā qí diàndòngchē qù chēzhàn.",
      "meaning": "Anh ấy đi xe điện tới ga.",
      "readingMinutes": 1
    },
    {
      "id": "l439-t1",
      "type": "teaching",
      "title": "公里 · kilômét",
      "text": "公里 là đơn vị chiều dài, một 公里 bằng một 千米; không phải đơn vị thời gian.",
      "hanzi": "机场离家三十公里。",
      "pinyin": "Jīchǎng lí jiā sānshí gōnglǐ.",
      "meaning": "Sân bay cách nhà ba mươi kilômét.",
      "readingMinutes": 1
    },
    {
      "id": "l439-t2",
      "type": "teaching",
      "title": "公路 · đường bộ",
      "text": "公路 là đường cho phương tiện đi lại, không phải đường ray tàu.",
      "hanzi": "这条公路通向机场。",
      "pinyin": "Zhè tiáo gōnglù tōngxiàng jīchǎng.",
      "meaning": "Đường này dẫn tới sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l439-t3",
      "type": "teaching",
      "title": "高速 · tốc độ cao; cao tốc",
      "text": "高速 là tính từ tốc độ cao trong 高速公路、高速列车; 上高速 trong đoạn là cách nói tắt đường cao tốc bổ sung.",
      "hanzi": "这是一条高速公路。",
      "pinyin": "Zhè shì yì tiáo gāosù gōnglù.",
      "meaning": "Đây là một tuyến đường cao tốc.",
      "readingMinutes": 1
    },
    {
      "id": "l439-t4",
      "type": "teaching",
      "title": "换乘 · đổi tuyến phương tiện",
      "text": "换乘 có đổi từ tuyến/phương tiện này sang tuyến khác; khác chỉ đổi chỗ ngồi.",
      "hanzi": "请在下一站换乘地铁。",
      "pinyin": "Qǐng zài xià yí zhàn huànchéng dìtiě.",
      "meaning": "Hãy đổi sang tàu điện ngầm ở ga sau.",
      "readingMinutes": 1
    },
    {
      "id": "l439-t5",
      "type": "teaching",
      "title": "航班 · chuyến bay",
      "text": "航班 là chuyến bay có lịch/số chuyến; không phải bản thân chiếc máy bay. Nhận diện chữ 航 trong 航班; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我的航班下午起飞。",
      "pinyin": "Wǒ de hángbān xiàwǔ qǐfēi.",
      "meaning": "Chuyến bay của tôi cất cánh chiều nay.",
      "readingMinutes": 1
    },
    {
      "id": "l439-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "至少 đặt trước số lượng thấp nhất: 至少要一个小时. Đó là cận dưới, không phải dự báo chính xác 一定一个小时. Dùng để giải thích vì sao phải chừa thời gian nối chuyến.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l439-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "机场离家三十公里。小陈先骑电动车到车站，再换乘机场大巴。司机说：“今天公路上车多，上高速前可能堵车，到机场至少要一个小时。”小陈的航班下午三点起飞，他上午就出门了。",
      "pinyin": "Jīchǎng lí jiā sānshí gōnglǐ. Xiǎo Chén xiān qí diàndòngchē dào chēzhàn, zài huànchéng jīchǎng dàbā. Sījī shuō: “Jīntiān gōnglù shàng chē duō, shàng gāosù qián kěnéng dǔchē, dào jīchǎng zhìshǎo yào yí ge xiǎoshí.” Xiǎo Chén de hángbān xiàwǔ sān diǎn qǐfēi, tā shàngwǔ jiù chūmén le.",
      "meaning": "Trần đi xe điện tới ga rồi đổi xe khách sân bay. Tài xế dự báo ít nhất một giờ vì đường đông. Bay lúc ba giờ chiều, Trần đã ra khỏi nhà buổi sáng.",
      "readingMinutes": 2
    },
    {
