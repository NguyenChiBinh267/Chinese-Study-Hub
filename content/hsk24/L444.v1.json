  "blocks": [
    {
      "id": "l444-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 类似 lèisì: tương tự; 沟通 gōutōng: trao đổi; 改正 gǎizhèng: sửa cho đúng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l444-t0",
      "type": "teaching",
      "title": "经历 · trải nghiệm, từng trải",
      "text": "经历 vừa là danh từ trải nghiệm vừa là động từ trải qua; bài hỏi danh từ 这次经历.",
      "hanzi": "这次经历让我学到了很多。",
      "pinyin": "Zhè cì jīnglì ràng wǒ xué dào le hěn duō.",
      "meaning": "Trải nghiệm này giúp tôi học nhiều điều.",
      "readingMinutes": 1
    },
    {
      "id": "l444-t1",
      "type": "teaching",
      "title": "经验 · kinh nghiệm",
      "text": "经验 là hiểu biết rút ra từ thực hành, khác 经历 là sự việc đã trải qua.",
      "hanzi": "他有丰富的工作经验。",
      "pinyin": "Tā yǒu fēngfù de gōngzuò jīngyàn.",
      "meaning": "Anh ấy có nhiều kinh nghiệm làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l444-t2",
      "type": "teaching",
      "title": "接受 · tiếp nhận, chấp nhận",
      "text": "接受 đi với 建议、帮助、邀请; nghe thấy lời góp ý chưa chắc đã 接受.",
      "hanzi": "她接受了同事的建议。",
      "pinyin": "Tā jiēshòu le tóngshì de jiànyì.",
      "meaning": "Cô ấy tiếp nhận góp ý của đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l444-t3",
      "type": "teaching",
      "title": "解释 · giải thích",
      "text": "解释 làm rõ nguyên nhân/nội dung; dùng 向别人解释 một việc. Nhận diện chữ 释 trong 解释; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请解释一下原因。",
      "pinyin": "Qǐng jiěshì yíxià yuányīn.",
      "meaning": "Hãy giải thích nguyên nhân.",
      "readingMinutes": 1
    },
    {
      "id": "l444-t4",
      "type": "teaching",
      "title": "今后 · từ nay về sau",
      "text": "今后 hướng tới tương lai tính từ hiện tại, không dùng cho một mốc quá khứ.",
      "hanzi": "今后我会及时说明情况。",
      "pinyin": "Jīnhòu wǒ huì jíshí shuōmíng qíngkuàng.",
      "meaning": "Từ nay tôi sẽ báo rõ tình hình kịp thời.",
      "readingMinutes": 1
    },
    {
      "id": "l444-t5",
      "type": "teaching",
      "title": "及时 · kịp thời",
      "text": "及时 nói làm đúng lúc trước khi quá muộn; khác 按时 là đúng giờ đã định.",
      "hanzi": "发现错误要及时改正。",
      "pinyin": "Fāxiàn cuòwù yào jíshí gǎizhèng.",
      "meaning": "Phát hiện lỗi cần sửa kịp thời.",
      "readingMinutes": 1
    },
    {
      "id": "l444-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "拿 + đối tượng + 来说 nêu một ví dụ để bàn luận: 拿这次经历来说，我学会了及时解释. Không phải hành động cầm vật trong cách dùng này. Đối tượng ví dụ phải liên quan ý phía sau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l444-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "同事问小李有什么工作经验。小李说：“拿这次经历来说，我开始没有及时解释材料的问题，大家等了很久。后来我接受了建议，先说明原因，再一起改正。今后遇到类似情况，我会早点儿沟通。”",
      "pinyin": "Tóngshì wèn Xiǎo Lǐ yǒu shénme gōngzuò jīngyàn. Xiǎo Lǐ shuō: “Ná zhè cì jīnglì lái shuō, wǒ kāishǐ méiyǒu jíshí jiěshì cáiliào de wèntí, dàjiā děng le hěn jiǔ. Hòulái wǒ jiēshòu le jiànyì, xiān shuōmíng yuányīn, zài yìqǐ gǎizhèng. Jīnhòu yùdào lèisì qíngkuàng, wǒ huì zǎo diǎnr gōutōng.”",
      "meaning": "Lý kể lần không giải thích vấn đề vật liệu kịp thời khiến cả nhóm chờ lâu. Sau góp ý, anh giải thích nguyên nhân và cùng sửa. Anh dự định trao đổi sớm hơn trong tương lai.",
      "readingMinutes": 2
    },
