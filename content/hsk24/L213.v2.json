  "blocks": [
    {
      "id": "l213-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "喜欢 là thích; 打 kết hợp với 篮球, 踢 kết hợp với 足球. Việc nhắc cách kết hợp này không tính 打 là mục từ mới của bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l213-t0",
      "type": "teaching",
      "title": "爱好 · sở thích",
      "text": "爱好 ở đây là danh từ trong 我的爱好. Không nhầm với 喜欢 khi điền câu 是我的爱好.",
      "hanzi": "打篮球是我的爱好。",
      "pinyin": "Dǎ lánqiú shì wǒ de àihào.",
      "meaning": "Chơi bóng rổ là sở thích của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l213-t1",
      "type": "teaching",
      "title": "篮球 · bóng rổ",
      "text": "打篮球 là chơi bóng rổ; không dùng 踢篮球 trong nghĩa môn thể thao đang học.",
      "hanzi": "他们下午打篮球。",
      "pinyin": "Tāmen xiàwǔ dǎ lánqiú.",
      "meaning": "Chiều họ chơi bóng rổ.",
      "readingMinutes": 1
    },
    {
      "id": "l213-t2",
      "type": "teaching",
      "title": "足球 · bóng đá",
      "text": "足球 dùng với 踢 khi nói chơi bóng đá. Không chỉ dựa vào chữ 球 để chọn cách kết hợp.",
      "hanzi": "我喜欢踢足球。",
      "pinyin": "Wǒ xǐhuan tī zúqiú.",
      "meaning": "Tôi thích chơi bóng đá.",
      "readingMinutes": 1
    },
    {
      "id": "l213-t3",
      "type": "teaching",
      "title": "踢 · đá bằng chân",
      "text": "踢 là hành động đá, ví dụ 踢球. Không phải mọi động tác chơi bóng đều dùng 踢.",
      "hanzi": "小王在踢球。",
      "pinyin": "Xiǎo Wáng zài tī qiú.",
      "meaning": "Tiểu Vương đang đá bóng.",
      "readingMinutes": 1
    },
    {
      "id": "l213-t4",
      "type": "teaching",
      "title": "跳舞 · nhảy múa, khiêu vũ",
      "text": "跳舞 nói nhảy theo hoạt động múa/nhạc, không phải mọi cú nhảy lên. 舞 đọc thanh ba.",
      "hanzi": "妹妹喜欢跳舞。",
      "pinyin": "Mèimei xǐhuan tiàowǔ.",
      "meaning": "Em gái thích nhảy múa.",
      "readingMinutes": 1
    },
    {
      "id": "l213-t5",
      "type": "teaching",
      "title": "快乐 · vui vẻ",
      "text": "快乐 dùng nói trạng thái vui hoặc lời chúc như 生日快乐. Không dùng 快乐 để nói tốc độ nhanh.",
      "hanzi": "生日快乐！",
      "pinyin": "Shēngrì kuàilè!",
      "meaning": "Chúc sinh nhật vui vẻ!",
      "readingMinutes": 1
    },
    {
      "id": "l213-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "跳舞 có phần động từ và danh từ; ở mẫu nhập môn này dùng cả từ 跳舞, không tự chèn 的 giữa chúng. Khi thêm thời lượng/cụm khác cần học mẫu tách riêng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l213-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的爱好是什么？乙：我喜欢踢足球，也喜欢跳舞。甲：星期天一起踢球吧。乙：好！我妹妹不踢球，她去跳舞。",
      "pinyin": "Jiǎ: Nǐ de àihào shì shénme? Yǐ: Wǒ xǐhuan tī zúqiú, yě xǐhuan tiàowǔ. Jiǎ: Xīngqītiān yìqǐ tī qiú ba. Yǐ: Hǎo! Wǒ mèimei bù tī qiú, tā qù tiàowǔ.",
      "meaning": "A: Sở thích của bạn là gì? B: Tôi thích đá bóng, cũng thích nhảy múa. A: Chủ nhật cùng đá bóng nhé. B: Được! Em gái tôi không đá bóng, em đi nhảy múa.",
      "readingMinutes": 2
    },
    {
