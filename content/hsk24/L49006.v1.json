  "blocks": [
    {
      "id": "l49006-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder0",
      "type": "teaching",
      "title": "暑假 · nghỉ hè",
      "text": "暑假 là kỳ nghỉ mùa hè, khác mọi ngày nghỉ. Nhận diện chữ 暑 trong 暑假; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "暑假我想回家。",
      "pinyin": "Shǔ jià wǒ xiǎng huí jiā.",
      "meaning": "Nghỉ hè tôi muốn về nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder1",
      "type": "teaching",
      "title": "听众 · người nghe; thính giả",
      "text": "听众 là người tiếp nhận chương trình/bài nói. Nhận diện chữ 众 trong 听众; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "听众给节目写了信。",
      "pinyin": "Tīng zhòng gěi jié mù xiě le xìn.",
      "meaning": "Thính giả viết thư cho chương trình.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder2",
      "type": "teaching",
      "title": "消息 · tin tức; tin nhắn",
      "text": "消息 là một tin được truyền tới; chưa chắc đã đúng.",
      "hanzi": "我收到了一条消息。",
      "pinyin": "Wǒ shōu dào le yì tiáo xiāo xi.",
      "meaning": "Tôi nhận một tin nhắn.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder3",
      "type": "teaching",
      "title": "转发 · chuyển tiếp; chia sẻ lại",
      "text": "转发 là gửi lại nội dung đã nhận, không xác nhận tính đúng.",
      "hanzi": "核对以后再转发。",
      "pinyin": "Hé duì yǐ hòu zài zhuǎn fā.",
      "meaning": "Đối chiếu xong rồi hãy chuyển tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder4",
      "type": "teaching",
      "title": "兴奋 · phấn khởi; hào hứng",
      "text": "兴奋 nói cảm xúc kích động vui mừng trong ngữ cảnh. Nhận diện chữ 奋 trong 兴奋; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "听到好消息，他很兴奋。",
      "pinyin": "Tīng dào hǎo xiāo xi, tā hěn xīng fèn.",
      "meaning": "Nghe tin vui anh ấy rất phấn khởi.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder5",
      "type": "teaching",
      "title": "醒 · tỉnh; thức giấc",
      "text": "醒 đối lập trạng thái ngủ, không phải chỉ rời giường.",
      "hanzi": "我今天醒得很早。",
      "pinyin": "Wǒ jīn tiān xǐng de hěn zǎo.",
      "meaning": "Hôm nay tôi tỉnh giấc rất sớm.",
      "readingMinutes": 1
    },
    {
      "id": "l49006-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 nêu điều đã biết/được chấp nhận, 就 dẫn kết luận hoặc đề nghị. Khác 如果 đặt điều kiện chưa chắc xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l49006-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校发了时间表，师生一起讨论暑假活动。老师点名后介绍报名条件，再发练习试题。小林说：“既然时间已经确定，我们就早点儿准备。”",
      "pinyin": "Xué xiào fā le shí jiān biǎo, shī shēng yì qǐ tǎo lùn shǔ jià huó dòng. Lǎo shī diǎn míng hòu jiè shào bào míng tiáo jiàn, zài fā liàn xí shì tí. Xiǎo Lín shuō: “Jì rán shí jiān yǐ jīng què dìng, wǒ men jiù zǎo diǎnr zhǔn bèi.”",
      "meaning": "Thầy trò bàn hoạt động hè sau khi đã xác định thời gian.",
      "readingMinutes": 2
    },
