  "blocks": [
    {
      "id": "l288-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder0",
      "type": "teaching",
      "title": "眼睛 · mắt",
      "text": "睛 đọc nhẹ trong 眼睛. Không phải mọi bộ phận nhìn thấy trên mặt đều gọi là 眼睛.",
      "hanzi": "我的眼睛有点儿累。",
      "pinyin": "Wǒ de yǎnjing yǒudiǎnr lèi.",
      "meaning": "Mắt tôi hơi mỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder1",
      "type": "teaching",
      "title": "手 · tay",
      "text": "手 chỉ bàn tay trong 洗手. Đừng nhầm với 首 dù cùng cách đọc trong một số ngữ cảnh khác.",
      "hanzi": "请洗手再吃饭。",
      "pinyin": "Qǐng xǐ shǒu zài chī fàn.",
      "meaning": "Hãy rửa tay rồi ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder2",
      "type": "teaching",
      "title": "花 · bông hoa",
      "text": "花2 là danh từ hoa. Cùng âm với động từ 花 tiêu tiền nhưng khác mục từ và nghĩa, không gộp hai bài thành một sense.",
      "hanzi": "我想画一朵花。",
      "pinyin": "Wǒ xiǎng huà yì duǒ huā.",
      "meaning": "Tôi muốn vẽ một bông hoa.",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder3",
      "type": "teaching",
      "title": "画 · vẽ",
      "text": "画 trong 画一只鸟 là động từ vẽ. Khi nói 一幅画 thì là danh từ bức tranh; bài không dùng nghĩa danh từ làm đáp án của câu động từ.",
      "hanzi": "她在画一只鸟。",
      "pinyin": "Tā zài huà yì zhī niǎo.",
      "meaning": "Cô ấy đang vẽ một con chim.",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder4",
      "type": "teaching",
      "title": "万 · mười nghìn",
      "text": "万 là đơn vị số đếm 10.000. 一万 = mười nghìn, không phải một triệu.",
      "hanzi": "一万比一千多。",
      "pinyin": "Yí wàn bǐ yì qiān duō.",
      "meaning": "Mười nghìn lớn hơn một nghìn.",
      "readingMinutes": 1
    },
    {
      "id": "l288-reminder5",
      "type": "teaching",
      "title": "坏 · hỏng, không còn hoạt động tốt trong câu",
      "text": "坏 ở đây là hỏng đồ vật. Không dùng nghĩa đạo đức xấu của người để trả lời câu điện thoại hỏng.",
      "hanzi": "我的手机坏了。",
      "pinyin": "Wǒ de shǒujī huài le.",
      "meaning": "Điện thoại của tôi hỏng rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l288-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的眼睛怎么了？乙：看书看得有点儿累。甲：我们去洗手间洗手，然后吃饭吧。乙：好，我也想起来动一动。",
      "pinyin": "Jiǎ: Nǐ de yǎnjing zěnme le? Yǐ: Kàn shū kàn de yǒudiǎnr lèi. Jiǎ: Wǒmen qù xǐshǒujiān xǐ shǒu, ránhòu chī fàn ba. Yǐ: Hǎo, wǒ yě xiǎng qǐlái dòng yi dòng.",
      "meaning": "A: Mắt bạn sao vậy? B: Đọc sách hơi mỏi. A: Chúng ta đến nhà vệ sinh rửa tay rồi ăn cơm nhé. B: Được, tôi cũng muốn đứng dậy cử động một chút.",
      "readingMinutes": 2
    },
    {
      "id": "l288-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "今天我们在外面画画。妹妹画一朵花，我画一只鸟。弟弟不画，他拿着球在跑。我们看见水里的鱼在游。",
      "pinyin": "Jīntiān wǒmen zài wàimiàn huà huà. Mèimei huà yì duǒ huā, wǒ huà yì zhī niǎo. Dìdi bú huà, tā ná zhe qiú zài pǎo. Wǒmen kànjiàn shuǐ li de yú zài yóu.",
      "meaning": "Hôm nay chúng tôi vẽ ở ngoài. Em gái vẽ hoa, tôi vẽ chim. Em trai không vẽ, em cầm bóng chạy. Chúng tôi thấy cá bơi trong nước.",
      "readingMinutes": 2
    },
    {
      "id": "l288-context2",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：明天出去玩，门票买了吗？乙：买好了。我还想买一些肉和水。甲：用这个包吧。乙：这个包坏了，我们用那个。",
      "pinyin": "Jiǎ: Míngtiān chūqù wán, ménpiào mǎi le ma? Yǐ: Mǎi hǎo le. Wǒ hái xiǎng mǎi yìxiē ròu hé shuǐ. Jiǎ: Yòng zhège bāo ba. Yǐ: Zhège bāo huài le, wǒmen yòng nàge.",
      "meaning": "A: Mai đi chơi, mua vé vào cửa chưa? B: Mua xong rồi. Tôi còn muốn mua ít thịt và nước. A: Dùng túi này nhé. B: Túi này hỏng rồi, dùng túi kia đi.",
      "readingMinutes": 2
    },
