  "blocks": [
    {
      "id": "l4082-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4082-t0",
      "type": "teaching",
      "title": "仍 · vẫn; còn",
      "text": "仍 là dạng một chữ, thường dùng trong văn viết, cùng hướng nghĩa với 仍然. Nhận diện chữ 仍 trong 仍; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "改了时间，他仍来参加。",
      "pinyin": "Gǎi le shí jiān, tā réng lái cān jiā.",
      "meaning": "Đổi giờ rồi anh ấy vẫn đến tham gia.",
      "readingMinutes": 1
    },
    {
      "id": "l4082-t1",
      "type": "teaching",
      "title": "仍然 · vẫn như trước",
      "text": "仍然 là dạng hai chữ, nói tình trạng tiếp tục dù hoàn cảnh đổi.",
      "hanzi": "换了教室，大家仍然认真学习。",
      "pinyin": "Huàn le jiào shì, dà jiā réng rán rèn zhēn xué xí.",
      "meaning": "Đổi phòng rồi mọi người vẫn học nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l4082-t2",
      "type": "teaching",
      "title": "受不了 · không chịu nổi",
      "text": "受不了 nói không thể chịu đựng điều gì trong cảm nhận nhân vật, không chẩn đoán bệnh.",
      "hanzi": "噪声太大，我受不了。",
      "pinyin": "Zào shēng tài dà, wǒ shòu bu liǎo.",
      "meaning": "Tiếng ồn quá lớn, tôi chịu không nổi.",
      "readingMinutes": 1
    },
    {
      "id": "l4082-t3",
      "type": "teaching",
      "title": "要是 · nếu; giả sử",
      "text": "要是 mở điều kiện chưa khẳng định có thật; thường phối với 就.",
      "hanzi": "要是还太吵，我们就换地方。",
      "pinyin": "Yào shi hái tài chǎo, wǒ men jiù huàn dì fang.",
      "meaning": "Nếu vẫn quá ồn, chúng ta đổi chỗ.",
      "readingMinutes": 1
    },
    {
      "id": "l4082-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "要是 đặt một giả định chứ không xác nhận đã xảy ra. 仍 và 仍然 gần nghĩa vẫn; bài chọn đúng độ dài yêu cầu để tránh coi dạng còn lại là sai.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4082-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林觉得教室外的噪声太大，受不了。小组改了时间，他仍来参加。换到另一间教室后，大家仍然认真学习。老师说：“要是这里还太吵，我们就再商量。”这是假设，不是说新教室已经很吵。",
      "pinyin": "Xiǎo Lín jué de jiào shì wài de zào shēng tài dà, shòu bu liǎo. Xiǎo zǔ gǎi le shí jiān, tā réng lái cān jiā. Huàn dào lìng yì jiān jiào shì hòu, dà jiā réng rán rèn zhēn xué xí. Lǎo shī shuō: “Yào shi zhè lǐ hái tài chǎo, wǒ men jiù zài shāng liang.” Zhè shì jiǎ shè, bú shì shuō xīn jiào shì yǐ jīng hěn chǎo.",
      "meaning": "Lời giáo viên là điều kiện dự phòng; không chứng minh phòng mới đã ồn.",
      "readingMinutes": 2
    },
    {
