  "blocks": [
    {
      "id": "l4042-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t0",
      "type": "teaching",
      "title": "体检 · khám sức khỏe",
      "text": "体检 là kiểm tra sức khỏe, không tự đồng nghĩa đã phát hiện bệnh.",
      "hanzi": "他今天去体检。",
      "pinyin": "Tā jīn tiān qù tǐ jiǎn.",
      "meaning": "Hôm nay anh ấy đi khám sức khỏe.",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t1",
      "type": "teaching",
      "title": "体温 · thân nhiệt",
      "text": "体温 chỉ nhiệt độ cơ thể, khác 气温.",
      "hanzi": "护士记录了体温。",
      "pinyin": "Hù shi jì lù le tǐ wēn.",
      "meaning": "Y tá ghi lại thân nhiệt.",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t2",
      "type": "teaching",
      "title": "体重 · cân nặng cơ thể",
      "text": "体重 chỉ trọng lượng cơ thể, không phải mọi đồ vật.",
      "hanzi": "表格上有体重这一项。",
      "pinyin": "Biǎo gé shàng yǒu tǐ zhòng zhè yí xiàng.",
      "meaning": "Biểu mẫu có mục cân nặng.",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t3",
      "type": "teaching",
      "title": "痛 · đau",
      "text": "痛 nói cảm giác đau; câu này không xác định nguyên nhân. Nhận diện chữ 痛 trong 痛; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "你觉得哪里痛？",
      "pinyin": "Nǐ jué de nǎ lǐ tòng?",
      "meaning": "Bạn thấy đau ở đâu?",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t4",
      "type": "teaching",
      "title": "头痛 · đau đầu",
      "text": "头痛 là triệu chứng đau đầu trong câu, không chỉ phiền lòng.",
      "hanzi": "他告诉医生自己有点儿头痛。",
      "pinyin": "Tā gào su yī shēng zì jǐ yǒu diǎnr tóu tòng.",
      "meaning": "Anh ấy nói với bác sĩ mình hơi đau đầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4042-t5",
      "type": "teaching",
      "title": "血 · máu",
      "text": "血 theo mục nguồn đọc xiě; bài không suy ra bệnh từ dấu hiệu.",
      "hanzi": "他的手指上有一点儿血。",
      "pinyin": "Tā de shǒu zhǐ shàng yǒu yì diǎnr xiě.",
      "meaning": "Trên ngón tay anh ấy có chút máu.",
      "readingMinutes": 1
    },
    {
      "id": "l4042-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然…就… dựa trên điều đã xảy ra để đưa đề nghị. Bài luyện cách thuật lại thông tin, không chẩn đoán hay chỉ dẫn điều trị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4042-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安来体检，护士记录体温和体重，问他哪里痛。小安说最近头痛，昨天又不小心划破手指，看见一点儿血。医生说：“既然来了，就把情况说清楚。”故事没有提供诊断或治疗方案。",
      "pinyin": "Xiǎo Ān lái tǐ jiǎn, hù shi jì lù tǐ wēn hé tǐ zhòng, wèn tā nǎ lǐ tòng. Xiǎo Ān shuō zuì jìn tóu tòng, zuó tiān yòu bù xiǎo xīn huá pò shǒu zhǐ, kàn jiàn yì diǎnr xiě. Yī shēng shuō: “Jì rán lái le, jiù bǎ qíng kuàng shuō qīng chu.” Gù shi méi yǒu tí gōng zhěn duàn huò zhì liáo fāng àn.",
      "meaning": "Tiểu An thuật lại tình trạng cho bác sĩ; câu chuyện không đưa chẩn đoán hay cách điều trị.",
      "readingMinutes": 2
    },
