  "blocks": [
    {
      "id": "l458-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 工具 gōngjù: công cụ; 限制 xiànzhì: giới hạn; 盲目 mángmù: mù quáng; 尝试 chángshì: thử.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l458-t0",
      "type": "teaching",
      "title": "科技 · khoa học công nghệ",
      "text": "科技 là tên chung khoa học và công nghệ; không phải mọi lời quảng cáo đều là 科研成果. Nhận diện chữ 技 trong 科技; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "学校举办科技活动。",
      "pinyin": "Xuéxiào jǔbàn kējì huódòng.",
      "meaning": "Trường tổ chức hoạt động khoa học công nghệ.",
      "readingMinutes": 1
    },
    {
      "id": "l458-t1",
      "type": "teaching",
      "title": "科学 · khoa học",
      "text": "科学 là danh từ ngành khoa học hoặc tính từ có cơ sở; bài dùng danh từ 科学知识.",
      "hanzi": "学生学习科学知识。",
      "pinyin": "Xuésheng xuéxí kēxué zhīshi.",
      "meaning": "Học sinh học kiến thức khoa học.",
      "readingMinutes": 1
    },
    {
      "id": "l458-t2",
      "type": "teaching",
      "title": "好处 · mặt lợi",
      "text": "好处 là lợi ích cụ thể; có thể dùng 对……有好处.",
      "hanzi": "这种方法有什么好处？",
      "pinyin": "Zhè zhǒng fāngfǎ yǒu shénme hǎochù?",
      "meaning": "Phương pháp này có lợi gì?",
      "readingMinutes": 1
    },
    {
      "id": "l458-t3",
      "type": "teaching",
      "title": "坏处 · mặt hại",
      "text": "坏处 nói bất lợi/tác hại, không đồng nghĩa một lỗi kỹ thuật cụ thể.",
      "hanzi": "只看手机也有坏处。",
      "pinyin": "Zhǐ kàn shǒujī yě yǒu huàichù.",
      "meaning": "Chỉ chăm điện thoại cũng có mặt hại.",
      "readingMinutes": 1
    },
    {
      "id": "l458-t4",
      "type": "teaching",
      "title": "尽管 · mặc dù",
      "text": "尽管 trong cấu trúc nhượng bộ được luyện cùng 但是, không suy ra điều kiện chưa xảy ra.",
      "hanzi": "尽管方便，但是还要小心。",
      "pinyin": "Jǐnguǎn fāngbiàn, dànshì hái yào xiǎoxīn.",
      "meaning": "Dù tiện, vẫn cần cẩn thận.",
      "readingMinutes": 1
    },
    {
      "id": "l458-t5",
      "type": "teaching",
      "title": "浪费 · lãng phí",
      "text": "浪费 có thể làm động từ nhận 时间、材料; khác 消费 không nhất thiết tiêu cực.",
      "hanzi": "重复填写会浪费时间。",
      "pinyin": "Chóngfù tiánxiě huì làngfèi shíjiān.",
      "meaning": "Điền lặp lại sẽ lãng phí thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l458-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "尽管 nêu sự thật được nhượng bộ, 但是 nêu mặt trái/kết quả khác dự kiến: 尽管技术方便，但是使用前还要了解风险. Khác 即使 nêu giả định. Trong đoạn nhóm đã dùng thử, sự tiện lợi là đánh giá trong câu chuyện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l458-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "科技活动上，学生试用一个整理笔记的小工具。老师让大家用科学知识说明好处和坏处。小组说：“它能减少重复填写，节约时间；如果不检查结果，也可能留下错误。尽管技术方便，但是使用前还要了解限制，不能浪费时间盲目尝试。”",
      "pinyin": "Kējì huódòng shàng, xuésheng shìyòng yí ge zhěnglǐ bǐjì de xiǎo gōngjù. Lǎoshī ràng dàjiā yòng kēxué zhīshi shuōmíng hǎochù hé huàichù. Xiǎozǔ shuō: “Tā néng jiǎnshǎo chóngfù tiánxiě, jiéyuē shíjiān; rúguǒ bù jiǎnchá jiéguǒ, yě kěnéng liúxià cuòwù. Jǐnguǎn jìshù fāngbiàn, dànshì shǐyòng qián hái yào liǎojiě xiànzhì, bù néng làngfèi shíjiān mángmù chángshì.”",
      "meaning": "Nhóm thử công cụ ghi chú, thấy đỡ điền lặp nhưng vẫn có thể để sót lỗi nếu không kiểm tra. Họ đề nghị hiểu giới hạn trước khi dùng, tránh thử mù quáng.",
      "readingMinutes": 2
    },
