  "blocks": [
    {
      "id": "l4080-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t0",
      "type": "teaching",
      "title": "小组 · nhóm nhỏ",
      "text": "小组 nói đơn vị nhóm cùng làm một việc.",
      "hanzi": "我们小组负责介绍结果。",
      "pinyin": "Wǒ men xiǎo zǔ fù zé jiè shào jié guǒ.",
      "meaning": "Nhóm chúng tôi phụ trách giới thiệu kết quả.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t1",
      "type": "teaching",
      "title": "谈 · nói chuyện; bàn",
      "text": "谈 ở 谈计划 là thảo luận về kế hoạch.",
      "hanzi": "我们先谈一下计划。",
      "pinyin": "Wǒ men xiān tán yí xià jì huà.",
      "meaning": "Chúng ta bàn kế hoạch trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t2",
      "type": "teaching",
      "title": "与 · và; với",
      "text": "与 tương đối văn viết, nối hai đối tượng hoặc dẫn bên cùng tham gia.",
      "hanzi": "我与同学一起准备。",
      "pinyin": "Wǒ yǔ tóng xué yì qǐ zhǔn bèi.",
      "meaning": "Tôi cùng bạn học chuẩn bị.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t3",
      "type": "teaching",
      "title": "赢得 · giành được; nhận được",
      "text": "赢得 ở đây là đạt sự tin tưởng nhờ hành động trong câu chuyện.",
      "hanzi": "认真解释赢得了大家的信任。",
      "pinyin": "Rèn zhēn jiě shì yíng dé le dà jiā de xìn rèn.",
      "meaning": "Giải thích nghiêm túc giành được lòng tin.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t4",
      "type": "teaching",
      "title": "支持 · ủng hộ; hỗ trợ",
      "text": "支持 không có nghĩa xác nhận mọi nhận định đều đúng. Nhận diện chữ 支 trong 支持; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "老师支持我们继续调查。",
      "pinyin": "Lǎo shī zhī chí wǒ men jì xù diào chá.",
      "meaning": "Giáo viên ủng hộ chúng tôi khảo sát tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-t5",
      "type": "teaching",
      "title": "指出 · chỉ ra",
      "text": "指出 nêu cụ thể điều cần chú ý, có thể là lỗi hoặc điểm tốt.",
      "hanzi": "她指出了表中的一个错误。",
      "pinyin": "Tā zhǐ chū le biǎo zhōng de yí ge cuò wù.",
      "meaning": "Cô ấy chỉ ra một lỗi trong bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l4080-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… nối việc làm bổ sung. 支持 một nhóm vẫn có thể 指出 vấn đề; ủng hộ không bắt buộc đồng ý mọi câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4080-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小组先谈计划，小安与同学一起准备。老师支持他们继续调查，也指出表中缺少日期。小组不仅补上日期，还解释信息从哪里来。认真说明赢得了同学的信任，但大家仍可以提出问题。",
      "pinyin": "Xiǎo zǔ xiān tán jì huà, Xiǎo Ān yǔ tóng xué yì qǐ zhǔn bèi. Lǎo shī zhī chí tā men jì xù diào chá, yě zhǐ chū biǎo zhōng quē shǎo rì qī. Xiǎo zǔ bù jǐn bǔ shàng rì qī, hái jiě shì xìn xī cóng nǎ lǐ lái. Rèn zhēn shuō míng yíng dé le tóng xué de xìn rèn, dàn dà jiā réng kě yǐ tí chū wèn tí.",
      "meaning": "Nhóm bổ sung ngày và nguồn thông tin sau góp ý; sự tin tưởng vẫn đi cùng quyền đặt câu hỏi.",
      "readingMinutes": 2
    },
