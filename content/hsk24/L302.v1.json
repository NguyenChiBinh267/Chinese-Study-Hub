  "blocks": [
    {
      "id": "l302-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc trật tự chủ ngữ–động từ–tân ngữ, 不/没 và 的; HSK1/HSK2 chưa được chứng nhận. Có thể khám phá bài nháp. 先 xiān: trước; 然后 ránhòu: sau đó; 只 zhǐ: chỉ; 够 gòu: đủ (hỗ trợ, chưa xác minh cấp); 明白 míngbai: hiểu. 不/没 và 会 được nhắc bằng đối chiếu tình huống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l302-t0",
      "type": "teaching",
      "title": "复习 · ôn lại",
      "text": "复习 nhìn lại nội dung đã học. Đọc một bài hoàn toàn mới lần đầu không tự động gọi là 复习.",
      "hanzi": "考试前，我先复习课文。",
      "pinyin": "Kǎoshì qián, wǒ xiān fùxí kèwén.",
      "meaning": "Trước kiểm tra tôi ôn bài khóa trước.",
      "readingMinutes": 1
    },
    {
      "id": "l302-t1",
      "type": "teaching",
      "title": "练习 · luyện tập",
      "text": "练习 là làm để tập kỹ năng; có thể là động từ hoặc bài tập theo ngữ cảnh. 练习写句子 là luyện viết câu, không chỉ nhìn đáp án.",
      "hanzi": "我每天练习写三个句子。",
      "pinyin": "Wǒ měi tiān liànxí xiě sān ge jùzi.",
      "meaning": "Mỗi ngày tôi luyện viết ba câu.",
      "readingMinutes": 1
    },
    {
      "id": "l302-t2",
      "type": "teaching",
      "title": "记 · ghi/nhớ",
      "text": "记 có thể ghi lại hoặc ghi nhớ theo tân ngữ. 记在本子上 là ghi xuống, 记住 là ghi nhớ; bài này chỉ kiểm tra nghĩa trong câu.",
      "hanzi": "我把老师说的话记在本子上。",
      "pinyin": "Wǒ bǎ lǎoshī shuō de huà jì zài běnzi shang.",
      "meaning": "Tôi ghi lời thầy vào vở.",
      "readingMinutes": 1
    },
    {
      "id": "l302-t3",
      "type": "teaching",
      "title": "简单 · đơn giản",
      "text": "简单 mô tả ít phức tạp; không nhất thiết đồng nghĩa không cần luyện. 对我来说很简单 là đơn giản đối với tôi.",
      "hanzi": "这个句子很简单。",
      "pinyin": "Zhège jùzi hěn jiǎndān.",
      "meaning": "Câu này rất đơn giản.",
      "readingMinutes": 1
    },
    {
      "id": "l302-t4",
      "type": "teaching",
      "title": "懂得 · hiểu/biết rõ",
      "text": "懂得 thường chỉ hiểu điều, đạo lý hoặc cách làm. Trong 懂得这个方法 là hiểu phương pháp; khác chỉ nhớ mặt chữ.",
      "hanzi": "现在我懂得这个方法了。",
      "pinyin": "Xiànzài wǒ dǒngde zhège fāngfǎ le.",
      "meaning": "Giờ tôi đã hiểu phương pháp này.",
      "readingMinutes": 1
    },
    {
      "id": "l302-t5",
      "type": "teaching",
      "title": "方法 · phương pháp/cách làm",
      "text": "方法 là cách để làm việc gì. 一个学习方法 là một phương pháp học; không phải đơn thuần thời gian biểu.",
      "hanzi": "老师介绍了一个学习方法。",
      "pinyin": "Lǎoshī jièshào le yí ge xuéxí fāngfǎ.",
      "meaning": "Thầy giới thiệu một phương pháp học.",
      "readingMinutes": 1
    },
    {
      "id": "l302-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "先 đặt trước việc thứ nhất, 再/然后 nối bước kế tiếp. Ví dụ 先复习课文，再练习写句子. 再 ở đây là làm bước sau, không dùng để kể một lần lặp đã xảy ra như 又.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l302-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我记了很多新词，还是不会写句子。老师：先复习课文，再练习写简单的句子。小安：只记词不够吗？老师：也要懂得词在句子里怎样用。小安：我明白了，这个方法我想试试。",
      "pinyin": "Xiǎo Ān: Wǒ jì le hěn duō xīn cí, háishi bú huì xiě jùzi. Lǎoshī: Xiān fùxí kèwén, zài liànxí xiě jiǎndān de jùzi. Xiǎo Ān: Zhǐ jì cí bú gòu ma? Lǎoshī: Yě yào dǒngde cí zài jùzi lǐ zěnyàng yòng. Xiǎo Ān: Wǒ míngbai le, zhège fāngfǎ wǒ xiǎng shìshi.",
      "meaning": "An đã ghi nhiều từ nhưng chưa viết được câu. Thầy khuyên ôn bài rồi luyện câu đơn giản, hiểu cách dùng từ trong câu. An muốn thử phương pháp đó.",
      "readingMinutes": 2
    },
