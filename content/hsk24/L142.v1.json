  "blocks": [
    {
      "id": "l142-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l142-t0",
      "type": "teaching",
      "title": "玩 · chơi (dạng một chữ)",
      "text": "玩 nói hoạt động chơi ở đây; đề từ điển này yêu cầu dạng một chữ không có 儿.",
      "hanzi": "我喜欢玩。",
      "pinyin": "Wǒ xǐ huan wán.",
      "meaning": "Tôi thích chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l142-t1",
      "type": "teaching",
      "title": "觉得 · cảm thấy; cho rằng",
      "text": "觉得 báo cảm nhận/ý kiến của người nói, không tự chứng minh ai khác cũng nghĩ vậy.",
      "hanzi": "我觉得这里很好玩儿。",
      "pinyin": "Wǒ jué de zhè lǐ hěn hǎo wánr.",
      "meaning": "Tôi thấy ở đây vui.",
      "readingMinutes": 1
    },
    {
      "id": "l142-t2",
      "type": "teaching",
      "title": "真 · thật; quả là (một âm tiết)",
      "text": "真 nhấn nhận xét trong câu; bài phân biệt dạng một âm tiết với 非常.",
      "hanzi": "这里真好！",
      "pinyin": "Zhè lǐ zhēn hǎo!",
      "meaning": "Ở đây thật tốt!",
      "readingMinutes": 1
    },
    {
      "id": "l142-t3",
      "type": "teaching",
      "title": "非常 · rất; vô cùng (hai âm tiết)",
      "text": "非常 đứng trước tính từ; khi đề yêu cầu dạng hai âm tiết này không thay bằng 真.",
      "hanzi": "我非常喜欢这里。",
      "pinyin": "Wǒ fēi cháng xǐ huan zhè lǐ.",
      "meaning": "Tôi rất thích nơi đây.",
      "readingMinutes": 1
    },
    {
      "id": "l142-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "觉得 mở một nhận xét/cảm nhận: 我觉得这里好玩儿. 真 và 非常 tăng mức độ trong các ví dụ; 真 một âm tiết, 非常 hai âm tiết. Không đồng nhất mọi nhận xét chủ quan với sự thật đã được kiểm chứng. 玩 là mục một chữ, khác mục 好玩儿 đã học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l142-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你喜欢这里吗？\nB：喜欢，我觉得这里很好玩儿。\nA：我也非常喜欢这里。\nB：真好！",
      "pinyin": "A: Nǐ xǐ huan zhè lǐ ma? B: Xǐ huan, wǒ jué de zhè lǐ hěn hǎo wánr. A: Wǒ yě fēi cháng xǐ huan zhè lǐ. B: Zhēn hǎo!",
      "meaning": "B nói cảm nhận của mình; A cũng thích nơi này. Không có dữ kiện để kết luận mọi người đều thích.",
      "readingMinutes": 2
    },
