  "blocks": [
    {
      "id": "l406-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 请教 qǐngjiào: xin chỉ dẫn; 回电 huí diàn: gọi lại; 永远 yǒngyuǎn: mãi mãi. 并读 bìng, ghi số 1 chỉ phân biệt mục nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l406-t0",
      "type": "teaching",
      "title": "抱歉 · áy náy, xin lỗi",
      "text": "抱歉 biểu đạt sự áy náy với người bị ảnh hưởng; 很抱歉 có thể mở lời lịch sự. Nhận diện chữ 抱 trong 抱歉; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "很抱歉，我来晚了。",
      "pinyin": "Hěn bàoqiàn, wǒ lái wǎn le.",
      "meaning": "Xin lỗi, tôi đến muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l406-t1",
      "type": "teaching",
      "title": "打扰 · làm phiền",
      "text": "打扰 dùng khi chen vào thời gian hoặc hoạt động của người khác, thường đi với xin lỗi.",
      "hanzi": "不好意思，打扰您一下。",
      "pinyin": "Bù hǎoyìsi, dǎrǎo nín yíxià.",
      "meaning": "Xin lỗi, cho phép tôi làm phiền ông/bà một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l406-t2",
      "type": "teaching",
      "title": "打招呼 · chào hỏi",
      "text": "打招呼 là cả cụm động–tân; không chỉ 招呼 khi gọi tên mục từ trong bài.",
      "hanzi": "见到邻居，我先打招呼。",
      "pinyin": "Jiàndào línjū, wǒ xiān dǎ zhāohu.",
      "meaning": "Gặp hàng xóm, tôi chào trước.",
      "readingMinutes": 1
    },
    {
      "id": "l406-t3",
      "type": "teaching",
      "title": "便于 · thuận tiện cho việc",
      "text": "便于 thường đi trước động từ và nói việc bố trí giúp làm gì, khác 方便 dùng rộng hơn.",
      "hanzi": "请留下号码，便于联系。",
      "pinyin": "Qǐng liú xià hàomǎ, biànyú liánxì.",
      "meaning": "Hãy để lại số điện thoại để tiện liên hệ.",
      "readingMinutes": 1
    },
    {
      "id": "l406-t4",
      "type": "teaching",
      "title": "不便 · bất tiện",
      "text": "不便 có thể chỉ điều kiện không thuận lợi hoặc lịch sự báo không thể làm ngay.",
      "hanzi": "他现在不便接电话。",
      "pinyin": "Tā xiànzài búbiàn jiē diànhuà.",
      "meaning": "Bây giờ anh ấy không tiện nghe điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l406-t5",
      "type": "teaching",
      "title": "答 · đáp, trả lời",
      "text": "答 đọc dá khi trả lời, khác 答应 dāying. Bài dùng nghĩa đáp câu hỏi, không phải hứa làm.",
      "hanzi": "这道题他答得很清楚。",
      "pinyin": "Zhè dào tí tā dá de hěn qīngchu.",
      "meaning": "Anh ấy trả lời câu này rất rõ.",
      "readingMinutes": 1
    },
    {
      "id": "l406-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "并 trong 并不 tăng ý phủ định, thường bác một suy đoán: 现在并不方便. Không dịch thành “và” ở câu này. 便于+động từ nêu tác dụng tạo thuận lợi, 不便 có thể nói sự bất tiện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l406-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小陈进办公室先打招呼，再问现在能不能请教问题。对方说现在并不方便。小陈说很抱歉打扰了，留下号码便于联系。下午对方回电，把问题答清楚了。一次不便不等于永远拒绝。",
      "pinyin": "Xiǎo Chén jìn bàngōngshì xiān dǎ zhāohu, zài wèn xiànzài néng bu néng qǐngjiào wèntí. Duìfāng shuō xiànzài bìng bù fāngbiàn. Xiǎo Chén shuō hěn bàoqiàn dǎrǎo le, liú xià hàomǎ biànyú liánxì. Xiàwǔ duìfāng huí diàn, bǎ wèntí dá qīngchu le. Yí cì búbiàn bù děngyú yǒngyuǎn jùjué.",
      "meaning": "Trần chào rồi xin hỏi. Người kia đang bận; Trần xin lỗi và để lại số. Chiều người kia gọi lại giải đáp.",
      "readingMinutes": 2
    },
