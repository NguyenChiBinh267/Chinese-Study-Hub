  "blocks": [
    {
      "id": "l1161-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder0",
      "type": "teaching",
      "title": "很 · rất; yếu tố mức độ",
      "text": "Từ đã học 很 có 1 chữ. Chữ 很 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 很 với 狠 / 根 / 恨; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这本书很新。",
      "pinyin": "Zhè běn shū hěn xīn.",
      "meaning": "Quyển sách này mới.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder1",
      "type": "teaching",
      "title": "漂亮 · đẹp; xinh",
      "text": "Từ đã học 漂亮 có 2 chữ. Chữ 漂 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 漂 với 飘 / 票 / 标; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那只猫很漂亮。",
      "pinyin": "Nà zhī māo hěn piào liang.",
      "meaning": "Con mèo kia đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder2",
      "type": "teaching",
      "title": "看 · nhìn; xem (dạng kàn)",
      "text": "Từ đã học 看 có 1 chữ. Chữ 看 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 看 với 着 / 春 / 者; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我正在看电视。",
      "pinyin": "Wǒ zhèng zài kàn diàn shì.",
      "meaning": "Tôi đang xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder3",
      "type": "teaching",
      "title": "同学 · bạn học",
      "text": "Từ đã học 同学 có 2 chữ. Chữ 同 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 同 với 向 / 周 / 司; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他是我的同学。",
      "pinyin": "Tā shì wǒ de tóng xué.",
      "meaning": "Anh ấy là bạn học của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder4",
      "type": "teaching",
      "title": "老师 · giáo viên; thầy/cô",
      "text": "Từ đã học 老师 có 2 chữ. Chữ 老 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 老 với 考 / 者 / 孝; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "她是我的老师。",
      "pinyin": "Tā shì wǒ de lǎo shī.",
      "meaning": "Cô ấy là giáo viên của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reminder5",
      "type": "teaching",
      "title": "学校 · trường học",
      "text": "Từ đã học 学校 có 2 chữ. Chữ 校 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 校 với 较 / 效 / 郊; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是我们的学校。",
      "pinyin": "Zhè shì wǒ men de xué xiào.",
      "meaning": "Đây là trường của chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1161-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这是什么书？\nB：这是我的汉语书。\nA：你每天读吗？\nB：对。",
      "pinyin": "A: Zhè shì shén me shū? B: Zhè shì wǒ de Hàn yǔ shū. A: Nǐ měi tiān dú ma? B: Duì.",
      "meaning": "B giới thiệu sách tiếng Hán của mình và xác nhận đọc hằng ngày.",
      "readingMinutes": 2
    },
