  "blocks": [
    {
      "id": "l1168-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder0",
      "type": "teaching",
      "title": "打电话 · gọi điện thoại",
      "text": "Từ đã học 打电话 có 3 chữ. Chữ 打 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 打 với 订 / 叮 / 灯; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我打电话。",
      "pinyin": "Wǒ dǎ diàn huà.",
      "meaning": "Tôi gọi điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder1",
      "type": "teaching",
      "title": "手机 · điện thoại di động",
      "text": "Từ đã học 手机 có 2 chữ. Chữ 机 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 机 với 枫 / 树 / 木; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我的手机很新。",
      "pinyin": "Wǒ de shǒu jī hěn xīn.",
      "meaning": "Điện thoại di động của tôi mới.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder2",
      "type": "teaching",
      "title": "电脑 · máy tính",
      "text": "Từ đã học 电脑 có 2 chữ. Chữ 脑 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 脑 với 恼 / 胸 / 胶; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有电脑。",
      "pinyin": "Wǒ yǒu diàn nǎo.",
      "meaning": "Tôi có máy tính.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder3",
      "type": "teaching",
      "title": "电视 · tivi; truyền hình",
      "text": "Từ đã học 电视 có 2 chữ. Chữ 视 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 视 với 现 / 祝 / 规; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喜欢看电视。",
      "pinyin": "Wǒ xǐ huan kàn diàn shì.",
      "meaning": "Tôi thích xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder4",
      "type": "teaching",
      "title": "歌 · bài hát; ca khúc",
      "text": "Từ đã học 歌 có 1 chữ. Chữ 歌 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 歌 với 哥 / 欲 / 次; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我唱歌。",
      "pinyin": "Wǒ chàng gē.",
      "meaning": "Tôi hát.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reminder5",
      "type": "teaching",
      "title": "玩 · chơi (dạng một chữ)",
      "text": "Từ đã học 玩 có 1 chữ. Chữ 玩 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 玩 với 现 / 环 / 元; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喜欢玩。",
      "pinyin": "Wǒ xǐ huan wán.",
      "meaning": "Tôi thích chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l1168-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：老师在办公室吗？\nB：不，他在教室。\nA：好，谢谢。",
      "pinyin": "A: Lǎo shī zài bàn gōng shì ma? B: Bù, tā zài jiào shì. A: Hǎo, xiè xie.",
      "meaning": "B sửa địa điểm: thầy ở lớp học, không ở văn phòng.",
      "readingMinutes": 2
    },
