  "blocks": [
    {
      "id": "l224-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "上/下 là lên/xuống; 来 hướng về mốc đang nói, 去 hướng xa. Người nói có thể ở tầng khác nên phải đọc ngữ cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l224-t0",
      "type": "teaching",
      "title": "上来 · lên về phía mốc người nói",
      "text": "Người trên tầng hai gọi người dưới lên chỗ mình dùng 上来.",
      "hanzi": "我在二楼，你上来吧。",
      "pinyin": "Wǒ zài èr lóu, nǐ shànglái ba.",
      "meaning": "Tôi ở tầng hai, bạn lên đây nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l224-t1",
      "type": "teaching",
      "title": "上去 · đi lên xa mốc người nói",
      "text": "Người ở tầng một nhìn người khác đi lên tầng hai có thể nói 他上去了.",
      "hanzi": "他上去找老师。",
      "pinyin": "Tā shàngqù zhǎo lǎoshī.",
      "meaning": "Anh ấy đi lên tìm giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l224-t2",
      "type": "teaching",
      "title": "下来 · xuống về phía mốc người nói",
      "text": "Người đứng dưới gọi người trên xuống chỗ mình dùng 下来.",
      "hanzi": "我在门口，你下来吧。",
      "pinyin": "Wǒ zài ménkǒu, nǐ xiàlái ba.",
      "meaning": "Tôi ở cửa, bạn xuống đây nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l224-t3",
      "type": "teaching",
      "title": "下去 · đi xuống xa mốc người nói",
      "text": "Người vẫn ở tầng trên nói người khác xuống bên dưới dùng 下去.",
      "hanzi": "我在二楼，他下去买水了。",
      "pinyin": "Wǒ zài èr lóu, tā xiàqù mǎi shuǐ le.",
      "meaning": "Tôi ở tầng hai, anh ấy xuống dưới mua nước rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l224-t4",
      "type": "teaching",
      "title": "过来 · sang về phía người nói",
      "text": "过来 ở đây là di chuyển sang chỗ người nói. Không suy ra đã hoàn tất một kinh nghiệm quá khứ.",
      "hanzi": "请到我这里来，快过来。",
      "pinyin": "Qǐng dào wǒ zhèlǐ lái, kuài guòlái.",
      "meaning": "Hãy đến chỗ tôi, mau sang đây.",
      "readingMinutes": 1
    },
    {
      "id": "l224-t5",
      "type": "teaching",
      "title": "过去 · đi sang xa mốc người nói",
      "text": "Mục 过去1 đang học là động từ di chuyển sang bên kia; không phải danh từ quá khứ.",
      "hanzi": "老师在那里，我们过去吧。",
      "pinyin": "Lǎoshī zài nàlǐ, wǒmen guòqù ba.",
      "meaning": "Giáo viên ở đằng kia, chúng ta sang đó nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l224-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Người ở trên gọi 上来, người dưới nói ai đó 上去. Tương tự 下来 hướng xuống về mốc, 下去 hướng xuống xa mốc; không chọn chỉ bằng nghĩa lên/xuống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l224-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "我在二楼。小李在门口，我说：你上来吧。小李上来以后，我们看见老师在外面。小李说：我们下去找老师吧。",
      "pinyin": "Wǒ zài èr lóu. Xiǎo Lǐ zài ménkǒu, wǒ shuō: Nǐ shànglái ba. Xiǎo Lǐ shànglái yǐhòu, wǒmen kànjiàn lǎoshī zài wàimiàn. Xiǎo Lǐ shuō: Wǒmen xiàqù zhǎo lǎoshī ba.",
      "meaning": "Tôi ở tầng hai. Tiểu Lý ở cửa, tôi nói: Bạn lên đây nhé. Sau khi Tiểu Lý lên, chúng tôi thấy giáo viên ở ngoài. Tiểu Lý nói: Chúng ta xuống tìm thầy/cô nhé.",
      "readingMinutes": 2
    },
