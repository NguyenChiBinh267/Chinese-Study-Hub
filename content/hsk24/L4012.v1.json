  "blocks": [
    {
      "id": "l4012-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t0",
      "type": "teaching",
      "title": "申请 · nộp đơn; xin",
      "text": "申请 là đề nghị chính thức để được xét, không đồng nghĩa đã được chấp nhận. Nhận diện chữ 申 trong 申请; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他准备申请这门课程。",
      "pinyin": "Tā zhǔn bèi shēn qǐng zhè mén kè chéng.",
      "meaning": "Anh ấy chuẩn bị đăng ký xin học khóa này.",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t1",
      "type": "teaching",
      "title": "入学 · nhập học",
      "text": "入学 là bắt đầu theo học sau thủ tục tương ứng; khác việc nộp đơn chưa có kết quả.",
      "hanzi": "入学以前，她想了解课程安排。",
      "pinyin": "Rù xué yǐ qián, tā xiǎng liǎo jiě kè chéng ān pái.",
      "meaning": "Trước khi nhập học cô ấy muốn tìm hiểu lịch học.",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t2",
      "type": "teaching",
      "title": "学费 · học phí",
      "text": "学费 chỉ khoản tiền học của nhân vật ở cơ sở hư cấu, không phải phí ứng dụng hoặc báo giá thật.",
      "hanzi": "请问学费包括教材吗？",
      "pinyin": "Qǐng wèn xué fèi bāo kuò jiào cái ma?",
      "meaning": "Xin hỏi học phí có gồm tài liệu không?",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t3",
      "type": "teaching",
      "title": "学院 · học viện; trường chuyên ngành",
      "text": "学院 là một đơn vị/trường đào tạo; không mặc định mọi 学院 đều cấp cùng loại bằng.",
      "hanzi": "这所学院有晚上的课程。",
      "pinyin": "Zhè suǒ xué yuàn yǒu wǎn shang de kè chéng.",
      "meaning": "Học viện này có khóa học buổi tối.",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t4",
      "type": "teaching",
      "title": "研究 · nghiên cứu",
      "text": "研究 là tìm hiểu có hệ thống; khác danh từ người học sau đại học 研究生.",
      "hanzi": "她想研究语言教学。",
      "pinyin": "Tā xiǎng yán jiū yǔ yán jiào xué.",
      "meaning": "Cô ấy muốn nghiên cứu dạy ngôn ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l4012-t5",
      "type": "teaching",
      "title": "研究生 · học viên sau đại học",
      "text": "研究生 là người học ở bậc sau đại học, không phải bất kỳ ai đang nghiên cứu một vấn đề.",
      "hanzi": "她的朋友是研究生。",
      "pinyin": "Tā de péng you shì yán jiū shēng.",
      "meaning": "Bạn cô ấy là học viên sau đại học.",
      "readingMinutes": 1
    },
    {
      "id": "l4012-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "没什么好怕的 nghĩa là không có gì phải sợ ở tình huống hỏi thông tin: 好 đứng trước động từ 怕, không mang nghĩa tốt. Không phải câu kết luận mọi khó khăn đều không đáng lo.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4012-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里的小梅想申请一所学院的课程。她对语言教学研究有兴趣，还没决定是否读研究生。入学安排和学费都需要向学院确认。她怕问题太多，朋友说：“不懂就问，没什么好怕的。先问清楚，再决定。”",
      "pinyin": "Gù shi lǐ de Xiǎo Méi xiǎng shēn qǐng yì suǒ xué yuàn de kè chéng. Tā duì yǔ yán jiào xué yán jiū yǒu xìng qù, hái méi jué dìng shì fǒu dú yán jiū shēng. Rù xué ān pái hé xué fèi dōu xū yào xiàng xué yuàn què rèn. Tā pà wèn tí tài duō, péng you shuō: “Bù dǒng jiù wèn, méi shén me hǎo pà de. Xiān wèn qīng chu, zài jué dìng.”",
      "meaning": "Tiểu Mai chưa quyết định học sau đại học; cần hỏi trường về nhập học và học phí trước khi chọn.",
      "readingMinutes": 2
    },
