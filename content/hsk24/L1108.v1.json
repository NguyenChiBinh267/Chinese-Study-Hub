  "blocks": [
    {
      "id": "l1108-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1108-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Khi phủ định một việc đã không xảy ra, dùng 没/没有 + động từ: 我昨天没去学校; 我昨天没有去学校 cũng phù hợp. Không dùng 不 để thay mọi phủ định quá khứ của một hành động cụ thể. Trong mẫu phủ định này không giữ 了 hoàn thành sau hành động: 我昨天没去学校了 không phải câu mục tiêu của bài. 不 vẫn dùng phủ định là/nhận xét/thói quen theo các mẫu trước; không đặt quy tắc “cứ thấy 昨天 thì mọi 不 đều sai”.",
      "hanzi": "我昨天没去学校。",
      "pinyin": "Wǒ zuó tiān méi qù xué xiào.",
      "meaning": "Hôm qua tôi đã không đến trường.",
      "readingMinutes": 3
    },
    {
      "id": "l1108-reminder0",
      "type": "teaching",
      "title": "昨天 · hôm qua",
      "text": "Nhắc nghĩa đã học: hôm qua. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我昨天休息。",
      "pinyin": "Wǒ zuó tiān xiū xi.",
      "meaning": "Hôm qua tôi nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l1108-reminder1",
      "type": "teaching",
      "title": "去 · đi; tới (nơi khác)",
      "text": "Nhắc nghĩa đã học: đi; tới (nơi khác). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我去学校读书。",
      "pinyin": "Wǒ qù xué xiào dú shū.",
      "meaning": "Tôi đến trường để đọc sách/học.",
      "readingMinutes": 1
    },
    {
      "id": "l1108-reminder2",
      "type": "teaching",
      "title": "学校 · trường học",
      "text": "Nhắc nghĩa đã học: trường học. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这是我们的学校。",
      "pinyin": "Zhè shì wǒ men de xué xiào.",
      "meaning": "Đây là trường của chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1108-reminder3",
      "type": "teaching",
      "title": "不 · không",
      "text": "Nhắc nghĩa đã học: không. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我不是安。",
      "pinyin": "Wǒ bú shì Ān.",
      "meaning": "Tôi không phải An.",
      "readingMinutes": 1
    },
    {
      "id": "l1108-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你昨天去学校了吗？\nB：没有，我昨天没去学校。\nA：你在家吗？\nB：对，我在家。",
      "pinyin": "A: Nǐ zuó tiān qù xué xiào le ma? B: Méi yǒu, wǒ zuó tiān méi qù xué xiào. A: Nǐ zài jiā ma? B: Duì, wǒ zài jiā.",
      "meaning": "B phủ định việc đến trường hôm qua và xác nhận ở nhà. 对 trong lời đáp nghĩa “đúng”, khác giới từ 对 đã phân biệt ở bài bổ sung trước.",
      "readingMinutes": 2
    },
