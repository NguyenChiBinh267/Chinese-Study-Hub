  "blocks": [
    {
      "id": "l4023-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t0",
      "type": "teaching",
      "title": "讨论 · thảo luận",
      "text": "讨论 là trao đổi để làm rõ vấn đề; không mặc định là tranh cãi hoặc đã ra quyết định.",
      "hanzi": "我们下午讨论新的安排。",
      "pinyin": "Wǒ men xià wǔ tǎo lùn xīn de ān pái.",
      "meaning": "Chiều chúng tôi thảo luận sắp xếp mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t1",
      "type": "teaching",
      "title": "提出 · đề xuất; nêu ra",
      "text": "提出 thường đi với 问题、建议, đưa vấn đề/ý kiến ra cho người khác xem xét.",
      "hanzi": "她提出了一个具体问题。",
      "pinyin": "Tā tí chū le yí ge jù tǐ wèn tí.",
      "meaning": "Cô ấy nêu một vấn đề cụ thể.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t2",
      "type": "teaching",
      "title": "提到 · nhắc đến",
      "text": "提到 là nói tới, có thể chỉ nhắc qua; khác 提出 là chủ động nêu vấn đề/đề xuất.",
      "hanzi": "经理提到了上周的讨论。",
      "pinyin": "Jīng lǐ tí dào le shàng zhōu de tǎo lùn.",
      "meaning": "Quản lý nhắc cuộc thảo luận tuần trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t3",
      "type": "teaching",
      "title": "提供 · cung cấp",
      "text": "提供 đưa thông tin/đồ dùng để người khác dùng, không phải đồng ý một ý kiến. Nhận diện chữ 供 trong 提供; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "同事提供了新的资料。",
      "pinyin": "Tóng shì tí gōng le xīn de zī liào.",
      "meaning": "Đồng nghiệp cung cấp tư liệu mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t4",
      "type": "teaching",
      "title": "想法 · ý tưởng; suy nghĩ",
      "text": "想法 chỉ điều một người nghĩ/định làm; chưa nhất thiết là kế hoạch được chấp thuận.",
      "hanzi": "我想听听你的想法。",
      "pinyin": "Wǒ xiǎng tīng ting nǐ de xiǎng fǎ.",
      "meaning": "Tôi muốn nghe suy nghĩ của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-t5",
      "type": "teaching",
      "title": "意见 · ý kiến",
      "text": "意见 có thể là đề nghị hoặc quan điểm, cũng có nghĩa bất mãn ở ngữ cảnh khác; ở đây là góp ý công việc.",
      "hanzi": "大家都可以发表意见。",
      "pinyin": "Dà jiā dōu kě yǐ fā biǎo yì jiàn.",
      "meaning": "Mọi người đều có thể phát biểu ý kiến.",
      "readingMinutes": 1
    },
    {
      "id": "l4023-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "说什么也得… nhấn mạnh quyết tâm phải làm cho được, như phải bàn rõ vấn đề. Chỉ luyện cụm 说什么也得, không diễn giải thành mệnh lệnh buộc người khác đồng ý hoặc thành mọi biến thể 怎么着.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4023-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "会议上，小田提出时间安排的问题，经理提到上周的讨论，请同事提供资料。大家的想法不同，但都可以发表意见。小田说：“这次说什么也得先把问题讨论清楚，不能因为着急就随便决定。”最后大家约好核对资料后再作决定。",
      "pinyin": "Huì yì shàng, Xiǎo Tián tí chū shí jiān ān pái de wèn tí, jīng lǐ tí dào shàng zhōu de tǎo lùn, qǐng tóng shì tí gōng zī liào. Dà jiā de xiǎng fǎ bù tóng, dàn dōu kě yǐ fā biǎo yì jiàn. Xiǎo Tián shuō: “Zhè cì shuō shén me yě děi xiān bǎ wèn tí tǎo lùn qīng chu, bù néng yīn wèi zháo jí jiù suí biàn jué dìng.” Zuì hòu dà jiā yuē hǎo hé duì zī liào hòu zài zuò jué dìng.",
      "meaning": "Nhóm có ý khác nhau và chấp nhận nghe góp ý; họ quyết kiểm tra tư liệu trước khi ra quyết định.",
      "readingMinutes": 2
    },
    {
