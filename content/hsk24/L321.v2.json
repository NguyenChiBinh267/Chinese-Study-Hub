  "blocks": [
    {
      "id": "l321-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 交 jiāo: nộp; 通知 tōngzhī: thông báo; 次 cì: lần. 不一定 bù yídìng: chưa chắc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l321-t0",
      "type": "teaching",
      "title": "班级 · lớp học/tập thể lớp",
      "text": "班级 chỉ tập thể hoặc đơn vị lớp, khác 年级 là khối/năm học. 一个年级可以有几个班级.",
      "hanzi": "这个班级有二十名学生。",
      "pinyin": "Zhège bānjí yǒu èrshí míng xuésheng.",
      "meaning": "Lớp này có hai mươi học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l321-t1",
      "type": "teaching",
      "title": "年级 · khối lớp/năm học",
      "text": "年级 nêu cấp năm đang học; 三年级 không tự là tên lớp cụ thể như 三班.",
      "hanzi": "她是三年级的学生。",
      "pinyin": "Tā shì sān niánjí de xuésheng.",
      "meaning": "Cô ấy là học sinh lớp ba.",
      "readingMinutes": 1
    },
    {
      "id": "l321-t2",
      "type": "teaching",
      "title": "初中 · trung học cơ sở",
      "text": "初中 là bậc trung học cơ sở trong ngữ cảnh giáo dục Trung Quốc; không đồng nhất với mọi hệ thống lớp của nước khác.",
      "hanzi": "他明年上初中。",
      "pinyin": "Tā míngnián shàng chūzhōng.",
      "meaning": "Năm sau cậu ấy học trung học cơ sở.",
      "readingMinutes": 1
    },
    {
      "id": "l321-t3",
      "type": "teaching",
      "title": "学期 · học kỳ",
      "text": "学期 là học kỳ của năm học; 下个学期起 nêu mốc kỳ sau, không phải một tiết học.",
      "hanzi": "这个学期我们学中文。",
      "pinyin": "Zhège xuéqī wǒmen xué Zhōngwén.",
      "meaning": "Học kỳ này chúng tôi học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l321-t4",
      "type": "teaching",
      "title": "作业 · bài tập được giao",
      "text": "作业 chỉ bài tập/nhiệm vụ được giao để học; 做作业, 交作业 là làm và nộp bài, không phải mọi 工作 công việc.",
      "hanzi": "请明天交作业。",
      "pinyin": "Qǐng míngtiān jiāo zuòyè.",
      "meaning": "Hãy nộp bài tập ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l321-t5",
      "type": "teaching",
      "title": "页 · trang; lượng từ trang",
      "text": "页 đếm trang giấy/sách, 第十页 chỉ trang thứ mười, 十页 chỉ mười trang. Không trộn số thứ tự với số lượng.",
      "hanzi": "今天的作业在第十页。",
      "pinyin": "Jīntiān de zuòyè zài dì shí yè.",
      "meaning": "Bài tập hôm nay ở trang mười.",
      "readingMinutes": 1
    },
    {
      "id": "l321-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "从下个学期起 đánh dấu mốc bắt đầu áp dụng, không nói thời điểm kết thúc. 起 đứng sau cả cụm thời gian; so sánh 从今天起.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l321-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：从下个学期起，这个班级每周有三次中文课。小林：初中一年级都一样吗？老师：不一定，先看自己班级的通知。今天的作业在第十页，明天交。",
      "pinyin": "Lǎoshī: Cóng xià ge xuéqī qǐ, zhège bānjí měi zhōu yǒu sān cì Zhōngwén kè. Xiǎo Lín: Chūzhōng yī niánjí dōu yíyàng ma? Lǎoshī: Bù yídìng, xiān kàn zìjǐ bānjí de tōngzhī. Jīntiān de zuòyè zài dì shí yè, míngtiān jiāo.",
      "meaning": "Từ kỳ tới lớp này học tiếng Trung ba buổi một tuần. Thầy yêu cầu xem thông báo đúng lớp; bài hôm nay ở trang mười, nộp ngày mai.",
      "readingMinutes": 2
    },
    {
