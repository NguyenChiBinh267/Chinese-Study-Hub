  "blocks": [
    {
      "id": "l377-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 内 nèi: bên trong; 后缀 hòuzhuì: hậu tố; 组成 zǔchéng: cấu tạo; 类别 lèibié: loại; 单位 dānwèi: đơn vị. Đối chiếu 园/员 đồng âm, không gộp nghĩa hoặc thẻ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l377-t0",
      "type": "teaching",
      "title": "园 · vườn/khu vườn (thành tố danh từ)",
      "text": "园 là vườn/khu, thường gặp trong 公园、花园、动物园; 园内 là bên trong khu vườn trong văn viết. Không coi mọi chữ kết thúc cùng âm là cùng thành tố.",
      "hanzi": "园内有很多树。",
      "pinyin": "Yuán nèi yǒu hěn duō shù.",
      "meaning": "Bên trong vườn có nhiều cây.",
      "readingMinutes": 1
    },
    {
      "id": "l377-t1",
      "type": "teaching",
      "title": "员 · hậu tố chỉ người/thành viên",
      "text": "员 ở 服务员、运动员 là hậu tố chỉ người, không tự thay cho 人 trong mọi câu. 与园同音但意义不同.",
      "hanzi": "这位服务员很热情。",
      "pinyin": "Zhè wèi fúwùyuán hěn rèqíng.",
      "meaning": "Nhân viên phục vụ này rất niềm nở.",
      "readingMinutes": 1
    },
    {
      "id": "l377-t2",
      "type": "teaching",
      "title": "子 · hậu tố tạo danh từ (âm nhẹ)",
      "text": "子 ở 桌子、箱子 là hậu tố đọc nhẹ zi; không có nghĩa đứa con ở đây. 不把形态成分当作独立人称名词.",
      "hanzi": "箱子放在桌子下面。",
      "pinyin": "Xiāngzi fàng zài zhuōzi xiàmian.",
      "meaning": "Thùng được đặt dưới bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l377-t3",
      "type": "teaching",
      "title": "室 · phòng (thành tố danh từ)",
      "text": "室 tạo tên phòng như 教室、办公室; 室内 nói trong phòng. Không dùng cả từ 办公室 để đếm thêm mục mới lần này.",
      "hanzi": "请在室内等。",
      "pinyin": "Qǐng zài shì nèi děng.",
      "meaning": "Hãy chờ trong phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l377-t4",
      "type": "teaching",
      "title": "种 · loại; lượng từ loại",
      "text": "种 zhǒng đếm loại như 两种书; khác zhòng trồng. Hai cuốn cùng loại không tự là hai loại.",
      "hanzi": "这里有两种书。",
      "pinyin": "Zhèlǐ yǒu liǎng zhǒng shū.",
      "meaning": "Ở đây có hai loại sách.",
      "readingMinutes": 1
    },
    {
      "id": "l377-t5",
      "type": "teaching",
      "title": "张 · lượng từ vật phẳng; mở tùy kết cấu",
      "text": "张 trong 一张纸 đếm vật phẳng, 张嘴 là động từ mở. Bài luyện lượng từ, đối chiếu chức năng trong giải thích, không khẳng định mọi nghĩa đã được kiểm tra.",
      "hanzi": "请给我一张纸。",
      "pinyin": "Qǐng gěi wǒ yì zhāng zhǐ.",
      "meaning": "Hãy cho tôi một tờ giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l377-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "—员 chỉ người/thành viên trong 运动员/服务员, —子 trong 桌子/箱子 không có nghĩa “con” như mọi trường hợp. Đây là thành tố gắn, không tạo câu *他是一个员. 园、室 có thể tạo tên nơi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l377-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师在室内讲词的组成：园内的园和服务员的员同音，但一个指地方，一个是人的后缀。箱子的子读轻声。桌上有两种书和一张纸；种数类别，张数纸，不按字数猜单位。",
      "pinyin": "Lǎoshī zài shì nèi jiǎng cí de zǔchéng: Yuán nèi de yuán hé fúwùyuán de yuán tóng yīn, dàn yí ge zhǐ dìfang, yí ge shì rén de hòuzhuì. Xiāngzi de zi dú qīngshēng. Zhuō shàng yǒu liǎng zhǒng shū hé yì zhāng zhǐ; zhǒng shǔ lèibié, zhāng shǔ zhǐ, bù àn zìshù cāi dānwèi.",
      "meaning": "Thầy giảng trong phòng: 园 và 员 đồng âm nhưng khác nghĩa; 子 trong 箱子 đọc nhẹ. Hai loại sách và một tờ giấy dùng đơn vị loại và tờ, không đoán theo số chữ.",
      "readingMinutes": 2
    },
    {
