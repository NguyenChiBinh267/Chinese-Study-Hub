  "blocks": [
    {
      "id": "l1104-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1104-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Ở 我有书，他也有书, vế sau thêm thông tin tương ứng về người thứ hai. 也 đứng trước phần vị ngữ của vế sau: 他也有书. Không đặt 也 sau tân ngữ chỉ vì tiếng Việt thường nói “cũng vậy” ở cuối. Chủ thể hai vế có thể khác nhau; cần đọc chủ thể chứ không tự gộp thành cùng một người.",
      "hanzi": "我有书，他也有书。",
      "pinyin": "Wǒ yǒu shū, tā yě yǒu shū.",
      "meaning": "Tôi có sách, anh ấy cũng có sách.",
      "readingMinutes": 3
    },
    {
      "id": "l1104-reminder0",
      "type": "teaching",
      "title": "也 · cũng",
      "text": "Nhắc nghĩa đã học: cũng. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我也喜欢茶。",
      "pinyin": "Wǒ yě xǐ huan chá.",
      "meaning": "Tôi cũng thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1104-reminder1",
      "type": "teaching",
      "title": "有 · có",
      "text": "Nhắc nghĩa đã học: có. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我家有三口人。",
      "pinyin": "Wǒ jiā yǒu sān kǒu rén.",
      "meaning": "Gia đình tôi có ba người.",
      "readingMinutes": 1
    },
    {
      "id": "l1104-reminder2",
      "type": "teaching",
      "title": "书 · sách",
      "text": "Nhắc nghĩa đã học: sách. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这是我的书。",
      "pinyin": "Zhè shì wǒ de shū.",
      "meaning": "Đây là sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1104-reminder3",
      "type": "teaching",
      "title": "字 · chữ; ký tự",
      "text": "Nhắc nghĩa đã học: chữ; ký tự. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这个字怎么读？",
      "pinyin": "Zhè ge zì zěn me dú?",
      "meaning": "Chữ này đọc thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l1104-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：我有书，你呢？\nB：我也有书。\nA：我有笔，她也有笔。",
      "pinyin": "A: Wǒ yǒu shū, nǐ ne? B: Wǒ yě yǒu shū. A: Wǒ yǒu bǐ, tā yě yǒu bǐ.",
      "meaning": "A và B đều nói có sách. Ở câu cuối, A nói mình và một người nữ có bút; không suy người nữ đó chính là B.",
      "readingMinutes": 2
    },
