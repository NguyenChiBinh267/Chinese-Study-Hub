  "blocks": [
    {
      "id": "l246-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "买 là mua; 给 dẫn người nhận, 妈妈 là mẹ. Các nghĩa này được nhắc hỗ trợ, không tính thêm vào 200 từ mới HSK2.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t0",
      "type": "teaching",
      "title": "Nhắc lại · 商场 · trung tâm hoặc khu mua sắm",
      "text": "商场 là nơi có hoạt động bán hàng, không phải mọi cửa hàng nhỏ. 去商场 là đến khu mua sắm.",
      "hanzi": "我们下午去商场。",
      "pinyin": "Wǒmen xiàwǔ qù shāngchǎng.",
      "meaning": "Chiều nay chúng tôi đến khu mua sắm.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t1",
      "type": "teaching",
      "title": "Nhắc lại · 不错 · khá tốt, ổn",
      "text": "不错 thường là lời nhận xét tích cực ‘khá tốt’, không đơn thuần là ‘không có lỗi’. Nói búcuò do 不 trước thanh bốn.",
      "hanzi": "这条裤子不错。",
      "pinyin": "Zhè tiáo kùzi búcuò.",
      "meaning": "Chiếc quần này khá ổn.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t2",
      "type": "teaching",
      "title": "Nhắc lại · 每 · mỗi",
      "text": "Mỗi món dùng 每 + lượng từ + danh từ: 每条裤子. Bài chỉ dạy cách dùng đại từ này, không mở rộng nghĩa phó từ cấp cao hơn.",
      "hanzi": "这里每条裤子都是一百块。",
      "pinyin": "Zhèlǐ měi tiáo kùzi dōu shì yì bǎi kuài.",
      "meaning": "Ở đây mỗi chiếc quần đều giá một trăm tệ.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t3",
      "type": "teaching",
      "title": "Nhắc lại · 条 · lượng từ cho quần và một số vật dài",
      "text": "Trong bài dùng 条 để đếm quần: 一条裤子. Đây là lượng từ, không dạy nghĩa danh từ ‘dải’ thuộc phạm vi cao hơn.",
      "hanzi": "我要两条裤子。",
      "pinyin": "Wǒ yào liǎng tiáo kùzi.",
      "meaning": "Tôi muốn lấy hai chiếc quần.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t4",
      "type": "teaching",
      "title": "Nhắc lại · 拿 · cầm hoặc lấy bằng tay",
      "text": "拿 là cầm/lấy, không có nghĩa mua. Có thể cầm xem một món rồi không mua.",
      "hanzi": "请拿这条裤子给我看看。",
      "pinyin": "Qǐng ná zhè tiáo kùzi gěi wǒ kànkan.",
      "meaning": "Làm ơn lấy chiếc quần này cho tôi xem.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-t5",
      "type": "teaching",
      "title": "Nhắc lại · 送 · tặng hoặc trao cho người khác",
      "text": "Bài này luyện nghĩa tặng quà: 送给妈妈. Không dùng câu này để suy ra nghĩa tiễn/đưa người trong ngữ cảnh khác.",
      "hanzi": "我想买一条裤子送给妈妈。",
      "pinyin": "Wǒ xiǎng mǎi yì tiáo kùzi sòng gěi māma.",
      "meaning": "Tôi muốn mua một chiếc quần tặng mẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l246-t0-l206-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "每 đặt trước lượng từ và danh từ để nói từng món trong một tập: 每条裤子. Không dùng 每 để nói một món ngẫu nhiên chưa xác định.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l246-t0-l206-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：这条裤子不错，多少钱？乙：这里每条都是一百块。甲：请拿黑色的给我看看。我想买一条送给妈妈。",
      "pinyin": "Jiǎ: Zhè tiáo kùzi búcuò, duōshao qián? Yǐ: Zhèlǐ měi tiáo dōu shì yì bǎi kuài. Jiǎ: Qǐng ná hēisè de gěi wǒ kànkan. Wǒ xiǎng mǎi yì tiáo sòng gěi māma.",
      "meaning": "A: Chiếc quần này khá ổn, bao nhiêu tiền? B: Ở đây mỗi chiếc đều một trăm tệ. A: Làm ơn lấy chiếc màu đen cho tôi xem. Tôi muốn mua một chiếc tặng mẹ.",
      "readingMinutes": 2
    },
