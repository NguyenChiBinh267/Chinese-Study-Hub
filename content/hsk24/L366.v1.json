  "blocks": [
    {
      "id": "l366-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 管理员 guǎnlǐyuán: quản lý; 走廊 zǒuláng: hành lang; 窗 chuāng: cửa sổ. Không thao tác điện hay thiết bị thật trong ứng dụng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l366-t0",
      "type": "teaching",
      "title": "安静 · yên tĩnh",
      "text": "安静 mô tả ít ồn hoặc giữ yên lặng, khác 安全 là an toàn. 房间安静不等于所有设施安全.",
      "hanzi": "这个房间很安静。",
      "pinyin": "Zhège fángjiān hěn ānjìng.",
      "meaning": "Phòng này rất yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l366-t1",
      "type": "teaching",
      "title": "安全 · an toàn",
      "text": "安全 nói không có/ít nguy hiểm theo tiêu chí và bối cảnh; 一句安全不是专业检查凭证. Cần hỏi đúng điều kiện đang nói.",
      "hanzi": "管理员说先检查是否安全。",
      "pinyin": "Guǎnlǐyuán shuō xiān jiǎnchá shìfǒu ānquán.",
      "meaning": "Người quản lý nói cần kiểm tra an toàn trước.",
      "readingMinutes": 1
    },
    {
      "id": "l366-t2",
      "type": "teaching",
      "title": "空调 · điều hòa không khí",
      "text": "空调 là thiết bị điều hòa; 开空调 dùng bật thiết bị, không phải mở cửa. Không tự chỉ chế độ nóng/lạnh nếu chưa có ngữ cảnh.",
      "hanzi": "屋子里有空调。",
      "pinyin": "Wūzi lǐ yǒu kōngtiáo.",
      "meaning": "Trong phòng có điều hòa.",
      "readingMinutes": 1
    },
    {
      "id": "l366-t3",
      "type": "teaching",
      "title": "凉快 · mát mẻ/dễ chịu",
      "text": "凉快 nói cảm giác mát, 快 đọc nhẹ; không phải nhanh hơn. 比较凉快 là tương đối mát, không phải quá lạnh.",
      "hanzi": "开窗以后很凉快。",
      "pinyin": "Kāi chuāng yǐhòu hěn liángkuai.",
      "meaning": "Sau mở cửa sổ thì rất mát.",
      "readingMinutes": 1
    },
    {
      "id": "l366-t4",
      "type": "teaching",
      "title": "电 · điện",
      "text": "电 trong 没电了 là hết/mất điện theo đối tượng; 手机没电 là hết pin, 屋里没电 có thể mất nguồn. Bài chọn điện phòng.",
      "hanzi": "今天屋子里没有电。",
      "pinyin": "Jīntiān wūzi lǐ méiyǒu diàn.",
      "meaning": "Hôm nay trong phòng không có điện.",
      "readingMinutes": 1
    },
    {
      "id": "l366-t5",
      "type": "teaching",
      "title": "卫生间 · nhà vệ sinh/phòng vệ sinh",
      "text": "卫生间 là phòng vệ sinh, có thể có thiết bị tắm tùy nơi; không tự bảo đảm nơi nào cũng có vòi tắm.",
      "hanzi": "卫生间在走廊右边。",
      "pinyin": "Wèishēngjiān zài zǒuláng yòubian.",
      "meaning": "Nhà vệ sinh ở bên phải hành lang.",
      "readingMinutes": 1
    },
    {
      "id": "l366-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "挺安静 là khá yên tĩnh theo cảm nhận. 安静 không đồng nghĩa 安全; không kết luận an toàn điện chỉ vì phòng mát. Ở đây đọc nhận xét và việc hỏi lại người quản lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l366-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林看房间，说这里挺安静，也很凉快。管理员说今天没有电，空调不能用，凉快是因为开着窗。卫生间在右边。小林没有把安静当成安全，先问清楚检查情况。",
      "pinyin": "Xiǎo Lín kàn fángjiān, shuō zhèlǐ tǐng ānjìng, yě hěn liángkuai. Guǎnlǐyuán shuō jīntiān méiyǒu diàn, kōngtiáo bù néng yòng, liángkuai shì yīnwèi kāi zhe chuāng. Wèishēngjiān zài yòubian. Xiǎo Lín méiyǒu bǎ ānjìng dàngchéng ānquán, xiān wèn qīngchu jiǎnchá qíngkuàng.",
      "meaning": "Lâm thấy phòng khá yên và mát. Quản lý nói mất điện nên điều hòa không chạy, mát nhờ cửa mở. Cậu hỏi tình trạng kiểm tra thay vì coi yên tĩnh là an toàn.",
      "readingMinutes": 2
    },
