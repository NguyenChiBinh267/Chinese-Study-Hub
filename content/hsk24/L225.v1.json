  "blocks": [
    {
      "id": "l225-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "从 giới thiệu điểm bắt đầu; 到 giới thiệu đích. 左/右 có thể được hiểu theo hướng người đang đi, nên cần mốc rõ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l225-t0",
      "type": "teaching",
      "title": "左 · trái, phía trái",
      "text": "左 chỉ hướng trái; trái/phải thay đổi theo người và mốc, không tự là đông/tây.",
      "hanzi": "到门口往左走。",
      "pinyin": "Dào ménkǒu wǎng zuǒ zǒu.",
      "meaning": "Đến cửa thì đi về bên trái.",
      "readingMinutes": 1
    },
    {
      "id": "l225-t1",
      "type": "teaching",
      "title": "右 · phải, phía phải",
      "text": "右 đối lập với 左. Trong 往右走 là hướng đi sang phải.",
      "hanzi": "车站在右边，往右走。",
      "pinyin": "Chēzhàn zài yòubian, wǎng yòu zǒu.",
      "meaning": "Trạm ở bên phải, hãy đi sang phải.",
      "readingMinutes": 1
    },
    {
      "id": "l225-t2",
      "type": "teaching",
      "title": "往 · về phía, hướng tới",
      "text": "Trong 往学校走, 往 dẫn hướng đi. Bài này dùng giới từ chỉ hướng, không dạy các nghĩa động từ khác.",
      "hanzi": "我们往学校走。",
      "pinyin": "Wǒmen wǎng xuéxiào zǒu.",
      "meaning": "Chúng tôi đi về phía trường.",
      "readingMinutes": 1
    },
    {
      "id": "l225-t3",
      "type": "teaching",
      "title": "从 · từ điểm xuất phát",
      "text": "从 ở đây là giới từ mở đầu nơi đi: 从我家到学校. Không dạy nghĩa phó từ thuộc cấp cao hơn.",
      "hanzi": "从我家到学校很近。",
      "pinyin": "Cóng wǒ jiā dào xuéxiào hěn jìn.",
      "meaning": "Từ nhà tôi đến trường rất gần.",
      "readingMinutes": 1
    },
    {
      "id": "l225-t4",
      "type": "teaching",
      "title": "走 · đi, di chuyển bằng bước chân trong ngữ cảnh",
      "text": "走 trong 往前走 là đi theo hướng được chỉ. Không phải mọi 走 trong tiếng Trung đều mang đúng nghĩa của ví dụ này.",
      "hanzi": "请往前走。",
      "pinyin": "Qǐng wǎng qián zǒu.",
      "meaning": "Hãy đi về phía trước.",
      "readingMinutes": 1
    },
    {
      "id": "l225-t5",
      "type": "teaching",
      "title": "路上 · trên đường đi",
      "text": "上 trong 路上 đọc nhẹ theo nguồn. 路上 có thể nói khoảng thời gian đang trên đường, không chỉ mặt đường vật lý.",
      "hanzi": "我在路上，快到了。",
      "pinyin": "Wǒ zài lùshang, kuài dào le.",
      "meaning": "Tôi đang trên đường, sắp đến rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l225-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "往 đứng trước hướng hoặc nơi đến trong 往左走. Không dùng 往 để tự khẳng định đã đến đích; nó chỉ hướng di chuyển.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l225-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：从这里到书店怎么走？乙：往前走，到学校门口往右走。甲：书店远吗？乙：不远。甲：好，我在路上了。",
      "pinyin": "Jiǎ: Cóng zhèlǐ dào shūdiàn zěnme zǒu? Yǐ: Wǎng qián zǒu, dào xuéxiào ménkǒu wǎng yòu zǒu. Jiǎ: Shūdiàn yuǎn ma? Yǐ: Bù yuǎn. Jiǎ: Hǎo, wǒ zài lùshang le.",
      "meaning": "A: Từ đây đến hiệu sách đi thế nào? B: Đi thẳng phía trước, đến cổng trường thì đi sang phải. A: Hiệu sách xa không? B: Không xa. A: Được, tôi đi rồi.",
      "readingMinutes": 2
    },
