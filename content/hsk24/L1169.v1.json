  "blocks": [
    {
      "id": "l1169-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder0",
      "type": "teaching",
      "title": "真 · thật; quả là (một âm tiết)",
      "text": "Từ đã học 真 có 1 chữ. Chữ 真 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 真 với 具 / 直 / 且; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这里真好！",
      "pinyin": "Zhè lǐ zhēn hǎo!",
      "meaning": "Ở đây thật tốt!",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder1",
      "type": "teaching",
      "title": "非常 · rất; vô cùng (hai âm tiết)",
      "text": "Từ đã học 非常 có 2 chữ. Chữ 非 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 非 với 韭 / 北 / 排; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我非常喜欢这里。",
      "pinyin": "Wǒ fēi cháng xǐ huan zhè lǐ.",
      "meaning": "Tôi rất thích nơi đây.",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder2",
      "type": "teaching",
      "title": "觉得 · cảm thấy; cho rằng",
      "text": "Từ đã học 觉得 có 2 chữ. Chữ 得 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 得 với 很 / 待 / 德; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我觉得这里很好玩儿。",
      "pinyin": "Wǒ jué de zhè lǐ hěn hǎo wánr.",
      "meaning": "Tôi thấy ở đây vui.",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder3",
      "type": "teaching",
      "title": "天 · ngày (đơn vị đếm)",
      "text": "Từ đã học 天 có 1 chữ. Chữ 天 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 天 với 大 / 太 / 犬; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我休息三天。",
      "pinyin": "Wǒ xiū xi sān tiān.",
      "meaning": "Tôi nghỉ ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder4",
      "type": "teaching",
      "title": "太 · quá; rất (cảm thán)",
      "text": "Từ đã học 太 có 1 chữ. Chữ 太 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 太 với 大 / 犬 / 天; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "太冷了！",
      "pinyin": "Tài lěng le!",
      "meaning": "Lạnh quá!",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reminder5",
      "type": "teaching",
      "title": "热 · nóng",
      "text": "Từ đã học 热 có 1 chữ. Chữ 热 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 热 với 执 / 熟 / 势; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这里很热。",
      "pinyin": "Zhè lǐ hěn rè.",
      "meaning": "Ở đây nóng.",
      "readingMinutes": 1
    },
    {
      "id": "l1169-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：今天星期几？\nB：今天星期六。\nA：你明天上学吗？\nB：不，我在家。",
      "pinyin": "A: Jīn tiān xīng qī jǐ? B: Jīn tiān xīng qī liù. A: Nǐ míng tiān shàng xué ma? B: Bù, wǒ zài jiā.",
      "meaning": "Ngày trong truyện là thứ bảy; B dự định ở nhà ngày mai.",
      "readingMinutes": 2
    },
