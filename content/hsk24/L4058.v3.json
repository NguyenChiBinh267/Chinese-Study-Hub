  "blocks": [
    {
      "id": "l4058-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t0",
      "type": "teaching",
      "title": "却 · nhưng lại",
      "text": "却 thường đứng trước vị ngữ, biểu thị điều trái dự kiến. Nhận diện chữ 却 trong 却; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他很累，却没有休息。",
      "pinyin": "Tā hěn lèi, què méi yǒu xiū xi.",
      "meaning": "Anh ấy rất mệt nhưng lại không nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t1",
      "type": "teaching",
      "title": "确实 · quả thực",
      "text": "确实 xác nhận nhận định, khác 然而 chuyển ý tương phản.",
      "hanzi": "这个练习确实不容易。",
      "pinyin": "Zhè ge liàn xí què shí bù róng yì.",
      "meaning": "Bài luyện này quả thực không dễ.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t2",
      "type": "teaching",
      "title": "然而 · tuy nhiên",
      "text": "然而 thường nối hai vế tương phản trong văn viết.",
      "hanzi": "我看懂了词语，然而还不懂整段话。",
      "pinyin": "Wǒ kàn dǒng le cí yǔ, rán ér hái bù dǒng zhěng duàn huà.",
      "meaning": "Tôi hiểu từ nhưng vẫn chưa hiểu cả đoạn.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t3",
      "type": "teaching",
      "title": "相反 · ngược lại; trái ngược",
      "text": "相反 chỉ sự đối lập, không chỉ mọi khác biệt nhỏ.",
      "hanzi": "两个人的看法正好相反。",
      "pinyin": "Liǎng ge rén de kàn fǎ zhèng hǎo xiāng fǎn.",
      "meaning": "Cách nhìn của hai người trái ngược nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t4",
      "type": "teaching",
      "title": "相同 · giống nhau",
      "text": "相同 chỉ giống ở phương diện đang nói; không suy mọi mặt giống.",
      "hanzi": "他们选了相同的答案。",
      "pinyin": "Tā men xuǎn le xiāng tóng de dá àn.",
      "meaning": "Họ chọn đáp án giống nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-t5",
      "type": "teaching",
      "title": "就是 · chính là",
      "text": "就是 ở câu này nhấn xác định đối tượng; còn có cách dùng liên từ ở ngữ cảnh khác.",
      "hanzi": "这就是我要找的书。",
      "pinyin": "Zhè jiù shì wǒ yào zhǎo de shū.",
      "meaning": "Đây chính là sách tôi đang tìm.",
      "readingMinutes": 1
    },
    {
      "id": "l4058-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "然而 nối hai mệnh đề tương phản, thiên văn viết. 却 thường ở trước vị ngữ trong vế sau; không chỉ dựa bản dịch Việt để suy mọi vị trí thay thế.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4058-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "两个同学选了相同的答案，解释却正好相反。小林说：“这个练习确实不容易。我看懂了词语，然而还不懂整段话。”老师指着课文说：“这就是我们要讨论的地方。”",
      "pinyin": "Liǎng ge tóng xué xuǎn le xiāng tóng de dá àn, jiě shì què zhèng hǎo xiāng fǎn. Xiǎo Lín shuō: “Zhè ge liàn xí què shí bù róng yì. Wǒ kàn dǒng le cí yǔ, rán ér hái bù dǒng zhěng duàn huà.” Lǎo shī zhǐ zhe kè wén shuō: “Zhè jiù shì wǒ men yào tǎo lùn de dì fang.”",
      "meaning": "Cùng đáp án chưa chắc cùng cách hiểu; nhóm thảo luận cả đoạn thay vì từng từ rời.",
      "readingMinutes": 2
    },
