  "blocks": [
    {
      "id": "l301-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc trật tự chủ ngữ–động từ–tân ngữ, 不/没 và 的; HSK1/HSK2 chưa được chứng nhận. Có thể khám phá bài nháp. 查 chá: tra; 用 yòng: dùng; 然后 ránhòu: sau đó; 把 trong lời nhắc là hỗ trợ được giải nghĩa, chưa đánh giá mẫu 把. 三个/一个 nhắc lại cách đếm. Nền cần: 书 shū sách, 写 xiě viết, 看 kàn đọc/xem.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l301-t0",
      "type": "teaching",
      "title": "词典 · từ điển từ/ngữ",
      "text": "词典 giải thích từ và cách dùng; khác 课本 dùng theo khóa học và 字典 thường tra chữ. Chọn theo mục đích tra từ, không coi mọi sách tham khảo giống nhau.",
      "hanzi": "这个词我不懂，想查一下词典。",
      "pinyin": "Zhège cí wǒ bù dǒng, xiǎng chá yíxià cídiǎn.",
      "meaning": "Tôi không hiểu từ này, muốn tra từ điển.",
      "readingMinutes": 1
    },
    {
      "id": "l301-t1",
      "type": "teaching",
      "title": "课本 · sách giáo khoa/giáo trình",
      "text": "课本 là sách dùng cho môn hoặc khóa học; không đồng nghĩa riêng một bài khóa. Có thể nói 一本课本.",
      "hanzi": "请把课本打开。",
      "pinyin": "Qǐng bǎ kèběn dǎkāi.",
      "meaning": "Hãy mở giáo trình ra.",
      "readingMinutes": 1
    },
    {
      "id": "l301-t2",
      "type": "teaching",
      "title": "课文 · bài khóa",
      "text": "课文 là phần văn bản để học/đọc trong giáo trình. 一本 thường đếm sách, 一篇 đếm bài văn; 篇 chỉ là hỗ trợ, chưa tính mục từ.",
      "hanzi": "今天的课文不长。",
      "pinyin": "Jīntiān de kèwén bù cháng.",
      "meaning": "Bài khóa hôm nay không dài.",
      "readingMinutes": 1
    },
    {
      "id": "l301-t3",
      "type": "teaching",
      "title": "笔记本 · sổ ghi chép",
      "text": "笔记本 ở đây là quyển sổ để viết ghi chú. Không dùng nghĩa máy tính xách tay; cách gọi thiết bị cần ngữ cảnh khác.",
      "hanzi": "我在笔记本上写新词。",
      "pinyin": "Wǒ zài bǐjìběn shang xiě xīn cí.",
      "meaning": "Tôi viết từ mới vào sổ.",
      "readingMinutes": 1
    },
    {
      "id": "l301-t4",
      "type": "teaching",
      "title": "黑板 · bảng lớp",
      "text": "黑板 gọi bảng dùng trong lớp; không bắt buộc mọi bảng thực tế có đúng màu đen. Phân biệt đồ dùng bảng với vở cá nhân.",
      "hanzi": "老师在黑板上写了三个词。",
      "pinyin": "Lǎoshī zài hēibǎn shang xiě le sān ge cí.",
      "meaning": "Thầy viết ba từ lên bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l301-t5",
      "type": "teaching",
      "title": "句子 · câu",
      "text": "句子 diễn đạt một ý theo cấu trúc; khác một mục từ đơn lẻ. 这个句子 nói câu cụ thể, không phải cả quyển sách.",
      "hanzi": "请用这个词写一个句子。",
      "pinyin": "Qǐng yòng zhège cí xiě yí ge jùzi.",
      "meaning": "Hãy dùng từ này viết một câu.",
      "readingMinutes": 1
    },
    {
      "id": "l301-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "该……了 báo đã đến lúc làm việc: 该看课文了. Khác 应该 diễn tả nên/cần theo phán đoán. Trong bài dùng quy trình học cụ thể, không tạo nghĩa bắt buộc pháp lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l301-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：该看课文了，请打开课本。小安：这个词我不懂。老师：可以查词典，再把新词写在笔记本上。小安：黑板上的那个句子也要写吗？老师：要写，然后用新词写自己的句子。",
      "pinyin": "Lǎoshī: Gāi kàn kèwén le, qǐng dǎkāi kèběn. Xiǎo Ān: Zhège cí wǒ bù dǒng. Lǎoshī: Kěyǐ chá cídiǎn, zài bǎ xīn cí xiě zài bǐjìběn shang. Xiǎo Ān: Hēibǎn shang de nà ge jùzi yě yào xiě ma? Lǎoshī: Yào xiě, ránhòu yòng xīn cí xiě zìjǐ de jùzi.",
      "meaning": "Thầy yêu cầu mở giáo trình đọc bài khóa. An không hiểu một từ. Thầy hướng dẫn tra từ điển rồi ghi từ mới vào sổ. Câu trên bảng cũng cần ghi và sau đó tự viết câu với từ mới.",
      "readingMinutes": 2
    },
