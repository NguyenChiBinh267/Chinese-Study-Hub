  "blocks": [
    {
      "id": "l320-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 客厅 kètīng: phòng khách; 卫生间 wèishēngjiān: nhà vệ sinh; 帮忙 bāng máng: giúp một tay; 台 tái: lượng từ máy. 把 bǎ là giới từ xử trí trong mẫu đang học, khác lượng từ 一把伞.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l320-t0",
      "type": "teaching",
      "title": "搬 · chuyển/mang đồ sang nơi khác",
      "text": "搬 nhận tân ngữ đồ vật: 搬沙发. 搬家 nói chuyển nơi ở, không dùng 搬家沙发.",
      "hanzi": "请帮我把沙发搬到这里。",
      "pinyin": "Qǐng bāng wǒ bǎ shāfā bān dào zhèlǐ.",
      "meaning": "Hãy giúp tôi chuyển sofa đến đây.",
      "readingMinutes": 1
    },
    {
      "id": "l320-t1",
      "type": "teaching",
      "title": "搬家 · chuyển nhà",
      "text": "搬家 là chuyển chỗ ở; 搬到新家 nói nơi đến. Không phải chỉ thay vị trí một chiếc ghế.",
      "hanzi": "我们下周搬家。",
      "pinyin": "Wǒmen xià zhōu bān jiā.",
      "meaning": "Tuần sau chúng tôi chuyển nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l320-t2",
      "type": "teaching",
      "title": "邻居 · hàng xóm",
      "text": "邻居 là người sống gần nhà; chưa chắc là bạn bè hay người thân. 跟邻居见面 là gặp hàng xóm.",
      "hanzi": "新邻居帮我们搬东西。",
      "pinyin": "Xīn línjū bāng wǒmen bān dōngxi.",
      "meaning": "Hàng xóm mới giúp chúng tôi chuyển đồ.",
      "readingMinutes": 1
    },
    {
      "id": "l320-t3",
      "type": "teaching",
      "title": "沙发 · sofa",
      "text": "沙发 là ghế sofa; thường 一张沙发, không đồng nhất với mọi 椅子.",
      "hanzi": "客厅里有一张沙发。",
      "pinyin": "Kètīng lǐ yǒu yì zhāng shāfā.",
      "meaning": "Phòng khách có một chiếc sofa.",
      "readingMinutes": 1
    },
    {
      "id": "l320-t4",
      "type": "teaching",
      "title": "洗衣机 · máy giặt",
      "text": "洗衣机 là máy giặt quần áo; 洗衣 có nghĩa giặt áo quần, 机 là bộ phận tạo tên máy.",
      "hanzi": "洗衣机放在卫生间里。",
      "pinyin": "Xǐyījī fàng zài wèishēngjiān lǐ.",
      "meaning": "Máy giặt được đặt trong nhà vệ sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l320-t5",
      "type": "teaching",
      "title": "小区 · khu dân cư",
      "text": "小区 chỉ khu dân cư theo ngữ cảnh đô thị; không phải mọi chỗ “nhỏ” hay một thành phố.",
      "hanzi": "这个小区离学校很近。",
      "pinyin": "Zhège xiǎoqū lí xuéxiào hěn jìn.",
      "meaning": "Khu dân cư này gần trường.",
      "readingMinutes": 1
    },
    {
      "id": "l320-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把 + đồ đã xác định + 搬到 + nơi đến nhấn mạnh xử lý đồ và kết quả vị trí: 把沙发搬到客厅. 不/没 đặt trước 把; không kết thúc bằng 把沙发搬 khi thiếu kết quả/ngữ cảnh. Chưa luyện toàn bộ 把.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l320-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "我们下周搬家，新家在学校旁边的小区。邻居说可以来帮忙。我们先把沙发搬到客厅，再把洗衣机放在卫生间。今天只是准备，还没有搬完。",
      "pinyin": "Wǒmen xià zhōu bān jiā, xīn jiā zài xuéxiào pángbiān de xiǎoqū. Línjū shuō kěyǐ lái bāng máng. Wǒmen xiān bǎ shāfā bān dào kètīng, zài bǎ xǐyījī fàng zài wèishēngjiān. Jīntiān zhǐ shì zhǔnbèi, hái méiyǒu bān wán.",
      "meaning": "Gia đình chuẩn bị chuyển nhà tuần sau. Hàng xóm đề nghị giúp. Kế hoạch là sofa vào phòng khách rồi đặt máy giặt trong nhà vệ sinh; chưa chuyển xong.",
      "readingMinutes": 2
    },
