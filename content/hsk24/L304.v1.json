  "blocks": [
    {
      "id": "l304-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc trật tự chủ ngữ–động từ–tân ngữ, 不/没 và 的; HSK1/HSK2 chưa được chứng nhận. Có thể khám phá bài nháp. 认真 rènzhēn: nghiêm túc; 可是 kěshì: nhưng; 东西 dōngxi: đồ/vật; 先/再: trước/rồi. Nền sở hữu 的 được nhắc rõ bằng 不是我的/别人的.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l304-t0",
      "type": "teaching",
      "title": "别人 · người khác",
      "text": "别人 thay người không phải người đang nói hoặc người đã xác định. Không dùng 别人 để nói một quyển sách khác.",
      "hanzi": "这是我的本子，不是别人的。",
      "pinyin": "Zhè shì wǒ de běnzi, bú shì biérén de.",
      "meaning": "Đây là vở tôi, không phải của người khác.",
      "readingMinutes": 1
    },
    {
      "id": "l304-t1",
      "type": "teaching",
      "title": "别的 · khác/cái khác",
      "text": "别的 bổ nghĩa hoặc thay đồ/người khác tùy ngữ cảnh. 别的方法 là phương pháp khác; khác 别人 chỉ người.",
      "hanzi": "这个方法不行，我们试试别的。",
      "pinyin": "Zhège fāngfǎ bù xíng, wǒmen shìshi biéde.",
      "meaning": "Cách này không được, chúng ta thử cách khác.",
      "readingMinutes": 1
    },
    {
      "id": "l304-t2",
      "type": "teaching",
      "title": "需要 · cần",
      "text": "需要 diễn tả nhu cầu của người hoặc việc. 我需要词典 nói tôi cần từ điển, không phải đã có từ điển.",
      "hanzi": "我需要一本词典。",
      "pinyin": "Wǒ xūyào yì běn cídiǎn.",
      "meaning": "Tôi cần một quyển từ điển.",
      "readingMinutes": 1
    },
    {
      "id": "l304-t3",
      "type": "teaching",
      "title": "应该 · nên/phải theo điều hợp lý",
      "text": "应该 nêu điều nên làm theo lời khuyên hoặc phán đoán. 你应该问老师 là nên hỏi thầy; không mặc nhiên là luật bắt buộc.",
      "hanzi": "不懂的时候，你应该问老师。",
      "pinyin": "Bù dǒng de shíhou, nǐ yīnggāi wèn lǎoshī.",
      "meaning": "Khi không hiểu, bạn nên hỏi thầy.",
      "readingMinutes": 1
    },
    {
      "id": "l304-t4",
      "type": "teaching",
      "title": "一定 · nhất định/chắc chắn",
      "text": "一定 trong 我一定会努力 bày tỏ quyết tâm; trong 他一定知道 là phán đoán chắc. Không biến lời quyết tâm thành bằng chứng năng lực thực tế.",
      "hanzi": "我一定会认真复习。",
      "pinyin": "Wǒ yídìng huì rènzhēn fùxí.",
      "meaning": "Tôi nhất định sẽ ôn nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l304-t5",
      "type": "teaching",
      "title": "怎样 · thế nào/bằng cách nào",
      "text": "怎样 thường hỏi cách làm hoặc tình trạng theo ngữ cảnh. 怎样复习 hỏi cách ôn, không hỏi một con số.",
      "hanzi": "你怎样复习新词？",
      "pinyin": "Nǐ zěnyàng fùxí xīn cí?",
      "meaning": "Bạn ôn từ mới bằng cách nào?",
      "readingMinutes": 1
    },
    {
      "id": "l304-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "怎样+动词 hỏi cách thực hiện, như 怎样复习. Trả lời bằng cách làm hoặc trình tự, không trả lời chỉ bằng tên đồ vật. 应该 là lời khuyên/phán đoán; 需要 nêu nhu cầu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l304-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我需要词典，可是这本不是我的。老师：别人的东西要先问，再用。小安：我应该怎样复习？老师：可以先读句子，再试试别的方法。小安：我一定会认真试一试。",
      "pinyin": "Xiǎo Ān: Wǒ xūyào cídiǎn, kěshì zhè běn bú shì wǒ de. Lǎoshī: Biérén de dōngxi yào xiān wèn, zài yòng. Xiǎo Ān: Wǒ yīnggāi zěnyàng fùxí? Lǎoshī: Kěyǐ xiān dú jùzi, zài shìshi biéde fāngfǎ. Xiǎo Ān: Wǒ yídìng huì rènzhēn shì yi shì.",
      "meaning": "An cần từ điển nhưng quyển này không phải của mình. Thầy nhắc hỏi trước khi dùng đồ người khác. An hỏi cách ôn; thầy gợi ý đọc câu rồi thử cách khác. An quyết tâm thử nghiêm túc.",
      "readingMinutes": 2
    },
