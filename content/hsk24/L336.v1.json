  "blocks": [
    {
      "id": "l336-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 称 chēng: cân; 根 gēn: lượng từ chuối; 店员 diànyuán: nhân viên bán hàng; 重量 zhòngliàng: khối lượng/cân nặng theo ngữ cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l336-t0",
      "type": "teaching",
      "title": "香蕉 · chuối",
      "text": "香蕉 là chuối; 根 đếm quả trong ví dụ. Không lấy 香蕉 làm tên gọi mọi trái cây vàng.",
      "hanzi": "我买了三根香蕉。",
      "pinyin": "Wǒ mǎi le sān gēn xiāngjiāo.",
      "meaning": "Tôi mua ba quả chuối.",
      "readingMinutes": 1
    },
    {
      "id": "l336-t1",
      "type": "teaching",
      "title": "新鲜 · tươi/mới mẻ",
      "text": "新鲜 khi nói thực phẩm là tươi, khác 新 là mới theo thời gian sử dụng. Nhãn mô tả không thay kiểm tra an toàn thực phẩm.",
      "hanzi": "今天的水果很新鲜。",
      "pinyin": "Jīntiān de shuǐguǒ hěn xīnxiān.",
      "meaning": "Trái cây hôm nay rất tươi.",
      "readingMinutes": 1
    },
    {
      "id": "l336-t2",
      "type": "teaching",
      "title": "瓶子 · chai/lọ",
      "text": "瓶子 là vật chứa; 一瓶水 dùng 瓶 làm lượng từ. 瓶子空了 không có nghĩa nước là chai.",
      "hanzi": "这个瓶子里是水。",
      "pinyin": "Zhège píngzi lǐ shì shuǐ.",
      "meaning": "Trong chai này là nước.",
      "readingMinutes": 1
    },
    {
      "id": "l336-t3",
      "type": "teaching",
      "title": "酒 · rượu/đồ uống có cồn",
      "text": "酒 là tên chung đồ uống có cồn; 不喝酒 nói không uống đồ có cồn, không chỉ riêng bia.",
      "hanzi": "我今天不喝酒。",
      "pinyin": "Wǒ jīntiān bù hē jiǔ.",
      "meaning": "Hôm nay tôi không uống rượu bia.",
      "readingMinutes": 1
    },
    {
      "id": "l336-t4",
      "type": "teaching",
      "title": "啤酒 · bia",
      "text": "啤酒 là một loại 酒; hỏi bia cụ thể cần đúng từ, không suy ra mọi 酒 là bia. Bài không khuyến khích uống.",
      "hanzi": "这不是水，是啤酒。",
      "pinyin": "Zhè bú shì shuǐ, shì píjiǔ.",
      "meaning": "Đây không phải nước, là bia.",
      "readingMinutes": 1
    },
    {
      "id": "l336-t5",
      "type": "teaching",
      "title": "公斤 · kilôgam",
      "text": "公斤 là đơn vị khối lượng kg; 一公斤香蕉 chỉ lượng cân, không đếm số quả. Không nhầm với 公里 kilômét.",
      "hanzi": "请称一公斤香蕉。",
      "pinyin": "Qǐng chēng yì gōngjīn xiāngjiāo.",
      "meaning": "Hãy cân một kilôgam chuối.",
      "readingMinutes": 1
    },
    {
      "id": "l336-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "公斤 là kilôgam; 一公斤等于两斤 trong đơn vị thị cân đại lục đang dùng, không suy ra mọi địa phương cùng chuẩn 斤. Bài chỉ chấm 公斤 theo nhãn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l336-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林买了一公斤新鲜香蕉。小王拿起一个瓶子，问是不是水。店员说：那是啤酒，水在左边。小王不喝酒，换了一瓶水。小林说：一公斤是重量，不是香蕉的根数。",
      "pinyin": "Xiǎo Lín mǎi le yì gōngjīn xīnxiān xiāngjiāo. Xiǎo Wáng ná qǐ yí ge píngzi, wèn shì bu shì shuǐ. Diànyuán shuō: Nà shì píjiǔ, shuǐ zài zuǒbian. Xiǎo Wáng bù hē jiǔ, huàn le yì píng shuǐ. Xiǎo Lín shuō: Yì gōngjīn shì zhòngliàng, bú shì xiāngjiāo de gēn shù.",
      "meaning": "Lâm mua một kg chuối tươi. Vương hỏi chai có phải nước không, biết là bia nên đổi nước. Một kg là khối lượng, không phải số quả.",
      "readingMinutes": 2
    },
    {
      "id": "l336-b0",
      "type": "exercise",
      "exerciseVersionId": "l336-v1-e0"
