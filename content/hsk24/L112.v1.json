  "blocks": [
    {
      "id": "l112-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l112-t0",
      "type": "teaching",
      "title": "哪 · nào",
      "text": "哪 chọn trong các khả năng; 你读哪本书 hỏi quyển nào, không hỏi số lượng.",
      "hanzi": "你读哪本书？",
      "pinyin": "Nǐ dú nǎ běn shū?",
      "meaning": "Bạn đọc quyển sách nào?",
      "readingMinutes": 1
    },
    {
      "id": "l112-t1",
      "type": "teaching",
      "title": "东西 · đồ; vật",
      "text": "东西 trong câu đồ vật đọc dōng xi; không dùng nghĩa hướng đông/tây để dịch máy móc.",
      "hanzi": "这是什么东西？",
      "pinyin": "Zhè shì shén me dōng xi?",
      "meaning": "Đây là đồ gì?",
      "readingMinutes": 1
    },
    {
      "id": "l112-t2",
      "type": "teaching",
      "title": "字 · chữ; ký tự",
      "text": "字 nói một chữ; một từ có thể có nhiều chữ như 你好.",
      "hanzi": "这个字怎么读？",
      "pinyin": "Zhè ge zì zěn me dú?",
      "meaning": "Chữ này đọc thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l112-t3",
      "type": "teaching",
      "title": "汉字 · chữ Hán",
      "text": "汉字 là hệ chữ đang học; pinyin viết bằng chữ Latin không tự là 汉字.",
      "hanzi": "我喜欢汉字。",
      "pinyin": "Wǒ xǐ huan Hàn zì.",
      "meaning": "Tôi thích chữ Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l112-t4",
      "type": "teaching",
      "title": "读 · đọc",
      "text": "读 là hành động đọc; 读书 còn là tổ hợp/mục từ riêng sẽ học sau.",
      "hanzi": "我读这本书。",
      "pinyin": "Wǒ dú zhè běn shū.",
      "meaning": "Tôi đọc quyển sách này.",
      "readingMinutes": 1
    },
    {
      "id": "l112-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "哪 hỏi lựa chọn trong một tập hợp: 你读哪本书？哪 + lượng từ + danh từ vẫn ở vị trí đối tượng cần hỏi. 字 là một chữ; 汉字 là chữ Hán, còn 东西 nói đồ/vật trong tình huống này. 读 có thể đọc thành tiếng hoặc đọc nội dung theo câu; bài chữ không đánh giá phát âm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l112-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你读哪本书？\nB：我读这本书。\nA：这是什么字？\nB：这是“人”字。\nA：好，我喜欢汉字。",
      "pinyin": "A: Nǐ dú nǎ běn shū? B: Wǒ dú zhè běn shū. A: Zhè shì shén me zì? B: Zhè shì “rén” zì. A: Hǎo, wǒ xǐ huan Hàn zì.",
      "meaning": "怎么 zěn me = thế nào trong ví dụ. Đoạn chỉ rõ chữ đang được hỏi là 人; không yêu cầu đoán nội dung một cuốn sách không hiển thị.",
      "readingMinutes": 2
    },
    {
