  "blocks": [
    {
      "id": "l153-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l153-t0",
      "type": "teaching",
      "title": "早饭 · bữa sáng",
      "text": "早饭 gọi bữa sáng, khác từ thời gian 早上 dù hai từ thường cùng xuất hiện.",
      "hanzi": "我吃早饭。",
      "pinyin": "Wǒ chī zǎo fàn.",
      "meaning": "Tôi ăn sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l153-t1",
      "type": "teaching",
      "title": "午饭 · bữa trưa",
      "text": "午饭 là bữa trưa, không phải cả khoảng thời gian 中午.",
      "hanzi": "我中午吃午饭。",
      "pinyin": "Wǒ zhōng wǔ chī wǔ fàn.",
      "meaning": "Tôi ăn trưa vào buổi trưa.",
      "readingMinutes": 1
    },
    {
      "id": "l153-t2",
      "type": "teaching",
      "title": "晚饭 · bữa tối",
      "text": "晚饭 là bữa tối; không dùng nó thay mọi câu nói muộn/trễ của 晚.",
      "hanzi": "我晚上吃晚饭。",
      "pinyin": "Wǒ wǎn shang chī wǎn fàn.",
      "meaning": "Tôi ăn tối vào buổi tối.",
      "readingMinutes": 1
    },
    {
      "id": "l153-t3",
      "type": "teaching",
      "title": "饭 · cơm; bữa ăn (theo ngữ cảnh)",
      "text": "饭 trong 吃饭 có thể nói ăn một bữa, không luôn chỉ riêng cơm trắng.",
      "hanzi": "我吃饭。",
      "pinyin": "Wǒ chī fàn.",
      "meaning": "Tôi ăn cơm/ăn bữa.",
      "readingMinutes": 1
    },
    {
      "id": "l153-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "吃饭 là ăn cơm/ăn bữa, không buộc món ăn luôn là 米饭. 早饭/午饭/晚饭 gọi bữa sáng/trưa/tối; dùng trước/sau 吃 theo câu đã cho, không suy mọi bữa đều ở một giờ giống nhau. 吃 được chú giải và sẽ học riêng ở bài kế tiếp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l153-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你吃早饭了吗？\nB：吃了。\nA：你什么时候吃午饭？\nB：我中午吃午饭。",
      "pinyin": "A: Nǐ chī zǎo fàn le ma? B: Chī le. A: Nǐ shén me shí hou chī wǔ fàn? B: Wǒ zhōng wǔ chī wǔ fàn.",
      "meaning": "吃 chī = ăn; 吃了 ở đây trả lời đã ăn. B đã ăn sáng và nói ăn trưa vào buổi trưa, không nêu giờ cụ thể.",
      "readingMinutes": 2
    },
