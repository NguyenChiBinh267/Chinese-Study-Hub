  "blocks": [
    {
      "id": "l211-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "我/我的 là tôi/của tôi; 过生日 là đón sinh nhật. Nêu tuổi, ngày và quan hệ không đồng nghĩa đã làm chủ toàn bộ HSK1.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l211-t0",
      "type": "teaching",
      "title": "妻子 · vợ",
      "text": "妻子 chỉ người vợ, không phải mọi phụ nữ đã kết hôn trong câu. 子 đọc nhẹ.",
      "hanzi": "这是我的妻子。",
      "pinyin": "Zhè shì wǒ de qīzi.",
      "meaning": "Đây là vợ tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l211-t1",
      "type": "teaching",
      "title": "丈夫 · chồng",
      "text": "丈夫 trong quan hệ gia đình là chồng; 夫 đọc nhẹ. Không dịch theo từng chữ thành đàn ông nói chung.",
      "hanzi": "她的丈夫是老师。",
      "pinyin": "Tā de zhàngfu shì lǎoshī.",
      "meaning": "Chồng cô ấy là giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l211-t2",
      "type": "teaching",
      "title": "奶奶 · bà nội",
      "text": "奶奶 trong gia đình là mẹ của bố; không dùng thay cho mọi bà ngoại. Âm thứ hai đọc nhẹ.",
      "hanzi": "奶奶是爸爸的妈妈。",
      "pinyin": "Nǎinai shì bàba de māma.",
      "meaning": "Bà nội là mẹ của bố.",
      "readingMinutes": 1
    },
    {
      "id": "l211-t3",
      "type": "teaching",
      "title": "爷爷 · ông nội",
      "text": "爷爷 là bố của bố khi nói quan hệ gia đình. Âm thứ hai đọc nhẹ.",
      "hanzi": "爷爷喜欢喝茶。",
      "pinyin": "Yéye xǐhuan hē chá.",
      "meaning": "Ông nội thích uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l211-t4",
      "type": "teaching",
      "title": "生日 · sinh nhật",
      "text": "Hỏi ngày sinh nhật dùng 你的生日是几月几号. 生日 là ngày sinh nhật, không phải số tuổi.",
      "hanzi": "今天是奶奶的生日。",
      "pinyin": "Jīntiān shì nǎinai de shēngrì.",
      "meaning": "Hôm nay là sinh nhật bà nội.",
      "readingMinutes": 1
    },
    {
      "id": "l211-t5",
      "type": "teaching",
      "title": "一起 · cùng nhau",
      "text": "一起 nói cùng tham gia hoạt động. 一 ở đây đọc yì trong mục từ nguồn; không đổi thành yī khi trả lời pinyin của từ này.",
      "hanzi": "我们一起吃饭吧。",
      "pinyin": "Wǒmen yìqǐ chī fàn ba.",
      "meaning": "Chúng ta cùng ăn cơm nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l211-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一起 đặt trước hoạt động để nói cùng làm: 一起吃饭. Cùng tham gia không có nghĩa mọi người có cùng quan hệ gia đình.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l211-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "今天是奶奶的生日。我和妻子去看奶奶，爷爷也在家。我们一起吃饭。奶奶说：今天我很高兴。",
      "pinyin": "Jīntiān shì nǎinai de shēngrì. Wǒ hé qīzi qù kàn nǎinai, yéye yě zài jiā. Wǒmen yìqǐ chī fàn. Nǎinai shuō: Jīntiān wǒ hěn gāoxìng.",
      "meaning": "Hôm nay là sinh nhật bà nội. Tôi cùng vợ đến thăm bà, ông nội cũng ở nhà. Chúng tôi cùng ăn cơm. Bà nói: Hôm nay bà rất vui.",
      "readingMinutes": 2
    },
    {
