  "blocks": [
    {
      "id": "l279-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder0",
      "type": "teaching",
      "title": "酒店 · khách sạn",
      "text": "酒店 ở đây là nơi ở khi đi xa; không nhầm với 饭馆 là nơi ăn.",
      "hanzi": "这家酒店离机场很近。",
      "pinyin": "Zhè jiā jiǔdiàn lí jīchǎng hěn jìn.",
      "meaning": "Khách sạn này rất gần sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder1",
      "type": "teaching",
      "title": "旅游 · đi du lịch",
      "text": "旅游 là đi để tham quan, nghỉ hoặc trải nghiệm, không dùng cho mọi lần đi làm xa. Giữ âm ü trong lǚ.",
      "hanzi": "我们想去中国旅游。",
      "pinyin": "Wǒmen xiǎng qù Zhōngguó lǚyóu.",
      "meaning": "Chúng tôi muốn đi du lịch Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder2",
      "type": "teaching",
      "title": "准备 · chuẩn bị",
      "text": "准备 có thể nói chuẩn bị đồ/việc hoặc dự định làm gì; bài tập nghĩa ở đây là chuẩn bị cho chuyến đi.",
      "hanzi": "我在准备明天的东西。",
      "pinyin": "Wǒ zài zhǔnbèi míngtiān de dōngxi.",
      "meaning": "Tôi đang chuẩn bị đồ cho ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder3",
      "type": "teaching",
      "title": "近 · gần",
      "text": "近 đối lập với 远. Cùng âm jìn với 进 nhưng chữ và nghĩa khác.",
      "hanzi": "学校离我家很近。",
      "pinyin": "Xuéxiào lí wǒ jiā hěn jìn.",
      "meaning": "Trường rất gần nhà tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder4",
      "type": "teaching",
      "title": "远 · xa",
      "text": "远 mô tả khoảng cách lớn so với mốc; nếu không có số đo thì chưa biết chính xác bao nhiêu mét.",
      "hanzi": "车站离这里很远。",
      "pinyin": "Chēzhàn lí zhèlǐ hěn yuǎn.",
      "meaning": "Ga ở rất xa đây.",
      "readingMinutes": 1
    },
    {
      "id": "l279-reminder5",
      "type": "teaching",
      "title": "路 · đường đi",
      "text": "路 là đường; 问路 là hỏi đường, không hỏi tên phương tiện.",
      "hanzi": "这条路上有一家饭馆。",
      "pinyin": "Zhè tiáo lù shang yǒu yì jiā fànguǎn.",
      "meaning": "Trên con đường này có một quán ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l279-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：明天去旅游，你准备好了吗？乙：机票已经买了。我们早上去机场。甲：住哪里？乙：住机场旁边的酒店。",
      "pinyin": "Jiǎ: Míngtiān qù lǚyóu, nǐ zhǔnbèi hǎo le ma? Yǐ: Jīpiào yǐjīng mǎi le. Wǒmen zǎoshang qù jīchǎng. Jiǎ: Zhù nǎlǐ? Yǐ: Zhù jīchǎng pángbiān de jiǔdiàn.",
      "meaning": "A: Mai đi du lịch, bạn chuẩn bị xong chưa? B: Vé máy bay đã mua rồi. Sáng chúng ta đến sân bay. A: Ở đâu? B: Ở khách sạn bên cạnh sân bay.",
      "readingMinutes": 2
    },
    {
      "id": "l279-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：从这里到学校远吗？乙：不远，走路十分钟。甲：在哪儿等你？乙：在学校门口。",
      "pinyin": "Jiǎ: Cóng zhèlǐ dào xuéxiào yuǎn ma? Yǐ: Bù yuǎn, zǒulù shí fēnzhōng. Jiǎ: Zài nǎr děng nǐ? Yǐ: Zài xuéxiào ménkǒu.",
      "meaning": "A: Từ đây đến trường có xa không? B: Không xa, đi bộ mười phút. A: Đợi bạn ở đâu? B: Ở cổng trường.",
      "readingMinutes": 2
    },
