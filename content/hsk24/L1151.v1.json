  "blocks": [
    {
      "id": "l1151-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder0",
      "type": "teaching",
      "title": "你 · bạn",
      "text": "Từ đã học 你 có 1 chữ. Chữ 你 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 你 với 他 / 休 / 们; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：你好！我叫安。\nB：你好！",
      "pinyin": "A: nǐ hǎo! wǒ jiào Ān.\nB: nǐ hǎo!",
      "meaning": "A: Xin chào! Tôi tên là An.\nB: Xin chào!",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder1",
      "type": "teaching",
      "title": "叫 · tên là / được gọi",
      "text": "Từ đã học 叫 có 1 chữ. Chữ 叫 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 叫 với 叩 / 叶 / 吓; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：你好！我叫安。\nB：你好！",
      "pinyin": "A: nǐ hǎo! wǒ jiào Ān.\nB: nǐ hǎo!",
      "meaning": "A: Xin chào! Tôi tên là An.\nB: Xin chào!",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder2",
      "type": "teaching",
      "title": "呢 · trợ từ hỏi lại trong ví dụ",
      "text": "Từ đã học 呢 có 1 chữ. Chữ 呢 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 呢 với 泥 / 尼 / 听; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：我叫安。你呢？",
      "pinyin": "A: wǒ jiào Ān. nǐ ne?",
      "meaning": "A: Tôi tên là An. Còn bạn thì sao?",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder3",
      "type": "teaching",
      "title": "我 · tôi",
      "text": "Từ đã học 我 có 1 chữ. Chữ 我 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 我 với 找 / 战 / 划; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：你好！我叫安。\nB：你好！",
      "pinyin": "A: nǐ hǎo! wǒ jiào Ān.\nB: nǐ hǎo!",
      "meaning": "A: Xin chào! Tôi tên là An.\nB: Xin chào!",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder4",
      "type": "teaching",
      "title": "好 · tốt; được",
      "text": "Từ đã học 好 có 1 chữ. Chữ 好 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 好 với 妈 / 她 / 如; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "好，我喝茶。",
      "pinyin": "Hǎo, wǒ hē chá.",
      "meaning": "Được, tôi uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reminder5",
      "type": "teaching",
      "title": "喜欢 · thích",
      "text": "Từ đã học 喜欢 có 2 chữ. Chữ 喜 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 喜 với 吉 / 善 / 嘉; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：我喜欢茶。你呢？\nB：我喜欢喝茶。",
      "pinyin": "A: wǒ xǐ huan chá. nǐ ne?\nB: wǒ xǐ huan hē chá.",
      "meaning": "A: Tôi thích trà. Còn bạn?\nB: Tôi thích uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1151-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你叫什么名字？\nB：我叫林。你呢？\nA：我叫安。",
      "pinyin": "A: Nǐ jiào shén me míng zi? B: Wǒ jiào Lín. Nǐ ne? A: Wǒ jiào Ān.",
      "meaning": "An và Linh giới thiệu tên. Không đoán giới tính từ tên.",
      "readingMinutes": 2
    },
