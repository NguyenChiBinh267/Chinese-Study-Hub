  "blocks": [
    {
      "id": "l1174-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder0",
      "type": "teaching",
      "title": "鸡蛋 · trứng gà",
      "text": "Từ đã học 鸡蛋 có 2 chữ. Chữ 蛋 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 蛋 với 虫 / 贵 / 虽; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有三个鸡蛋。",
      "pinyin": "Wǒ yǒu sān ge jī dàn.",
      "meaning": "Tôi có ba quả trứng gà.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder1",
      "type": "teaching",
      "title": "超市 · siêu thị",
      "text": "Từ đã học 超市 có 2 chữ. Chữ 市 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 市 với 巾 / 币 / 布; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那是超市。",
      "pinyin": "Nà shì chāo shì.",
      "meaning": "Kia là siêu thị.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder2",
      "type": "teaching",
      "title": "便宜 · rẻ; không đắt",
      "text": "Từ đã học 便宜 có 2 chữ. Chữ 便 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 便 với 使 / 更 / 硬; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这本书很便宜。",
      "pinyin": "Zhè běn shū hěn pián yi.",
      "meaning": "Quyển sách này rẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder3",
      "type": "teaching",
      "title": "元 · đồng/nguyên (đơn vị yuán trong ví dụ)",
      "text": "Từ đã học 元 có 1 chữ. Chữ 元 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 元 với 无 / 天 / 园; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这本书十元。",
      "pinyin": "Zhè běn shū shí yuán.",
      "meaning": "Quyển sách này10nguyên trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder4",
      "type": "teaching",
      "title": "多 · nhiều",
      "text": "Từ đã học 多 có 1 chữ. Chữ 多 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 多 với 少 / 夕 / 名; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我的书很多。",
      "pinyin": "Wǒ de shū hěn duō.",
      "meaning": "Sách của tôi nhiều.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reminder5",
      "type": "teaching",
      "title": "少 · ít",
      "text": "Từ đã học 少 có 1 chữ. Chữ 少 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 少 với 小 / 沙 / 步; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我的书很少。",
      "pinyin": "Wǒ de shū hěn shǎo.",
      "meaning": "Sách của tôi ít.",
      "readingMinutes": 1
    },
    {
      "id": "l1174-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你房间里有什么？\nB：有桌子、椅子和书。\nA：你的书多吗？\nB：很多。",
      "pinyin": "A: Nǐ fáng jiān li yǒu shén me? B: Yǒu zhuō zi, yǐ zi hé shū. A: Nǐ de shū duō ma? B: Hěn duō.",
      "meaning": "B kể bàn, ghế, sách và nói sách nhiều; không nêu con số cụ thể.",
      "readingMinutes": 2
    },
