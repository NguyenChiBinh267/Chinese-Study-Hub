  "blocks": [
    {
      "id": "l317-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 兄妹 xiōngmèi: anh trai và em gái; phối ngẫu là vợ/chồng theo ngữ cảnh, không suy ra giới tính từ 他/她 trong lời kể. 什么…的 ôn cách hỏi thời điểm sự kiện đã biết.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l317-t0",
      "type": "teaching",
      "title": "阿姨 · dì/cô; cách gọi phụ nữ lớn tuổi hơn",
      "text": "阿姨 có thể là em/chị của mẹ hoặc cách xưng hô lịch sự với phụ nữ thế hệ cha mẹ; không tự suy ra quan hệ máu mủ.",
      "hanzi": "这是我妈妈的妹妹，我叫她阿姨。",
      "pinyin": "Zhè shì wǒ māma de mèimei, wǒ jiào tā āyí.",
      "meaning": "Đây là em gái mẹ tôi, tôi gọi là dì.",
      "readingMinutes": 1
    },
    {
      "id": "l317-t1",
      "type": "teaching",
      "title": "爱人 · vợ hoặc chồng",
      "text": "爱人 trong giới thiệu gia đình ở đây chỉ người phối ngẫu, không phải bất kỳ người mình thích; 人 đọc nhẹ.",
      "hanzi": "这是我的爱人，我们去年结婚了。",
      "pinyin": "Zhè shì wǒ de àiren, wǒmen qùnián jié hūn le.",
      "meaning": "Đây là vợ/chồng tôi, chúng tôi kết hôn năm ngoái.",
      "readingMinutes": 1
    },
    {
      "id": "l317-t2",
      "type": "teaching",
      "title": "夫妻 · vợ chồng",
      "text": "夫妻 chỉ một cặp vợ chồng; 他们是夫妻 xác định quan hệ giữa hai người, không dùng cho anh chị em.",
      "hanzi": "他们是夫妻，不是兄妹。",
      "pinyin": "Tāmen shì fūqī, bú shì xiōngmèi.",
      "meaning": "Họ là vợ chồng, không phải anh em.",
      "readingMinutes": 1
    },
    {
      "id": "l317-t3",
      "type": "teaching",
      "title": "见面 · gặp mặt",
      "text": "见面 thường đi với 跟/和 để nêu người gặp; tân ngữ người không đặt ngay sau toàn từ.",
      "hanzi": "我们周末跟朋友见面。",
      "pinyin": "Wǒmen zhōumò gēn péngyou jiàn miàn.",
      "meaning": "Cuối tuần chúng tôi gặp bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l317-t4",
      "type": "teaching",
      "title": "结婚 · kết hôn",
      "text": "结婚 là sự kiện lập gia đình; 跟他结婚 chứ không dùng 结婚他. 去年结婚了 nói sự kiện quá khứ.",
      "hanzi": "叔叔去年结婚了。",
      "pinyin": "Shūshu qùnián jié hūn le.",
      "meaning": "Chú kết hôn năm ngoái.",
      "readingMinutes": 1
    },
    {
      "id": "l317-t5",
      "type": "teaching",
      "title": "叔叔 · chú; cách gọi nam giới thế hệ cha mẹ",
      "text": "叔叔 có thể chỉ em trai của bố; cũng dùng xưng hô với đàn ông thế hệ cha mẹ. Đây không phải tên mọi người lớn.",
      "hanzi": "他是爸爸的弟弟，我叫他叔叔。",
      "pinyin": "Tā shì bàba de dìdi, wǒ jiào tā shūshu.",
      "meaning": "Ông ấy là em trai bố tôi, tôi gọi là chú.",
      "readingMinutes": 1
    },
    {
      "id": "l317-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "见面 và 结婚 là kết cấu động–tân có thể tách: 跟朋友见面, 见过一次面, 结了婚. Không nói 见面他; dùng 跟他见面. Trong bài luyện kết cấu 跟…见面; chưa đánh giá mọi dạng tách.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l317-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：周末跟谁见面？小王：跟叔叔和他的爱人。小林：他们什么时候结婚的？小王：去年。他们是夫妻。我妈妈的妹妹也来，我叫她阿姨。",
      "pinyin": "Xiǎo Lín: Zhōumò gēn shéi jiàn miàn? Xiǎo Wáng: Gēn shūshu hé tā de àiren. Xiǎo Lín: Tāmen shì shénme shíhou jié hūn de? Xiǎo Wáng: Qùnián. Tāmen shì fūqī. Wǒ māma de mèimei yě lái, wǒ jiào tā āyí.",
      "meaning": "Vương sẽ gặp chú và người phối ngẫu vào cuối tuần; họ cưới năm ngoái. Em gái mẹ cũng đến.",
      "readingMinutes": 2
    },
