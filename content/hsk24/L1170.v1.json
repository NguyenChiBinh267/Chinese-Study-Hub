  "blocks": [
    {
      "id": "l1170-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder0",
      "type": "teaching",
      "title": "非常 · rất; vô cùng (hai âm tiết)",
      "text": "Từ đã học 非常 có 2 chữ. Chữ 常 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 常 với 堂 / 带 / 掌; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我非常喜欢这里。",
      "pinyin": "Wǒ fēi cháng xǐ huan zhè lǐ.",
      "meaning": "Tôi rất thích nơi đây.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder1",
      "type": "teaching",
      "title": "明天 · ngày mai",
      "text": "Từ đã học 明天 có 2 chữ. Chữ 明 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 明 với 朋 / 阳 / 胡; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我明天上班。",
      "pinyin": "Wǒ míng tiān shàng bān.",
      "meaning": "Ngày mai tôi đi làm.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder2",
      "type": "teaching",
      "title": "现在 · bây giờ; hiện tại",
      "text": "Từ đã học 现在 có 2 chữ. Chữ 现 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 现 với 见 / 玩 / 规; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我现在在学校。",
      "pinyin": "Wǒ xiàn zài zài xué xiào.",
      "meaning": "Bây giờ tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder3",
      "type": "teaching",
      "title": "号 · ngày trong tháng (dạng hào)",
      "text": "Từ đã học 号 có 1 chữ. Chữ 号 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 号 với 只 / 口 / 召; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "五月三号。",
      "pinyin": "Wǔ yuè sān hào.",
      "meaning": "Ngày3 tháng5.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder4",
      "type": "teaching",
      "title": "日 · ngày trong tháng (dạng rì)",
      "text": "Từ đã học 日 có 1 chữ. Chữ 日 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 日 với 目 / 白 / 曰; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "五月三日。",
      "pinyin": "Wǔ yuè sān rì.",
      "meaning": "Ngày3 tháng5.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reminder5",
      "type": "teaching",
      "title": "星期 · tuần; yếu tố gọi thứ",
      "text": "Từ đã học 星期 có 2 chữ. Chữ 期 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 期 với 旗 / 棋 / 其; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "今天星期一。",
      "pinyin": "Jīn tiān xīng qī yī.",
      "meaning": "Hôm nay là thứ Hai trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l1170-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：我的书在哪儿？\nB：在椅子上。\nA：这是我的书吗？\nB：对。",
      "pinyin": "A: Wǒ de shū zài nǎr? B: Zài yǐ zi shang. A: Zhè shì wǒ de shū ma? B: Duì.",
      "meaning": "Sách của A ở trên ghế.",
      "readingMinutes": 2
    },
