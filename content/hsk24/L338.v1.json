  "blocks": [
    {
      "id": "l338-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 绿灯 lǜ dēng: đèn xanh; 标志 biāozhì: biển/ký hiệu; 指定 zhǐdìng: chỉ định; 停 tíng: dừng/đỗ. Bài đọc không thay chỉ dẫn giao thông tại địa điểm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l338-t0",
      "type": "teaching",
      "title": "路边 · ven đường",
      "text": "路边 chỉ phần bên cạnh đường; không tự đồng nghĩa nơi đỗ xe hợp lệ. 站在路边 nói vị trí, chưa là giấy phép đỗ.",
      "hanzi": "他在路边等车。",
      "pinyin": "Tā zài lùbiān děng chē.",
      "meaning": "Anh ấy chờ xe bên đường.",
      "readingMinutes": 1
    },
    {
      "id": "l338-t1",
      "type": "teaching",
      "title": "红绿灯 · đèn tín hiệu giao thông",
      "text": "红绿灯 là đèn giao thông; dấu gạch nối trong pinyin nguồn phân tách màu, không đổi thành mục từ khác. Phải đọc tín hiệu thực tế.",
      "hanzi": "路口有红绿灯。",
      "pinyin": "Lùkǒu yǒu hónglǜdēng.",
      "meaning": "Giao lộ có đèn giao thông.",
      "readingMinutes": 1
    },
    {
      "id": "l338-t2",
      "type": "teaching",
      "title": "辆 · lượng từ xe",
      "text": "辆 là lượng từ, không phải tên một loại xe. 两辆车 là hai xe, 两个司机 là hai người lái.",
      "hanzi": "路边有两辆车。",
      "pinyin": "Lùbiān yǒu liǎng liàng chē.",
      "meaning": "Bên đường có hai xe.",
      "readingMinutes": 1
    },
    {
      "id": "l338-t3",
      "type": "teaching",
      "title": "司机 · người lái xe",
      "text": "司机 là tài xế, không phải hành khách. 一位司机 là một người lái, không đếm bằng 辆.",
      "hanzi": "司机说先等绿灯。",
      "pinyin": "Sījī shuō xiān děng lǜ dēng.",
      "meaning": "Tài xế nói hãy chờ đèn xanh trước.",
      "readingMinutes": 1
    },
    {
      "id": "l338-t4",
      "type": "teaching",
      "title": "汽车 · ô tô/xe hơi",
      "text": "汽车 chỉ ô tô/xe động cơ loại này trong bài; không dùng làm tên chung mọi xe như 自行车.",
      "hanzi": "这辆汽车是白色的。",
      "pinyin": "Zhè liàng qìchē shì báisè de.",
      "meaning": "Chiếc ô tô này màu trắng.",
      "readingMinutes": 1
    },
    {
      "id": "l338-t5",
      "type": "teaching",
      "title": "自行车 · xe đạp",
      "text": "自行车 là xe đạp; 骑自行车 là đạp xe, không dùng 开自行车 trong cách nói bài này.",
      "hanzi": "她骑自行车去学校。",
      "pinyin": "Tā qí zìxíngchē qù xuéxiào.",
      "meaning": "Cô ấy đạp xe đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l338-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "辆 đếm xe có bánh như 一辆汽车、一辆自行车. 司机 là người lái, đếm bằng 位/名/个; không dùng 一辆司机.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l338-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "路边有一辆汽车和两辆自行车。司机看着红绿灯，说：先等绿灯，再按这里的标志走。小林把自行车停在指定的地方，没有因为路边空着就随便停。",
      "pinyin": "Lùbiān yǒu yí liàng qìchē hé liǎng liàng zìxíngchē. Sījī kàn zhe hónglǜdēng, shuō: Xiān děng lǜ dēng, zài àn zhèlǐ de biāozhì zǒu. Xiǎo Lín bǎ zìxíngchē tíng zài zhǐdìng de dìfang, méiyǒu yīnwèi lùbiān kòng zhe jiù suíbiàn tíng.",
      "meaning": "Bên đường có một ô tô và hai xe đạp. Tài xế nhắc chờ đèn và theo biển tại chỗ. Lâm để xe đúng nơi quy định, không tùy tiện đỗ vì thấy trống.",
      "readingMinutes": 2
    },
    {
