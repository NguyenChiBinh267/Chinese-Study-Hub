  "blocks": [
    {
      "id": "l462-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 居民 jūmín: cư dân; 公告 gōnggào: thông báo; 分类 fēnlèi: phân loại; 回收 huíshōu: thu hồi/tái chế; 处理 chǔlǐ: xử lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l462-t0",
      "type": "teaching",
      "title": "垃圾 · rác",
      "text": "垃圾 lā jī là danh từ rác; chưa suy ra loại tái chế của từng vật. Nhận diện chữ 圾 trong 垃圾; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请不要把垃圾扔进江里。",
      "pinyin": "Qǐng bú yào bǎ lājī rēng jìn jiāng lǐ.",
      "meaning": "Đừng ném rác xuống sông.",
      "readingMinutes": 1
    },
    {
      "id": "l462-t1",
      "type": "teaching",
      "title": "流 · chảy",
      "text": "流 nói dòng chất lỏng hay dòng di chuyển; ở đây nước chảy.",
      "hanzi": "江水从这里流过。",
      "pinyin": "Jiāng shuǐ cóng zhèlǐ liú guò.",
      "meaning": "Nước sông chảy qua đây.",
      "readingMinutes": 1
    },
    {
      "id": "l462-t2",
      "type": "teaching",
      "title": "目的 · mục đích",
      "text": "目的 trả lời làm việc để làm gì, khác 目的地 là nơi đến.",
      "hanzi": "活动的目的是减少垃圾。",
      "pinyin": "Huódòng de mùdì shì jiǎnshǎo lājī.",
      "meaning": "Mục đích hoạt động là giảm rác.",
      "readingMinutes": 1
    },
    {
      "id": "l462-t3",
      "type": "teaching",
      "title": "目标 · mục tiêu",
      "text": "目标 là đích muốn đạt, có thể cụ thể/đo được; không phải thành tựu đã xác nhận.",
      "hanzi": "我们先定一个小目标。",
      "pinyin": "Wǒmen xiān dìng yí ge xiǎo mùbiāo.",
      "meaning": "Chúng tôi đặt mục tiêu nhỏ trước.",
      "readingMinutes": 1
    },
    {
      "id": "l462-t4",
      "type": "teaching",
      "title": "获取 · thu thập, lấy được",
      "text": "获取 thường đi với 信息、知识; không bảo đảm thông tin đúng nếu chỉ lấy được.",
      "hanzi": "居民可以获取分类信息。",
      "pinyin": "Jūmín kěyǐ huòqǔ fēnlèi xìnxī.",
      "meaning": "Cư dân có thể lấy thông tin phân loại.",
      "readingMinutes": 1
    },
    {
      "id": "l462-t5",
      "type": "teaching",
      "title": "大量 · lượng lớn",
      "text": "大量 + danh từ không đếm một vật; khác 一件 lớn về kích thước.",
      "hanzi": "这里以前有大量垃圾。",
      "pinyin": "Zhèlǐ yǐqián yǒu dàliàng lājī.",
      "meaning": "Ở đây trước kia có lượng rác lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l462-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Vế sau 好 + động từ nêu mục đích thuận lợi cho hành động trước: 把垃圾分好类，好让大家回收. Ở đây 好不是 tính từ tốt hay sở thích; không nhầm mục đích với kết quả đã đạt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l462-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社区旁边有一条江，江水从小桥下流过。以前桥边有大量垃圾，居民决定办一次环保活动。活动的目的是减少垃圾，小目标是先整理桥边。大家从公告中获取分类信息，把垃圾分好类，好让回收人员处理。",
      "pinyin": "Shèqū pángbiān yǒu yì tiáo jiāng, jiāng shuǐ cóng xiǎo qiáo xià liú guò. Yǐqián qiáo biān yǒu dàliàng lājī, jūmín juédìng bàn yí cì huánbǎo huódòng. Huódòng de mùdì shì jiǎnshǎo lājī, xiǎo mùbiāo shì xiān zhěnglǐ qiáo biān. Dàjiā cóng gōnggào zhōng huòqǔ fēnlèi xìnxī, bǎ lājī fēn hǎo lèi, hǎo ràng huíshōu rényuán chǔlǐ.",
      "meaning": "Khu dân cư tổ chức dọn rác bên cầu. Mục đích là giảm rác, mục tiêu nhỏ trước là dọn khu cầu. Mọi người lấy thông tin từ thông báo và phân loại để người thu hồi xử lý.",
      "readingMinutes": 2
    },
