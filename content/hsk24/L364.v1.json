  "blocks": [
    {
      "id": "l364-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 灯光 dēngguāng: ánh đèn; 窗边 chuāng biān: bên cửa sổ; 外貌 wàimào: ngoại hình; 相似 xiāngsì: tương tự; 长得 zhǎng de: trông/vẻ ngoài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l364-t0",
      "type": "teaching",
      "title": "照片 · tấm ảnh",
      "text": "照片 là sản phẩm ảnh, 一张照片 đếm tấm ảnh; không gọi thiết bị bằng 照片.",
      "hanzi": "这张照片是昨天拍的。",
      "pinyin": "Zhè zhāng zhàopiàn shì zuótiān pāi de.",
      "meaning": "Ảnh này chụp hôm qua.",
      "readingMinutes": 1
    },
    {
      "id": "l364-t1",
      "type": "teaching",
      "title": "照相 · chụp ảnh",
      "text": "照相 gần nghĩa 拍照 trong hoạt động; 去照相 là đi chụp, không tự cho biết chụp cho ai hay kiểu gì.",
      "hanzi": "我们一起去照相。",
      "pinyin": "Wǒmen yìqǐ qù zhào xiàng.",
      "meaning": "Chúng tôi cùng đi chụp ảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l364-t2",
      "type": "teaching",
      "title": "照 · chiếu/soi (ánh sáng)",
      "text": "照 ở 灯照着桌子 là chiếu sáng; 照相 là từ ghép khác chức năng. Bài chưa dạy mọi nghĩa “theo/đối chiếu” của 照.",
      "hanzi": "灯光照着桌子。",
      "pinyin": "Dēngguāng zhào zhe zhuōzi.",
      "meaning": "Ánh đèn chiếu lên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l364-t3",
      "type": "teaching",
      "title": "向 · hướng về/về phía",
      "text": "向 trong 向窗边走 nêu hướng đi; khác 像 là giống. Không dùng 向 thay 像 trong nhận xét ngoại hình.",
      "hanzi": "请向窗边走两步。",
      "pinyin": "Qǐng xiàng chuāng biān zǒu liǎng bù.",
      "meaning": "Hãy đi hai bước về phía cửa sổ.",
      "readingMinutes": 1
    },
    {
      "id": "l364-t4",
      "type": "teaching",
      "title": "像 · giống/tựa như",
      "text": "像 trong 她像姐姐 là giống chị; không phải hướng di chuyển. Chưa biết ai lớn hơn chỉ từ nét mặt giống nhau.",
      "hanzi": "她长得很像姐姐。",
      "pinyin": "Tā zhǎng de hěn xiàng jiějie.",
      "meaning": "Cô ấy trông rất giống chị.",
      "readingMinutes": 1
    },
    {
      "id": "l364-t5",
      "type": "teaching",
      "title": "双 · đôi; lượng từ vật thành cặp",
      "text": "双 đếm vật thành cặp như 一双鞋; không dùng 一双照片 thay hai ảnh rời. 两只鞋 mới chắc là hai chiếc, chưa chắc cùng đôi.",
      "hanzi": "照片里有一双新鞋。",
      "pinyin": "Zhàopiàn lǐ yǒu yì shuāng xīn xié.",
      "meaning": "Trong ảnh có một đôi giày mới.",
      "readingMinutes": 1
    },
    {
      "id": "l364-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "向窗边走 nêu hướng đi trong lời hướng dẫn; 像姐姐 nói giống chị, không chỉ hướng. Hai chữ đều đọc xiàng nhưng khác chữ và chức năng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l364-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "照相时，灯光照着桌子。朋友请小林向窗边走两步，再拍照片。照片里的女孩很像她姐姐，旁边放着一双新鞋。相似只说外貌，不证明两人年龄或经历相同。",
      "pinyin": "Zhào xiàng shí, dēngguāng zhào zhe zhuōzi. Péngyou qǐng Xiǎo Lín xiàng chuāng biān zǒu liǎng bù, zài pāi zhàopiàn. Zhàopiàn lǐ de nǚhái hěn xiàng tā jiějie, pángbiān fàng zhe yì shuāng xīn xié. Xiāngsì zhǐ shuō wàimào, bù zhèngmíng liǎng rén niánlíng huò jīnglì xiāngtóng.",
      "meaning": "Khi chụp, ánh đèn chiếu bàn; bạn yêu cầu Lâm đi về phía cửa sổ. Bé gái trong ảnh giống chị, có đôi giày bên cạnh. Giống ngoại hình chưa chứng minh tuổi hay trải nghiệm như nhau.",
      "readingMinutes": 2
    },
