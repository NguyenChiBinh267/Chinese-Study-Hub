  "blocks": [
    {
      "id": "l4049-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t0",
      "type": "teaching",
      "title": "酸奶 · sữa chua",
      "text": "酸奶 là thực phẩm, khác 酸 tả vị chua.",
      "hanzi": "妹妹想喝一杯酸奶。",
      "pinyin": "Mèi mei xiǎng hē yì bēi suān nǎi.",
      "meaning": "Em gái muốn uống một cốc sữa chua.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t1",
      "type": "teaching",
      "title": "油 · dầu; dầu ăn",
      "text": "油 trong nấu ăn là dầu ăn, không phải xăng.",
      "hanzi": "锅里只放一点儿油。",
      "pinyin": "Guō lǐ zhǐ fàng yì diǎnr yóu.",
      "meaning": "Chỉ cho một chút dầu vào chảo.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t2",
      "type": "teaching",
      "title": "盐 · muối",
      "text": "盐 là gia vị muối; 咸 là tính từ mặn. Nhận diện chữ 盐 trong 盐; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他忘了往菜里放盐。",
      "pinyin": "Tā wàng le wǎng cài lǐ fàng yán.",
      "meaning": "Anh ấy quên cho muối vào món ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t3",
      "type": "teaching",
      "title": "味 · vị; mùi vị",
      "text": "味 trong 味不错 là cách nói gọn về mùi vị, không phải khẩu vị cá nhân.",
      "hanzi": "这道菜的味不错。",
      "pinyin": "Zhè dào cài de wèi bú cuò.",
      "meaning": "Món này có vị khá ngon.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t4",
      "type": "teaching",
      "title": "香 · thơm",
      "text": "香 tả mùi thơm trong câu, không phải một loại gia vị.",
      "hanzi": "刚做好的饭真香。",
      "pinyin": "Gāng zuò hǎo de fàn zhēn xiāng.",
      "meaning": "Cơm vừa nấu thơm thật.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-t5",
      "type": "teaching",
      "title": "熟 · chín (thực phẩm)",
      "text": "Nguồn ghi shú/shóu; hiển thị shú, shóu cũng là đọc nguồn. 熟 đối lập 生 khi tả thức ăn.",
      "hanzi": "饭已经熟了。",
      "pinyin": "Fàn yǐ jīng shú le.",
      "meaning": "Cơm đã chín rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l4049-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然…就… lấy một tình trạng đã biết làm cơ sở cho đề nghị. Ở đây nhân vật thấy cơm chín rồi mới mời ăn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4049-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "哥哥做饭，先放油，再放菜和盐。饭熟了，很香，妹妹觉得味不错，饭后还想喝酸奶。哥哥说：“既然饭熟了，我们就吃饭吧。”这是一段生活故事，不是食谱。",
      "pinyin": "Gē ge zuò fàn, xiān fàng yóu, zài fàng cài hé yán. Fàn shú le, hěn xiāng, mèi mei jué de wèi bú cuò, fàn hòu hái xiǎng hē suān nǎi. Gē ge shuō: “Jì rán fàn shú le, wǒ men jiù chī fàn ba.” Zhè shì yí duàn shēng huó gù shi, bú shì shí pǔ.",
      "meaning": "Anh nấu bữa tối, em nhận xét mùi vị; câu chuyện không phải công thức nấu ăn.",
      "readingMinutes": 2
    },
    {
