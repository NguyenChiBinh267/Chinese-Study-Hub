  "blocks": [
    {
      "id": "l405-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 肯定 kěndìng: ghi nhận; 承认 chéngrèn: thừa nhận; 如实 rúshí: đúng sự thật; 后续 hòuxù: về sau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l405-t0",
      "type": "teaching",
      "title": "表示 · bày tỏ, biểu thị",
      "text": "表示 nhận nội dung ý kiến/cảm ơn; không thay cho 表演 biểu diễn. Nhận diện chữ 示 trong 表示; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他表示愿意帮助同事。",
      "pinyin": "Tā biǎoshì yuànyì bāngzhù tóngshì.",
      "meaning": "Anh ấy bày tỏ sẵn lòng giúp đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l405-t1",
      "type": "teaching",
      "title": "表现 · sự thể hiện, biểu hiện",
      "text": "表现 ở 工作表现 là cách làm việc được quan sát, không đồng nghĩa một lời hứa.",
      "hanzi": "经理肯定了她的工作表现。",
      "pinyin": "Jīnglǐ kěndìng le tā de gōngzuò biǎoxiàn.",
      "meaning": "Quản lý ghi nhận cách cô ấy làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l405-t2",
      "type": "teaching",
      "title": "表扬 · khen ngợi",
      "text": "表扬 thường kèm người và lý do cụ thể; ở đây khen sự cẩn thận, không phải tự khen.",
      "hanzi": "经理表扬他认真工作。",
      "pinyin": "Jīnglǐ biǎoyáng tā rènzhēn gōngzuò.",
      "meaning": "Quản lý khen anh ấy làm việc nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l405-t3",
      "type": "teaching",
      "title": "诚实 · trung thực",
      "text": "诚实 là nói đúng sự thật; có thể thừa nhận điều chưa biết, không đồng nghĩa biết hết.",
      "hanzi": "她很诚实，承认自己还没做完。",
      "pinyin": "Tā hěn chéngshí, chéngrèn zìjǐ hái méi zuò wán.",
      "meaning": "Cô ấy trung thực, thừa nhận mình chưa làm xong.",
      "readingMinutes": 1
    },
    {
      "id": "l405-t4",
      "type": "teaching",
      "title": "答应 · đồng ý, nhận lời",
      "text": "答应 đọc dāying với âm sau nhẹ; nhận lời làm việc khác 回答 là trả lời câu hỏi.",
      "hanzi": "我答应明天把材料送来。",
      "pinyin": "Wǒ dāying míngtiān bǎ cáiliào sòng lái.",
      "meaning": "Tôi nhận lời ngày mai mang tài liệu đến.",
      "readingMinutes": 1
    },
    {
      "id": "l405-t5",
      "type": "teaching",
      "title": "保证 · bảo đảm, cam kết",
      "text": "保证 có thể dẫn một mệnh đề cam kết; lời nói chưa tự chứng minh kết quả.",
      "hanzi": "我保证按时完成这项工作。",
      "pinyin": "Wǒ bǎozhèng ànshí wánchéng zhè xiàng gōngzuò.",
      "meaning": "Tôi cam kết hoàn thành việc này đúng hạn.",
      "readingMinutes": 1
    },
    {
      "id": "l405-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "表扬+người+việc làm nêu rõ hành động được khen: 经理表扬他认真工作. Không nhầm 表示 là bày tỏ với 表现 là thể hiện; lời hứa 保证 còn cần được thực hiện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l405-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "经理问小周材料准备得怎么样。小周诚实地说还差两页，但答应明天送来，并保证按时完成。经理表扬他如实说明情况，也表示会提供帮助。大家要看后续的工作表现，不能只听保证。",
      "pinyin": "Jīnglǐ wèn Xiǎo Zhōu cáiliào zhǔnbèi de zěnmeyàng. Xiǎo Zhōu chéngshí de shuō hái chà liǎng yè, dàn dāying míngtiān sòng lái, bìng bǎozhèng ànshí wánchéng. Jīnglǐ biǎoyáng tā rúshí shuōmíng qíngkuàng, yě biǎoshì huì tígōng bāngzhù. Dàjiā yào kàn hòuxù de gōngzuò biǎoxiàn, bù néng zhǐ tīng bǎozhèng.",
      "meaning": "Châu còn thiếu hai trang, nhận lời mang đến ngày mai. Quản lý khen việc nói thật và đề nghị hỗ trợ; vẫn phải xem kết quả làm việc sau đó.",
      "readingMinutes": 2
    },
