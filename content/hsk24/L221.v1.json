  "blocks": [
    {
      "id": "l221-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "说 là nói; 写 là viết; 高兴 là vui. 得/地 trong các cấu trúc của bài đều đọc nhẹ de nhưng vị trí khác nhau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l221-t0",
      "type": "teaching",
      "title": "词 · từ ngữ",
      "text": "词 là đơn vị từ, không phải mọi chữ Hán đơn lẻ. Một từ có thể có nhiều chữ, như 书包.",
      "hanzi": "这个词是什么意思？",
      "pinyin": "Zhège cí shì shénme yìsi?",
      "meaning": "Từ này có nghĩa gì?",
      "readingMinutes": 1
    },
    {
      "id": "l221-t1",
      "type": "teaching",
      "title": "错 · sai",
      "text": "错 nói chưa đúng. 写错了 nói viết sai rồi, không có nghĩa chưa từng viết.",
      "hanzi": "这个字我写错了。",
      "pinyin": "Zhège zì wǒ xiě cuò le.",
      "meaning": "Chữ này tôi viết sai rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l221-t2",
      "type": "teaching",
      "title": "得 · trợ từ sau động từ để dẫn phần mô tả",
      "text": "Chỉ luyện cách đọc nhẹ de trong 写得好, không lẫn 得 dé/ děi ở nghĩa khác.",
      "hanzi": "你写得很好。",
      "pinyin": "Nǐ xiě de hěn hǎo.",
      "meaning": "Bạn viết rất tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l221-t3",
      "type": "teaching",
      "title": "地 · trợ từ nối phần mô tả với động từ sau",
      "text": "地 trong 高兴地说 đọc de, không phải dì chỉ đất/nơi. Đáp án chỉ áp dụng cấu trúc này.",
      "hanzi": "她高兴地说：我写对了。",
      "pinyin": "Tā gāoxìng de shuō: Wǒ xiě duì le.",
      "meaning": "Cô ấy vui vẻ nói: Tôi viết đúng rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l221-t4",
      "type": "teaching",
      "title": "这么 · thế này, đến mức này",
      "text": "这么 trong 这么难 chỉ mức độ như thế này; đừng thay mọi chỗ bằng 这样 vì cấu trúc có thể khác.",
      "hanzi": "这个词这么难，我想再看一遍。",
      "pinyin": "Zhège cí zhème nán, wǒ xiǎng zài kàn yí biàn.",
      "meaning": "Từ này khó thế, tôi muốn xem lại một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l221-t5",
      "type": "teaching",
      "title": "这样 · như thế này, theo cách này",
      "text": "这样 chỉ cách/thế này trong 请这样写. Không phải tự động chỉ kích thước hay màu.",
      "hanzi": "这个字请这样写。",
      "pinyin": "Zhège zì qǐng zhèyàng xiě.",
      "meaning": "Chữ này hãy viết theo cách này.",
      "readingMinutes": 1
    },
    {
      "id": "l221-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động từ + 得 + mô tả kết quả/cách làm: 写得好. Phần mô tả đứng trước động từ thì dùng 地: 高兴地说. Không đổi hai chữ chỉ vì cùng đọc de.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l221-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学生：这个字我写错了。老师：请这样写。学生：这个词这么难啊！老师：不要着急，你已经写得很好了。",
      "pinyin": "Xuésheng: Zhège zì wǒ xiě cuò le. Lǎoshī: Qǐng zhèyàng xiě. Xuésheng: Zhège cí zhème nán a! Lǎoshī: Bú yào zháojí, nǐ yǐjīng xiě de hěn hǎo le.",
      "meaning": "Học sinh: Em viết sai chữ này rồi. Giáo viên: Hãy viết thế này. Học sinh: Từ này khó thế! Giáo viên: Đừng sốt ruột, em đã viết tốt rồi.",
      "readingMinutes": 2
    },
    {
