  "blocks": [
    {
      "id": "l411-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 证件 zhèngjiàn: giấy tờ; 出发 chūfā: khởi hành; 通知 tōngzhī: thông báo; 估计 gūjì: ước lượng; 当成 dàngchéng: xem là.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l411-t0",
      "type": "teaching",
      "title": "大巴 · xe khách lớn",
      "text": "大巴 là cách gọi xe khách/xe buýt đường dài cỡ lớn; chọn phương tiện dựa tuyến cụ thể, không mặc định chạy mọi nơi. Nhận diện chữ 巴 trong 大巴; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们坐大巴去机场。",
      "pinyin": "Wǒmen zuò dàbā qù jīchǎng.",
      "meaning": "Chúng tôi đi xe khách lớn đến sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l411-t1",
      "type": "teaching",
      "title": "登机 · lên máy bay",
      "text": "登机 là bước lên máy bay sau các thủ tục; không có nghĩa đã hạ cánh.",
      "hanzi": "请在登机前准备好证件。",
      "pinyin": "Qǐng zài dēngjī qián zhǔnbèi hǎo zhèngjiàn.",
      "meaning": "Hãy chuẩn bị giấy tờ trước khi lên máy bay.",
      "readingMinutes": 1
    },
    {
      "id": "l411-t2",
      "type": "teaching",
      "title": "大厅 · sảnh lớn",
      "text": "大厅 là khu sảnh rộng trong công trình, khác 房间 là phòng riêng.",
      "hanzi": "我们在出发大厅见面。",
      "pinyin": "Wǒmen zài chūfā dàtīng jiànmiàn.",
      "meaning": "Chúng ta gặp nhau ở sảnh khởi hành.",
      "readingMinutes": 1
    },
    {
      "id": "l411-t3",
      "type": "teaching",
      "title": "动车 · tàu động lực phân tán",
      "text": "动车 trong giao tiếp thường nói loại tàu động lực phân tán; bài không suy ra tốc độ cụ thể từ tên gọi.",
      "hanzi": "这趟动车下午两点出发。",
      "pinyin": "Zhè tàng dòngchē xiàwǔ liǎng diǎn chūfā.",
      "meaning": "Chuyến tàu này khởi hành lúc hai giờ chiều.",
      "readingMinutes": 1
    },
    {
      "id": "l411-t4",
      "type": "teaching",
      "title": "堵车 · tắc đường",
      "text": "堵车 là tình trạng giao thông ùn tắc, có thể làm chậm xe đường bộ chứ không phải tên phương tiện.",
      "hanzi": "路上堵车，我们晚到了十分钟。",
      "pinyin": "Lù shàng dǔchē, wǒmen wǎn dào le shí fēnzhōng.",
      "meaning": "Đường tắc nên chúng tôi đến muộn mười phút.",
      "readingMinutes": 1
    },
    {
      "id": "l411-t5",
      "type": "teaching",
      "title": "大约 · khoảng, chừng",
      "text": "大约 biểu thị số ước lượng; không dùng làm cam kết thời gian chính xác.",
      "hanzi": "从这里走过去大约要十分钟。",
      "pinyin": "Cóng zhèlǐ zǒu guòqù dàyuē yào shí fēnzhōng.",
      "meaning": "Đi bộ từ đây sang đó mất khoảng mười phút.",
      "readingMinutes": 1
    },
    {
      "id": "l411-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "大约 đứng trước số lượng/thời gian ước tính, không phải giờ bảo đảm. Cần phân biệt thời gian chờ 大约二十分钟 với giờ cố định 两点.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l411-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小何先坐动车到市里，再换大巴去机场。司机说大约四十分钟能到，但路上可能堵车。到了出发大厅，小何先看登机通知，没有把估计的到达时间当成保证。",
      "pinyin": "Xiǎo Hé xiān zuò dòngchē dào shì lǐ, zài huàn dàbā qù jīchǎng. Sījī shuō dàyuē sìshí fēnzhōng néng dào, dàn lù shàng kěnéng dǔchē. Dào le chūfā dàtīng, Xiǎo Hé xiān kàn dēngjī tōngzhī, méiyǒu bǎ gūjì de dàodá shíjiān dàngchéng bǎozhèng.",
      "meaning": "Hà đi tàu vào thành phố rồi chuyển xe khách đến sân bay. Bốn mươi phút là ước lượng có thể bị ảnh hưởng bởi tắc đường; Hà xem thông báo lên máy bay khi đến sảnh.",
      "readingMinutes": 2
    },
    {
