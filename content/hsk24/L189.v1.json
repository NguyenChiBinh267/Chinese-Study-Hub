  "blocks": [
    {
      "id": "l189-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder0",
      "type": "teaching",
      "title": "唱 · hát",
      "text": "Nhắc nghĩa đã học: hát. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我姐姐唱歌很好听。",
      "pinyin": "Wǒ jiě jie chàng gē hěn hǎo tīng.",
      "meaning": "Chị gái tôi hát hay.",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder1",
      "type": "teaching",
      "title": "觉得 · cảm thấy; cho rằng",
      "text": "Nhắc nghĩa đã học: cảm thấy; cho rằng. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我觉得你唱歌很好听。",
      "pinyin": "Wǒ jué de nǐ chàng gē hěn hǎo tīng.",
      "meaning": "Tôi thấy bạn hát hay.",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder2",
      "type": "teaching",
      "title": "天气 · thời tiết",
      "text": "Nhắc nghĩa đã học: thời tiết. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "明天天气怎么样？",
      "pinyin": "Míng tiān tiān qì zěn me yàng?",
      "meaning": "Ngày mai thời tiết thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder3",
      "type": "teaching",
      "title": "雪 · tuyết",
      "text": "Nhắc nghĩa đã học: tuyết. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "今天没有雪。",
      "pinyin": "Jīn tiān méi yǒu xuě.",
      "meaning": "Hôm nay không có tuyết.",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder4",
      "type": "teaching",
      "title": "今天 · hôm nay",
      "text": "Nhắc nghĩa đã học: hôm nay. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我今天在家休息。",
      "pinyin": "Wǒ jīn tiān zài jiā xiū xi.",
      "meaning": "Hôm nay tôi nghỉ ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l189-reminder5",
      "type": "teaching",
      "title": "明天 · ngày mai",
      "text": "Nhắc nghĩa đã học: ngày mai. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我明天去学校唱歌。",
      "pinyin": "Wǒ míng tiān qù xué xiào chàng gē.",
      "meaning": "Ngày mai tôi đến trường hát.",
      "readingMinutes": 1
    },
    {
      "id": "l189-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你今天去学校吗？\nB：不去，今天下雨。我在家休息。\nA：明天呢？\nB：明天我去学校唱歌。\nA：我也去。",
      "pinyin": "A: Nǐ jīn tiān qù xué xiào ma? B: Bú qù, jīn tiān xià yǔ. Wǒ zài jiā xiū xi. A: Míng tiān ne? B: Míng tiān wǒ qù xué xiào chàng gē. A: Wǒ yě qù.",
      "meaning": "Trong truyện, B nghỉ ở nhà hôm nay và sẽ đến trường hát ngày mai. Đây không phải dự báo thời tiết thực.",
      "readingMinutes": 2
    },
