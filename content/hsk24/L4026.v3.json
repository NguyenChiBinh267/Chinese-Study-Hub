  "blocks": [
    {
      "id": "l4026-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t0",
      "type": "teaching",
      "title": "寄 · gửi",
      "text": "寄 nói gửi thư/đồ qua dịch vụ, khác tự mang tới. Nhận diện chữ 寄 trong 寄; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我想寄一个包裹。",
      "pinyin": "Wǒ xiǎng jì yí ge bāo guǒ.",
      "meaning": "Tôi muốn gửi một bưu kiện.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t1",
      "type": "teaching",
      "title": "快递 · chuyển phát nhanh",
      "text": "快递 có thể chỉ dịch vụ hoặc kiện hàng chuyển phát.",
      "hanzi": "快递下午送到。",
      "pinyin": "Kuài dì xià wǔ sòng dào.",
      "meaning": "Kiện chuyển phát đến vào buổi chiều.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t2",
      "type": "teaching",
      "title": "身份证 · căn cước; thẻ định danh",
      "text": "身份证 là giấy tờ định danh, khác hộ chiếu 护照.",
      "hanzi": "请保管好身份证。",
      "pinyin": "Qǐng bǎo guǎn hǎo shēn fèn zhèng.",
      "meaning": "Xin giữ cẩn thận thẻ định danh.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t3",
      "type": "teaching",
      "title": "证件 · giấy tờ chứng nhận",
      "text": "证件 là tên chung, có thể gồm nhiều loại giấy tờ.",
      "hanzi": "出门前检查证件。",
      "pinyin": "Chū mén qián jiǎn chá zhèng jiàn.",
      "meaning": "Trước khi ra ngoài hãy kiểm tra giấy tờ.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t4",
      "type": "teaching",
      "title": "进入 · đi vào",
      "text": "进入 là vào một nơi hoặc một giai đoạn; ở đây chỉ nơi chốn.",
      "hanzi": "请从左边进入大厅。",
      "pinyin": "Qǐng cóng zuǒ bian jìn rù dà tīng.",
      "meaning": "Xin vào sảnh từ phía trái.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-t5",
      "type": "teaching",
      "title": "排队 · xếp hàng",
      "text": "排队 là đứng/chờ theo thứ tự, không chỉ một hàng ghế.",
      "hanzi": "大家正在门口排队。",
      "pinyin": "Dà jiā zhèng zài mén kǒu pái duì.",
      "meaning": "Mọi người đang xếp hàng ở cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l4026-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把证件看一看 đặt đối tượng trước 看一看, nghĩa xem qua giấy tờ. Câu chuyện là bài luyện hư cấu, không nêu thủ tục hành chính có thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4026-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安去寄包裹，进入大厅后先排队。工作人员请他把证件看一看，确认姓名。小安把身份证收好，选择了快递。他寄的是书，不是证件。这里的办理安排仅属于故事。",
      "pinyin": "Xiǎo Ān qù jì bāo guǒ, jìn rù dà tīng hòu xiān pái duì. Gōng zuò rén yuán qǐng tā bǎ zhèng jiàn kàn yi kàn, què rèn xìng míng. Xiǎo Ān bǎ shēn fèn zhèng shōu hǎo, xuǎn zé le kuài dì. Tā jì de shì shū, bú shì zhèng jiàn. Zhè lǐ de bàn lǐ ān pái jǐn shǔ yú gù shi.",
      "meaning": "Tiểu An xếp hàng gửi sách bằng chuyển phát, kiểm tra rồi cất thẻ định danh.",
      "readingMinutes": 2
    },
