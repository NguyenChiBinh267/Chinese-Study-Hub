  "blocks": [
    {
      "id": "l4077-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t0",
      "type": "teaching",
      "title": "深 · sâu",
      "text": "深 ở hộp tả độ sâu, khác 高 là chiều cao theo ngữ cảnh.",
      "hanzi": "这个盒子很深。",
      "pinyin": "Zhè ge hé zi hěn shēn.",
      "meaning": "Chiếc hộp này rất sâu.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t1",
      "type": "teaching",
      "title": "细 · mảnh; nhỏ về bề ngang",
      "text": "细 trong 细线 tả sợi mảnh, không phải 仔细 là kỹ lưỡng.",
      "hanzi": "这根线太细了。",
      "pinyin": "Zhè gēn xiàn tài xì le.",
      "meaning": "Sợi dây này mảnh quá.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t2",
      "type": "teaching",
      "title": "乱 · lộn xộn",
      "text": "乱 ở 桌上很乱 nói đồ vật không theo trật tự.",
      "hanzi": "桌上的东西很乱。",
      "pinyin": "Zhuō shàng de dōng xi hěn luàn.",
      "meaning": "Đồ trên bàn lộn xộn.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t3",
      "type": "teaching",
      "title": "牌 · biển; tấm bảng",
      "text": "牌 ở 指示牌 là biển hướng dẫn, không chỉ mọi trang giấy. Nhận diện chữ 牌 trong 牌; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "门口有一块指示牌。",
      "pinyin": "Mén kǒu yǒu yí kuài zhǐ shì pái.",
      "meaning": "Cửa có một biển hướng dẫn.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t4",
      "type": "teaching",
      "title": "小伙子 · chàng trai; thanh niên nam",
      "text": "小伙子 chỉ nam thanh niên trong lời kể, không phải trẻ nhỏ nói chung.",
      "hanzi": "那个小伙子帮忙搬了箱子。",
      "pinyin": "Nà ge xiǎo huǒ zi bāng máng bān le xiāng zi.",
      "meaning": "Chàng trai đó giúp chuyển thùng.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-t5",
      "type": "teaching",
      "title": "辛苦 · vất vả",
      "text": "辛苦 nói công việc tốn sức; 辛苦了 có thể ghi nhận công sức.",
      "hanzi": "大家辛苦了，先休息一下吧。",
      "pinyin": "Dà jiā xīn kǔ le, xiān xiū xi yí xià ba.",
      "meaning": "Mọi người vất vả rồi, nghỉ một chút nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l4077-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung việc phải làm. 深 và 细 trong bài nói độ sâu/mảnh; không tự chuyển sang mọi nghĩa trừu tượng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4077-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社区准备一个小展览，桌上很乱，盒子又很深，拿东西不方便。一个小伙子帮忙搬箱子，发现挂指示牌的线太细。大家不仅重新整理桌子，还换了合适的线。负责人说：“辛苦了，先休息一下吧。”",
      "pinyin": "Shè qū zhǔn bèi yí ge xiǎo zhǎn lǎn, zhuō shàng hěn luàn, hé zi yòu hěn shēn, ná dōng xi bù fāng biàn. Yí ge xiǎo huǒ zi bāng máng bān xiāng zi, fā xiàn guà zhǐ shì pái de xiàn tài xì. Dà jiā bù jǐn chóng xīn zhěng lǐ zhuō zi, hái huàn le hé shì de xiàn. Fù zé rén shuō: “Xīn kǔ le, xiān xiū xi yí xià ba.”",
      "meaning": "Nhóm thay dây phù hợp và sắp bàn rồi nghỉ; đây là bố trí triển lãm hư cấu.",
      "readingMinutes": 2
    },
