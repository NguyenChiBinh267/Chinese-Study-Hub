  "blocks": [
    {
      "id": "l4046-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t0",
      "type": "teaching",
      "title": "外出 · ra ngoài",
      "text": "外出 là rời nơi ở/làm việc để ra ngoài.",
      "hanzi": "外出以前请检查行李。",
      "pinyin": "Wài chū yǐ qián qǐng jiǎn chá xíng li.",
      "meaning": "Trước khi ra ngoài hãy kiểm tra hành lý.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t1",
      "type": "teaching",
      "title": "入住 · nhận phòng; vào ở",
      "text": "入住 nói bắt đầu lưu trú, không phải chỉ đi qua cửa.",
      "hanzi": "我们下午办理入住。",
      "pinyin": "Wǒ men xià wǔ bàn lǐ rù zhù.",
      "meaning": "Chiều chúng tôi làm thủ tục nhận phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t2",
      "type": "teaching",
      "title": "入口 · lối vào",
      "text": "入口 là nơi đi vào, khác động từ 进入.",
      "hanzi": "入口在楼的右边。",
      "pinyin": "Rù kǒu zài lóu de yòu bian.",
      "meaning": "Lối vào ở phía phải tòa nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t3",
      "type": "teaching",
      "title": "入 · vào",
      "text": "入 trong 入内 là cách nói gọn, thường gặp ở biển chữ.",
      "hanzi": "客人可以从这里入内。",
      "pinyin": "Kè rén kě yǐ cóng zhè lǐ rù nèi.",
      "meaning": "Khách có thể vào từ đây.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t4",
      "type": "teaching",
      "title": "指 · chỉ; trỏ",
      "text": "指 ở đây là chỉ hướng bằng tay, không phải ngón tay như danh từ. Nhận diện chữ 指 trong 指; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请指一下入口的位置。",
      "pinyin": "Qǐng zhǐ yí xià rù kǒu de wèi zhi.",
      "meaning": "Xin chỉ vị trí lối vào.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-t5",
      "type": "teaching",
      "title": "直接 · trực tiếp",
      "text": "直接 nói làm thẳng, không qua bước/người trung gian.",
      "hanzi": "请直接问前台。",
      "pinyin": "Qǐng zhí jiē wèn qián tái.",
      "meaning": "Hãy hỏi thẳng quầy tiếp tân.",
      "readingMinutes": 1
    },
    {
      "id": "l4046-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有的是 + danh từ nói có nhiều, không thiếu; ở đây chỉ lời giới thiệu trong địa điểm hư cấu, không phải đánh giá một khách sạn thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4046-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "外出的客人来到故事里的旅店，准备入住。他请工作人员指一下入口，对方说：“从右边入内，直接问前台就行。附近有的是吃饭的地方，安顿好以后再慢慢选。”",
      "pinyin": "Wài chū de kè rén lái dào gù shi lǐ de lǚ diàn, zhǔn bèi rù zhù. Tā qǐng gōng zuò rén yuán zhǐ yí xià rù kǒu, duì fāng shuō: “Cóng yòu bian rù nèi, zhí jiē wèn qián tái jiù xíng. Fù jìn yǒu de shì chī fàn de dì fang, ān dùn hǎo yǐ hòu zài màn man xuǎn.”",
      "meaning": "Khách hỏi lối vào và được hướng dẫn hỏi trực tiếp quầy tiếp tân của nơi lưu trú hư cấu.",
      "readingMinutes": 2
    },
