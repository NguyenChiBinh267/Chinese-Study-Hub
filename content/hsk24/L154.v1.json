  "blocks": [
    {
      "id": "l154-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l154-t0",
      "type": "teaching",
      "title": "吃 · ăn",
      "text": "吃 nói ăn, khác 喝 uống trong các mẫu đồ ăn/đồ uống này.",
      "hanzi": "我吃了米饭。",
      "pinyin": "Wǒ chī le mǐ fàn.",
      "meaning": "Tôi đã ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l154-t1",
      "type": "teaching",
      "title": "菜 · rau; món ăn (theo ngữ cảnh)",
      "text": "菜 trong 我吃菜 có thể nói rau/món rau; trong câu khác có thể là một món ăn, không tự kết luận mọi 菜 đều chay.",
      "hanzi": "我吃菜。",
      "pinyin": "Wǒ chī cài.",
      "meaning": "Tôi ăn rau/món rau.",
      "readingMinutes": 1
    },
    {
      "id": "l154-t2",
      "type": "teaching",
      "title": "米饭 · cơm (gạo đã nấu)",
      "text": "米饭 chỉ cơm nấu từ gạo, hẹp hơn 饭 dùng cho bữa ăn nói chung.",
      "hanzi": "我喜欢吃米饭。",
      "pinyin": "Wǒ xǐ huan chī mǐ fàn.",
      "meaning": "Tôi thích ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l154-t3",
      "type": "teaching",
      "title": "水 · nước",
      "text": "水 trong câu là nước để uống; không tự đưa lời khuyên lượng nước hay sức khỏe.",
      "hanzi": "我喝水。",
      "pinyin": "Wǒ hē shuǐ.",
      "meaning": "Tôi uống nước.",
      "readingMinutes": 1
    },
    {
      "id": "l154-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Trong 我吃了米饭, 了 sau động từ nói hành động đã hoàn thành trong ngữ cảnh. Không phải cứ có thời gian quá khứ là mọi câu đều thêm 了. 吃 dùng với đồ ăn, 喝 đã học với đồ uống; 菜/米饭/水 là những đối tượng khác nhau trong các câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l154-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你想喝茶吗？\nB：不想，我想喝水。\nA：好。你吃饭了吗？\nB：吃了，我吃了米饭和菜。",
      "pinyin": "A: Nǐ xiǎng hē chá ma? B: Bù xiǎng, wǒ xiǎng hē shuǐ. A: Hǎo. Nǐ chī fàn le ma? B: Chī le, wǒ chī le mǐ fàn hé cài.",
      "meaning": "B muốn uống nước, không muốn trà ở tình huống này; B nói đã ăn cơm và rau/món ăn. Không suy chế độ ăn thường xuyên.",
      "readingMinutes": 2
    },
    {
