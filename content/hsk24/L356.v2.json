  "blocks": [
    {
      "id": "l356-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 留学 liúxué: du học; 算 suàn: tính; 下课 xià kè: tan tiết. 以 hôm/năm nay làm mốc, không giả định ngày tháng thật trong đoạn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l356-t0",
      "type": "teaching",
      "title": "后年 · năm kia phía tương lai",
      "text": "后年 là năm sau nữa tính từ năm đang nói; không phải năm ngay sau 去年. Không gắn năm dương lịch thật khi đoạn không cho.",
      "hanzi": "我打算后年去留学。",
      "pinyin": "Wǒ dǎsuàn hòunián qù liúxué.",
      "meaning": "Tôi định năm sau nữa đi du học.",
      "readingMinutes": 1
    },
    {
      "id": "l356-t1",
      "type": "teaching",
      "title": "后天 · ngày kia",
      "text": "后天 là sau ngày mai một ngày, tính từ hôm nay. Không dùng cho mọi tương lai xa.",
      "hanzi": "我们后天见面。",
      "pinyin": "Wǒmen hòutiān jiàn miàn.",
      "meaning": "Chúng ta gặp ngày kia.",
      "readingMinutes": 1
    },
    {
      "id": "l356-t2",
      "type": "teaching",
      "title": "前年 · năm kia phía quá khứ",
      "text": "前年 là năm trước nữa, cách năm nay hai năm. 不同 去年 (năm ngoái).",
      "hanzi": "他前年搬到这里。",
      "pinyin": "Tā qiánnián bān dào zhèlǐ.",
      "meaning": "Anh ấy chuyển đến đây năm trước nữa.",
      "readingMinutes": 1
    },
    {
      "id": "l356-t3",
      "type": "teaching",
      "title": "前天 · hôm kia",
      "text": "前天 là ngày trước hôm qua, lấy ngày nói làm mốc. Không thể biết ngày trong tuần nếu chưa biết hôm nay.",
      "hanzi": "我前天给她写了信。",
      "pinyin": "Wǒ qiántiān gěi tā xiě le xìn.",
      "meaning": "Hôm kia tôi viết thư cho cô ấy.",
      "readingMinutes": 1
    },
    {
      "id": "l356-t4",
      "type": "teaching",
      "title": "以后 · sau/sau này",
      "text": "以后 nêu sau mốc hoặc tương lai trong ngữ cảnh; 上课以后 là sau giờ bắt đầu học/việc học tùy câu, nên dùng 下课以后 khi muốn rõ sau tan lớp.",
      "hanzi": "下课以后我去图书馆。",
      "pinyin": "Xià kè yǐhòu wǒ qù túshūguǎn.",
      "meaning": "Sau tan lớp tôi đến thư viện.",
      "readingMinutes": 1
    },
    {
      "id": "l356-t5",
      "type": "teaching",
      "title": "以前 · trước/trước đây",
      "text": "以前 nêu trước một mốc hoặc trước đây; 搬家以前 không phải đã hoàn thành chuyển nhà. Đề đọc quan hệ trước sau, không chấm ngày thật.",
      "hanzi": "搬家以前，我住在南方。",
      "pinyin": "Bān jiā yǐqián, wǒ zhù zài nánfāng.",
      "meaning": "Trước khi chuyển nhà tôi sống ở miền nam.",
      "readingMinutes": 1
    },
    {
      "id": "l356-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "前天/后天 lấy hôm nay làm mốc, 前年/后年 lấy năm nay. 以前/以后 cần một mốc từ ngữ hoặc ngữ cảnh. Chuyển ngày kể phải tính lại mốc, không giữ nguyên lịch cũ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l356-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林前年搬家，以前住在南方。他前天写信，后天要跟朋友见面。下课以后他先去图书馆，他打算后年才去留学。这些时间都按他说话的今天和今年来算。",
      "pinyin": "Xiǎo Lín qiánnián bān jiā, yǐqián zhù zài nánfāng. Tā qiántiān xiě xìn, hòutiān yào gēn péngyou jiàn miàn. Xià kè yǐhòu tā xiān qù túshūguǎn, tā dǎsuàn hòunián cái qù liúxué. Zhèxiē shíjiān dōu àn tā shuōhuà de jīntiān hé jīnnián lái suàn.",
      "meaning": "Lâm chuyển nhà năm trước nữa, trước đây ở miền nam; viết thư hôm kia, gặp bạn ngày kia, sau tan lớp đến thư viện, định năm sau nữa du học. Các mốc tính từ ngày/năm đang nói.",
      "readingMinutes": 2
    },
    {
      "id": "l356-b0",
      "type": "exercise",
      "exerciseVersionId": "l356-v2-e0"
    },
