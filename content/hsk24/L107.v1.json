  "blocks": [
    {
      "id": "l107-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l107-t0",
      "type": "teaching",
      "title": "爸爸 · bố; ba",
      "text": "爸爸 là cách gọi bố thân mật; âm sau thường nhẹ trong dạng từ điển ở bài.",
      "hanzi": "这是我爸爸。",
      "pinyin": "Zhè shì wǒ bà ba.",
      "meaning": "Đây là bố tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l107-t1",
      "type": "teaching",
      "title": "妈妈 · mẹ; má",
      "text": "妈妈 gọi mẹ; 我的妈妈 và 我妈妈 đều có thể chỉ mẹ của tôi.",
      "hanzi": "我妈妈喜欢茶。",
      "pinyin": "Wǒ mā ma xǐ huan chá.",
      "meaning": "Mẹ tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l107-t2",
      "type": "teaching",
      "title": "孩子 · trẻ em; con",
      "text": "孩子 có thể chỉ trẻ em hoặc con của ai theo ngữ cảnh, không chỉ con trai.",
      "hanzi": "那个孩子叫文。",
      "pinyin": "Nà ge hái zi jiào Wén.",
      "meaning": "Đứa trẻ kia tên Văn.",
      "readingMinutes": 1
    },
    {
      "id": "l107-t3",
      "type": "teaching",
      "title": "家人 · người nhà; thành viên gia đình",
      "text": "家人 là người trong gia đình; 这是我的家人 giới thiệu người nhà theo tình huống.",
      "hanzi": "这是我的家人。",
      "pinyin": "Zhè shì wǒ de jiā rén.",
      "meaning": "Đây là người nhà của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l107-t4",
      "type": "teaching",
      "title": "家 · nhà; gia đình",
      "text": "家 trong 我家 nói nhà/gia đình tôi; không đồng nghĩa một người thân riêng lẻ.",
      "hanzi": "这是我家。",
      "pinyin": "Zhè shì wǒ jiā.",
      "meaning": "Đây là nhà tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l107-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "我的爸爸/我的妈妈 chỉ quan hệ người thân; với quan hệ thân thiết thường có thể bỏ 的: 我爸爸. 家人 là người trong gia đình, 家 có thể là nhà/gia đình theo câu. Không dùng 家 thay tất cả các cách gọi một người thân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l107-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这是我爸爸，这是我妈妈。\nB：那个孩子是谁？\nA：他叫文。他是我的家人。\nB：你好，文！",
      "pinyin": "A: Zhè shì wǒ bà ba, zhè shì wǒ mā ma. B: Nà ge hái zi shì shéi? A: Tā jiào Wén. Tā shì wǒ de jiā rén. B: Nǐ hǎo, Wén!",
      "meaning": "A giới thiệu bố mẹ và nói Văn là người nhà. Đoạn không nói quan hệ cụ thể giữa A và Văn.",
      "readingMinutes": 2
    },
