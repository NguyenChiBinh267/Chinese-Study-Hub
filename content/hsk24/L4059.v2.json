  "blocks": [
    {
      "id": "l4059-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t0",
      "type": "teaching",
      "title": "仅仅 · chỉ; vẻn vẹn",
      "text": "仅仅 giới hạn phạm vi, không nhấn mức độ cao. Nhận diện chữ 仅 trong 仅仅; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我仅仅检查了第一页。",
      "pinyin": "Wǒ jǐn jǐn jiǎn chá le dì yī yè.",
      "meaning": "Tôi chỉ kiểm tra trang đầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t1",
      "type": "teaching",
      "title": "十分 · rất; hết sức",
      "text": "十分 làm phó từ mức độ trong câu này, không phải điểm số.",
      "hanzi": "她十分认真。",
      "pinyin": "Tā shí fēn rèn zhēn.",
      "meaning": "Cô ấy rất nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t2",
      "type": "teaching",
      "title": "实在 · thật sự; quả là",
      "text": "实在 ở đây nhấn cảm nhận của người nói.",
      "hanzi": "今天实在太忙了。",
      "pinyin": "Jīn tiān shí zài tài máng le.",
      "meaning": "Hôm nay thật sự bận quá.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t3",
      "type": "teaching",
      "title": "完全 · hoàn toàn",
      "text": "完全 biểu thị toàn bộ mức độ/phạm vi, không chỉ phần lớn.",
      "hanzi": "我完全同意这个建议。",
      "pinyin": "Wǒ wán quán tóng yì zhè ge jiàn yì.",
      "meaning": "Tôi hoàn toàn đồng ý đề nghị này.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t4",
      "type": "teaching",
      "title": "许多 · nhiều",
      "text": "许多 nói số lượng đáng kể, không có nghĩa mọi người/vật.",
      "hanzi": "桌上还有许多材料。",
      "pinyin": "Zhuō shàng hái yǒu xǔ duō cái liào.",
      "meaning": "Trên bàn vẫn còn nhiều tư liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-t5",
      "type": "teaching",
      "title": "一切 · mọi thứ; tất cả",
      "text": "一切 chỉ toàn bộ trong phạm vi đang nói; theo đọc nguồn yíqiè.",
      "hanzi": "一切都准备好了。",
      "pinyin": "Yí qiè dōu zhǔn bèi hǎo le.",
      "meaning": "Mọi thứ đều đã chuẩn bị xong.",
      "readingMinutes": 1
    },
    {
      "id": "l4059-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "够忙的 nhấn khá bận trong lời nhận xét. Các từ mức độ khác cần xét đúng phạm vi: 完全 là hoàn toàn, 仅仅 là chỉ, không tự hoán đổi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4059-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小方十分认真，可今天实在太忙了。桌上还有许多材料，他仅仅检查了第一页，不敢说一切都好了。朋友说：“今天够忙的，我们分工吧。”小方完全同意。",
      "pinyin": "Xiǎo Fāng shí fēn rèn zhēn, kě jīn tiān shí zài tài máng le. Zhuō shàng hái yǒu xǔ duō cái liào, tā jǐn jǐn jiǎn chá le dì yī yè, bù gǎn shuō yí qiè dōu hǎo le. Péng you shuō: “Jīn tiān gòu máng de, wǒ men fēn gōng ba.” Xiǎo Fāng wán quán tóng yì.",
      "meaning": "Tiểu Phương chỉ kiểm trang đầu nên không nói mọi việc xong; anh đồng ý chia việc.",
      "readingMinutes": 2
    },
