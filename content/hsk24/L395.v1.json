  "blocks": [
    {
      "id": "l395-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder0",
      "type": "teaching",
      "title": "环境 · môi trường/khung cảnh",
      "text": "环境 mô tả điều kiện xung quanh như yên tĩnh, sạch. Không coi đây chỉ là thời tiết hoặc một đồ vật riêng.",
      "hanzi": "这里的环境很安静。",
      "pinyin": "Zhèlǐ de huánjìng hěn ānjìng.",
      "meaning": "Môi trường ở đây yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder1",
      "type": "teaching",
      "title": "南 · nam",
      "text": "南 là hướng nam, khác 男 chỉ nam giới dù cùng đọc nán. 在南边 mô tả vị trí, không chỉ đi xuống cầu thang.",
      "hanzi": "我们往南走。",
      "pinyin": "Wǒmen wǎng nán zǒu.",
      "meaning": "Chúng tôi đi về phía nam.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder2",
      "type": "teaching",
      "title": "北 · bắc",
      "text": "北 là hướng bắc. 北京 là tên riêng, không thay cho từ chỉ hướng trong câu 往北走.",
      "hanzi": "请往北走，再往东走。",
      "pinyin": "Qǐng wǎng běi zǒu, zài wǎng dōng zǒu.",
      "meaning": "Hãy đi bắc rồi đi đông.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder3",
      "type": "teaching",
      "title": "方向 · phương hướng",
      "text": "方向 là hướng đi hoặc hướng chỉ; 你走错方向了 nói nhầm hướng, không nhất thiết nhầm địa điểm hẹn.",
      "hanzi": "我不知道车站在哪个方向。",
      "pinyin": "Wǒ bù zhīdào chēzhàn zài nǎ ge fāngxiàng.",
      "meaning": "Tôi không biết ga ở hướng nào.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder4",
      "type": "teaching",
      "title": "换 · đổi/thay",
      "text": "换 nói đổi một vật hoặc thay thứ đang dùng. 换一个包 là đổi sang túi khác; khác 还 huán trả lại vật.",
      "hanzi": "这个包太小，我想换一个。",
      "pinyin": "Zhège bāo tài xiǎo, wǒ xiǎng huàn yí ge.",
      "meaning": "Túi này nhỏ quá, tôi muốn đổi một cái.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder5",
      "type": "teaching",
      "title": "丢 · làm mất/thất lạc",
      "text": "丢 trong 我的包丢了 nói túi thất lạc. Không dùng mặc nhiên nghĩa cố ý vứt; cần ngữ cảnh để phân biệt.",
      "hanzi": "我的包丢了，里面有票。",
      "pinyin": "Wǒ de bāo diū le, lǐmian yǒu piào.",
      "meaning": "Túi tôi bị thất lạc, bên trong có vé.",
      "readingMinutes": 1
    },
    {
      "id": "l395-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对我来说 giới hạn nhận xét theo góc nhìn người nói. Một nơi thuận tiện cho người cần tàu điện không có nghĩa thuận tiện cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l395-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：这家宾馆怎么样？小李：对我来说，这个地方很方便，附近有地铁站。小安：环境呢？小李：晚上很安静。我们见面的地点就在宾馆门口，不用去车站。",
      "pinyin": "Xiǎo Ān: Zhè jiā bīnguǎn zěnmeyàng? Xiǎo Lǐ: Duì wǒ lái shuō, zhège dìfang hěn fāngbiàn, fùjìn yǒu dìtiězhàn. Xiǎo Ān: Huánjìng ne? Xiǎo Lǐ: Wǎnshang hěn ānjìng. Wǒmen jiànmiàn de dìdiǎn jiù zài bīnguǎn ménkǒu, búyòng qù chēzhàn.",
      "meaning": "An hỏi khách sạn. Lý thấy nơi này tiện vì gần ga tàu điện, buổi tối yên tĩnh. Hai người gặp ngay cửa khách sạn, không phải cửa ga.",
      "readingMinutes": 2
    },
