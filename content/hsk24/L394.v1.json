  "blocks": [
    {
      "id": "l394-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder0",
      "type": "teaching",
      "title": "行李 · hành lý",
      "text": "行李 chỉ đồ mang theo chuyến đi; thường dùng 件 khi đếm từng kiện. Không gọi giấy thông hành là hành lý khi hỏi loại giấy tờ.",
      "hanzi": "我的行李不多，只有一个包。",
      "pinyin": "Wǒ de xíngli bù duō, zhǐ yǒu yí ge bāo.",
      "meaning": "Hành lý tôi ít, chỉ có một túi.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder1",
      "type": "teaching",
      "title": "护照 · hộ chiếu",
      "text": "护照 là giấy tờ định danh đi quốc tế. Bài luyện nhận biết từ, không khẳng định yêu cầu nhập cảnh hay đi tàu thực tế ở bất kỳ nước nào.",
      "hanzi": "请不要忘了带护照。",
      "pinyin": "Qǐng bú yào wàng le dài hùzhào.",
      "meaning": "Xin đừng quên mang hộ chiếu.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder2",
      "type": "teaching",
      "title": "检票 · kiểm vé",
      "text": "检票 là kiểm tra vé; khác 买票 mua vé và 上车 lên xe/tàu. 检票口 là nơi kiểm vé, 口 là hỗ trợ.",
      "hanzi": "检票以后，我们再上车。",
      "pinyin": "Jiǎnpiào yǐhòu, wǒmen zài shàng chē.",
      "meaning": "Sau khi kiểm vé chúng tôi mới lên tàu.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder3",
      "type": "teaching",
      "title": "地图 · bản đồ",
      "text": "地图 giúp xem vị trí và đường đi. 电子地图 là bản đồ điện tử, không phải tự động là vé hay lịch tàu.",
      "hanzi": "我在地图上找车站。",
      "pinyin": "Wǒ zài dìtú shang zhǎo chēzhàn.",
      "meaning": "Tôi tìm ga trên bản đồ.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder4",
      "type": "teaching",
      "title": "宾馆 · khách sạn/nhà nghỉ",
      "text": "宾馆 là cơ sở lưu trú; cùng trường nghĩa 酒店 nhưng không phân cấp chất lượng chỉ từ tên gọi. Không suy ra giá hay hạng sao.",
      "hanzi": "我们在车站附近找了一家宾馆。",
      "pinyin": "Wǒmen zài chēzhàn fùjìn zhǎo le yì jiā bīnguǎn.",
      "meaning": "Chúng tôi tìm một khách sạn gần ga.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder5",
      "type": "teaching",
      "title": "宾馆 · khách sạn/nhà nghỉ",
      "text": "宾馆 là cơ sở lưu trú; cùng trường nghĩa 酒店 nhưng không phân cấp chất lượng chỉ từ tên gọi. Không suy ra giá hay hạng sao.",
      "hanzi": "我们在车站附近找了一家宾馆。",
      "pinyin": "Wǒmen zài chēzhàn fùjìn zhǎo le yì jiā bīnguǎn.",
      "meaning": "Chúng tôi tìm một khách sạn gần ga.",
      "readingMinutes": 1
    },
    {
      "id": "l394-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "出发以前 và 出发以后 đặt sự việc làm mốc. 出发以前检票 là kiểm vé trước khi khởi hành; không đảo thành sau khi đi. 以前/以后 là hỗ trợ được giải thích, chưa tính thêm từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l394-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我们几点出发？小李：八点。出发以前，先看看行李，别忘了护照和票。小安：我们坐高铁吗？小李：对。先检票，再上车。我在地图上找到了车站。",
      "pinyin": "Xiǎo Ān: Wǒmen jǐ diǎn chūfā? Xiǎo Lǐ: Bā diǎn. Chūfā yǐqián, xiān kànkan xíngli, bié wàng le hùzhào hé piào. Xiǎo Ān: Wǒmen zuò gāotiě ma? Xiǎo Lǐ: Duì. Xiān jiǎnpiào, zài shàng chē. Wǒ zài dìtú shang zhǎodào le chēzhàn.",
      "meaning": "An hỏi giờ khởi hành. Lý nói 8 giờ, nhắc kiểm hành lý, đừng quên hộ chiếu và vé trong chuyến đi của họ. Hai người đi tàu cao tốc, kiểm vé rồi lên tàu; Lý đã tìm ga trên bản đồ.",
      "readingMinutes": 2
    },
