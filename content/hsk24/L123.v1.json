  "blocks": [
    {
      "id": "l123-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l123-t0",
      "type": "teaching",
      "title": "说 · nói",
      "text": "说 trong 说汉语 là nói tiếng Trung; không thay bằng 写 nếu đang nói bằng miệng.",
      "hanzi": "我说汉语。",
      "pinyin": "Wǒ shuō Hàn yǔ.",
      "meaning": "Tôi nói tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l123-t1",
      "type": "teaching",
      "title": "说话 · nói chuyện; nói",
      "text": "说话 gọi hoạt động nói; với lời nhắc trên lớp, cần chú ý lịch sự và ngữ cảnh.",
      "hanzi": "请不要说话。",
      "pinyin": "Qǐng bú yào shuō huà.",
      "meaning": "Xin đừng nói chuyện.",
      "readingMinutes": 1
    },
    {
      "id": "l123-t2",
      "type": "teaching",
      "title": "听 · nghe; lắng nghe",
      "text": "听 chỉ việc nghe/lắng nghe; không tự chứng minh đã nghe rõ mọi nội dung.",
      "hanzi": "我听老师说话。",
      "pinyin": "Wǒ tīng lǎo shī shuō huà.",
      "meaning": "Tôi nghe giáo viên nói.",
      "readingMinutes": 1
    },
    {
      "id": "l123-t3",
      "type": "teaching",
      "title": "听见 · nghe thấy; nghe được",
      "text": "听见 nhấn đã nghe thấy trong tình huống, khác chỉ làm hành động lắng nghe.",
      "hanzi": "我听见了。",
      "pinyin": "Wǒ tīng jiàn le.",
      "meaning": "Tôi nghe thấy rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l123-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "说 thường đi với nội dung/ngôn ngữ, như 说汉语; 说话 nói hành động nói chuyện. 听 là nghe/lắng nghe, 听见 nhấn việc nghe được âm/thông tin trong câu. Một đoạn hội thoại có chữ 听 không biến bài đọc thành bài kiểm tra nghe; chưa có audio đã duyệt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l123-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你听见了吗？\nB：没听见，请再说。\nA：我叫安。\nB：我听见了，谢谢！",
      "pinyin": "A: Nǐ tīng jiàn le ma? B: Méi tīng jiàn, qǐng zài shuō. A: Wǒ jiào Ān. B: Wǒ tīng jiàn le, xiè xie!",
      "meaning": "没 méi = không/chưa trong việc đã xảy ra; 再 zài = lại; 了 le = rồi trong câu này. Đọc lời nhân vật hư cấu, không chấm khả năng nghe thật.",
      "readingMinutes": 2
    },
    {
