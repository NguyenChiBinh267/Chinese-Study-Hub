  "blocks": [
    {
      "id": "l169-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l169-t0",
      "type": "teaching",
      "title": "饭店 · nhà hàng; quán ăn (trong cảnh này)",
      "text": "饭店 ở bài là nơi ăn uống; từ cũng có cách dùng chỉ khách sạn trong ngữ cảnh khác, không áp nghĩa đó vào mọi câu ở đây.",
      "hanzi": "我们去饭店吃饭吧。",
      "pinyin": "Wǒ men qù fàn diàn chī fàn ba.",
      "meaning": "Chúng ta đến quán ăn ăn cơm nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l169-t1",
      "type": "teaching",
      "title": "好吃 · ngon (đối với món ăn)",
      "text": "好吃 là nhận xét món ăn của người nói; không dùng thay 好喝 cho mọi đồ uống.",
      "hanzi": "这个饺子很好吃。",
      "pinyin": "Zhè ge jiǎo zi hěn hǎo chī.",
      "meaning": "Chiếc sủi cảo này ngon.",
      "readingMinutes": 1
    },
    {
      "id": "l169-t2",
      "type": "teaching",
      "title": "怎么样 · thế nào; ra sao (dạng zěnmeyàng)",
      "text": "怎么样 hỏi tình trạng/đánh giá trong câu mẫu, khác câu hỏi cách đi có 怎么.",
      "hanzi": "这个饭店怎么样？",
      "pinyin": "Zhè ge fàn diàn zěn me yàng?",
      "meaning": "Quán ăn này thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l169-t3",
      "type": "teaching",
      "title": "吧 · nhé; đi (trợ từ nhẹ ba)",
      "text": "吧 ở lời đề nghị cuối câu; bài chưa bao quát mọi công dụng suy đoán của trợ từ.",
      "hanzi": "我们去吧。",
      "pinyin": "Wǒ men qù ba.",
      "meaning": "Chúng ta đi nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l169-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "怎么样 hỏi tình trạng/đánh giá như 这个饭店怎么样; 怎么 ở bài trước thường hỏi cách làm trong 你怎么去学校. 吧 cuối 我们去饭店吧 làm lời đề nghị nhẹ hơn, chưa phải lời xác nhận người kia đồng ý. 好吃 nhận xét món ăn ngon theo người nói, không phải một phép đo khách quan.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l169-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这个饭店怎么样？\nB：饺子很好吃。\nA：我们去饭店吃饭吧。\nB：好，我想吃饺子。",
      "pinyin": "A: Zhè ge fàn diàn zěn me yàng? B: Jiǎo zi hěn hǎo chī. A: Wǒ men qù fàn diàn chī fàn ba. B: Hǎo, wǒ xiǎng chī jiǎo zi.",
      "meaning": "B khen sủi cảo, rồi đồng ý lời đề nghị đi ăn. Tên quán, giá và chất lượng thực tế không được xác nhận bởi truyện.",
      "readingMinutes": 2
    },
