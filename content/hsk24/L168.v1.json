  "blocks": [
    {
      "id": "l168-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l168-t0",
      "type": "teaching",
      "title": "国 · nước; quốc gia (dạng guó)",
      "text": "国 dùng trong 哪国人 hỏi người nước nào; không phải nghĩa nước uống của 水.",
      "hanzi": "你是哪国人？",
      "pinyin": "Nǐ shì nǎ guó rén?",
      "meaning": "Bạn là người nước nào?",
      "readingMinutes": 1
    },
    {
      "id": "l168-t1",
      "type": "teaching",
      "title": "中国 · Trung Quốc",
      "text": "中国 là tên riêng Trung Quốc; pinyin tên riêng bắt đầu bằng chữ hoa theo mục từ nguồn.",
      "hanzi": "我朋友在中国。",
      "pinyin": "Wǒ péng you zài Zhōng guó.",
      "meaning": "Bạn tôi ở Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l168-t2",
      "type": "teaching",
      "title": "岁 · tuổi (đơn vị suì)",
      "text": "岁 đứng sau số tuổi; 八岁 là tám tuổi, không phải tám năm cho mọi thời lượng.",
      "hanzi": "我八岁。",
      "pinyin": "Wǒ bā suì.",
      "meaning": "Tôi tám tuổi.",
      "readingMinutes": 1
    },
    {
      "id": "l168-t3",
      "type": "teaching",
      "title": "小朋友 · bạn nhỏ; trẻ nhỏ",
      "text": "小朋友 là cách gọi trẻ/bạn nhỏ; không suy tuổi chính xác nếu đoạn chưa nêu.",
      "hanzi": "这个小朋友八岁。",
      "pinyin": "Zhè ge xiǎo péng you bā suì.",
      "meaning": "Bạn nhỏ này tám tuổi.",
      "readingMinutes": 1
    },
    {
      "id": "l168-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Trong 我八岁, 八岁 làm vị ngữ chỉ tuổi, không cần thêm 是 như khi nhận diện 我是学生. 岁 đo tuổi, không thay cho 年 ở mọi thời lượng. 国 là nước/quốc gia; 中国 là tên riêng Trung Quốc. Tên người và tuổi dưới đây chỉ là dữ kiện của truyện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l168-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这个小朋友叫什么名字？\nB：他叫安，八岁。\nA：他在哪儿？\nB：他在中国。",
      "pinyin": "A: Zhè ge xiǎo péng you jiào shén me míng zi? B: Tā jiào Ān, bā suì. A: Tā zài nǎr? B: Tā zài Zhōng guó.",
      "meaning": "Truyện nói An8tuổi và ở Trung Quốc; nơi đang ở không tự chứng minh quốc tịch.",
      "readingMinutes": 2
    },
