  "blocks": [
    {
      "id": "l245-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "喝 là uống, 吃 là ăn, 要 ở đây là muốn gọi món. Câu hỏi A 还是 B yêu cầu chọn phương án, không thêm 吗 trong mẫu này. 杯 là cốc, dùng đếm đồ uống; 家 đếm cơ sở như quán ăn trong 一家饭馆.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t0",
      "type": "teaching",
      "title": "Nhắc lại · 红茶 · trà đen, thường gọi hồng trà",
      "text": "红茶 là tên loại trà, thường tương ứng black tea. Không dịch máy móc thành mọi nước trà màu đỏ.",
      "hanzi": "我想喝一杯红茶。",
      "pinyin": "Wǒ xiǎng hē yì bēi hóngchá.",
      "meaning": "Tôi muốn uống một cốc hồng trà.",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t1",
      "type": "teaching",
      "title": "Nhắc lại · 绿茶 · trà xanh",
      "text": "绿茶 là tên trà xanh; chữ 绿 có âm ü, không đọc lù. Giữ thanh bốn ở lǜ.",
      "hanzi": "妈妈喜欢喝绿茶。",
      "pinyin": "Māma xǐhuan hē lǜchá.",
      "meaning": "Mẹ thích uống trà xanh.",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t2",
      "type": "teaching",
      "title": "Nhắc lại · 咖啡 · cà phê",
      "text": "Hai âm tiết đều thanh một. 咖啡 là đồ uống; 一杯咖啡 là một cốc cà phê.",
      "hanzi": "这杯咖啡很热。",
      "pinyin": "Zhè bēi kāfēi hěn rè.",
      "meaning": "Cốc cà phê này nóng.",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t3",
      "type": "teaching",
      "title": "Nhắc lại · 奶茶 · trà sữa",
      "text": "奶茶 là trà pha sữa; không mặc định có trân châu hay nhiều đường. Muốn biết thành phần phải hỏi thêm.",
      "hanzi": "你要奶茶还是绿茶？",
      "pinyin": "Nǐ yào nǎichá háishi lǜchá?",
      "meaning": "Bạn muốn trà sữa hay trà xanh?",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t4",
      "type": "teaching",
      "title": "Nhắc lại · 饭馆 · quán ăn, nhà hàng",
      "text": "饭馆 là nơi ăn uống; không phải 饭店 trong mọi ngữ cảnh và không phải ‘nhà cơm’ dịch từng chữ.",
      "hanzi": "学校旁边有一家饭馆。",
      "pinyin": "Xuéxiào pángbiān yǒu yì jiā fànguǎn.",
      "meaning": "Bên cạnh trường có một quán ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-t5",
      "type": "teaching",
      "title": "Nhắc lại · 鱼 · cá",
      "text": "鱼 có âm ü, không đọc yǔ hoặc yù. Ở đây dùng danh từ món cá; việc nói 我不吃鱼 không tự cho biết lý do.",
      "hanzi": "我想吃鱼。",
      "pinyin": "Wǒ xiǎng chī yú.",
      "meaning": "Tôi muốn ăn cá.",
      "readingMinutes": 1
    },
    {
      "id": "l245-t0-l205-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "Dùng 还是 giữa hai món để hỏi khách chọn gì. Trả lời bằng tên món hoặc 我要 + món. 还是 trong bài chỉ là nối lựa chọn, không phải nghĩa ‘vẫn’ trong các ngữ cảnh khác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l245-t0-l205-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：这家饭馆有鱼，我们在这里吃吧。乙：好。甲：你喝红茶还是绿茶？乙：我要绿茶，不要奶茶。",
      "pinyin": "Jiǎ: Zhè jiā fànguǎn yǒu yú, wǒmen zài zhèlǐ chī ba. Yǐ: Hǎo. Jiǎ: Nǐ hē hóngchá háishi lǜchá? Yǐ: Wǒ yào lǜchá, bú yào nǎichá.",
      "meaning": "A: Quán này có cá, chúng ta ăn ở đây nhé. B: Được. A: Bạn uống hồng trà hay trà xanh? B: Tôi muốn trà xanh, không lấy trà sữa.",
      "readingMinutes": 2
    },
