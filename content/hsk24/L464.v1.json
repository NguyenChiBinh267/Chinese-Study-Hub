  "blocks": [
    {
      "id": "l464-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 初学者 chūxuézhě: người mới; 绳 shéng: dây; 捡 jiǎn: nhặt; 撞 zhuàng: va vào. Đây là đọc hiểu, không xác nhận năng lực vận động.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l464-t0",
      "type": "teaching",
      "title": "拉 · kéo",
      "text": "拉 chỉ kéo về phía mình/đưa bằng lực kéo; khác 推 là đẩy.",
      "hanzi": "请轻轻拉这根绳子。",
      "pinyin": "Qǐng qīngqīng lā zhè gēn shéngzi.",
      "meaning": "Hãy kéo nhẹ sợi dây này.",
      "readingMinutes": 1
    },
    {
      "id": "l464-t1",
      "type": "teaching",
      "title": "举 · giơ, nâng lên",
      "text": "举 trong 举手 là đưa tay lên, khác 抬 có phạm vi kết hợp khác. Nhận diện chữ 举 trong 举; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "有问题请举手。",
      "pinyin": "Yǒu wèntí qǐng jǔ shǒu.",
      "meaning": "Có câu hỏi xin giơ tay.",
      "readingMinutes": 1
    },
    {
      "id": "l464-t2",
      "type": "teaching",
      "title": "拍 · vỗ, chụp",
      "text": "拍 ở đây là vỗ nhẹ bằng tay; 拍照 là kết hợp nghĩa chụp ảnh bổ sung.",
      "hanzi": "请轻轻拍手。",
      "pinyin": "Qǐng qīngqīng pāi shǒu.",
      "meaning": "Hãy vỗ tay nhẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l464-t3",
      "type": "teaching",
      "title": "排 · xếp thành hàng",
      "text": "排在后面 nói vị trí xếp hàng, khác 拍 là vỗ có bộ tay.",
      "hanzi": "请排在我后面。",
      "pinyin": "Qǐng pái zài wǒ hòumiàn.",
      "meaning": "Hãy xếp sau tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l464-t4",
      "type": "teaching",
      "title": "路过 · đi ngang qua",
      "text": "路过 chỉ hành trình ngang qua nơi nào, không nhất thiết dừng vào.",
      "hanzi": "我路过操场时看见了教练。",
      "pinyin": "Wǒ lùguò cāochǎng shí kànjiàn le jiàoliàn.",
      "meaning": "Khi qua sân tôi thấy huấn luyện viên.",
      "readingMinutes": 1
    },
    {
      "id": "l464-t5",
      "type": "teaching",
      "title": "落 · rơi, rụng, hạ",
      "text": "落 luò trong 叶子落 xuống; không dùng đọc lào/là của nghĩa khác.",
      "hanzi": "叶子从树上落下来。",
      "pinyin": "Yèzi cóng shù shàng luò xià lái.",
      "meaning": "Lá rụng từ trên cây xuống.",
      "readingMinutes": 1
    },
    {
      "id": "l464-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把 + vật xác định + trạng ngữ + động từ diễn tả cách xử lý: 请把手慢慢举起来. 慢慢 đứng sau 把手 và trước động từ; không dùng 请慢慢把 trong bài sắp xếp này vì đã gộp cụm 请把手.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l464-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小孙路过操场，看见初学者排在教练后面。教练先说：“请把手慢慢举起来，再轻轻拍手。”接着大家练习拉一根软绳。树叶落在地上，有人想跑去捡，教练让他先看清周围，别撞到别人。",
      "pinyin": "Xiǎo Sūn lùguò cāochǎng, kànjiàn chūxuézhě pái zài jiàoliàn hòumiàn. Jiàoliàn xiān shuō: “Qǐng bǎ shǒu mànmàn jǔ qǐ lái, zài qīngqīng pāi shǒu.” Jiēzhe dàjiā liànxí lā yì gēn ruǎn shéng. Shùyè luò zài dì shàng, yǒu rén xiǎng pǎo qù jiǎn, jiàoliàn ràng tā xiān kàn qīng zhōuwéi, bié zhuàng dào biérén.",
      "meaning": "Tôn đi qua sân thấy nhóm mới tập theo hướng dẫn giơ tay và vỗ nhẹ, rồi kéo dây mềm. Khi có người định nhặt lá, huấn luyện viên nhắc nhìn xung quanh.",
      "readingMinutes": 2
    },
    {
