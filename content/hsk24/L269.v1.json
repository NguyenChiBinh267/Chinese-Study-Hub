  "blocks": [
    {
      "id": "l269-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "买 là mua; 钱 là tiền; 块 trong giá tiền là đơn vị tệ trong ví dụ hư cấu. Các số tiền tự soạn chỉ dùng học ngôn ngữ, không phải giá thị trường.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t0",
      "type": "teaching",
      "title": "Nhắc lại · 包 · túi, chiếc túi",
      "text": "包 ở đây là danh từ túi. Nguồn còn ghi động từ/lượng từ, nhưng bài chỉ chấm nghĩa danh từ trong 这个包.",
      "hanzi": "这个包是我的。",
      "pinyin": "Zhège bāo shì wǒ de.",
      "meaning": "Chiếc túi này của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t1",
      "type": "teaching",
      "title": "Nhắc lại · 肉 · thịt",
      "text": "肉 chỉ thịt nói chung; câu không nêu loại thì không tự kết luận thịt bò hay thịt lợn.",
      "hanzi": "我们买一些肉。",
      "pinyin": "Wǒmen mǎi yìxiē ròu.",
      "meaning": "Chúng tôi mua một ít thịt.",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t2",
      "type": "teaching",
      "title": "Nhắc lại · 花 · tiêu, chi tiền hoặc thời gian",
      "text": "花1 trong 花钱 là động từ chi tiêu. Không chọn nghĩa bông hoa ở ngữ cảnh này dù cùng đọc huā.",
      "hanzi": "买这些东西要花多少钱？",
      "pinyin": "Mǎi zhèxiē dōngxi yào huā duōshao qián?",
      "meaning": "Mua những đồ này phải tốn bao nhiêu tiền?",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t3",
      "type": "teaching",
      "title": "Nhắc lại · 万 · mười nghìn",
      "text": "万 là đơn vị số đếm 10.000. 一万 = mười nghìn, không phải một triệu.",
      "hanzi": "一万比一千多。",
      "pinyin": "Yí wàn bǐ yì qiān duō.",
      "meaning": "Mười nghìn lớn hơn một nghìn.",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t4",
      "type": "teaching",
      "title": "Nhắc lại · 门票 · vé vào cửa",
      "text": "门票 là vé vào một địa điểm/sự kiện; khác 机票 là vé máy bay. Không suy ra được miễn phí nếu chỉ nói có vé.",
      "hanzi": "门票已经买好了。",
      "pinyin": "Ménpiào yǐjīng mǎi hǎo le.",
      "meaning": "Vé vào cửa đã mua xong rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-t5",
      "type": "teaching",
      "title": "Nhắc lại · 坏 · hỏng, không còn hoạt động tốt trong câu",
      "text": "坏 ở đây là hỏng đồ vật. Không dùng nghĩa đạo đức xấu của người để trả lời câu điện thoại hỏng.",
      "hanzi": "我的手机坏了。",
      "pinyin": "Wǒ de shǒujī huài le.",
      "meaning": "Điện thoại của tôi hỏng rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l269-t0-l229-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "一万 là 10.000. Không bỏ một số không khi dịch từ 万 sang nghìn; ví dụ 一万块 là mười nghìn tệ, không phải một nghìn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l269-t0-l229-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：明天出去玩，门票买了吗？乙：买好了。我还想买一些肉和水。甲：用这个包吧。乙：这个包坏了，我们用那个。",
      "pinyin": "Jiǎ: Míngtiān chūqù wán, ménpiào mǎi le ma? Yǐ: Mǎi hǎo le. Wǒ hái xiǎng mǎi yìxiē ròu hé shuǐ. Jiǎ: Yòng zhège bāo ba. Yǐ: Zhège bāo huài le, wǒmen yòng nàge.",
      "meaning": "A: Mai đi chơi, mua vé vào cửa chưa? B: Mua xong rồi. Tôi còn muốn mua ít thịt và nước. A: Dùng túi này nhé. B: Túi này hỏng rồi, dùng túi kia đi.",
      "readingMinutes": 2
    },
