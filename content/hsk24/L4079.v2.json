  "blocks": [
    {
      "id": "l4079-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t0",
      "type": "teaching",
      "title": "图 · hình; sơ đồ",
      "text": "图 ở 座位图 là sơ đồ chỗ ngồi, không phải mục tiêu 图谋.",
      "hanzi": "请先看座位图。",
      "pinyin": "Qǐng xiān kàn zuò wèi tú.",
      "meaning": "Xin xem sơ đồ chỗ ngồi trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t1",
      "type": "teaching",
      "title": "图片 · hình ảnh",
      "text": "图片 là hình dùng minh họa; mô tả này không kèm file ảnh.",
      "hanzi": "说明里有一张图片。",
      "pinyin": "Shuō míng lǐ yǒu yì zhāng tú piàn.",
      "meaning": "Trong bản hướng dẫn có một hình ảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t2",
      "type": "teaching",
      "title": "小吃 · món ăn nhẹ; quà vặt",
      "text": "小吃 chỉ món ăn nhỏ/đặc trưng theo nơi, không có nghĩa mọi món ăn đều nhỏ.",
      "hanzi": "演出前，我们买了小吃。",
      "pinyin": "Yǎn chū qián, wǒ men mǎi le xiǎo chī.",
      "meaning": "Trước buổi diễn chúng tôi mua món ăn nhẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t3",
      "type": "teaching",
      "title": "闻 · ngửi; ngửi thấy",
      "text": "闻 ở 闻到香味 nói cảm nhận bằng mũi; bài chữ không kiểm tra khứu giác.",
      "hanzi": "我闻到了面包的香味。",
      "pinyin": "Wǒ wén dào le miàn bāo de xiāng wèi.",
      "meaning": "Tôi ngửi thấy mùi thơm bánh mì.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t4",
      "type": "teaching",
      "title": "响 · vang; phát tiếng",
      "text": "响 ở 铃响 nói chuông phát tiếng, không tự có audio trong bài.",
      "hanzi": "铃响了，观众走进大厅。",
      "pinyin": "Líng xiǎng le, guān zhòng zǒu jìn dà tīng.",
      "meaning": "Chuông vang, khán giả vào sảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-t5",
      "type": "teaching",
      "title": "座位 · chỗ ngồi",
      "text": "座位 là vị trí cho người ngồi, khác 整座 là lượng từ công trình. Nhận diện chữ 座 trong 座位; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请按号码找座位。",
      "pinyin": "Qǐng àn hào mǎ zhǎo zuò wèi.",
      "meaning": "Xin tìm chỗ ngồi theo số.",
      "readingMinutes": 1
    },
    {
      "id": "l4079-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 lấy tình hình làm căn cứ. 图 và 图片 là danh từ liên quan hình; bài chỉ mô tả bằng chữ, không có ảnh thật hoặc âm thanh để nhận diện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4079-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "这段文字描述一场演出：门口的说明有座位图和一张图片。小林买了小吃，闻到面包的香味。铃响后，他按号码找座位。既然演出快开始了，他就收好食物，安静地坐下。这里没有实际图片或录音。",
      "pinyin": "Zhè duàn wén zì miáo shù yì chǎng yǎn chū: mén kǒu de shuō míng yǒu zuò wèi tú hé yì zhāng tú piàn. Xiǎo Lín mǎi le xiǎo chī, wén dào miàn bāo de xiāng wèi. Líng xiǎng hòu, tā àn hào mǎ zhǎo zuò wèi. Jì rán yǎn chū kuài kāi shǐ le, tā jiù shōu hǎo shí wù, ān jìng de zuò xià. Zhè lǐ méi yǒu shí jì tú piàn huò lù yīn.",
      "meaning": "Đoạn chỉ mô tả bằng chữ việc xem sơ đồ và vào chỗ sau tiếng chuông.",
      "readingMinutes": 2
    },
