  "blocks": [
    {
      "id": "l1156-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder0",
      "type": "teaching",
      "title": "个 · cái; người (lượng từ phổ biến)",
      "text": "Từ đã học 个 có 1 chữ. Chữ 个 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 个 với 伞 / 人 / 入; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "一个朋友。",
      "pinyin": "Yí ge péng you.",
      "meaning": "Một người bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder1",
      "type": "teaching",
      "title": "大 · to; lớn",
      "text": "Từ đã học 大 có 1 chữ. Chữ 大 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 大 với 太 / 犬 / 天; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那只狗很大。",
      "pinyin": "Nà zhī gǒu hěn dà.",
      "meaning": "Con chó kia to.",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder2",
      "type": "teaching",
      "title": "谁 · ai",
      "text": "Từ đã học 谁 có 1 chữ. Chữ 谁 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 谁 với 推 / 准 / 难; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他是谁？",
      "pinyin": "Tā shì shéi?",
      "meaning": "Anh ấy là ai?",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder3",
      "type": "teaching",
      "title": "妈妈 · mẹ; má",
      "text": "Từ đã học 妈妈 có 2 chữ. Chữ 妈 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 妈 với 马 / 吗 / 奶; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我妈妈喜欢茶。",
      "pinyin": "Wǒ mā ma xǐ huan chá.",
      "meaning": "Mẹ tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder4",
      "type": "teaching",
      "title": "孩子 · trẻ em; con",
      "text": "Từ đã học 孩子 có 2 chữ. Chữ 孩 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 孩 với 核 / 该 / 刻; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那个孩子叫文。",
      "pinyin": "Nà ge hái zi jiào Wén.",
      "meaning": "Đứa trẻ kia tên Văn.",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reminder5",
      "type": "teaching",
      "title": "爸爸 · bố; ba",
      "text": "Từ đã học 爸爸 có 2 chữ. Chữ 爸 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 爸 với 爷 / 父 / 色; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是我爸爸。",
      "pinyin": "Zhè shì wǒ bà ba.",
      "meaning": "Đây là bố tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1156-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：今天下雨吗？\nB：没有，今天天气很好。\nA：你想去哪儿？\nB：我想去学校。",
      "pinyin": "A: Jīn tiān xià yǔ ma? B: Méi yǒu, jīn tiān tiān qì hěn hǎo. A: Nǐ xiǎng qù nǎr? B: Wǒ xiǎng qù xué xiào.",
      "meaning": "Thời tiết trong truyện tốt, không mưa; không phải dự báo thật.",
      "readingMinutes": 2
    },
