  "blocks": [
    {
      "id": "l1103-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1103-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Hai vế có thể đặt cạnh nhau với dấu phẩy để cung cấp hai thông tin liên quan: 我喝茶，他喝水. Mỗi vế có người và hành động riêng. Không cần tự chèn “vì…nên…” nếu đoạn chỉ liệt kê hai lựa chọn; quan hệ nguyên nhân chưa được nêu. 茶/喝 đã học ở L002, không dạy lại như từ mới. Thực đơn dưới là văn bản gốc hư cấu, không mô tả tập quán của mọi người Trung Quốc.",
      "hanzi": "我喝茶，他喝水。",
      "pinyin": "Wǒ hē chá, tā hē shuǐ.",
      "meaning": "Tôi uống trà, anh ấy uống nước.",
      "readingMinutes": 3
    },
    {
      "id": "l1103-reminder0",
      "type": "teaching",
      "title": "水 · nước",
      "text": "Nhắc nghĩa đã học: nước. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我喝水。",
      "pinyin": "Wǒ hē shuǐ.",
      "meaning": "Tôi uống nước.",
      "readingMinutes": 1
    },
    {
      "id": "l1103-reminder1",
      "type": "teaching",
      "title": "元 · đồng/nguyên (đơn vị yuán trong ví dụ)",
      "text": "Nhắc nghĩa đã học: đồng/nguyên (đơn vị yuán trong ví dụ). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这本书十元。",
      "pinyin": "Zhè běn shū shí yuán.",
      "meaning": "Quyển sách này10nguyên trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l1103-reminder2",
      "type": "teaching",
      "title": "饺子 · sủi cảo; bánh chẻo",
      "text": "Nhắc nghĩa đã học: sủi cảo; bánh chẻo. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我喜欢饺子。",
      "pinyin": "Wǒ xǐ huan jiǎo zi.",
      "meaning": "Tôi thích sủi cảo.",
      "readingMinutes": 1
    },
    {
      "id": "l1103-reminder3",
      "type": "teaching",
      "title": "米饭 · cơm (gạo đã nấu)",
      "text": "Nhắc nghĩa đã học: cơm (gạo đã nấu). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我吃了米饭。",
      "pinyin": "Wǒ chī le mǐ fàn.",
      "meaning": "Tôi đã ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l1103-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "茶：三元\n饺子：六元\n米饭：两元\nA：我喝茶，你吃什么？\nB：我吃饺子。",
      "pinyin": "Chá: sān yuán. Jiǎo zi: liù yuán. Mǐ fàn: liǎng yuán. A: Wǒ hē chá, nǐ chī shén me? B: Wǒ chī jiǎo zi.",
      "meaning": "Thực đơn hư cấu: trà3nguyên, sủi cảo6nguyên, cơm2nguyên. A chọn trà; B chọn sủi cảo. Đọc tên món và con số, không suy giá thật hoặc mọi thói quen văn hóa.",
