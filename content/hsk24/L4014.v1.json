  "blocks": [
    {
      "id": "l4014-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t0",
      "type": "teaching",
      "title": "收入 · thu nhập; khoản thu",
      "text": "收入 chỉ khoản thu; trong sổ bán hàng này là tiền bán hàng trước chi phí, không đồng nghĩa lợi nhuận.",
      "hanzi": "本周的收入比上周高。",
      "pinyin": "Běn zhōu de shōu rù bǐ shàng zhōu gāo.",
      "meaning": "Khoản thu tuần này cao hơn tuần trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t1",
      "type": "teaching",
      "title": "生意 · việc kinh doanh; buôn bán",
      "text": "生意 nói công việc mua bán; 意 thường đọc nhẹ trong từ này.",
      "hanzi": "这家小店的生意不错。",
      "pinyin": "Zhè jiā xiǎo diàn de shēng yi bú cuò.",
      "meaning": "Cửa hàng nhỏ này buôn bán khá tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t2",
      "type": "teaching",
      "title": "市场 · thị trường; chợ",
      "text": "市场 ở đây là khu chợ cụ thể nơi mua bán; không phải dự báo thị trường tài chính.",
      "hanzi": "他在市场里开了一家小店。",
      "pinyin": "Tā zài shì chǎng lǐ kāi le yì jiā xiǎo diàn.",
      "meaning": "Anh ấy mở một cửa hàng nhỏ trong chợ.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t3",
      "type": "teaching",
      "title": "商品 · hàng hóa",
      "text": "商品 là đồ được đưa ra mua bán; không phải mọi đồ vật cá nhân đều là hàng hóa. Nhận diện chữ 品 trong 商品; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "店里增加了两种商品。",
      "pinyin": "Diàn lǐ zēng jiā le liǎng zhǒng shāng pǐn.",
      "meaning": "Cửa hàng thêm hai loại hàng hóa.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t4",
      "type": "teaching",
      "title": "数量 · số lượng",
      "text": "数量 biểu thị lượng đếm của vật, khác 数字 là ký hiệu/số cụ thể dùng để ghi.",
      "hanzi": "卖出的商品数量没有变化。",
      "pinyin": "Mài chū de shāng pǐn shù liàng méi yǒu biàn huà.",
      "meaning": "Số lượng hàng bán ra không thay đổi.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-t5",
      "type": "teaching",
      "title": "数字 · con số; chữ số",
      "text": "数字 là số/ký hiệu trong bảng; một con số cần đơn vị và bối cảnh để hiểu.",
      "hanzi": "请检查表格里的数字。",
      "pinyin": "Qǐng jiǎn chá biǎo gé lǐ de shù zì.",
      "meaning": "Hãy kiểm tra các con số trong bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l4014-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 nối mệnh đề tương phản nhẹ: doanh thu tăng, tuy nhiên số hàng bán không đổi. Không dùng sự đồng thời của hai số liệu để suy ra nguyên nhân. Sổ bán hàng ở đây hoàn toàn hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4014-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "在课堂故事里，小方在市场开店，记录自己的生意。他拿出两周的商品表格：“收入增加了，不过卖出的商品数量没有变。”同学问是不是利润增加了。老师说：“先看清数字的意思。收入没有扣除成本，不能直接当作利润；这些数字也不是真实市场数据。”",
      "pinyin": "Zài kè táng gù shi lǐ, Xiǎo Fāng zài shì chǎng kāi diàn, jì lù zì jǐ de shēng yi. Tā ná chū liǎng zhōu de shāng pǐn biǎo gé: “Shōu rù zēng jiā le, bú guò mài chū de shāng pǐn shù liàng méi yǒu biàn.” Tóng xué wèn shì bu shì lì rùn zēng jiā le. Lǎo shī shuō: “Xiān kàn qīng shù zì de yì si. Shōu rù méi yǒu kòu chú chéng běn, bù néng zhí jiē dàng zuò lì rùn; zhè xiē shù zì yě bú shì zhēn shí shì chǎng shù jù.”",
      "meaning": "Sổ bán hàng hư cấu phân biệt khoản thu với lợi nhuận và số lượng với con số; không phải dữ liệu hay lời khuyên tài chính.",
      "readingMinutes": 2
    },
    {
