  "blocks": [
    {
      "id": "l327-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 美术 měishù: mỹ thuật; 幅 fú: lượng từ bức tranh; 画法 huàfǎ: cách vẽ; 检查 jiǎnchá: kiểm tra. 张嘴 zhāng zuǐ: mở miệng; không dùng làm thước đo phát âm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l327-t0",
      "type": "teaching",
      "title": "耳朵 · tai",
      "text": "耳朵 chỉ bộ phận tai; 朵 đọc nhẹ. 用耳朵听 diễn tả chức năng trong câu, không đánh giá khả năng nghe của người học.",
      "hanzi": "画上的人有两只耳朵。",
      "pinyin": "Huà shàng de rén yǒu liǎng zhī ěrduo.",
      "meaning": "Người trong tranh có hai tai.",
      "readingMinutes": 1
    },
    {
      "id": "l327-t1",
      "type": "teaching",
      "title": "脸 · mặt",
      "text": "脸 chỉ khuôn mặt, khác 头 là cả đầu. 洗脸 là rửa mặt, không phải tắm toàn thân.",
      "hanzi": "他在画自己的脸。",
      "pinyin": "Tā zài huà zìjǐ de liǎn.",
      "meaning": "Cậu ấy đang vẽ khuôn mặt mình.",
      "readingMinutes": 1
    },
    {
      "id": "l327-t2",
      "type": "teaching",
      "title": "头发 · tóc",
      "text": "头发 là tóc trên đầu; 发 ở từ này đọc nhẹ fa, không phải fā của 发消息.",
      "hanzi": "她的头发很短。",
      "pinyin": "Tā de tóufa hěn duǎn.",
      "meaning": "Tóc cô ấy ngắn.",
      "readingMinutes": 1
    },
    {
      "id": "l327-t3",
      "type": "teaching",
      "title": "腿 · chân (phần từ hông đến bàn chân)",
      "text": "腿 là phần chân, khác 脚 thường chỉ bàn chân. 画腿不等于只画脚.",
      "hanzi": "画里的人腿很长。",
      "pinyin": "Huà lǐ de rén tuǐ hěn cháng.",
      "meaning": "Người trong tranh có chân dài.",
      "readingMinutes": 1
    },
    {
      "id": "l327-t4",
      "type": "teaching",
      "title": "脚 · bàn chân",
      "text": "脚 chỉ bàn chân trong đối chiếu với 腿; 一只脚 là một bàn chân, 一双脚 là hai bàn chân thành đôi.",
      "hanzi": "他的脚在水里。",
      "pinyin": "Tā de jiǎo zài shuǐ lǐ.",
      "meaning": "Bàn chân cậu ấy ở trong nước.",
      "readingMinutes": 1
    },
    {
      "id": "l327-t5",
      "type": "teaching",
      "title": "嘴 · miệng",
      "text": "嘴 là miệng; 张嘴 là mở miệng. Không lấy việc nhớ tên bộ phận làm bằng chứng nói/phát âm.",
      "hanzi": "请把嘴画小一点儿。",
      "pinyin": "Qǐng bǎ zuǐ huà xiǎo yìdiǎnr.",
      "meaning": "Hãy vẽ miệng nhỏ hơn một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l327-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "他画头发画得很认真 lặp động từ 画 để giữ tân ngữ 头发 và bổ ngữ sau 得. Đây là mô tả cách vẽ, không phải nhận xét đúng/sai về cơ thể.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l327-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "美术课上，小林先画脸、耳朵和嘴，再画头发、腿和脚。他画头发画得很认真。老师说：这幅画的腿很长，脚很小，这是你的画法，不是身体检查。",
      "pinyin": "Měishù kè shàng, Xiǎo Lín xiān huà liǎn, ěrduo hé zuǐ, zài huà tóufa, tuǐ hé jiǎo. Tā huà tóufa huà de hěn rènzhēn. Lǎoshī shuō: Zhè fú huà de tuǐ hěn cháng, jiǎo hěn xiǎo, zhè shì nǐ de huàfǎ, bú shì shēntǐ jiǎnchá.",
      "meaning": "Trong giờ mỹ thuật Lâm vẽ các bộ phận cơ thể. Cậu vẽ tóc rất cẩn thận. Thầy nói chân dài, bàn chân nhỏ là cách vẽ của cậu, không phải kết quả khám cơ thể.",
      "readingMinutes": 2
    },
    {
