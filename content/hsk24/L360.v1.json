  "blocks": [
    {
      "id": "l360-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 够 gòu: đủ; 记录 jìlù: ghi chép; 删掉 shāndiào: xóa bỏ; 原因 yuányīn: nguyên nhân. Bài chỉ nói tình huống công việc, không hướng dẫn thao tác xóa dữ liệu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l360-t0",
      "type": "teaching",
      "title": "行 · được/ổn/có thể thực hiện",
      "text": "行 xíng ở lời chấp thuận nghĩa được/ổn, khác háng của 银行. 行不行 hỏi khả thi/chấp thuận, không nói nghề nghiệp.",
      "hanzi": "明天再做也行。",
      "pinyin": "Míngtiān zài zuò yě xíng.",
      "meaning": "Ngày mai làm cũng được.",
      "readingMinutes": 1
    },
    {
      "id": "l360-t1",
      "type": "teaching",
      "title": "不行 · không được/không ổn",
      "text": "不行 có thể không được phép hoặc không khả thi theo cảnh; khác 不用 không cần. 明天不行说明明天不合适.",
      "hanzi": "今天去不行，我有课。",
      "pinyin": "Jīntiān qù bù xíng, wǒ yǒu kè.",
      "meaning": "Hôm nay đi không được, tôi có lớp.",
      "readingMinutes": 1
    },
    {
      "id": "l360-t2",
      "type": "teaching",
      "title": "清楚 · rõ/hiểu rõ",
      "text": "清楚 có thể mô tả rõ ràng hoặc hiểu rõ; 说清楚 là nói cho rõ, không tự là nói đúng sự thật.",
      "hanzi": "请把时间说清楚。",
      "pinyin": "Qǐng bǎ shíjiān shuō qīngchu.",
      "meaning": "Hãy nói rõ thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l360-t3",
      "type": "teaching",
      "title": "重要 · quan trọng",
      "text": "重要 nêu tầm quan trọng theo mục tiêu; 不 thể đồng nhất việc gấp với việc quan trọng trong mọi hoàn cảnh.",
      "hanzi": "这件事对我们很重要。",
      "pinyin": "Zhè jiàn shì duì wǒmen hěn zhòngyào.",
      "meaning": "Việc này quan trọng với chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l360-t4",
      "type": "teaching",
      "title": "主要 · chủ yếu/chính",
      "text": "主要 nêu phần hoặc lý do chính, chưa là duy nhất. 主要原因 là nguyên nhân chính, có thể còn nguyên nhân khác.",
      "hanzi": "主要问题是时间不够。",
      "pinyin": "Zhǔyào wèntí shì shíjiān bú gòu.",
      "meaning": "Vấn đề chính là không đủ thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l360-t5",
      "type": "teaching",
      "title": "有用 · hữu ích",
      "text": "有用 nói có ích với mục tiêu/người; 对我有用 chưa chứng minh có ích cho tất cả. Không phải mọi thứ dùng được đều quan trọng nhất.",
      "hanzi": "这本字典对我很有用。",
      "pinyin": "Zhè běn zìdiǎn duì wǒ hěn yǒuyòng.",
      "meaning": "Từ điển này hữu ích với tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l360-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不用 nêu không cần, khác 不行 là không được/không khả thi. 不用再说 nghĩa không cần nói lại; 不行 chưa đủ biết là cấm hay không thể nếu thiếu ngữ cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l360-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "同事问明天开会行不行。小林说今天不行，明天可以。主要问题是今天时间不够；先把时间说清楚很重要。旧记录也有用，不用因为它旧就全部删掉。",
      "pinyin": "Tóngshì wèn míngtiān kāi huì xíng bu xíng. Xiǎo Lín shuō jīntiān bù xíng, míngtiān kěyǐ. Zhǔyào wèntí shì jīntiān shíjiān bú gòu; xiān bǎ shíjiān shuō qīngchu hěn zhòngyào. Jiù jìlù yě yǒuyòng, bú yòng yīnwèi tā jiù jiù quánbù shāndiào.",
      "meaning": "Đồng nghiệp hỏi mai họp được không. Lâm nói hôm nay không, mai được; vấn đề chính là thiếu thời gian. Cần nói rõ thời gian, và ghi chép cũ vẫn hữu ích nên không cần xóa hết.",
      "readingMinutes": 2
    },
    {
