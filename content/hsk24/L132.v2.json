  "blocks": [
    {
      "id": "l132-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l132-t0",
      "type": "teaching",
      "title": "这边 · bên này; phía này",
      "text": "这边 không tự chỉ trái hay phải; theo vị trí mà người nói đang xác định.",
      "hanzi": "请来这边。",
      "pinyin": "Qǐng lái zhè biān.",
      "meaning": "Mời đến phía này.",
      "readingMinutes": 1
    },
    {
      "id": "l132-t1",
      "type": "teaching",
      "title": "来 · đến; tới (về điểm nhìn)",
      "text": "来 trong lời mời hướng người nghe về phía người nói đang chỉ.",
      "hanzi": "请来我的学校。",
      "pinyin": "Qǐng lái wǒ de xué xiào.",
      "meaning": "Mời đến trường của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l132-t2",
      "type": "teaching",
      "title": "去 · đi; tới (nơi khác)",
      "text": "去 trong câu đi đến trường; nơi học là đích, không phải đối tượng sở hữu.",
      "hanzi": "我去学校读书。",
      "pinyin": "Wǒ qù xué xiào dú shū.",
      "meaning": "Tôi đến trường để đọc sách/học.",
      "readingMinutes": 1
    },
    {
      "id": "l132-t3",
      "type": "teaching",
      "title": "到 · đến; tới đích",
      "text": "到 nhấn đến đích; 了 trong ví dụ báo đã đến ở tình huống này.",
      "hanzi": "我到学校了。",
      "pinyin": "Wǒ dào xué xiào le.",
      "meaning": "Tôi đến trường rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l132-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "来 hướng về điểm nhìn của người nói/người được đặt làm trung tâm; 去 hướng tới nơi khác theo điểm nhìn đó. 到 nhấn tới/đến đích. Trong 我去学校读书, đi đến trường là để đọc/học; không phải hai chủ ngữ khác nhau. 这边 nói phía này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l132-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你去哪儿？\nB：我去学校读书。\nA：我也去学校。\nB：好，我们去学校。",
      "pinyin": "A: Nǐ qù nǎr? B: Wǒ qù xué xiào dú shū. A: Wǒ yě qù xué xiào. B: Hǎo, wǒ men qù xué xiào.",
      "meaning": "Hai người nói đi đến trường; B nêu mục đích đọc sách/học. Đoạn chưa khẳng định đã tới nơi.",
      "readingMinutes": 2
    },
