  "blocks": [
    {
      "id": "l127-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l127-t0",
      "type": "teaching",
      "title": "这里 · ở đây; chỗ này (dạng có âm tiết lǐ)",
      "text": "这里 nêu nơi gần điểm đang được chỉ, không phải đại từ chỉ một đồ vật như 这个.",
      "hanzi": "这里是我们的学校。",
      "pinyin": "Zhè lǐ shì wǒ men de xué xiào.",
      "meaning": "Đây là trường của chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l127-t1",
      "type": "teaching",
      "title": "这儿 · ở đây; chỗ này (dạng hóa r)",
      "text": "这儿 là dạng hóa r chỉ nơi này; trong câu này có thể dùng 这里 nhưng đề hình thức phân biệt hai mục.",
      "hanzi": "我在这儿。",
      "pinyin": "Wǒ zài zhèr.",
      "meaning": "Tôi ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l127-t2",
      "type": "teaching",
      "title": "那里 · ở đó; chỗ kia (dạng có âm tiết lǐ)",
      "text": "那里 chỉ nơi kia trong tình huống, không tự mang nghĩa nhà của người nghe.",
      "hanzi": "那里是小学。",
      "pinyin": "Nà lǐ shì xiǎo xué.",
      "meaning": "Kia là trường tiểu học.",
      "readingMinutes": 1
    },
    {
      "id": "l127-t3",
      "type": "teaching",
      "title": "那儿 · ở đó; chỗ kia (dạng hóa r)",
      "text": "那儿 là dạng hóa r chỉ nơi kia; không tách chữ 儿 thành âm ér khi đọc từ này.",
      "hanzi": "他在那儿。",
      "pinyin": "Tā zài nàr.",
      "meaning": "Anh ấy ở kia.",
      "readingMinutes": 1
    },
    {
      "id": "l127-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "这里/这儿 chỉ chỗ này, 那里/那儿 chỉ chỗ kia theo ngữ cảnh; các dạng hóa r không cần thêm âm tiết ér riêng. Mẫu chỗ + 是 + danh từ xác định địa điểm: 这里是学校. Đây khác câu ai ở đâu như 我在这里. Khi đề yêu cầu một dạng cụ thể, giữ đúng dạng chữ/âm đã chỉ rõ. Dòng nguồn ghi nhãn 所处+是+名词; bài dùng nghĩa nơi chốn trong câu minh họa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l127-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这里是你的学校吗？\nB：不是，这里是小学。我的学校在那里。\nA：你姐姐在那儿吗？\nB：在，她是那里的老师。",
      "pinyin": "A: Zhè lǐ shì nǐ de xué xiào ma? B: Bú shì, zhè lǐ shì xiǎo xué. Wǒ de xué xiào zài nà lǐ. A: Nǐ jiě jie zài nàr ma? B: Zài, tā shì nà lǐ de lǎo shī.",
      "meaning": "B phân biệt địa điểm này với trường của mình ở kia. Chị gái B là giáo viên ở địa điểm kia; không gán cấp học cho trường ấy nếu chưa nêu.",
      "readingMinutes": 2
    },
