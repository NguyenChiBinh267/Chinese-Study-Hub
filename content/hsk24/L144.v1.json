  "blocks": [
    {
      "id": "l144-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l144-t0",
      "type": "teaching",
      "title": "雨 · mưa (danh từ)",
      "text": "雨 gọi mưa; 下雨 là cụm nói trời mưa, được học riêng trong cùng bài.",
      "hanzi": "这是雨，不是雪。",
      "pinyin": "Zhè shì yǔ, bú shì xuě.",
      "meaning": "Đây là mưa, không phải tuyết.",
      "readingMinutes": 1
    },
    {
      "id": "l144-t1",
      "type": "teaching",
      "title": "下雨 · trời mưa; có mưa",
      "text": "下雨 là mục hai chữ nói có mưa; không thay nó bằng danh từ 雨 khi đề hỏi cả cụm.",
      "hanzi": "下雨了。",
      "pinyin": "Xià yǔ le.",
      "meaning": "Mưa rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l144-t2",
      "type": "teaching",
      "title": "雪 · tuyết",
      "text": "雪 là tuyết; không suy màu sắc hoặc nhiệt độ cụ thể từ câu chỉ gọi tên.",
      "hanzi": "这是雪。",
      "pinyin": "Zhè shì xuě.",
      "meaning": "Đây là tuyết.",
      "readingMinutes": 1
    },
    {
      "id": "l144-t3",
      "type": "teaching",
      "title": "天 · ngày (đơn vị đếm)",
      "text": "天 trong 三天 là ba ngày, không tự có nghĩa ba buổi sáng.",
      "hanzi": "我休息三天。",
      "pinyin": "Wǒ xiū xi sān tiān.",
      "meaning": "Tôi nghỉ ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l144-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "雨/雪 là danh từ mưa/tuyết; 下雨 là có mưa. 了 cuối 下雨了 trong tình huống này báo chuyển sang có mưa; không phải cứ mọi câu có 了 là quá khứ. 天 đếm ngày trong 一天/三天; không đồng nhất 天 với cả mục 天气.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l144-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：下雨了吗？\nB：下雨了。\nA：这是雪吗？\nB：不是，是雨。",
      "pinyin": "A: Xià yǔ le ma? B: Xià yǔ le. A: Zhè shì xuě ma? B: Bú shì, shì yǔ.",
      "meaning": "B xác nhận có mưa và bác bỏ việc gọi nó là tuyết. Người học chỉ dựa vào lời thoại, không cần đoán từ một ảnh thời tiết.",
      "readingMinutes": 2
    },
