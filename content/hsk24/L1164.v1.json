  "blocks": [
    {
      "id": "l1164-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder0",
      "type": "teaching",
      "title": "可以 · có thể; được phép",
      "text": "Từ đã học 可以 có 2 chữ. Chữ 以 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 以 với 似 / 从 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我可以读这本书吗？",
      "pinyin": "Wǒ kě yǐ dú zhè běn shū ma?",
      "meaning": "Tôi có thể đọc quyển sách này không?",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder1",
      "type": "teaching",
      "title": "在 · ở; tại (vị trí trong bài)",
      "text": "Từ đã học 在 có 1 chữ. Chữ 在 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 在 với 再 / 土 / 左; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我在学校。",
      "pinyin": "Wǒ zài xué xiào.",
      "meaning": "Tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder2",
      "type": "teaching",
      "title": "边 · bên; cạnh",
      "text": "Từ đã học 边 có 1 chữ. Chữ 边 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 边 với 这 / 过 / 近; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "狗在外边。",
      "pinyin": "Gǒu zài wài bian.",
      "meaning": "Chó ở bên ngoài.",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder3",
      "type": "teaching",
      "title": "到 · đến; tới đích",
      "text": "Từ đã học 到 có 1 chữ. Chữ 到 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 到 với 别 / 倒 / 刻; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我到学校了。",
      "pinyin": "Wǒ dào xué xiào le.",
      "meaning": "Tôi đến trường rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder4",
      "type": "teaching",
      "title": "去 · đi; tới (nơi khác)",
      "text": "Từ đã học 去 có 1 chữ. Chữ 去 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 去 với 云 / 丢 / 法; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我去学校读书。",
      "pinyin": "Wǒ qù xué xiào dú shū.",
      "meaning": "Tôi đến trường để đọc sách/học.",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reminder5",
      "type": "teaching",
      "title": "怎么 · thế nào; bằng cách nào",
      "text": "Từ đã học 怎么 có 2 chữ. Chữ 怎 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 怎 với 作 / 昨 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你的名字怎么写？",
      "pinyin": "Nǐ de míng zi zěn me xiě?",
      "meaning": "Tên bạn viết thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l1164-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你今天想做什么？\nB：我想休息。\nA：你不看电影吗？\nB：对，我不看电影。",
      "pinyin": "A: Nǐ jīn tiān xiǎng zuò shén me? B: Wǒ xiǎng xiū xi. A: Nǐ bù kàn diàn yǐng ma? B: Duì, wǒ bù kàn diàn yǐng.",
      "meaning": "B muốn nghỉ, không xem phim. Đọc cả câu xác nhận để tránh suy từ câu hỏi phủ định.",
      "readingMinutes": 2
    },
