  "blocks": [
    {
      "id": "l4048-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t0",
      "type": "teaching",
      "title": "台 · lượng từ cho máy, thiết bị",
      "text": "台 dùng để đếm thiết bị như 一台机器. Nhận diện chữ 台 trong 台; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "桌上放着一台模型机器。",
      "pinyin": "Zhuō shàng fàng zhe yì tái mó xíng jī qì.",
      "meaning": "Trên bàn có một mô hình máy.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t1",
      "type": "teaching",
      "title": "转 · rẽ; chuyển hướng",
      "text": "转 đọc zhuǎn khi đổi hướng; không đọc zhuàn ở ngữ cảnh này.",
      "hanzi": "模型小车向左转。",
      "pinyin": "Mó xíng xiǎo chē xiàng zuǒ zhuǎn.",
      "meaning": "Xe mô hình rẽ trái.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t2",
      "type": "teaching",
      "title": "推 · đẩy",
      "text": "推 là dùng lực đưa ra xa, khác 拉 là kéo về.",
      "hanzi": "她把小车向前推。",
      "pinyin": "Tā bǎ xiǎo chē xiàng qián tuī.",
      "meaning": "Cô ấy đẩy xe nhỏ về trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t3",
      "type": "teaching",
      "title": "抬头 · ngẩng đầu",
      "text": "抬头 là nâng đầu lên nhìn, không chỉ nâng vật.",
      "hanzi": "请抬头看黑板。",
      "pinyin": "Qǐng tái tóu kàn hēi bǎn.",
      "meaning": "Hãy ngẩng đầu nhìn bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t4",
      "type": "teaching",
      "title": "停 · dừng",
      "text": "停 có thể chỉ tạm dừng; bài phân biệt dạng một chữ.",
      "hanzi": "小车在白线前停了。",
      "pinyin": "Xiǎo chē zài bái xiàn qián tíng le.",
      "meaning": "Xe nhỏ đã dừng trước vạch trắng.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-t5",
      "type": "teaching",
      "title": "停止 · dừng lại; chấm dứt",
      "text": "停止 là dạng hai chữ; không mặc định mọi lần dừng đều vĩnh viễn.",
      "hanzi": "演示结束后，机器停止工作。",
      "pinyin": "Yǎn shì jié shù hòu, jī qì tíng zhǐ gōng zuò.",
      "meaning": "Sau buổi minh họa máy ngừng hoạt động.",
      "readingMinutes": 1
    },
    {
      "id": "l4048-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "按顺序操作就是了 nêu cách làm được coi là đủ trong bài tập mô hình; không là hướng dẫn vận hành máy thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4048-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师用一台模型机器上课。小组抬头看黑板，再推小车向前走、向左转，让它停在白线前。演示结束后，机器停止工作。老师说：“按顺序操作就是了。”",
      "pinyin": "Lǎo shī yòng yì tái mó xíng jī qì shàng kè. Xiǎo zǔ tái tóu kàn hēi bǎn, zài tuī xiǎo chē xiàng qián zǒu, xiàng zuǒ zhuǎn, ràng tā tíng zài bái xiàn qián. Yǎn shì jié shù hòu, jī qì tíng zhǐ gōng zuò. Lǎo shī shuō: “Àn shùn xù cāo zuò jiù shì le.”",
      "meaning": "Nhóm làm bài tập với xe mô hình, làm theo thứ tự trên bảng.",
      "readingMinutes": 2
    },
    {
