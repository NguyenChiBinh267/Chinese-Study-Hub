  "blocks": [
    {
      "id": "l4064-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t0",
      "type": "teaching",
      "title": "否则 · nếu không thì",
      "text": "否则 nêu hậu quả khi điều trước không được làm.",
      "hanzi": "请提前申请，否则不能借用。",
      "pinyin": "Qǐng tí qián shēn qǐng, fǒu zé bù néng jiè yòng.",
      "meaning": "Xin đăng ký trước, nếu không sẽ không mượn được.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t1",
      "type": "teaching",
      "title": "千万 · nhất thiết; ngàn vạn lần",
      "text": "千万 trong 千万别 nhấn mạnh lời nhắc, không chỉ số lượng.",
      "hanzi": "千万别忘了关灯。",
      "pinyin": "Qiān wàn bié wàng le guān dēng.",
      "meaning": "Nhất thiết đừng quên tắt đèn.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t2",
      "type": "teaching",
      "title": "允许 · cho phép",
      "text": "允许 nói sự đồng ý theo quy định của nơi này. Nhận diện chữ 允 trong 允许; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个房间允许小组讨论。",
      "pinyin": "Zhè ge fáng jiān yǔn xǔ xiǎo zǔ tǎo lùn.",
      "meaning": "Phòng này cho phép thảo luận nhóm.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t3",
      "type": "teaching",
      "title": "只好 · đành phải",
      "text": "只好 biểu thị lựa chọn bị giới hạn trong tình huống.",
      "hanzi": "房间满了，我们只好改时间。",
      "pinyin": "Fáng jiān mǎn le, wǒ men zhǐ hǎo gǎi shí jiān.",
      "meaning": "Phòng kín chỗ nên chúng tôi đành đổi giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t4",
      "type": "teaching",
      "title": "往往 · thường; hay",
      "text": "往往 nói điều thường thấy qua nhiều lần, không bảo đảm lần nào cũng vậy.",
      "hanzi": "周末这个房间往往很忙。",
      "pinyin": "Zhōu mò zhè ge fáng jiān wǎng wǎng hěn máng.",
      "meaning": "Cuối tuần phòng này thường rất bận.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-t5",
      "type": "teaching",
      "title": "随着 · cùng với; theo đà",
      "text": "随着 nối sự thay đổi đi kèm quá trình khác.",
      "hanzi": "随着人数增加，房间不够用了。",
      "pinyin": "Suí zhe rén shù zēng jiā, fáng jiān bú gòu yòng le.",
      "meaning": "Số người tăng lên khiến phòng không còn đủ dùng.",
      "readingMinutes": 1
    },
    {
      "id": "l4064-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "要是 đặt điều kiện giả định. 往往 chỉ xu hướng thường xảy ra, không có nghĩa mọi lần đều vậy; 随着 biểu thị diễn biến đi kèm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4064-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里的学校允许小组借房间，但必须提前申请，否则不能借用。随着人数增加，周末往往很忙。要是房间满了，小组就只好改时间。离开前，老师提醒：“千万别忘了关灯。”",
      "pinyin": "Gù shi lǐ de xué xiào yǔn xǔ xiǎo zǔ jiè fáng jiān, dàn bì xū tí qián shēn qǐng, fǒu zé bù néng jiè yòng. Suí zhe rén shù zēng jiā, zhōu mò wǎng wǎng hěn máng. Yào shi fáng jiān mǎn le, xiǎo zǔ jiù zhǐ hǎo gǎi shí jiān. Lí kāi qián, lǎo shī tí xǐng: “Qiān wàn bié wàng le guān dēng.”",
      "meaning": "Quy định mượn phòng thuộc trường hư cấu trong bài. Nhóm đổi giờ nếu hết chỗ.",
      "readingMinutes": 2
    },
