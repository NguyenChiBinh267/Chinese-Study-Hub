  "blocks": [
    {
      "id": "l4013-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t0",
      "type": "teaching",
      "title": "首都 · thủ đô",
      "text": "首都 chỉ thành phố giữ vai trò thủ đô, không đồng nghĩa thành phố đông dân nhất.",
      "hanzi": "北京是中国的首都。",
      "pinyin": "Běi jīng shì Zhōng guó de shǒu dū.",
      "meaning": "Bắc Kinh là thủ đô Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t1",
      "type": "teaching",
      "title": "座 · lượng từ cho công trình, núi, thành phố",
      "text": "座 dùng trong 一座城市、一座桥; không dùng thay lượng từ cho người.",
      "hanzi": "地图上标出了一座古城。",
      "pinyin": "Dì tú shàng biāo chū le yí zuò gǔ chéng.",
      "meaning": "Trên bản đồ đã đánh dấu một thành cổ.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t2",
      "type": "teaching",
      "title": "市区 · khu vực nội thành",
      "text": "市区 là khu đô thị trong thành phố, không phải cả địa phận thành phố luôn rộng bằng nó.",
      "hanzi": "参观路线从市区开始。",
      "pinyin": "Cān guān lù xiàn cóng shì qū kāi shǐ.",
      "meaning": "Tuyến tham quan bắt đầu từ nội thành.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t3",
      "type": "teaching",
      "title": "西部 · miền tây; phần phía tây",
      "text": "西部 chỉ vùng phía tây của phạm vi đang nói; 西边 thường là phía tây tương đối gần.",
      "hanzi": "成都位于中国西部。",
      "pinyin": "Chéng dū wèi yú Zhōng guó xī bù.",
      "meaning": "Thành Đô nằm ở miền tây Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t4",
      "type": "teaching",
      "title": "亚洲 · châu Á",
      "text": "亚洲 là tên châu lục, không phải tên quốc gia; chữ đầu pinyin tên riêng viết hoa. Nhận diện chữ 亚 trong 亚洲; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "中国位于亚洲。",
      "pinyin": "Zhōng guó wèi yú Yà zhōu.",
      "meaning": "Trung Quốc nằm ở châu Á.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-t5",
      "type": "teaching",
      "title": "世纪 · thế kỷ",
      "text": "世纪 là khoảng một trăm năm theo cách chia lịch; khác 世纪末 là cuối thế kỷ.",
      "hanzi": "这本书介绍了上个世纪的城市生活。",
      "pinyin": "Zhè běn shū jiè shào le shàng ge shì jì de chéng shì shēng huó.",
      "meaning": "Sách này giới thiệu đời sống đô thị thế kỷ trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4013-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Số từ + tính từ + lượng từ, như 两大张地图, nhấn khổ lớn của hai tờ bản đồ. 大 đứng trước 张; không đọc thành 两张大 (hai tờ lớn) khi chưa có danh từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4013-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师把两大张地图放在桌上，先指出亚洲，再介绍中国的两座城市：北京是首都，成都位于西部。同学们比较两座城市的市区地图，又读了一段介绍上个世纪城市生活的文字。这节课练习描述位置，不比较人口或经济排名。",
      "pinyin": "Lǎo shī bǎ liǎng dà zhāng dì tú fàng zài zhuō shàng, xiān zhǐ chū Yà zhōu, zài jiè shào Zhōng guó de liǎng zuò chéng shì: Běi jīng shì shǒu dū, Chéng dū wèi yú xī bù. Tóng xué men bǐ jiào liǎng zuò chéng shì de shì qū dì tú, yòu dú le yí duàn jiè shào shàng ge shì jì chéng shì shēng huó de wén zì. Zhè jié kè liàn xí miáo shù wèi zhi, bù bǐ jiào rén kǒu huò jīng jì pái míng.",
      "meaning": "Lớp dùng hai bản đồ lớn để mô tả vị trí Bắc Kinh, Thành Đô và đọc về đời sống thế kỷ trước; không có xếp hạng hay số liệu hiện thời.",
      "readingMinutes": 2
    },
