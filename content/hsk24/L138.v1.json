  "blocks": [
    {
      "id": "l138-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l138-t0",
      "type": "teaching",
      "title": "对不起 · xin lỗi",
      "text": "对不起 dùng khi xin lỗi trong tình huống, không thay lời cảm ơn 谢谢.",
      "hanzi": "对不起，我有事。",
      "pinyin": "Duì bu qǐ, wǒ yǒu shì.",
      "meaning": "Xin lỗi, tôi có việc.",
      "readingMinutes": 1
    },
    {
      "id": "l138-t1",
      "type": "teaching",
      "title": "对 · đúng; phải (xác nhận)",
      "text": "对 trong lời đáp xác nhận thông tin; bài không dùng nghĩa giới từ đối với.",
      "hanzi": "对，我是老师。",
      "pinyin": "Duì, wǒ shì lǎo shī.",
      "meaning": "Đúng, tôi là giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l138-t2",
      "type": "teaching",
      "title": "问题 · câu hỏi; vấn đề",
      "text": "问题 ở ví dụ là một câu hỏi, chưa gán một khó khăn cụ thể.",
      "hanzi": "我有一个问题。",
      "pinyin": "Wǒ yǒu yí ge wèn tí.",
      "meaning": "Tôi có một câu hỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l138-t3",
      "type": "teaching",
      "title": "请问 · xin hỏi",
      "text": "请问 là cách mở câu hỏi lịch sự; vẫn phải nói phần thông tin cần hỏi sau nó.",
      "hanzi": "请问，医院在哪儿？",
      "pinyin": "Qǐng wèn, yī yuàn zài nǎr?",
      "meaning": "Xin hỏi, bệnh viện ở đâu?",
      "readingMinutes": 1
    },
    {
      "id": "l138-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "请问 mở đầu câu hỏi lịch sự; sau đó vẫn cần nội dung cần hỏi, như 医院在哪儿？对 là đúng trong câu xác nhận ở bài này, không dạy mọi nghĩa giới từ của 对. 对不起/没关系 tạo một cặp xin lỗi/đáp; 问题 là vấn đề/câu hỏi theo ngữ cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l138-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：请问，你是老师吗？\nB：对，我是老师。\nA：我有一个问题。\nB：好，请问。",
      "pinyin": "A: Qǐng wèn, nǐ shì lǎo shī ma? B: Duì, wǒ shì lǎo shī. A: Wǒ yǒu yí ge wèn tí. B: Hǎo, qǐng wèn.",
      "meaning": "B xác nhận là giáo viên rồi mời A hỏi. Đoạn chưa đưa nội dung câu hỏi của A, nên không tự đoán vấn đề.",
      "readingMinutes": 2
    },
