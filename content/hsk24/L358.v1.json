  "blocks": [
    {
      "id": "l358-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 完整 wánzhěng: hoàn chỉnh; 次数 cìshù: số lần; 相加 xiāngjiā: cộng vào nhau. Đối thoại chỉ được đọc dưới dạng văn bản ở đây.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l358-t0",
      "type": "teaching",
      "title": "讲 · nói/kể/giảng",
      "text": "讲 có thể kể chuyện hoặc giảng nội dung; 讲故事 nêu kể chuyện, không dùng 讲一个字 như mọi động tác viết chữ.",
      "hanzi": "老师讲了一个故事。",
      "pinyin": "Lǎoshī jiǎng le yí ge gùshi.",
      "meaning": "Thầy kể một câu chuyện.",
      "readingMinutes": 1
    },
    {
      "id": "l358-t1",
      "type": "teaching",
      "title": "回答 · trả lời",
      "text": "回答 thường nhận 问题; 回答老师的问题 là trả lời câu hỏi của thầy. 不 phải mọi nói chuyện đều là trả lời.",
      "hanzi": "请用中文回答问题。",
      "pinyin": "Qǐng yòng Zhōngwén huídá wèntí.",
      "meaning": "Hãy trả lời câu hỏi bằng tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l358-t2",
      "type": "teaching",
      "title": "句 · lượng từ câu",
      "text": "句 đếm câu/lời như 一句话, 三句中文. Không dùng như 页 đếm trang hay 遍 đếm lượt hoàn chỉnh.",
      "hanzi": "请读这三句话。",
      "pinyin": "Qǐng dú zhè sān jù huà.",
      "meaning": "Hãy đọc ba câu này.",
      "readingMinutes": 1
    },
    {
      "id": "l358-t3",
      "type": "teaching",
      "title": "段 · đoạn; lượng từ đoạn",
      "text": "段 đếm đoạn nội dung/khoảng theo cảnh; 一段课文 là một đoạn bài đọc, có thể nhiều câu.",
      "hanzi": "我们先读第一段。",
      "pinyin": "Wǒmen xiān dú dì yī duàn.",
      "meaning": "Chúng tôi đọc đoạn đầu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l358-t4",
      "type": "teaching",
      "title": "遍 · lượt (làm trọn một lần)",
      "text": "遍 đếm một lượt làm từ đầu đến cuối, 一遍课文 thường theo động từ đọc/nghe. Không tự nói số lần thạo hay hiểu.",
      "hanzi": "我把课文读了一遍。",
      "pinyin": "Wǒ bǎ kèwén dú le yí biàn.",
      "meaning": "Tôi đọc bài một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l358-t5",
      "type": "teaching",
      "title": "对话 · đối thoại/trò chuyện qua lại",
      "text": "对话 trong bài là trao đổi qua lại giữa người; 跟老师对话 không phải tự độc thoại. Chưa có chấm nói hay audio.",
      "hanzi": "学生跟老师对话。",
      "pinyin": "Xuésheng gēn lǎoshī duìhuà.",
      "meaning": "Học sinh đối thoại với thầy.",
      "readingMinutes": 1
    },
    {
      "id": "l358-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "遍 đếm việc làm trọn từ đầu tới cuối: 读一遍课文. 次 đếm lần nói chung. 一句/一段 đếm đơn vị nội dung; không biến ba câu thành ba lượt đọc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l358-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师先讲故事，再请学生跟他对话。小林读了第一段，一共三句话。他只读了一遍，然后回答两个问题。这里的句、段和遍分别数句子、内容段和完整次数，不能相加成同一个数字。",
      "pinyin": "Lǎoshī xiān jiǎng gùshi, zài qǐng xuésheng gēn tā duìhuà. Xiǎo Lín dú le dì yī duàn, yígòng sān jù huà. Tā zhǐ dú le yí biàn, ránhòu huídá liǎng ge wèntí. Zhèlǐ de jù, duàn hé biàn fēnbié shǔ jùzi, nèiróng duàn hé wánzhěng cìshù, bù néng xiāngjiā chéng tóng yí ge shùzì.",
      "meaning": "Thầy kể chuyện rồi đối thoại với học sinh. Lâm đọc đoạn đầu gồm ba câu một lượt, sau đó trả lời hai câu hỏi. Câu, đoạn và lượt là các đơn vị khác nhau.",
      "readingMinutes": 2
    },
    {
