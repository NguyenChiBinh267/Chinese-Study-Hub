  "blocks": [
    {
      "id": "l4074-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t0",
      "type": "teaching",
      "title": "组 · nhóm; tổ",
      "text": "组 là đơn vị nhóm người trong bài.",
      "hanzi": "我们分成三个组。",
      "pinyin": "Wǒ men fēn chéng sān ge zǔ.",
      "meaning": "Chúng tôi chia thành ba nhóm.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t1",
      "type": "teaching",
      "title": "经济 · kinh tế",
      "text": "经济 ở 地方经济 nói hoạt động sản xuất, trao đổi, không khẳng định một mô hình chính sách.",
      "hanzi": "课堂上讨论地方经济。",
      "pinyin": "Kè táng shàng tǎo lùn dì fāng jīng jì.",
      "meaning": "Lớp học thảo luận kinh tế địa phương.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t2",
      "type": "teaching",
      "title": "竞争 · cạnh tranh",
      "text": "竞争 nói nhiều bên tranh cơ hội theo điều kiện, không tất yếu dẫn tới kết quả tốt. Nhận diện chữ 竞 trong 竞争; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "两家小店之间有竞争。",
      "pinyin": "Liǎng jiā xiǎo diàn zhī jiān yǒu jìng zhēng.",
      "meaning": "Hai cửa hàng nhỏ có cạnh tranh.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t3",
      "type": "teaching",
      "title": "作用 · tác dụng; vai trò",
      "text": "作用 chỉ ảnh hưởng hoặc công dụng; cần nêu cụ thể trong ngữ cảnh.",
      "hanzi": "这张表的作用是记录价格。",
      "pinyin": "Zhè zhāng biǎo de zuò yòng shì jì lù jià gé.",
      "meaning": "Tác dụng của bảng là ghi giá.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t4",
      "type": "teaching",
      "title": "起到 · phát huy; có tác dụng",
      "text": "起到 thường đi với 作用; phải nêu tác dụng nào, không chỉ nói chung thành công.",
      "hanzi": "记录起到了比较信息的作用。",
      "pinyin": "Jì lù qǐ dào le bǐ jiào xìn xī de zuò yòng.",
      "meaning": "Bản ghi có tác dụng đối chiếu thông tin.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-t5",
      "type": "teaching",
      "title": "为 · làm; trở thành vai trò",
      "text": "为1 đọc wéi trong 选…为… là động từ trong mục nguồn.",
      "hanzi": "大家选小安为组长。",
      "pinyin": "Dà jiā xuǎn Xiǎo Ān wéi zǔ zhǎng.",
      "meaning": "Mọi người chọn Tiểu An làm trưởng nhóm.",
      "readingMinutes": 1
    },
    {
      "id": "l4074-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung hai tác dụng. 为1 đọc wéi trong 选他为组长 có nghĩa làm/đảm nhiệm vai trò, khác wèi giới từ chỉ mục đích.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4074-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "课堂讨论地方经济，学生分成三个组，选小安为组长。他们记录两家小店的价格，了解竞争情况。这张表不仅起到了记录价格的作用，还帮助大家发现信息缺口。老师提醒：一次记录不能说明竞争一定使价格下降。",
      "pinyin": "Kè táng tǎo lùn dì fāng jīng jì, xué sheng fēn chéng sān ge zǔ, xuǎn Xiǎo Ān wéi zǔ zhǎng. Tā men jì lù liǎng jiā xiǎo diàn de jià gé, liǎo jiě jìng zhēng qíng kuàng. Zhè zhāng biǎo bù jǐn qǐ dào le jì lù jià gé de zuò yòng, hái bāng zhù dà jiā fā xiàn xìn xī quē kǒu. Lǎo shī tí xǐng: yí cì jì lù bù néng shuō míng jìng zhēng yí dìng shǐ jià gé xià jiàng.",
      "meaning": "Nhóm ghi giá để so sánh; một lần ghi chưa chứng minh cạnh tranh gây giảm giá. Đây là bài học hư cấu.",
      "readingMinutes": 2
    },
    {
