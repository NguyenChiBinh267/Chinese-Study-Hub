  "blocks": [
    {
      "id": "l4015-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t0",
      "type": "teaching",
      "title": "作者 · tác giả",
      "text": "作者 là người tạo văn bản/tác phẩm đang nói, không nhất thiết làm nghề viết.",
      "hanzi": "这篇文章的作者是一位老师。",
      "pinyin": "Zhè piān wén zhāng de zuò zhě shì yí wèi lǎo shī.",
      "meaning": "Tác giả bài viết này là một giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t1",
      "type": "teaching",
      "title": "作品 · tác phẩm",
      "text": "作品 là sản phẩm sáng tác có nội dung/hình thức, không phải tác giả tạo ra nó.",
      "hanzi": "读书会上介绍了三部作品。",
      "pinyin": "Dú shū huì shàng jiè shào le sān bù zuò pǐn.",
      "meaning": "Buổi đọc sách giới thiệu ba tác phẩm.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t2",
      "type": "teaching",
      "title": "作家 · nhà văn",
      "text": "作家 là người sáng tác văn học; hẹp hơn 作者 dùng cho bất kỳ văn bản phù hợp nào.",
      "hanzi": "这位作家常写乡村生活。",
      "pinyin": "Zhè wèi zuò jiā cháng xiě xiāng cūn shēng huó.",
      "meaning": "Nhà văn này thường viết về đời sống làng quê.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t3",
      "type": "teaching",
      "title": "小说 · tiểu thuyết; truyện hư cấu",
      "text": "小说 là thể loại văn xuôi hư cấu, không có nghĩa câu nói nhỏ tiếng.",
      "hanzi": "我正在读一本小说。",
      "pinyin": "Wǒ zhèng zài dú yì běn xiǎo shuō.",
      "meaning": "Tôi đang đọc một tiểu thuyết.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t4",
      "type": "teaching",
      "title": "文章 · bài viết",
      "text": "文章 chỉ một bài văn/bài viết hoàn chỉnh; dùng lượng từ 篇. Nhận diện chữ 章 trong 文章; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他写了一篇介绍作者的文章。",
      "pinyin": "Tā xiě le yì piān jiè shào zuò zhě de wén zhāng.",
      "meaning": "Anh ấy viết một bài giới thiệu tác giả.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-t5",
      "type": "teaching",
      "title": "文字 · chữ viết; văn tự",
      "text": "文字 là hệ chữ hoặc lời văn ở dạng viết, không chỉ riêng một bài hoàn chỉnh.",
      "hanzi": "这段文字很容易读懂。",
      "pinyin": "Zhè duàn wén zì hěn róng yì dú dǒng.",
      "meaning": "Đoạn chữ này rất dễ đọc hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l4015-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有声有色 là thành ngữ tả lời kể/miêu tả sinh động, có hình ảnh, thuộc mẫu cố định 有A有B. Trong bài chỉ đọc và sắp câu, không có thu âm hoặc chấm nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4015-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "读书会上，小宁介绍一位虚构的作家和他的作品。她先读小说中的一段文字，再用自己的话介绍作者，没有复制整部作品。最后她读了一篇自己写的文章，把人物的故事讲得有声有色。这里的作家和作品都是为练习设计的。",
      "pinyin": "Dú shū huì shàng, Xiǎo Níng jiè shào yí wèi xū gòu de zuò jiā hé tā de zuò pǐn. Tā xiān dú xiǎo shuō zhōng de yí duàn wén zì, zài yòng zì jǐ de huà jiè shào zuò zhě, méi yǒu fù zhì zhěng bù zuò pǐn. Zuì hòu tā dú le yì piān zì jǐ xiě de wén zhāng, bǎ rén wù de gù shi jiǎng de yǒu shēng yǒu sè. Zhè lǐ de zuò jiā hé zuò pǐn dōu shì wèi liàn xí shè jì de.",
      "meaning": "Tiểu Ninh giới thiệu nhà văn và tác phẩm hư cấu, tự viết bài kể chuyện sinh động. Không trích tác phẩm có thật.",
      "readingMinutes": 2
    },
    {
