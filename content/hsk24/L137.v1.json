  "blocks": [
    {
      "id": "l137-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l137-t0",
      "type": "teaching",
      "title": "忙 · bận",
      "text": "忙 mô tả trạng thái bận; không tự đánh giá người bận là tốt hơn người khác.",
      "hanzi": "我很忙。",
      "pinyin": "Wǒ hěn máng.",
      "meaning": "Tôi bận.",
      "readingMinutes": 1
    },
    {
      "id": "l137-t1",
      "type": "teaching",
      "title": "事 · việc; chuyện",
      "text": "事 trong 我有事 là có việc cần làm; chưa nêu việc cụ thể.",
      "hanzi": "我有事。",
      "pinyin": "Wǒ yǒu shì.",
      "meaning": "Tôi có việc.",
      "readingMinutes": 1
    },
    {
      "id": "l137-t2",
      "type": "teaching",
      "title": "没事 · không có việc; không sao",
      "text": "没事 trong câu đi với 不忙 là không có việc/bận trong tình huống đó.",
      "hanzi": "我没事，不忙。",
      "pinyin": "Wǒ méi shì, bù máng.",
      "meaning": "Tôi không có việc, không bận.",
      "readingMinutes": 1
    },
    {
      "id": "l137-t3",
      "type": "teaching",
      "title": "没关系 · không sao (đáp lời xin lỗi)",
      "text": "没关系 ở lời đáp lịch sự không phải lời chẩn đoán rằng mọi chuyện đều an toàn.",
      "hanzi": "没关系。",
      "pinyin": "Méi guān xi.",
      "meaning": "Không sao.",
      "readingMinutes": 1
    },
    {
      "id": "l137-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "忙 là tính từ trong 我很忙, không thêm 是 trước 很忙. 有事 có việc; 没事 có thể là không có việc hoặc không sao theo tình huống. 没关系 là lời đáp không sao khi được xin lỗi, không phải khẳng định không có bất kỳ mối quan hệ nào trong mọi câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l137-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你忙吗？\nB：忙，我有事。\nA：对不起。\nB：没关系。",
      "pinyin": "A: Nǐ máng ma? B: Máng, wǒ yǒu shì. A: Duì bu qǐ. B: Méi guān xi.",
      "meaning": "对不起 duì bu qǐ = xin lỗi, học riêng ở bài sau. B có việc và bận; cuối đoạn đáp lại lời xin lỗi một cách lịch sự.",
      "readingMinutes": 2
    },
