  "blocks": [
    {
      "id": "l492-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 加油 jiāyóu: cổ vũ/cố lên; 心情 xīnqíng: tâm trạng; 改进 gǎijìn: cải thiện; không phải kết quả thể thao có thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l492-t0",
      "type": "teaching",
      "title": "乒乓球 · bóng bàn",
      "text": "乒乓球 đọc pīng pāng qiú; phân biệt hai chữ 乒 với nét chân trái và 乓 nét chân phải trong kiểu chữ in. Nhận diện chữ 乒 trong 乒乓球; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他们下午练乒乓球。",
      "pinyin": "Tāmen xiàwǔ liàn pīngpāngqiú.",
      "meaning": "Chiều họ tập bóng bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l492-t1",
      "type": "teaching",
      "title": "球队 · đội bóng",
      "text": "球队 là đội thể thao dùng bóng, khác 球迷 là người hâm mộ.",
      "hanzi": "球队已经准备好了。",
      "pinyin": "Qiúduì yǐjīng zhǔnbèi hǎo le.",
      "meaning": "Đội bóng đã chuẩn bị xong.",
      "readingMinutes": 1
    },
    {
      "id": "l492-t2",
      "type": "teaching",
      "title": "球迷 · người hâm mộ bóng",
      "text": "球迷 chỉ người thích/theo dõi thể thao bóng, không mặc định là cầu thủ.",
      "hanzi": "球迷在场外等候。",
      "pinyin": "Qiúmí zài chǎng wài děnghòu.",
      "meaning": "Người hâm mộ đợi ngoài sân.",
      "readingMinutes": 1
    },
    {
      "id": "l492-t3",
      "type": "teaching",
      "title": "庆祝 · chúc mừng, kỷ niệm",
      "text": "庆祝 là tổ chức/biểu đạt niềm vui về sự kiện; ở đây chúc mừng đội hoàn thành giải.",
      "hanzi": "大家庆祝比赛顺利结束。",
      "pinyin": "Dàjiā qìngzhù bǐsài shùnlì jiéshù.",
      "meaning": "Mọi người mừng giải kết thúc thuận lợi.",
      "readingMinutes": 1
    },
    {
      "id": "l492-t4",
      "type": "teaching",
      "title": "平常 · bình thường, thường ngày",
      "text": "平常 nói thời gian/tình trạng thường ngày, khác 平均 là trung bình số học.",
      "hanzi": "他平常练习很认真。",
      "pinyin": "Tā píngcháng liànxí hěn rènzhēn.",
      "meaning": "Ngày thường anh tập rất nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l492-t5",
      "type": "teaching",
      "title": "轻松 · thoải mái, nhẹ nhàng",
      "text": "轻松 nói ít căng thẳng/gánh nặng, không đồng nghĩa chắc thắng.",
      "hanzi": "今天大家的心情比较轻松。",
      "pinyin": "Jīntiān dàjiā de xīnqíng bǐjiào qīngsōng.",
      "meaning": "Hôm nay tâm trạng mọi người khá thoải mái.",
      "readingMinutes": 1
    },
    {
      "id": "l492-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "无论 + điều kiện/các trường hợp + 都/也 + kết quả không đổi: 无论比赛结果怎样，球队都先感谢对手. Không suy rằng mọi kết quả có giá trị như nhau; lời cảm ơn vẫn giữ dù thắng thua.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l492-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校球队平常认真练乒乓球。比赛前，教练让大家保持轻松的心情。球迷在场外等候，准备为队员加油。无论比赛结果怎样，球队都先感谢对手。结束后，大家庆祝比赛顺利完成，也讨论下次怎样改进。",
      "pinyin": "Xuéxiào qiúduì píngcháng rènzhēn liàn pīngpāngqiú. Bǐsài qián, jiàoliàn ràng dàjiā bǎochí qīngsōng de xīnqíng. Qiúmí zài chǎng wài děnghòu, zhǔnbèi wèi duìyuán jiāyóu. Wúlùn bǐsài jiéguǒ zěnyàng, qiúduì dōu xiān gǎnxiè duìshǒu. Jiéshù hòu, dàjiā qìngzhù bǐsài shùnlì wánchéng, yě tǎolùn xià cì zěnyàng gǎijìn.",
      "meaning": "Đội trường tập bóng bàn đều. Trước thi họ giữ tâm trạng thoải mái, cổ động viên chờ cổ vũ. Dù kết quả nào đội cũng cảm ơn đối thủ, rồi mừng hoàn tất và bàn cải thiện.",
      "readingMinutes": 2
    },
