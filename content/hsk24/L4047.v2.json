  "blocks": [
    {
      "id": "l4047-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t0",
      "type": "teaching",
      "title": "装 · đựng vào; đóng gói",
      "text": "装 trong câu là bỏ đồ vào vật chứa. Nhận diện chữ 装 trong 装; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请把鞋装进箱子。",
      "pinyin": "Qǐng bǎ xié zhuāng jìn xiāng zi.",
      "meaning": "Hãy bỏ giày vào thùng.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t1",
      "type": "teaching",
      "title": "皮鞋 · giày da",
      "text": "皮鞋 là giày làm bằng da, không phải mọi giày đen.",
      "hanzi": "这双皮鞋需要擦一下。",
      "pinyin": "Zhè shuāng pí xié xū yào cā yí xià.",
      "meaning": "Đôi giày da này cần lau một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t2",
      "type": "teaching",
      "title": "破 · rách; vỡ; hỏng",
      "text": "破 nói vật không còn nguyên vẹn trong câu.",
      "hanzi": "这个纸盒破了。",
      "pinyin": "Zhè ge zhǐ hé pò le.",
      "meaning": "Hộp giấy này bị rách rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t3",
      "type": "teaching",
      "title": "敲 · gõ",
      "text": "敲 là tác động gõ vào bề mặt, khác 推 là đẩy.",
      "hanzi": "他轻轻敲了两下门。",
      "pinyin": "Tā qīng qīng qiāo le liǎng xià mén.",
      "meaning": "Anh ấy gõ cửa nhẹ hai lần.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t4",
      "type": "teaching",
      "title": "弄 · làm; xử lý",
      "text": "弄 có nghĩa rộng; 弄坏 là làm hỏng, không chỉ gõ.",
      "hanzi": "别把纸盒弄坏了。",
      "pinyin": "Bié bǎ zhǐ hé nòng huài le.",
      "meaning": "Đừng làm hỏng hộp giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-t5",
      "type": "teaching",
      "title": "列 · liệt kê; kê ra",
      "text": "列 trong 列清单 là ghi các mục thành danh sách.",
      "hanzi": "我先列了一张清单。",
      "pinyin": "Wǒ xiān liè le yì zhāng qīng dān.",
      "meaning": "Tôi kê một danh sách trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4047-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "够重的 nhấn mạnh khá nặng trong lời nhận xét khẩu ngữ; không phải phép đo khối lượng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4047-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安先列清单，再把皮鞋装进箱子。他发现纸盒破了，敲门请朋友拿胶带。朋友说：“别再弄坏了，这箱子够重的。”两人换了一个结实的盒子。",
      "pinyin": "Xiǎo Ān xiān liè qīng dān, zài bǎ pí xié zhuāng jìn xiāng zi. Tā fā xiàn zhǐ hé pò le, qiāo mén qǐng péng you ná jiāo dài. Péng you shuō: “Bié zài nòng huài le, zhè xiāng zi gòu zhòng de.” Liǎng rén huàn le yí ge jiē shi de hé zi.",
      "meaning": "Tiểu An kê đồ, đóng giày rồi đổi hộp rách sang hộp chắc hơn.",
      "readingMinutes": 2
    },
    {
