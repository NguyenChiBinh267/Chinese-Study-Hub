  "blocks": [
    {
      "id": "l1157-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder0",
      "type": "teaching",
      "title": "孩子 · trẻ em; con",
      "text": "Từ đã học 孩子 có 2 chữ. Chữ 子 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 子 với 了 / 孑 / 予; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那个孩子叫文。",
      "pinyin": "Nà ge hái zi jiào Wén.",
      "meaning": "Đứa trẻ kia tên Văn.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder1",
      "type": "teaching",
      "title": "儿子 · con trai",
      "text": "Từ đã học 儿子 có 2 chữ. Chữ 儿 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 儿 với 几 / 九 / 允; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他是我儿子。",
      "pinyin": "Tā shì wǒ ér zi.",
      "meaning": "Cậu ấy là con trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder2",
      "type": "teaching",
      "title": "哥哥 · anh trai",
      "text": "Từ đã học 哥哥 có 2 chữ. Chữ 哥 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 哥 với 可 / 何 / 奇; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我哥哥叫安。",
      "pinyin": "Wǒ gē ge jiào Ān.",
      "meaning": "Anh trai tôi tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder3",
      "type": "teaching",
      "title": "妹妹 · em gái",
      "text": "Từ đã học 妹妹 có 2 chữ. Chữ 妹 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 妹 với 未 / 味 / 抹; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我妹妹喜欢茶。",
      "pinyin": "Wǒ mèi mei xǐ huan chá.",
      "meaning": "Em gái tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder4",
      "type": "teaching",
      "title": "弟弟 · em trai",
      "text": "Từ đã học 弟弟 có 2 chữ. Chữ 弟 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 弟 với 第 / 梯 / 递; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他是我弟弟。",
      "pinyin": "Tā shì wǒ dì di.",
      "meaning": "Cậu ấy là em trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reminder5",
      "type": "teaching",
      "title": "三 · ba",
      "text": "Từ đã học 三 có 1 chữ. Chữ 三 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 三 với 王 / 玉 / 主; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "一、二、三。",
      "pinyin": "Yī, èr, sān.",
      "meaning": "Một, hai, ba.",
      "readingMinutes": 1
    },
    {
      "id": "l1157-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你怎么去学校？\nB：我坐出租车。\nA：你爸爸呢？\nB：他开车。",
      "pinyin": "A: Nǐ zěn me qù xué xiào? B: Wǒ zuò chū zū chē. A: Nǐ bà ba ne? B: Tā kāi chē.",
      "meaning": "B đi taxi, bố của B lái xe; không suy B là tài xế.",
      "readingMinutes": 2
    },
