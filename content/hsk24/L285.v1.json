  "blocks": [
    {
      "id": "l285-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder0",
      "type": "teaching",
      "title": "忘 · quên",
      "text": "忘 đối lập với 记得. 别忘了 là lời nhắc đừng quên, không khẳng định người kia đã quên.",
      "hanzi": "别忘了拿书。",
      "pinyin": "Bié wàng le ná shū.",
      "meaning": "Đừng quên lấy sách.",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder1",
      "type": "teaching",
      "title": "告诉 · nói cho biết",
      "text": "告诉 thường nêu người nhận thông tin: 告诉我. 诉 đọc nhẹ trong từ này.",
      "hanzi": "请告诉我你的名字。",
      "pinyin": "Qǐng gàosu wǒ nǐ de míngzi.",
      "meaning": "Làm ơn cho tôi biết tên bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder2",
      "type": "teaching",
      "title": "介绍 · giới thiệu",
      "text": "介绍 là làm người nghe biết một người/sự việc. 给你介绍一位老师 là giới thiệu một giáo viên với bạn.",
      "hanzi": "我给你介绍一位老师。",
      "pinyin": "Wǒ gěi nǐ jièshào yí wèi lǎoshī.",
      "meaning": "Tôi giới thiệu một giáo viên với bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder3",
      "type": "teaching",
      "title": "不好意思 · xin lỗi nhẹ hoặc thấy ngại",
      "text": "不好意思 dùng khi làm phiền hoặc cảm thấy ngại, không chỉ là ‘ý nghĩa không tốt’. Tình huống nghiêm trọng cần cách xin lỗi phù hợp hơn.",
      "hanzi": "不好意思，我没听懂。",
      "pinyin": "Bù hǎoyìsi, wǒ méi tīng dǒng.",
      "meaning": "Xin lỗi, tôi nghe chưa hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder4",
      "type": "teaching",
      "title": "让 · cho phép hoặc yêu cầu ai làm",
      "text": "Trong 请让他进来, 让 là động từ cho phép người kia vào. Không dạy nghĩa giới từ cấp cao hơn.",
      "hanzi": "请让他进来。",
      "pinyin": "Qǐng ràng tā jìnlái.",
      "meaning": "Làm ơn cho anh ấy vào.",
      "readingMinutes": 1
    },
    {
      "id": "l285-reminder5",
      "type": "teaching",
      "title": "但是 · nhưng",
      "text": "但是 nối ý tương phản; không dùng thay 所以 nếu cần nêu kết quả nguyên nhân.",
      "hanzi": "我想去，但是今天没有时间。",
      "pinyin": "Wǒ xiǎng qù, dànshì jīntiān méiyǒu shíjiān.",
      "meaning": "Tôi muốn đi nhưng hôm nay không có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l285-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：考试快要开始了，你记得拿书吗？乙：记得，我已经拿来了。甲：这本书你看完了吗？乙：还没有，今天我想看完。",
      "pinyin": "Jiǎ: Kǎoshì kuàiyào kāishǐ le, nǐ jìde ná shū ma? Yǐ: Jìde, wǒ yǐjīng ná lái le. Jiǎ: Zhè běn shū nǐ kàn wán le ma? Yǐ: Hái méiyǒu, jīntiān wǒ xiǎng kàn wán.",
      "meaning": "A: Bài kiểm tra sắp bắt đầu, bạn nhớ lấy sách không? B: Nhớ, tôi lấy đến rồi. A: Bạn đọc xong quyển sách này chưa? B: Chưa, hôm nay tôi muốn đọc xong.",
      "readingMinutes": 2
    },
    {
      "id": "l285-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：不好意思，你能来帮忙吗？乙：可以。甲：请帮我拿书。我给你介绍一位老师。乙：好，请告诉我老师的名字。",
      "pinyin": "Jiǎ: Bù hǎoyìsi, nǐ néng lái bāngmáng ma? Yǐ: Kěyǐ. Jiǎ: Qǐng bāng wǒ ná shū. Wǒ gěi nǐ jièshào yí wèi lǎoshī. Yǐ: Hǎo, qǐng gàosu wǒ lǎoshī de míngzi.",
      "meaning": "A: Xin lỗi làm phiền, bạn đến giúp được không? B: Được. A: Giúp tôi lấy sách nhé. Tôi giới thiệu một giáo viên với bạn. B: Được, hãy cho tôi biết tên thầy/cô.",
      "readingMinutes": 2
    },
    {
      "id": "l285-context2",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你为什么想去那家书店？乙：虽然很远，但是那里的书很有意思。甲：我今天有很多事情要做，不能和你一起去。乙：好，下次一起去。",
      "pinyin": "Jiǎ: Nǐ wèi shénme xiǎng qù nà jiā shūdiàn? Yǐ: Suīrán hěn yuǎn, dànshì nàlǐ de shū hěn yǒu yìsi. Jiǎ: Wǒ jīntiān yǒu hěn duō shìqing yào zuò, bù néng hé nǐ yìqǐ qù. Yǐ: Hǎo, xià cì yìqǐ qù.",
      "meaning": "A: Vì sao bạn muốn đến hiệu sách đó? B: Tuy xa nhưng sách ở đó thú vị. A: Hôm nay tôi có nhiều việc nên không thể cùng đi. B: Được, lần sau cùng đi.",
      "readingMinutes": 2
    },
