  "blocks": [
    {
      "id": "l344-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 填表 tián biǎo: điền mẫu; 工作人员 gōngzuò rényuán: nhân viên; 真实 zhēnshí: thật; 卡号 kǎhào: số thẻ. Đây là đọc ngôn ngữ, không thực hiện giao dịch hay hướng dẫn tài chính.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l344-t0",
      "type": "teaching",
      "title": "银行 · ngân hàng",
      "text": "银行 là cơ sở/ngân hàng, 行 đọc háng trong từ này, khác xíng là được/đi. Bài chỉ dùng tình huống hỏi thông tin.",
      "hanzi": "银行在学校旁边。",
      "pinyin": "Yínháng zài xuéxiào pángbiān.",
      "meaning": "Ngân hàng ở cạnh trường.",
      "readingMinutes": 1
    },
    {
      "id": "l344-t1",
      "type": "teaching",
      "title": "银行卡 · thẻ ngân hàng",
      "text": "银行卡 là tên chung thẻ ngân hàng; không tự chỉ riêng 信用卡. Không cần nhập số thẻ thật để luyện.",
      "hanzi": "他把银行卡放在包里。",
      "pinyin": "Tā bǎ yínhángkǎ fàng zài bāo lǐ.",
      "meaning": "Anh ấy đặt thẻ ngân hàng trong túi.",
      "readingMinutes": 1
    },
    {
      "id": "l344-t2",
      "type": "teaching",
      "title": "号码 · số/mã số",
      "text": "号码 là chuỗi số định danh/liên lạc như 电话号码; không đồng nghĩa mọi lượng đếm. 不 biết số từ câu hỏi chưa phải số thật.",
      "hanzi": "请再说一遍电话号码。",
      "pinyin": "Qǐng zài shuō yí biàn diànhuà hàomǎ.",
      "meaning": "Hãy nói lại số điện thoại một lần.",
      "readingMinutes": 1
    },
    {
      "id": "l344-t3",
      "type": "teaching",
      "title": "还 · trả lại",
      "text": "还 huán là trả đồ/trả lại, khác hái là còn/lại. 还给我 nêu người nhận lại đồ.",
      "hanzi": "明天请把书还给我。",
      "pinyin": "Míngtiān qǐng bǎ shū huán gěi wǒ.",
      "meaning": "Ngày mai hãy trả sách cho tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l344-t4",
      "type": "teaching",
      "title": "借 · mượn/cho mượn",
      "text": "借 có thể là mượn hoặc cho mượn tùy kết cấu: 向你借是 mượn của bạn, 借给你是 cho bạn mượn. Không chỉ học một bản dịch rời.",
      "hanzi": "我向同事借了一支笔。",
      "pinyin": "Wǒ xiàng tóngshì jiè le yì zhī bǐ.",
      "meaning": "Tôi mượn một cây bút của đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l344-t5",
      "type": "teaching",
      "title": "用 · dùng",
      "text": "用 nêu công cụ hoặc sử dụng; 用笔写字 khác 借笔 mượn bút. Có quyền dùng chưa tự có quyền giữ lại.",
      "hanzi": "我用这支笔填表。",
      "pinyin": "Wǒ yòng zhè zhī bǐ tián biǎo.",
      "meaning": "Tôi dùng cây bút này điền biểu mẫu.",
      "readingMinutes": 1
    },
    {
      "id": "l344-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "向同事借笔 nêu người mình hỏi mượn; 借给同事 là cho đồng nghiệp mượn. 还给 nêu người nhận lại. Cần đọc chủ thể để biết chiều hành động.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l344-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林去银行问银行卡的事情，要记一个电话号码。他向同事借笔，用笔记好，马上还给同事。工作人员说不需要在这个练习里写真实卡号；小林只练习读懂借和还的方向。",
      "pinyin": "Xiǎo Lín qù yínháng wèn yínhángkǎ de shìqing, yào jì yí ge diànhuà hàomǎ. Tā xiàng tóngshì jiè bǐ, yòng bǐ jì hǎo, mǎshàng huán gěi tóngshì. Gōngzuò rényuán shuō bù xūyào zài zhège liànxí lǐ xiě zhēnshí kǎhào; Xiǎo Lín zhǐ liànxí dú dǒng jiè hé huán de fāngxiàng.",
      "meaning": "Lâm hỏi thông tin thẻ, mượn bút của đồng nghiệp để ghi số điện thoại rồi trả ngay. Bài không cần số thẻ thật; chỉ luyện chiều mượn và trả.",
      "readingMinutes": 2
    },
    {
