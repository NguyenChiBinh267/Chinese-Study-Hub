  "blocks": [
    {
      "id": "l49010-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49010-reminder0",
      "type": "teaching",
      "title": "普遍 · phổ biến",
      "text": "普遍 nói xuất hiện rộng, khác mọi trường hợp không ngoại lệ.",
      "hanzi": "这种看法很普遍。",
      "pinyin": "Zhè zhǒng kàn fǎ hěn pǔ biàn.",
      "meaning": "Cách nhìn này khá phổ biến.",
      "readingMinutes": 1
    },
    {
      "id": "l49010-reminder1",
      "type": "teaching",
      "title": "流行 · thịnh hành",
      "text": "流行 tả được ưa chuộng trong một giai đoạn, không bảo đảm chất lượng.",
      "hanzi": "最近流行这种小台灯。",
      "pinyin": "Zuì jìn liú xíng zhè zhǒng xiǎo tái dēng.",
      "meaning": "Gần đây loại đèn bàn nhỏ này thịnh hành.",
      "readingMinutes": 1
