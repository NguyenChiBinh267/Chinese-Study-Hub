  "blocks": [
    {
      "id": "l354-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 完成 wánchéng: hoàn thành; 读音 dúyīn: cách đọc; 混 hùn: trộn lẫn. Hai mục 得 có cùng Hanzi nên bài chọn nghĩa gốc chỉ chấp nhận đọc theo ngữ cảnh; không dùng hai 得 như hai lựa chọn phân biệt hình chữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l354-t0",
      "type": "teaching",
      "title": "得 · được/đạt được",
      "text": "得 dé là động từ đạt/nhận, như 得第一名. Khác děi phải và de trợ từ; cùng chữ không gộp cách đọc vào một thẻ nghĩa.",
      "hanzi": "她在比赛中得了第一名。",
      "pinyin": "Tā zài bǐsài zhōng dé le dì yī míng.",
      "meaning": "Cô ấy đạt hạng nhất cuộc thi.",
      "readingMinutes": 1
    },
    {
      "id": "l354-t1",
      "type": "teaching",
      "title": "得到 · nhận được/đạt được",
      "text": "得到 nêu đạt/nhận một điều như 帮助、机会. Động từ nhấn kết quả, chưa tự là công sức hay bằng chứng năng lực.",
      "hanzi": "我得到了同事的帮助。",
      "pinyin": "Wǒ dédào le tóngshì de bāngzhù.",
      "meaning": "Tôi nhận được sự giúp đỡ của đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l354-t2",
      "type": "teaching",
      "title": "得 · phải/cần phải",
      "text": "得 děi là động từ năng nguyện trước hành động, không là 得 dé nhận được. Đề nhận diện theo chức năng và đọc đúng.",
      "hanzi": "我得先完成工作。",
      "pinyin": "Wǒ děi xiān wánchéng gōngzuò.",
      "meaning": "Tôi phải hoàn thành công việc trước.",
      "readingMinutes": 1
    },
    {
      "id": "l354-t3",
      "type": "teaching",
      "title": "该 · nên/đến lúc phải",
      "text": "该 trong 该走了 chỉ đến lúc nên đi; không phải 该 tài liệu nghĩa “này/đó”. Chữ số nguồn không gõ vào câu.",
      "hanzi": "我们该走了。",
      "pinyin": "Wǒmen gāi zǒu le.",
      "meaning": "Chúng ta đến lúc nên đi rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l354-t4",
      "type": "teaching",
      "title": "愿意 · sẵn lòng/muốn",
      "text": "愿意 nêu tự nguyện/sẵn lòng, 不愿意 là không muốn chứ chưa là không có khả năng. Không suy ra hành động đã xảy ra.",
      "hanzi": "我愿意帮助新同事。",
      "pinyin": "Wǒ yuànyì bāngzhù xīn tóngshì.",
      "meaning": "Tôi sẵn lòng giúp đồng nghiệp mới.",
      "readingMinutes": 1
    },
    {
      "id": "l354-t5",
      "type": "teaching",
      "title": "为 · vì/cho (đối tượng, mục đích theo câu)",
      "text": "为 wèi trong 为同事做事 nêu người hưởng/đối tượng làm vì; khác wéi trong nghĩa làm/trở thành chưa thuộc mục này.",
      "hanzi": "我想为大家做一点儿事。",
      "pinyin": "Wǒ xiǎng wèi dàjiā zuò yìdiǎnr shì.",
      "meaning": "Tôi muốn làm chút việc cho mọi người.",
      "readingMinutes": 1
    },
    {
      "id": "l354-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "得 děi đứng trước động từ nghĩa phải; 得 dé là động từ nhận/đạt. 该 thường nên/phải theo tình huống, 愿意 nói tự nguyện. Không dùng 愿意 để xác nhận đã hoàn thành việc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l354-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林得到了同事的帮助。他愿意为大家做一点儿事，可是今天得先完成自己的工作。经理说：现在该开会了。他知道得第一名的得读dé，得先完成的得读děi，不把读音混在一起。",
      "pinyin": "Xiǎo Lín dédào le tóngshì de bāngzhù. Tā yuànyì wèi dàjiā zuò yìdiǎnr shì, kěshì jīntiān děi xiān wánchéng zìjǐ de gōngzuò. Jīnglǐ shuō: Xiànzài gāi kāi huì le. Tā zhīdào dé dì yī míng de dé dú dé, děi xiān wánchéng de děi dú děi, bù bǎ dúyīn hùn zài yìqǐ.",
      "meaning": "Lâm được đồng nghiệp giúp nên muốn đóng góp, nhưng hôm nay phải hoàn thành việc riêng trước; quản lý báo đến giờ họp. Cậu phân biệt dé đạt và děi phải.",
      "readingMinutes": 2
    },
    {
      "id": "l354-b0",
      "type": "exercise",
      "exerciseVersionId": "l354-v1-e0"
