  "blocks": [
    {
      "id": "l115-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l115-t0",
      "type": "teaching",
      "title": "她们 · họ (nhóm nữ)",
      "text": "她们 chỉ nhóm nữ đã biết trong ngữ cảnh; không thay nhóm vật bằng 她们.",
      "hanzi": "她们是我的家人。",
      "pinyin": "Tā men shì wǒ de jiā rén.",
      "meaning": "Họ là người nhà của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l115-t1",
      "type": "teaching",
      "title": "它 · nó (vật hoặc con vật)",
      "text": "它 trong câu thay con chó đang được nhắc, không thay người bạn theo mẫu của bài.",
      "hanzi": "它是我的狗。",
      "pinyin": "Tā shì wǒ de gǒu.",
      "meaning": "Nó là chó của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l115-t2",
      "type": "teaching",
      "title": "它们 · chúng nó (vật hoặc con vật)",
      "text": "它们 thay nhóm vật/con vật đã xác định, âm giống 他们/她们 nhưng chữ viết khác.",
      "hanzi": "它们是我的狗。",
      "pinyin": "Tā men shì wǒ de gǒu.",
      "meaning": "Chúng là những con chó của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l115-t3",
      "type": "teaching",
      "title": "狗 · chó",
      "text": "狗 chỉ loài chó; câu giới thiệu bằng 是 không tự cho biết số lượng.",
      "hanzi": "我喜欢狗。",
      "pinyin": "Wǒ xǐ huan gǒu.",
      "meaning": "Tôi thích chó.",
      "readingMinutes": 1
    },
    {
      "id": "l115-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "它 chỉ vật/con vật đã rõ trong tình huống; 它们 là số nhiều tương ứng. 他们 thường dùng nhóm nam hoặc nhóm gồm nam nữ; 她们 chỉ nhóm nữ khi biết rõ. Chỉ âm tā/tāmen không đủ phân biệt các chữ. 狗 là chó; không dùng đại từ để đoán một vật chưa được nêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l115-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这是什么？\nB：狗。它是我的狗。\nA：你喜欢它吗？\nB：喜欢。",
      "pinyin": "A: Zhè shì shén me? B: Gǒu. Tā shì wǒ de gǒu. A: Nǐ xǐ huan tā ma? B: Xǐ huan.",
      "meaning": "Đối tượng đã được B gọi là chó nên 它 có đối tượng rõ; đây là một con trong cuộc hội thoại, không suy số nhiều.",
      "readingMinutes": 2
    },
