  "blocks": [
    {
      "id": "l124-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l124-t0",
      "type": "teaching",
      "title": "会 · biết; có khả năng đã học",
      "text": "会 trong 会写汉字 nói kỹ năng; không có nghĩa đã đạt mastery chỉ vì nhân vật nói vậy.",
      "hanzi": "我会写汉字。",
      "pinyin": "Wǒ huì xiě Hàn zì.",
      "meaning": "Tôi biết viết chữ Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l124-t1",
      "type": "teaching",
      "title": "能 · có thể; có khả năng",
      "text": "能 trong câu nói khả năng nghe được ở tình huống hiện tại, không nhất thiết do đã học một kỹ năng.",
      "hanzi": "我能听见你说话。",
      "pinyin": "Wǒ néng tīng jiàn nǐ shuō huà.",
      "meaning": "Tôi có thể nghe bạn nói.",
      "readingMinutes": 1
    },
    {
      "id": "l124-t2",
      "type": "teaching",
      "title": "可以 · có thể; được phép",
      "text": "可以 ở câu hỏi xin phép đọc sách; không phải lời khẳng định có sách.",
      "hanzi": "我可以读这本书吗？",
      "pinyin": "Wǒ kě yǐ dú zhè běn shū ma?",
      "meaning": "Tôi có thể đọc quyển sách này không?",
      "readingMinutes": 1
    },
    {
      "id": "l124-t3",
      "type": "teaching",
      "title": "知道 · biết (thông tin)",
      "text": "知道 dùng với thông tin như tên; 认识 thường nói biết/quen một người.",
      "hanzi": "我知道你的名字。",
      "pinyin": "Wǒ zhī dào nǐ de míng zi.",
      "meaning": "Tôi biết tên bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l124-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "会 thường nói kỹ năng đã học, 能 nói khả năng/điều kiện làm được theo tình huống, 可以 có thể nói sự cho phép. Các nghĩa có chỗ giao nhau; không gán một quy tắc tuyệt đối cho mọi câu. 知道 là biết thông tin, khác 认识 một người đã học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l124-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你会说汉语吗？\nB：会。你呢？\nA：我会说，也会写汉字。\nB：我可以读你的书吗？\nA：可以。",
      "pinyin": "A: Nǐ huì shuō Hàn yǔ ma? B: Huì. Nǐ ne? A: Wǒ huì shuō, yě huì xiě Hàn zì. B: Wǒ kě yǐ dú nǐ de shū ma? A: Kě yǐ.",
      "meaning": "B hỏi xin phép đọc sách của A và A đồng ý. Các phát biểu kỹ năng là nội dung hội thoại, không phải đánh giá người học.",
      "readingMinutes": 2
    },
    {
