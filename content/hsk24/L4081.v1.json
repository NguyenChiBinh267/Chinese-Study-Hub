  "blocks": [
    {
      "id": "l4081-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4081-t0",
      "type": "teaching",
      "title": "情况 · tình hình; tình huống",
      "text": "情况 là những điều đang xảy ra hoặc hoàn cảnh cụ thể.",
      "hanzi": "请先说明具体情况。",
      "pinyin": "Qǐng xiān shuō míng jù tǐ qíng kuàng.",
      "meaning": "Xin nói rõ tình hình cụ thể trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4081-t1",
      "type": "teaching",
      "title": "使馆 · sứ quán",
      "text": "使馆 là cơ quan đại diện ngoại giao; bài không xác nhận địa chỉ hay quy định thật.",
      "hanzi": "她想向使馆询问信息。",
      "pinyin": "Tā xiǎng xiàng shǐ guǎn xún wèn xìn xī.",
      "meaning": "Cô ấy muốn hỏi thông tin từ sứ quán.",
      "readingMinutes": 1
    },
    {
      "id": "l4081-t2",
      "type": "teaching",
      "title": "熟悉 · quen thuộc; biết rõ",
      "text": "熟悉 nói có hiểu biết qua tiếp xúc; không đồng nghĩa biết mọi thay đổi mới. Nhận diện chữ 悉 trong 熟悉; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我不熟悉新的安排。",
      "pinyin": "Wǒ bù shú xi xīn de ān pái.",
      "meaning": "Tôi chưa quen với sắp xếp mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4081-t3",
      "type": "teaching",
      "title": "严格 · nghiêm; chặt chẽ",
      "text": "严格 nói tiêu chuẩn hoặc cách thực hiện không dễ bỏ qua yêu cầu; không tự suy ra một quy định cụ thể.",
      "hanzi": "故事里的材料检查很严格。",
      "pinyin": "Gù shi lǐ de cái liào jiǎn chá hěn yán gé.",
      "meaning": "Trong truyện việc kiểm tra tài liệu rất nghiêm.",
      "readingMinutes": 1
    },
    {
      "id": "l4081-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 nêu căn cứ để hỏi đúng nơi. Bài chỉ luyện lời hỏi trong tình huống hư cấu; không đưa ra yêu cầu visa hay thủ tục thật của bất kỳ sứ quán nào.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4081-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安不熟悉新的安排，想向使馆询问信息。朋友听说材料检查严格，但不知道具体要求。小安说：“既然我们不清楚，就先说明情况，再向负责的人询问。”他们没有把听说的内容当成已确认的规定。",
      "pinyin": "Xiǎo Ān bù shú xi xīn de ān pái, xiǎng xiàng shǐ guǎn xún wèn xìn xī. Péng you tīng shuō cái liào jiǎn chá yán gé, dàn bù zhī dào jù tǐ yāo qiú. Xiǎo Ān shuō: “Jì rán wǒ men bù qīng chu, jiù xiān shuō míng qíng kuàng, zài xiàng fù zé de rén xún wèn.” Tā men méi yǒu bǎ tīng shuō de nèi róng dàng chéng yǐ què rèn de guī dìng.",
      "meaning": "Nhóm hỏi nơi phụ trách thay vì coi lời nghe kể là quy định đã xác nhận.",
      "readingMinutes": 2
    },
