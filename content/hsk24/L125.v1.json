  "blocks": [
    {
      "id": "l125-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l125-t0",
      "type": "teaching",
      "title": "想 · muốn; nghĩ (theo ngữ cảnh)",
      "text": "想 trong 想喝茶 là muốn uống trà; bài chưa khái quát mọi nghĩa nghĩ/nhớ của 想.",
      "hanzi": "我想喝茶。",
      "pinyin": "Wǒ xiǎng hē chá.",
      "meaning": "Tôi muốn uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l125-t1",
      "type": "teaching",
      "title": "要 · muốn; lấy; cần (theo ngữ cảnh)",
      "text": "要 trong lời chọn đồ uống là muốn lấy, không phải lúc nào cũng là dấu tương lai.",
      "hanzi": "我要茶。",
      "pinyin": "Wǒ yào chá.",
      "meaning": "Tôi muốn trà.",
      "readingMinutes": 1
    },
    {
      "id": "l125-t2",
      "type": "teaching",
      "title": "不要 · không muốn; đừng",
      "text": "不要 trong 请不要说话 là lời nhắc đừng nói; trong trả lời chọn đồ uống có thể là không muốn lấy.",
      "hanzi": "请不要说话。",
      "pinyin": "Qǐng bú yào shuō huà.",
      "meaning": "Xin đừng nói chuyện.",
      "readingMinutes": 1
    },
    {
      "id": "l125-t3",
      "type": "teaching",
      "title": "没有 · không có; chưa có",
      "text": "没有 là phủ định có/sở hữu ở ví dụ; không thay nó bằng 不有.",
      "hanzi": "我没有茶。",
      "pinyin": "Wǒ méi yǒu chá.",
      "meaning": "Tôi không có trà.",
      "readingMinutes": 1
    },
    {
      "id": "l125-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "想 + hành động thường nói muốn làm; 要 trong tình huống chọn đồ uống nói muốn/lấy thứ đó. 不要 phủ định yêu cầu hoặc nhắc đừng làm, cần ngữ cảnh lịch sự. Phủ định có/sở hữu là 没有, không dùng 不有. Không biến lời mời thành chấm điểm sở thích cá nhân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l125-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你想喝茶吗？\nB：想。我没有茶。\nA：这是茶，你要吗？\nB：要，谢谢！",
      "pinyin": "A: Nǐ xiǎng hē chá ma? B: Xiǎng. Wǒ méi yǒu chá. A: Zhè shì chá, nǐ yào ma? B: Yào, xiè xie!",
      "meaning": "B muốn uống trà nhưng chưa có; A giới thiệu trà và B đồng ý nhận. Không suy B luôn muốn uống trà ở mọi thời điểm.",
      "readingMinutes": 2
    },
