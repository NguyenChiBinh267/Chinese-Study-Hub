  "blocks": [
    {
      "id": "l4060-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t0",
      "type": "teaching",
      "title": "缺 · thiếu",
      "text": "缺 là động từ thiếu trong câu; không chỉ khuyết điểm.",
      "hanzi": "这套工具缺一个零件。",
      "pinyin": "Zhè tào gōng jù quē yí ge líng jiàn.",
      "meaning": "Bộ dụng cụ này thiếu một bộ phận.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t1",
      "type": "teaching",
      "title": "缺少 · thiếu; thiếu hụt",
      "text": "缺少 là dạng hai chữ; nhiều câu cũng có thể dùng 缺, bài yêu cầu dạng từ rõ ràng.",
      "hanzi": "这里缺少必要的材料。",
      "pinyin": "Zhè lǐ quē shǎo bì yào de cái liào.",
      "meaning": "Ở đây thiếu tư liệu cần thiết.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t2",
      "type": "teaching",
      "title": "满 · đầy",
      "text": "满 chỉ đầy sức chứa, không đồng nghĩa đủ mọi thành phần.",
      "hanzi": "箱子已经满了。",
      "pinyin": "Xiāng zi yǐ jīng mǎn le.",
      "meaning": "Thùng đã đầy rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t3",
      "type": "teaching",
      "title": "整 · cả; nguyên",
      "text": "整 trong 一整天 nhấn cả ngày; đề yêu cầu dạng một chữ. Nhận diện chữ 整 trong 整; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他工作了一整天。",
      "pinyin": "Tā gōng zuò le yì zhěng tiān.",
      "meaning": "Anh ấy làm việc cả một ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t4",
      "type": "teaching",
      "title": "整个 · toàn bộ; cả",
      "text": "整个 thường bổ nghĩa danh từ cụ thể; bài yêu cầu dạng hai chữ.",
      "hanzi": "整个房间都很安静。",
      "pinyin": "Zhěng ge fáng jiān dōu hěn ān jìng.",
      "meaning": "Cả căn phòng rất yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-t5",
      "type": "teaching",
      "title": "所有 · tất cả",
      "text": "所有 thường đứng trước danh từ hoặc dùng 所有的; không có nghĩa chỉ một ít.",
      "hanzi": "所有文件都在桌上。",
      "pinyin": "Suǒ yǒu wén jiàn dōu zài zhuō shàng.",
      "meaning": "Tất cả tài liệu ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4060-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有的是材料 là nhiều tài liệu, không nhất thiết mọi loại cần dùng đều đủ. Luyện phân biệt số lượng lớn với đủ thành phần.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4060-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "整个房间放满了箱子，可这套工具仍缺一个零件。小林整理了一整天，才发现有的是纸，却缺少必要材料。他把所有文件列成清单，准备按需要补齐。",
      "pinyin": "Zhěng ge fáng jiān fàng mǎn le xiāng zi, kě zhè tào gōng jù réng quē yí ge líng jiàn. Xiǎo Lín zhěng lǐ le yì zhěng tiān, cái fā xiàn yǒu de shì zhǐ, què quē shǎo bì yào cái liào. Tā bǎ suǒ yǒu wén jiàn liè chéng qīng dān, zhǔn bèi àn xū yào bǔ qí.",
      "meaning": "Thùng đầy không có nghĩa đủ đồ; Tiểu Lâm lập danh sách phần còn thiếu.",
      "readingMinutes": 2
    },
