  "blocks": [
    {
      "id": "l351-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 家人 jiārén: người nhà; 感谢 gǎnxiè: cảm ơn; 经历 jīnglì: trải nghiệm; 网上 wǎng shàng: trên mạng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l351-t0",
      "type": "teaching",
      "title": "聊 · nói chuyện/tán gẫu",
      "text": "聊 là nói chuyện thoải mái; 聊工作 nói trò chuyện về việc, không tự là cuộc họp chính thức.",
      "hanzi": "我们聊一会儿吧。",
      "pinyin": "Wǒmen liáo yíhuìr ba.",
      "meaning": "Chúng ta nói chuyện một lúc nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l351-t1",
      "type": "teaching",
      "title": "聊天儿 · tán gẫu/trò chuyện",
      "text": "聊天儿 là nói chuyện phiếm, 儿 hóa nằm trong tiānr. 跟朋友聊天儿 nêu người trò chuyện; không dùng 聊天儿朋友.",
      "hanzi": "她喜欢跟朋友聊天儿。",
      "pinyin": "Tā xǐhuan gēn péngyou liáo tiānr.",
      "meaning": "Cô ấy thích tán gẫu với bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l351-t2",
      "type": "teaching",
      "title": "关系 · quan hệ/mối liên hệ",
      "text": "关系 là quan hệ giữa người/việc; 没关系 còn là lời đáp “không sao”, không dùng một bản dịch cho mọi chỗ.",
      "hanzi": "他跟邻居的关系很好。",
      "pinyin": "Tā gēn línjū de guānxì hěn hǎo.",
      "meaning": "Quan hệ của anh ấy với hàng xóm rất tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l351-t3",
      "type": "teaching",
      "title": "关心 · quan tâm/chăm lo",
      "text": "关心 chú ý vì lo và muốn điều tốt cho ai/việc; 关心你 khác chỉ 关注 một bản tin. Không biết cảm xúc người khác chỉ từ một hành động.",
      "hanzi": "家人很关心我。",
      "pinyin": "Jiārén hěn guānxīn wǒ.",
      "meaning": "Người nhà rất quan tâm tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l351-t4",
      "type": "teaching",
      "title": "关注 · chú ý/theo dõi",
      "text": "关注 thường là chú ý/theo dõi người hoặc thông tin, như 关注新闻; không tự là hành động chăm sóc cụ thể.",
      "hanzi": "我关注学校的新消息。",
      "pinyin": "Wǒ guānzhù xuéxiào de xīn xiāoxi.",
      "meaning": "Tôi theo dõi tin mới của trường.",
      "readingMinutes": 1
    },
    {
      "id": "l351-t5",
      "type": "teaching",
      "title": "身边 · bên cạnh/quanh mình",
      "text": "身边 là bên cạnh hoặc những người gần gũi theo cảnh, khác 身上 trên người. 身边的人 chỉ người quanh mình.",
      "hanzi": "我很感谢身边的朋友。",
      "pinyin": "Wǒ hěn gǎnxiè shēnbiān de péngyou.",
      "meaning": "Tôi cảm ơn những người bạn bên mình.",
      "readingMinutes": 1
    },
    {
      "id": "l351-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "咱们 bao gồm cả người nghe trong lời rủ: 咱们聊一会儿吧. 我们 có thể gồm hoặc không gồm người nghe tùy ngữ cảnh. Bài không khẳng định luôn thay thế được.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l351-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "朋友坐在小林身边，说：咱们聊一会儿吧。两人聊天儿，谈到跟邻居的关系。朋友关心他的生活，也关注学校的消息，但不会把网上看到的每条消息当成他个人的经历。",
      "pinyin": "Péngyou zuò zài Xiǎo Lín shēnbiān, shuō: Zánmen liáo yíhuìr ba. Liǎng rén liáo tiānr, tándào gēn línjū de guānxì. Péngyou guānxīn tā de shēnghuó, yě guānzhù xuéxiào de xiāoxi, dàn bú huì bǎ wǎng shàng kàndào de měi tiáo xiāoxi dàngchéng tā gè rén de jīnglì.",
      "meaning": "Bạn ngồi cạnh Lâm rủ cùng nói chuyện về hàng xóm và cuộc sống. Bạn quan tâm Lâm, theo dõi tin trường nhưng không coi mọi tin mạng là trải nghiệm của Lâm.",
      "readingMinutes": 2
    },
    {
      "id": "l351-b0",
      "type": "exercise",
      "exerciseVersionId": "l351-v1-e0"
    },
