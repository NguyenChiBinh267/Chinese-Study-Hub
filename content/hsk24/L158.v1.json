  "blocks": [
    {
      "id": "l158-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l158-t0",
      "type": "teaching",
      "title": "买 · mua",
      "text": "买 là mua; khác 卖 bán cả chữ và thanh điệu.",
      "hanzi": "我买书。",
      "pinyin": "Wǒ mǎi shū.",
      "meaning": "Tôi mua sách.",
      "readingMinutes": 1
    },
    {
      "id": "l158-t1",
      "type": "teaching",
      "title": "卖 · bán",
      "text": "卖 là bán; không bỏ nét để biến thành 买 mua.",
      "hanzi": "这家店卖书。",
      "pinyin": "Zhè jiā diàn mài shū.",
      "meaning": "Tiệm này bán sách.",
      "readingMinutes": 1
    },
    {
      "id": "l158-t2",
      "type": "teaching",
      "title": "钱 · tiền",
      "text": "钱 là tiền trong câu; không tự có số tiền hoặc loại tiền nếu chưa nêu.",
      "hanzi": "我没有钱。",
      "pinyin": "Wǒ méi yǒu qián.",
      "meaning": "Tôi không có tiền.",
      "readingMinutes": 1
    },
    {
      "id": "l158-t3",
      "type": "teaching",
      "title": "贵 · đắt; giá cao",
      "text": "贵 là nhận xét giá trong tình huống, không phải báo giá đã kiểm chứng của một cuốn sách thật.",
      "hanzi": "这本书很贵。",
      "pinyin": "Zhè běn shū hěn guì.",
      "meaning": "Quyển sách này đắt.",
      "readingMinutes": 1
    },
    {
      "id": "l158-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động từ/tính từ + 不 + chính từ đó tạo câu hỏi chính-phản như 买不买/贵不贵. Với mẫu này không thêm 吗 như câu hỏi có-không thông thường. 买 mǎi là mua, 卖 mài là bán; giữ thanh và chữ khác nhau. 贵 chỉ giá cao theo nhận xét trong câu, không phải giá thị trường thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l158-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这本书贵不贵？\nB：很贵。\nA：你买不买？\nB：我不买这本，我买那本。",
      "pinyin": "A: Zhè běn shū guì bu guì? B: Hěn guì. A: Nǐ mǎi bu mǎi? B: Wǒ bù mǎi zhè běn, wǒ mǎi nà běn.",
      "meaning": "B nhận xét quyển này đắt và chọn quyển kia. 不 trong câu hỏi chính-phản có thể nhẹ; pinyin mục 不 riêng vẫn bù.",
      "readingMinutes": 2
    },
