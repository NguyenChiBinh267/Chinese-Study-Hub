  "blocks": [
    {
      "id": "l212-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "星期 chỉ tuần/thứ; 做 là làm. Mỗi hoạt động có cách kết hợp riêng; không thêm 做 trước mọi động từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l212-t0",
      "type": "teaching",
      "title": "经常 · thường xuyên",
      "text": "经常 nói việc lặp lại khá thường xuyên, không nhất thiết mỗi ngày.",
      "hanzi": "我经常跑步。",
      "pinyin": "Wǒ jīngcháng pǎobù.",
      "meaning": "Tôi thường xuyên chạy bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l212-t1",
      "type": "teaching",
      "title": "有时 · đôi lúc",
      "text": "有时 đặt trước hoạt động để nói chỉ xảy ra vào một số lúc; không đồng nghĩa luôn luôn.",
      "hanzi": "我有时在家运动。",
      "pinyin": "Wǒ yǒushí zài jiā yùndòng.",
      "meaning": "Đôi lúc tôi vận động ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l212-t2",
      "type": "teaching",
      "title": "自己 · bản thân, tự mình",
      "text": "自己 chỉ chính người đang được nói đến. 我自己做 nhấn mạnh tôi tự làm; không mặc định đang ở một mình.",
      "hanzi": "这些事情我自己做。",
      "pinyin": "Zhèxiē shìqing wǒ zìjǐ zuò.",
      "meaning": "Những việc này tôi tự làm.",
      "readingMinutes": 1
    },
    {
      "id": "l212-t3",
      "type": "teaching",
      "title": "跑步 · chạy bộ",
      "text": "跑步 là hoạt động chạy bộ; không nói 做跑步 trong mẫu này. Khi thêm thời lượng cần học cách tách động từ riêng sau.",
      "hanzi": "他每天早上跑步。",
      "pinyin": "Tā měitiān zǎoshang pǎobù.",
      "meaning": "Sáng nào anh ấy cũng chạy bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l212-t4",
      "type": "teaching",
      "title": "运动 · vận động, tập thể thao",
      "text": "运动 ở đây chỉ hoạt động thể chất; dùng 做运动 hoặc 运动. Không phải mọi cử động nhỏ đều là một buổi tập.",
      "hanzi": "做运动以后，我想喝水。",
      "pinyin": "Zuò yùndòng yǐhòu, wǒ xiǎng hē shuǐ.",
      "meaning": "Sau khi tập thể thao, tôi muốn uống nước.",
      "readingMinutes": 1
    },
    {
      "id": "l212-t5",
      "type": "teaching",
      "title": "游泳 · bơi",
      "text": "游泳 chỉ bơi, không phải đi du lịch. 游泳 và 旅游 đều có 游 nhưng nghĩa toàn từ khác.",
      "hanzi": "星期天我们去游泳。",
      "pinyin": "Xīngqītiān wǒmen qù yóuyǒng.",
      "meaning": "Chủ nhật chúng tôi đi bơi.",
      "readingMinutes": 1
    },
    {
      "id": "l212-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "经常 đặt trước động từ để nói thường xuyên; 有时 chỉ đôi lúc. Hai từ không bảo đảm một số lần cố định mỗi tuần.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l212-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你经常做什么运动？乙：我经常跑步，有时游泳。甲：你和谁一起跑步？乙：有时和朋友一起，有时自己去。",
      "pinyin": "Jiǎ: Nǐ jīngcháng zuò shénme yùndòng? Yǐ: Wǒ jīngcháng pǎobù, yǒushí yóuyǒng. Jiǎ: Nǐ hé shéi yìqǐ pǎobù? Yǐ: Yǒushí hé péngyou yìqǐ, yǒushí zìjǐ qù.",
      "meaning": "A: Bạn thường tập môn gì? B: Tôi thường chạy bộ, đôi lúc bơi. A: Bạn chạy với ai? B: Có lúc với bạn, có lúc tự đi.",
      "readingMinutes": 2
    },
