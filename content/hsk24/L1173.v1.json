  "blocks": [
    {
      "id": "l1173-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder0",
      "type": "teaching",
      "title": "牛奶 · sữa bò",
      "text": "Từ đã học 牛奶 có 2 chữ. Chữ 奶 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 奶 với 妈 / 好 / 仍; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喜欢喝牛奶。",
      "pinyin": "Wǒ xǐ huan hē niú nǎi.",
      "meaning": "Tôi thích uống sữa bò.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder1",
      "type": "teaching",
      "title": "苹果 · táo",
      "text": "Từ đã học 苹果 có 2 chữ. Chữ 苹 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 苹 với 平 / 萍 / 草; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有一个苹果。",
      "pinyin": "Wǒ yǒu yí ge píng guǒ.",
      "meaning": "Tôi có một quả táo.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder2",
      "type": "teaching",
      "title": "鸡蛋 · trứng gà",
      "text": "Từ đã học 鸡蛋 có 2 chữ. Chữ 鸡 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 鸡 với 鸣 / 鸭 / 鸟; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有三个鸡蛋。",
      "pinyin": "Wǒ yǒu sān ge jī dàn.",
      "meaning": "Tôi có ba quả trứng gà.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder3",
      "type": "teaching",
      "title": "超市 · siêu thị",
      "text": "Từ đã học 超市 có 2 chữ. Chữ 超 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 超 với 起 / 走 / 赴; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那是超市。",
      "pinyin": "Nà shì chāo shì.",
      "meaning": "Kia là siêu thị.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder4",
      "type": "teaching",
      "title": "卖 · bán",
      "text": "Từ đã học 卖 có 1 chữ. Chữ 卖 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 卖 với 买 / 读 / 实; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这家店卖书。",
      "pinyin": "Zhè jiā diàn mài shū.",
      "meaning": "Tiệm này bán sách.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reminder5",
      "type": "teaching",
      "title": "贵 · đắt; giá cao",
      "text": "Từ đã học 贵 có 1 chữ. Chữ 贵 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 贵 với 责 / 费 / 员; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这本书很贵。",
      "pinyin": "Zhè běn shū hěn guì.",
      "meaning": "Quyển sách này đắt.",
      "readingMinutes": 1
    },
    {
      "id": "l1173-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你买这件衣服吗？\nB：不，这件太贵了。\nA：那件呢？\nB：我想买那件。",
      "pinyin": "A: Nǐ mǎi zhè jiàn yī fu ma? B: Bù, zhè jiàn tài guì le. A: Nà jiàn ne? B: Wǒ xiǎng mǎi nà jiàn.",
      "meaning": "B không mua chiếc này vì thấy quá đắt, muốn mua chiếc kia.",
      "readingMinutes": 2
    },
