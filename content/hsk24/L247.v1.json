  "blocks": [
    {
      "id": "l247-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "去 là đi đến; 买 là mua; 要 có thể diễn đạt dự định. 家 đếm cơ sở như khách sạn; chỉ nhắc nghĩa hỗ trợ, không xác nhận mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t0",
      "type": "teaching",
      "title": "Nhắc lại · 机场 · sân bay",
      "text": "机场 là nơi máy bay đến và đi, khác 车站. Không dùng 机场 để chỉ riêng một chuyến bay.",
      "hanzi": "我们早上去机场。",
      "pinyin": "Wǒmen zǎoshang qù jīchǎng.",
      "meaning": "Sáng chúng tôi đến sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t1",
      "type": "teaching",
      "title": "Nhắc lại · 机票 · vé máy bay",
      "text": "机票 là vé cho chuyến bay; 买了机票 chưa nói đã đến sân bay.",
      "hanzi": "我已经买了机票。",
      "pinyin": "Wǒ yǐjīng mǎi le jīpiào.",
      "meaning": "Tôi đã mua vé máy bay.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t2",
      "type": "teaching",
      "title": "Nhắc lại · 票 · vé",
      "text": "票 là tên chung cho vé; ngữ cảnh mới cho biết vé xe, vé máy bay hay loại khác.",
      "hanzi": "你的票在这里。",
      "pinyin": "Nǐ de piào zài zhèlǐ.",
      "meaning": "Vé của bạn ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t3",
      "type": "teaching",
      "title": "Nhắc lại · 酒店 · khách sạn",
      "text": "酒店 ở đây là nơi ở khi đi xa; không nhầm với 饭馆 là nơi ăn.",
      "hanzi": "这家酒店离机场很近。",
      "pinyin": "Zhè jiā jiǔdiàn lí jīchǎng hěn jìn.",
      "meaning": "Khách sạn này rất gần sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t4",
      "type": "teaching",
      "title": "Nhắc lại · 旅游 · đi du lịch",
      "text": "旅游 là đi để tham quan, nghỉ hoặc trải nghiệm, không dùng cho mọi lần đi làm xa. Giữ âm ü trong lǚ.",
      "hanzi": "我们想去中国旅游。",
      "pinyin": "Wǒmen xiǎng qù Zhōngguó lǚyóu.",
      "meaning": "Chúng tôi muốn đi du lịch Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-t5",
      "type": "teaching",
      "title": "Nhắc lại · 准备 · chuẩn bị",
      "text": "准备 có thể nói chuẩn bị đồ/việc hoặc dự định làm gì; bài tập nghĩa ở đây là chuẩn bị cho chuyến đi.",
      "hanzi": "我在准备明天的东西。",
      "pinyin": "Wǒ zài zhǔnbèi míngtiān de dōngxi.",
      "meaning": "Tôi đang chuẩn bị đồ cho ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l247-t0-l207-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "已经 đặt trước động từ để báo việc đã xảy ra. 我已经买了机票 nói đã mua vé; không tự cho biết giờ bay hay nơi ở.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l247-t0-l207-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：明天去旅游，你准备好了吗？乙：机票已经买了。我们早上去机场。甲：住哪里？乙：住机场旁边的酒店。",
      "pinyin": "Jiǎ: Míngtiān qù lǚyóu, nǐ zhǔnbèi hǎo le ma? Yǐ: Jīpiào yǐjīng mǎi le. Wǒmen zǎoshang qù jīchǎng. Jiǎ: Zhù nǎlǐ? Yǐ: Zhù jīchǎng pángbiān de jiǔdiàn.",
      "meaning": "A: Mai đi du lịch, bạn chuẩn bị xong chưa? B: Vé máy bay đã mua rồi. Sáng chúng ta đến sân bay. A: Ở đâu? B: Ở khách sạn bên cạnh sân bay.",
      "readingMinutes": 2
    },
