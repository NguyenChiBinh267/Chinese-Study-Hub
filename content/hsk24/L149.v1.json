  "blocks": [
    {
      "id": "l149-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l149-t0",
      "type": "teaching",
      "title": "早 · sớm",
      "text": "早 là sớm theo mốc đang nói, không tự là danh từ cả buổi sáng trong mọi câu.",
      "hanzi": "太早了！",
      "pinyin": "Tài zǎo le!",
      "meaning": "Sớm quá!",
      "readingMinutes": 1
    },
    {
      "id": "l149-t1",
      "type": "teaching",
      "title": "早上 · buổi sáng (dạng zǎoshang)",
      "text": "早上 chỉ buổi sáng, thường đầu ngày; 上 nhẹ theo pinyin mục từ.",
      "hanzi": "早上好！",
      "pinyin": "Zǎo shang hǎo!",
      "meaning": "Chào buổi sáng!",
      "readingMinutes": 1
    },
    {
      "id": "l149-t2",
      "type": "teaching",
      "title": "上午 · buổi sáng trước trưa (dạng shàngwǔ)",
      "text": "上午 chỉ phần trước trưa, có thể chồng lấn với 早上; đề nêu rõ âm để chọn mục.",
      "hanzi": "我上午上课。",
      "pinyin": "Wǒ shàng wǔ shàng kè.",
      "meaning": "Tôi học trên lớp vào buổi sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l149-t3",
      "type": "teaching",
      "title": "中午 · buổi trưa",
      "text": "中午 là buổi trưa theo sinh hoạt, không tự là đúng một phút trên đồng hồ.",
      "hanzi": "我中午休息。",
      "pinyin": "Wǒ zhōng wǔ xiū xi.",
      "meaning": "Tôi nghỉ vào buổi trưa.",
      "readingMinutes": 1
    },
    {
      "id": "l149-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "早 tả sớm; 早上 là buổi sáng thường nói ở đầu ngày, 上午 là phần trước buổi trưa. Hai cách gọi buổi sáng có thể chồng lấn, không gán giờ tuyệt đối cho mọi tình huống. 中午 là buổi trưa; thời gian có thể đứng trước hành động như 我上午上课.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l149-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：早上好！你上午上课吗？\nB：上课。你呢？\nA：我也上课，中午我休息。",
      "pinyin": "A: Zǎo shang hǎo! Nǐ shàng wǔ shàng kè ma? B: Shàng kè. Nǐ ne? A: Wǒ yě shàng kè, zhōng wǔ wǒ xiū xi.",
      "meaning": "Hai người học vào buổi sáng; A nói nghỉ buổi trưa. Không có giờ bắt đầu/kết thúc chính xác trong đoạn.",
      "readingMinutes": 2
    },
