  "blocks": [
    {
      "id": "l339-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 却 què: lại/nhưng; 改 gǎi: đổi; 确定 quèdìng: xác định; 到达 dàodá: đến nơi, chỉ đối chiếu với 起飞.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l339-t0",
      "type": "teaching",
      "title": "骑 · cưỡi/đi (xe đạp, ngựa)",
      "text": "骑 dùng cho cưỡi ngựa hoặc đi xe đạp; không dùng 骑汽车 thay 开/坐汽车. Trong bài là đạp xe.",
      "hanzi": "我平时骑车上学。",
      "pinyin": "Wǒ píngshí qí chē shàng xué.",
      "meaning": "Bình thường tôi đạp xe đi học.",
      "readingMinutes": 1
    },
    {
      "id": "l339-t1",
      "type": "teaching",
      "title": "船 · thuyền/tàu thủy",
      "text": "船 chỉ phương tiện trên nước; 坐船 là đi tàu/thuyền, không phải máy bay.",
      "hanzi": "我们坐船过河。",
      "pinyin": "Wǒmen zuò chuán guò hé.",
      "meaning": "Chúng tôi đi thuyền qua sông.",
      "readingMinutes": 1
    },
    {
      "id": "l339-t2",
      "type": "teaching",
      "title": "起飞 · cất cánh",
      "text": "起飞 nói máy bay bắt đầu bay; khác 到达 là đến nơi. 八点起飞不等于八点到达.",
      "hanzi": "飞机八点起飞。",
      "pinyin": "Fēijī bā diǎn qǐfēi.",
      "meaning": "Máy bay cất cánh lúc tám giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l339-t3",
      "type": "teaching",
      "title": "晚点 · trễ giờ (chuyến xe/tàu/máy bay)",
      "text": "晚点 là trễ so với lịch, không chỉ thời điểm muộn trong ngày. 晚点了 chưa biết chính xác trễ bao lâu.",
      "hanzi": "今天的飞机晚点了。",
      "pinyin": "Jīntiān de fēijī wǎndiǎn le.",
      "meaning": "Chuyến bay hôm nay trễ giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l339-t4",
      "type": "teaching",
      "title": "伞 · ô/dù",
      "text": "伞 là ô; 一把伞 dùng 把 là lượng từ. 没带伞 nói không mang ô, chưa tự có nghĩa sẽ ướt.",
      "hanzi": "下雨了，我带了一把伞。",
      "pinyin": "Xià yǔ le, wǒ dài le yì bǎ sǎn.",
      "meaning": "Trời mưa, tôi mang một chiếc ô.",
      "readingMinutes": 1
    },
    {
      "id": "l339-t5",
      "type": "teaching",
      "title": "雨衣 · áo mưa",
      "text": "雨衣 là áo che mưa; 穿雨衣 là mặc áo mưa, khác 打伞 là che ô.",
      "hanzi": "骑车时她穿雨衣。",
      "pinyin": "Qí chē shí tā chuān yǔyī.",
      "meaning": "Khi đạp xe cô ấy mặc áo mưa.",
      "readingMinutes": 1
    },
    {
      "id": "l339-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "或者坐船，或者坐飞机 đưa hai phương án trong trần thuật. Câu hỏi trực tiếp 你坐船还是坐飞机 cần 还是. Bài luyện phương án dự kiến chứ chưa đặt vé.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l339-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林平时骑车去车站，下雨时穿雨衣，今天却坐车，还带了伞。朋友原来想坐船，后来改坐飞机。飞机晚点了，起飞时间还没确定，两人先看通知。",
      "pinyin": "Xiǎo Lín píngshí qí chē qù chēzhàn, xià yǔ shí chuān yǔyī, jīntiān què zuò chē, hái dài le sǎn. Péngyou yuánlái xiǎng zuò chuán, hòulái gǎi zuò fēijī. Fēijī wǎndiǎn le, qǐfēi shíjiān hái méi quèdìng, liǎng rén xiān kàn tōngzhī.",
      "meaning": "Lâm thường đạp xe, mặc áo mưa khi mưa; hôm nay đi xe và mang ô. Bạn đổi đi thuyền sang máy bay, nhưng chuyến trễ và giờ cất cánh chưa xác định.",
      "readingMinutes": 2
    },
    {
      "id": "l339-b0",
      "type": "exercise",
      "exerciseVersionId": "l339-v1-e0"
    },
