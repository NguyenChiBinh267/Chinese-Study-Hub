  "blocks": [
    {
      "id": "l472-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 固定 gùdìng: cố định; 商量 shāngliang: bàn bạc; 月末 yuè mò: cuối tháng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l472-t0",
      "type": "teaching",
      "title": "秒 · giây",
      "text": "秒 là đơn vị thời gian; 六十秒 bằng một phút trong hệ đo thông thường.",
      "hanzi": "请等十秒。",
      "pinyin": "Qǐng děng shí miǎo.",
      "meaning": "Hãy đợi mười giây.",
      "readingMinutes": 1
    },
    {
      "id": "l472-t1",
      "type": "teaching",
      "title": "末 · cuối",
      "text": "末 trong 周末、月末 chỉ cuối kỳ; không phải 未来的未.",
      "hanzi": "我们月末再见面。",
      "pinyin": "Wǒmen yuè mò zài jiànmiàn.",
      "meaning": "Cuối tháng chúng ta gặp lại.",
      "readingMinutes": 1
    },
    {
      "id": "l472-t2",
      "type": "teaching",
      "title": "目前 · hiện nay",
      "text": "目前 chỉ tình hình ở thời điểm đang nói; khác 将来 là tương lai.",
      "hanzi": "目前还没有确定时间。",
      "pinyin": "Mùqián hái méiyǒu quèdìng shíjiān.",
      "meaning": "Hiện chưa xác định thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l472-t3",
      "type": "teaching",
      "title": "年底 · cuối năm",
      "text": "年底 là phần cuối năm, không phải 年底 chắc chắn một ngày cụ thể.",
      "hanzi": "我们年底再整理记录。",
      "pinyin": "Wǒmen niándǐ zài zhěnglǐ jìlù.",
      "meaning": "Cuối năm chúng ta xem lại bản ghi.",
      "readingMinutes": 1
    },
    {
      "id": "l472-t4",
      "type": "teaching",
      "title": "年龄 · tuổi, độ tuổi",
      "text": "年龄 là danh từ tuổi; số tuổi dùng 岁, không nói 我二十年龄. Nhận diện chữ 龄 trong 年龄; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "年龄不同，习惯也不同。",
      "pinyin": "Niánlíng bù tóng, xíguàn yě bù tóng.",
      "meaning": "Tuổi khác, thói quen cũng khác.",
      "readingMinutes": 1
    },
    {
      "id": "l472-t5",
      "type": "teaching",
      "title": "偶尔 · thỉnh thoảng",
      "text": "偶尔 nói tần suất ít/không thường xuyên, không đồng nghĩa 偶然 là tình cờ trong mọi câu.",
      "hanzi": "我偶尔去图书馆看书。",
      "pinyin": "Wǒ ǒuěr qù túshūguǎn kàn shū.",
      "meaning": "Thỉnh thoảng tôi tới thư viện đọc.",
      "readingMinutes": 1
    },
    {
      "id": "l472-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "偶尔 + động từ nêu tần suất thỉnh thoảng, không phải ngày cố định: 我偶尔去图书馆. Chưa biến thành lịch tuần bắt buộc. Trong bài sắp xếp dùng một cụm vị ngữ để giữ thứ tự duy nhất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l472-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社区读书小组里，大家年龄不同。小杨说自己偶尔去图书馆，目前还不能每周固定参加。负责人建议月末再商量时间，年底一起整理阅读记录。发言前，大家先等十秒，让还没想好的人也有机会。",
      "pinyin": "Shèqū dúshū xiǎozǔ lǐ, dàjiā niánlíng bù tóng. Xiǎo Yáng shuō zìjǐ ǒuěr qù túshūguǎn, mùqián hái bù néng měi zhōu gùdìng cānjiā. Fùzérén jiànyì yuè mò zài shāngliang shíjiān, niándǐ yìqǐ zhěnglǐ yuèdú jìlù. Fāyán qián, dàjiā xiān děng shí miǎo, ràng hái méi xiǎng hǎo de rén yě yǒu jīhuì.",
      "meaning": "Nhóm đọc có nhiều độ tuổi. Dương chỉ thỉnh thoảng tới thư viện, chưa cam kết mỗi tuần. Nhóm bàn lại cuối tháng, xem bản ghi cuối năm và chừa thời gian cho mọi người nghĩ trước phát biểu.",
      "readingMinutes": 2
    },
    {
