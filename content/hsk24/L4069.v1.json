  "blocks": [
    {
      "id": "l4069-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t0",
      "type": "teaching",
      "title": "幽默 · hài hước; dí dỏm",
      "text": "幽默 mô tả cách nói gây vui khéo léo, không đồng nghĩa chế giễu. Nhận diện chữ 幽 trong 幽默; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他说话很幽默。",
      "pinyin": "Tā shuō huà hěn yōu mò.",
      "meaning": "Anh ấy nói chuyện dí dỏm.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t1",
      "type": "teaching",
      "title": "笑话 · chuyện cười",
      "text": "笑话 trong 讲笑话 là câu chuyện gây cười.",
      "hanzi": "她给我们讲了一个笑话。",
      "pinyin": "Tā gěi wǒ men jiǎng le yí ge xiào hua.",
      "meaning": "Cô ấy kể cho chúng tôi một chuyện cười.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t2",
      "type": "teaching",
      "title": "有趣 · thú vị",
      "text": "有趣 nói có điều hấp dẫn người trải nghiệm.",
      "hanzi": "这个故事很有趣。",
      "pinyin": "Zhè ge gù shi hěn yǒu qù.",
      "meaning": "Câu chuyện này thú vị.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t3",
      "type": "teaching",
      "title": "无聊 · buồn chán; tẻ nhạt",
      "text": "无聊 có thể tả cảm giác hoặc việc thiếu hấp dẫn; ở đây tả người đang chờ.",
      "hanzi": "等得太久，他觉得无聊。",
      "pinyin": "Děng de tài jiǔ, tā jué de wú liáo.",
      "meaning": "Chờ quá lâu anh ấy thấy chán.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t4",
      "type": "teaching",
      "title": "愉快 · vui vẻ; dễ chịu",
      "text": "愉快 nói tâm trạng hay trải nghiệm dễ chịu.",
      "hanzi": "我们度过了愉快的下午。",
      "pinyin": "Wǒ men dù guò le yú kuài de xià wǔ.",
      "meaning": "Chúng tôi có buổi chiều vui vẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-t5",
      "type": "teaching",
      "title": "游玩 · đi chơi; tham quan",
      "text": "游玩 chỉ hoạt động đi chơi, không phải làm việc.",
      "hanzi": "周末我们去公园游玩。",
      "pinyin": "Zhōu mò wǒ men qù gōng yuán yóu wán.",
      "meaning": "Cuối tuần chúng tôi đi chơi công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l4069-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 bổ sung điều hạn chế của đánh giá. 幽默 nói nét dí dỏm; 笑话 là câu chuyện vui. Hứng thú của một người không đại diện cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4069-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "大家去公园游玩，排队时小安觉得无聊。小林说话幽默，讲了一个有趣的笑话，大家笑了。不过小安更想散步，不想一直听故事。朋友尊重他的想法，一起度过了愉快的下午。",
      "pinyin": "Dà jiā qù gōng yuán yóu wán, pái duì shí Xiǎo Ān jué de wú liáo. Xiǎo Lín shuō huà yōu mò, jiǎng le yí ge yǒu qù de xiào hua, dà jiā xiào le. Bú guò Xiǎo Ān gèng xiǎng sàn bù, bù xiǎng yì zhí tīng gù shi. Péng you zūn zhòng tā de xiǎng fǎ, yì qǐ dù guò le yú kuài de xià wǔ.",
      "meaning": "Bạn bè tôn trọng sở thích đi dạo của Tiểu An, dù câu chuyện vui.",
      "readingMinutes": 2
    },
    {
