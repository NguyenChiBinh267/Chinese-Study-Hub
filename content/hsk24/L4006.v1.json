  "blocks": [
    {
      "id": "l4006-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t0",
      "type": "teaching",
      "title": "人数 · số người",
      "text": "人数 là số lượng người, thường đi với 增加、减少、统计; khác 人员 chỉ những người tham gia.",
      "hanzi": "请先统计参加活动的人数。",
      "pinyin": "Qǐng xiān tǒng jì cān jiā huó dòng de rén shù.",
      "meaning": "Hãy thống kê số người tham gia trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t1",
      "type": "teaching",
      "title": "人员 · nhân sự; người tham gia",
      "text": "人员 chỉ tập hợp người đảm nhận công việc; không phải con số.",
      "hanzi": "工作人员正在准备桌椅。",
      "pinyin": "Gōng zuò rén yuán zhèng zài zhǔn bèi zhuō yǐ.",
      "meaning": "Nhân viên đang chuẩn bị bàn ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t2",
      "type": "teaching",
      "title": "任务 · nhiệm vụ",
      "text": "任务 là việc được giao cần hoàn thành; khác 活动 là cả hoạt động. Nhận diện chữ 任 trong 任务; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我的任务是检查名单。",
      "pinyin": "Wǒ de rèn wu shì jiǎn chá míng dān.",
      "meaning": "Nhiệm vụ của tôi là kiểm tra danh sách.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t3",
      "type": "teaching",
      "title": "任何 · bất kỳ",
      "text": "任何 bổ nghĩa danh từ; trong câu phủ định 不能把任何… nghĩa là không được bỏ sót bất kỳ… nào.",
      "hanzi": "不能漏掉任何一位客人。",
      "pinyin": "Bù néng lòu diào rèn hé yí wèi kè rén.",
      "meaning": "Không được bỏ sót bất kỳ vị khách nào.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t4",
      "type": "teaching",
      "title": "同时 · đồng thời",
      "text": "同时 nối hai việc xảy ra cùng lúc hoặc bổ sung việc cần làm; không mang nghĩa giống nhau.",
      "hanzi": "两组人员同时开始工作。",
      "pinyin": "Liǎng zǔ rén yuán tóng shí kāi shǐ gōng zuò.",
      "meaning": "Hai nhóm nhân sự bắt đầu cùng lúc.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-t5",
      "type": "teaching",
      "title": "同样 · giống nhau; như nhau",
      "text": "同样 nói sự giống nhau, không có nghĩa hai việc diễn ra cùng thời điểm.",
      "hanzi": "两组有同样的任务。",
      "pinyin": "Liǎng zǔ yǒu tóng yàng de rèn wu.",
      "meaning": "Hai nhóm có nhiệm vụ giống nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l4006-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有的是 + danh từ nhấn mạnh có rất nhiều, không thiếu: 有的是时间. Không hiểu thành 有的 (một số). Cần đọc cả cụm 是, không bỏ nó.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4006-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "活动负责人先统计人数，再安排人员。第一组的任务是摆桌椅，第二组同时检查名单，不能漏掉任何一位客人。两组都收到同样的通知。小李担心来不及，负责人说：“离开始还有两个小时，我们有的是时间，不用着急。”",
      "pinyin": "Huó dòng fù zé rén xiān tǒng jì rén shù, zài ān pái rén yuán. Dì yī zǔ de rèn wu shì bǎi zhuō yǐ, dì èr zǔ tóng shí jiǎn chá míng dān, bù néng lòu diào rèn hé yí wèi kè rén. Liǎng zǔ dōu shōu dào tóng yàng de tōng zhī. Xiǎo Lǐ dān xīn lái bu jí, fù zé rén shuō: “Lí kāi shǐ hái yǒu liǎng ge xiǎo shí, wǒ men yǒu de shì shí jiān, bú yòng zháo jí.”",
      "meaning": "Người phụ trách phân công hai nhóm, một nhóm bày bàn ghế và một nhóm kiểm danh sách; còn hai giờ chuẩn bị.",
      "readingMinutes": 2
    },
    {
