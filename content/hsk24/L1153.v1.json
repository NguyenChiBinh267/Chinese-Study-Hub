  "blocks": [
    {
      "id": "l1153-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder0",
      "type": "teaching",
      "title": "人 · người",
      "text": "Từ đã học 人 có 1 chữ. Chữ 人 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 人 với 八 / 入 / 大; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这个人叫安。",
      "pinyin": "Zhè ge rén jiào Ān.",
      "meaning": "Người này tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder1",
      "type": "teaching",
      "title": "什么 · gì; cái gì",
      "text": "Từ đã học 什么 có 2 chữ. Chữ 什 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 什 với 仟 / 叶 / 计; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你叫什么名字？",
      "pinyin": "Nǐ jiào shén me míng zi?",
      "meaning": "Bạn tên là gì?",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder2",
      "type": "teaching",
      "title": "认识 · quen; biết một người",
      "text": "Từ đã học 认识 có 2 chữ. Chữ 认 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 认 với 让 / 议 / 讥; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我认识你。",
      "pinyin": "Wǒ rèn shi nǐ.",
      "meaning": "Tôi biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder3",
      "type": "teaching",
      "title": "高兴 · vui; vui mừng",
      "text": "Từ đã học 高兴 có 2 chữ. Chữ 高 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 高 với 亮 / 商 / 亭; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "认识你，我很高兴。",
      "pinyin": "Rèn shi nǐ, wǒ hěn gāo xìng.",
      "meaning": "Tôi vui được biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder4",
      "type": "teaching",
      "title": "怎么 · thế nào; bằng cách nào",
      "text": "Từ đã học 怎么 có 2 chữ. Chữ 么 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 么 với 公 / 云 / 去; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你的名字怎么写？",
      "pinyin": "Nǐ de míng zi zěn me xiě?",
      "meaning": "Tên bạn viết thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reminder5",
      "type": "teaching",
      "title": "他 · anh ấy; ông ấy",
      "text": "Từ đã học 他 có 1 chữ. Chữ 他 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 他 với 她 / 它 / 池; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他叫安。",
      "pinyin": "Tā jiào Ān.",
      "meaning": "Anh ấy tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l1153-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这是你哥哥吗？\nB：不是，这是我弟弟。\nA：他几岁？\nB：六岁。",
      "pinyin": "A: Zhè shì nǐ gē ge ma? B: Bú shì, zhè shì wǒ dì di. A: Tā jǐ suì? B: Liù suì.",
      "meaning": "B sửa quan hệ: em trai, không phải anh trai; em6tuổi.",
      "readingMinutes": 2
    },
