  "blocks": [
    {
      "id": "l131-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l131-t0",
      "type": "teaching",
      "title": "外 · ngoài; bên ngoài (dạng một chữ)",
      "text": "外 đứng sau nơi chốn, đối lập với 里 trong các ví dụ.",
      "hanzi": "我在房间外。",
      "pinyin": "Wǒ zài fáng jiān wài.",
      "meaning": "Tôi ở ngoài phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l131-t1",
      "type": "teaching",
      "title": "外边 · bên ngoài (dạng hai chữ)",
      "text": "外边 là dạng hai chữ; 边 nhẹ trong pinyin từ điển của mục này.",
      "hanzi": "狗在外边。",
      "pinyin": "Gǒu zài wài bian.",
      "meaning": "Chó ở bên ngoài.",
      "readingMinutes": 1
    },
    {
      "id": "l131-t2",
      "type": "teaching",
      "title": "边 · bên; cạnh",
      "text": "边 trong 桌子边 nói phía cạnh bàn, không phải nhất thiết ở trên bàn.",
      "hanzi": "猫在桌子边。",
      "pinyin": "Māo zài zhuō zi biān.",
      "meaning": "Mèo ở cạnh bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l131-t3",
      "type": "teaching",
      "title": "那边 · bên kia; phía kia",
      "text": "那边 dựa vào điểm được người nói chỉ; không tự là hướng đông hay tây.",
      "hanzi": "那边是医院。",
      "pinyin": "Nà biān shì yī yuàn.",
      "meaning": "Bên kia là bệnh viện.",
      "readingMinutes": 1
    },
    {
      "id": "l131-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "外放在地名/处所后表示外面：房间外。外边是较完整的地点说法；边可在桌子边中表示旁侧。那边是所指的另一边，不等于任何固定的左边或右边。Bài chỉ học quan hệ vị trí được viết rõ, không đo khoảng cách.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l131-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你的狗在房间里吗？\nB：不在，它在外边。\nA：猫呢？\nB：猫在桌子边。",
      "pinyin": "A: Nǐ de gǒu zài fáng jiān lǐ ma? B: Bú zài, tā zài wài bian. A: Māo ne? B: Māo zài zhuō zi biān.",
      "meaning": "医院 yī yuàn = bệnh viện, được chú giải trước bài nghề nghiệp. Chó ở ngoài; mèo ở cạnh bàn.",
      "readingMinutes": 2
    },
