  "blocks": [
    {
      "id": "l341-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 讨论 tǎolùn: thảo luận; 手续 shǒuxù: thủ tục; 办不了 bàn bu liǎo: không xử lý được; 安排 ānpái: sắp xếp. Khả năng bổ ngữ cần ôn trong L323.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l341-t0",
      "type": "teaching",
      "title": "办公室 · văn phòng",
      "text": "办公室 là phòng/nơi làm công việc hành chính; không phải mọi công ty là một căn phòng duy nhất.",
      "hanzi": "经理在办公室。",
      "pinyin": "Jīnglǐ zài bàngōngshì.",
      "meaning": "Quản lý ở văn phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l341-t1",
      "type": "teaching",
      "title": "办 · làm/xử lý (việc, thủ tục)",
      "text": "办 dùng xử lý công việc như 办手续、办事, không thay 做 trong mọi hoạt động. 办完 là xử lý xong.",
      "hanzi": "这件事明天再办。",
      "pinyin": "Zhè jiàn shì míngtiān zài bàn.",
      "meaning": "Việc này ngày mai xử lý sau.",
      "readingMinutes": 1
    },
    {
      "id": "l341-t2",
      "type": "teaching",
      "title": "开会 · họp",
      "text": "开会 là tham gia/tổ chức cuộc họp tùy chủ thể; không phải 打开 một vật gọi là 会.",
      "hanzi": "我们下午三点开会。",
      "pinyin": "Wǒmen xiàwǔ sān diǎn kāi huì.",
      "meaning": "Chúng tôi họp lúc ba giờ chiều.",
      "readingMinutes": 1
    },
    {
      "id": "l341-t3",
      "type": "teaching",
      "title": "会 · cuộc họp",
      "text": "会 huì danh từ trong 这个会, khác 会 năng nguyện “biết/có thể/sẽ”. Chữ số 2 chỉ phân biệt mục từ nguồn, không phải phần chữ người học gõ.",
      "hanzi": "这个会四点结束。",
      "pinyin": "Zhège huì sì diǎn jiéshù.",
      "meaning": "Cuộc họp này kết thúc lúc bốn giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l341-t4",
      "type": "teaching",
      "title": "同事 · đồng nghiệp",
      "text": "同事 chỉ người làm cùng đơn vị/công việc theo bài; không tự là bạn thân hay quản lý.",
      "hanzi": "新同事坐在我旁边。",
      "pinyin": "Xīn tóngshì zuò zài wǒ pángbiān.",
      "meaning": "Đồng nghiệp mới ngồi cạnh tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l341-t5",
      "type": "teaching",
      "title": "同意 · đồng ý",
      "text": "同意 nêu tán thành với đề nghị cụ thể; 不同意 không đồng nghĩa ghét người đề xuất. 同意了也可能还没执行.",
      "hanzi": "我同意先问同事。",
      "pinyin": "Wǒ tóngyì xiān wèn tóngshì.",
      "meaning": "Tôi đồng ý hỏi đồng nghiệp trước.",
      "readingMinutes": 1
    },
    {
      "id": "l341-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "为了… nêu mục đích trước hành động: 为了讨论计划，我们开会. Mục đích chưa chứng minh kết quả; 开会了 không có nghĩa đã đạt đồng thuận.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l341-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "为了讨论下周的计划，经理和同事们下午在办公室开会。这个会四点结束。有件事今天办不了，大家同意明天再办。小林只同意这个安排，没有说每个问题都解决了。",
      "pinyin": "Wèile tǎolùn xià zhōu de jìhuà, jīnglǐ hé tóngshìmen xiàwǔ zài bàngōngshì kāi huì. Zhège huì sì diǎn jiéshù. Yǒu jiàn shì jīntiān bàn bu liǎo, dàjiā tóngyì míngtiān zài bàn. Xiǎo Lín zhǐ tóngyì zhège ānpái, méiyǒu shuō měi ge wèntí dōu jiějué le.",
      "meaning": "Quản lý và đồng nghiệp họp về kế hoạch tuần tới. Họp kết thúc lúc bốn giờ; một việc chưa làm được nên nhất trí xử lý ngày mai. Lâm chỉ tán thành cách sắp xếp này.",
      "readingMinutes": 2
    },
    {
