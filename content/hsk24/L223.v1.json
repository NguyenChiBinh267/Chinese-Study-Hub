  "blocks": [
    {
      "id": "l223-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "去 là đi đến; 来/去 chọn theo mốc người nói. 站 trong bài là danh từ trạm, không phải động từ đứng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l223-t0",
      "type": "teaching",
      "title": "出 · ra, đi từ trong ra",
      "text": "出 là động từ ra; trong 出学校 nói đi ra khỏi trường. Không lẫn với 进 là vào.",
      "hanzi": "他刚出教室。",
      "pinyin": "Tā gāng chū jiàoshì.",
      "meaning": "Anh ấy vừa ra khỏi phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l223-t1",
      "type": "teaching",
      "title": "出国 · ra nước ngoài",
      "text": "出国 nói rời đất nước để đến nước khác. Đi từ nhà đến ga chưa đủ để gọi là 出国.",
      "hanzi": "我想明年出国学习。",
      "pinyin": "Wǒ xiǎng míngnián chūguó xuéxí.",
      "meaning": "Tôi muốn năm sau ra nước ngoài học.",
      "readingMinutes": 1
    },
    {
      "id": "l223-t2",
      "type": "teaching",
      "title": "出门 · ra khỏi nhà hoặc cửa",
      "text": "出门 trong kế hoạch hằng ngày thường nói ra khỏi nhà. Không đồng nghĩa nhất thiết đi nước ngoài.",
      "hanzi": "我出门买东西。",
      "pinyin": "Wǒ chūmén mǎi dōngxi.",
      "meaning": "Tôi ra ngoài mua đồ.",
      "readingMinutes": 1
    },
    {
      "id": "l223-t3",
      "type": "teaching",
      "title": "进 · vào",
      "text": "进 là động từ vào. 同音 近 jìn chỉ gần; câu đi vào phải chọn chữ 进.",
      "hanzi": "请进教室。",
      "pinyin": "Qǐng jìn jiàoshì.",
      "meaning": "Mời vào phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l223-t4",
      "type": "teaching",
      "title": "飞 · bay",
      "text": "飞 là bay trong không trung; 坐飞机 là đi bằng máy bay. Không phải mọi đi xa đều dùng 飞.",
      "hanzi": "鸟在天上飞。",
      "pinyin": "Niǎo zài tiān shang fēi.",
      "meaning": "Chim bay trên trời.",
      "readingMinutes": 1
    },
    {
      "id": "l223-t5",
      "type": "teaching",
      "title": "站 · trạm, điểm dừng",
      "text": "Mục từ chính thức 站1 là danh từ trạm ở cấp này; không dùng động từ đứng để chứng minh nghĩa này đã học.",
      "hanzi": "下一站是机场。",
      "pinyin": "Xià yí zhàn shì jīchǎng.",
      "meaning": "Trạm tiếp theo là sân bay.",
      "readingMinutes": 1
    },
    {
      "id": "l223-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Một người có thể nối hai hoạt động: 出门买东西, ra ngoài để mua đồ. Không cần thêm một chủ ngữ mới giữa hai hoạt động cùng người làm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l223-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你今天出国吗？乙：不是，我出门去机场看朋友。甲：怎么去？乙：坐地铁，下一站就是机场。",
      "pinyin": "Jiǎ: Nǐ jīntiān chūguó ma? Yǐ: Bú shì, wǒ chūmén qù jīchǎng kàn péngyou. Jiǎ: Zěnme qù? Yǐ: Zuò dìtiě, xià yí zhàn jiù shì jīchǎng.",
      "meaning": "A: Hôm nay bạn ra nước ngoài à? B: Không, tôi ra ngoài đến sân bay gặp bạn. A: Đi thế nào? B: Tàu điện ngầm, trạm kế tiếp là sân bay.",
      "readingMinutes": 2
    },
    {
