  "blocks": [
    {
      "id": "l399-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder0",
      "type": "teaching",
      "title": "放心 · yên tâm",
      "text": "放心 diễn tả bớt lo vì tin vào điều gì trong ngữ cảnh. Không dùng để bảo đảm rủi ro y tế hoặc điều chưa kiểm chứng.",
      "hanzi": "我到家就给你打电话，你放心吧。",
      "pinyin": "Wǒ dào jiā jiù gěi nǐ dǎ diànhuà, nǐ fàngxīn ba.",
      "meaning": "Tôi về tới nhà sẽ gọi bạn, bạn yên tâm nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder1",
      "type": "teaching",
      "title": "饿 · đói",
      "text": "饿 tả cảm giác đói; khác 渴 khát. 很饿 không nói chính xác cần ăn bao nhiêu hoặc suy ra nguyên nhân y tế.",
      "hanzi": "我有点儿饿，想吃饭。",
      "pinyin": "Wǒ yǒudiǎnr è, xiǎng chī fàn.",
      "meaning": "Tôi hơi đói, muốn ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder2",
      "type": "teaching",
      "title": "渴 · khát",
      "text": "渴 tả khát nước; khác 可 kě trong 可是 và khác 饱 no. 我渴了 là lời báo cảm giác.",
      "hanzi": "走了很久，我有点儿渴。",
      "pinyin": "Zǒu le hěn jiǔ, wǒ yǒudiǎnr kě.",
      "meaning": "Đi lâu rồi, tôi hơi khát.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder3",
      "type": "teaching",
      "title": "饱 · no",
      "text": "饱 trong 吃饱了 nói đã no sau ăn; không đồng nghĩa đồ ăn ngon hay món ăn đã hết.",
      "hanzi": "我吃饱了，不想再吃。",
      "pinyin": "Wǒ chī bǎo le, bù xiǎng zài chī.",
      "meaning": "Tôi no rồi, không muốn ăn thêm.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder4",
      "type": "teaching",
      "title": "冰箱 · tủ lạnh",
      "text": "冰箱 là thiết bị để giữ lạnh; khác 箱子 thùng/hộp nói chung. Trong bài chỉ hỏi nơi lấy đồ uống.",
      "hanzi": "饮料在冰箱里。",
      "pinyin": "Yǐnliào zài bīngxiāng lǐ.",
      "meaning": "Đồ uống ở trong tủ lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder5",
      "type": "teaching",
      "title": "冰箱 · tủ lạnh",
      "text": "冰箱 là thiết bị để giữ lạnh; khác 箱子 thùng/hộp nói chung. Trong bài chỉ hỏi nơi lấy đồ uống.",
      "hanzi": "饮料在冰箱里。",
      "pinyin": "Yǐnliào zài bīngxiāng lǐ.",
      "meaning": "Đồ uống ở trong tủ lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l399-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不用 là không cần, khác 不能 là không thể/không được. Bài luyện nhánh 不用; 不必 chỉ được đối chiếu như cách nói không cần, chưa có đánh giá riêng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l399-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我想参加学校的锻炼活动，必须买票吗？小李：不用买票，但必须先报名。小安：我会问清楚活动怎么安排，再决定。小李：这样我就放心了。小安：我希望能坚持，不过今天感到有点儿累。",
      "pinyin": "Xiǎo Ān: Wǒ xiǎng cānjiā xuéxiào de duànliàn huódòng, bìxū mǎi piào ma? Xiǎo Lǐ: Búyòng mǎi piào, dàn bìxū xiān bàomíng. Xiǎo Ān: Wǒ huì wèn qīngchu huódòng zěnme ānpái, zài juédìng. Xiǎo Lǐ: Zhèyàng wǒ jiù fàngxīn le. Xiǎo Ān: Wǒ xīwàng néng jiānchí, búguò jīntiān gǎndào yǒudiǎnr lèi.",
      "meaning": "An hỏi hoạt động luyện tập của trường có cần mua vé. Lý nói không cần vé nhưng phải đăng ký. An sẽ hỏi cách tổ chức rồi quyết định. An muốn duy trì nhưng hôm nay hơi mệt. Chỉ ghi nhận lời kể và quy định của hoạt động hư cấu.",
      "readingMinutes": 2
    },
