  "blocks": [
    {
      "id": "l104-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l104-t0",
      "type": "teaching",
      "title": "您 · ngài; bác; anh/chị (kính trọng)",
      "text": "您 là dạng xưng hô tôn trọng của 你; bản dịch Việt tùy quan hệ.",
      "hanzi": "您好！",
      "pinyin": "Nín hǎo!",
      "meaning": "Xin chào bác/anh chị!",
      "readingMinutes": 1
    },
    {
      "id": "l104-t1",
      "type": "teaching",
      "title": "请 · xin; mời",
      "text": "请 đứng trước hành động trong lời mời; không dùng nó như một lời cảm ơn.",
      "hanzi": "请喝茶。",
      "pinyin": "Qǐng hē chá.",
      "meaning": "Mời uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l104-t2",
      "type": "teaching",
      "title": "谢谢 · cảm ơn",
      "text": "谢谢 đáp khi được giúp hoặc được mời theo tình huống; không cần dịch từng chữ hai lần.",
      "hanzi": "谢谢您！",
      "pinyin": "Xiè xie nín!",
      "meaning": "Cảm ơn bác/anh chị!",
      "readingMinutes": 1
    },
    {
      "id": "l104-t3",
      "type": "teaching",
      "title": "不客气 · không có gì; đừng khách sáo",
      "text": "不客气 đáp lại lời cảm ơn; nguồn ghi bú kèqi cho cả cụm cố định này.",
      "hanzi": "不客气。",
      "pinyin": "Bú kè qi.",
      "meaning": "Không có gì.",
      "readingMinutes": 1
    },
    {
      "id": "l104-t4",
      "type": "teaching",
      "title": "再见 · tạm biệt; hẹn gặp lại",
      "text": "再见 dùng lúc chia tay; không suy rằng đã hẹn chính xác một ngày gặp.",
      "hanzi": "再见，安！",
      "pinyin": "Zài jiàn, Ān!",
      "meaning": "Tạm biệt An!",
      "readingMinutes": 1
    },
    {
      "id": "l104-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "请 + động từ có thể tạo lời mời/yêu cầu lịch sự trong ngữ cảnh. 请喝茶 là mời uống trà, không phải câu hỏi sở thích. 谢谢/不客气 là một cặp đáp lời thường gặp. 您 là cách xưng hô kính trọng; chọn theo quan hệ, không gán một tuổi cứng cho mọi tình huống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l104-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：您好！请喝茶。\nB：谢谢您！\nA：不客气。\nB：再见！\nA：再见！",
      "pinyin": "A: Nín hǎo! Qǐng hē chá. B: Xiè xie nín! A: Bú kè qi. B: Zài jiàn! A: Zài jiàn!",
      "meaning": "A mời trà, B cảm ơn, A đáp không có gì; cuối đoạn hai người chia tay.",
      "readingMinutes": 2
    },
