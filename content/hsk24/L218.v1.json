  "blocks": [
    {
      "id": "l218-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "词 là từ; 怎么样 hỏi nhận xét. Không biến nhận xét chủ quan thú vị/không thú vị thành sự thật về mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l218-t0",
      "type": "teaching",
      "title": "为什么 · tại sao",
      "text": "为什么 hỏi nguyên nhân, không hỏi vị trí hay thời gian. Câu trả lời có thể dùng 因为.",
      "hanzi": "你为什么不去？",
      "pinyin": "Nǐ wèi shénme bú qù?",
      "meaning": "Tại sao bạn không đi?",
      "readingMinutes": 1
    },
    {
      "id": "l218-t1",
      "type": "teaching",
      "title": "但是 · nhưng",
      "text": "但是 nối ý tương phản; không dùng thay 所以 nếu cần nêu kết quả nguyên nhân.",
      "hanzi": "我想去，但是今天没有时间。",
      "pinyin": "Wǒ xiǎng qù, dànshì jīntiān méiyǒu shíjiān.",
      "meaning": "Tôi muốn đi nhưng hôm nay không có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l218-t2",
      "type": "teaching",
      "title": "虽然 · tuy, mặc dù",
      "text": "虽然 thừa nhận một điều trước khi nêu ý trái kỳ vọng. Thường phối hợp 但是 trong mẫu này.",
      "hanzi": "虽然很远，但是我想去。",
      "pinyin": "Suīrán hěn yuǎn, dànshì wǒ xiǎng qù.",
      "meaning": "Tuy xa nhưng tôi muốn đi.",
      "readingMinutes": 1
    },
    {
      "id": "l218-t3",
      "type": "teaching",
      "title": "事情 · việc, sự việc",
      "text": "事情 nói việc hoặc chuyện cần làm/được nhắc đến, không chỉ một vật hữu hình. 情 trong từ này đọc nhẹ.",
      "hanzi": "我今天有很多事情要做。",
      "pinyin": "Wǒ jīntiān yǒu hěn duō shìqing yào zuò.",
      "meaning": "Hôm nay tôi có nhiều việc phải làm.",
      "readingMinutes": 1
    },
    {
      "id": "l218-t4",
      "type": "teaching",
      "title": "意思 · ý nghĩa, ý",
      "text": "意思 trong 这个词的意思 là nghĩa của từ; không phải động từ thích. 思 đọc nhẹ.",
      "hanzi": "这个词是什么意思？",
      "pinyin": "Zhège cí shì shénme yìsi?",
      "meaning": "Từ này có nghĩa gì?",
      "readingMinutes": 1
    },
    {
      "id": "l218-t5",
      "type": "teaching",
      "title": "有意思 · thú vị",
      "text": "有意思 là nhận xét thấy thú vị. Không dịch từng chữ thành sở hữu một ý nghĩa trong mẫu 这本书很有意思.",
      "hanzi": "这本书很有意思。",
      "pinyin": "Zhè běn shū hěn yǒu yìsi.",
      "meaning": "Quyển sách này rất thú vị.",
      "readingMinutes": 1
    },
    {
      "id": "l218-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "虽然 nêu một điều được thừa nhận, 但是 chuyển sang điều đối lập. ‘Tuy xa nhưng thú vị’ không phủ nhận nơi đó xa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l218-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你为什么想去那家书店？乙：虽然很远，但是那里的书很有意思。甲：我今天有很多事情要做，不能和你一起去。乙：好，下次一起去。",
      "pinyin": "Jiǎ: Nǐ wèi shénme xiǎng qù nà jiā shūdiàn? Yǐ: Suīrán hěn yuǎn, dànshì nàlǐ de shū hěn yǒu yìsi. Jiǎ: Wǒ jīntiān yǒu hěn duō shìqing yào zuò, bù néng hé nǐ yìqǐ qù. Yǐ: Hǎo, xià cì yìqǐ qù.",
      "meaning": "A: Vì sao bạn muốn đến hiệu sách đó? B: Tuy xa nhưng sách ở đó thú vị. A: Hôm nay tôi có nhiều việc nên không thể cùng đi. B: Được, lần sau cùng đi.",
      "readingMinutes": 2
    },
