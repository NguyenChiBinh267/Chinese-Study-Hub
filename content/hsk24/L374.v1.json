  "blocks": [
    {
      "id": "l374-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 没空 méi kòng: không rảnh; 书名 shūmíng: tên sách; 记下来 jì xiàlái: ghi lại. Các cặp đồng nghĩa chỉ luyện dạng chữ có ràng buộc, không chấm các biến thể tự do là sai ngữ pháp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l374-t0",
      "type": "teaching",
      "title": "不但 · không những/không chỉ",
      "text": "不但 đưa ý đầu của cặp tăng tiến 不但…而且…, thường dùng 不但会读，而且会写. 不 cần suy ra ý nào đã thành thạo từ lời khoe.",
      "hanzi": "她不但会读，而且会写。",
      "pinyin": "Tā búdàn huì dú, érqiě huì xiě.",
      "meaning": "Cô ấy không chỉ biết đọc mà còn biết viết.",
      "readingMinutes": 1
    },
    {
      "id": "l374-t1",
      "type": "teaching",
      "title": "而且 · mà còn/hơn nữa",
      "text": "而且 bổ sung ý tăng tiến, thường đi với 不但 nhưng cũng có thể dùng độc lập. Không dùng làm dấu chuyển ý trái ngược như 可是.",
      "hanzi": "这本书便宜，而且有用。",
      "pinyin": "Zhè běn shū piányi, érqiě yǒuyòng.",
      "meaning": "Sách này rẻ, hơn nữa còn hữu ích.",
      "readingMinutes": 1
    },
    {
      "id": "l374-t2",
      "type": "teaching",
      "title": "可 · nhưng (liên từ khẩu ngữ)",
      "text": "可 trong câu này là nhưng, gần 可是, khác 可以 là có thể. Đề truy hồi một chữ vì cả 可/可是 có thể đúng khi đổi dạng.",
      "hanzi": "我想去，可今天没空。",
      "pinyin": "Wǒ xiǎng qù, kě jīntiān méi kòng.",
      "meaning": "Tôi muốn đi nhưng hôm nay không rảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l374-t3",
      "type": "teaching",
      "title": "可是 · nhưng",
      "text": "可是 chuyển ý tương phản giữa mong muốn và điều kiện; không tự phủ định mọi câu trước. Có thể gần 可 trong lời nói, không dùng làm đáp án phân biệt nghĩa tuyệt đối.",
      "hanzi": "我想买，可是没带钱。",
      "pinyin": "Wǒ xiǎng mǎi, kěshì méi dài qián.",
      "meaning": "Tôi muốn mua nhưng không mang tiền.",
      "readingMinutes": 1
    },
    {
      "id": "l374-t4",
      "type": "teaching",
      "title": "或 · hoặc (dạng một chữ)",
      "text": "或 nối lựa chọn và thường gọn trong văn viết như 今天或明天. 或者 cũng có thể phù hợp, nên câu truy hồi ghi rõ một chữ.",
      "hanzi": "今天或明天都行。",
      "pinyin": "Jīntiān huò míngtiān dōu xíng.",
      "meaning": "Hôm nay hoặc mai đều được.",
      "readingMinutes": 1
    },
    {
      "id": "l374-t5",
      "type": "teaching",
      "title": "或者 · hoặc (dạng hai chữ)",
      "text": "或者 nối lựa chọn trong trần thuật; câu hỏi chọn trực tiếp thường 还是. Không khẳng định 或 không dùng được ở cùng vị trí.",
      "hanzi": "我们坐车或者走路去。",
      "pinyin": "Wǒmen zuò chē huòzhě zǒu lù qù.",
      "meaning": "Chúng ta đi xe hoặc đi bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l374-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不但A，而且B nhấn thêm mức/ý mới; 可/可是 chuyển ý, 或/或者 nối lựa chọn. 可 và 可是 có thể gần nghĩa; 或 và 或者 cũng vậy, bài ghi rõ khi chỉ truy hồi đúng dạng chữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l374-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林说：这本书不但便宜，而且有用，我想买，可没带钱。朋友说：今天或明天买都行；我们可以坐车或者走路回来。小林说：可是明天我有课，那就先把书名记下来。",
      "pinyin": "Xiǎo Lín shuō: Zhè běn shū búdàn piányi, érqiě yǒuyòng, wǒ xiǎng mǎi, kě méi dài qián. Péngyou shuō: Jīntiān huò míngtiān mǎi dōu xíng; wǒmen kěyǐ zuò chē huòzhě zǒu lù huílai. Xiǎo Lín shuō: Kěshì míngtiān wǒ yǒu kè, nà jiù xiān bǎ shūmíng jì xiàlái.",
      "meaning": "Lâm thấy sách rẻ và hữu ích nhưng quên tiền. Bạn nói hôm nay hay mai đều được, có thể xe hoặc đi bộ quay lại; Lâm có lớp mai nên ghi tên sách trước.",
      "readingMinutes": 2
    },
