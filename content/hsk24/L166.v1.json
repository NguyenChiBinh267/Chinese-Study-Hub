  "blocks": [
    {
      "id": "l166-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l166-t0",
      "type": "teaching",
      "title": "开车 · lái xe (dạng kāichē)",
      "text": "开车 là tự lái xe trong ví dụ; 坐车 không xác nhận người đó là tài xế.",
      "hanzi": "我爸爸开车去学校。",
      "pinyin": "Wǒ bà ba kāi chē qù xué xiào.",
      "meaning": "Bố tôi lái xe đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l166-t1",
      "type": "teaching",
      "title": "开 · mở (dạng kāi trong mẫu mở cửa)",
      "text": "开 trong 开门 là mở cửa; bài chưa khái quát mọi nghĩa của 开.",
      "hanzi": "请开门。",
      "pinyin": "Qǐng kāi mén.",
      "meaning": "Xin mở cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l166-t2",
      "type": "teaching",
      "title": "坐 · ngồi; đi bằng phương tiện (dạng zuò)",
      "text": "坐 trong 坐火车 nói đi bằng tàu, không tự nói người đó lái tàu.",
      "hanzi": "我坐火车去学校。",
      "pinyin": "Wǒ zuò huǒ chē qù xué xiào.",
      "meaning": "Tôi đi tàu hỏa đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l166-t3",
      "type": "teaching",
      "title": "看见 · nhìn thấy (dạng kànjiàn)",
      "text": "看见 nói nhìn thấy; 看 có thể chỉ hành động nhìn/xem mà không khẳng định thấy đối tượng.",
      "hanzi": "我看见老师了。",
      "pinyin": "Wǒ kàn jiàn lǎo shī le.",
      "meaning": "Tôi đã nhìn thấy thầy/cô rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l166-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "我坐火车去学校 dùng 坐火车 nêu phương tiện đi học. 开车 là lái xe, khác 坐车 là đi/ngồi trên xe; không suy ai cũng có bằng lái. 开 trong 开门 là mở; 开车 là tổ hợp lái xe. 看见 nhấn đã nhìn thấy trong câu, khác 看 là hành động nhìn/xem. Câu hỏi nêu dạng và âm để không chấm sai từ đồng nghĩa ngoài phạm vi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l166-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你爸爸怎么去学校？\nB：他开车去学校。\nA：你呢？\nB：我坐火车去学校。",
      "pinyin": "A: Nǐ bà ba zěn me qù xué xiào? B: Tā kāi chē qù xué xiào. A: Nǐ ne? B: Wǒ zuò huǒ chē qù xué xiào.",
      "meaning": "Bố của B lái xe; B đi tàu. Phân biệt người lái với người ngồi/đi bằng phương tiện trong dữ kiện hư cấu.",
      "readingMinutes": 2
    },
