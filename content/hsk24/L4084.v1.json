  "blocks": [
    {
      "id": "l4084-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4084-t0",
      "type": "teaching",
      "title": "无论 · bất kể; dù",
      "text": "无论 trong 无论选哪本书，都… nói quy tắc giữ với mọi lựa chọn trong phạm vi câu.",
      "hanzi": "无论选哪本书，都先看目录。",
      "pinyin": "Wú lùn xuǎn nǎ běn shū, dōu xiān kàn mù lù.",
      "meaning": "Bất kể chọn sách nào, đều xem mục lục trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4084-t1",
      "type": "teaching",
      "title": "羡慕 · ngưỡng mộ; ao ước có được",
      "text": "羡慕 nói mong có điều tốt như người khác, không nhất thiết ghét họ. Nhận diện chữ 慕 trong 羡慕; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我羡慕她有时间阅读。",
      "pinyin": "Wǒ xiàn mù tā yǒu shí jiān yuè dú.",
      "meaning": "Tôi ao ước có thời gian đọc như cô ấy.",
      "readingMinutes": 1
    },
    {
      "id": "l4084-t2",
      "type": "teaching",
      "title": "再说 · hơn nữa; để nói sau",
      "text": "再说 ở 再说，这本书… bổ sung lý do; trong 下次再说 lại là nói sau, cần xét câu.",
      "hanzi": "我先借这本，再说，它也不太厚。",
      "pinyin": "Wǒ xiān jiè zhè běn, zài shuō, tā yě bú tài hòu.",
      "meaning": "Tôi mượn cuốn này trước, hơn nữa nó cũng không quá dày.",
      "readingMinutes": 1
    },
    {
      "id": "l4084-t3",
      "type": "teaching",
      "title": "者 · người; yếu tố tạo tên người làm việc",
      "text": "者 là trợ từ trong mục nguồn, ở 读者 tạo nghĩa người đọc; không nhập cả 读者 khi bài yêu cầu một chữ.",
      "hanzi": "这位读者提出了一个问题。",
      "pinyin": "Zhè wèi dú zhě tí chū le yí ge wèn tí.",
      "meaning": "Người đọc này nêu một câu hỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l4084-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "无论 nêu các khả năng, 都 giữ kết quả nhất quán. 者 trong 读者 chỉ người làm việc đọc; không dùng 者 như một danh từ độc lập thay cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4084-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "一位读者羡慕朋友每周都有时间阅读，自己却很忙。朋友说：“无论选哪本书，都先看目录，按自己的目标安排。”她选了一本较薄的书，说：“再说，这本也适合我。”她没有照搬朋友的进度。",
      "pinyin": "Yí wèi dú zhě xiàn mù péng you měi zhōu dōu yǒu shí jiān yuè dú, zì jǐ què hěn máng. Péng you shuō: “Wú lùn xuǎn nǎ běn shū, dōu xiān kàn mù lù, àn zì jǐ de mù biāo ān pái.” Tā xuǎn le yì běn jiào báo de shū, shuō: “Zài shuō, zhè běn yě shì hé wǒ.” Tā méi yǒu zhào bān péng you de jìn dù.",
      "meaning": "Người đọc chọn sách theo mục tiêu, thời gian của mình thay vì sao chép tiến độ bạn.",
      "readingMinutes": 2
    },
