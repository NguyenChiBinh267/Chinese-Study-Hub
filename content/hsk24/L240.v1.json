  "blocks": [
    {
      "id": "l240-prereq",
      "type": "teaching",
      "title": "Kiến thức hỗ trợ",
      "text": "Nhắc 我/你/他, 是/有/在, số và câu hỏi cơ bản; HSK1 chưa hoàn chỉnh. Từ hỗ trợ trong ngữ cảnh được giải thích tại mỗi mục; không cộng từ mới hay cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l240-reminder0",
      "type": "teaching",
      "title": "Nhắc từ đã học · 介绍",
      "text": "介绍 là làm người nghe biết một người/sự việc. 给你介绍一位老师 là giới thiệu một giáo viên với bạn.",
      "hanzi": "我给你介绍一位老师。",
      "pinyin": "Wǒ gěi nǐ jièshào yí wèi lǎoshī.",
      "meaning": "Tôi giới thiệu một giáo viên với bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l240-reminder1",
      "type": "teaching",
      "title": "Nhắc từ đã học · 帮忙",
      "text": "帮忙 dùng như hoạt động giúp đỡ: 请来帮忙. Không đặt người ngay sau toàn từ theo kiểu 帮忙我.",
      "hanzi": "你能来帮忙吗？",
      "pinyin": "Nǐ néng lái bāngmáng ma?",
      "meaning": "Bạn có thể đến giúp một tay không?",
      "readingMinutes": 1
    },
    {
      "id": "l240-reminder2",
      "type": "teaching",
      "title": "Nhắc từ đã học · 送",
      "text": "Bài này luyện nghĩa tặng quà: 送给妈妈. Không dùng câu này để suy ra nghĩa tiễn/đưa người trong ngữ cảnh khác.",
      "hanzi": "我想买一条裤子送给妈妈。",
      "pinyin": "Wǒ xiǎng mǎi yì tiáo kùzi sòng gěi māma.",
      "meaning": "Tôi muốn mua một chiếc quần tặng mẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l240-reminder3",
      "type": "teaching",
      "title": "Nhắc từ đã học · 希望",
      "text": "希望 nêu mong muốn, không bảo đảm kết quả. Tôi mong bạn đến không có nghĩa bạn đã đồng ý đến.",
      "hanzi": "我希望你明天来。",
      "pinyin": "Wǒ xīwàng nǐ míngtiān lái.",
      "meaning": "Tôi mong bạn đến ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l240-grammar0",
      "type": "teaching",
      "title": "Cách nói 1",
      "text": "送给李老师一杯红茶 nêu người nhận rồi vật được tặng. Phân biệt 给他送茶: 给 đứng trước động từ làm thành phần giới thiệu người nhận.",
      "hanzi": "我送给李老师一杯红茶。",
      "pinyin": "Wǒ sòng gěi Lǐ lǎoshī yì bēi hóngchá.",
      "meaning": "Tôi tặng thầy Lý một cốc trà đen.",
      "readingMinutes": 1
    },
    {
      "id": "l240-grammar1",
      "type": "teaching",
      "title": "Cách nói 2",
      "text": "我给他送饭 dùng 给他 để giới thiệu người nhận trước hành động 送饭. Không đồng nhất vị trí này với chuỗi 送给他.",
      "hanzi": "我给他送饭。",
      "pinyin": "Wǒ gěi tā sòng fàn.",
      "meaning": "Tôi mang cơm cho anh ấy.",
      "readingMinutes": 1
    },
    {
      "id": "l240-grammar2",
      "type": "teaching",
      "title": "Cách nói 3",
      "text": "工作是帮忙送饭 giải thích công việc là gì. 是 nối chủ thể với nội dung định danh/giải thích, không diễn tả hành động đang diễn ra.",
      "hanzi": "我的工作是帮忙送饭。",
      "pinyin": "Wǒ de gōngzuò shì bāngmáng sòng fàn.",
      "meaning": "Công việc của tôi là giúp mang cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l240-grammar3",
      "type": "teaching",
      "title": "Cách nói 4",
      "text": "还是先做好现在的工作吧 thể hiện lời khuyên sau cân nhắc. Không dùng ví dụ này để coi các nghĩa 都2/就2 trong cùng dòng nguồn đã được dạy đầy đủ. 先 và 把 trong đoạn là hỗ trợ HSK3, không kiểm tra cấu trúc 把 ở đây.",
      "hanzi": "还是先做好现在的工作吧。",
      "pinyin": "Háishi xiān zuò hǎo xiànzài de gōngzuò ba.",
      "meaning": "Trước hết hãy làm tốt công việc hiện tại.",
      "readingMinutes": 1
    },
    {
      "id": "l240-scene",
      "type": "teaching",
      "title": "Tình huống mới",
      "text": "Đọc trao đổi về vai trò công việc, đối tượng nhận đồ và lời nhờ.",
      "hanzi": "小李：请介绍一下你的工作。小王：我在饭馆工作，常常帮忙送饭。今天我送给李老师一杯红茶。小李：你希望做什么？小王：我希望以后教中文。现在还是把工作做好吧。",
      "pinyin": "Xiǎo Lǐ: Qǐng jièshào yíxià nǐ de gōngzuò. Xiǎo Wáng: Wǒ zài fànguǎn gōngzuò, chángcháng bāngmáng sòng fàn. Jīntiān wǒ sòng gěi Lǐ lǎoshī yì bēi hóngchá. Xiǎo Lǐ: Nǐ xīwàng zuò shénme? Xiǎo Wáng: Wǒ xīwàng yǐhòu jiāo Zhōngwén. Xiànzài háishi bǎ gōngzuò zuò hǎo ba.",
      "meaning": "Lý nhờ giới thiệu công việc. Vương làm ở quán, hay giúp mang cơm. Hôm nay bạn tặng thầy Lý cốc trà đen. Khi được hỏi mong muốn, Vương nói muốn dạy tiếng Trung sau này, hiện tại nên làm tốt công việc.",
      "readingMinutes": 2
    },
