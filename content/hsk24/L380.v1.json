  "blocks": [
    {
      "id": "l380-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 内容 nèiróng: nội dung; 做出 zuò chū: đưa ra/thực hiện; 不等于 bù děngyú: không bằng/không đồng nghĩa. So sánh cùng tiêu chí, không suy rộng từ một thuộc tính.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l380-t0",
      "type": "teaching",
      "title": "比如 · ví dụ/chẳng hạn",
      "text": "比如 dẫn ví dụ cho nhóm đã nói, không tự liệt kê hết. 比如网球 không có nghĩa chỉ có tennis trong mọi thể thao.",
      "hanzi": "我喜欢体育，比如网球。",
      "pinyin": "Wǒ xǐhuan tǐyù, bǐrú wǎngqiú.",
      "meaning": "Tôi thích thể thao, chẳng hạn tennis.",
      "readingMinutes": 1
    },
    {
      "id": "l380-t1",
      "type": "teaching",
      "title": "不同 · khác nhau",
      "text": "不同 nêu khác theo tiêu chí cần chỉ rõ; 两本书内容不同 không tự nói giá khác. Pinyin nguồn tách hai từ vẫn giữ mục từ này.",
      "hanzi": "这两本书的内容不同。",
      "pinyin": "Zhè liǎng běn shū de nèiróng bù tóng.",
      "meaning": "Nội dung hai sách này khác nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l380-t2",
      "type": "teaching",
      "title": "其他 · khác/còn lại",
      "text": "其他 + danh từ chỉ nhóm còn lại theo phạm vi như 其他书; 不 tự là mọi sách trên đời. 不同 đánh giá khác, 其他 chỉ phần còn lại.",
      "hanzi": "我想再看看其他书。",
      "pinyin": "Wǒ xiǎng zài kànkan qítā shū.",
      "meaning": "Tôi muốn xem thêm sách khác.",
      "readingMinutes": 1
    },
    {
      "id": "l380-t3",
      "type": "teaching",
      "title": "选 · chọn (dạng một chữ)",
      "text": "选 là chọn một phương án/người/vật; 选择 cũng có thể là động từ, nên đề chỉ truy hồi đúng dạng một chữ. Chọn chưa tự mua.",
      "hanzi": "我选蓝色的。",
      "pinyin": "Wǒ xuǎn lánsè de.",
      "meaning": "Tôi chọn chiếc màu xanh lam.",
      "readingMinutes": 1
    },
    {
      "id": "l380-t4",
      "type": "teaching",
      "title": "选择 · lựa chọn (động từ/danh từ)",
      "text": "选择 có thể là chọn hoặc sự lựa chọn; 做出选择 là đưa lựa chọn, 不 phải mọi lựa chọn đều đã thực hiện. Dạng hai chữ gần 选 khi là động từ.",
      "hanzi": "我们还有别的选择。",
      "pinyin": "Wǒmen hái yǒu bié de xuǎnzé.",
      "meaning": "Chúng ta còn lựa chọn khác.",
      "readingMinutes": 1
    },
    {
      "id": "l380-t5",
      "type": "teaching",
      "title": "一样 · giống nhau/cùng",
      "text": "一样 nói giống theo tiêu chí nêu: 一样大 là cùng cỡ. Không suy từ cùng cỡ ra cùng nội dung/giá.",
      "hanzi": "这两本书一样大。",
      "pinyin": "Zhè liǎng běn shū yíyàng dà.",
      "meaning": "Hai sách này cùng kích cỡ.",
      "readingMinutes": 1
    },
    {
      "id": "l380-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "A跟B一样大 so cùng kích cỡ; A跟B一样 có thể cần ngữ cảnh tiêu chí. Không biến cùng màu thành giống mọi đặc tính. 比如 đưa ví dụ chứ không liệt kê toàn bộ tập hợp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l380-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林选书，比如先看有故事的。两本书一样大，内容却不同。他再看看其他书，最后做出选择，但还没买。朋友说：大小一样不等于内容和价格都一样。",
      "pinyin": "Xiǎo Lín xuǎn shū, bǐrú xiān kàn yǒu gùshi de. Liǎng běn shū yíyàng dà, nèiróng què bù tóng. Tā zài kànkan qítā shū, zuìhòu zuò chū xuǎnzé, dàn hái méi mǎi. Péngyou shuō: Dàxiǎo yíyàng bù děngyú nèiróng hé jiàgé dōu yíyàng.",
      "meaning": "Lâm chọn sách, chẳng hạn xem loại có truyện. Hai sách cùng cỡ nhưng khác nội dung; cậu xem thêm rồi chọn, chưa mua. Cùng cỡ chưa là giống nội dung và giá.",
      "readingMinutes": 2
    },
    {
