  "blocks": [
    {
      "id": "l109-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l109-t0",
      "type": "teaching",
      "title": "一 · một",
      "text": "一 đứng riêng ghi yī; không lấy âm yí/yì trong cụm thay pinyin từ điển.",
      "hanzi": "一、二、三。",
      "pinyin": "Yī, èr, sān.",
      "meaning": "Một, hai, ba.",
      "readingMinutes": 1
    },
    {
      "id": "l109-t1",
      "type": "teaching",
      "title": "二 · hai (số đếm)",
      "text": "二 dùng trong chuỗi đếm; 两 là dạng khác sẽ học khi đếm đồ vật.",
      "hanzi": "二、三、四。",
      "pinyin": "Èr, sān, sì.",
      "meaning": "Hai, ba, bốn.",
      "readingMinutes": 1
    },
    {
      "id": "l109-t2",
      "type": "teaching",
      "title": "三 · ba",
      "text": "三 gồm ba nét ngang; đừng nhầm với 二 khi nhận diện chữ.",
      "hanzi": "三、四、五。",
      "pinyin": "Sān, sì, wǔ.",
      "meaning": "Ba, bốn, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l109-t3",
      "type": "teaching",
      "title": "四 · bốn",
      "text": "四 đọc sì, không phải shì của 是; đây là hai âm và hai chữ khác.",
      "hanzi": "四、五。",
      "pinyin": "Sì, wǔ.",
      "meaning": "Bốn, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l109-t4",
      "type": "teaching",
      "title": "五 · năm",
      "text": "五 là số năm; phân biệt với 我 wǒ đã học.",
      "hanzi": "一、二、三、四、五。",
      "pinyin": "Yī, èr, sān, sì, wǔ.",
      "meaning": "Một, hai, ba, bốn, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l109-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一二三四五 là số đếm từ một đến năm. Trong bài đếm thành tiếng/đọc thẻ số, số có thể đứng riêng; không cần 是. Khi đi với danh từ thường cần lượng từ, sẽ học ở nhóm đồ vật. 一 đứng riêng đọc yī; biến điệu trong cụm sẽ được nhắc ở ví dụ cụ thể.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l109-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：一、二、三、四、五。\nB：三？\nA：三。\nB：好，谢谢！",
      "pinyin": "A: Yī, èr, sān, sì, wǔ. B: Sān? A: Sān. B: Hǎo, xiè xie!",
      "meaning": "A đọc chuỗi một đến năm. B hỏi lại số ba và A xác nhận đúng số đó; đây là luyện đọc chữ số, chưa đánh giá nghe.",
      "readingMinutes": 2
    },
