  "blocks": [
    {
      "id": "l135-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l135-t0",
      "type": "teaching",
      "title": "医生 · bác sĩ",
      "text": "医生 không tự chỉ giới tính; câu đang giới thiệu nghề trong tình huống hư cấu.",
      "hanzi": "她是医生。",
      "pinyin": "Tā shì yī shēng.",
      "meaning": "Cô ấy là bác sĩ.",
      "readingMinutes": 1
    },
    {
      "id": "l135-t1",
      "type": "teaching",
      "title": "医院 · bệnh viện",
      "text": "医院 là nơi; không dùng 她是医院 để giới thiệu bác sĩ.",
      "hanzi": "我去医院。",
      "pinyin": "Wǒ qù yī yuàn.",
      "meaning": "Tôi đến bệnh viện.",
      "readingMinutes": 1
    },
    {
      "id": "l135-t2",
      "type": "teaching",
      "title": "先生 · ông; anh (xưng hô lịch sự)",
      "text": "先生 sau tên gọi người nam theo cách xưng hô đã xác định; không đoán chỉ dựa vào tên 林.",
      "hanzi": "林先生，您好！",
      "pinyin": "Lín xiān sheng, nín hǎo!",
      "meaning": "Chào ông/anh Lâm!",
      "readingMinutes": 1
    },
    {
      "id": "l135-t3",
      "type": "teaching",
      "title": "女士 · bà; cô; chị (xưng hô lịch sự)",
      "text": "女士 là cách xưng hô lịch sự với người nữ theo tình huống; tên 安 chỉ minh họa.",
      "hanzi": "安女士，您好！",
      "pinyin": "Ān nǚ shì, nín hǎo!",
      "meaning": "Chào bà/chị An!",
      "readingMinutes": 1
    },
    {
      "id": "l135-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "医生 là nghề, 医院 là nơi; 她是医生 và 她在医院工作 có vai trò khác nhau. 先生/女士 là cách xưng hô lịch sự theo thông tin được nêu, không đoán từ tên. Nêu tên nghề không tự xác nhận giấy phép hoặc trình độ một người thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l135-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：安女士是老师吗？\nB：不是，她是医生。\nA：她在哪儿工作？\nB：在医院工作。",
      "pinyin": "A: Ān nǚ shì shì lǎo shī ma? B: Bú shì, tā shì yī shēng. A: Tā zài nǎr gōng zuò? B: Zài yī yuàn gōng zuò.",
      "meaning": "Đoạn nói rõ An là bác sĩ và làm ở bệnh viện; không suy nghề từ cách xưng hô hoặc tên.",
      "readingMinutes": 2
    },
