  "blocks": [
    {
      "id": "l108-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l108-t0",
      "type": "teaching",
      "title": "哥哥 · anh trai",
      "text": "哥哥 chỉ anh trai lớn hơn mình trong quan hệ gia đình ở bài.",
      "hanzi": "我哥哥叫安。",
      "pinyin": "Wǒ gē ge jiào Ān.",
      "meaning": "Anh trai tôi tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l108-t1",
      "type": "teaching",
      "title": "姐姐 · chị gái",
      "text": "姐姐 là chị gái lớn hơn người có quan hệ được nói đến.",
      "hanzi": "她是我姐姐。",
      "pinyin": "Tā shì wǒ jiě jie.",
      "meaning": "Cô ấy là chị gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l108-t2",
      "type": "teaching",
      "title": "弟弟 · em trai",
      "text": "弟弟 là em trai nhỏ tuổi hơn, không phải mọi người đàn ông trẻ.",
      "hanzi": "他是我弟弟。",
      "pinyin": "Tā shì wǒ dì di.",
      "meaning": "Cậu ấy là em trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l108-t3",
      "type": "teaching",
      "title": "妹妹 · em gái",
      "text": "妹妹 chỉ em gái; cần biết quan hệ, không đoán từ tên.",
      "hanzi": "我妹妹喜欢茶。",
      "pinyin": "Wǒ mèi mei xǐ huan chá.",
      "meaning": "Em gái tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l108-t4",
      "type": "teaching",
      "title": "儿子 · con trai",
      "text": "儿子 nói quan hệ con trai với cha/mẹ, không nói thứ tự anh em.",
      "hanzi": "他是我儿子。",
      "pinyin": "Tā shì wǒ ér zi.",
      "meaning": "Cậu ấy là con trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l108-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Anh chị em được gọi theo quan hệ với người nói và thứ tự tuổi: 哥哥/姐姐 lớn hơn, 弟弟/妹妹 nhỏ hơn. 儿子 là con trai của ai, không đồng nghĩa 弟弟. Các danh từ này làm chủ thể hoặc phần sau 是 trong câu giới thiệu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l108-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：他是你弟弟吗？\nB：不是，他是我哥哥。\nA：她呢？\nB：她是我妹妹。",
      "pinyin": "A: Tā shì nǐ dì di ma? B: Bú shì, tā shì wǒ gē ge. A: Tā ne? B: Tā shì wǒ mèi mei.",
      "meaning": "B sửa cách gọi của A: người nam là anh trai B; người nữ được nhắc sau là em gái B.",
      "readingMinutes": 2
    },
