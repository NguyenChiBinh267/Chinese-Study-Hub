  "blocks": [
    {
      "id": "l136-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l136-t0",
      "type": "teaching",
      "title": "病 · bệnh; sự ốm đau",
      "text": "病 trong 没有病 là danh từ; không suy tình trạng sức khỏe người học từ câu mẫu.",
      "hanzi": "我没有病。",
      "pinyin": "Wǒ méi yǒu bìng.",
      "meaning": "Tôi không có bệnh.",
      "readingMinutes": 1
    },
    {
      "id": "l136-t1",
      "type": "teaching",
      "title": "生病 · bị ốm; bị bệnh",
      "text": "生病 là bị ốm; không hiểu thành việc sinh ra một vật tên bệnh.",
      "hanzi": "她生病了。",
      "pinyin": "Tā shēng bìng le.",
      "meaning": "Cô ấy bị ốm rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l136-t2",
      "type": "teaching",
      "title": "看病 · đi khám; khám bệnh",
      "text": "看病 trong 我去医院看病 nói đi khám; câu không tự cho biết bệnh gì hay kết quả khám.",
      "hanzi": "我去医院看病。",
      "pinyin": "Wǒ qù yī yuàn kàn bìng.",
      "meaning": "Tôi đến bệnh viện khám bệnh.",
      "readingMinutes": 1
    },
    {
      "id": "l136-t3",
      "type": "teaching",
      "title": "休息 · nghỉ ngơi",
      "text": "休息 dùng trong giờ nghỉ hoặc nghỉ việc đang làm; âm 息 nhẹ trong mục từ.",
      "hanzi": "下课了，请休息。",
      "pinyin": "Xià kè le, qǐng xiū xi.",
      "meaning": "Hết tiết rồi, xin nghỉ ngơi.",
      "readingMinutes": 1
    },
    {
      "id": "l136-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "生病 nói bị ốm; 看病 nói đi khám/chữa bệnh theo tình huống, không phải chỉ nhìn một vật tên 病. 病 có thể là danh từ bệnh. 休息 là nghỉ ngơi; các câu chỉ luyện ngôn ngữ, không chẩn đoán hoặc hướng dẫn điều trị cho người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l136-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你去哪儿？\nB：我去医院看病。\nA：你生病了吗？\nB：生病了，我想休息。",
      "pinyin": "A: Nǐ qù nǎr? B: Wǒ qù yī yuàn kàn bìng. A: Nǐ shēng bìng le ma? B: Shēng bìng le, wǒ xiǎng xiū xi.",
      "meaning": "Nhân vật B nói mình bị ốm và muốn nghỉ. Đây là hội thoại viết hư cấu, không có dữ kiện để chẩn đoán bệnh cụ thể.",
      "readingMinutes": 2
    },
