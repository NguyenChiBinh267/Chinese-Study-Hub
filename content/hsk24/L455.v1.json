  "blocks": [
    {
      "id": "l455-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 演出 yǎnchū: buổi diễn; 唱腔 chàngqiāng: lối/giọng hát; 服装 fúzhuāng: trang phục; 完整 wánzhěng: hoàn chỉnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l455-t0",
      "type": "teaching",
      "title": "京剧 · kinh kịch",
      "text": "京剧 là một loại hình sân khấu Trung Quốc; không dùng thay cho mọi hí kịch. Nhận diện chữ 剧 trong 京剧; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她第一次看京剧。",
      "pinyin": "Tā dì yī cì kàn Jīngjù.",
      "meaning": "Cô lần đầu xem kinh kịch.",
      "readingMinutes": 1
    },
    {
      "id": "l455-t1",
      "type": "teaching",
      "title": "剧院 · nhà hát",
      "text": "剧院 là địa điểm biểu diễn; 电影院 thường là rạp phim.",
      "hanzi": "剧院门口有演出介绍。",
      "pinyin": "Jùyuàn ménkǒu yǒu yǎnchū jièshào.",
      "meaning": "Cửa nhà hát có giới thiệu buổi diễn.",
      "readingMinutes": 1
    },
    {
      "id": "l455-t2",
      "type": "teaching",
      "title": "精彩 · đặc sắc, hấp dẫn",
      "text": "精彩 khen nội dung/biểu diễn nổi bật; không chỉ màu sắc đẹp.",
      "hanzi": "这场演出很精彩。",
      "pinyin": "Zhè chǎng yǎnchū hěn jīngcǎi.",
      "meaning": "Buổi diễn này đặc sắc.",
      "readingMinutes": 1
    },
    {
      "id": "l455-t3",
      "type": "teaching",
      "title": "举办 · tổ chức",
      "text": "举办 thường đi với 活动、比赛、展览; ở đây là hoạt động giới thiệu.",
      "hanzi": "剧院举办了介绍活动。",
      "pinyin": "Jùyuàn jǔbàn le jièshào huódòng.",
      "meaning": "Nhà hát tổ chức hoạt động giới thiệu.",
      "readingMinutes": 1
    },
    {
      "id": "l455-t4",
      "type": "teaching",
      "title": "举行 · diễn ra, tổ chức",
      "text": "举行 tập trung việc sự kiện được tiến hành; nhiều ngữ cảnh gần 举办, bài giới hạn hình thức.",
      "hanzi": "活动在周六举行。",
      "pinyin": "Huódòng zài Zhōuliù jǔxíng.",
      "meaning": "Hoạt động diễn ra thứ bảy.",
      "readingMinutes": 1
    },
    {
      "id": "l455-t5",
      "type": "teaching",
      "title": "美 · đẹp",
      "text": "美 là tính từ tả vẻ đẹp, có thể nói 唱腔很美; chưa bao quát mọi nghĩa khác.",
      "hanzi": "演员的服装很美。",
      "pinyin": "Yǎnyuán de fúzhuāng hěn měi.",
      "meaning": "Trang phục diễn viên đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l455-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "甚至 đưa trường hợp ở mức cao hơn hoặc gây bất ngờ: 大家很喜欢，甚至有人看了两遍. Không chỉ nối hai việc bất kỳ. Cần ngữ cảnh yêu thích làm nền cho mức độ xem lại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l455-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "剧院举办京剧介绍活动，周六下午举行。工作人员先解释唱腔和服装，再请大家看一小段演出。小苏觉得服装很美，演出也精彩。大家很喜欢，甚至有人看了两遍。她决定下次先读故事介绍，再来看完整的演出。",
      "pinyin": "Jùyuàn jǔbàn Jīngjù jièshào huódòng, Zhōuliù xiàwǔ jǔxíng. Gōngzuò rényuán xiān jiěshì chàngqiāng hé fúzhuāng, zài qǐng dàjiā kàn yì xiǎo duàn yǎnchū. Xiǎo Sū juéde fúzhuāng hěn měi, yǎnchū yě jīngcǎi. Dàjiā hěn xǐhuan, shènzhì yǒu rén kàn le liǎng biàn. Tā juédìng xià cì xiān dú gùshi jièshào, zài lái kàn wánzhěng de yǎnchū.",
      "meaning": "Nhà hát giới thiệu kinh kịch chiều thứ bảy. Khán giả được giải thích giọng hát và trang phục trước khi xem trích đoạn. Có người thích đến mức xem hai lần. Tô định đọc cốt truyện trước lần tới.",
      "readingMinutes": 2
    },
