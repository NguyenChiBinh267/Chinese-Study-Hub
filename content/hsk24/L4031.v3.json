  "blocks": [
    {
      "id": "l4031-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t0",
      "type": "teaching",
      "title": "心 · lòng; trái tim",
      "text": "心 ở 记在心里 chỉ tâm trí, không phải vị trí trong phòng.",
      "hanzi": "我把这句话记在心里。",
      "pinyin": "Wǒ bǎ zhè jù huà jì zài xīn lǐ.",
      "meaning": "Tôi ghi nhớ câu này trong lòng.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t1",
      "type": "teaching",
      "title": "心情 · tâm trạng",
      "text": "心情 là trạng thái cảm xúc ở một thời điểm.",
      "hanzi": "她今天心情很好。",
      "pinyin": "Tā jīn tiān xīn qíng hěn hǎo.",
      "meaning": "Hôm nay cô ấy có tâm trạng tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t2",
      "type": "teaching",
      "title": "信心 · sự tự tin; niềm tin",
      "text": "信心 thường đi với 有、增强, không phải thông tin.",
      "hanzi": "练习以后，我更有信心。",
      "pinyin": "Liàn xí yǐ hòu, wǒ gèng yǒu xìn xīn.",
      "meaning": "Sau luyện tập tôi tự tin hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t3",
      "type": "teaching",
      "title": "兴奋 · phấn khởi; hào hứng",
      "text": "兴奋 nói cảm xúc kích động vui mừng trong ngữ cảnh. Nhận diện chữ 奋 trong 兴奋; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "听到好消息，他很兴奋。",
      "pinyin": "Tīng dào hǎo xiāo xi, tā hěn xīng fèn.",
      "meaning": "Nghe tin vui anh ấy rất phấn khởi.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t4",
      "type": "teaching",
      "title": "醒 · tỉnh; thức giấc",
      "text": "醒 đối lập trạng thái ngủ, không phải chỉ rời giường.",
      "hanzi": "我今天醒得很早。",
      "pinyin": "Wǒ jīn tiān xǐng de hěn zǎo.",
      "meaning": "Hôm nay tôi tỉnh giấc rất sớm.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-t5",
      "type": "teaching",
      "title": "也许 · có lẽ",
      "text": "也许 chỉ khả năng, không khẳng định chắc chắn.",
      "hanzi": "也许下午会下雨。",
      "pinyin": "Yě xǔ xià wǔ huì xià yǔ.",
      "meaning": "Có lẽ chiều sẽ mưa.",
      "readingMinutes": 1
    },
    {
      "id": "l4031-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "就是…也… đặt tình huống nhượng bộ: ngay cả nếu căng thẳng, vẫn thử nói. Đây là lời động viên trong truyện, không bảo đảm kết quả thực tế.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4031-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小陈醒得很早，心情有点儿紧张。朋友说：“也许你会紧张，但就是紧张，也可以先说一句。”小陈把话记在心里。练习后，他有了信心，想到见新朋友又很兴奋。",
      "pinyin": "Xiǎo Chén xǐng de hěn zǎo, xīn qíng yǒu diǎnr jǐn zhāng. Péng you shuō: “Yě xǔ nǐ huì jǐn zhāng, dàn jiù shì jǐn zhāng, yě kě yǐ xiān shuō yí jù.” Xiǎo Chén bǎ huà jì zài xīn lǐ. Liàn xí hòu, tā yǒu le xìn xīn, xiǎng dào jiàn xīn péng you yòu hěn xīng fèn.",
      "meaning": "Bạn khuyên Tiểu Trần bắt đầu bằng một câu dù còn hồi hộp.",
      "readingMinutes": 2
    },
    {
