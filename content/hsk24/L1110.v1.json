  "blocks": [
    {
      "id": "l1110-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1110-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "再 + động từ trong 请再读一下 yêu cầu đọc thêm một lượt. Đặt 再 trước cụm hành động trong mẫu; không đảo thành 读再. Chữ 在 cùng âm zài có chức năng khác, như 在学校 chỉ nơi chốn hoặc 在读书 chỉ đang đọc. Nếu chỉ nghe âm zài riêng lẻ thì chưa đủ chọn chữ; phải xét nghĩa và vị trí.",
      "hanzi": "请再读一下。",
      "pinyin": "Qǐng zài dú yí xià.",
      "meaning": "Xin đọc lại một lượt.",
      "readingMinutes": 3
    },
    {
      "id": "l1110-reminder0",
      "type": "teaching",
      "title": "再 · lại; thêm lần nữa (dạng zài)",
      "text": "Nhắc nghĩa đã học: lại; thêm lần nữa (dạng zài). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "请再说。",
      "pinyin": "Qǐng zài shuō.",
      "meaning": "Xin nói lại.",
      "readingMinutes": 1
    },
    {
      "id": "l1110-reminder1",
      "type": "teaching",
      "title": "读 · đọc",
      "text": "Nhắc nghĩa đã học: đọc. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "你读哪本书？",
      "pinyin": "Nǐ dú nǎ běn shū?",
      "meaning": "Bạn đọc quyển sách nào?",
      "readingMinutes": 1
    },
    {
      "id": "l1110-reminder2",
      "type": "teaching",
      "title": "说 · nói",
      "text": "Nhắc nghĩa đã học: nói. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我说汉语。",
      "pinyin": "Wǒ shuō Hàn yǔ.",
      "meaning": "Tôi nói tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l1110-reminder3",
      "type": "teaching",
      "title": "一下 · một chút; một lượt ngắn (dạng yíxià)",
      "text": "Nhắc nghĩa đã học: một chút; một lượt ngắn (dạng yíxià). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "请读一下这个字。",
      "pinyin": "Qǐng dú yí xià zhè ge zì.",
      "meaning": "Xin đọc chữ này một chút/một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l1110-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：我没有听见，请再说。\nB：好，我明天去学校。\nA：谢谢。",
      "pinyin": "A: Wǒ méi yǒu tīng jiàn, qǐng zài shuō. B: Hǎo, wǒ míng tiān qù xué xiào. A: Xiè xie.",
      "meaning": "A chưa nghe thấy nên nhờ nói thêm một lượt; B nói lại kế hoạch đi học ngày mai. Đọc văn bản không chứng minh người học đã nghe được audio.",
      "readingMinutes": 2
