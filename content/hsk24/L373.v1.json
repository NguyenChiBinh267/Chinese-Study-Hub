  "blocks": [
    {
      "id": "l373-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 偷 tōu: lấy trộm; 联系 liánxì: liên hệ; 确认 quèrèn: xác nhận; 想起 xiǎng qǐ: nhớ ra. Không suy ra ai làm sai chỉ từ mất dấu đồ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l373-t0",
      "type": "teaching",
      "title": "把 · đem/đưa đối tượng ra trước động từ; lượng từ tùy câu",
      "text": "把 trong 我把书拿走了 là giới từ xử trí; 一把伞 là lượng từ. Cả hai được đối chiếu, không dùng 把+đồ+động từ trần khi mẫu cần kết quả.",
      "hanzi": "我把书放在桌上。",
      "pinyin": "Wǒ bǎ shū fàng zài zhuō shàng.",
      "meaning": "Tôi đặt sách trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l373-t1",
      "type": "teaching",
      "title": "被 · bị/được (dấu câu bị động)",
      "text": "被 đưa tác nhân sau đối tượng nhận tác động; 书被同学拿走了 không nói sách tự mang đi. Chưa luyện mọi dạng bị động bỏ tác nhân.",
      "hanzi": "书被同学拿走了。",
      "pinyin": "Shū bèi tóngxué ná zǒu le.",
      "meaning": "Sách bị bạn học mang đi.",
      "readingMinutes": 1
    },
    {
      "id": "l373-t2",
      "type": "teaching",
      "title": "分开 · tách ra/chia ra",
      "text": "分开 nêu tách người/vật, khác 分别 là lần lượt/tương ứng ở ngữ cảnh khác. 分开走 nói đi riêng, không tự là tuyệt giao.",
      "hanzi": "请把新旧书分开。",
      "pinyin": "Qǐng bǎ xīn jiù shū fēnkāi.",
      "meaning": "Hãy tách sách mới với sách cũ.",
      "readingMinutes": 1
    },
    {
      "id": "l373-t3",
      "type": "teaching",
      "title": "不见 · mất dấu/không thấy",
      "text": "不见 trong 书不见了 là không thấy/mất dấu; không tự chứng minh trộm cắp. Pinyin nguồn bú do biến điệu trước jiàn.",
      "hanzi": "我的书不见了。",
      "pinyin": "Wǒ de shū bú jiàn le.",
      "meaning": "Tôi không thấy sách đâu nữa.",
      "readingMinutes": 1
    },
    {
      "id": "l373-t4",
      "type": "teaching",
      "title": "突然 · đột nhiên/bất ngờ",
      "text": "突然 có thể trước động từ hoặc mô tả sự việc bất ngờ; 突然发现 nói chợt nhận ra, không phải việc mới bắt đầu tồn tại.",
      "hanzi": "他突然想起书在哪里。",
      "pinyin": "Tā tūrán xiǎng qǐ shū zài nǎli.",
      "meaning": "Cậu ấy chợt nhớ sách ở đâu.",
      "readingMinutes": 1
    },
    {
      "id": "l373-t5",
      "type": "teaching",
      "title": "遇到 · gặp (người/sự việc)",
      "text": "遇到 có thể gặp người hoặc gặp vấn đề; khác 见面 thường là gặp mặt có chủ thể hai bên. 遇到问题不等于问题已解决.",
      "hanzi": "我遇到了一个问题。",
      "pinyin": "Wǒ yùdào le yí ge wèntí.",
      "meaning": "Tôi gặp một vấn đề.",
      "readingMinutes": 1
    },
    {
      "id": "l373-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "我把书拿走了 lấy người thực hiện làm chủ thể; 书被我拿走了 lấy sách nhận tác động làm chủ thể. Kết quả giống trong cảnh này nhưng trọng tâm khác; 不见了 chỉ mất dấu, chưa biết ai lấy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l373-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林把新旧书分开，后来发现一本书不见了。他没有说一定被人偷了。遇到这个问题以后，他突然想起同学说过借书。原来书被同学借走了；他先联系同学确认。",
      "pinyin": "Xiǎo Lín bǎ xīn jiù shū fēnkāi, hòulái fāxiàn yì běn shū bú jiàn le. Tā méiyǒu shuō yídìng bèi rén tōu le. Yùdào zhège wèntí yǐhòu, tā tūrán xiǎng qǐ tóngxué shuō guo jiè shū. Yuánlái shū bèi tóngxué jiè zǒu le; tā xiān liánxì tóngxué quèrèn.",
      "meaning": "Lâm tách sách mới cũ, không thấy một cuốn nhưng chưa kết luận bị trộm. Cậu chợt nhớ bạn từng hỏi mượn và liên lạc xác nhận sách được bạn mượn.",
      "readingMinutes": 2
    },
    {
