  "blocks": [
    {
      "id": "l1176-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1176-reminder0",
      "type": "teaching",
      "title": "千 · nghìn",
      "text": "Từ đã học 千 có 1 chữ. Chữ 千 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 千 với 干 / 于 / 十; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "一千元。",
      "pinyin": "Yì qiān yuán.",
      "meaning": "Một nghìn nguyên trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l1176-reminder1",
      "type": "teaching",
      "title": "百 · trăm",
      "text": "Từ đã học 百 có 1 chữ. Chữ 百 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 百 với 白 / 自 / 目; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "一百元。",
      "pinyin": "Yì bǎi yuán.",
      "meaning": "Một trăm nguyên trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l1176-reminder2",
      "type": "teaching",
      "title": "出租车 · taxi; xe cho thuê chở khách",
      "text": "Từ đã học 出租车 có 3 chữ. Chữ 出 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 出 với 山 / 击 / 凹; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我坐出租车。",
      "pinyin": "Wǒ zuò chū zū chē.",
      "meaning": "Tôi đi taxi.",
      "readingMinutes": 1
    },
    {
      "id": "l1176-reminder3",
      "type": "teaching",
      "title": "火车 · tàu hỏa; xe lửa",
      "text": "Từ đã học 火车 có 2 chữ. Chữ 火 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 火 với 人 / 灭 / 大; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我坐火车去学校。",
      "pinyin": "Wǒ zuò huǒ chē qù xué xiào.",
      "meaning": "Tôi đi tàu hỏa đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l1176-reminder4",
      "type": "teaching",
      "title": "飞机 · máy bay",
      "text": "Từ đã học 飞机 có 2 chữ. Chữ 飞 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 飞 với 风 / 凡 / 乙; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
