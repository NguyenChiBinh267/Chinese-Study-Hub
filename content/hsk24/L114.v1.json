  "blocks": [
    {
      "id": "l114-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l114-t0",
      "type": "teaching",
      "title": "爱 · yêu; yêu thương",
      "text": "爱 trong 我爱我的家人 diễn tả tình yêu thương; bản dịch cần theo đối tượng.",
      "hanzi": "我爱我的家人。",
      "pinyin": "Wǒ ài wǒ de jiā rén.",
      "meaning": "Tôi yêu thương gia đình tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l114-t1",
      "type": "teaching",
      "title": "男朋友 · bạn trai (quan hệ tình cảm)",
      "text": "男朋友 ở bài này là người yêu nam; muốn nói người bạn nam thông thường cần diễn đạt phù hợp khác.",
      "hanzi": "他是我男朋友。",
      "pinyin": "Tā shì wǒ nán péng you.",
      "meaning": "Anh ấy là bạn trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l114-t2",
      "type": "teaching",
      "title": "女朋友 · bạn gái (quan hệ tình cảm)",
      "text": "女朋友 trong câu là người yêu nữ, không tự hiểu mọi 朋友 nữ là 女朋友.",
      "hanzi": "她是我女朋友。",
      "pinyin": "Tā shì wǒ nǚ péng you.",
      "meaning": "Cô ấy là bạn gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l114-t3",
      "type": "teaching",
      "title": "他们 · họ (nhóm nam hoặc gồm nam nữ)",
      "text": "他们 chỉ nhóm người đã rõ trong ngữ cảnh; không dùng chữ này để khẳng định nhóm toàn nữ.",
      "hanzi": "他们是我的朋友。",
      "pinyin": "Tā men shì wǒ de péng you.",
      "meaning": "Họ là bạn của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l114-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "她们 chỉ nhóm nữ theo thông tin đã biết. 男朋友/女朋友 thường chỉ bạn trai/bạn gái trong quan hệ tình cảm, khác 朋友. Đừng suy quan hệ từ việc hai người cùng có mặt. 爱 trong ví dụ nói tình cảm với gia đình; không tự gán nghĩa sở thích nhẹ của 喜欢 cho mọi câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l114-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：她是你女朋友吗？\nB：不是，她是我姐姐。\nA：她叫什么名字？\nB：她叫林。",
      "pinyin": "A: Tā shì nǐ nǚ péng you ma? B: Bú shì, tā shì wǒ jiě jie. A: Tā jiào shén me míng zi? B: Tā jiào Lín.",
      "meaning": "B bác bỏ quan hệ bạn gái và xác nhận đó là chị gái. Không lấy lời hỏi của A làm sự thật.",
      "readingMinutes": 2
    },
