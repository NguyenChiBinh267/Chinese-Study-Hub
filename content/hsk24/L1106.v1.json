  "blocks": [
    {
      "id": "l1106-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1106-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Có thể nhấn hành động đang diễn ra bằng 在/正在 + động từ + 呢: 妈妈正在做饭呢. 呢 trong câu này không hỏi lại người khác như 你呢. Đặt 呢 cuối câu mô tả hành động; không đưa nó trước động từ. 在 ở đây đi với hành động, khác 在 + nơi chốn. Việc có 呢 không tự cho biết hành động kéo dài bao lâu.",
      "hanzi": "妈妈正在做饭呢。",
      "pinyin": "Mā ma zhèng zài zuò fàn ne.",
      "meaning": "Mẹ đang nấu ăn đấy.",
      "readingMinutes": 3
    },
    {
      "id": "l1106-reminder0",
      "type": "teaching",
      "title": "正在 · đang (dạng zhèngzài)",
      "text": "Nhắc nghĩa đã học: đang (dạng zhèngzài). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我正在看电视。",
      "pinyin": "Wǒ zhèng zài kàn diàn shì.",
      "meaning": "Tôi đang xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l1106-reminder1",
      "type": "teaching",
      "title": "做饭 · nấu ăn (dạng zuò fàn)",
      "text": "Nhắc nghĩa đã học: nấu ăn (dạng zuò fàn). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "妈妈正在做饭。",
      "pinyin": "Mā ma zhèng zài zuò fàn.",
      "meaning": "Mẹ đang nấu ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l1106-reminder2",
      "type": "teaching",
      "title": "看 · nhìn; xem (dạng kàn)",
      "text": "Nhắc nghĩa đã học: nhìn; xem (dạng kàn). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我正在看电视。",
      "pinyin": "Wǒ zhèng zài kàn diàn shì.",
      "meaning": "Tôi đang xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l1106-reminder3",
      "type": "teaching",
      "title": "妈妈 · mẹ; má",
      "text": "Nhắc nghĩa đã học: mẹ; má. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我妈妈喜欢茶。",
      "pinyin": "Wǒ mā ma xǐ huan chá.",
      "meaning": "Mẹ tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1106-reading",
