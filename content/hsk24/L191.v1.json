  "blocks": [
    {
      "id": "l191-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder0",
      "type": "teaching",
      "title": "起床 · dậy; ra khỏi giường",
      "text": "Nhắc nghĩa đã học: dậy; ra khỏi giường. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我六点起床。",
      "pinyin": "Wǒ liù diǎn qǐ chuáng.",
      "meaning": "Tôi dậy lúc6giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder1",
      "type": "teaching",
      "title": "分钟 · phút (khoảng thời gian, dạng fēnzhōng)",
      "text": "Nhắc nghĩa đã học: phút (khoảng thời gian, dạng fēnzhōng). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我休息三分钟。",
      "pinyin": "Wǒ xiū xi sān fēn zhōng.",
      "meaning": "Tôi nghỉ ba phút.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder2",
      "type": "teaching",
      "title": "早饭 · bữa sáng",
      "text": "Nhắc nghĩa đã học: bữa sáng. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我想吃早饭。",
      "pinyin": "Wǒ xiǎng chī zǎo fàn.",
      "meaning": "Tôi muốn ăn sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder3",
      "type": "teaching",
      "title": "吃 · ăn",
      "text": "Nhắc nghĩa đã học: ăn. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我不想吃面条儿。",
      "pinyin": "Wǒ bù xiǎng chī miàn tiáor.",
      "meaning": "Tôi không muốn ăn mì sợi.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder4",
      "type": "teaching",
      "title": "饺子 · sủi cảo; bánh chẻo",
      "text": "Nhắc nghĩa đã học: sủi cảo; bánh chẻo. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我和我的朋友吃饺子。",
      "pinyin": "Wǒ hé wǒ de péng you chī jiǎo zi.",
      "meaning": "Tôi và bạn của tôi ăn sủi cảo.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reminder5",
      "type": "teaching",
      "title": "牛奶 · sữa bò",
      "text": "Nhắc nghĩa đã học: sữa bò. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我有牛奶，也有水。",
      "pinyin": "Wǒ yǒu niú nǎi, yě yǒu shuǐ.",
      "meaning": "Tôi có sữa bò, cũng có nước.",
      "readingMinutes": 1
    },
    {
      "id": "l191-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你几点起床？\nB：我六点起床，七点吃早饭。\nA：你吃什么？\nB：我吃饺子，喝牛奶。\nA：好。",
      "pinyin": "A: Nǐ jǐ diǎn qǐ chuáng? B: Wǒ liù diǎn qǐ chuáng, qī diǎn chī zǎo fàn. A: Nǐ chī shén me? B: Wǒ chī jiǎo zi, hē niú nǎi. A: Hǎo.",
      "meaning": "B nêu lịch hư cấu: dậy6giờ, ăn sáng7giờ; món là sủi cảo và sữa bò. Không phải lịch lưu hoặc khuyến nghị chế độ sinh hoạt cho người học.",
      "readingMinutes": 2
    },
