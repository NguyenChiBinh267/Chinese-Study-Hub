  "blocks": [
    {
      "id": "l272-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "电脑 là máy tính (SUPPLEMENTARY: chưa kiểm chứng cấp trong bài); 不要 là đừng. 过 đọc nhẹ khi chỉ kinh nghiệm, khác guò là động từ đi qua/đón một dịp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t0",
      "type": "teaching",
      "title": "Nhắc lại · 打 · chơi một số môn hoặc thao tác trong tổ hợp",
      "text": "打1 trong 打篮球 là động từ chơi bóng rổ. Không tự dùng 打 với mọi môn, ví dụ bóng đá dùng 踢.",
      "hanzi": "我打过篮球。",
      "pinyin": "Wǒ dǎ guo lánqiú.",
      "meaning": "Tôi từng chơi bóng rổ.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t1",
      "type": "teaching",
      "title": "Nhắc lại · 打开 · mở ra, bật mở để sử dụng",
      "text": "打开 trong 打开电脑 là bật/mở máy tính; trong 打开门 là mở cửa. Nghĩa phụ thuộc đối tượng chứ không phải luôn đánh cho mở.",
      "hanzi": "请打开电脑。",
      "pinyin": "Qǐng dǎkāi diànnǎo.",
      "meaning": "Hãy bật máy tính.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t2",
      "type": "teaching",
      "title": "Nhắc lại · 上网 · lên mạng",
      "text": "上网 là sử dụng/kết nối mạng; không tự chứng minh đang học hoặc đang chơi trò gì.",
      "hanzi": "他晚上喜欢上网。",
      "pinyin": "Tā wǎnshang xǐhuan shàngwǎng.",
      "meaning": "Buổi tối anh ấy thích lên mạng.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t3",
      "type": "teaching",
      "title": "Nhắc lại · 网上 · trên mạng",
      "text": "网上 dùng như nơi thông tin/hành động online; 上 trong từ này đọc nhẹ theo nguồn.",
      "hanzi": "我在网上看书。",
      "pinyin": "Wǒ zài wǎngshang kàn shū.",
      "meaning": "Tôi đọc sách trên mạng.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t4",
      "type": "teaching",
      "title": "Nhắc lại · 过 · trợ từ chỉ đã từng",
      "text": "过 đọc nhẹ trong 看过/玩过, tách khỏi động từ 过 guò mục347. Không tự chỉ thời điểm cụ thể hoặc hành động đang diễn ra.",
      "hanzi": "这本书我看过。",
      "pinyin": "Zhè běn shū wǒ kàn guo.",
      "meaning": "Quyển sách này tôi đã từng đọc.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-t5",
      "type": "teaching",
      "title": "Nhắc lại · 没意思 · không thú vị, chán",
      "text": "没意思 ở đây là nhận xét không thú vị của người nói. Không dùng để kết luận ai cũng thấy chán hoặc bản thân người nói không có ý định.",
      "hanzi": "我觉得这个游戏没意思。",
      "pinyin": "Wǒ juéde zhège yóuxì méi yìsi.",
      "meaning": "Tôi thấy trò chơi này không thú vị.",
      "readingMinutes": 1
    },
    {
      "id": "l272-t0-l232-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "Động từ + 过 nói đã từng có kinh nghiệm, như 看过. Chưa nói việc đang diễn ra. 吗 tạo câu hỏi; 没玩过 là chưa từng chơi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l272-t0-l232-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你玩过这个游戏吗？乙：玩过，我觉得没意思。甲：那我们上网看书吧。乙：好，请打开电脑。我在网上看过很多书。",
      "pinyin": "Jiǎ: Nǐ wán guo zhège yóuxì ma? Yǐ: Wán guo, wǒ juéde méi yìsi. Jiǎ: Nà wǒmen shàngwǎng kàn shū ba. Yǐ: Hǎo, qǐng dǎkāi diànnǎo. Wǒ zài wǎngshang kàn guo hěn duō shū.",
      "meaning": "A: Bạn từng chơi trò này chưa? B: Chơi rồi, tôi thấy không thú vị. A: Vậy cùng lên mạng đọc sách nhé. B: Được, hãy bật máy tính. Tôi từng đọc nhiều sách trên mạng.",
      "readingMinutes": 2
    },
