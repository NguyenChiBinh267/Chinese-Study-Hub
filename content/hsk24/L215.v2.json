  "blocks": [
    {
      "id": "l215-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "天气 là thời tiết; 今天 là hôm nay; 比 dùng so sánh. Ví dụ tốc độ không cung cấp lịch chạy hay thời gian thực tế. 但是 nghĩa là nhưng, nối ý trái kỳ vọng; được nhắc hỗ trợ, chưa kiểm chứng mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l215-t0",
      "type": "teaching",
      "title": "晴 · trời quang, có nắng",
      "text": "晴 nói trạng thái trời quang; không có nghĩa chắc chắn nóng. Trời quang vẫn có thể lạnh.",
      "hanzi": "今天是晴天，但是很冷。",
      "pinyin": "Jīntiān shì qíngtiān, dànshì hěn lěng.",
      "meaning": "Hôm nay trời quang nhưng rất lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l215-t1",
      "type": "teaching",
      "title": "阴 · trời âm u",
      "text": "阴 nói trời nhiều mây/âm u, chưa tự cho biết có mưa. Đừng tự thêm thông tin mưa vào đáp án.",
      "hanzi": "今天是阴天，不太热。",
      "pinyin": "Jīntiān shì yīntiān, bú tài rè.",
      "meaning": "Hôm nay trời âm u, không nóng lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l215-t2",
      "type": "teaching",
      "title": "快 · nhanh",
      "text": "快 ở đây là tốc độ nhanh; khác 快要 chỉ sắp xảy ra. ‘Nhanh’ luôn cần hiểu hoạt động đang nói.",
      "hanzi": "坐地铁比走路快。",
      "pinyin": "Zuò dìtiě bǐ zǒulù kuài.",
      "meaning": "Đi tàu điện ngầm nhanh hơn đi bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l215-t3",
      "type": "teaching",
      "title": "慢 · chậm",
      "text": "慢 nói tốc độ thấp; không tự đồng nghĩa với trễ giờ. 走得慢 là đi chậm, 得 dẫn phần mô tả mức độ.",
      "hanzi": "爷爷走得很慢。",
      "pinyin": "Yéye zǒu de hěn màn.",
      "meaning": "Ông nội đi rất chậm.",
      "readingMinutes": 1
    },
    {
      "id": "l215-t4",
      "type": "teaching",
      "title": "因为 · vì, bởi vì",
      "text": "因为 giới thiệu nguyên nhân được nêu trong lời nói. Ở đây luyện liên từ nối mệnh đề, không phân tích mọi cách dùng giới từ.",
      "hanzi": "因为今天很冷，我不去游泳。",
      "pinyin": "Yīnwèi jīntiān hěn lěng, wǒ bú qù yóuyǒng.",
      "meaning": "Vì hôm nay lạnh, tôi không đi bơi.",
      "readingMinutes": 1
    },
    {
      "id": "l215-t5",
      "type": "teaching",
      "title": "所以 · nên, cho nên",
      "text": "所以 đưa phần kết quả, không đặt vào chỗ nêu nguyên nhân. Có thể đi với 因为 trong mẫu đã học.",
      "hanzi": "今天很冷，所以我们在家。",
      "pinyin": "Jīntiān hěn lěng, suǒyǐ wǒmen zài jiā.",
      "meaning": "Hôm nay lạnh nên chúng tôi ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l215-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "因为 dẫn lý do, 所以 dẫn kết quả: 因为冷，所以不去. Câu biểu đạt lý do người nói nêu, không biến mọi tình huống cùng xảy ra thành quan hệ nhân quả.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l215-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：今天是晴天，我们去游泳吧？乙：是晴天，但是很冷。甲：那我们去书店吧。乙：好，因为书店离这里远，所以我们坐地铁去。",
      "pinyin": "Jiǎ: Jīntiān shì qíngtiān, wǒmen qù yóuyǒng ba? Yǐ: Shì qíngtiān, dànshì hěn lěng. Jiǎ: Nà wǒmen qù shūdiàn ba. Yǐ: Hǎo, yīnwèi shūdiàn lí zhèlǐ yuǎn, suǒyǐ wǒmen zuò dìtiě qù.",
      "meaning": "A: Hôm nay trời quang, đi bơi nhé? B: Trời quang nhưng rất lạnh. A: Vậy đến hiệu sách nhé. B: Được, vì hiệu sách xa đây nên chúng ta đi tàu điện ngầm.",
      "readingMinutes": 2
    },
