  "blocks": [
    {
      "id": "l4001-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t0",
      "type": "teaching",
      "title": "篇 · lượng từ cho bài viết",
      "text": "篇 đếm bài văn/báo cáo, không đếm trang giấy. Nhận diện chữ 篇 trong 篇; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我写了两篇报告。",
      "pinyin": "Wǒ xiě le liǎng piān bào gào.",
      "meaning": "Tôi đã viết hai bài báo cáo.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t1",
      "type": "teaching",
      "title": "期 · kỳ; số của ấn phẩm",
      "text": "一期 là một kỳ hoặc một số tạp chí; khác 篇 đếm từng bài viết.",
      "hanzi": "这期杂志有三篇故事。",
      "pinyin": "Zhè qī zá zhì yǒu sān piān gù shi.",
      "meaning": "Số tạp chí này có ba truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t2",
      "type": "teaching",
      "title": "期末 · cuối học kỳ",
      "text": "期末 là giai đoạn cuối kỳ, không phải số cuối của tạp chí.",
      "hanzi": "期末我们要交报告。",
      "pinyin": "Qī mò wǒ men yào jiāo bào gào.",
      "meaning": "Cuối kỳ chúng tôi phải nộp báo cáo.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t3",
      "type": "teaching",
      "title": "期中 · giữa học kỳ",
      "text": "期中 chỉ thời điểm giữa kỳ; 中 ở đây không mang nghĩa Trung Quốc.",
      "hanzi": "期中考试在下周。",
      "pinyin": "Qī zhōng kǎo shì zài xià zhōu.",
      "meaning": "Thi giữa kỳ vào tuần sau.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t4",
      "type": "teaching",
      "title": "其次 · thứ hai; tiếp theo",
      "text": "其次 sắp xếp luận điểm sau 首先; không chỉ phần nằm bên trong một tập hợp.",
      "hanzi": "首先检查日期，其次修改内容。",
      "pinyin": "Shǒu xiān jiǎn chá rì qī, qí cì xiū gǎi nèi róng.",
      "meaning": "Trước tiên kiểm tra ngày, tiếp theo sửa nội dung.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-t5",
      "type": "teaching",
      "title": "其中 · trong số đó",
      "text": "其中 chỉ một phần của tập hợp vừa nói; không phải thứ tự thứ hai.",
      "hanzi": "三篇报告中，其中一篇还没写完。",
      "pinyin": "Sān piān bào gào zhōng, qí zhōng yì piān hái méi xiě wán.",
      "meaning": "Trong ba báo cáo, một bài vẫn chưa viết xong.",
      "readingMinutes": 1
    },
    {
      "id": "l4001-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "然而 nối hai mệnh đề tương phản, thường dùng trong văn viết: đã làm được một phần, tuy nhiên phần khác còn thiếu. Không đồng nghĩa với 其次 (thứ hai).",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4001-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "期中考试以后，小林准备期末报告。他先读这期杂志的三篇文章，其中一篇介绍学习方法。他说：“首先整理材料，其次写总结。我写了两篇报告，然而还没完成期末总结。”",
      "pinyin": "Qī zhōng kǎo shì yǐ hòu, Xiǎo Lín zhǔn bèi qī mò bào gào. Tā xiān dú zhè qī zá zhì de sān piān wén zhāng, qí zhōng yì piān jiè shào xué xí fāng fǎ. Tā shuō: “Shǒu xiān zhěng lǐ cái liào, qí cì xiě zǒng jié. Wǒ xiě le liǎng piān bào gào, rán ér hái méi wán chéng qī mò zǒng jié.”",
      "meaning": "Tiểu Lâm đọc ba bài để chuẩn bị cuối kỳ; đã viết hai báo cáo nhưng chưa hoàn thành tổng kết.",
      "readingMinutes": 2
    },
    {
