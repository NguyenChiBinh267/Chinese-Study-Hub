  "blocks": [
    {
      "id": "l442-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 室内 shìnèi: trong nhà; 组长 zǔzhǎng: trưởng nhóm; 取消 qǔxiāo: hủy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l442-t0",
      "type": "teaching",
      "title": "计划 · kế hoạch",
      "text": "计划 có thể là danh từ hoặc động từ; 按计划 nghĩa theo kế hoạch.",
      "hanzi": "我们按计划准备活动。",
      "pinyin": "Wǒmen àn jìhuà zhǔnbèi huódòng.",
      "meaning": "Chúng tôi chuẩn bị hoạt động theo kế hoạch.",
      "readingMinutes": 1
    },
    {
      "id": "l442-t1",
      "type": "teaching",
      "title": "活动 · hoạt động",
      "text": "活动 trong bài là sự kiện có người tham gia; không phải động tác đơn lẻ.",
      "hanzi": "这次活动在室内举行。",
      "pinyin": "Zhè cì huódòng zài shìnèi jǔxíng.",
      "meaning": "Hoạt động lần này tổ chức trong nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l442-t2",
      "type": "teaching",
      "title": "加入 · gia nhập, tham gia vào",
      "text": "加入 + nhóm/đội/tổ chức, khác chỉ dự một sự kiện bằng 参加.",
      "hanzi": "欢迎你加入我们的小组。",
      "pinyin": "Huānyíng nǐ jiārù wǒmen de xiǎozǔ.",
      "meaning": "Chào mừng bạn vào nhóm chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l442-t3",
      "type": "teaching",
      "title": "加上 · cộng thêm",
      "text": "加上 đưa yếu tố bổ sung vào tổng hoặc lý do; không thay 与 trước mọi danh từ.",
      "hanzi": "两个人加上我，一共三个人。",
      "pinyin": "Liǎng ge rén jiāshàng wǒ, yígòng sān ge rén.",
      "meaning": "Hai người cộng thêm tôi là ba người.",
      "readingMinutes": 1
    },
    {
      "id": "l442-t4",
      "type": "teaching",
      "title": "即使 · cho dù",
      "text": "即使 biểu thị giả định nhượng bộ, kết hợp 也 ở vế sau. Nhận diện chữ 即 trong 即使; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "即使下雨，我们也按计划学习。",
      "pinyin": "Jíshǐ xià yǔ, wǒmen yě àn jìhuà xuéxí.",
      "meaning": "Cho dù mưa, chúng tôi vẫn học theo kế hoạch.",
      "readingMinutes": 1
    },
    {
      "id": "l442-t5",
      "type": "teaching",
      "title": "既然 · đã... thì...",
      "text": "既然 đưa tiền đề được coi là có thật trong tình huống, thường đi với 就.",
      "hanzi": "既然已经报名，就按时参加吧。",
      "pinyin": "Jìrán yǐjīng bàomíng, jiù ànshí cānjiā ba.",
      "meaning": "Đã đăng ký rồi thì hãy tham gia đúng giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l442-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "即使 nêu điều kiện giả định có thể bất lợi; 也 nêu kết quả vẫn giữ nguyên. Ví dụ 即使下雨，我们也按计划学习. Không dùng nó như 既然 để khẳng định điều kiện đã xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l442-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小组原来有两个人，加上新加入的小黄，一共三个人。他们计划周六办阅读活动。小黄问：“下雨怎么办？”组长说：“活动可以在教室里举行，即使下雨，我们也按计划学习。既然大家已经报名，就请按时到。”",
      "pinyin": "Xiǎozǔ yuánlái yǒu liǎng ge rén, jiāshàng xīn jiārù de Xiǎo Huáng, yígòng sān ge rén. Tāmen jìhuà Zhōuliù bàn yuèdú huódòng. Xiǎo Huáng wèn: “Xià yǔ zěnme bàn?” Zǔzhǎng shuō: “Huódòng kěyǐ zài jiàoshì lǐ jǔxíng, jíshǐ xià yǔ, wǒmen yě àn jìhuà xuéxí. Jìrán dàjiā yǐjīng bàomíng, jiù qǐng ànshí dào.”",
      "meaning": "Nhóm ba người lên kế hoạch đọc sách thứ bảy. Họ có lớp trong nhà nên dù mưa vẫn học. Việc đăng ký đã xảy ra; trời mưa chỉ là giả định.",
      "readingMinutes": 2
    },
