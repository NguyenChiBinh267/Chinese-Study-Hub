  "blocks": [
    {
      "id": "l4067-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t0",
      "type": "teaching",
      "title": "项 · hạng; mục",
      "text": "项 làm lượng từ cho công việc, kế hoạch, nội dung. Nhận diện chữ 项 trong 项; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这项工作由我负责。",
      "pinyin": "Zhè xiàng gōng zuò yóu wǒ fù zé.",
      "meaning": "Hạng việc này do tôi phụ trách.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t1",
      "type": "teaching",
      "title": "通 · thông; nối được",
      "text": "通 trong 电话通了 nói đường liên lạc đã kết nối.",
      "hanzi": "电话终于通了。",
      "pinyin": "Diàn huà zhōng yú tōng le.",
      "meaning": "Cuối cùng điện thoại đã nối được.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t2",
      "type": "teaching",
      "title": "通过 · thông qua",
      "text": "通过 ở đây là chấp thuận kế hoạch sau xem xét.",
      "hanzi": "计划已经通过了。",
      "pinyin": "Jì huà yǐ jīng tōng guò le.",
      "meaning": "Kế hoạch đã được thông qua.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t3",
      "type": "teaching",
      "title": "通知 · thông báo",
      "text": "通知 là báo tin cần thiết cho người liên quan.",
      "hanzi": "请通知所有参加的人。",
      "pinyin": "Qǐng tōng zhī suǒ yǒu cān jiā de rén.",
      "meaning": "Xin thông báo mọi người tham gia.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t4",
      "type": "teaching",
      "title": "现有 · hiện có",
      "text": "现有 bổ nghĩa cho nguồn lực đang có lúc nói.",
      "hanzi": "先整理现有材料。",
      "pinyin": "Xiān zhěng lǐ xiàn yǒu cái liào.",
      "meaning": "Trước hết sắp xếp tài liệu hiện có.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-t5",
      "type": "teaching",
      "title": "已 · đã",
      "text": "已 thường gặp trong văn viết; không dùng nó như 未 là chưa.",
      "hanzi": "邮件上写着：计划已通过。",
      "pinyin": "Yóu jiàn shàng xiě zhe: jì huà yǐ tōng guò.",
      "meaning": "Email ghi: kế hoạch đã được thông qua.",
      "readingMinutes": 1
    },
    {
      "id": "l4067-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung hai việc cùng cần làm. 已 là cách viết gọn của 已经 trong ngữ cảnh này; 通 báo cuộc gọi đã nối, còn 通过 ở đây nói kế hoạch được thông qua.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4067-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "邮件通知大家：这项计划已通过。小周先整理现有材料，再打电话确认。电话通了，他说：“我们不仅要整理材料，还要通知参加的人。”同事把两件事分别记下。",
      "pinyin": "Yóu jiàn tōng zhī dà jiā: zhè xiàng jì huà yǐ tōng guò. Xiǎo Zhōu xiān zhěng lǐ xiàn yǒu cái liào, zài dǎ diàn huà què rèn. Diàn huà tōng le, tā shuō: “Wǒ men bù jǐn yào zhěng lǐ cái liào, hái yào tōng zhī cān jiā de rén.” Tóng shì bǎ liǎng jiàn shì fēn bié jì xià.",
      "meaning": "Hai việc được ghi riêng: sắp xếp tài liệu và báo người tham gia.",
      "readingMinutes": 2
    },
