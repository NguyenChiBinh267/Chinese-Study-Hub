  "blocks": [
    {
      "id": "l4036-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t0",
      "type": "teaching",
      "title": "种 · trồng",
      "text": "种 đọc zhòng khi là động từ trồng cây, khác zhǒng chỉ loại/hạt.",
      "hanzi": "爷爷在院子里种菜。",
      "pinyin": "Yé ye zài yuàn zi lǐ zhòng cài.",
      "meaning": "Ông trồng rau trong sân.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t1",
      "type": "teaching",
      "title": "院子 · sân",
      "text": "院子 là khoảng sân của nhà/cơ sở, không phải học viện.",
      "hanzi": "院子里有一张桌子。",
      "pinyin": "Yuàn zi lǐ yǒu yì zhāng zhuō zi.",
      "meaning": "Trong sân có một cái bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t2",
      "type": "teaching",
      "title": "阳光 · ánh nắng",
      "text": "阳光 ở đây là ánh sáng mặt trời, không tả tính cách.",
      "hanzi": "这里上午有阳光。",
      "pinyin": "Zhè lǐ shàng wǔ yǒu yáng guāng.",
      "meaning": "Ở đây buổi sáng có nắng.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t3",
      "type": "teaching",
      "title": "周围 · xung quanh",
      "text": "周围 nói vùng quanh một điểm làm mốc.",
      "hanzi": "房子周围有很多树。",
      "pinyin": "Fáng zi zhōu wéi yǒu hěn duō shù.",
      "meaning": "Xung quanh nhà có nhiều cây.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t4",
      "type": "teaching",
      "title": "鲜花 · hoa tươi",
      "text": "鲜花 là hoa tươi, không chỉ tất cả thực vật.",
      "hanzi": "奶奶把鲜花放在桌上。",
      "pinyin": "Nǎi nai bǎ xiān huā fàng zài zhuō shàng.",
      "meaning": "Bà đặt hoa tươi lên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-t5",
      "type": "teaching",
      "title": "西红柿 · cà chua",
      "text": "西红柿 là tên cà chua, không tách nghĩa từng chữ. Nhận diện chữ 柿 trong 西红柿; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这些西红柿还没红。",
      "pinyin": "Zhè xiē xī hóng shì hái méi hóng.",
      "meaning": "Những quả cà chua này chưa đỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l4036-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有空来看看 lược liên từ: nếu rảnh thì tới xem. Chỉ luyện một câu điều kiện–đề nghị rút gọn, không chấp nhận toàn bộ phạm vi hàng nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4036-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "爷爷在院子里种西红柿，周围还种了花。上午有阳光，奶奶把一束鲜花放在桌上。她给朋友写信：“有空来看看，我们一起在院子里坐坐。”",
      "pinyin": "Yé ye zài yuàn zi lǐ zhòng xī hóng shì, zhōu wéi hái zhòng le huā. Shàng wǔ yǒu yáng guāng, nǎi nai bǎ yí shù xiān huā fàng zài zhuō shàng. Tā gěi péng you xiě xìn: “Yǒu kòng lái kàn kan, wǒ men yì qǐ zài yuàn zi lǐ zuò zuo.”",
      "meaning": "Ông trồng cà chua; bà mời bạn khi rảnh tới ngắm sân.",
      "readingMinutes": 2
    },
    {
