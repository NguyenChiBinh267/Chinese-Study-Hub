  "blocks": [
    {
      "id": "l106-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l106-t0",
      "type": "teaching",
      "title": "谁 · ai",
      "text": "谁 hỏi người chưa rõ; bài chọn cách đọc shéi, nguồn cũng ghi shuí.",
      "hanzi": "他是谁？",
      "pinyin": "Tā shì shéi?",
      "meaning": "Anh ấy là ai?",
      "readingMinutes": 1
    },
    {
      "id": "l106-t1",
      "type": "teaching",
      "title": "们 · hậu tố số nhiều cho người",
      "text": "们 trong 我们 tạo dạng chúng tôi/chúng ta; không tự đứng thành chủ thể.",
      "hanzi": "我们喜欢茶。",
      "pinyin": "Wǒ men xǐ huan chá.",
      "meaning": "Chúng tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l106-t2",
      "type": "teaching",
      "title": "我们 · chúng tôi; chúng ta",
      "text": "我们 bao gồm người nói; có bao gồm người nghe hay không phải xem tình huống.",
      "hanzi": "我们是朋友。",
      "pinyin": "Wǒ men shì péng you.",
      "meaning": "Chúng ta là bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l106-t3",
      "type": "teaching",
      "title": "你们 · các bạn",
      "text": "你们 chỉ nhiều người đang nghe; 你 chỉ một người trong tình huống đơn giản này.",
      "hanzi": "你们叫什么名字？",
      "pinyin": "Nǐ men jiào shén me míng zi?",
      "meaning": "Các bạn tên là gì?",
      "readingMinutes": 1
    },
    {
      "id": "l106-t4",
      "type": "teaching",
      "title": "大家 · mọi người; cả nhóm",
      "text": "大家 là cả nhóm đang được gọi, không phải cách nói một ngôi nhà lớn.",
      "hanzi": "大家好！",
      "pinyin": "Dà jiā hǎo!",
      "meaning": "Chào mọi người!",
      "readingMinutes": 1
    },
    {
      "id": "l106-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "我/你 thêm 们 thành 我们/你们 để chỉ nhiều người. 们 gắn với đại từ/người trong phạm vi bài, không gắn sau động từ hoặc mọi danh từ. 大家 gọi cả nhóm trong ngữ cảnh; 谁 hỏi danh tính. 谁 có cách đọc shéi và shuí trong nguồn, bài dùng shéi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l106-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：大家好！我叫安。你们叫什么名字？\nB：我叫林。他叫文。我们是朋友。\nA：你们好！",
      "pinyin": "A: Dà jiā hǎo! Wǒ jiào Ān. Nǐ men jiào shén me míng zi? B: Wǒ jiào Lín. Tā jiào Wén. Wǒ men shì péng you. A: Nǐ men hǎo!",
      "meaning": "安、林、文 là tên minh họa. B giới thiệu mình và 文; 我们 trong lời B chỉ B và 文.",
      "readingMinutes": 2
    },
    {
