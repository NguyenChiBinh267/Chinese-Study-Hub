  "blocks": [
    {
      "id": "l4038-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t0",
      "type": "teaching",
      "title": "失败 · thất bại",
      "text": "失败 là không đạt mục tiêu; có thể nói về một lần thử hoặc một cuộc thi. Trong bài chỉ nói lần thất bại này, không kết luận năng lực lâu dài.",
      "hanzi": "这次尝试失败了。",
      "pinyin": "Zhè cì cháng shì shī bài le.",
      "meaning": "Lần thử này đã thất bại.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t1",
      "type": "teaching",
      "title": "失望 · thất vọng",
      "text": "失望 là cảm xúc khi mong đợi không thành.",
      "hanzi": "没能参加活动，她很失望。",
      "pinyin": "Méi néng cān jiā huó dòng, tā hěn shī wàng.",
      "meaning": "Không dự được hoạt động, cô ấy rất thất vọng.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t2",
      "type": "teaching",
      "title": "失去 · mất; đánh mất",
      "text": "失去 thường đi với cơ hội/khả năng/người, khác tự vứt đồ.",
      "hanzi": "他失去了一次机会。",
      "pinyin": "Tā shī qù le yí cì jī huì.",
      "meaning": "Anh ấy mất một cơ hội.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t3",
      "type": "teaching",
      "title": "伤心 · buồn lòng",
      "text": "伤心 nói cảm xúc buồn, không phải vết thương cơ thể.",
      "hanzi": "听到这个消息，她很伤心。",
      "pinyin": "Tīng dào zhè ge xiāo xi, tā hěn shāng xīn.",
      "meaning": "Nghe tin này cô ấy rất buồn.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t4",
      "type": "teaching",
      "title": "永远 · mãi mãi",
      "text": "永远 nói thời gian không có điểm kết thúc trong cách diễn đạt.",
      "hanzi": "我会永远记得这一天。",
      "pinyin": "Wǒ huì yǒng yuǎn jì de zhè yì tiān.",
      "meaning": "Tôi sẽ mãi nhớ ngày này.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-t5",
      "type": "teaching",
      "title": "幸福 · hạnh phúc",
      "text": "幸福 nói cảm nhận tốt đẹp về cuộc sống, không chỉ vui thoáng qua. Nhận diện chữ 幸 trong 幸福; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "和家人在一起，她觉得很幸福。",
      "pinyin": "Hé jiā rén zài yì qǐ, tā jué de hěn xìng fú.",
      "meaning": "Ở bên gia đình cô ấy thấy hạnh phúc.",
      "readingMinutes": 1
    },
    {
      "id": "l4038-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 chuyển sang mặt giới hạn/tương phản nhẹ; lời an ủi không phủ nhận cảm xúc trước đó.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4038-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "比赛失败以后，小梅失去了一次参赛机会，又伤心又失望。家人陪她散步。她说：“我会记得这次失败，不过它不会永远决定我的生活。有人愿意陪我，我也觉得幸福。”",
      "pinyin": "Bǐ sài shī bài yǐ hòu, Xiǎo Méi shī qù le yí cì cān sài jī huì, yòu shāng xīn yòu shī wàng. Jiā rén péi tā sàn bù. Tā shuō: “Wǒ huì jì de zhè cì shī bài, bú guò tā bú huì yǒng yuǎn jué dìng wǒ de shēng huó. Yǒu rén yuàn yì péi wǒ, wǒ yě jué de xìng fú.”",
      "meaning": "Tiểu Mai vẫn buồn nhưng trân trọng gia đình đồng hành sau thất bại.",
      "readingMinutes": 2
    },
    {
