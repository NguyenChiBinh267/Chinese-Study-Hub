  "blocks": [
    {
      "id": "l329-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 散步 sàn bù: đi dạo; 标牌 biāopái: biển chỉ dẫn; 随便 suíbiàn: tùy tiện; 长 zhǎng: mọc; 棵 kē và 片 piàn là lượng từ cây và vùng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l329-t0",
      "type": "teaching",
      "title": "草 · cỏ",
      "text": "草 là cỏ như loại thực vật; 一棵草 nói một cây cỏ, 草地 chỉ cả khu đất có cỏ.",
      "hanzi": "树下有草。",
      "pinyin": "Shù xià yǒu cǎo.",
      "meaning": "Dưới cây có cỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l329-t1",
      "type": "teaching",
      "title": "草地 · bãi cỏ",
      "text": "草地 là khu đất phủ cỏ; không tự được phép đi lên chỉ vì là 草地. Đọc biển tại chỗ.",
      "hanzi": "孩子们在草地旁边玩。",
      "pinyin": "Háizimen zài cǎodì pángbiān wán.",
      "meaning": "Bọn trẻ chơi cạnh bãi cỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l329-t2",
      "type": "teaching",
      "title": "树 · cây (thân gỗ)",
      "text": "树 thường là cây thân gỗ; 树下 là dưới tán/vị trí dưới cây theo cảnh, không phải dưới rễ.",
      "hanzi": "这棵树很高。",
      "pinyin": "Zhè kē shù hěn gāo.",
      "meaning": "Cây này cao.",
      "readingMinutes": 1
    },
    {
      "id": "l329-t3",
      "type": "teaching",
      "title": "开花 · nở hoa",
      "text": "开花 nói cây/hoa bắt đầu nở; không phải động tác mở một bông hoa bằng tay.",
      "hanzi": "花园里的树开花了。",
      "pinyin": "Huāyuán lǐ de shù kāi huā le.",
      "meaning": "Cây trong vườn đã nở hoa.",
      "readingMinutes": 1
    },
    {
      "id": "l329-t4",
      "type": "teaching",
      "title": "花园 · vườn hoa/vườn",
      "text": "花园 là vườn trồng hoa/cảnh theo ngữ cảnh, không phải mọi 公园 công cộng đều chỉ là vườn hoa.",
      "hanzi": "学校后面有一个花园。",
      "pinyin": "Xuéxiào hòumian yǒu yí ge huāyuán.",
      "meaning": "Sau trường có một khu vườn.",
      "readingMinutes": 1
    },
    {
      "id": "l329-t5",
      "type": "teaching",
      "title": "公园 · công viên",
      "text": "公园 là công viên công cộng theo bài; có thể có vườn hoa hay bãi cỏ bên trong nhưng không đồng nghĩa từng phần ấy.",
      "hanzi": "我们周末去公园散步。",
      "pinyin": "Wǒmen zhōumò qù gōngyuán sàn bù.",
      "meaning": "Cuối tuần chúng tôi đi dạo công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l329-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "在树下 chỉ vị trí dưới cây; 下 đứng sau danh từ. 在公园里/在花园中 đều là vị trí; không dùng 上 cho mọi không gian. Luyện thứ tự 在+树+下.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l329-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "公园里有花园和草地。花园里的树开花了，树下也长着草。小林在树下看书，朋友在草地旁边散步。他们先看标牌，不随便走进花园。",
      "pinyin": "Gōngyuán lǐ yǒu huāyuán hé cǎodì. Huāyuán lǐ de shù kāi huā le, shù xià yě zhǎng zhe cǎo. Xiǎo Lín zài shù xià kàn shū, péngyou zài cǎodì pángbiān sàn bù. Tāmen xiān kàn biāopái, bù suíbiàn zǒu jìn huāyuán.",
      "meaning": "Trong công viên có vườn và bãi cỏ. Cây trong vườn nở hoa. Lâm đọc dưới cây, bạn đi dạo cạnh bãi cỏ. Họ xem biển trước, không tự ý vào vườn.",
      "readingMinutes": 2
    },
    {
      "id": "l329-b0",
      "type": "exercise",
      "exerciseVersionId": "l329-v1-e0"
    },
