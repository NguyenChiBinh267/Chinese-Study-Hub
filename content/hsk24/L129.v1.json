  "blocks": [
    {
      "id": "l129-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l129-t0",
      "type": "teaching",
      "title": "在 · ở; tại (vị trí trong bài)",
      "text": "在 ở 我在学校 giới thiệu nơi chốn, không tự mang nghĩa đang học.",
      "hanzi": "我在学校。",
      "pinyin": "Wǒ zài xué xiào.",
      "meaning": "Tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l129-t1",
      "type": "teaching",
      "title": "住 · sống; ở; cư trú",
      "text": "住 nói nơi ở/cư trú trong câu, không phải hành động đứng tại đâu trong chốc lát.",
      "hanzi": "我住在这里。",
      "pinyin": "Wǒ zhù zài zhè lǐ.",
      "meaning": "Tôi sống ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l129-t2",
      "type": "teaching",
      "title": "房间 · phòng; căn phòng",
      "text": "房间 là một phòng, không tự đồng nghĩa toàn bộ một ngôi nhà.",
      "hanzi": "这是我的房间。",
      "pinyin": "Zhè shì wǒ de fáng jiān.",
      "meaning": "Đây là phòng của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l129-t3",
      "type": "teaching",
      "title": "里 · trong; bên trong",
      "text": "里 đặt sau nơi chốn như 房间里, không đưa lên đầu theo trật tự tiếng Việt.",
      "hanzi": "猫在房间里。",
      "pinyin": "Māo zài fáng jiān lǐ.",
      "meaning": "Mèo ở trong phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l129-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "在 + nơi chốn nói vị trí trong bài này: 猫在房间里. 住在 + nơi chốn nói nơi sống. 里 đứng sau tên chỗ để nói bên trong. Không nhầm 在 ở đây với mẫu đang làm một hành động; nghĩa tiến diễn sẽ học ở nhóm sau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l129-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你住在哪儿？\nB：我住在这里。这是我的房间。\nA：你的猫呢？\nB：猫在房间里。",
      "pinyin": "A: Nǐ zhù zài nǎr? B: Wǒ zhù zài zhè lǐ. Zhè shì wǒ de fáng jiān. A: Nǐ de māo ne? B: Māo zài fáng jiān lǐ.",
      "meaning": "B giới thiệu nơi ở và phòng của mình. Câu cuối nói vị trí của mèo; không yêu cầu người học suy từ ảnh.",
      "readingMinutes": 2
    },
