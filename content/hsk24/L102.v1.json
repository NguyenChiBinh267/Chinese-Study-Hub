  "blocks": [
    {
      "id": "l102-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. 这/这个 trong ví dụ được giải thích là “này/người này”; sẽ học riêng ở bài chỉ đối tượng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l102-t0",
      "type": "teaching",
      "title": "名字 · tên",
      "text": "名字 chỉ tên gọi; không lấy việc biết tên làm bằng chứng đã biết người đó.",
      "hanzi": "你叫什么名字？",
      "pinyin": "Nǐ jiào shén me míng zi?",
      "meaning": "Bạn tên là gì?",
      "readingMinutes": 1
    },
    {
      "id": "l102-t1",
      "type": "teaching",
      "title": "什么 · gì; cái gì",
      "text": "什么 hỏi điều chưa rõ; trong câu hỏi tên đứng trước 名字.",
      "hanzi": "你喜欢什么？",
      "pinyin": "Nǐ xǐ huan shén me?",
      "meaning": "Bạn thích gì?",
      "readingMinutes": 1
    },
    {
      "id": "l102-t2",
      "type": "teaching",
      "title": "人 · người",
      "text": "人 là người nói chung, không riêng đàn ông.",
      "hanzi": "这个人叫安。",
      "pinyin": "Zhè ge rén jiào Ān.",
      "meaning": "Người này tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l102-t3",
      "type": "teaching",
      "title": "认识 · quen; biết một người",
      "text": "认识 thường nói biết người hoặc nhận biết; không thay mọi cách dùng 知道.",
      "hanzi": "我认识你。",
      "pinyin": "Wǒ rèn shi nǐ.",
      "meaning": "Tôi biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l102-t4",
      "type": "teaching",
      "title": "高兴 · vui; vui mừng",
      "text": "高兴 nói cảm xúc vui; 很 trong câu là hỗ trợ mức độ, không dịch cứng từng chữ thành rất ở mọi câu.",
      "hanzi": "认识你，我很高兴。",
      "pinyin": "Rèn shi nǐ, wǒ hěn gāo xìng.",
      "meaning": "Tôi vui được biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l102-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "什么 hỏi thông tin chưa biết; giữ vị trí của phần cần hỏi: 我叫安 → 你叫什么名字？Không cần đưa 什么 lên đầu như một số câu hỏi tiếng Việt. 认识 là biết/quen một người; 名字 là tên. 很 trong ví dụ được chú giải là từ mức độ hỗ trợ, chưa phải mục từ mới của bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l102-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你叫什么名字？\nB：我叫安。你呢？\nA：我叫林。\nB：认识你，我很高兴。\nA：我也很高兴。",
      "pinyin": "A: Nǐ jiào shén me míng zi? B: Wǒ jiào Ān. Nǐ ne? A: Wǒ jiào Lín. B: Rèn shi nǐ, wǒ hěn gāo xìng. A: Wǒ yě hěn gāo xìng.",
      "meaning": "安 An và 林 Lâm là tên minh họa; 很 hěn là từ hỗ trợ trong câu cảm xúc. Đoạn không yêu cầu người học nhập tên tự do.",
      "readingMinutes": 2
    },
