  "blocks": [
    {
      "id": "l337-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 商店 shāngdiàn: cửa hàng; 车道 chēdào: làn xe; 沿着 yánzhe: dọc theo. Đây là đọc tình huống, không đánh giá kỹ năng tham gia giao thông thực tế.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l337-t0",
      "type": "teaching",
      "title": "层 · tầng/lớp; lượng từ tầng",
      "text": "层 đếm tầng hoặc lớp; 三层楼 là tòa ba tầng, 第三层 là tầng thứ ba. Không nhầm số lượng với vị trí.",
      "hanzi": "图书馆在第三层。",
      "pinyin": "Túshūguǎn zài dì sān céng.",
      "meaning": "Thư viện ở tầng ba.",
      "readingMinutes": 1
    },
    {
      "id": "l337-t1",
      "type": "teaching",
      "title": "电梯 · thang máy",
      "text": "电梯 là thang máy; 坐电梯 là đi thang máy, khác 走楼梯 dùng cầu thang bộ.",
      "hanzi": "我们坐电梯上楼。",
      "pinyin": "Wǒmen zuò diàntī shàng lóu.",
      "meaning": "Chúng tôi đi thang máy lên tầng.",
      "readingMinutes": 1
    },
    {
      "id": "l337-t2",
      "type": "teaching",
      "title": "楼梯 · cầu thang bộ",
      "text": "楼梯 là cầu thang bộ; 走楼梯 là đi bằng bậc thang, không phải đứng chờ trong thang máy.",
      "hanzi": "他从楼梯下来了。",
      "pinyin": "Tā cóng lóutī xiàlái le.",
      "meaning": "Anh ấy đi xuống từ cầu thang bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l337-t3",
      "type": "teaching",
      "title": "马路 · đường phố/đường xe chạy",
      "text": "马路 thường nói đường cho xe trong đô thị; 过马路 là qua đường. Không phải nơi nào cũng có cùng quy tắc qua đường.",
      "hanzi": "过马路以前先看清楚。",
      "pinyin": "Guò mǎlù yǐqián xiān kàn qīngchu.",
      "meaning": "Trước khi qua đường hãy nhìn rõ.",
      "readingMinutes": 1
    },
    {
      "id": "l337-t4",
      "type": "teaching",
      "title": "街 · phố",
      "text": "街 là phố/đường phố, có thể đi với tên riêng. 这条街 chỉ con phố, 街上 chỉ trên phố.",
      "hanzi": "这条街有很多商店。",
      "pinyin": "Zhè tiáo jiē yǒu hěn duō shāngdiàn.",
      "meaning": "Phố này có nhiều cửa hàng.",
      "readingMinutes": 1
    },
    {
      "id": "l337-t5",
      "type": "teaching",
      "title": "路口 · ngã giao đường",
      "text": "路口 là nơi các đường giao hoặc lối ra/vào theo cảnh. 在路口等 là chờ ở giao lộ, không đứng giữa lòng đường.",
      "hanzi": "我们在路口旁边等你。",
      "pinyin": "Wǒmen zài lùkǒu pángbiān děng nǐ.",
      "meaning": "Chúng tôi chờ bạn cạnh giao lộ.",
      "readingMinutes": 1
    },
    {
      "id": "l337-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "三层 có thể chỉ ba tầng, 第三层 là tầng thứ ba. Tầng trong lời hướng dẫn 三层 thường là tầng ba theo ngữ cảnh. 在三层下电梯 nêu nơi ra thang máy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l337-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "图书馆在第三层。电梯今天不能用，小林走楼梯下来。出门后，他沿着这条街走，在路口旁边等朋友；他们先看清楚，再过马路，没有在车道中间等。",
      "pinyin": "Túshūguǎn zài dì sān céng. Diàntī jīntiān bù néng yòng, Xiǎo Lín zǒu lóutī xiàlái. Chū mén hòu, tā yánzhe zhè tiáo jiē zǒu, zài lùkǒu pángbiān děng péngyou; tāmen xiān kàn qīngchu, zài guò mǎlù, méiyǒu zài chēdào zhōngjiān děng.",
      "meaning": "Thư viện ở tầng ba. Thang máy không dùng được nên Lâm xuống bằng cầu thang bộ, đi dọc phố và chờ bạn cạnh giao lộ rồi cùng qua đường.",
      "readingMinutes": 2
    },
    {
