  "blocks": [
    {
      "id": "l228-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "画 có thể là vẽ hoặc bức tranh; bài luyện hành động vẽ. 花 ở bài này là bông hoa, khác 花 tiền đã dành riêng ở bài mua đồ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l228-t0",
      "type": "teaching",
      "title": "花 · bông hoa",
      "text": "花2 là danh từ hoa. Cùng âm với động từ 花 tiêu tiền nhưng khác mục từ và nghĩa, không gộp hai bài thành một sense.",
      "hanzi": "我想画一朵花。",
      "pinyin": "Wǒ xiǎng huà yì duǒ huā.",
      "meaning": "Tôi muốn vẽ một bông hoa.",
      "readingMinutes": 1
    },
    {
      "id": "l228-t1",
      "type": "teaching",
      "title": "画 · vẽ",
      "text": "画 trong 画一只鸟 là động từ vẽ. Khi nói 一幅画 thì là danh từ bức tranh; bài không dùng nghĩa danh từ làm đáp án của câu động từ.",
      "hanzi": "她在画一只鸟。",
      "pinyin": "Tā zài huà yì zhī niǎo.",
      "meaning": "Cô ấy đang vẽ một con chim.",
      "readingMinutes": 1
    },
    {
      "id": "l228-t2",
      "type": "teaching",
      "title": "鸟 · chim",
      "text": "鸟 là chim; một con chim không tự cho biết loài cụ thể. Không thêm tên loài không có trong câu.",
      "hanzi": "那只鸟在树上。",
      "pinyin": "Nà zhī niǎo zài shù shang.",
      "meaning": "Con chim kia ở trên cây.",
      "readingMinutes": 1
    },
    {
      "id": "l228-t3",
      "type": "teaching",
      "title": "球 · quả bóng, bóng nói chung",
      "text": "球 nói bóng nói chung, chưa xác định bóng đá hay bóng rổ khi ngữ cảnh không nêu.",
      "hanzi": "这个球是弟弟的。",
      "pinyin": "Zhège qiú shì dìdi de.",
      "meaning": "Quả bóng này của em trai.",
      "readingMinutes": 1
    },
    {
      "id": "l228-t4",
      "type": "teaching",
      "title": "游 · bơi, di chuyển trong nước",
      "text": "游 ở đây là bơi của cá; không dùng nghĩa đi tham quan trong từ ghép để trả lời.",
      "hanzi": "鱼在水里游。",
      "pinyin": "Yú zài shuǐ li yóu.",
      "meaning": "Cá bơi trong nước.",
      "readingMinutes": 1
    },
    {
      "id": "l228-t5",
      "type": "teaching",
      "title": "跑 · chạy",
      "text": "跑 chỉ chạy trong câu này, không phải đi bộ chậm. 跑步 là tên hoạt động chạy bộ đã học.",
      "hanzi": "小孩儿在外面跑。",
      "pinyin": "Xiǎoháir zài wàimiàn pǎo.",
      "meaning": "Đứa trẻ đang chạy ở ngoài.",
      "readingMinutes": 1
    },
    {
      "id": "l228-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động từ lặp như 看看 hoặc 看一看 diễn đạt xem một chút, thử xem. 画一画 có thể nói thử vẽ; 画画 trong đoạn đọc gọi tên hoạt động vẽ tranh, không dùng riêng từ đó để khẳng định nghĩa làm một chút. Các mẫu A了A/ABAB vẫn cần luyện riêng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l228-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "今天我们在外面画画。妹妹画一朵花，我画一只鸟。弟弟不画，他拿着球在跑。我们看见水里的鱼在游。",
      "pinyin": "Jīntiān wǒmen zài wàimiàn huà huà. Mèimei huà yì duǒ huā, wǒ huà yì zhī niǎo. Dìdi bú huà, tā ná zhe qiú zài pǎo. Wǒmen kànjiàn shuǐ li de yú zài yóu.",
      "meaning": "Hôm nay chúng tôi vẽ ở ngoài. Em gái vẽ hoa, tôi vẽ chim. Em trai không vẽ, em cầm bóng chạy. Chúng tôi thấy cá bơi trong nước.",
      "readingMinutes": 2
    },
