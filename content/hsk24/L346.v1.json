  "blocks": [
    {
      "id": "l346-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 其中 qízhōng: trong đó; 核对 héduì: đối chiếu; 确定 quèdìng: xác nhận/chắc chắn; 当成 dàngchéng: coi thành.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l346-t0",
      "type": "teaching",
      "title": "差 · kém/chênh lệch/thiếu",
      "text": "差 trong 还差两个人 là còn thiếu hai người, 很差 là kém. Bài không dạy chā/chāi/chài; không dùng một nghĩa cho mọi cách đọc.",
      "hanzi": "名单还差两个人。",
      "pinyin": "Míngdān hái chà liǎng ge rén.",
      "meaning": "Danh sách còn thiếu hai người.",
      "readingMinutes": 1
    },
    {
      "id": "l346-t1",
      "type": "teaching",
      "title": "差不多 · gần như/xấp xỉ",
      "text": "差不多 chỉ gần bằng/xấp xỉ; không bảo đảm bằng nhau. 差不多三十人 là gần ba mươi người.",
      "hanzi": "两个人的身高差不多。",
      "pinyin": "Liǎng ge rén de shēngāo chàbuduō.",
      "meaning": "Chiều cao hai người gần bằng nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l346-t2",
      "type": "teaching",
      "title": "大概 · khoảng/có lẽ",
      "text": "大概 trước số là khoảng; trước sự việc là có lẽ. Cần giữ độ không chắc, không dịch thành xác nhận đã xảy ra.",
      "hanzi": "今天大概有三十人来。",
      "pinyin": "Jīntiān dàgài yǒu sānshí rén lái.",
      "meaning": "Hôm nay có khoảng ba mươi người đến.",
      "readingMinutes": 1
    },
    {
      "id": "l346-t3",
      "type": "teaching",
      "title": "几乎 · hầu như/gần như",
      "text": "几乎 + 都 nói gần toàn bộ, có thể còn ngoại lệ. 几乎都到了 không đủ chứng minh mọi người đã đến.",
      "hanzi": "同学们几乎都到了。",
      "pinyin": "Tóngxuémen jīhū dōu dào le.",
      "meaning": "Các bạn học hầu như đều đến rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l346-t4",
      "type": "teaching",
      "title": "好像 · hình như/có vẻ",
      "text": "好像 đánh dấu suy đoán hoặc tương tự; 好像忘了 chưa là chắc đã quên. Đây khác 像 trong so sánh ngoại hình.",
      "hanzi": "他好像忘了带书。",
      "pinyin": "Tā hǎoxiàng wàng le dài shū.",
      "meaning": "Hình như cậu ấy quên mang sách.",
      "readingMinutes": 1
    },
    {
      "id": "l346-t5",
      "type": "teaching",
      "title": "一般 · bình thường; thông thường",
      "text": "一般 có thể là bình thường về chất lượng hoặc thông thường; 一般来说 là nói chung, không khẳng định không có ngoại lệ.",
      "hanzi": "这个房间的大小很一般。",
      "pinyin": "Zhège fángjiān de dàxiǎo hěn yìbān.",
      "meaning": "Kích cỡ phòng này khá bình thường.",
      "readingMinutes": 1
    },
    {
      "id": "l346-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "大概 nói ước lượng, 好像 nói cảm giác/phỏng đoán, 几乎 nói gần đạt mức toàn bộ. Không biến 大概三十人 thành đúng ba mươi; 差不多一样 không phải chính xác giống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l346-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "名单上大概有三十个人。现在几乎都到了，还差两个人。小林说两位新同学的身高差不多，其中一个好像忘了带书。老师说：先问清楚，不要把好像当成确定。一般来说，我们先核对名单。",
      "pinyin": "Míngdān shàng dàgài yǒu sānshí ge rén. Xiànzài jīhū dōu dào le, hái chà liǎng ge rén. Xiǎo Lín shuō liǎng wèi xīn tóngxué de shēngāo chàbuduō, qízhōng yí ge hǎoxiàng wàng le dài shū. Lǎoshī shuō: Xiān wèn qīngchu, bú yào bǎ hǎoxiàng dàngchéng quèdìng. Yìbān lái shuō, wǒmen xiān héduì míngdān.",
      "meaning": "Danh sách khoảng ba mươi người, còn thiếu hai. Lâm nói hai bạn mới cao gần bằng và một người có vẻ quên sách; thầy yêu cầu hỏi rõ và đối chiếu danh sách.",
      "readingMinutes": 2
    },
    {
