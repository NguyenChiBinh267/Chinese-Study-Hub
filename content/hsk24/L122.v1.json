  "blocks": [
    {
      "id": "l122-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l122-t0",
      "type": "teaching",
      "title": "课 · tiết học; buổi học; môn học",
      "text": "课 trong 汉语课 nói buổi/môn tiếng Trung, không phải trường học.",
      "hanzi": "我喜欢汉语课。",
      "pinyin": "Wǒ xǐ huan Hàn yǔ kè.",
      "meaning": "Tôi thích giờ tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l122-t1",
      "type": "teaching",
      "title": "上课 · vào học; học trên lớp",
      "text": "上课 chỉ hoạt động học/giờ học bắt đầu trong ngữ cảnh; không dịch từng chữ thành đi lên tiết.",
      "hanzi": "我们上课。",
      "pinyin": "Wǒ men shàng kè.",
      "meaning": "Chúng tôi vào học/học trên lớp.",
      "readingMinutes": 1
    },
    {
      "id": "l122-t2",
      "type": "teaching",
      "title": "下课 · tan học; kết thúc tiết học",
      "text": "下课 nói tiết học kết thúc; 了 trong ví dụ báo sự thay đổi đã xảy ra, được chú giải thêm.",
      "hanzi": "下课了。",
      "pinyin": "Xià kè le.",
      "meaning": "Hết tiết rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l122-t3",
      "type": "teaching",
      "title": "上学 · đi học",
      "text": "上学 nói đi học hoặc theo học, khác riêng một tiết 上课.",
      "hanzi": "我弟弟上学。",
      "pinyin": "Wǒ dì di shàng xué.",
      "meaning": "Em trai tôi đi học.",
      "readingMinutes": 1
    },
    {
      "id": "l122-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "课 là tiết/buổi học hoặc môn học theo câu. 上课 nói vào học/học trên lớp, 下课 nói kết thúc tiết; không coi chúng là chỉ hướng lên/xuống một vật. 上学 là đi học. Một số tổ hợp động từ có thể tách trong mẫu khác, nhưng trước hết dùng cả cụm đúng nghĩa trong tình huống này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l122-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你上什么课？\nB：我上汉语课。\nA：你喜欢汉语课吗？\nB：喜欢。\nA：好，下课了。",
      "pinyin": "A: Nǐ shàng shén me kè? B: Wǒ shàng Hàn yǔ kè. A: Nǐ xǐ huan Hàn yǔ kè ma? B: Xǐ huan. A: Hǎo, xià kè le.",
      "meaning": "了 le trong câu cuối = rồi, báo giờ học kết thúc. Đoạn không nêu ngày hoặc giờ cụ thể.",
      "readingMinutes": 2
    },
