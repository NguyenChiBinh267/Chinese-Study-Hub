  "blocks": [
    {
      "id": "l276-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l276-reminder0",
      "type": "teaching",
      "title": "Phương tiện và điểm đến",
      "text": "车站 là ga/trạm xe, cần đọc ngữ cảnh để biết loại trạm. 地铁 là tàu điện ngầm; 公交车 là xe buýt công cộng. Nói 坐地铁, 坐公交车. 打车 tự mang nghĩa bắt taxi/gọi xe; không hiểu thành ‘đánh xe’.",
      "hanzi": "我们坐地铁去车站。他打车去。",
      "pinyin": "Wǒmen zuò dìtiě qù chēzhàn. Tā dǎchē qù.",
      "meaning": "Chúng tôi đi tàu điện ngầm đến ga. Anh ấy đi bằng taxi/xe gọi.",
      "readingMinutes": 3
    },
    {
      "id": "l276-reminder1",
      "type": "teaching",
      "title": "黑色 · màu đen",
      "text": "黑色 là tên màu, không phải riêng vật màu đen. Thêm 的 trước danh từ: 黑色的裤子.",
      "hanzi": "我想买黑色的裤子。",
      "pinyin": "Wǒ xiǎng mǎi hēisè de kùzi.",
      "meaning": "Tôi muốn mua quần màu đen.",
      "readingMinutes": 1
    },
    {
      "id": "l276-reminder2",
      "type": "teaching",
      "title": "手表 · đồng hồ đeo tay",
      "text": "手表 đeo trên tay, không dùng thay cho mọi loại đồng hồ. 手 là tay, 表 trong từ này chỉ đồng hồ.",
      "hanzi": "我的手表在桌子上。",
      "pinyin": "Wǒ de shǒubiǎo zài zhuōzi shang.",
      "meaning": "Đồng hồ đeo tay của tôi ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l276-reminder3",
      "type": "teaching",
      "title": "教室 · phòng học",
      "text": "教室 đọc jiàoshì; chữ 教 trong từ này đọc jiào, khác động từ 教 jiāo ở dưới.",
      "hanzi": "学生都在教室里。",
      "pinyin": "Xuésheng dōu zài jiàoshì li.",
      "meaning": "Các học sinh đều ở trong phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l276-reminder4",
      "type": "teaching",
      "title": "考试 · kiểm tra hoặc kỳ thi",
      "text": "考试 có thể là việc thi hoặc một kỳ thi; 明天有考试 nói ngày mai có bài kiểm tra. Không suy ra đây là kỳ HSK chính thức.",
      "hanzi": "我们明天有考试。",
      "pinyin": "Wǒmen míngtiān yǒu kǎoshì.",
      "meaning": "Ngày mai chúng tôi có bài kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l276-reminder5",
      "type": "teaching",
      "title": "题 · câu hỏi hoặc bài toán trong bài tập",
      "text": "题 dùng cho câu/bài cần làm trong bài tập, không phải mọi câu hỏi giao tiếp. Hỏi ‘câu này’ dùng 这道题; 道 là lượng từ hỗ trợ SUPPLEMENTARY, cấp chưa kiểm chứng.",
      "hanzi": "这道题我没看懂。",
      "pinyin": "Zhè dào tí wǒ méi kàn dǒng.",
      "meaning": "Câu bài tập này tôi đọc chưa hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l276-context0",
      "type": "teaching",
      "title": "Đọc tin nhắn hẹn đi",
      "text": "Chú ý phân biệt kế hoạch của người nói và người được nhắc tới. Hai người chọn tàu điện ngầm, còn anh trai đi bằng taxi/xe gọi. Đoạn văn không cung cấp giá vé hay thời gian đến.",
      "hanzi": "甲：我们怎么去车站？坐地铁还是坐公交车？乙：坐地铁吧。甲：好。我哥哥打车去。",
      "pinyin": "Jiǎ: Wǒmen zěnme qù chēzhàn? Zuò dìtiě háishi zuò gōngjiāochē? Yǐ: Zuò dìtiě ba. Jiǎ: Hǎo. Wǒ gēge dǎchē qù.",
      "meaning": "A: Chúng ta đến ga thế nào? Tàu điện ngầm hay xe buýt? B: Đi tàu điện ngầm nhé. A: Được. Anh trai tôi đi taxi/xe gọi.",
      "readingMinutes": 3
    },
    {
      "id": "l276-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你想买什么颜色的裤子？乙：黑色的。甲：这条怎么样？乙：很好。我还想看手表。",
      "pinyin": "Jiǎ: Nǐ xiǎng mǎi shénme yánsè de kùzi? Yǐ: Hēisè de. Jiǎ: Zhè tiáo zěnmeyàng? Yǐ: Hěn hǎo. Wǒ hái xiǎng kàn shǒubiǎo.",
      "meaning": "A: Bạn muốn mua quần màu gì? B: Màu đen. A: Chiếc này thế nào? B: Tốt. Tôi còn muốn xem đồng hồ đeo tay.",
      "readingMinutes": 2
    },
    {
      "id": "l276-context2",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：明天有考试。学生：老师，这道题我没看懂。老师：我们一起看。学生：好，我的书在书包里。",
      "pinyin": "Lǎoshī: Míngtiān yǒu kǎoshì. Xuésheng: Lǎoshī, zhè dào tí wǒ méi kàn dǒng. Lǎoshī: Wǒmen yìqǐ kàn. Xuésheng: Hǎo, wǒ de shū zài shūbāo li.",
      "meaning": "Giáo viên: Ngày mai có bài kiểm tra. Học sinh: Thầy/cô ơi, em đọc câu này chưa hiểu. Giáo viên: Chúng ta cùng xem. Học sinh: Vâng, sách của em ở trong cặp.",
      "readingMinutes": 2
    },
