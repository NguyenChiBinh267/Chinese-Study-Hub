  "blocks": [
    {
      "id": "l416-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 更正 gēngzhèng: đính chính; 以…为准 yǐ…wéi zhǔn: lấy… làm chuẩn. Phân biệt từ ghép 发送/发出 phải dựa ngữ cảnh và phạm vi đề, không tạo quy tắc loại trừ tuyệt đối.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l416-t0",
      "type": "teaching",
      "title": "负责 · phụ trách, chịu trách nhiệm",
      "text": "负责 có thể nhận công việc chịu trách nhiệm; ở đây không chỉ khen thái độ có trách nhiệm. Nhận diện chữ 负 trong 负责; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我负责发送今天的通知。",
      "pinyin": "Wǒ fùzé fāsòng jīntiān de tōngzhī.",
      "meaning": "Tôi phụ trách gửi thông báo hôm nay.",
      "readingMinutes": 1
    },
    {
      "id": "l416-t1",
      "type": "teaching",
      "title": "负责人 · người phụ trách",
      "text": "负责人 là người được giao chịu trách nhiệm; không mặc định chính là giám đốc toàn công ty.",
      "hanzi": "请先联系这项工作的负责人。",
      "pinyin": "Qǐng xiān liánxì zhè xiàng gōngzuò de fùzérén.",
      "meaning": "Hãy liên hệ người phụ trách việc này trước.",
      "readingMinutes": 1
    },
    {
      "id": "l416-t2",
      "type": "teaching",
      "title": "发送 · gửi đi",
      "text": "发送 thường nói gửi thông tin/tệp qua phương tiện truyền; nhận được phản hồi là bước khác.",
      "hanzi": "她把文件发送给同事了。",
      "pinyin": "Tā bǎ wénjiàn fāsòng gěi tóngshì le.",
      "meaning": "Cô ấy đã gửi tệp cho đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l416-t3",
      "type": "teaching",
      "title": "发出 · phát ra, phát đi",
      "text": "发出 nói đưa âm thanh/tín hiệu/thông báo ra; bài dùng với 通知, không phải mọi câu đều loại trừ 发送.",
      "hanzi": "办公室发出了一份新通知。",
      "pinyin": "Bàngōngshì fāchū le yí fèn xīn tōngzhī.",
      "meaning": "Văn phòng phát đi một thông báo mới.",
      "readingMinutes": 1
    },
    {
      "id": "l416-t4",
      "type": "teaching",
      "title": "错误 · lỗi, sai sót",
      "text": "错误 ở 发现错误 là danh từ; phát hiện lỗi chưa tự có nghĩa đã sửa xong.",
      "hanzi": "我们发现日期有一个错误。",
      "pinyin": "Wǒmen fāxiàn rìqī yǒu yí ge cuòwù.",
      "meaning": "Chúng tôi phát hiện một lỗi ở ngày tháng.",
      "readingMinutes": 1
    },
    {
      "id": "l416-t5",
      "type": "teaching",
      "title": "改 · sửa, đổi",
      "text": "改 trong 改日期、改错误 chỉ sửa đổi; cần nói rõ nội dung nào thay đổi.",
      "hanzi": "请把日期改成星期三。",
      "pinyin": "Qǐng bǎ rìqī gǎi chéng Xīngqīsān.",
      "meaning": "Hãy sửa ngày thành thứ tư.",
      "readingMinutes": 1
    },
    {
      "id": "l416-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 xem vế đầu là điều đã được chấp nhận làm căn cứ, rồi 就 nêu việc nên làm: 既然发现错误，就马上改. Khác 要是 là còn giả thiết.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l416-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小孟负责发送通知。文件发出后，负责人发现日期有错误。她说既然发现了问题，就先改日期，再发更正说明。小孟改成星期三，重新发送，并请同事以新通知为准。",
      "pinyin": "Xiǎo Mèng fùzé fāsòng tōngzhī. Wénjiàn fāchū hòu, fùzérén fāxiàn rìqī yǒu cuòwù. Tā shuō jìrán fāxiàn le wèntí, jiù xiān gǎi rìqī, zài fā gēngzhèng shuōmíng. Xiǎo Mèng gǎi chéng Xīngqīsān, chóngxīn fāsòng, bìng qǐng tóngshì yǐ xīn tōngzhī wéi zhǔn.",
      "meaning": "Mạnh gửi thông báo rồi được báo có lỗi ngày. Cô sửa sang thứ tư, gửi lại và nhờ đồng nghiệp theo thông báo mới.",
      "readingMinutes": 2
    },
    {
