  "blocks": [
    {
      "id": "l170-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l170-t0",
      "type": "teaching",
      "title": "第 · thứ; tiền tố số thứ tự (dì)",
      "text": "第 đứng trước số khi nói thứ tự, như 第一课; không tự có nghĩa đứng đầu nếu thiếu số.",
      "hanzi": "这是第一课。",
      "pinyin": "Zhè shì dì yī kè.",
      "meaning": "Đây là bài thứ nhất.",
      "readingMinutes": 1
    },
    {
      "id": "l170-t1",
      "type": "teaching",
      "title": "都 · đều; tất cả (dạng dōu)",
      "text": "都 đứng trước vị ngữ và có phạm vi theo chủ thể đã nêu; không thay 也 trong mọi câu.",
      "hanzi": "我们都学习汉语。",
      "pinyin": "Wǒ men dōu xué xí Hàn yǔ.",
      "meaning": "Chúng tôi đều học tiếng Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l170-t2",
      "type": "teaching",
      "title": "给 · cho; đưa cho (động từ gěi)",
      "text": "给 trong ví dụ là đưa sách cho người nhận; bài chưa khái quát mọi cách dùng giới từ của 给.",
      "hanzi": "妈妈给我一本书。",
      "pinyin": "Mā ma gěi wǒ yì běn shū.",
      "meaning": "Mẹ cho tôi một quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l170-t3",
      "type": "teaching",
      "title": "还 · còn; còn thêm (dạng hái)",
      "text": "还 đọc hái ở nghĩa thêm điều nữa; không nhầm với huán trả lại thuộc nghĩa khác ngoài mục này.",
      "hanzi": "我有书，还有笔。",
      "pinyin": "Wǒ yǒu shū, hái yǒu bǐ.",
      "meaning": "Tôi có sách, còn có bút.",
      "readingMinutes": 1
    },
    {
      "id": "l170-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "第 + số tạo thứ tự: 第一课 là bài thứ nhất; 一课 chỉ một bài theo lượng, không đồng nhất hai cách. 都 đứng trước vị ngữ để gom các thành viên trong phạm vi đang nói: 我们都学习汉语. 还 thêm một điều vào thông tin đã nêu: 我有书，还有笔. 给 trong 妈妈给我一本书 là đưa/cho, với người nhận trước vật được cho. Các câu chỉ minh họa từng mẫu, không chứng nhận học xong toàn bộ các hàng ngữ pháp nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l170-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这是第一课吗？\nB：是。我们都学习汉语。\nA：你有什么？\nB：我有书，还有笔。妈妈给我一本书。",
      "pinyin": "A: Zhè shì dì yī kè ma? B: Shì. Wǒ men dōu xué xí Hàn yǔ. A: Nǐ yǒu shén me? B: Wǒ yǒu shū, hái yǒu bǐ. Mā ma gěi wǒ yì běn shū.",
      "meaning": "Hai người đang nói về bài thứ nhất trong truyện. B có sách và bút, được mẹ cho một quyển sách; không đồng nhất bài trong truyện với vị trí người học trong hệ thống.",
      "readingMinutes": 2
    },
