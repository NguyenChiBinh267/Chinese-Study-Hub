  "blocks": [
    {
      "id": "l234-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "请 mở đầu lời nhờ; 菜 là món ăn. Khi cùng chữ có nhiều nghĩa, chọn theo toàn câu và chú thích cấp của nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l234-t0",
      "type": "teaching",
      "title": "别 · đừng",
      "text": "别1 là phó từ phủ định trong lời yêu cầu 别跑. Không nhầm với từ khác nghĩa chia lìa hay khác biệt.",
      "hanzi": "这里有小孩儿，别跑。",
      "pinyin": "Zhèlǐ yǒu xiǎoháir, bié pǎo.",
      "meaning": "Ở đây có trẻ con, đừng chạy.",
      "readingMinutes": 1
    },
    {
      "id": "l234-t1",
      "type": "teaching",
      "title": "跟 · với, cùng, đi theo đối tượng trong mẫu này",
      "text": "跟 trong 跟奶奶一起 là giới từ chỉ người đi cùng. Nguồn còn ghi liên từ ở cấp này; nghĩa danh từ/động từ cấp cao hơn không được tính ở đây.",
      "hanzi": "我跟奶奶一起去饭馆。",
      "pinyin": "Wǒ gēn nǎinai yìqǐ qù fànguǎn.",
      "meaning": "Tôi cùng bà nội đến quán ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l234-t2",
      "type": "teaching",
      "title": "点 · gọi, chọn món",
      "text": "点2 là động từ trong 点菜 ở cấp2. Không dùng danh từ chấm/điểm hay lượng từ được chú thích cấp cao hơn để trả lời câu này.",
      "hanzi": "我们点鱼和肉吧。",
      "pinyin": "Wǒmen diǎn yú hé ròu ba.",
      "meaning": "Chúng ta gọi cá và thịt nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l234-t3",
      "type": "teaching",
      "title": "过 · đón, trải qua một dịp trong ngữ cảnh sinh nhật",
      "text": "Mục347 là động từ guò có thanh bốn. Trong 过生日 nghĩa là đón sinh nhật, không phải trợ từ kinh nghiệm guo đọc nhẹ mục351.",
      "hanzi": "今天我们一起过生日。",
      "pinyin": "Jīntiān wǒmen yìqǐ guò shēngrì.",
      "meaning": "Hôm nay chúng tôi cùng đón sinh nhật.",
      "readingMinutes": 1
    },
    {
      "id": "l234-t4",
      "type": "teaching",
      "title": "笑 · cười",
      "text": "笑 ở đây là cười; không tự suy ra đang chế nhạo ai khi câu không nêu đối tượng/ngữ cảnh.",
      "hanzi": "奶奶高兴地笑了。",
      "pinyin": "Nǎinai gāoxìng de xiào le.",
      "meaning": "Bà nội vui vẻ cười.",
      "readingMinutes": 1
    },
    {
      "id": "l234-t5",
      "type": "teaching",
      "title": "从小 · từ nhỏ",
      "text": "从小 chỉ khoảng bắt đầu từ thời thơ ấu đến mốc được nói. Không đồng nghĩa mọi việc đều xảy ra đúng một ngày lúc nhỏ.",
      "hanzi": "我从小跟奶奶住在一起。",
      "pinyin": "Wǒ cóngxiǎo gēn nǎinai zhù zài yìqǐ.",
      "meaning": "Tôi sống cùng bà nội từ nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l234-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "别 đứng trước động từ để nhắc hoặc yêu cầu đừng làm. 别笑 không có nghĩa chưa từng cười; đó là yêu cầu ở tình huống hiện tại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l234-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "我从小跟奶奶住在一起。今天是奶奶的生日，我们一起去饭馆。我说：我们点鱼和肉吧。弟弟想跑，奶奶说：别跑，慢慢走。然后她高兴地笑了。",
      "pinyin": "Wǒ cóngxiǎo gēn nǎinai zhù zài yìqǐ. Jīntiān shì nǎinai de shēngrì, wǒmen yìqǐ qù fànguǎn. Wǒ shuō: Wǒmen diǎn yú hé ròu ba. Dìdi xiǎng pǎo, nǎinai shuō: Bié pǎo, mànmàn zǒu. Ránhòu tā gāoxìng de xiào le.",
      "meaning": "Tôi sống với bà nội từ nhỏ. Hôm nay sinh nhật bà, chúng tôi cùng đến quán ăn. Tôi nói: Gọi cá và thịt nhé. Em trai muốn chạy, bà nói: Đừng chạy, đi chậm thôi. Rồi bà vui vẻ cười.",
      "readingMinutes": 2
    },
