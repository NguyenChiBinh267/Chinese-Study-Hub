  "blocks": [
    {
      "id": "l468-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 双方 shuāngfāng: hai bên; 发言 fāyán: phát biểu; 替 tì: thay cho.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l468-t0",
      "type": "teaching",
      "title": "互相 · lẫn nhau",
      "text": "互相 cần hành động giữa từ hai bên; khác 自己 tự làm.",
      "hanzi": "大家互相介绍。",
      "pinyin": "Dàjiā hùxiāng jièshào.",
      "meaning": "Mọi người giới thiệu với nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l468-t1",
      "type": "teaching",
      "title": "对方 · đối phương, bên kia",
      "text": "对方 là người/nhóm phía bên kia trong giao tiếp, không nhất thiết đối thủ.",
      "hanzi": "先听听对方的想法。",
      "pinyin": "Xiān tīngting duìfāng de xiǎngfǎ.",
      "meaning": "Hãy nghe suy nghĩ bên kia trước.",
      "readingMinutes": 1
    },
    {
      "id": "l468-t2",
      "type": "teaching",
      "title": "点头 · gật đầu",
      "text": "点头 có thể báo đã nghe, chưa chắc luôn là đồng ý; cần hỏi rõ ngữ cảnh.",
      "hanzi": "她点头表示听见了。",
      "pinyin": "Tā diǎntóu biǎoshì tīngjiàn le.",
      "meaning": "Cô gật đầu cho biết đã nghe.",
      "readingMinutes": 1
    },
    {
      "id": "l468-t3",
      "type": "teaching",
      "title": "喊 · gọi to, hét",
      "text": "喊 nói âm lượng lớn, có thể do khoảng cách; không mặc định tức giận.",
      "hanzi": "他在门外喊我的名字。",
      "pinyin": "Tā zài mén wài hǎn wǒ de míngzi.",
      "meaning": "Anh gọi to tên tôi ngoài cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l468-t4",
      "type": "teaching",
      "title": "活泼 · hoạt bát",
      "text": "活泼 tả tính cách/sinh hoạt sinh động, không đồng nghĩa lịch sự hơn người trầm. Nhận diện chữ 泼 trong 活泼; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个孩子很活泼。",
      "pinyin": "Zhè ge háizi hěn huópō.",
      "meaning": "Đứa trẻ hoạt bát.",
      "readingMinutes": 1
    },
    {
      "id": "l468-t5",
      "type": "teaching",
      "title": "姑娘 · cô gái",
      "text": "姑娘 gū niang là cách gọi cô gái, sắc thái tùy vùng/ngữ cảnh; bài dùng kể chuyện, không áp làm xưng hô mọi nơi.",
      "hanzi": "那位姑娘正在介绍自己。",
      "pinyin": "Nà wèi gūniang zhèngzài jièshào zìjǐ.",
      "meaning": "Cô gái ấy đang tự giới thiệu.",
      "readingMinutes": 1
    },
    {
      "id": "l468-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "相互 tương tự 互相, nêu hành động qua lại giữa nhiều bên: 双方要相互理解. Không dùng để biến một người thành nhiều người. Câu sắp xếp giữ chủ ngữ 双方 trước 要 để tránh di chuyển trạng ngữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l468-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "新小组里，一位活泼的姑娘主动介绍自己，大家互相认识。门外有人喊她的名字，她先向对方点头，表示听见了。回来后，她问安静的同学想不想发言，没有替他回答。老师说：“双方要相互理解，也要给别人时间。”",
      "pinyin": "Xīn xiǎozǔ lǐ, yí wèi huópō de gūniang zhǔdòng jièshào zìjǐ, dàjiā hùxiāng rènshi. Mén wài yǒu rén hǎn tā de míngzi, tā xiān xiàng duìfāng diǎntóu, biǎoshì tīngjiàn le. Huí lái hòu, tā wèn ānjìng de tóngxué xiǎng bu xiǎng fāyán, méiyǒu tì tā huídá. Lǎoshī shuō: “Shuāngfāng yào xiānghù lǐjiě, yě yào gěi biérén shíjiān.”",
      "meaning": "Cô gái hoạt bát giới thiệu mình, gật đầu để báo nghe người gọi, rồi hỏi bạn ít nói có muốn phát biểu thay vì trả lời hộ. Thầy nhắc hiểu nhau và cho người khác thời gian.",
      "readingMinutes": 2
    },
