  "blocks": [
    {
      "id": "l478-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 手工 shǒugōng: thủ công; 示范 shìfàn: làm mẫu; 重做 chóng zuò: làm lại; 失误 shīwù: sơ suất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l478-t0",
      "type": "teaching",
      "title": "对面 · đối diện",
      "text": "对面 nói phía bên kia/đối diện, không phải đối phương 对方.",
      "hanzi": "材料放在对面的桌子上。",
      "pinyin": "Cáiliào fàng zài duìmiàn de zhuōzi shàng.",
      "meaning": "Vật liệu ở bàn đối diện.",
      "readingMinutes": 1
    },
    {
      "id": "l478-t1",
      "type": "teaching",
      "title": "活 · việc làm, công việc",
      "text": "活 huó trong 干活、这点儿活 là việc lao động, không phải huo nhẹ của 生活.",
      "hanzi": "这点儿活我们一起做。",
      "pinyin": "Zhè diǎnr huó wǒmen yìqǐ zuò.",
      "meaning": "Chút việc này chúng ta cùng làm.",
      "readingMinutes": 1
    },
    {
      "id": "l478-t2",
      "type": "teaching",
      "title": "火 · lửa",
      "text": "火 ở bài chỉ ngọn lửa/nguồn nhiệt; ví dụ không hướng dẫn dùng lửa thật.",
      "hanzi": "这个实验不用火。",
      "pinyin": "Zhè ge shíyàn bú yòng huǒ.",
      "meaning": "Thí nghiệm này không dùng lửa.",
      "readingMinutes": 1
    },
    {
      "id": "l478-t3",
      "type": "teaching",
      "title": "掉 · rơi, rớt",
      "text": "掉 trong 掉到地上 nói mất vị trí/rơi; cũng có bổ ngữ 掉 chưa bao quát ở đây. Nhận diện chữ 掉 trong 掉; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "一张纸掉到地上了。",
      "pinyin": "Yì zhāng zhǐ diào dào dì shàng le.",
      "meaning": "Tờ giấy rơi xuống đất.",
      "readingMinutes": 1
    },
    {
      "id": "l478-t4",
      "type": "teaching",
      "title": "动作 · động tác",
      "text": "动作 là hành động/cử động cụ thể; khác 活动 là hoạt động tổng thể.",
      "hanzi": "老师先示范动作。",
      "pinyin": "Lǎoshī xiān shìfàn dòngzuò.",
      "meaning": "Thầy làm mẫu động tác trước.",
      "readingMinutes": 1
    },
    {
      "id": "l478-t5",
      "type": "teaching",
      "title": "留 · giữ, để lại",
      "text": "留 trong 留一点儿材料 nói giữ phần cho sau; khác 流 là chảy.",
      "hanzi": "请留一点儿材料。",
      "pinyin": "Qǐng liú yìdiǎnr cáiliào.",
      "meaning": "Hãy giữ lại chút vật liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l478-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "顿 ngoài đếm bữa ăn còn đếm một đợt hành động như 批评一顿. Bài chỉ luyện một ví dụ có giải thích: 老师没有批评他一顿，而是让他重做. Không khuyến khích phê bình nặng; phân biệt lượng từ với 一次 trong cách dùng khác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l478-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "手工课上，老师先示范动作。对面的桌子上放着纸和绳子，这个练习不用火。小唐不小心让一张纸掉到地上。老师没有批评他一顿，而是让他重做。大家一起把活做完，还留一点儿材料给下一组。",
      "pinyin": "Shǒugōng kè shàng, lǎoshī xiān shìfàn dòngzuò. Duìmiàn de zhuōzi shàng fàngzhe zhǐ hé shéngzi, zhè ge liànxí bú yòng huǒ. Xiǎo Táng bù xiǎoxīn ràng yì zhāng zhǐ diào dào dì shàng. Lǎoshī méiyǒu pīpíng tā yí dùn, ér shì ràng tā chóng zuò. Dàjiā yìqǐ bǎ huó zuò wán, hái liú yìdiǎnr cáiliào gěi xià yì zǔ.",
      "meaning": "Giờ thủ công dùng giấy và dây, không dùng lửa. Đường làm rơi giấy, thầy cho làm lại thay vì trách một trận. Nhóm hoàn tất và giữ vật liệu cho nhóm sau.",
      "readingMinutes": 2
    },
