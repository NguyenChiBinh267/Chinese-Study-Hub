  "blocks": [
    {
      "id": "l4061-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t0",
      "type": "teaching",
      "title": "距离 · khoảng cách",
      "text": "距离 ở đây là quãng đường giữa hai nơi. Nhận diện chữ 距 trong 距离; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "两站之间的距离不远。",
      "pinyin": "Liǎng zhàn zhī jiān de jù lí bù yuǎn.",
      "meaning": "Khoảng cách giữa hai trạm không xa.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t1",
      "type": "teaching",
      "title": "速度 · tốc độ",
      "text": "速度 chỉ mức nhanh chậm, không phải tổng thời gian.",
      "hanzi": "雨天车速慢，速度不能太快。",
      "pinyin": "Yǔ tiān chē sù màn, sù dù bù néng tài kuài.",
      "meaning": "Trời mưa xe đi chậm, tốc độ không thể quá nhanh.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t2",
      "type": "teaching",
      "title": "左右 · khoảng; xấp xỉ",
      "text": "左右 sau số lượng biểu thị ước lượng, không phải bên trái/phải trong câu này.",
      "hanzi": "原来估计十分钟左右到。",
      "pinyin": "Yuán lái gū jì shí fēn zhōng zuǒ yòu dào.",
      "meaning": "Ban đầu ước tính đến sau khoảng mười phút.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t3",
      "type": "teaching",
      "title": "以内 · trong phạm vi; không quá",
      "text": "以内 đặt giới hạn, ở đây nói thời gian tối đa.",
      "hanzi": "十分钟以内恐怕到不了。",
      "pinyin": "Shí fēn zhōng yǐ nèi kǒng pà dào bu liǎo.",
      "meaning": "E rằng không thể đến trong mười phút.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t4",
      "type": "teaching",
      "title": "至少 · ít nhất",
      "text": "至少 nêu cận dưới; có thể cần lâu hơn.",
      "hanzi": "现在至少需要十五分钟。",
      "pinyin": "Xiàn zài zhì shǎo xū yào shí wǔ fēn zhōng.",
      "meaning": "Giờ cần ít nhất mười lăm phút.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-t5",
      "type": "teaching",
      "title": "准 · chính xác",
      "text": "准 ở đây mô tả đồng hồ chạy đúng, không phải 准备.",
      "hanzi": "我的表走得很准。",
      "pinyin": "Wǒ de biǎo zǒu de hěn zhǔn.",
      "meaning": "Đồng hồ tôi chạy rất chính xác.",
      "readingMinutes": 1
    },
    {
      "id": "l4061-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 nêu căn cứ đã biết, 就 dẫn cách xử lý. Khoảng ước lượng 左右 không phải lời hứa; 至少 là cận dưới, 以内 là giới hạn trên.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4061-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "两站距离不远，原来估计十分钟左右到。下雨后速度变慢，现在至少需要十五分钟，十分钟以内到不了。小林的表走得很准。他说：“既然车慢了，我们就告诉朋友新的时间。”",
      "pinyin": "Liǎng zhàn jù lí bù yuǎn, yuán lái gū jì shí fēn zhōng zuǒ yòu dào. Xià yǔ hòu sù dù biàn màn, xiàn zài zhì shǎo xū yào shí wǔ fēn zhōng, shí fēn zhōng yǐ nèi dào bu liǎo. Xiǎo Lín de biǎo zǒu de hěn zhǔn. Tā shuō: “Jì rán chē màn le, wǒ men jiù gào su péng you xīn de shí jiān.”",
      "meaning": "Mưa làm chậm chuyến xe, nên nhóm báo lại giờ đến. Đây là số liệu hư cấu trong truyện.",
      "readingMinutes": 2
    },
    {
