  "blocks": [
    {
      "id": "l113-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l113-t0",
      "type": "teaching",
      "title": "口 · người (lượng từ đếm thành viên gia đình)",
      "text": "口 trong 三口人 là lượng từ, không dịch là ba cái miệng; ở ngữ cảnh khác 口 có thể chỉ miệng.",
      "hanzi": "我家有三口人。",
      "pinyin": "Wǒ jiā yǒu sān kǒu rén.",
      "meaning": "Gia đình tôi có ba người.",
      "readingMinutes": 1
    },
    {
      "id": "l113-t1",
      "type": "teaching",
      "title": "有 · có",
      "text": "有 nói có/sở hữu trong mẫu chủ thể + 有 + đối tượng, không dùng 是 thay cho 有.",
      "hanzi": "我有一个朋友。",
      "pinyin": "Wǒ yǒu yí ge péng you.",
      "meaning": "Tôi có một người bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l113-t2",
      "type": "teaching",
      "title": "和 · và",
      "text": "和 nối các danh từ như bố và mẹ; không nhất thiết dịch mọi chữ “và” bằng 和.",
      "hanzi": "我爸爸和我妈妈喜欢茶。",
      "pinyin": "Wǒ bà ba hé wǒ mā ma xǐ huan chá.",
      "meaning": "Bố và mẹ tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l113-t3",
      "type": "teaching",
      "title": "女儿 · con gái",
      "text": "女儿 là con gái của ai, khác 妹妹 em gái; 儿 ở đây là âm ér riêng, không đọc kiểu hóa r.",
      "hanzi": "她是我女儿。",
      "pinyin": "Tā shì wǒ nǚ ér.",
      "meaning": "Cô bé là con gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l113-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有 biểu thị có/sở hữu: 我有一个女儿。Phủ định là 没有, không dùng 不有 trong mẫu này; 没有 được chú giải và sẽ học riêng. 家 có thể đi với 口 để đếm người: 我家有三口人. 和 nối các danh từ được liệt kê, không dùng nó để nối tùy ý mọi hai câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l113-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你家有几口人？\nB：我家有三口人。\nA：谁？\nB：我爸爸、我妈妈和我。",
      "pinyin": "A: Nǐ jiā yǒu jǐ kǒu rén? B: Wǒ jiā yǒu sān kǒu rén. A: Shéi? B: Wǒ bà ba, wǒ mā ma hé wǒ.",
      "meaning": "几 jǐ = mấy, được chú giải để hỏi số người. B liệt kê bố, mẹ và mình, tổng cộng ba người.",
      "readingMinutes": 2
    },
