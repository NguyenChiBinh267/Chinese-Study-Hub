  "blocks": [
    {
      "id": "l368-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 图案 tú’àn: họa tiết; 耳机 ěrjī: tai nghe; 颜色 yánsè: màu sắc; 感受 gǎnshòu: cảm nhận. Nội dung âm thanh được đọc dưới dạng chữ, chưa có audio.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l368-t0",
      "type": "teaching",
      "title": "黄色 · màu vàng",
      "text": "黄色 là tên màu; 黄色的上衣 dùng 的 khi bổ nghĩa áo. Không suy ra vàng kim/chất liệu từ màu.",
      "hanzi": "这件上衣是黄色的。",
      "pinyin": "Zhè jiàn shàngyī shì huángsè de.",
      "meaning": "Áo này màu vàng.",
      "readingMinutes": 1
    },
    {
      "id": "l368-t1",
      "type": "teaching",
      "title": "蓝 · xanh lam",
      "text": "蓝 là xanh lam, khác 绿 xanh lục. 天很蓝 không phải tên màu vàng; 蓝色 là dạng danh từ màu.",
      "hanzi": "她选了蓝的那件。",
      "pinyin": "Tā xuǎn le lán de nà jiàn.",
      "meaning": "Cô ấy chọn chiếc màu xanh lam.",
      "readingMinutes": 1
    },
    {
      "id": "l368-t2",
      "type": "teaching",
      "title": "难看 · khó coi/xấu (đánh giá)",
      "text": "难看 nói ấn tượng nhìn xấu hoặc khó xử tùy cảnh; bài chỉ đánh giá mẫu áo. Không phải “khó đọc được”.",
      "hanzi": "我觉得这个图案不好看，有点儿难看。",
      "pinyin": "Wǒ juéde zhège tú’àn bù hǎokàn, yǒudiǎnr nánkàn.",
      "meaning": "Tôi thấy họa tiết này không đẹp, hơi xấu.",
      "readingMinutes": 1
    },
    {
      "id": "l368-t3",
      "type": "teaching",
      "title": "难听 · khó nghe/chói tai",
      "text": "难听 nói âm không dễ nghe hoặc lời khó chịu; không phải nghe không rõ (听不清). Đề chỉ dùng âm thanh sản phẩm.",
      "hanzi": "这个声音有点儿难听。",
      "pinyin": "Zhège shēngyīn yǒudiǎnr nántīng.",
      "meaning": "Âm này hơi khó nghe.",
      "readingMinutes": 1
    },
    {
      "id": "l368-t4",
      "type": "teaching",
      "title": "奇怪 · lạ/kỳ lạ",
      "text": "奇怪 nói khác điều trông đợi hoặc cảm thấy lạ; chưa chứng minh hỏng hay nguy hiểm. 觉得奇怪是感受，不是检测.",
      "hanzi": "我觉得这个颜色很奇怪。",
      "pinyin": "Wǒ juéde zhège yánsè hěn qíguài.",
      "meaning": "Tôi thấy màu này lạ.",
      "readingMinutes": 1
    },
    {
      "id": "l368-t5",
      "type": "teaching",
      "title": "试 · thử",
      "text": "试 là thử để xem phù hợp/hoạt động, 如 试衣服、试一下. 试了不代表一定买了.",
      "hanzi": "我想先试一下。",
      "pinyin": "Wǒ xiǎng xiān shì yíxià.",
      "meaning": "Tôi muốn thử trước.",
      "readingMinutes": 1
    },
    {
      "id": "l368-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "看上去不合适 nêu ấn tượng nhìn, khác 试了才知道说 sau thử. 难看/难听 là đánh giá chủ quan về đồ hay âm thanh trong bài, không dùng để miệt thị người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l368-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林觉得黄色上衣的图案难看，蓝的那件看上去更合适，他想先试一下。朋友试耳机，觉得声音难听，又发现颜色很奇怪。两人只说自己的感受，没有声称商品一定坏了。",
      "pinyin": "Xiǎo Lín juéde huángsè shàngyī de tú’àn nánkàn, lán de nà jiàn kàn shàngqu gèng héshì, tā xiǎng xiān shì yíxià. Péngyou shì ěrjī, juéde shēngyīn nántīng, yòu fāxiàn yánsè hěn qíguài. Liǎng rén zhǐ shuō zìjǐ de gǎnshòu, méiyǒu shēngchēng shāngpǐn yídìng huài le.",
      "meaning": "Lâm thích xem thử áo xanh hơn họa tiết áo vàng. Bạn thử tai nghe, thấy âm khó nghe và màu lạ. Họ nêu cảm nhận, chưa kết luận sản phẩm hỏng.",
      "readingMinutes": 2
    },
    {
