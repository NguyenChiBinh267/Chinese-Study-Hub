  "blocks": [
    {
      "id": "l152-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l152-t0",
      "type": "teaching",
      "title": "点 · giờ; điểm giờ (lượng từ đồng hồ)",
      "text": "点 trong 三点 là giờ đồng hồ; không dạy nghĩa gọi món/chấm điểm ở đây.",
      "hanzi": "现在三点。",
      "pinyin": "Xiàn zài sān diǎn.",
      "meaning": "Bây giờ3giờ trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l152-t1",
      "type": "teaching",
      "title": "分 · phút (mục fēn)",
      "text": "分 trong 三点十分 là phần phút của giờ; câu hỏi âm fēn phân biệt với 分钟.",
      "hanzi": "现在三点十分。",
      "pinyin": "Xiàn zài sān diǎn shí fēn.",
      "meaning": "Bây giờ3giờ10phút trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l152-t2",
      "type": "teaching",
      "title": "分钟 · phút (khoảng thời gian, dạng fēnzhōng)",
      "text": "分钟 trong 五分钟 là khoảng năm phút, không tự nói phút thứ5 của một giờ.",
      "hanzi": "我休息五分钟。",
      "pinyin": "Wǒ xiū xi wǔ fēn zhōng.",
      "meaning": "Tôi nghỉ năm phút.",
      "readingMinutes": 1
    },
    {
      "id": "l152-t3",
      "type": "teaching",
      "title": "小时 · giờ; tiếng (khoảng thời gian)",
      "text": "小时 đếm thời lượng; 一小时 và 一个小时 đều có thể dùng, khác thời điểm 一点.",
      "hanzi": "我上课一小时。",
      "pinyin": "Wǒ shàng kè yì xiǎo shí.",
      "meaning": "Tôi học trên lớp một giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l152-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Giờ trên đồng hồ dùng số + 点; phút dùng số + 分: 三点十分 là3giờ10phút. 分钟/小时 thường nói khoảng thời gian như 五分钟/一小时; không trộn 三点十分 với một khoảng ba giờ. Đoạn là giờ trong truyện, không phải số giờ đã học được hệ thống đo.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l152-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：现在几点？\nB：三点十分。\nA：你什么时候上课？\nB：三点上课，我上课一小时。",
      "pinyin": "A: Xiàn zài jǐ diǎn? B: Sān diǎn shí fēn. A: Nǐ shén me shí hou shàng kè? B: Sān diǎn shàng kè, wǒ shàng kè yì xiǎo shí.",
      "meaning": "Câu chuyện nói giờ hiện tại3:10, giờ bắt đầu học3:00 và thời lượng một giờ. Không phải dữ liệu đồng hồ hoặc telemetry thật.",
      "readingMinutes": 2
    },
