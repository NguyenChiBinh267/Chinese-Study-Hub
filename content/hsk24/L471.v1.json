  "blocks": [
    {
      "id": "l471-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 长度 chángdù: chiều dài; 重量 zhòngliàng: khối lượng; 换算 huànsuàn: quy đổi; 准确 zhǔnquè: chính xác. Không cung cấp quy tắc đo/giá hiện hành.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l471-t0",
      "type": "teaching",
      "title": "克 · gam",
      "text": "克 là đơn vị khối lượng gam; không nhầm 公斤 bằng 1000 gam.",
      "hanzi": "这袋茶叶重一百克。",
      "pinyin": "Zhè dài cháyè zhòng yìbǎi kè.",
      "meaning": "Túi trà này nặng một trăm gam.",
      "readingMinutes": 1
    },
    {
      "id": "l471-t1",
      "type": "teaching",
      "title": "量 · đo",
      "text": "量 liáng là động từ đo; khác liàng trong 数量. Bài dùng 量长度. Nhận diện chữ 量 trong 量; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请量一下盒子的长度。",
      "pinyin": "Qǐng liáng yíxià hézi de chángdù.",
      "meaning": "Hãy đo chiều dài hộp.",
      "readingMinutes": 1
    },
    {
      "id": "l471-t2",
      "type": "teaching",
      "title": "两 · lạng (đơn vị khối lượng)",
      "text": "两2 liǎng là đơn vị truyền thống; bài chưa quy đổi nếu không nêu hệ đo và không coi số2 là chữ phải gõ.",
      "hanzi": "店员把重量写成几两。",
      "pinyin": "Diànyuán bǎ zhòngliàng xiě chéng jǐ liǎng.",
      "meaning": "Người bán ghi khối lượng bằng mấy lạng.",
      "readingMinutes": 1
    },
    {
      "id": "l471-t3",
      "type": "teaching",
      "title": "零花钱 · tiền tiêu vặt",
      "text": "零花钱 là khoản nhỏ dành chi tiêu cá nhân; không phải tất cả tiền tiết kiệm.",
      "hanzi": "他用零花钱买书。",
      "pinyin": "Tā yòng línghuāqián mǎi shū.",
      "meaning": "Cậu dùng tiền tiêu vặt mua sách.",
      "readingMinutes": 1
    },
    {
      "id": "l471-t4",
      "type": "teaching",
      "title": "零钱 · tiền lẻ",
      "text": "零钱 là tiền mệnh giá nhỏ/tiền thừa để trả, khác 零花钱 là nguồn/mục đích tiền.",
      "hanzi": "我带了一些零钱。",
      "pinyin": "Wǒ dài le yìxiē língqián.",
      "meaning": "Tôi mang ít tiền lẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l471-t5",
      "type": "teaching",
      "title": "另 · khác, nữa",
      "text": "另 đứng trong 另一个、另买, cần phần đi sau; không nhất thiết đứng riêng như 另外.",
      "hanzi": "我想看另一个盒子。",
      "pinyin": "Wǒ xiǎng kàn lìng yí ge hézi.",
      "meaning": "Tôi muốn xem hộp khác.",
      "readingMinutes": 1
    },
    {
      "id": "l471-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Số + 来 + lượng từ biểu thị xấp xỉ theo quy ước ngữ cảnh: 十来块钱 là khoảng hơn/chừng mười tệ, không phải đúng 10. Khi cần thanh toán phải hỏi giá chính xác, không suy ra hóa đơn từ số ước chừng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l471-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小东用零花钱买一袋茶叶。店员说重一百克，标签还写了“两”的单位，小东请他说明这里采用的换算。装袋前，他又量了盒子的长度，想换另一个小盒子。店员说价钱十来块钱，小东先问准确价格，再拿出零钱付款。",
      "pinyin": "Xiǎo Dōng yòng línghuāqián mǎi yí dài cháyè. Diànyuán shuō zhòng yìbǎi kè, biāoqiān hái xiě le “liǎng” de dānwèi, Xiǎo Dōng qǐng tā shuōmíng zhèlǐ cǎiyòng de huànsuàn. Zhuāng dài qián, tā yòu liáng le hézi de chángdù, xiǎng huàn lìng yí ge xiǎo hézi. Diànyuán shuō jiàqián shí lái kuài qián, Xiǎo Dōng xiān wèn zhǔnquè jiàgé, zài ná chū língqián fùkuǎn.",
      "meaning": "Đông mua trà bằng tiền tiêu vặt, hỏi rõ cách quy đổi đơn vị lạng trên nhãn. Cậu đo hộp, chọn hộp khác và hỏi giá chính xác trước khi trả tiền lẻ vì người bán mới nói giá chừng mười tệ.",
      "readingMinutes": 2
    },
    {
