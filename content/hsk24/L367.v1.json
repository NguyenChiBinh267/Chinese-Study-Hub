  "blocks": [
    {
      "id": "l367-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 打扫 dǎsǎo: dọn dẹp; 干净 gānjìng: sạch; 袋子 dàizi: túi; 价签 jiàqiān: nhãn giá; 列 liè: cột; 距离 jùlí: khoảng cách.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l367-t0",
      "type": "teaching",
      "title": "屋子 · căn phòng/nhà (không gian trong)",
      "text": "屋子 nói căn phòng hoặc nhà theo ngữ cảnh; 这间屋子 chỉ không gian bên trong, không phải cả 小区.",
      "hanzi": "这间屋子要打扫。",
      "pinyin": "Zhè jiān wūzi yào dǎsǎo.",
      "meaning": "Phòng này cần dọn.",
      "readingMinutes": 1
    },
    {
      "id": "l367-t1",
      "type": "teaching",
      "title": "箱子 · hộp/thùng/va li",
      "text": "箱子 là vật chứa đồ dạng thùng/hộp/va li theo cảnh; không tự biết có bánh xe hay không từ tên chung.",
      "hanzi": "请把书放进箱子。",
      "pinyin": "Qǐng bǎ shū fàng jìn xiāngzi.",
      "meaning": "Hãy cho sách vào thùng.",
      "readingMinutes": 1
    },
    {
      "id": "l367-t2",
      "type": "teaching",
      "title": "扫 · quét",
      "text": "扫 trong 扫地 là quét sàn; chưa dạy quét mã hay mọi nghĩa số hóa. 扫干净 nói quét sạch theo kết quả.",
      "hanzi": "他把地扫干净了。",
      "pinyin": "Tā bǎ dì sǎo gānjìng le.",
      "meaning": "Anh ấy quét sạch sàn rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l367-t3",
      "type": "teaching",
      "title": "米 · mét",
      "text": "米 ở 两米 là đơn vị mét, khác 米 trong gạo nếu đổi ngữ cảnh. Không nhầm 公斤 khối lượng.",
      "hanzi": "桌子离门有两米。",
      "pinyin": "Zhuōzi lí mén yǒu liǎng mǐ.",
      "meaning": "Bàn cách cửa hai mét.",
      "readingMinutes": 1
    },
    {
      "id": "l367-t4",
      "type": "teaching",
      "title": "斤 · cân (đơn vị 0,5 kg theo chuẩn bài)",
      "text": "斤 trong nhãn đại lục ở đây bằng nửa kg; chuẩn địa phương khác có thể khác nên không áp toàn cầu. 一斤不是一公斤.",
      "hanzi": "袋子上写着一斤。",
      "pinyin": "Dàizi shàng xiě zhe yì jīn.",
      "meaning": "Trên túi ghi một cân (0,5 kg theo chuẩn bài).",
      "readingMinutes": 1
    },
    {
      "id": "l367-t5",
      "type": "teaching",
      "title": "毛 · hào (khẩu ngữ, 1/10 元)",
      "text": "毛 ở 两毛钱 là đơn vị tiền khẩu ngữ, bằng 角 trong hệ nhãn đang kể; chưa dạy nghĩa lông. Không lấy tiền làm khối lượng.",
      "hanzi": "这个小袋子两毛钱。",
      "pinyin": "Zhège xiǎo dàizi liǎng máo qián.",
      "meaning": "Túi nhỏ này giá hai hào.",
      "readingMinutes": 1
    },
    {
      "id": "l367-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把地扫干净 nêu đối tượng và kết quả sạch. 米、斤、毛 lần lượt dùng đo độ dài, khối lượng và tiền trong nhãn hư cấu; không đổi lẫn đơn vị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l367-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "搬家前，小林把屋子里的地扫干净，把书放进箱子。箱子离门两米。旁边的袋子标着一斤，另一个小袋子的价签是两毛钱。米、斤、毛不能放在同一列相加。",
      "pinyin": "Bān jiā qián, Xiǎo Lín bǎ wūzi lǐ de dì sǎo gānjìng, bǎ shū fàng jìn xiāngzi. Xiāngzi lí mén liǎng mǐ. Pángbiān de dàizi biāo zhe yì jīn, lìng yí ge xiǎo dàizi de jiàqiān shì liǎng máo qián. Mǐ, jīn, máo bù néng fàng zài tóng yí liè xiāngjiā.",
      "meaning": "Trước chuyển nhà Lâm quét phòng và đóng sách vào thùng cách cửa hai mét. Túi bên cạnh ghi một cân; túi nhỏ khác ghi giá hai hào. Không cộng các đơn vị khác đại lượng.",
      "readingMinutes": 2
    },
    {
      "id": "l367-b0",
      "type": "exercise",
      "exerciseVersionId": "l367-v1-e0"
