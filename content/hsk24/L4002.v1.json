  "blocks": [
    {
      "id": "l4002-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t0",
      "type": "teaching",
      "title": "皮肤 · da",
      "text": "皮肤 là lớp da trên cơ thể; không phải vỏ quả trong ngữ cảnh này. Nhận diện chữ 肤 trong 皮肤; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "天气干燥，我的皮肤很干。",
      "pinyin": "Tiān qì gān zào, wǒ de pí fū hěn gān.",
      "meaning": "Trời hanh khô, da tôi rất khô.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t1",
      "type": "teaching",
      "title": "气 · hơi; khí",
      "text": "Trong 喘气, 气 chỉ hơi thở; không dùng nghĩa tức giận của 生气 ở câu này.",
      "hanzi": "他停下来喘了一口气。",
      "pinyin": "Tā tíng xià lái chuǎn le yì kǒu qì.",
      "meaning": "Anh ấy dừng lại thở một hơi.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t2",
      "type": "teaching",
      "title": "全身 · toàn thân",
      "text": "全身 nói khắp cơ thể một người; không chỉ một bộ phận.",
      "hanzi": "走完山路，我全身都是汗。",
      "pinyin": "Zǒu wán shān lù, wǒ quán shēn dōu shì hàn.",
      "meaning": "Đi hết đường núi, tôi ướt mồ hôi khắp người.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t3",
      "type": "teaching",
      "title": "脾气 · tính khí",
      "text": "脾气 nói tính nóng/lành trong cách phản ứng; không phải cơ quan nội tạng trong từ này.",
      "hanzi": "她脾气很好，从不乱发火。",
      "pinyin": "Tā pí qi hěn hǎo, cóng bù luàn fā huǒ.",
      "meaning": "Cô ấy tính rất hiền, không nổi nóng vô cớ.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t4",
      "type": "teaching",
      "title": "强 · mạnh",
      "text": "强 là tính từ mạnh về sức lực/cường độ; 对手很强 không có nghĩa đối thủ nặng cân.",
      "hanzi": "今天的风很强。",
      "pinyin": "Jīn tiān de fēng hěn qiáng.",
      "meaning": "Gió hôm nay rất mạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-t5",
      "type": "teaching",
      "title": "轻 · nhẹ",
      "text": "轻 nói trọng lượng nhẹ trong câu này; không phải mức bệnh nặng/nhẹ.",
      "hanzi": "这个背包很轻。",
      "pinyin": "Zhè ge bēi bāo hěn qīng.",
      "meaning": "Chiếc ba lô này rất nhẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l4002-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "够 + tính từ + 的 nhấn mạnh mức độ khá cao trong nhận xét khẩu ngữ, như 这段路够长的 (đoạn đường này dài ra phết). Khác 够 dùng để nói đủ số lượng. Đây là tình huống hư cấu, không phải tư vấn sức khỏe.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4002-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小陈背着很轻的包走山路。风很强，天气也干燥，他觉得皮肤有点儿干。到了山顶，他全身都是汗，停下来喘气。朋友问他累不累。他笑着说：“这段路够长的，不过风景很好。”朋友觉得他脾气真好。",
      "pinyin": "Xiǎo Chén bēi zhe hěn qīng de bāo zǒu shān lù. Fēng hěn qiáng, tiān qì yě gān zào, tā jué de pí fū yǒu diǎnr gān. Dào le shān dǐng, tā quán shēn dōu shì hàn, tíng xià lái chuǎn qì. Péng you wèn tā lèi bu lèi. Tā xiào zhe shuō: “Zhè duàn lù gòu cháng de, bú guò fēng jǐng hěn hǎo.” Péng you jué de tā pí qi zhēn hǎo.",
      "meaning": "Tiểu Trần thấy đường dài và mệt nhưng vẫn vui vẻ ngắm cảnh; ba lô nhẹ, gió mạnh.",
      "readingMinutes": 2
    },
