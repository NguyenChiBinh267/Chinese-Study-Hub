  "blocks": [
    {
      "id": "l398-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder0",
      "type": "teaching",
      "title": "担心 · lo lắng",
      "text": "担心 diễn tả lo về người/việc, như 担心朋友. Cảm xúc lo không phải bằng chứng xác nhận nguy hiểm hoặc chẩn đoán.",
      "hanzi": "妈妈很担心我。",
      "pinyin": "Māma hěn dānxīn wǒ.",
      "meaning": "Mẹ lo cho tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder1",
      "type": "teaching",
      "title": "健康 · khỏe mạnh/sức khỏe tốt",
      "text": "健康 trong 身体健康 miêu tả khỏe. Bài học không chứng nhận sức khỏe hoặc khẳng định hết sốt là đã khỏe hoàn toàn.",
      "hanzi": "我们都希望家人身体健康。",
      "pinyin": "Wǒmen dōu xīwàng jiārén shēntǐ jiànkāng.",
      "meaning": "Chúng tôi đều mong người nhà khỏe mạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder2",
      "type": "teaching",
      "title": "锻炼 · rèn luyện/tập luyện",
      "text": "锻炼 chỉ rèn luyện cơ thể hay năng lực tùy tân ngữ. 这次锻炼 dùng trong kế hoạch cá nhân, không là đơn thuốc hay thời lượng khuyến nghị.",
      "hanzi": "我想每天找一点儿时间锻炼。",
      "pinyin": "Wǒ xiǎng měi tiān zhǎo yìdiǎnr shíjiān duànliàn.",
      "meaning": "Tôi muốn tìm một chút thời gian mỗi ngày để tập luyện.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder3",
      "type": "teaching",
      "title": "坚持 · kiên trì/duy trì",
      "text": "坚持 nói tiếp tục làm theo điều đã chọn. Không mặc nhiên diễn tả rằng tiếp tục bất kỳ hoạt động nào cũng phù hợp hoặc tốt.",
      "hanzi": "我想坚持这个学习计划。",
      "pinyin": "Wǒ xiǎng jiānchí zhège xuéxí jìhuà.",
      "meaning": "Tôi muốn duy trì kế hoạch học này.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder4",
      "type": "teaching",
      "title": "必须 · nhất thiết/phải",
      "text": "必须 nhấn việc bắt buộc theo yêu cầu đã nêu. Phải biết ai đặt yêu cầu và phạm vi; không nâng mọi lời khuyên thành luật chung.",
      "hanzi": "老师说，参加活动必须先报名。",
      "pinyin": "Lǎoshī shuō, cānjiā huódòng bìxū xiān bàomíng.",
      "meaning": "Thầy nói tham gia hoạt động phải đăng ký trước.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder5",
      "type": "teaching",
      "title": "不用 · không cần",
      "text": "不用 phủ nhận sự cần thiết, không tự động là cấm. 不用买票 không cần mua vé; khác 不能买票 không được/không thể mua.",
      "hanzi": "这个活动不用买票。",
      "pinyin": "Zhège huódòng búyòng mǎi piào.",
      "meaning": "Hoạt động này không cần mua vé.",
      "readingMinutes": 1
    },
    {
      "id": "l398-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "……的话，就…… đặt giả định trước kết quả/hành động trong tình huống. 你不舒服的话，就告诉我 là lời đề nghị báo thông tin, không phải một chẩn đoán.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l398-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "医生：你哪里不舒服？小安：我昨天发烧，朋友说可能是感冒。妈妈很担心。医生：先说说你的情况，我再检查。小安：我想早点儿好起来。医生：有什么不舒服的话，就告诉我。",
      "pinyin": "Yīshēng: Nǐ nǎli bù shūfu? Xiǎo Ān: Wǒ zuótiān fāshāo, péngyou shuō kěnéng shì gǎnmào. Māma hěn dānxīn. Yīshēng: Xiān shuōshuo nǐ de qíngkuàng, wǒ zài jiǎnchá. Xiǎo Ān: Wǒ xiǎng zǎo diǎnr hǎo qǐlái. Yīshēng: Yǒu shénme bù shūfu dehuà, jiù gàosu wǒ.",
      "meaning": "Bác sĩ hỏi An khó chịu ở đâu. An kể sốt hôm qua, bạn cho rằng có thể là cảm; mẹ lo lắng. Bác sĩ muốn nghe tình trạng rồi kiểm tra. Đây là hội thoại học ngôn ngữ, chưa có kết luận bệnh hay chỉ dẫn điều trị.",
      "readingMinutes": 2
    },
