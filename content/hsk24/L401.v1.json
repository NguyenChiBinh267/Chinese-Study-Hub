  "blocks": [
    {
      "id": "l401-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 说明 shuōmíng: hướng dẫn; 填 tián: điền; 姓名 xìngmíng: họ tên; 栏 lán: cột/mục; 录取 lùqǔ: được nhận; 规则 guīzé: quy tắc. Ví dụ hư cấu, không nhập dữ liệu thật hay gửi đơn. HSK3 đã có dạy từ vựng nháp, các kỹ năng khác và duyệt ngôn ngữ vẫn thiếu. Có thể đọc lại L375 về điều kiện, L384 về lời khuyên, L357 về kế hoạch học; không tự cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l401-t0",
      "type": "teaching",
      "title": "安排 · sắp xếp/bố trí",
      "text": "安排 là bố trí công việc/thời gian, có thể nhận tân ngữ như 时间、活动. 已安排 không tự là đã diễn ra.",
      "hanzi": "我们先安排报名时间。",
      "pinyin": "Wǒmen xiān ānpái bàomíng shíjiān.",
      "meaning": "Chúng tôi sắp xếp thời gian đăng ký trước.",
      "readingMinutes": 1
    },
    {
      "id": "l401-t1",
      "type": "teaching",
      "title": "按时 · đúng giờ/đúng hạn",
      "text": "按时 đứng trước động từ chỉ đúng thời gian đã hẹn/quy định, khác 及时 là kịp lúc ở ngữ cảnh khác. Cần biết mốc được nêu.",
      "hanzi": "请按时来，不要迟到。",
      "pinyin": "Qǐng ànshí lái, bú yào chídào.",
      "meaning": "Hãy đến đúng giờ, đừng đến muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l401-t2",
      "type": "teaching",
      "title": "按照 · theo/chiếu theo",
      "text": "按照 dẫn quy tắc/hướng dẫn làm căn cứ; không có nghĩa theo giờ như 按时. 这里按照说明是依照说明做.",
      "hanzi": "请按照说明填表。",
      "pinyin": "Qǐng ànzhào shuōmíng tián biǎo.",
      "meaning": "Hãy điền mẫu theo hướng dẫn.",
      "readingMinutes": 1
    },
    {
      "id": "l401-t3",
      "type": "teaching",
      "title": "报名 · đăng ký tham gia",
      "text": "报名 là ghi danh hoạt động/khóa/thi, chưa chứng minh được nhận hay đã đạt. 报名参加 đi với hoạt động.",
      "hanzi": "我想报名参加阅读活动。",
      "pinyin": "Wǒ xiǎng bàomíng cānjiā yuèdú huódòng.",
      "meaning": "Tôi muốn đăng ký hoạt động đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l401-t4",
      "type": "teaching",
      "title": "表 · bảng/biểu mẫu (danh từ ở bài)",
      "text": "表 ở 填表 là biểu mẫu để điền, khác 手表 là đồng hồ. Bài không dạy mọi nghĩa động từ của 表.",
      "hanzi": "这张表要填姓名和日期。",
      "pinyin": "Zhè zhāng biǎo yào tián xìngmíng hé rìqī.",
      "meaning": "Mẫu này cần điền họ tên và ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l401-t5",
      "type": "teaching",
      "title": "表格 · bảng biểu/biểu mẫu có ô",
      "text": "表格 nhấn cách chia ô/hàng/cột để ghi thông tin; có thể gần 表 trong một số câu. Đề yêu cầu đúng dạng hai chữ khi truy hồi.",
      "hanzi": "请把日期写在表格里。",
      "pinyin": "Qǐng bǎ rìqī xiě zài biǎogé lǐ.",
      "meaning": "Hãy viết ngày vào biểu mẫu.",
      "readingMinutes": 1
    },
    {
      "id": "l401-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "按照+quy định/hướng dẫn nêu căn cứ thực hiện: 按照说明填表. Khác 按时 là đúng thời gian. 按照做了 chưa tự chứng minh thông tin đúng hay đã được duyệt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l401-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林想报名参加阅读活动。工作人员先安排时间，请他按时来，并按照说明填表。表格里有姓名和日期两栏。小林填完后问是不是已经被录取，对方解释：现在只是收到这张表，还要按本次规则确认。",
      "pinyin": "Xiǎo Lín xiǎng bàomíng cānjiā yuèdú huódòng. Gōngzuò rényuán xiān ānpái shíjiān, qǐng tā ànshí lái, bìng ànzhào shuōmíng tián biǎo. Biǎogé lǐ yǒu xìngmíng hé rìqī liǎng lán. Xiǎo Lín tián wán hòu wèn shì bu shì yǐjīng bèi lùqǔ, duìfāng jiěshì: Xiànzài zhǐshì shōudào zhè zhāng biǎo, hái yào àn běn cì guīzé quèrèn.",
      "meaning": "Lâm đăng ký hoạt động đọc. Nhân viên hẹn giờ và yêu cầu điền theo hướng dẫn; mẫu có tên và ngày. Nộp xong mới là nhận mẫu, còn phải xác nhận theo quy tắc của hoạt động.",
      "readingMinutes": 2
    },
    {
