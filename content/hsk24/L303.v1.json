  "blocks": [
    {
      "id": "l303-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc trật tự chủ ngữ–động từ–tân ngữ, 不/没 và 的; HSK1/HSK2 chưa được chứng nhận. Có thể khám phá bài nháp. 只要 zhǐyào: chỉ cần; 结果 jiéguǒ: kết quả (hỗ trợ); 一定 yídìng: chắc chắn; 最多 zuì duō: nhiều nhất. Những từ hỗ trợ không tính vào sáu mục của bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l303-t0",
      "type": "teaching",
      "title": "成绩 · kết quả/thành tích học tập",
      "text": "成绩 nói kết quả học hoặc công việc theo ngữ cảnh. 成绩不错 không đưa ra số điểm cụ thể, cũng không chứng minh nguyên nhân kết quả.",
      "hanzi": "这次考试的成绩不错。",
      "pinyin": "Zhè cì kǎoshì de chéngjì búcuò.",
      "meaning": "Kết quả kiểm tra lần này khá tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l303-t1",
      "type": "teaching",
      "title": "得分 · ghi/đạt điểm",
      "text": "得分 là đạt điểm theo cách chấm của hoạt động. 得 đọc dé ở đây, không phải děi nghĩa phải.",
      "hanzi": "他在比赛中得分了。",
      "pinyin": "Tā zài bǐsài zhōng défēn le.",
      "meaning": "Bạn ấy ghi được điểm trong cuộc thi.",
      "readingMinutes": 1
    },
    {
      "id": "l303-t2",
      "type": "teaching",
      "title": "比赛 · cuộc thi/thi đấu",
      "text": "比赛 có thể là danh từ cuộc thi hoặc động từ thi đấu. 本次比赛 là cuộc thi này; bài không mô phỏng đề HSK chính thức.",
      "hanzi": "我们想参加中文比赛。",
      "pinyin": "Wǒmen xiǎng cānjiā Zhōngwén bǐsài.",
      "meaning": "Chúng tôi muốn tham gia cuộc thi tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l303-t3",
      "type": "teaching",
      "title": "参加 · tham gia",
      "text": "参加 dùng với hoạt động hay tổ chức theo ngữ cảnh; không đồng nghĩa chiến thắng hoặc hoàn thành.",
      "hanzi": "你明天参加比赛吗？",
      "pinyin": "Nǐ míngtiān cānjiā bǐsài ma?",
      "meaning": "Ngày mai bạn tham gia cuộc thi không?",
      "readingMinutes": 1
    },
    {
      "id": "l303-t4",
      "type": "teaching",
      "title": "聪明 · thông minh",
      "text": "聪明 nhận xét khả năng hiểu nhanh; không đồng nghĩa mọi việc đều làm tốt hay không cần luyện. Không suy ra phẩm chất từ một điểm số.",
      "hanzi": "这个孩子很聪明，也很爱学习。",
      "pinyin": "Zhège háizi hěn cōngmíng, yě hěn ài xuéxí.",
      "meaning": "Đứa trẻ này thông minh và cũng thích học.",
      "readingMinutes": 1
    },
    {
      "id": "l303-t5",
      "type": "teaching",
      "title": "努力 · cố gắng/chăm chỉ",
      "text": "努力 có thể làm động từ cố gắng hoặc tính từ chăm chỉ. 努力学习 là cố gắng học; đây là hành động, không phải bảo đảm điểm.",
      "hanzi": "她每天都努力学习。",
      "pinyin": "Tā měi tiān dōu nǔlì xuéxí.",
      "meaning": "Ngày nào cô ấy cũng cố gắng học.",
      "readingMinutes": 1
    },
    {
      "id": "l303-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "只要 nêu điều kiện đủ trong lời quy định hoặc kế hoạch cụ thể. 只要明天不下雨，我们就参加比赛 nói kế hoạch của nhóm, không suy ra cố gắng luôn bảo đảm điểm cao. 只要 là hỗ trợ của bài, không cộng thêm từ mới.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l303-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：只要明天不下雨，我们就参加学校的中文比赛。小安：小李很聪明，一定得分最多吗？老师：不能这样说，比赛结果还不知道。小安：我会努力准备，不只看成绩。",
      "pinyin": "Lǎoshī: Zhǐyào míngtiān bú xià yǔ, wǒmen jiù cānjiā xuéxiào de Zhōngwén bǐsài. Xiǎo Ān: Xiǎo Lǐ hěn cōngmíng, yídìng défēn zuì duō ma? Lǎoshī: Bù néng zhèyàng shuō, bǐsài jiéguǒ hái bù zhīdào. Xiǎo Ān: Wǒ huì nǔlì zhǔnbèi, bù zhǐ kàn chéngjì.",
      "meaning": "Thầy nói nếu mai không mưa thì nhóm tham gia cuộc thi tiếng Trung của trường. An hỏi liệu Lý thông minh có chắc đạt nhiều điểm nhất. Thầy nói chưa biết kết quả. An sẽ cố gắng chuẩn bị, không chỉ nhìn thành tích.",
      "readingMinutes": 2
    },
    {
      "id": "l303-b0",
