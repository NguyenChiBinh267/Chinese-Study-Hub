  "blocks": [
    {
      "id": "l4057-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t0",
      "type": "teaching",
      "title": "产生 · nảy sinh; hình thành",
      "text": "产生 nói điều xuất hiện/hình thành, không chỉ sinh con. Nhận diện chữ 产 trong 产生; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个误会是怎样产生的？",
      "pinyin": "Zhè ge wù huì shì zěn yàng chǎn shēng de?",
      "meaning": "Hiểu lầm này nảy sinh thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t1",
      "type": "teaching",
      "title": "引起 · gây ra; gợi lên",
      "text": "引起 thường dẫn sự chú ý, phản ứng hoặc vấn đề.",
      "hanzi": "这件事引起了大家的注意。",
      "pinyin": "Zhè jiàn shì yǐn qǐ le dà jiā de zhù yì.",
      "meaning": "Việc này thu hút sự chú ý của mọi người.",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t2",
      "type": "teaching",
      "title": "原因 · nguyên nhân; lý do",
      "text": "原因 là danh từ, khác liên từ dẫn mệnh đề nguyên nhân.",
      "hanzi": "我们还不知道原因。",
      "pinyin": "Wǒ men hái bù zhī dào yuán yīn.",
      "meaning": "Chúng tôi vẫn chưa biết nguyên nhân.",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t3",
      "type": "teaching",
      "title": "由于 · do; bởi vì",
      "text": "由于 dẫn nguyên nhân; không thay cho 因此 dẫn kết quả.",
      "hanzi": "由于下雨，活动推迟了。",
      "pinyin": "Yóu yú xià yǔ, huó dòng tuī chí le.",
      "meaning": "Do trời mưa, hoạt động bị hoãn.",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t4",
      "type": "teaching",
      "title": "因此 · vì vậy",
      "text": "因此 nhấn quan hệ kết quả; đề yêu cầu từ chứa 此.",
      "hanzi": "他认真检查，因此发现了错误。",
      "pinyin": "Tā rèn zhēn jiǎn chá, yīn cǐ fā xiàn le cuò wù.",
      "meaning": "Anh ấy kiểm tra kỹ, vì vậy phát hiện lỗi.",
      "readingMinutes": 1
    },
    {
      "id": "l4057-t5",
      "type": "teaching",
      "title": "于是 · thế là; rồi thì",
      "text": "于是 nối diễn biến tiếp theo; đề phân biệt bằng dạng có 于, không phủ nhận mọi cách dùng 因此.",
      "hanzi": "她想听解释，于是留了下来。",
      "pinyin": "Tā xiǎng tīng jiě shì, yú shì liú le xià lái.",
      "meaning": "Cô ấy muốn nghe giải thích, thế là ở lại.",
      "readingMinutes": 1
    },
    {
      "id": "l4057-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "因此 dẫn kết quả có quan hệ với nguyên nhân; 于是 thường nhấn hành động tiếp theo. Hai từ có thể cùng hợp một số ngữ cảnh; bài giới hạn rõ từ được hỏi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4057-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "由于通知上的日期写错了，大家产生了误会。这件事引起注意，小林检查后发现原因，因此重新发了通知。小梅想听完整解释，于是留了下来。一个词说明结果，另一个词把故事往下讲。",
      "pinyin": "Yóu yú tōng zhī shàng de rì qī xiě cuò le, dà jiā chǎn shēng le wù huì. Zhè jiàn shì yǐn qǐ zhù yì, Xiǎo Lín jiǎn chá hòu fā xiàn yuán yīn, yīn cǐ chóng xīn fā le tōng zhī. Xiǎo Méi xiǎng tīng wán zhěng jiě shì, yú shì liú le xià lái. Yí ge cí shuō míng jié guǒ, lìng yí ge cí bǎ gù shi wǎng xià jiǎng.",
      "meaning": "Ngày ghi sai gây hiểu lầm; Tiểu Lâm kiểm tra rồi phát lại thông báo.",
      "readingMinutes": 2
    },
    {
