  "blocks": [
    {
      "id": "l119-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l119-t0",
      "type": "teaching",
      "title": "小学 · trường tiểu học; bậc tiểu học",
      "text": "小学 nói trường/cấp học, không phải bản thân một học sinh nhỏ.",
      "hanzi": "这是小学。",
      "pinyin": "Zhè shì xiǎo xué.",
      "meaning": "Đây là trường tiểu học.",
      "readingMinutes": 1
    },
    {
      "id": "l119-t1",
      "type": "teaching",
      "title": "小学生 · học sinh tiểu học",
      "text": "小学生 là người học tiểu học; không bỏ 生 nếu đang gọi vai trò người học.",
      "hanzi": "她是小学生。",
      "pinyin": "Tā shì xiǎo xué shēng.",
      "meaning": "Cô bé là học sinh tiểu học.",
      "readingMinutes": 1
    },
    {
      "id": "l119-t2",
      "type": "teaching",
      "title": "中学 · trường trung học; bậc trung học",
      "text": "中学 nói trường/cấp trung học; bản dịch cụ thể cần ngữ cảnh hệ giáo dục.",
      "hanzi": "那是中学。",
      "pinyin": "Nà shì zhōng xué.",
      "meaning": "Kia là trường trung học.",
      "readingMinutes": 1
    },
    {
      "id": "l119-t3",
      "type": "teaching",
      "title": "中学生 · học sinh trung học",
      "text": "中学生 gọi người học ở bậc trung học, không tự cho biết lớp mấy.",
      "hanzi": "我哥哥是中学生。",
      "pinyin": "Wǒ gē ge shì zhōng xué shēng.",
      "meaning": "Anh trai tôi là học sinh trung học.",
      "readingMinutes": 1
    },
    {
      "id": "l119-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "小学 là trường/cấp tiểu học, 小学生 là học sinh tiểu học; 中学 và 中学生 có quan hệ tương tự cho bậc trung học. Phân biệt nơi/cấp học với người học: 她是小学生, không dùng 她是小学 để giới thiệu vai trò. Không gán tuổi cố định chỉ từ tên cấp học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l119-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你妹妹是中学生吗？\nB：不是，她是小学生。\nA：你哥哥呢？\nB：他是中学生。",
      "pinyin": "A: Nǐ mèi mei shì zhōng xué shēng ma? B: Bú shì, tā shì xiǎo xué shēng. A: Nǐ gē ge ne? B: Tā shì zhōng xué shēng.",
      "meaning": "B sửa rằng em gái học tiểu học; anh trai học trung học. Không có dữ kiện về tuổi hoặc lớp cụ thể.",
      "readingMinutes": 2
    },
