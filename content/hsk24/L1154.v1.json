  "blocks": [
    {
      "id": "l1154-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder0",
      "type": "teaching",
      "title": "高兴 · vui; vui mừng",
      "text": "Từ đã học 高兴 có 2 chữ. Chữ 兴 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 兴 với 共 / 兵 / 其; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "认识你，我很高兴。",
      "pinyin": "Rèn shi nǐ, wǒ hěn gāo xìng.",
      "meaning": "Tôi vui được biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder1",
      "type": "teaching",
      "title": "认识 · quen; biết một người",
      "text": "Từ đã học 认识 có 2 chữ. Chữ 识 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 识 với 织 / 职 / 只; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我认识你。",
      "pinyin": "Wǒ rèn shi nǐ.",
      "meaning": "Tôi biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder2",
      "type": "teaching",
      "title": "女 · nữ",
      "text": "Từ đã học 女 có 1 chữ. Chữ 女 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 女 với 如 / 好 / 母; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "性别：女。",
      "pinyin": "Xìng bié: nǚ.",
      "meaning": "Giới tính: nữ.",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder3",
      "type": "teaching",
      "title": "她 · cô ấy; bà ấy",
      "text": "Từ đã học 她 có 1 chữ. Chữ 她 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 她 với 他 / 妈 / 地; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "她叫林。",
      "pinyin": "Tā jiào Lín.",
      "meaning": "Cô ấy tên Lâm.",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder4",
      "type": "teaching",
      "title": "朋友 · bạn; bạn bè",
      "text": "Từ đã học 朋友 có 2 chữ. Chữ 朋 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 朋 với 明 / 月 / 用; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你好，朋友！",
      "pinyin": "Nǐ hǎo, péng you!",
      "meaning": "Chào bạn!",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reminder5",
      "type": "teaching",
      "title": "男朋友 · bạn trai (quan hệ tình cảm)",
      "text": "Từ đã học 男朋友 có 3 chữ. Chữ 友 ở vị trí 3 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 友 với 反 / 又 / 及; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "他是我男朋友。",
      "pinyin": "Tā shì wǒ nán péng you.",
      "meaning": "Anh ấy là bạn trai tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1154-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你明天几点去学校？\nB：我八点去学校。\nA：今天呢？\nB：我今天在家。",
      "pinyin": "A: Nǐ míng tiān jǐ diǎn qù xué xiào? B: Wǒ bā diǎn qù xué xiào. A: Jīn tiān ne? B: Wǒ jīn tiān zài jiā.",
      "meaning": "B đi học8giờ ngày mai, hôm nay ở nhà.",
      "readingMinutes": 2
    },
