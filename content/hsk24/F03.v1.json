  "blocks": [
    {
      "id": "f03-intro",
      "type": "teaching",
      "title": "Cách học bài này",
      "text": "Mục tiêu là tiếng Phổ thông với chữ giản thể. Pinyin ghi âm, chữ Hán ghi đơn vị ngôn ngữ, nghĩa Việt giúp hiểu; ba phần không thay thế nhau. Quay lại các hình minh họa và hộp gợi ý của F01/F02 khi cần; không cần bật âm thanh để tiếp tục.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "f03-note0",
      "type": "teaching",
      "title": "Bước 1",
      "text": "Bắt đầu từ m/n trong F01 rồi học theo nhóm: b p m f; d t n l; g k h; j q x; zh ch sh r; z c s. Đây là 21 phụ âm đầu thường được học. y/w còn tham gia cách viết âm tiết không có phụ âm đầu; đừng đọc chúng như chữ Việt rồi tự suy cả âm tiết.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "f03-note1",
      "type": "teaching",
      "title": "Bước 2",
      "text": "b/p, d/t, g/k, j/q, zh/ch, z/c khác nhau về cách bật hơi; không chỉ là b/p hay đ/t tiếng Việt. Đặt tờ giấy trước miệng có thể giúp quan sát hơi khi tự thử, nhưng ứng dụng không chấm tờ giấy hay xác nhận phát âm. Dùng diagram/gợi ý đã có trong F01 và coach pinyin để quan sát vị trí môi, lưỡi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "f03-note2",
      "type": "teaching",
      "title": "Bước 3",
      "text": "j q x đi với nhóm vần i/ü; zh ch sh r và z c s cần quan sát vị trí lưỡi khác. Không thêm một nguyên âm Việt vào sau phụ âm khi ghép. Nhìn jī = j + i, qī = q + i; hãy giữ cả dấu thanh, không chỉ phần chữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "f03-note3",
      "type": "teaching",
      "title": "Bước 4",
      "text": "Luyện bằng chữ dưới đây kiểm tra ký hiệu và cách ghép, không kiểm tra nghe hay phát âm. Nút TTS nếu có chỉ dùng giọng zh-CN cục bộ, tổng hợp/chưa duyệt; thiếu giọng thì bỏ qua. Không cần dịch vụ trả phí.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
