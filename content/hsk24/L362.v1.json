  "blocks": [
    {
      "id": "l362-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 选定 xuǎndìng: chọn xong; 向上 xiàng shàng: lên trên; 做准备 zuò zhǔnbèi: chuẩn bị. Mô tả bài đọc không là huấn luyện thể thao.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l362-t0",
      "type": "teaching",
      "title": "体育 · thể dục/thể thao",
      "text": "体育 chỉ lĩnh vực/môn giáo dục thể chất; 体育课 là giờ thể dục, không chỉ một động tác tập.",
      "hanzi": "下午我们有体育课。",
      "pinyin": "Xiàwǔ wǒmen yǒu tǐyù kè.",
      "meaning": "Chiều chúng tôi có giờ thể dục.",
      "readingMinutes": 1
    },
    {
      "id": "l362-t1",
      "type": "teaching",
      "title": "体育馆 · nhà thi đấu/nhà thể thao",
      "text": "体育馆 là công trình thể thao trong nhà, không phải mọi 球场 đều có mái. Cần đọc địa điểm cụ thể.",
      "hanzi": "今天体育馆不开门。",
      "pinyin": "Jīntiān tǐyùguǎn bù kāi mén.",
      "meaning": "Hôm nay nhà thể thao không mở cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l362-t2",
      "type": "teaching",
      "title": "球场 · sân bóng/sân chơi môn bóng",
      "text": "球场 là sân cho môn bóng theo ngữ cảnh; cần tên môn khi muốn biết bóng đá hay tennis. Không phải sân nào cũng dùng mọi môn.",
      "hanzi": "我们在球场见面。",
      "pinyin": "Wǒmen zài qiúchǎng jiàn miàn.",
      "meaning": "Chúng tôi gặp ở sân bóng.",
      "readingMinutes": 1
    },
    {
      "id": "l362-t3",
      "type": "teaching",
      "title": "网球 · quần vợt/tennis",
      "text": "网球 là tennis, dùng 打网球; khác 羽毛球 cầu lông. Không tự chấm kỹ thuật từ nhớ tên môn.",
      "hanzi": "她喜欢打网球。",
      "pinyin": "Tā xǐhuan dǎ wǎngqiú.",
      "meaning": "Cô ấy thích chơi tennis.",
      "readingMinutes": 1
    },
    {
      "id": "l362-t4",
      "type": "teaching",
      "title": "羽毛球 · cầu lông",
      "text": "羽毛球 chỉ môn/quả cầu lông theo câu, 打羽毛球 là chơi cầu lông. 羽毛 không làm từ này thành tên mọi vật có lông.",
      "hanzi": "我想打羽毛球。",
      "pinyin": "Wǒ xiǎng dǎ yǔmáoqiú.",
      "meaning": "Tôi muốn chơi cầu lông.",
      "readingMinutes": 1
    },
    {
      "id": "l362-t5",
      "type": "teaching",
      "title": "跳 · nhảy",
      "text": "跳 là nhảy trong 跳一下, 跳绳 hay 跳舞 cần tân ngữ bổ sung. Bài chỉ dạy động tác nhảy, không tự dạy kỹ thuật thể dục.",
      "hanzi": "他向上跳了一下。",
      "pinyin": "Tā xiàng shàng tiào le yíxià.",
      "meaning": "Cậu ấy nhảy lên một cái.",
      "readingMinutes": 1
    },
    {
      "id": "l362-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "打网球或者打羽毛球 là hai phương án trong trần thuật. 用 打 với hai môn này; 跳 là động tác khác, không phải tên mọi môn bóng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l362-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "体育课上，老师说体育馆今天不开门，大家在外面的球场活动。小林打网球或者打羽毛球，还没选定。朋友先向上跳了一下做准备，没有说自己已经参加比赛。",
      "pinyin": "Tǐyù kè shàng, lǎoshī shuō tǐyùguǎn jīntiān bù kāi mén, dàjiā zài wàimian de qiúchǎng huódòng. Xiǎo Lín dǎ wǎngqiú huòzhě dǎ yǔmáoqiú, hái méi xuǎndìng. Péngyou xiān xiàng shàng tiào le yíxià zuò zhǔnbèi, méiyǒu shuō zìjǐ yǐjīng cānjiā bǐsài.",
      "meaning": "Nhà thể thao đóng cửa nên lớp hoạt động ngoài sân. Lâm chưa chọn tennis hay cầu lông; bạn nhảy chuẩn bị, chưa nói đã thi đấu.",
      "readingMinutes": 2
    },
    {
      "id": "l362-b0",
      "type": "exercise",
      "exerciseVersionId": "l362-v1-e0"
