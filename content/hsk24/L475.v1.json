  "blocks": [
    {
      "id": "l475-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 熟悉 shúxī: quen thuộc; 兄妹 xiōngmèi: anh trai và em gái; 变化 biànhuà: sự thay đổi. Địa điểm và lịch sử hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l475-t0",
      "type": "teaching",
      "title": "回忆 · hồi ức, nhớ lại",
      "text": "回忆 vừa là nhớ lại vừa là danh từ hồi ức; bài dùng động từ 回忆过去. Nhận diện chữ 忆 trong 回忆; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "大家一起回忆过去的生活。",
      "pinyin": "Dàjiā yìqǐ huíyì guòqù de shēnghuó.",
      "meaning": "Mọi người cùng nhớ cuộc sống trước đây.",
      "readingMinutes": 1
    },
    {
      "id": "l475-t1",
      "type": "teaching",
      "title": "过程 · quá trình",
      "text": "过程 là các bước/giai đoạn diễn ra, khác 结果 là kết quả cuối.",
      "hanzi": "他介绍了变化的过程。",
      "pinyin": "Tā jièshào le biànhuà de guòchéng.",
      "meaning": "Anh giới thiệu quá trình thay đổi.",
      "readingMinutes": 1
    },
    {
      "id": "l475-t2",
      "type": "teaching",
      "title": "当时 · lúc đó",
      "text": "当时 gắn một thời điểm đã nói; khác 目前 là hiện tại.",
      "hanzi": "当时这里没有这座桥。",
      "pinyin": "Dāngshí zhèlǐ méiyǒu zhè zuò qiáo.",
      "meaning": "Lúc đó ở đây chưa có cầu này.",
      "readingMinutes": 1
    },
    {
      "id": "l475-t3",
      "type": "teaching",
      "title": "出现 · xuất hiện",
      "text": "出现 nói điều/người trở nên có mặt/hiện ra, không nhất thiết mới được tạo.",
      "hanzi": "照片里出现了熟悉的街道。",
      "pinyin": "Zhàopiàn lǐ chūxiàn le shúxī de jiēdào.",
      "meaning": "Trong ảnh hiện ra phố quen.",
      "readingMinutes": 1
    },
    {
      "id": "l475-t4",
      "type": "teaching",
      "title": "改变 · thay đổi",
      "text": "改变 có thể nhận 计划、习惯; không dùng như mọi câu tồn tại 变化.",
      "hanzi": "新桥改变了大家的出行方式。",
      "pinyin": "Xīn qiáo gǎibiàn le dàjiā de chūxíng fāngshì.",
      "meaning": "Cầu mới thay đổi cách đi lại của mọi người.",
      "readingMinutes": 1
    },
    {
      "id": "l475-t5",
      "type": "teaching",
      "title": "到来 · đến, tới",
      "text": "到来 thường nói thời kỳ/sự kiện đến, như 假日到来; không thay mọi 到后 có tân ngữ địa điểm.",
      "hanzi": "假日的到来让孩子们很高兴。",
      "pinyin": "Jiàrì de dàolái ràng háizimen hěn gāoxìng.",
      "meaning": "Kỳ nghỉ tới làm trẻ vui.",
      "readingMinutes": 1
    },
    {
      "id": "l475-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "于是 nối sự việc trước với hành động/kết quả tiếp theo do tình huống đó: 旧照片出现了，于是大家谈起过去. Không nhất thiết có suy luận phổ quát; dùng kể chuỗi sự việc có liên hệ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l475-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "假日到来，兄妹回家整理旧照片。一张旧照片出现了，于是大家谈起过去。当时江上没有桥，出门要坐船。后来新桥改变了出行方式。母亲介绍变化的过程，孩子们一边听一边回忆自己小时候的生活。",
      "pinyin": "Jiàrì dàolái, xiōngmèi huí jiā zhěnglǐ jiù zhàopiàn. Yì zhāng jiù zhàopiàn chūxiàn le, yúshì dàjiā tán qǐ guòqù. Dāngshí jiāng shàng méiyǒu qiáo, chūmén yào zuò chuán. Hòulái xīn qiáo gǎibiàn le chūxíng fāngshì. Mǔqīn jièshào biànhuà de guòchéng, háizimen yì biān tīng yì biān huíyì zìjǐ xiǎoshíhou de shēnghuó.",
      "meaning": "Anh em về dịp nghỉ, thấy ảnh cũ rồi trò chuyện. Xưa chưa có cầu phải đi thuyền; cầu mới đổi cách đi lại. Mẹ kể quá trình, các con nhớ tuổi thơ.",
      "readingMinutes": 2
    },
    {
