  "blocks": [
    {
      "id": "l459-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 条款 tiáokuǎn: điều khoản; 签字 qiān zì: ký; 涉及 shèjí: liên quan; 资格 zīgé: tư cách chuyên môn. Tất cả mẫu giấy và sự kiện đều hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l459-t0",
      "type": "teaching",
      "title": "法 · cách, phương pháp",
      "text": "法 trong 想个法 là cách giải quyết, chưa phải luật; chữ đồng hình được dạy hai phạm vi riêng.",
      "hanzi": "我们得想个法。",
      "pinyin": "Wǒmen děi xiǎng ge fǎ.",
      "meaning": "Chúng ta phải nghĩ cách.",
      "readingMinutes": 1
    },
    {
      "id": "l459-t1",
      "type": "teaching",
      "title": "法律 · pháp luật",
      "text": "法律 là hệ thống quy tắc pháp luật; đoạn không nêu luật thực tế nào. Nhận diện chữ 律 trong 法律; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我想了解相关法律。",
      "pinyin": "Wǒ xiǎng liǎojiě xiāngguān fǎlǜ.",
      "meaning": "Tôi muốn tìm hiểu pháp luật liên quan.",
      "readingMinutes": 1
    },
    {
      "id": "l459-t2",
      "type": "teaching",
      "title": "律师 · luật sư",
      "text": "律师 là nghề hỗ trợ/tư vấn pháp lý; không mặc định lời nhân vật là tư vấn đúng luật.",
      "hanzi": "她向律师说明情况。",
      "pinyin": "Tā xiàng lǜshī shuōmíng qíngkuàng.",
      "meaning": "Cô trình bày tình hình với luật sư.",
      "readingMinutes": 1
    },
    {
      "id": "l459-t3",
      "type": "teaching",
      "title": "警察 · cảnh sát",
      "text": "警察 là người thuộc lực lượng cảnh sát; khác 律师 là nghề pháp lý khác.",
      "hanzi": "他向警察问路。",
      "pinyin": "Tā xiàng jǐngchá wèn lù.",
      "meaning": "Anh hỏi đường cảnh sát.",
      "readingMinutes": 1
    },
    {
      "id": "l459-t4",
      "type": "teaching",
      "title": "拒绝 · từ chối",
      "text": "拒绝 nhận lời đề nghị/yêu cầu hoặc hành động; 拒绝签字 không nói hợp đồng đó sai.",
      "hanzi": "他拒绝马上签字。",
      "pinyin": "Tā jùjué mǎshàng qiān zì.",
      "meaning": "Anh từ chối ký ngay.",
      "readingMinutes": 1
    },
    {
      "id": "l459-t5",
      "type": "teaching",
      "title": "难道 · lẽ nào",
      "text": "难道 đánh dấu phản vấn; không phải danh từ khó khăn 困难.",
      "hanzi": "难道不懂就不能问吗？",
      "pinyin": "Nándào bù dǒng jiù bù néng wèn ma?",
      "meaning": "Lẽ nào không hiểu thì không được hỏi?",
      "readingMinutes": 1
    },
    {
      "id": "l459-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "难道……吗？ là câu hỏi tu từ thường ngụ ý phản bác giả định: 难道不懂就不能问吗？ Người nói cho rằng có thể hỏi. Không đọc như câu hỏi trung tính yêu cầu trả lời có/không mà bỏ thái độ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l459-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社区的语言练习课讨论一张虚构的表格。小吴不懂条款，拒绝马上签字，想找个法弄清楚。老师说：“难道不懂就不能问吗？可以先说明问题，再向合适的人求助。警察和律师的工作不同，涉及法律的问题要找有资格的人解释。”",
      "pinyin": "Shèqū de yǔyán liànxí kè tǎolùn yì zhāng xūgòu de biǎogé. Xiǎo Wú bù dǒng tiáokuǎn, jùjué mǎshàng qiān zì, xiǎng zhǎo ge fǎ nòng qīngchu. Lǎoshī shuō: “Nándào bù dǒng jiù bù néng wèn ma? Kěyǐ xiān shuōmíng wèntí, zài xiàng héshì de rén qiúzhù. Jǐngchá hé lǜshī de gōngzuò bù tóng, shèjí fǎlǜ de wèntí yào zhǎo yǒu zīgé de rén jiěshì.”",
      "meaning": "Lớp ngôn ngữ bàn biểu mẫu hư cấu. Ngô chưa hiểu nên chưa ký, muốn tìm cách làm rõ. Thầy dùng câu phản vấn để khuyến khích hỏi người phù hợp, phân biệt nghề cảnh sát và luật sư.",
      "readingMinutes": 2
    },
