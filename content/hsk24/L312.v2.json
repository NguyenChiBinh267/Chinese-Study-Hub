  "blocks": [
    {
      "id": "l312-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 不/没, 很, số lượng và địa điểm. HSK1/2 chưa hoàn chỉnh; chỉ khám phá DRAFT. 房间 fángjiān: phòng; 客厅 kètīng: phòng khách (hỗ trợ chưa xác minh cấp); 所 suǒ: lượng từ nhà/công trình; 开着 kāi zhe: đang bật/mở. Chỉ nhánh đặt vật của 把 được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l312-t0",
      "type": "teaching",
      "title": "打扫 · quét dọn/dọn vệ sinh",
      "text": "打扫 chỉ dọn cho sạch theo ngữ cảnh, thường dùng với 房间/教室. Không đồng nghĩa di chuyển mọi đồ vật hay sửa nhà.",
      "hanzi": "我们一起打扫房子。",
      "pinyin": "Wǒmen yìqǐ dǎsǎo fángzi.",
      "meaning": "Chúng tôi cùng dọn nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l312-t1",
      "type": "teaching",
      "title": "干净 · sạch",
      "text": "干净 là trạng thái sạch; khác 打扫 là hành động dọn. 很干净 chưa cho biết ai đã dọn hay lúc nào.",
      "hanzi": "这个房间很干净。",
      "pinyin": "Zhège fángjiān hěn gānjìng.",
      "meaning": "Phòng này sạch.",
      "readingMinutes": 1
    },
    {
      "id": "l312-t2",
      "type": "teaching",
      "title": "房子 · nhà/căn nhà",
      "text": "房子 thường nói căn nhà/công trình để ở; khác 房间 phòng trong nhà và 家 nhà theo gia đình/nơi thuộc về.",
      "hanzi": "这所房子有三个房间。",
      "pinyin": "Zhè suǒ fángzi yǒu sān ge fángjiān.",
      "meaning": "Căn nhà này có ba phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l312-t3",
      "type": "teaching",
      "title": "放 · đặt/để",
      "text": "放 ở đây là đặt vật tại một nơi. 放在桌上 nói đặt trên bàn; không dùng nghĩa nghỉ như 放假.",
      "hanzi": "请把书放在桌上。",
      "pinyin": "Qǐng bǎ shū fàng zài zhuō shang.",
      "meaning": "Hãy đặt sách lên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l312-t4",
      "type": "teaching",
      "title": "关 · đóng/tắt",
      "text": "关 với 门 là đóng cửa, với 灯 là tắt đèn. Khác 关心 quan tâm là từ khác chưa được dạy ở đây.",
      "hanzi": "出门以前，请关灯。",
      "pinyin": "Chū mén yǐqián, qǐng guān dēng.",
      "meaning": "Trước khi ra ngoài hãy tắt đèn.",
      "readingMinutes": 1
    },
    {
      "id": "l312-t5",
      "type": "teaching",
      "title": "灯 · đèn",
      "text": "灯 là đồ vật phát sáng, không phải động từ tắt. 灯还开着 nói đèn còn bật; không dịch nhầm 关灯 thành bật đèn.",
      "hanzi": "客厅的灯还开着。",
      "pinyin": "Kètīng de dēng hái kāi zhe.",
      "meaning": "Đèn phòng khách còn bật.",
      "readingMinutes": 1
    },
    {
      "id": "l312-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把门口的东西放在桌上 dùng vật đã xác định trước động từ+在+vị trí. Nhánh này là đặt vật ở đâu, bổ sung nhánh 带到 ở bài đi lại; chưa bao phủ toàn bộ mẫu 把.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l312-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小李：出门以前，我们先打扫一下房子。小安：桌上的书放在哪里？小李：放在书包里。小安：现在房间很干净了。小李：好，别忘了关灯，再关门。",
      "pinyin": "Xiǎo Lǐ: Chū mén yǐqián, wǒmen xiān dǎsǎo yíxià fángzi. Xiǎo Ān: Zhuō shang de shū fàng zài nǎli? Xiǎo Lǐ: Fàng zài shūbāo lǐ. Xiǎo Ān: Xiànzài fángjiān hěn gānjìng le. Xiǎo Lǐ: Hǎo, bié wàng le guān dēng, zài guān mén.",
      "meaning": "Trước khi ra ngoài, Lý và An dọn nhà. Sách trên bàn được đặt vào cặp. Phòng đã sạch; Lý nhắc tắt đèn rồi đóng cửa.",
      "readingMinutes": 2
    },
