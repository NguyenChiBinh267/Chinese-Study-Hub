  "blocks": [
    {
      "id": "l182-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder0",
      "type": "teaching",
      "title": "谁 · ai",
      "text": "Nhắc nghĩa đã học: ai. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "你姐姐是谁？",
      "pinyin": "Nǐ jiě jie shì shéi?",
      "meaning": "Ai là chị gái của bạn?",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder1",
      "type": "teaching",
      "title": "我们 · chúng tôi; chúng ta",
      "text": "Nhắc nghĩa đã học: chúng tôi; chúng ta. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我们认识你妈妈。",
      "pinyin": "Wǒ men rèn shi nǐ mā ma.",
      "meaning": "Chúng tôi biết mẹ bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder2",
      "type": "teaching",
      "title": "爸爸 · bố; ba",
      "text": "Nhắc nghĩa đã học: bố; ba. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "他爸爸叫文。",
      "pinyin": "Tā bà ba jiào Wén.",
      "meaning": "Bố anh ấy tên Văn.",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder3",
      "type": "teaching",
      "title": "姐姐 · chị gái",
      "text": "Nhắc nghĩa đã học: chị gái. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我姐姐认识你。",
      "pinyin": "Wǒ jiě jie rèn shi nǐ.",
      "meaning": "Chị gái tôi biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder4",
      "type": "teaching",
      "title": "四 · bốn",
      "text": "Nhắc nghĩa đã học: bốn. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "三、四、五。",
      "pinyin": "Sān, sì, wǔ.",
      "meaning": "Ba, bốn, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l182-reminder5",
      "type": "teaching",
      "title": "九 · chín",
      "text": "Nhắc nghĩa đã học: chín. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "八、九、十。",
      "pinyin": "Bā, jiǔ, shí.",
      "meaning": "Tám, chín, mười.",
      "readingMinutes": 1
    },
    {
      "id": "l182-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：她是你妈妈吗？\nB：不是，她是我姐姐。\nA：她叫什么名字？\nB：她叫林。\nA：我认识她。",
      "pinyin": "A: Tā shì nǐ mā ma ma? B: Bú shì, tā shì wǒ jiě jie. A: Tā jiào shén me míng zi? B: Tā jiào Lín. A: Wǒ rèn shi tā.",
      "meaning": "A hỏi có phải mẹ của B không. B sửa lại là chị gái tên Lâm; A nói biết cô ấy.",
      "readingMinutes": 2
    },
