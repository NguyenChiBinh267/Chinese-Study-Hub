  "blocks": [
    {
      "id": "l4016-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t0",
      "type": "teaching",
      "title": "赢 · thắng",
      "text": "赢 là giành phần thắng trong cuộc thi; không đồng nghĩa kiếm tiền trong mọi ngữ cảnh. Nhận diện chữ 赢 trong 赢; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他们希望赢下这场比赛。",
      "pinyin": "Tā men xī wàng yíng xià zhè chǎng bǐ sài.",
      "meaning": "Họ hy vọng thắng trận này.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t1",
      "type": "teaching",
      "title": "输 · thua",
      "text": "输 trong thi đấu đối lập 赢; không phải 输送 là vận chuyển.",
      "hanzi": "昨天我们输了比赛。",
      "pinyin": "Zuó tiān wǒ men shū le bǐ sài.",
      "meaning": "Hôm qua chúng tôi thua trận.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t2",
      "type": "teaching",
      "title": "受伤 · bị thương",
      "text": "受伤 chỉ việc bị tổn thương cơ thể; bài học không chẩn đoán hoặc hướng dẫn điều trị.",
      "hanzi": "受伤的队员没有参加比赛。",
      "pinyin": "Shòu shāng de duì yuán méi yǒu cān jiā bǐ sài.",
      "meaning": "Thành viên bị thương không tham gia trận đấu.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t3",
      "type": "teaching",
      "title": "勇敢 · dũng cảm",
      "text": "勇敢 tả thái độ đối diện khó khăn; không đồng nghĩa liều lĩnh tiếp tục khi bị thương.",
      "hanzi": "他勇敢地承认了自己的错误。",
      "pinyin": "Tā yǒng gǎn de chéng rèn le zì jǐ de cuò wù.",
      "meaning": "Anh ấy dũng cảm thừa nhận sai sót của mình.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t4",
      "type": "teaching",
      "title": "优秀 · ưu tú; xuất sắc",
      "text": "优秀 đánh giá năng lực/phẩm chất tốt; không phải bảo đảm luôn thắng mọi trận.",
      "hanzi": "优秀的队员也会输。",
      "pinyin": "Yōu xiù de duì yuán yě huì shū.",
      "meaning": "Thành viên xuất sắc cũng có thể thua.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-t5",
      "type": "teaching",
      "title": "态度 · thái độ",
      "text": "态度 chỉ cách nhìn và ứng xử đối với người/việc, không phải kết quả thi đấu.",
      "hanzi": "教练很重视大家的态度。",
      "pinyin": "Jiào liàn hěn zhòng shì dà jiā de tài dù.",
      "meaning": "Huấn luyện viên coi trọng thái độ của mọi người.",
      "readingMinutes": 1
    },
    {
      "id": "l4016-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "就是…也… đặt tình huống nhượng bộ mang nghĩa dù/ngay cả nếu…vẫn…: 就是输了，也要尊重对手. 输了 trong giả định không khẳng định nhân vật đã thua trận thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4016-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "这是一个虚构的体育故事。受伤的小队员没有上场，其他人都希望赢。教练说：“就是输了，也要尊重对手。优秀的队员不仅技术好，态度也好。”比赛后，小林勇敢地承认自己传球失误，大家一起讨论下次怎么配合。故事没有说明最后谁赢谁输。",
      "pinyin": "Zhè shì yí ge xū gòu de tǐ yù gù shi. Shòu shāng de xiǎo duì yuán méi yǒu shàng chǎng, qí tā rén dōu xī wàng yíng. Jiào liàn shuō: “Jiù shì shū le, yě yào zūn zhòng duì shǒu. Yōu xiù de duì yuán bù jǐn jì shù hǎo, tài dù yě hǎo.” Bǐ sài hòu, Xiǎo Lín yǒng gǎn de chéng rèn zì jǐ chuán qiú shī wù, dà jiā yì qǐ tǎo lùn xià cì zěn me pèi hé. Gù shi méi yǒu shuō míng zuì hòu shéi yíng shéi shū.",
      "meaning": "Truyện thể thao hư cấu chú trọng tôn trọng đối thủ và nhận lỗi; không nêu đội thắng cuối cùng.",
      "readingMinutes": 2
    },
    {
      "id": "l4016-b0",
      "type": "exercise",
      "exerciseVersionId": "l4016-v1-e0"
    },
    {
      "id": "l4016-b1",
