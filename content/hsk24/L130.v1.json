  "blocks": [
    {
      "id": "l130-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l130-t0",
      "type": "teaching",
      "title": "上 · trên; phía trên",
      "text": "上 đứng sau tên vật để nói vị trí ở trên; câu không tự cho biết vật có chạm bề mặt hay không ở mọi trường hợp.",
      "hanzi": "书在桌子上。",
      "pinyin": "Shū zài zhuō zi shang.",
      "meaning": "Sách ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l130-t1",
      "type": "teaching",
      "title": "下 · dưới; phía dưới",
      "text": "下 trong 桌子下 nói dưới bàn, khác từ 下课 chỉ kết thúc tiết đã học.",
      "hanzi": "猫在桌子下。",
      "pinyin": "Māo zài zhuō zi xia.",
      "meaning": "Mèo ở dưới bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l130-t2",
      "type": "teaching",
      "title": "前 · trước; phía trước",
      "text": "前 trong câu nói phía trước một mốc không gian; không phải luôn là thời gian trước đây.",
      "hanzi": "椅子在桌子前。",
      "pinyin": "Yǐ zi zài zhuō zi qián.",
      "meaning": "Ghế ở phía trước bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l130-t3",
      "type": "teaching",
      "title": "后 · sau; phía sau",
      "text": "后 trong ví dụ nói phía sau ghế; cần mốc là ghế, không hiểu là phía sau người đọc mặc định.",
      "hanzi": "狗在椅子后。",
      "pinyin": "Gǒu zài yǐ zi hòu.",
      "meaning": "Chó ở phía sau ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l130-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Danh từ nơi/vật + 上/下/前/后 tạo cụm vị trí: 桌子下 là dưới bàn. Dùng 在 trước cả cụm: 猫在桌子下. Bài này dùng nghĩa không gian; 前/后 có thể có cách dùng thời gian ở ngữ cảnh khác. Không suy hướng trái/phải hay khoảng cách nếu đoạn không cho.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l130-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：猫在哪儿？\nB：在桌子下。\nA：狗呢？\nB：狗在椅子后。",
      "pinyin": "A: Māo zài nǎr? B: Zài zhuō zi xia. A: Gǒu ne? B: Gǒu zài yǐ zi hòu.",
      "meaning": "Mèo dưới bàn; chó phía sau ghế. Các vị trí được nói rõ bằng chữ; không có sơ đồ để tự đo thêm hướng hoặc khoảng cách.",
      "readingMinutes": 2
    },
