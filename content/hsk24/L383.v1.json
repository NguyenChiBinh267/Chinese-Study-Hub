  "blocks": [
    {
      "id": "l383-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 副 fù: lượng từ một bộ tai nghe; 音量 yīnliàng: âm lượng; 调 tiáo: điều chỉnh; 播放 bōfàng: phát media. Chưa có bài kiểm tra nghe hoặc chấm chơi game.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l383-t0",
      "type": "teaching",
      "title": "耳机 · tai nghe",
      "text": "耳机 là thiết bị đeo nghe âm, khác 耳朵 là tai. 一副耳机 đếm một bộ, không tự có nhạc hay hoạt động nghe trong bài chữ.",
      "hanzi": "这副耳机是我的。",
      "pinyin": "Zhè fù ěrjī shì wǒ de.",
      "meaning": "Bộ tai nghe này của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l383-t1",
      "type": "teaching",
      "title": "游戏 · trò chơi",
      "text": "游戏 là trò chơi; 玩游戏 là chơi, không tự là bài học/thi có điểm năng lực. Bài đọc nói trò chơi hư cấu, không cài thêm game.",
      "hanzi": "我们周末玩游戏。",
      "pinyin": "Wǒmen zhōumò wán yóuxì.",
      "meaning": "Cuối tuần chúng tôi chơi trò chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l383-t2",
      "type": "teaching",
      "title": "一共 · tổng cộng",
      "text": "一共 nêu tổng trong tập đang xét; 两人一共… khác 每人… mỗi người. Không cộng lặp cùng đối tượng.",
      "hanzi": "今天一共来了三个人。",
      "pinyin": "Jīntiān yígòng lái le sān ge rén.",
      "meaning": "Hôm nay tổng cộng có ba người đến.",
      "readingMinutes": 1
    },
    {
      "id": "l383-t3",
      "type": "teaching",
      "title": "一块儿 · cùng nhau (trạng ngữ)",
      "text": "一块儿 trong 一块儿玩 là cùng nhau, không phải một khối vật liệu. 儿 hóa vào kuàir, khác 块儿 như khối trong ngữ cảnh khác.",
      "hanzi": "我们一块儿玩游戏。",
      "pinyin": "Wǒmen yíkuàir wán yóuxì.",
      "meaning": "Chúng ta cùng chơi trò chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l383-t4",
      "type": "teaching",
      "title": "极 · cực kỳ/rất (trong 极了)",
      "text": "极 trong 开心极了 làm mức độ cao sau tính từ. 不 dùng 开心很极了; chưa dạy nghĩa cực địa/đỉnh điểm ở ngữ cảnh khác.",
      "hanzi": "收到礼物，她开心极了。",
      "pinyin": "Shōudào lǐwù, tā kāixīn jí le.",
      "meaning": "Nhận quà, cô ấy vui vô cùng.",
      "readingMinutes": 1
    },
    {
      "id": "l383-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "形容词+极了 nhấn mức cao, 如 开心极了; không đặt 极了 trước tính từ trong mẫu này. 一共 đếm tổng đúng phạm vi, 一块儿 nói cùng nhau theo cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l383-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "今天一共来了三个人，大家一块儿玩游戏。小林带了耳机，但先把音量调小，听到有人叫就停下来。他说收到朋友的礼物开心极了。文字只描述这些动作，并没有真的播放声音。",
      "pinyin": "Jīntiān yígòng lái le sān ge rén, dàjiā yíkuàir wán yóuxì. Xiǎo Lín dài le ěrjī, dàn xiān bǎ yīnliàng tiáo xiǎo, tīngdào yǒu rén jiào jiù tíng xiàlái. Tā shuō shōudào péngyou de lǐwù kāixīn jí le. Wénzì zhǐ miáoshù zhèxiē dòngzuò, bìng méiyǒu zhēn de bōfàng shēngyīn.",
      "meaning": "Có tổng cộng ba người cùng chơi. Lâm mang tai nghe, chỉnh âm lượng nhỏ và dừng khi có người gọi, rất vui vì quà. Đoạn chữ không phát âm thanh thật.",
      "readingMinutes": 2
    },
    {
      "id": "l383-b0",
      "type": "exercise",
      "exerciseVersionId": "l383-v1-e0"
    },
