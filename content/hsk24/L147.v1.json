  "blocks": [
    {
      "id": "l147-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l147-t0",
      "type": "teaching",
      "title": "月 · tháng (lịch hoặc đơn vị)",
      "text": "月 trong 五月 là tháng5; nói một khoảng năm tháng thường cần mẫu khác như 五个月.",
      "hanzi": "五月三号。",
      "pinyin": "Wǔ yuè sān hào.",
      "meaning": "Ngày3 tháng5.",
      "readingMinutes": 1
    },
    {
      "id": "l147-t1",
      "type": "teaching",
      "title": "日 · ngày trong tháng (dạng rì)",
      "text": "日 là cách ghi ngày trang trọng trong mẫu lịch; không nhầm âm rì với hào.",
      "hanzi": "五月三日。",
      "pinyin": "Wǔ yuè sān rì.",
      "meaning": "Ngày3 tháng5.",
      "readingMinutes": 1
    },
    {
      "id": "l147-t2",
      "type": "teaching",
      "title": "号 · ngày trong tháng (dạng hào)",
      "text": "号 dùng trong cách nói ngày của tháng ở đây; không dạy mọi nghĩa số hiệu của 号.",
      "hanzi": "今天五月三号。",
      "pinyin": "Jīn tiān wǔ yuè sān hào.",
      "meaning": "Hôm nay là ngày3 tháng5 trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l147-t3",
      "type": "teaching",
      "title": "星期 · tuần; yếu tố gọi thứ",
      "text": "星期 + số1–6 gọi thứ trong tuần; 星期一 là thứ Hai, không phải ngày1 của tháng.",
      "hanzi": "今天星期一。",
      "pinyin": "Jīn tiān xīng qī yī.",
      "meaning": "Hôm nay là thứ Hai trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l147-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Tháng gọi bằng số + 月; tháng11/12 là 十一月/十二月, với 十一=10+1 và 十二=10+2. Ngày trong tháng dùng 日 trang trọng hoặc 号 thường gặp trong nói. 星期一 đến 星期六 là các thứ; Chủ nhật có hai tên ở bài sau. Ngày/星期 trong đoạn là lịch hư cấu, không đọc đồng hồ máy người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l147-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：今天几月几号？\nB：今天五月三号。\nA：星期几？\nB：星期一。",
      "pinyin": "A: Jīn tiān jǐ yuè jǐ hào? B: Jīn tiān wǔ yuè sān hào. A: Xīng qī jǐ? B: Xīng qī yī.",
      "meaning": "几 jǐ = mấy. Lịch trong truyện là ngày3 tháng5, thứ Hai, không nêu năm; không phải ngày thực của máy hoặc người học.",
      "readingMinutes": 2
    },
