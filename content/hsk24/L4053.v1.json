  "blocks": [
    {
      "id": "l4053-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t0",
      "type": "teaching",
      "title": "普遍 · phổ biến",
      "text": "普遍 nói xuất hiện rộng, khác mọi trường hợp không ngoại lệ.",
      "hanzi": "这种看法很普遍。",
      "pinyin": "Zhè zhǒng kàn fǎ hěn pǔ biàn.",
      "meaning": "Cách nhìn này khá phổ biến.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t1",
      "type": "teaching",
      "title": "流行 · thịnh hành",
      "text": "流行 tả được ưa chuộng trong một giai đoạn, không bảo đảm chất lượng.",
      "hanzi": "最近流行这种小台灯。",
      "pinyin": "Zuì jìn liú xíng zhè zhǒng xiǎo tái dēng.",
      "meaning": "Gần đây loại đèn bàn nhỏ này thịnh hành.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t2",
      "type": "teaching",
      "title": "推出 · đưa ra; ra mắt",
      "text": "推出 trong câu là giới thiệu sản phẩm ra ngoài.",
      "hanzi": "小组推出了新模型。",
      "pinyin": "Xiǎo zǔ tuī chū le xīn mó xíng.",
      "meaning": "Nhóm giới thiệu mô hình mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t3",
      "type": "teaching",
      "title": "吸引 · thu hút",
      "text": "吸引 nói làm người khác chú ý/hứng thú.",
      "hanzi": "这个设计吸引了很多人。",
      "pinyin": "Zhè ge shè jì xī yǐn le hěn duō rén.",
      "meaning": "Thiết kế này thu hút nhiều người.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t4",
      "type": "teaching",
      "title": "效果 · hiệu quả; kết quả đạt được",
      "text": "效果 là kết quả tác động; cần bối cảnh để đánh giá. Nhận diện chữ 效 trong 效果; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们还要观察使用效果。",
      "pinyin": "Wǒ men hái yào guān chá shǐ yòng xiào guǒ.",
      "meaning": "Chúng tôi còn cần quan sát hiệu quả sử dụng.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-t5",
      "type": "teaching",
      "title": "有效 · có hiệu quả",
      "text": "有效 là tính từ, khác danh từ 效果.",
      "hanzi": "这个办法对他很有效。",
      "pinyin": "Zhè ge bàn fǎ duì tā hěn yǒu xiào.",
      "meaning": "Cách này rất hiệu quả với anh ấy.",
      "readingMinutes": 1
    },
    {
      "id": "l4053-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 đưa giới hạn của nhận xét: được chú ý không tự chứng minh có hiệu quả. Các sản phẩm trong chuyện đều hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4053-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里的小组推出一种台灯模型，吸引了很多同学。这种设计很流行，同学们普遍觉得它好看，不过还要比较实际效果。老师问：“受欢迎就一定有效吗？”同学说，还需要试验。",
      "pinyin": "Gù shi lǐ de xiǎo zǔ tuī chū yì zhǒng tái dēng mó xíng, xī yǐn le hěn duō tóng xué. Zhè zhǒng shè jì hěn liú xíng, tóng xué men pǔ biàn jué de tā hǎo kàn, bú guò hái yào bǐ jiào shí jì xiào guǒ. Lǎo shī wèn: “Shòu huān yíng jiù yí dìng yǒu xiào ma?” Tóng xué shuō, hái xū yào shì yàn.",
      "meaning": "Nhóm phân biệt được ưa chuộng với có hiệu quả, chưa kết luận trước thử nghiệm.",
      "readingMinutes": 2
    },
