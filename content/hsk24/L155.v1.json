  "blocks": [
    {
      "id": "l155-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l155-t0",
      "type": "teaching",
      "title": "包子 · bánh bao",
      "text": "包子 là tên món; âm 子 nhẹ theo từ điển trong bài.",
      "hanzi": "我吃包子。",
      "pinyin": "Wǒ chī bāo zi.",
      "meaning": "Tôi ăn bánh bao.",
      "readingMinutes": 1
    },
    {
      "id": "l155-t1",
      "type": "teaching",
      "title": "饺子 · sủi cảo; bánh chẻo",
      "text": "饺子 là tên món khác 包子; không chấm người học tự nhận món từ ảnh không có.",
      "hanzi": "我喜欢饺子。",
      "pinyin": "Wǒ xǐ huan jiǎo zi.",
      "meaning": "Tôi thích sủi cảo.",
      "readingMinutes": 1
    },
    {
      "id": "l155-t2",
      "type": "teaching",
      "title": "面条儿 · mì sợi (dạng hóa r)",
      "text": "Nguồn ghi 面条儿; 面条 cũng được dùng ngoài đề, nhưng mục đang hỏi yêu cầu dạng có 儿 hóa r.",
      "hanzi": "我吃面条儿。",
      "pinyin": "Wǒ chī miàn tiáor.",
      "meaning": "Tôi ăn mì sợi.",
      "readingMinutes": 1
    },
    {
      "id": "l155-t3",
      "type": "teaching",
      "title": "牛奶 · sữa bò",
      "text": "牛奶 chỉ sữa bò trong câu, không phải mọi loại thức uống gọi là sữa.",
      "hanzi": "我喜欢喝牛奶。",
      "pinyin": "Wǒ xǐ huan hē niú nǎi.",
      "meaning": "Tôi thích uống sữa bò.",
      "readingMinutes": 1
    },
    {
      "id": "l155-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "和 nối danh từ/cụm danh từ như 包子和饺子, không dùng để nối mọi hai câu theo chữ và của tiếng Việt. 包子/饺子 là tên các món ăn Trung Quốc thường gặp; không khẳng định chúng chỉ tồn tại ở một quốc gia. 面条儿 ở nguồn có hóa r; bài hỏi đúng dạng nguồn này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l155-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你吃包子吗？\nB：我不吃包子，我吃饺子和面条儿。\nA：你喝什么？\nB：我喝牛奶。",
      "pinyin": "A: Nǐ chī bāo zi ma? B: Wǒ bù chī bāo zi, wǒ chī jiǎo zi hé miàn tiáor. A: Nǐ hē shén me? B: Wǒ hē niú nǎi.",
      "meaning": "B chọn sủi cảo và mì, uống sữa bò; đây là lựa chọn của nhân vật ở tình huống đã cho, không khuyên dinh dưỡng hoặc suy sở thích của người học.",
      "readingMinutes": 2
    },
