  "blocks": [
    {
      "id": "l353-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 空地 kòngdì: bãi đất trống; 凭 píng: dựa vào; 造成 zàochéng: gây ra. Biến đổi vật lý không tự chứng minh quan hệ nhân quả hay chất lượng cuộc sống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l353-t0",
      "type": "teaching",
      "title": "变 · thay đổi/trở nên",
      "text": "变 là đổi/trở nên; 变冷 là trở lạnh, khác 变成+vật/kết quả. Không phải mọi sự đổi đều là tốt lên.",
      "hanzi": "天气变冷了。",
      "pinyin": "Tiānqì biàn lěng le.",
      "meaning": "Thời tiết trở lạnh rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l353-t1",
      "type": "teaching",
      "title": "变成 · biến thành/trở thành",
      "text": "变成 cần nêu kết quả như 变成公园; khác chỉ 变 là thay đổi không nhất thiết nói thành gì.",
      "hanzi": "这里变成了一个公园。",
      "pinyin": "Zhèlǐ biànchéng le yí ge gōngyuán.",
      "meaning": "Chỗ này đã trở thành một công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l353-t2",
      "type": "teaching",
      "title": "变化 · sự thay đổi/thay đổi",
      "text": "变化 là danh từ hoặc động từ; 有变化 nêu có thay đổi, 变化很大 nêu mức độ. Không tự nói nguyên nhân.",
      "hanzi": "这个城市的变化很大。",
      "pinyin": "Zhège chéngshì de biànhuà hěn dà.",
      "meaning": "Thành phố này thay đổi rất nhiều.",
      "readingMinutes": 1
    },
    {
      "id": "l353-t3",
      "type": "teaching",
      "title": "发生 · xảy ra",
      "text": "发生 đi với sự việc xảy ra; 发生了变化 nêu thay đổi đã xảy ra, không phải ai phát hiện ra nó.",
      "hanzi": "这里发生了很大的变化。",
      "pinyin": "Zhèlǐ fāshēng le hěn dà de biànhuà.",
      "meaning": "Ở đây đã xảy ra thay đổi lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l353-t4",
      "type": "teaching",
      "title": "发现 · phát hiện/nhận ra",
      "text": "发现 có chủ thể nhận ra điều trước chưa biết; 我发现不等于我造成. Không dùng 发现 thay 发生 cho sự kiện tự xảy ra.",
      "hanzi": "我发现这里多了一个公园。",
      "pinyin": "Wǒ fāxiàn zhèlǐ duō le yí ge gōngyuán.",
      "meaning": "Tôi nhận ra nơi đây có thêm công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l353-t5",
      "type": "teaching",
      "title": "发展 · phát triển/sự phát triển",
      "text": "发展 nói phát triển theo thời gian; 快 chưa tự chứng minh mọi mặt đều tốt. 城市发展是话题，不是成绩认定.",
      "hanzi": "这个城市发展得很快。",
      "pinyin": "Zhège chéngshì fāzhǎn de hěn kuài.",
      "meaning": "Thành phố này phát triển nhanh.",
      "readingMinutes": 1
    },
    {
      "id": "l353-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "变成 + kết quả nêu biến thành: 小树变成了大树. 发生 nêu sự kiện xảy ra, 发现 nêu ai nhận ra; không đổi hai động từ chỉ vì cùng có 发.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l353-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林回到过去住的地方，发现空地变成了公园。这里发生了很大的变化，城市发展得很快。天也变冷了。他记录看到的变化，没有只凭一个公园就说所有人的生活都变好了。",
      "pinyin": "Xiǎo Lín huí dào guòqù zhù de dìfang, fāxiàn kòngdì biànchéng le gōngyuán. Zhèlǐ fāshēng le hěn dà de biànhuà, chéngshì fāzhǎn de hěn kuài. Tiān yě biàn lěng le. Tā jìlù kàndào de biànhuà, méiyǒu zhǐ píng yí ge gōngyuán jiù shuō suǒyǒu rén de shēnghuó dōu biàn hǎo le.",
      "meaning": "Lâm trở lại nơi ở cũ, nhận ra bãi đất thành công viên. Thành phố đổi nhiều, trời trở lạnh. Cậu không suy ra đời sống mọi người đều tốt hơn chỉ từ một công viên.",
      "readingMinutes": 2
    },
    {
