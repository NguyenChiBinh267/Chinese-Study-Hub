  "blocks": [
    {
      "id": "l226-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "高 là cao, 矮 là thấp (SUPPLEMENTARY, chưa xác minh cấp ở phần hỗ trợ). So sánh phải có cùng đặc điểm và mốc rõ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l226-t0",
      "type": "teaching",
      "title": "高 · cao",
      "text": "Bài dùng tính từ cao về chiều cao. Không mở rộng mọi nghĩa như giá cao hay trình độ cao nếu chưa có ví dụ.",
      "hanzi": "小王比我高。",
      "pinyin": "Xiǎo Wáng bǐ wǒ gāo.",
      "meaning": "Tiểu Vương cao hơn tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l226-t1",
      "type": "teaching",
      "title": "个子 · vóc người, chiều cao cơ thể",
      "text": "个子 nói về chiều cao/vóc người; 子 đọc nhẹ. 个子高 không có nghĩa số lượng người lớn.",
      "hanzi": "他的个子很高。",
      "pinyin": "Tā de gèzi hěn gāo.",
      "meaning": "Anh ấy có vóc người cao.",
      "readingMinutes": 1
    },
    {
      "id": "l226-t2",
      "type": "teaching",
      "title": "比 · so với, hơn trong câu so sánh",
      "text": "比 ở đây là giới từ so sánh A với B. Không thêm 很 trước 高 trong mẫu A比B高 của bài.",
      "hanzi": "哥哥比我高。",
      "pinyin": "Gēge bǐ wǒ gāo.",
      "meaning": "Anh trai cao hơn tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l226-t3",
      "type": "teaching",
      "title": "最 · nhất trong một nhóm xác định",
      "text": "最 phải có nhóm/ngữ cảnh so sánh, như 我们班最高. Không tự coi ‘cao hơn tôi’ là cao nhất thế giới.",
      "hanzi": "小王是我们班最高的学生。",
      "pinyin": "Xiǎo Wáng shì wǒmen bān zuì gāo de xuésheng.",
      "meaning": "Tiểu Vương là học sinh cao nhất lớp chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l226-t4",
      "type": "teaching",
      "title": "那么 · đến mức như thế kia",
      "text": "那么高 ở đây chỉ mức độ cao; không dùng như danh từ người. Phân biệt với 那样 nêu cách/trạng thái như kia.",
      "hanzi": "他有那么高吗？",
      "pinyin": "Tā yǒu nàme gāo ma?",
      "meaning": "Anh ấy cao đến thế à?",
      "readingMinutes": 1
    },
    {
      "id": "l226-t5",
      "type": "teaching",
      "title": "那样 · như thế kia, theo cách đó",
      "text": "那样 có thể chỉ cách làm đã nêu: 不要那样说. Bài không gán nghĩa kết nối suy luận của 那么 cho 那样.",
      "hanzi": "不要那样说。",
      "pinyin": "Bú yào nàyàng shuō.",
      "meaning": "Đừng nói như thế.",
      "readingMinutes": 1
    },
    {
      "id": "l226-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "A比B高 nói A cao hơn B. 最 nêu cao nhất trong một nhóm đã xác định; không gọi ai cao nhất chỉ vì cao hơn một người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l226-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：小王的个子真高。乙：他比我高，也是我们班最高的学生。甲：他有那么高吗？乙：有，我们都知道。",
      "pinyin": "Jiǎ: Xiǎo Wáng de gèzi zhēn gāo. Yǐ: Tā bǐ wǒ gāo, yě shì wǒmen bān zuì gāo de xuésheng. Jiǎ: Tā yǒu nàme gāo ma? Yǐ: Yǒu, wǒmen dōu zhīdào.",
      "meaning": "A: Tiểu Vương cao thật. B: Cậu ấy cao hơn tôi, cũng là học sinh cao nhất lớp chúng tôi. A: Cậu ấy cao đến thế à? B: Có, chúng tôi đều biết.",
      "readingMinutes": 2
    },
