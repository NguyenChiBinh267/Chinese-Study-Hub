  "blocks": [
    {
      "id": "l410-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 预报 yùbào: dự báo; 连续 liánxù: liên tiếp; 朝南 cháo nán: hướng nam; 气温 qìwēn: nhiệt độ không khí. Câu hỏi dạng từ nếu hỏi 窗/窗户 phải chỉ rõ số chữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l410-t0",
      "type": "teaching",
      "title": "窗 · cửa sổ (dạng đơn âm)",
      "text": "窗 thường gặp trong 开窗、关窗; cùng chỉ cửa sổ như 窗户, nên bài yêu cầu phân biệt dạng một chữ và hai chữ khi truy hồi. Nhận diện chữ 窗 trong 窗; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "屋里太热了，请开窗。",
      "pinyin": "Wū lǐ tài rè le, qǐng kāi chuāng.",
      "meaning": "Trong phòng nóng quá, hãy mở cửa sổ.",
      "readingMinutes": 1
    },
    {
      "id": "l410-t1",
      "type": "teaching",
      "title": "窗户 · cửa sổ",
      "text": "窗户 đọc chuānghu, âm 户 nhẹ; có thể dùng làm danh từ độc lập, đồng nghĩa gần 窗 trong nhiều câu.",
      "hanzi": "这扇窗户朝南。",
      "pinyin": "Zhè shàn chuānghu cháo nán.",
      "meaning": "Cửa sổ này hướng nam.",
      "readingMinutes": 1
    },
    {
      "id": "l410-t2",
      "type": "teaching",
      "title": "吹 · thổi",
      "text": "吹 có thể tả gió thổi hoặc thổi bằng miệng; ở đây là tác động của gió.",
      "hanzi": "风把桌上的纸吹走了。",
      "pinyin": "Fēng bǎ zhuō shàng de zhǐ chuī zǒu le.",
      "meaning": "Gió thổi bay giấy trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l410-t3",
      "type": "teaching",
      "title": "低温 · nhiệt độ thấp",
      "text": "低温 là danh từ chỉ tình trạng nhiệt độ thấp theo bối cảnh, không tự chỉ một con số chuẩn.",
      "hanzi": "预报说明天会有低温。",
      "pinyin": "Yùbào shuō míngtiān huì yǒu dīwēn.",
      "meaning": "Dự báo nói ngày mai có nhiệt độ thấp.",
      "readingMinutes": 1
    },
    {
      "id": "l410-t4",
      "type": "teaching",
      "title": "高温 · nhiệt độ cao",
      "text": "高温 nói mức nhiệt cao trong bối cảnh thời tiết hoặc kỹ thuật; không tự đồng nghĩa bị sốt.",
      "hanzi": "最近这里连续出现高温。",
      "pinyin": "Zuìjìn zhèlǐ liánxù chūxiàn gāowēn.",
      "meaning": "Gần đây nơi này liên tiếp có nhiệt độ cao.",
      "readingMinutes": 1
    },
    {
      "id": "l410-t5",
      "type": "teaching",
      "title": "高于 · cao hơn (mốc)",
      "text": "高于 nhận mốc so sánh như 去年同期; không thay cho mọi cách nói chiều cao của người.",
      "hanzi": "今天的气温高于昨天。",
      "pinyin": "Jīntiān de qìwēn gāoyú zuótiān.",
      "meaning": "Nhiệt độ hôm nay cao hơn hôm qua.",
      "readingMinutes": 1
    },
    {
      "id": "l410-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "跟+A+相比 đặt đối tượng làm mốc so sánh. Cao hơn mốc có thể nói 高于; 高温 và 低温 cần ngữ cảnh/mốc, không phải ngưỡng cố định do bài quy định.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l410-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "李老师看了一份旧天气记录：去年这个月有高温，后来又出现低温。跟去年相比，今年同一天的气温高于去年。她打开朝南的窗户，风把一张纸吹走了，于是马上关窗。",
      "pinyin": "Lǐ lǎoshī kàn le yí fèn jiù tiānqì jìlù: Qùnián zhège yuè yǒu gāowēn, hòulái yòu chūxiàn dīwēn. Gēn qùnián xiāngbǐ, jīnnián tóng yì tiān de qìwēn gāoyú qùnián. Tā dǎkāi cháo nán de chuānghu, fēng bǎ yì zhāng zhǐ chuī zǒu le, yúshì mǎshàng guān chuāng.",
      "meaning": "Cô Lý đọc ghi chép thời tiết cũ rồi so sánh cùng ngày giữa hai năm. Cô đóng cửa sổ sau khi gió thổi bay giấy. Đây là dữ liệu hư cấu.",
      "readingMinutes": 2
    },
    {
