  "blocks": [
    {
      "id": "l4051-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t0",
      "type": "teaching",
      "title": "高价 · giá cao",
      "text": "高价 là mức giá cao, không đồng nghĩa chất lượng tốt.",
      "hanzi": "这件旧物卖出了高价。",
      "pinyin": "Zhè jiàn jiù wù mài chū le gāo jià.",
      "meaning": "Món đồ cũ này bán được giá cao.",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t1",
      "type": "teaching",
      "title": "现金 · tiền mặt",
      "text": "现金 là tiền mặt, khác thanh toán chuyển khoản.",
      "hanzi": "他问能不能用现金。",
      "pinyin": "Tā wèn néng bù néng yòng xiàn jīn.",
      "meaning": "Anh ấy hỏi có dùng tiền mặt được không.",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t2",
      "type": "teaching",
      "title": "支付 · thanh toán; chi trả",
      "text": "支付 nói thực hiện khoản chi, không riêng một phương thức.",
      "hanzi": "请先确认支付方式。",
      "pinyin": "Qǐng xiān què rèn zhī fù fāng shì.",
      "meaning": "Xin xác nhận cách thanh toán trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t3",
      "type": "teaching",
      "title": "结账 · thanh toán hóa đơn",
      "text": "结账 thường dùng khi chốt khoản mua/bữa ăn. Nhận diện chữ 账 trong 结账; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们吃完饭去结账。",
      "pinyin": "Wǒ men chī wán fàn qù jié zhàng.",
      "meaning": "Chúng tôi ăn xong đi thanh toán.",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t4",
      "type": "teaching",
      "title": "赚 · kiếm được tiền; lãi",
      "text": "赚 nói kiếm được tiền; không tự xác định đã trừ mọi chi phí.",
      "hanzi": "他想靠手艺赚钱。",
      "pinyin": "Tā xiǎng kào shǒu yì zhuàn qián.",
      "meaning": "Anh ấy muốn kiếm tiền bằng tay nghề.",
      "readingMinutes": 1
    },
    {
      "id": "l4051-t5",
      "type": "teaching",
      "title": "值 · đáng giá; có giá trị bằng",
      "text": "值 đi với giá trị/giá tiền, khác 值得 đi với việc đáng làm.",
      "hanzi": "这本书值这个价吗？",
      "pinyin": "Zhè běn shū zhí zhè ge jià ma?",
      "meaning": "Quyển sách này có đáng giá ấy không?",
      "readingMinutes": 1
    },
    {
      "id": "l4051-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "贵是贵，可是… thừa nhận giá cao rồi bổ sung một mặt khác. Đây là quan điểm nhân vật, không tư vấn mua hay đầu tư.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4051-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里的小店卖手工本子。客人觉得高价不一定就值，结账前先问能否用现金支付。店主说自己靠手艺赚钱。客人回答：“贵是贵，可是我喜欢这个设计。”他先比较，再决定。",
      "pinyin": "Gù shi lǐ de xiǎo diàn mài shǒu gōng běn zi. Kè rén jué de gāo jià bù yí dìng jiù zhí, jié zhàng qián xiān wèn néng fǒu yòng xiàn jīn zhī fù. Diàn zhǔ shuō zì jǐ kào shǒu yì zhuàn qián. Kè rén huí dá: “Guì shì guì, kě shì wǒ xǐ huan zhè ge shè jì.” Tā xiān bǐ jiào, zài jué dìng.",
      "meaning": "Khách so sánh giá trị và hỏi phương thức thanh toán trước khi quyết định mua sổ thủ công.",
      "readingMinutes": 2
    },
