  "blocks": [
    {
      "id": "l237-prereq",
      "type": "teaching",
      "title": "Kiến thức hỗ trợ",
      "text": "Nhắc 我/你/他, 是/有/在, số và câu hỏi cơ bản; HSK1 chưa hoàn chỉnh. Từ hỗ trợ trong ngữ cảnh được giải thích tại mỗi mục; không cộng từ mới hay cấp mastery. 中餐馆 (Zhōngcānguǎn): quán món Trung, từ hỗ trợ ngoài mục tiêu được tính.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l237-reminder0",
      "type": "teaching",
      "title": "Nhắc từ đã học · 红茶",
      "text": "红茶 là tên loại trà, thường tương ứng black tea. Không dịch máy móc thành mọi nước trà màu đỏ.",
      "hanzi": "我想喝一杯红茶。",
      "pinyin": "Wǒ xiǎng hē yì bēi hóngchá.",
      "meaning": "Tôi muốn uống một cốc hồng trà.",
      "readingMinutes": 1
    },
    {
      "id": "l237-reminder1",
      "type": "teaching",
      "title": "Nhắc từ đã học · 绿茶",
      "text": "绿茶 là tên trà xanh; chữ 绿 có âm ü, không đọc lù. Giữ thanh bốn ở lǜ.",
      "hanzi": "妈妈喜欢喝绿茶。",
      "pinyin": "Māma xǐhuan hē lǜchá.",
      "meaning": "Mẹ thích uống trà xanh.",
      "readingMinutes": 1
    },
    {
      "id": "l237-reminder2",
      "type": "teaching",
      "title": "Nhắc từ đã học · 肉",
      "text": "肉 chỉ thịt nói chung; câu không nêu loại thì không tự kết luận thịt bò hay thịt lợn.",
      "hanzi": "我们买一些肉。",
      "pinyin": "Wǒmen mǎi yìxiē ròu.",
      "meaning": "Chúng tôi mua một ít thịt.",
      "readingMinutes": 1
    },
    {
      "id": "l237-reminder3",
      "type": "teaching",
      "title": "Nhắc từ đã học · 点",
      "text": "点2 là động từ trong 点菜 ở cấp2. Không dùng danh từ chấm/điểm hay lượng từ được chú thích cấp cao hơn để trả lời câu này.",
      "hanzi": "我们点鱼和肉吧。",
      "pinyin": "Wǒmen diǎn yú hé ròu ba.",
      "meaning": "Chúng ta gọi cá và thịt nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l237-grammar0",
      "type": "teaching",
      "title": "Cách nói 1",
      "text": "Trong 一包红茶, 包 là lượng từ một gói trà; khác 包 trong 我的包: danh từ chiếc túi. Không gộp hai chức năng thành cùng nghĩa từ vựng.",
      "hanzi": "我买了一包红茶。",
      "pinyin": "Wǒ mǎi le yì bāo hóngchá.",
      "meaning": "Tôi mua một gói trà đen.",
      "readingMinutes": 1
    },
    {
      "id": "l237-grammar1",
      "type": "teaching",
      "title": "Cách nói 2",
      "text": "十多个人 là hơn mười người, không xác định con số chính xác; 多 đứng sau số và trước lượng từ. Tránh dùng mẫu này để suy ra chính xác mười một.",
      "hanzi": "饭馆里有十多个人。",
      "pinyin": "Fànguǎn lǐ yǒu shí duō ge rén.",
      "meaning": "Trong quán có hơn mười người.",
      "readingMinutes": 1
    },
    {
      "id": "l237-grammar2",
      "type": "teaching",
      "title": "Cách nói 3",
      "text": "一个多小时 là hơn một giờ; 多 đứng sau lượng từ thời lượng. Khác 十多个人 là hơn mười người.",
      "hanzi": "我们吃了一个多小时。",
      "pinyin": "Wǒmen chī le yí ge duō xiǎoshí.",
      "meaning": "Chúng tôi ăn hơn một giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l237-grammar3",
      "type": "teaching",
      "title": "Cách nói 4",
      "text": "还是点鱼吧 là đề nghị sau cân nhắc; không phải câu hỏi lựa chọn với hai phương án. 平时: thường ngày; 试试: thử một chút, đều là hỗ trợ.",
      "hanzi": "还是点鱼吧。",
      "pinyin": "Háishi diǎn yú ba.",
      "meaning": "Hay là gọi cá đi.",
      "readingMinutes": 1
    },
    {
      "id": "l237-scene",
      "type": "teaching",
      "title": "Tình huống mới",
      "text": "Đọc hội thoại gọi món, phân biệt đồ uống, thói quen và cách nói lượng gần đúng.",
      "hanzi": "服务员：你们点什么？王：我平时喝绿茶，今天想试试红茶。李：我不吃肉，还是点鱼吧。王：我家里还有一包红茶，是妈妈买的。李：这家中餐馆的鱼不错，我上次来过。",
      "pinyin": "Fúwùyuán: Nǐmen diǎn shénme? Wáng: Wǒ píngshí hē lǜchá, jīntiān xiǎng shìshi hóngchá. Lǐ: Wǒ bù chī ròu, háishi diǎn yú ba. Wáng: Wǒ jiā lǐ hái yǒu yì bāo hóngchá, shì māma mǎi de. Lǐ: Zhè jiā Zhōngcānguǎn de yú búcuò, wǒ shàng cì lái guo.",
      "meaning": "Nhân viên hỏi gọi gì. Vương thường uống trà xanh, hôm nay muốn thử trà đen. Lý không ăn thịt và đề nghị gọi cá. Nhà Vương còn một gói trà đen mẹ mua. Lý nhận xét cá ở quán món Trung khá ngon và đã từng đến đây.",
      "readingMinutes": 2
    },
