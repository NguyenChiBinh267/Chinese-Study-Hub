  "blocks": [
    {
      "id": "l1165-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder0",
      "type": "teaching",
      "title": "找 · tìm",
      "text": "Từ đã học 找 có 1 chữ. Chữ 找 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 找 với 我 / 战 / 划; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我找我的书。",
      "pinyin": "Wǒ zhǎo wǒ de shū.",
      "meaning": "Tôi tìm sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder1",
      "type": "teaching",
      "title": "公司 · công ty",
      "text": "Từ đã học 公司 có 2 chữ. Chữ 公 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 公 với 么 / 去 / 云; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是我姐姐的公司。",
      "pinyin": "Zhè shì wǒ jiě jie de gōng sī.",
      "meaning": "Đây là công ty của chị gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder2",
      "type": "teaching",
      "title": "工作 · làm việc; công việc",
      "text": "Từ đã học 工作 có 2 chữ. Chữ 作 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 作 với 昨 / 做 / 休; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我在公司工作。",
      "pinyin": "Wǒ zài gōng sī gōng zuò.",
      "meaning": "Tôi làm việc ở công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder3",
      "type": "teaching",
      "title": "上班 · đi làm; vào ca làm",
      "text": "Từ đã học 上班 có 2 chữ. Chữ 班 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 班 với 斑 / 辨 / 辩; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我妈妈上班。",
      "pinyin": "Wǒ mā ma shàng bān.",
      "meaning": "Mẹ tôi đi làm.",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder4",
      "type": "teaching",
      "title": "先生 · ông; anh (xưng hô lịch sự)",
      "text": "Từ đã học 先生 có 2 chữ. Chữ 先 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 先 với 失 / 告 / 洗; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "林先生，您好！",
      "pinyin": "Lín xiān sheng, nín hǎo!",
      "meaning": "Chào ông/anh Lâm!",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reminder5",
      "type": "teaching",
      "title": "女士 · bà; cô; chị (xưng hô lịch sự)",
      "text": "Từ đã học 女士 có 2 chữ. Chữ 士 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 士 với 土 / 干 / 王; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "安女士，您好！",
      "pinyin": "Ān nǚ shì, nín hǎo!",
      "meaning": "Chào bà/chị An!",
      "readingMinutes": 1
    },
    {
      "id": "l1165-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：下课了，你去哪儿？\nB：我去书店买书。\nA：我也去。",
      "pinyin": "A: Xià kè le, nǐ qù nǎr? B: Wǒ qù shū diàn mǎi shū. A: Wǒ yě qù.",
      "meaning": "Sau giờ học, B đi hiệu sách mua sách; A nói cũng đi.",
      "readingMinutes": 2
    },
