  "blocks": [
    {
      "id": "l4083-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4083-t0",
      "type": "teaching",
      "title": "社会 · xã hội",
      "text": "社会 ở 社会活动 nói sinh hoạt với cộng đồng, không chỉ một gia đình.",
      "hanzi": "学校组织了一次社会活动。",
      "pinyin": "Xué xiào zǔ zhī le yí cì shè huì huó dòng.",
      "meaning": "Trường tổ chức một hoạt động xã hội.",
      "readingMinutes": 1
    },
    {
      "id": "l4083-t1",
      "type": "teaching",
      "title": "使 · khiến; làm cho",
      "text": "使 nối nguyên nhân với chủ thể chịu tác động trong câu. Nhận diện chữ 使 trong 使; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "清楚的说明使我明白了要求。",
      "pinyin": "Qīng chu de shuō míng shǐ wǒ míng bai le yāo qiú.",
      "meaning": "Giải thích rõ khiến tôi hiểu yêu cầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4083-t2",
      "type": "teaching",
      "title": "养成 · hình thành; rèn thành",
      "text": "养成 thường đi với thói quen, cần quá trình chứ không chỉ một lần làm.",
      "hanzi": "她慢慢养成了阅读习惯。",
      "pinyin": "Tā màn màn yǎng chéng le yuè dú xí guàn.",
      "meaning": "Cô ấy dần hình thành thói quen đọc.",
      "readingMinutes": 1
    },
    {
      "id": "l4083-t3",
      "type": "teaching",
      "title": "增长 · tăng lên; phát triển",
      "text": "增长 thường dùng với kiến thức, kinh nghiệm hoặc đại lượng thích hợp; không đồng nghĩa đã thành thạo.",
      "hanzi": "交流使我的知识有所增长。",
      "pinyin": "Jiāo liú shǐ wǒ de zhī shi yǒu suǒ zēng zhǎng.",
      "meaning": "Trao đổi giúp kiến thức tôi tăng thêm đôi chút.",
      "readingMinutes": 1
    },
    {
      "id": "l4083-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… thêm một hoạt động học cụ thể. 使 làm cho một thay đổi xảy ra trong lời kể; không từ một ví dụ suy ra quan hệ nhân quả cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4083-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校的社会活动包括一个读书小组。清楚的说明使小安明白了要求：不仅阅读，还要提出问题。几周后，她说自己慢慢养成了阅读习惯，知识有所增长。这个自述不能证明所有参加者都有同样的变化。",
      "pinyin": "Xué xiào de shè huì huó dòng bāo kuò yí ge dú shū xiǎo zǔ. Qīng chu de shuō míng shǐ Xiǎo Ān míng bai le yāo qiú: bù jǐn yuè dú, hái yào tí chū wèn tí. Jǐ zhōu hòu, tā shuō zì jǐ màn màn yǎng chéng le yuè dú xí guàn, zhī shi yǒu suǒ zēng zhǎng. Zhè ge zì shù bù néng zhèng míng suǒ yǒu cān jiā zhě dōu yǒu tóng yàng de biàn huà.",
      "meaning": "Một người kể đã hình thành thói quen sau nhiều tuần; chưa có dữ kiện cho mọi thành viên.",
      "readingMinutes": 2
    },
