  "blocks": [
    {
      "id": "l4072-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t0",
      "type": "teaching",
      "title": "原来 · hóa ra; ban đầu",
      "text": "原来 có nhiều cách dùng; ở đây phát hiện điều khác với tưởng tượng.",
      "hanzi": "原来那只是一个梦。",
      "pinyin": "Yuán lái nà zhǐ shì yí ge mèng.",
      "meaning": "Hóa ra đó chỉ là một giấc mơ.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t1",
      "type": "teaching",
      "title": "做梦 · nằm mơ",
      "text": "做梦 chỉ trải nghiệm khi ngủ trong câu này. Nhận diện chữ 梦 trong 做梦; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "昨晚我做梦了。",
      "pinyin": "Zuó wǎn wǒ zuò mèng le.",
      "meaning": "Tối qua tôi nằm mơ.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t2",
      "type": "teaching",
      "title": "重 · nặng",
      "text": "重 đọc zhòng, mô tả trọng lượng; không dùng cách đọc chóng ở đây.",
      "hanzi": "这个书包很重。",
      "pinyin": "Zhè ge shū bāo hěn zhòng.",
      "meaning": "Cặp này rất nặng.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t3",
      "type": "teaching",
      "title": "重点 · trọng điểm; điểm chính",
      "text": "重点 là phần cần tập trung, không phải 重量 là cân nặng.",
      "hanzi": "这次练习的重点是顺序。",
      "pinyin": "Zhè cì liàn xí de zhòng diǎn shì shùn xù.",
      "meaning": "Trọng điểm lần luyện này là thứ tự.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t4",
      "type": "teaching",
      "title": "重视 · coi trọng",
      "text": "重视 nói dành sự chú ý nghiêm túc cho điều gì.",
      "hanzi": "老师重视每个人的问题。",
      "pinyin": "Lǎo shī zhòng shì měi ge rén de wèn tí.",
      "meaning": "Giáo viên coi trọng câu hỏi của mỗi người.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-t5",
      "type": "teaching",
      "title": "自信 · tự tin",
      "text": "自信 ở đây là trạng thái tin vào khả năng bản thân, không bảo đảm luôn đúng.",
      "hanzi": "准备以后，她更自信了。",
      "pinyin": "Zhǔn bèi yǐ hòu, tā gèng zì xìn le.",
      "meaning": "Chuẩn bị xong cô ấy tự tin hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l4072-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 hạn định kết luận: việc trong mơ không phải kết quả thực tế. 重 trong bài đọc zhòng là nặng, không phải chóng trong 重复.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4072-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "昨晚小安做梦，梦见自己背着很重的书包去考试，什么题都会。醒来才发现原来只是梦，不过她没有因此不准备。她把顺序当作复习重点，重视实际练习，准备后更自信了。",
      "pinyin": "Zuó wǎn Xiǎo Ān zuò mèng, mèng jiàn zì jǐ bēi zhe hěn zhòng de shū bāo qù kǎo shì, shén me tí dōu huì. Xǐng lái cái fā xiàn yuán lái zhǐ shì mèng, bú guò tā méi yǒu yīn cǐ bù zhǔn bèi. Tā bǎ shùn xù dàng zuò fù xí zhòng diǎn, zhòng shì shí jì liàn xí, zhǔn bèi hòu gèng zì xìn le.",
      "meaning": "Giấc mơ làm bài tốt không thay cho chuẩn bị; Tiểu An vẫn luyện phần thứ tự.",
      "readingMinutes": 2
    },
