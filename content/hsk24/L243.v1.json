  "blocks": [
    {
      "id": "l243-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "Cần biết 这/那, 的 và 要: 这 là này, 那 là kia, 的 giúp lược danh từ đã rõ; 要 ở đây là muốn lấy. Đây là nhắc kiến thức, không xác nhận đã nắm HSK1. 件 đếm món quần áo trong 一件衣服. 手表 không dùng lượng từ 条 trong ví dụ này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t0",
      "type": "teaching",
      "title": "Nhắc lại · 黑色 · màu đen",
      "text": "黑色 là tên màu, không phải riêng vật màu đen. Thêm 的 trước danh từ: 黑色的裤子.",
      "hanzi": "我想买黑色的裤子。",
      "pinyin": "Wǒ xiǎng mǎi hēisè de kùzi.",
      "meaning": "Tôi muốn mua quần màu đen.",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t1",
      "type": "teaching",
      "title": "Nhắc lại · 红色 · màu đỏ",
      "text": "红色 chỉ màu đỏ; đừng nhầm với 红茶, tên một loại trà.",
      "hanzi": "这件衣服是红色的。",
      "pinyin": "Zhè jiàn yīfu shì hóngsè de.",
      "meaning": "Bộ quần áo này màu đỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t2",
      "type": "teaching",
      "title": "Nhắc lại · 绿色 · màu xanh lá",
      "text": "Chỉ dùng 绿色 như tên màu (danh từ) ở bài này. Không mở rộng sang các nghĩa tính từ ở cấp cao hơn.",
      "hanzi": "我喜欢绿色。",
      "pinyin": "Wǒ xǐhuan lǜsè.",
      "meaning": "Tôi thích màu xanh lá.",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t3",
      "type": "teaching",
      "title": "Nhắc lại · 颜色 · màu sắc",
      "text": "Hỏi màu dùng 什么颜色. 颜色 không phải từ chỉ một màu cụ thể.",
      "hanzi": "你喜欢什么颜色？",
      "pinyin": "Nǐ xǐhuan shénme yánsè?",
      "meaning": "Bạn thích màu gì?",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t4",
      "type": "teaching",
      "title": "Nhắc lại · 裤子 · quần",
      "text": "Đếm quần với 条: 一条裤子. 子 đọc nhẹ. 条 được giải thích hỗ trợ ở đây, sẽ luyện riêng trong bài mua đồ.",
      "hanzi": "这条裤子是黑色的。",
      "pinyin": "Zhè tiáo kùzi shì hēisè de.",
      "meaning": "Chiếc quần này màu đen.",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-t5",
      "type": "teaching",
      "title": "Nhắc lại · 手表 · đồng hồ đeo tay",
      "text": "手表 đeo trên tay, không dùng thay cho mọi loại đồng hồ. 手 là tay, 表 trong từ này chỉ đồng hồ.",
      "hanzi": "我的手表在桌子上。",
      "pinyin": "Wǒ de shǒubiǎo zài zhuōzi shang.",
      "meaning": "Đồng hồ đeo tay của tôi ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l243-t0-l203-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "Màu + 的 thay cho món đồ đã nhắc: 红色的 nghĩa là cái màu đỏ. Không cần lặp lại 裤子 nếu người nghe đã biết đang chọn quần.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l243-t0-l203-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你想买什么颜色的裤子？乙：黑色的。甲：这条怎么样？乙：很好。我还想看手表。",
      "pinyin": "Jiǎ: Nǐ xiǎng mǎi shénme yánsè de kùzi? Yǐ: Hēisè de. Jiǎ: Zhè tiáo zěnmeyàng? Yǐ: Hěn hǎo. Wǒ hái xiǎng kàn shǒubiǎo.",
      "meaning": "A: Bạn muốn mua quần màu gì? B: Màu đen. A: Chiếc này thế nào? B: Tốt. Tôi còn muốn xem đồng hồ đeo tay.",
      "readingMinutes": 2
    },
