  "blocks": [
    {
      "id": "l372-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 来源 láiyuán: nguồn; 日期 rìqī: ngày tháng; 照常 zhàocháng: như thường; 套 tào: áp rập khuôn; 标题 biāotí: tiêu đề.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l372-t0",
      "type": "teaching",
      "title": "报纸 · báo giấy/tờ báo",
      "text": "报纸 là báo dạng giấy trong bài; 新闻 là nội dung tin, không đồng nhất vật mang với nội dung. 一份报纸 dùng 份.",
      "hanzi": "爷爷每天看报纸。",
      "pinyin": "Yéye měi tiān kàn bàozhǐ.",
      "meaning": "Ông đọc báo mỗi ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l372-t1",
      "type": "teaching",
      "title": "查 · tra/tìm kiểm",
      "text": "查 là tra cứu/kiểm tra thông tin như 查字典、查时间. Không phải mọi 看 đã là kiểm tra đúng nguồn.",
      "hanzi": "我先查消息的来源。",
      "pinyin": "Wǒ xiān chá xiāoxi de láiyuán.",
      "meaning": "Tôi tra nguồn tin trước.",
      "readingMinutes": 1
    },
    {
      "id": "l372-t2",
      "type": "teaching",
      "title": "根据 · dựa theo/căn cứ",
      "text": "根据 trong 根据通知是 giới từ dẫn căn cứ; không phải kết luận không thể sai. Đọc ngày và phạm vi nguồn cùng lúc.",
      "hanzi": "根据通知，明天照常上课。",
      "pinyin": "Gēnjù tōngzhī, míngtiān zhàocháng shàng kè.",
      "meaning": "Theo thông báo, ngày mai học bình thường.",
      "readingMinutes": 1
    },
    {
      "id": "l372-t3",
      "type": "teaching",
      "title": "新闻 · tin tức",
      "text": "新闻 là tin tức, có thể trên báo/mạng. Tin được viết chưa tự là đã kiểm chứng; cần nguồn và ngày.",
      "hanzi": "这条新闻是昨天的。",
      "pinyin": "Zhè tiáo xīnwén shì zuótiān de.",
      "meaning": "Tin này là của hôm qua.",
      "readingMinutes": 1
    },
    {
      "id": "l372-t4",
      "type": "teaching",
      "title": "影响 · ảnh hưởng/tác động",
      "text": "影响 có thể động từ hoặc danh từ; 天气影响出行 nêu tác động, chưa nói đây là nguyên nhân duy nhất của mọi thay đổi.",
      "hanzi": "天气影响了出行安排。",
      "pinyin": "Tiānqì yǐngxiǎng le chūxíng ānpái.",
      "meaning": "Thời tiết ảnh hưởng kế hoạch đi lại.",
      "readingMinutes": 1
    },
    {
      "id": "l372-t5",
      "type": "teaching",
      "title": "最近 · gần đây/dạo này",
      "text": "最近 là khoảng gần thời điểm nói, không có độ dài ngày cố định. 最近的新闻 cần kiểm ngày thực tế khi dùng.",
      "hanzi": "最近我常看学校的新闻。",
      "pinyin": "Zuìjìn wǒ cháng kàn xuéxiào de xīnwén.",
      "meaning": "Gần đây tôi hay xem tin trường.",
      "readingMinutes": 1
    },
    {
      "id": "l372-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "根据通知 nêu căn cứ đang dùng cho kết luận; 不 chứng minh thông báo luôn đúng hoặc còn hiệu lực. 影响 là tác động, chưa là nguyên nhân duy nhất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l372-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "最近，小林跟爷爷看报纸上的新闻。听说天气会影响出行，他先查来源和日期。根据今天的学校通知，明天照常上课；昨天那条新闻谈的是另一座城市，不能直接套到自己学校。",
      "pinyin": "Zuìjìn, Xiǎo Lín gēn yéye kàn bàozhǐ shàng de xīnwén. Tīngshuō tiānqì huì yǐngxiǎng chūxíng, tā xiān chá láiyuán hé rìqī. Gēnjù jīntiān de xuéxiào tōngzhī, míngtiān zhàocháng shàng kè; zuótiān nà tiáo xīnwén tán de shì lìng yí zuò chéngshì, bù néng zhíjiē tào dào zìjǐ xuéxiào.",
      "meaning": "Lâm cùng ông đọc báo, tra nguồn và ngày khi nghe tin thời tiết ảnh hưởng đi lại. Thông báo trường hôm nay vẫn học ngày mai; tin hôm qua thuộc thành phố khác nên không áp thẳng.",
      "readingMinutes": 2
    },
