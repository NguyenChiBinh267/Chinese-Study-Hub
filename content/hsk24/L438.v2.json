  "blocks": [
    {
      "id": "l438-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 形式 xíngshì: hình thức; 却 què: nhưng lại; 暖和 nuǎnhuo: ấm áp; 假期 jiàqī: kỳ nghỉ. 旅行 lǚxíng: du lịch; từ hỗ trợ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l438-t0",
      "type": "teaching",
      "title": "度假 · nghỉ dưỡng, đi nghỉ",
      "text": "度假 là dành kỳ nghỉ để nghỉ ngơi/du lịch, khác 放假 là được nghỉ.",
      "hanzi": "我们寒假去海边度假。",
      "pinyin": "Wǒmen hánjià qù hǎibiān dùjià.",
      "meaning": "Nghỉ đông chúng tôi ra biển nghỉ dưỡng.",
      "readingMinutes": 1
    },
    {
      "id": "l438-t1",
      "type": "teaching",
      "title": "风景 · phong cảnh",
      "text": "风景 nói cảnh quan nhìn thấy; không chỉ thời tiết.",
      "hanzi": "这里的风景很美。",
      "pinyin": "Zhèlǐ de fēngjǐng hěn měi.",
      "meaning": "Phong cảnh ở đây đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l438-t2",
      "type": "teaching",
      "title": "多样 · đa dạng",
      "text": "多样 nhấn mạnh có nhiều loại, không chỉ số lượng nhiều của một loại.",
      "hanzi": "这里的活动形式多样。",
      "pinyin": "Zhèlǐ de huódòng xíngshì duōyàng.",
      "meaning": "Hình thức hoạt động ở đây đa dạng.",
      "readingMinutes": 1
    },
    {
      "id": "l438-t3",
      "type": "teaching",
      "title": "丰富 · phong phú",
      "text": "丰富 dùng cho nội dung, kinh nghiệm hay sản vật dồi dào; trong bài là hoạt động.",
      "hanzi": "假期的活动很丰富。",
      "pinyin": "Jiàqī de huódòng hěn fēngfù.",
      "meaning": "Hoạt động kỳ nghỉ rất phong phú.",
      "readingMinutes": 1
    },
    {
      "id": "l438-t4",
      "type": "teaching",
      "title": "寒假 · kỳ nghỉ đông",
      "text": "寒假 thường là kỳ nghỉ đông của nhà trường; không phải mọi ngày lạnh. Nhận diện chữ 寒 trong 寒假; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "寒假我们不住校。",
      "pinyin": "Hánjià wǒmen bú zhù xiào.",
      "meaning": "Nghỉ đông chúng tôi không ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l438-t5",
      "type": "teaching",
      "title": "寒冷 · giá lạnh",
      "text": "寒冷 miêu tả khí hậu/thời tiết lạnh, trang trọng hơn 冷.",
      "hanzi": "北部冬天很寒冷。",
      "pinyin": "Běibù dōngtiān hěn hánlěng.",
      "meaning": "Mùa đông miền bắc giá lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l438-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "多么 + tính từ diễn đạt cảm thán, thường có 啊 ở cuối: 这里的风景多么美啊！ Không dùng 多么 để hỏi số lượng như 多少. Bài chỉ luyện câu cảm thán đã cho.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l438-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "寒假，小周想去北部看雪，姐姐却想去海边度假。北部天气寒冷，海边比较暖和。旅行介绍上说，海边风景美，活动丰富，形式也多样。姐姐看着照片说：“这里的风景多么美啊！”他们最后决定先去海边。",
      "pinyin": "Hánjià, Xiǎo Zhōu xiǎng qù běibù kàn xuě, jiějie què xiǎng qù hǎibiān dùjià. Běibù tiānqì hánlěng, hǎibiān bǐjiào nuǎnhuo. Lǚxíng jièshào shàng shuō, hǎibiān fēngjǐng měi, huódòng fēngfù, xíngshì yě duōyàng. Jiějie kànzhe zhàopiàn shuō: “Zhèlǐ de fēngjǐng duōme měi a!” Tāmen zuìhòu juédìng xiān qù hǎibiān.",
      "meaning": "Châu muốn xem tuyết nhưng chị muốn nghỉ ở biển. Miền bắc lạnh, biển ấm hơn. Tờ giới thiệu nói biển đẹp, hoạt động phong phú và đa dạng. Họ chọn biển trước.",
      "readingMinutes": 2
    },
    {
