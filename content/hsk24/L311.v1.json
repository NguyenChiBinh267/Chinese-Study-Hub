  "blocks": [
    {
      "id": "l311-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 不/没, 很, số lượng và địa điểm. HSK1/2 chưa hoàn chỉnh; chỉ khám phá DRAFT. 不但 búdàn: không chỉ; 而且 érqiě: mà còn; 一瓶 yì píng: một chai; 很久 hěn jiǔ: lâu. Bài chỉ hiểu nhu cầu và hội thoại, không chấm lựa chọn dinh dưỡng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l311-t0",
      "type": "teaching",
      "title": "饿 · đói",
      "text": "饿 tả cảm giác đói; khác 渴 khát. 很饿 không nói chính xác cần ăn bao nhiêu hoặc suy ra nguyên nhân y tế.",
      "hanzi": "我有点儿饿，想吃饭。",
      "pinyin": "Wǒ yǒudiǎnr è, xiǎng chī fàn.",
      "meaning": "Tôi hơi đói, muốn ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l311-t1",
      "type": "teaching",
      "title": "渴 · khát",
      "text": "渴 tả khát nước; khác 可 kě trong 可是 và khác 饱 no. 我渴了 là lời báo cảm giác.",
      "hanzi": "走了很久，我有点儿渴。",
      "pinyin": "Zǒu le hěn jiǔ, wǒ yǒudiǎnr kě.",
      "meaning": "Đi lâu rồi, tôi hơi khát.",
      "readingMinutes": 1
    },
    {
      "id": "l311-t2",
      "type": "teaching",
      "title": "饱 · no",
      "text": "饱 trong 吃饱了 nói đã no sau ăn; không đồng nghĩa đồ ăn ngon hay món ăn đã hết.",
      "hanzi": "我吃饱了，不想再吃。",
      "pinyin": "Wǒ chī bǎo le, bù xiǎng zài chī.",
      "meaning": "Tôi no rồi, không muốn ăn thêm.",
      "readingMinutes": 1
    },
    {
      "id": "l311-t3",
      "type": "teaching",
      "title": "冰箱 · tủ lạnh",
      "text": "冰箱 là thiết bị để giữ lạnh; khác 箱子 thùng/hộp nói chung. Trong bài chỉ hỏi nơi lấy đồ uống.",
      "hanzi": "饮料在冰箱里。",
      "pinyin": "Yǐnliào zài bīngxiāng lǐ.",
      "meaning": "Đồ uống ở trong tủ lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l311-t4",
      "type": "teaching",
      "title": "饮料 · đồ uống",
      "text": "饮料 nói chung về đồ uống; 矿泉水 là loại nước cụ thể. Chọn theo loại được hỏi, không gán mọi đồ uống là nước khoáng.",
      "hanzi": "这里有水，也有别的饮料。",
      "pinyin": "Zhèlǐ yǒu shuǐ, yě yǒu biéde yǐnliào.",
      "meaning": "Ở đây có nước và các đồ uống khác.",
      "readingMinutes": 1
    },
    {
      "id": "l311-t5",
      "type": "teaching",
      "title": "矿泉水 · nước khoáng",
      "text": "矿泉水 chỉ nước khoáng; không dùng cho mọi chai nước không nhãn. 这瓶矿泉水是我的 nói quyền sở hữu, không có tuyên bố sức khỏe.",
      "hanzi": "我想买一瓶矿泉水。",
      "pinyin": "Wǒ xiǎng mǎi yì píng kuàngquánshuǐ.",
      "meaning": "Tôi muốn mua một chai nước khoáng.",
      "readingMinutes": 1
    },
    {
      "id": "l311-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不但……而且…… thêm thông tin cùng hướng: 我不但渴，而且饿. Không đồng nghĩa tuy…nhưng hoặc nếu…thì. Mẫu mô tả lời nói cá nhân trong tình huống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l311-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我不但渴，而且饿。小李：饮料在冰箱里，你想喝什么？小安：我想喝矿泉水。小李：饭也好了。小安：谢谢。过了一会儿，小安说：我吃饱了，不用再给我拿饭。",
      "pinyin": "Xiǎo Ān: Wǒ búdàn kě, érqiě è. Xiǎo Lǐ: Yǐnliào zài bīngxiāng lǐ, nǐ xiǎng hē shénme? Xiǎo Ān: Wǒ xiǎng hē kuàngquánshuǐ. Xiǎo Lǐ: Fàn yě hǎo le. Xiǎo Ān: Xièxie. Guò le yíhuìr, Xiǎo Ān shuō: Wǒ chī bǎo le, búyòng zài gěi wǒ ná fàn.",
      "meaning": "An vừa khát vừa đói, muốn uống nước khoáng. Lý nói đồ uống trong tủ lạnh và cơm đã xong. Sau một lúc An nói đã no, không cần lấy thêm cơm.",
      "readingMinutes": 2
    },
    {
      "id": "l311-b0",
      "type": "exercise",
      "exerciseVersionId": "l311-v1-e0"
