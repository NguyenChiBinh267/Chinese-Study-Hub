  "blocks": [
    {
      "id": "l165-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l165-t0",
      "type": "teaching",
      "title": "车 · xe; phương tiện xe",
      "text": "车 là tên xe chung trong bài, không suy mọi phương tiện đều gọi là 车.",
      "hanzi": "这是我的车。",
      "pinyin": "Zhè shì wǒ de chē.",
      "meaning": "Đây là xe của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l165-t1",
      "type": "teaching",
      "title": "出租车 · taxi; xe cho thuê chở khách",
      "text": "出租车 là danh từ taxi, không phải động từ đặt/gọi xe.",
      "hanzi": "我坐出租车。",
      "pinyin": "Wǒ zuò chū zū chē.",
      "meaning": "Tôi đi taxi.",
      "readingMinutes": 1
    },
    {
      "id": "l165-t2",
      "type": "teaching",
      "title": "火车 · tàu hỏa; xe lửa",
      "text": "火车 là tàu hỏa, không suy lịch chạy hoặc giá vé từ tên phương tiện.",
      "hanzi": "我坐火车去学校。",
      "pinyin": "Wǒ zuò huǒ chē qù xué xiào.",
      "meaning": "Tôi đi tàu hỏa đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l165-t3",
      "type": "teaching",
      "title": "飞机 · máy bay",
      "text": "飞机 là máy bay; câu mẫu không xác nhận chuyến bay/điểm đến thực.",
      "hanzi": "我坐飞机。",
      "pinyin": "Wǒ zuò fēi jī.",
      "meaning": "Tôi đi máy bay.",
      "readingMinutes": 1
    },
    {
      "id": "l165-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Trong 我坐火车去学校, đi tàu là phương thức để tới trường: cùng một chủ thể làm chuỗi hành động. 坐 zuò trong mẫu nói đi bằng/ngồi trên phương tiện, học mục từ riêng ở bài kế tiếp. 车 là tên xe chung, 出租车/火车/飞机 là các loại phương tiện khác nhau; không đặt vé hay xác nhận hành trình thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l165-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你怎么去学校？\nB：我坐火车去学校。\nA：你姐姐呢？\nB：她坐出租车去学校。",
      "pinyin": "A: Nǐ zěn me qù xué xiào? B: Wǒ zuò huǒ chē qù xué xiào. A: Nǐ jiě jie ne? B: Tā zuò chū zū chē qù xué xiào.",
      "meaning": "B đi tàu hỏa; chị gái đi taxi. Đây là thông tin trong truyện, không phải đề xuất tuyến đi hoặc dịch vụ thực.",
      "readingMinutes": 2
    },
    {
