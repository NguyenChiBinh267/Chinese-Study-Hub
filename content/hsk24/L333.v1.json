  "blocks": [
    {
      "id": "l333-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 服务员 fúwùyuán: nhân viên phục vụ; 点 diǎn: gọi món; 汤 tāng: canh; 口 kǒu: ngụm/miếng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l333-t0",
      "type": "teaching",
      "title": "菜单 · thực đơn",
      "text": "菜单 liệt kê món của quán; 看菜单 là xem thực đơn, không phải món ăn mang ra.",
      "hanzi": "我们先看菜单。",
      "pinyin": "Wǒmen xiān kàn càidān.",
      "meaning": "Chúng tôi xem thực đơn trước.",
      "readingMinutes": 1
    },
    {
      "id": "l333-t1",
      "type": "teaching",
      "title": "尝 · nếm/thử vị",
      "text": "尝 là nếm một ít để biết vị; 尝尝 là thử nếm, không đồng nghĩa ăn hết.",
      "hanzi": "你先尝一口汤。",
      "pinyin": "Nǐ xiān cháng yì kǒu tāng.",
      "meaning": "Bạn nếm một ngụm canh trước.",
      "readingMinutes": 1
    },
    {
      "id": "l333-t2",
      "type": "teaching",
      "title": "筷子 · đũa",
      "text": "筷子 là đũa, 一双筷子 là một đôi; 子 đọc nhẹ, khác 刀叉 là dao nĩa.",
      "hanzi": "请给我一双筷子。",
      "pinyin": "Qǐng gěi wǒ yì shuāng kuàizi.",
      "meaning": "Hãy cho tôi một đôi đũa.",
      "readingMinutes": 1
    },
    {
      "id": "l333-t3",
      "type": "teaching",
      "title": "勺子 · thìa",
      "text": "勺子 là thìa/muỗng; dùng để múc trong ví dụ, không phải vật chứa cả bát canh.",
      "hanzi": "我用勺子喝汤。",
      "pinyin": "Wǒ yòng sháozi hē tāng.",
      "meaning": "Tôi dùng thìa uống canh.",
      "readingMinutes": 1
    },
    {
      "id": "l333-t4",
      "type": "teaching",
      "title": "碗 · bát; lượng từ bát",
      "text": "碗 gọi bát hoặc đếm khẩu phần một bát; 一碗饭 không phải mọi loại đồ đựng phẳng.",
      "hanzi": "这只碗里有米饭。",
      "pinyin": "Zhè zhī wǎn lǐ yǒu mǐfàn.",
      "meaning": "Trong bát này có cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l333-t5",
      "type": "teaching",
      "title": "盘子 · đĩa",
      "text": "盘子 gọi chiếc đĩa; 一盘菜 dùng 盘 làm lượng từ, không nói 一盘子 khi đề đã yêu cầu tên đồ đựng đơn thuần.",
      "hanzi": "请把菜放在盘子里。",
      "pinyin": "Qǐng bǎ cài fàng zài pánzi lǐ.",
      "meaning": "Hãy đặt thức ăn vào đĩa.",
      "readingMinutes": 1
    },
    {
      "id": "l333-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一碗饭 đếm một bát cơm, 一盘菜 đếm một đĩa thức ăn; 碗/盘子 riêng lẻ gọi đồ đựng. Không lấy số bát làm số người nếu đoạn không nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l333-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "服务员拿来菜单、碗和盘子。小林点了一碗饭，用筷子吃；小王用勺子尝了一口汤，说先不加别的。盘子里是大家一起吃的菜，不是一个人的全部饭菜。",
      "pinyin": "Fúwùyuán ná lái càidān, wǎn hé pánzi. Xiǎo Lín diǎn le yì wǎn fàn, yòng kuàizi chī; Xiǎo Wáng yòng sháozi cháng le yì kǒu tāng, shuō xiān bù jiā bié de. Pánzi lǐ shì dàjiā yìqǐ chī de cài, bú shì yí ge rén de quánbù fàncài.",
      "meaning": "Nhân viên mang thực đơn và bát đĩa. Lâm gọi một bát cơm; Vương thử canh bằng thìa, chưa thêm gì. Thức ăn trên đĩa để cùng ăn.",
      "readingMinutes": 2
    },
    {
