  "blocks": [
    {
      "id": "l256-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "看 là đọc/xem; 书 là sách. 别 nghĩa là đừng trong lời nhắc, không được tính là mục từ mới của bài này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t0",
      "type": "teaching",
      "title": "Nhắc lại · 已经 · đã",
      "text": "已经 đặt trước động từ, nhấn mạnh việc đã xảy ra trước mốc đang nói. Không dùng thay 快要 cho việc chưa bắt đầu.",
      "hanzi": "我已经看了这本书。",
      "pinyin": "Wǒ yǐjīng kàn le zhè běn shū.",
      "meaning": "Tôi đã đọc quyển sách này.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t1",
      "type": "teaching",
      "title": "Nhắc lại · 开始 · bắt đầu",
      "text": "开始 có thể là động từ hoặc danh từ; ở đây nói hoạt động bắt đầu, không phải làm xong.",
      "hanzi": "考试九点开始。",
      "pinyin": "Kǎoshì jiǔ diǎn kāishǐ.",
      "meaning": "Bài kiểm tra bắt đầu lúc chín giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t2",
      "type": "teaching",
      "title": "Nhắc lại · 快要 · sắp",
      "text": "快要 cho biết rất gần thời điểm xảy ra; chưa xác nhận đã bắt đầu. Mẫu thường đi với 了 cuối câu.",
      "hanzi": "电影快要开始了。",
      "pinyin": "Diànyǐng kuàiyào kāishǐ le.",
      "meaning": "Phim sắp bắt đầu rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t3",
      "type": "teaching",
      "title": "Nhắc lại · 完 · xong, hoàn tất",
      "text": "完 sau động từ nói đạt kết quả xong: 看完. 看了 chỉ đã đọc, chưa tự bảo đảm đọc hết.",
      "hanzi": "我看完这本书了。",
      "pinyin": "Wǒ kàn wán zhè běn shū le.",
      "meaning": "Tôi đọc xong quyển sách này rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t4",
      "type": "teaching",
      "title": "Nhắc lại · 记得 · nhớ, còn nhớ",
      "text": "记得 thường chỉ giữ được thông tin trong trí nhớ; không phải mọi cách học thuộc. 得 trong từ này đọc nhẹ.",
      "hanzi": "我记得明天有考试。",
      "pinyin": "Wǒ jìde míngtiān yǒu kǎoshì.",
      "meaning": "Tôi nhớ ngày mai có bài kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-t5",
      "type": "teaching",
      "title": "Nhắc lại · 忘 · quên",
      "text": "忘 đối lập với 记得. 别忘了 là lời nhắc đừng quên, không khẳng định người kia đã quên.",
      "hanzi": "别忘了拿书。",
      "pinyin": "Bié wàng le ná shū.",
      "meaning": "Đừng quên lấy sách.",
      "readingMinutes": 1
    },
    {
      "id": "l256-t0-l216-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "快要 + hoạt động + 了 báo việc sắp xảy ra. Phân biệt với 已经 là đã xảy ra và 完 chỉ kết quả làm xong.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l256-t0-l216-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：考试快要开始了，你记得拿书吗？乙：记得，我已经拿来了。甲：这本书你看完了吗？乙：还没有，今天我想看完。",
      "pinyin": "Jiǎ: Kǎoshì kuàiyào kāishǐ le, nǐ jìde ná shū ma? Yǐ: Jìde, wǒ yǐjīng ná lái le. Jiǎ: Zhè běn shū nǐ kàn wán le ma? Yǐ: Hái méiyǒu, jīntiān wǒ xiǎng kàn wán.",
      "meaning": "A: Bài kiểm tra sắp bắt đầu, bạn nhớ lấy sách không? B: Nhớ, tôi lấy đến rồi. A: Bạn đọc xong quyển sách này chưa? B: Chưa, hôm nay tôi muốn đọc xong.",
      "readingMinutes": 2
    },
