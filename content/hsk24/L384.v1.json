  "blocks": [
    {
      "id": "l384-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 寄 jì: gửi qua bưu điện; 本人 běnrén: chính người đó; 不过 búguò: nhưng; 地址 dìzhǐ: địa chỉ. Chỉ là tình huống đọc, không gửi thư thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l384-t0",
      "type": "teaching",
      "title": "除了 · ngoài/ngoại trừ",
      "text": "除了 có nhánh thêm (除了A还B) và loại (除了A都B); phải đọc vế sau, không dùng một bản dịch cho cả hai logic.",
      "hanzi": "除了小林以外，大家都写了信。",
      "pinyin": "Chúle Xiǎo Lín yǐwài, dàjiā dōu xiě le xìn.",
      "meaning": "Ngoại trừ Lâm, mọi người đều viết thư.",
      "readingMinutes": 1
    },
    {
      "id": "l384-t1",
      "type": "teaching",
      "title": "当然 · đương nhiên/tất nhiên",
      "text": "当然 thể hiện người nói coi là hiển nhiên/chấp thuận, không tự là bằng chứng điều đó đúng ngoài ngữ cảnh. 当然可以 là lời đồng ý.",
      "hanzi": "当然可以，不过要先问本人。",
      "pinyin": "Dāngrán kěyǐ, búguò yào xiān wèn běnrén.",
      "meaning": "Tất nhiên được, nhưng cần hỏi chính người đó trước.",
      "readingMinutes": 1
    },
    {
      "id": "l384-t2",
      "type": "teaching",
      "title": "其实 · thật ra",
      "text": "其实 dẫn thông tin thực tế trái điều đang tưởng; chỉ là cách trình bày, chưa tự kiểm chứng chân lý. 其实不是不想写 explains reasonchange.",
      "hanzi": "其实我已经写好了。",
      "pinyin": "Qíshí wǒ yǐjīng xiě hǎo le.",
      "meaning": "Thật ra tôi đã viết xong.",
      "readingMinutes": 1
    },
    {
      "id": "l384-t3",
      "type": "teaching",
      "title": "封 · lượng từ lá thư; niêm/phong tùy ngữ cảnh",
      "text": "封 trong 一封信/邮件 đếm một thư; khác 张 đếm tờ. Bài chưa dạy động từ niêm phong dù nguồn có nghĩa đó.",
      "hanzi": "我写了一封信。",
      "pinyin": "Wǒ xiě le yì fēng xìn.",
      "meaning": "Tôi viết một lá thư.",
      "readingMinutes": 1
    },
    {
      "id": "l384-t4",
      "type": "teaching",
      "title": "最好 · tốt nhất nên (lời khuyên)",
      "text": "最好+động từ thường khuyên nên làm, không ra lệnh tuyệt đối hay đo được “tối ưu”. 最好的书 là cấu trúc đánh giá khác, chưa chấm chung.",
      "hanzi": "最好先看要求，再写信。",
      "pinyin": "Zuìhǎo xiān kàn yāoqiú, zài xiě xìn.",
      "meaning": "Tốt nhất nên đọc yêu cầu trước rồi viết thư.",
      "readingMinutes": 1
    },
    {
      "id": "l384-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "除了小林以外，大家都写了信 dùng 除了…都… loại trừ Lâm khỏi khẳng định. Khác 除了信以外，还发了邮件 là thêm một việc. 最好 nêu gợi ý, không phải bảo đảm kết quả tốt nhất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l384-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "朋友以为除了小林以外，大家都写了一封信。小林说：其实我已经写好了，只是还没寄。朋友说：当然可以晚一点儿寄，不过最好先看地址和要求。这里不是说每个人都必须马上寄。",
      "pinyin": "Péngyou yǐwéi chúle Xiǎo Lín yǐwài, dàjiā dōu xiě le yì fēng xìn. Xiǎo Lín shuō: Qíshí wǒ yǐjīng xiě hǎo le, zhǐshì hái méi jì. Péngyou shuō: Dāngrán kěyǐ wǎn yìdiǎnr jì, búguò zuìhǎo xiān kàn dìzhǐ hé yāoqiú. Zhèlǐ bú shì shuō měi ge rén dōu bìxū mǎshàng jì.",
      "meaning": "Bạn tưởng Lâm chưa viết, nhưng Lâm nói thật ra đã xong, chỉ chưa gửi. Bạn đồng ý gửi muộn hơn và khuyên kiểm địa chỉ cùng yêu cầu trước; không bắt mọi người gửi ngay.",
      "readingMinutes": 2
    },
