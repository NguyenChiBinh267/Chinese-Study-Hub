  "blocks": [
    {
      "id": "l441-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 讨论 tǎolùn: thảo luận; 交流 jiāoliú: giao lưu; 经验 jīngyàn: kinh nghiệm; 顺 shùn: suôn sẻ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l441-t0",
      "type": "teaching",
      "title": "基本 · cơ bản",
      "text": "基本 bổ nghĩa danh từ, như 基本方法; không tự mang nghĩa đã thành thạo.",
      "hanzi": "先学习基本方法。",
      "pinyin": "Xiān xuéxí jīběn fāngfǎ.",
      "meaning": "Hãy học phương pháp cơ bản trước.",
      "readingMinutes": 1
    },
    {
      "id": "l441-t1",
      "type": "teaching",
      "title": "基本上 · về cơ bản",
      "text": "基本上 là phó từ nghĩa nhìn chung/gần như, vẫn có thể còn ngoại lệ.",
      "hanzi": "这些词我基本上都认识。",
      "pinyin": "Zhèxiē cí wǒ jīběnshàng dōu rènshi.",
      "meaning": "Về cơ bản tôi nhận ra những từ này.",
      "readingMinutes": 1
    },
    {
      "id": "l441-t2",
      "type": "teaching",
      "title": "基础 · nền tảng",
      "text": "基础 là phần kiến thức/kỹ năng làm nền; dùng 打好基础. Nhận diện chữ 础 trong 基础; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们要打好基础。",
      "pinyin": "Wǒmen yào dǎ hǎo jīchǔ.",
      "meaning": "Chúng ta cần xây nền tảng tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l441-t3",
      "type": "teaching",
      "title": "积极 · tích cực",
      "text": "积极 nói thái độ chủ động tham gia; không chỉ cảm giác vui vẻ.",
      "hanzi": "她积极参加讨论。",
      "pinyin": "Tā jījí cānjiā tǎolùn.",
      "meaning": "Cô ấy tích cực tham gia thảo luận.",
      "readingMinutes": 1
    },
    {
      "id": "l441-t4",
      "type": "teaching",
      "title": "积累 · tích lũy",
      "text": "积累 thường đi với 经验、知识; cần quá trình chứ không chỉ đọc một lần.",
      "hanzi": "每天阅读可以积累词语。",
      "pinyin": "Měi tiān yuèdú kěyǐ jīlěi cíyǔ.",
      "meaning": "Đọc hằng ngày giúp tích lũy từ ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l441-t5",
      "type": "teaching",
      "title": "继续 · tiếp tục",
      "text": "继续 nối hoạt động đã bắt đầu; không nhất thiết làm lại từ đầu như 重新.",
      "hanzi": "休息以后继续练习。",
      "pinyin": "Xiūxi yǐhòu jìxù liànxí.",
      "meaning": "Nghỉ xong tiếp tục luyện tập.",
      "readingMinutes": 1
    },
    {
      "id": "l441-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "首先 nêu việc đầu tiên, 其次 nêu ý/việc tiếp theo trong trình bày có thứ tự. Chúng không tự khẳng định quan hệ nguyên nhân. Ví dụ 首先打好基础，其次积累经验. Bài luyện giữ hai bước này theo thứ tự.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l441-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安学中文三个月了，基本上认识课本里的词，却不敢参加讨论。老师建议：“首先打好基础，其次积累交流经验。”小安先复习基本方法，再积极参加小组讨论。第一次说得不太顺，他休息以后继续练习。",
      "pinyin": "Xiǎo Ān xué Zhōngwén sān ge yuè le, jīběnshàng rènshi kèběn lǐ de cí, què bù gǎn cānjiā tǎolùn. Lǎoshī jiànyì: “Shǒuxiān dǎ hǎo jīchǔ, qícì jīlěi jiāoliú jīngyàn.” Xiǎo Ān xiān fùxí jīběn fāngfǎ, zài jījí cānjiā xiǎozǔ tǎolùn. Dì yī cì shuō de bú tài shùn, tā xiūxi yǐhòu jìxù liànxí.",
      "meaning": "An nhận mặt nhiều từ nhưng ngại thảo luận. Thầy khuyên xây nền trước, rồi tích lũy kinh nghiệm giao tiếp. Cậu ôn phương pháp và tham gia nhóm, tiếp tục luyện dù lần đầu chưa trôi chảy.",
      "readingMinutes": 2
    },
    {
