  "blocks": [
    {
      "id": "l4011-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t0",
      "type": "teaching",
      "title": "上门 · đến tận nhà",
      "text": "上门 là đến nhà/địa điểm khách, không chỉ bước lên cửa.",
      "hanzi": "师傅约好下午上门。",
      "pinyin": "Shī fu yuē hǎo xià wǔ shàng mén.",
      "meaning": "Thợ hẹn chiều đến nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t1",
      "type": "teaching",
      "title": "师傅 · thợ; cách gọi người có tay nghề",
      "text": "师傅 là cách gọi lịch sự thợ hoặc người có nghề; khác 师父 trong quan hệ thầy truyền nghề riêng.",
      "hanzi": "我先给师傅打电话。",
      "pinyin": "Wǒ xiān gěi shī fu dǎ diàn huà.",
      "meaning": "Tôi gọi điện cho bác thợ trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t2",
      "type": "teaching",
      "title": "修 · sửa",
      "text": "修 có thể dùng một chữ khi nói sửa vật; bài điền yêu cầu dạng một chữ. Nhận diện chữ 修 trong 修; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这把椅子还能修。",
      "pinyin": "Zhè bǎ yǐ zi hái néng xiū.",
      "meaning": "Chiếc ghế này còn sửa được.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t3",
      "type": "teaching",
      "title": "修理 · sửa chữa",
      "text": "修理 là động từ hai chữ, cùng trường nghĩa với 修; bài chọn yêu cầu dạng hai chữ.",
      "hanzi": "他会修理旧家具。",
      "pinyin": "Tā huì xiū lǐ jiù jiā jù.",
      "meaning": "Anh ấy biết sửa đồ gỗ cũ.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t4",
      "type": "teaching",
      "title": "收拾 · dọn dẹp; thu xếp",
      "text": "收拾 là sắp đặt cho gọn, không phải 收费 là thu phí; 拾 thường đọc nhẹ trong từ.",
      "hanzi": "我先收拾一下客厅。",
      "pinyin": "Wǒ xiān shōu shi yí xià kè tīng.",
      "meaning": "Tôi dọn phòng khách trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-t5",
      "type": "teaching",
      "title": "收费 · thu phí",
      "text": "收费 là thu tiền dịch vụ trong câu chuyện hư cấu; không phải phí của ứng dụng hay giá thực tế.",
      "hanzi": "请先说明怎样收费。",
      "pinyin": "Qǐng xiān shuō míng zěn yàng shōu fèi.",
      "meaning": "Xin nói trước cách tính phí.",
      "readingMinutes": 1
    },
    {
      "id": "l4011-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "晚就晚点儿吧 lặp lại tính từ để chấp nhận mức chênh lệch nhỏ: muộn thì muộn một chút cũng được. Không áp dụng cho mọi tình huống hoặc ép người khác chấp nhận.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4011-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安家的椅子坏了，他先收拾客厅，再给师傅打电话：“您会修理这种椅子吗？请先说明怎样收费。”师傅说能修，约好下午上门。后来师傅说要晚半个小时，小安回答：“晚就晚点儿吧，今天有人在家等。”",
      "pinyin": "Xiǎo Ān jiā de yǐ zi huài le, tā xiān shōu shi kè tīng, zài gěi shī fu dǎ diàn huà: “Nín huì xiū lǐ zhè zhǒng yǐ zi ma? Qǐng xiān shuō míng zěn yàng shōu fèi.” Shī fu shuō néng xiū, yuē hǎo xià wǔ shàng mén. Hòu lái shī fu shuō yào wǎn bàn ge xiǎo shí, Xiǎo Ān huí dá: “Wǎn jiù wǎn diǎnr ba, jīn tiān yǒu rén zài jiā děng.”",
      "meaning": "Tiểu An hỏi khả năng sửa ghế và cách tính phí trước; đồng ý thợ đến muộn nửa giờ vì có người ở nhà.",
      "readingMinutes": 2
    },
