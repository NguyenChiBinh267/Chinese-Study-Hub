  "blocks": [
    {
      "id": "l375-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 登记 dēngjì: đăng ký; 表 biǎo: biểu mẫu; 报名处 bàomíng chù: nơi đăng ký; 外出 wàichū: ra ngoài. Quy tắc hư cấu trong đoạn, không tự đổi điều kiện mở khóa của ứng dụng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l375-t0",
      "type": "teaching",
      "title": "如果 · nếu",
      "text": "如果 đặt trước giả thiết như 如果下雨; chưa xác nhận có mưa. Vế sau có thể dùng 就 theo quan hệ ngữ cảnh.",
      "hanzi": "如果下雨，我们就坐车。",
      "pinyin": "Rúguǒ xià yǔ, wǒmen jiù zuò chē.",
      "meaning": "Nếu mưa, chúng ta đi xe.",
      "readingMinutes": 1
    },
    {
      "id": "l375-t1",
      "type": "teaching",
      "title": "的话 · nếu… (dấu sau giả thiết)",
      "text": "的话 đặt sau cụm/câu điều kiện: 下雨的话. Không nhầm với 的话 chỉ lời nói của ai ở ngữ cảnh khác.",
      "hanzi": "下雨的话，我们就坐车。",
      "pinyin": "Xià yǔ dehuà, wǒmen jiù zuò chē.",
      "meaning": "Nếu trời mưa, chúng ta đi xe.",
      "readingMinutes": 1
    },
    {
      "id": "l375-t2",
      "type": "teaching",
      "title": "只要 · chỉ cần",
      "text": "只要 nhấn điều kiện đủ trong quy tắc được kể; 不 tự áp sang mọi hoàn cảnh. 只要交表就能登记是这次规定.",
      "hanzi": "只要交表，就能登记。",
      "pinyin": "Zhǐyào jiāo biǎo, jiù néng dēngjì.",
      "meaning": "Chỉ cần nộp mẫu là có thể đăng ký.",
      "readingMinutes": 1
    },
    {
      "id": "l375-t3",
      "type": "teaching",
      "title": "只有 · chỉ khi/chỉ có",
      "text": "只有…才… nêu điều kiện cần; 只有老师同意才去 không bảo đảm đã đồng ý hay sẽ chắc đi. 只有一本书 là nghĩa chỉ có một quyển khác kết cấu.",
      "hanzi": "只有老师同意，我们才去。",
      "pinyin": "Zhǐyǒu lǎoshī tóngyì, wǒmen cái qù.",
      "meaning": "Chỉ khi thầy đồng ý chúng tôi mới đi.",
      "readingMinutes": 1
    },
    {
      "id": "l375-t4",
      "type": "teaching",
      "title": "只 · chỉ",
      "text": "只 giới hạn phạm vi như 只看 là chỉ xem, không tự có nghĩa chỉ có thể. 只和只能 khác ý tự nguyện/khả năng bị giới hạn.",
      "hanzi": "我今天只看，不买。",
      "pinyin": "Wǒ jīntiān zhǐ kàn, bù mǎi.",
      "meaning": "Hôm nay tôi chỉ xem, không mua.",
      "readingMinutes": 1
    },
    {
      "id": "l375-t5",
      "type": "teaching",
      "title": "只能 · chỉ có thể/đành phải",
      "text": "只能 nêu giới hạn khả năng/lựa chọn; 只能坐车 vì xa, khác 只坐车 chỉ nêu lựa chọn. Không tự là mệnh lệnh pháp lý.",
      "hanzi": "太远了，我们只能坐车。",
      "pinyin": "Tài yuǎn le, wǒmen zhǐ néng zuò chē.",
      "meaning": "Xa quá, chúng ta chỉ có thể đi xe.",
      "readingMinutes": 1
    },
    {
      "id": "l375-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "只要P就Q nêu P đủ cho Q trong quy tắc/kế hoạch; 只有P才Q nêu P là điều kiện cần. Không suy ra 只有P才Q nghĩa có P thì chắc chắn Q. 如果/…的话 nêu giả thiết, không tự khẳng định đang xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l375-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "如果下雨，或者说下雨的话，我们就坐车。报名处说这次只要交表就能登记，但外出活动只有老师同意才能去。小林今天只看活动介绍；地方太远，他知道到时只能坐车。",
      "pinyin": "Rúguǒ xià yǔ, huòzhě shuō xià yǔ dehuà, wǒmen jiù zuò chē. Bàomíng chù shuō zhè cì zhǐyào jiāo biǎo jiù néng dēngjì, dàn wàichū huódòng zhǐyǒu lǎoshī tóngyì cái néng qù. Xiǎo Lín jīntiān zhǐ kàn huódòng jièshào; dìfang tài yuǎn, tā zhīdào dào shí zhǐ néng zuò chē.",
      "meaning": "Nếu mưa thì đi xe. Lần đăng ký này chỉ cần nộp mẫu, nhưng đi ngoại khóa cần thầy đồng ý. Lâm hôm nay chỉ đọc; vì xa nên lúc đi chỉ có thể dùng xe.",
      "readingMinutes": 2
    },
    {
      "id": "l375-b0",
      "type": "exercise",
