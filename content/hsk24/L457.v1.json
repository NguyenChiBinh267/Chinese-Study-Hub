  "blocks": [
    {
      "id": "l457-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 尺码 chǐmǎ: cỡ; 出示 chūshì: đưa cho xem; 标价 biāojià: giá niêm yết; 试穿 shìchuān: thử mặc/đi. 不必 bú bì: không cần; 不怎么 bù zěnme: không... lắm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l457-t0",
      "type": "teaching",
      "title": "购买 · mua",
      "text": "购买 là động từ mua, trang trọng hơn 买; hay gặp trong thông báo. Nhận diện chữ 购 trong 购买; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "购买以前请看说明。",
      "pinyin": "Gòumǎi yǐqián qǐng kàn shuōmíng.",
      "meaning": "Trước khi mua hãy đọc hướng dẫn.",
      "readingMinutes": 1
    },
    {
      "id": "l457-t1",
      "type": "teaching",
      "title": "购物 · mua sắm",
      "text": "购物 nói hoạt động mua sắm, không trực tiếp nhận một món bằng 购物一件衣服.",
      "hanzi": "她周末去购物。",
      "pinyin": "Tā zhōumò qù gòuwù.",
      "meaning": "Cuối tuần cô đi mua sắm.",
      "readingMinutes": 1
    },
    {
      "id": "l457-t2",
      "type": "teaching",
      "title": "会员 · hội viên",
      "text": "会员 là người tham gia tổ chức/dịch vụ; ưu đãi tùy điều kiện, không mặc định miễn phí.",
      "hanzi": "会员需要出示号码。",
      "pinyin": "Huìyuán xūyào chūshì hàomǎ.",
      "meaning": "Hội viên cần đưa số hội viên.",
      "readingMinutes": 1
    },
    {
      "id": "l457-t3",
      "type": "teaching",
      "title": "货 · hàng hóa",
      "text": "货 là hàng trong 有货、没货; không phải tên một món cụ thể.",
      "hanzi": "这双鞋还有货。",
      "pinyin": "Zhè shuāng xié hái yǒu huò.",
      "meaning": "Đôi giày này vẫn còn hàng.",
      "readingMinutes": 1
    },
    {
      "id": "l457-t4",
      "type": "teaching",
      "title": "牌子 · nhãn hiệu, biển",
      "text": "牌子 trong bài hỏi thương hiệu của sản phẩm, khác biển thông báo ở nghĩa khác.",
      "hanzi": "你想买哪个牌子？",
      "pinyin": "Nǐ xiǎng mǎi nǎ ge páizi?",
      "meaning": "Bạn muốn mua nhãn hiệu nào?",
      "readingMinutes": 1
    },
    {
      "id": "l457-t5",
      "type": "teaching",
      "title": "免费 · miễn phí",
      "text": "免费 nói không thu phí cho hạng mục được nêu; không suy ra toàn bộ giao dịch miễn phí.",
      "hanzi": "包装服务是免费的。",
      "pinyin": "Bāozhuāng fúwù shì miǎnfèi de.",
      "meaning": "Dịch vụ gói hàng miễn phí.",
      "readingMinutes": 1
    },
    {
      "id": "l457-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不怎么 + tính từ/động từ phủ định mức độ: 这双鞋子不怎么合适 nghĩa không được vừa lắm, không nhất thiết hoàn toàn không dùng được. Khác 不必 là không cần thiết.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l457-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小于去购物，想购买一双鞋。她先问牌子和尺码，再问有没有货。店员说会员可以免费包装，但鞋子仍按标价付款。朋友提醒：“不必现在购买，先试穿，再看条件。”小于试了以后觉得不怎么合适，决定再看看。",
      "pinyin": "Xiǎo Yú qù gòuwù, xiǎng gòumǎi yì shuāng xié. Tā xiān wèn páizi hé chǐmǎ, zài wèn yǒu méiyǒu huò. Diànyuán shuō huìyuán kěyǐ miǎnfèi bāozhuāng, dàn xiézi réng àn biāojià fùkuǎn. Péngyou tíxǐng: “Búbì xiànzài gòumǎi, xiān shìchuān, zài kàn tiáojiàn.” Xiǎo Yú shì le yǐhòu juéde bù zěnme héshì, juédìng zài kànkan.",
      "meaning": "Vu hỏi nhãn hiệu, cỡ và hàng còn. Hội viên được gói miễn phí nhưng vẫn phải trả tiền giày. Bạn nhắc thử và xem điều kiện trước; Vu chưa mua vì không vừa.",
      "readingMinutes": 2
    },
    {
