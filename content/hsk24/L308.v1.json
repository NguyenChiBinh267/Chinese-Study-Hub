  "blocks": [
    {
      "id": "l308-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 先/再, thời gian đứng trước động từ, 在 và lượng từ cơ bản. Prerequisite HSK1/2 vẫn chưa chứng nhận. 着急 zháojí: lo/vội; 还没 hái méi: vẫn chưa; 把 bǎ được dạy theo nhánh vị trí. 还 huán trả lại chỉ để đối chiếu âm/ý với 换 huàn, chưa cộng từ. Ngữ cảnh mất đồ là hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l308-t0",
      "type": "teaching",
      "title": "换 · đổi/thay",
      "text": "换 nói đổi một vật hoặc thay thứ đang dùng. 换一个包 là đổi sang túi khác; khác 还 huán trả lại vật.",
      "hanzi": "这个包太小，我想换一个。",
      "pinyin": "Zhège bāo tài xiǎo, wǒ xiǎng huàn yí ge.",
      "meaning": "Túi này nhỏ quá, tôi muốn đổi một cái.",
      "readingMinutes": 1
    },
    {
      "id": "l308-t1",
      "type": "teaching",
      "title": "丢 · làm mất/thất lạc",
      "text": "丢 trong 我的包丢了 nói túi thất lạc. Không dùng mặc nhiên nghĩa cố ý vứt; cần ngữ cảnh để phân biệt.",
      "hanzi": "我的包丢了，里面有票。",
      "pinyin": "Wǒ de bāo diū le, lǐmian yǒu piào.",
      "meaning": "Túi tôi bị thất lạc, bên trong có vé.",
      "readingMinutes": 1
    },
    {
      "id": "l308-t2",
      "type": "teaching",
      "title": "带 · mang theo",
      "text": "带 ở đây là động từ mang người/vật cùng đi. 带到车站 chỉ điểm đến; không dùng nghĩa danh từ dây/đai.",
      "hanzi": "请把包带到车站。",
      "pinyin": "Qǐng bǎ bāo dài dào chēzhàn.",
      "meaning": "Hãy mang túi đến ga.",
      "readingMinutes": 1
    },
    {
      "id": "l308-t3",
      "type": "teaching",
      "title": "离开 · rời khỏi",
      "text": "离开 nêu tách khỏi nơi/người; 离开宾馆 là rời khách sạn, không phải làm mất khách sạn.",
      "hanzi": "他还没离开宾馆。",
      "pinyin": "Tā hái méi líkāi bīnguǎn.",
      "meaning": "Anh ấy chưa rời khách sạn.",
      "readingMinutes": 1
    },
    {
      "id": "l308-t4",
      "type": "teaching",
      "title": "经过 · đi qua",
      "text": "经过 ở đây là động từ đi qua một nơi. 不要把“经过”与经验助词“过”混成同一用法; tên gọi quá trình là nghĩa khác chưa kiểm tra.",
      "hanzi": "我去车站的时候经过学校。",
      "pinyin": "Wǒ qù chēzhàn de shíhou jīngguò xuéxiào.",
      "meaning": "Tôi đi qua trường khi tới ga.",
      "readingMinutes": 1
    },
    {
      "id": "l308-t5",
      "type": "teaching",
      "title": "接 · đón",
      "text": "接 trong 去车站接朋友 là tới đón bạn. Khác tiếp nhận cuộc gọi trong 接电话; bài chỉ chấm nghĩa đón người theo ngữ cảnh.",
      "hanzi": "我今天去车站接朋友。",
      "pinyin": "Wǒ jīntiān qù chēzhàn jiē péngyou.",
      "meaning": "Hôm nay tôi đến ga đón bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l308-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把 đưa vật đã xác định lên trước động từ. 把包带到车站 nêu mang túi tới ga; không nói người đã rời ga. Chỉ luyện nhánh động từ+到+địa điểm, chưa đủ mọi mẫu 把 trong dòng nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l308-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我的包丢了，我想里面有票。小李：你先别着急。小王还没离开宾馆，我问问他。小王：包在这里。我会经过学校，可以把包带到车站。小安：谢谢！我在那里接朋友，先不换别的包了。",
      "pinyin": "Xiǎo Ān: Wǒ de bāo diū le, wǒ xiǎng lǐmian yǒu piào. Xiǎo Lǐ: Nǐ xiān bié zháojí. Xiǎo Wáng hái méi líkāi bīnguǎn, wǒ wènwen tā. Xiǎo Wáng: Bāo zài zhèlǐ. Wǒ huì jīngguò xuéxiào, kěyǐ bǎ bāo dài dào chēzhàn. Xiǎo Ān: Xièxie! Wǒ zài nàli jiē péngyou, xiān bú huàn biéde bāo le.",
      "meaning": "An nghĩ mất túi, có vé ở trong. Lý hỏi Vương vì Vương chưa rời khách sạn. Vương thấy túi, sẽ đi qua trường và mang túi tới ga. An đón bạn tại ga và chưa đổi túi khác nữa.",
      "readingMinutes": 2
    },
