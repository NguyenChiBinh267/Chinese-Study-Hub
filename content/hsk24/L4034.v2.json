  "blocks": [
    {
      "id": "l4034-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t0",
      "type": "teaching",
      "title": "老虎 · hổ",
      "text": "老虎 là loài hổ, không phải mọi thú lớn. Nhận diện chữ 虎 trong 老虎; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "照片里有一只老虎。",
      "pinyin": "Zhào piàn lǐ yǒu yì zhī lǎo hǔ.",
      "meaning": "Trong ảnh có một con hổ.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t1",
      "type": "teaching",
      "title": "熊 · gấu",
      "text": "熊 là loài gấu; 熊猫 là tên một loài cụ thể.",
      "hanzi": "这只熊正在休息。",
      "pinyin": "Zhè zhī xióng zhèng zài xiū xi.",
      "meaning": "Con gấu này đang nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t2",
      "type": "teaching",
      "title": "生命 · sự sống; sinh mạng",
      "text": "生命 chỉ sự sống, không chỉ tuổi thọ.",
      "hanzi": "我们应该尊重生命。",
      "pinyin": "Wǒ men yīng gāi zūn zhòng shēng mìng.",
      "meaning": "Chúng ta nên tôn trọng sự sống.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t3",
      "type": "teaching",
      "title": "死 · chết",
      "text": "死 chỉ hết sự sống; không đồng nghĩa ngủ.",
      "hanzi": "故事里的老树已经死了。",
      "pinyin": "Gù shi lǐ de lǎo shù yǐ jīng sǐ le.",
      "meaning": "Cây già trong truyện đã chết.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t4",
      "type": "teaching",
      "title": "远离 · tránh xa; rời xa",
      "text": "远离 nhấn mạnh giữ khoảng cách xa khỏi.",
      "hanzi": "请远离危险区域。",
      "pinyin": "Qǐng yuǎn lí wēi xiǎn qū yù.",
      "meaning": "Hãy tránh xa khu vực nguy hiểm.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-t5",
      "type": "teaching",
      "title": "危险 · nguy hiểm",
      "text": "危险 nói khả năng gây hại, không phải đã có thương tích.",
      "hanzi": "靠近野生动物很危险。",
      "pinyin": "Kào jìn yě shēng dòng wù hěn wēi xiǎn.",
      "meaning": "Tới gần động vật hoang dã rất nguy hiểm.",
      "readingMinutes": 1
    },
    {
      "id": "l4034-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不A也能B cho biết không cần thực hiện A vẫn làm được B; không tới gần vẫn quan sát được.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4034-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "展板上有老虎和熊的照片，也介绍动物的生命过程。旁边一棵老树已经死了。老师让大家远离危险区域：“不靠近动物，也能用图片学习。观察不等于打扰。”",
      "pinyin": "Zhǎn bǎn shàng yǒu lǎo hǔ hé xióng de zhào piàn, yě jiè shào dòng wù de shēng mìng guò chéng. Páng biān yì kē lǎo shù yǐ jīng sǐ le. Lǎo shī ràng dà jiā yuǎn lí wēi xiǎn qū yù: “Bú kào jìn dòng wù, yě néng yòng tú piàn xué xí. Guān chá bù děng yú dǎ rǎo.”",
      "meaning": "Nhóm học qua hình ảnh và giữ khoảng cách với vùng nguy hiểm.",
      "readingMinutes": 2
    },
    {
