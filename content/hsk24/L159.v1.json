  "blocks": [
    {
      "id": "l159-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l159-t0",
      "type": "teaching",
      "title": "便宜 · rẻ; không đắt",
      "text": "便宜 trong ví dụ đọc pián yi, không dùng biàn theo một nghĩa khác của chữ 便.",
      "hanzi": "这本书很便宜。",
      "pinyin": "Zhè běn shū hěn pián yi.",
      "meaning": "Quyển sách này rẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l159-t1",
      "type": "teaching",
      "title": "元 · đồng/nguyên (đơn vị yuán trong ví dụ)",
      "text": "元 trong 十元 là đơn vị tiền của ví dụ, không phải tỷ giá hay báo giá thật.",
      "hanzi": "这本书十元。",
      "pinyin": "Zhè běn shū shí yuán.",
      "meaning": "Quyển sách này10nguyên trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l159-t2",
      "type": "teaching",
      "title": "块 · đồng (cách nói kuài trong ví dụ)",
      "text": "块 ở đây là cách nói đơn vị tiền, khác mọi nghĩa khối/miếng ở ngữ cảnh khác.",
      "hanzi": "这本书十块钱。",
      "pinyin": "Zhè běn shū shí kuài qián.",
      "meaning": "Quyển sách này10đồng trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l159-t3",
      "type": "teaching",
      "title": "多少 · bao nhiêu (dạng duōshao)",
      "text": "多少 hỏi số lượng/giá; trong 多少钱 là giá bao nhiêu tiền.",
      "hanzi": "这本书多少钱？",
      "pinyin": "Zhè běn shū duō shao qián?",
      "meaning": "Quyển sách này bao nhiêu tiền?",
      "readingMinutes": 1
    },
    {
      "id": "l159-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "多少钱 hỏi giá bao nhiêu tiền. Trong ví dụ nhân dân tệ, 元 là tên đơn vị thường ghi viết, 块 là cách nói thường dùng cho cùng đơn vị; không đưa tỷ giá hoặc yêu cầu giao dịch. 便宜 là rẻ theo tình huống. Các đề từ vựng chỉ rõ âm để phân biệt từ gần nghĩa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l159-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这本书多少钱？\nB：十块钱。\nA：贵吗？\nB：不贵，很便宜。",
      "pinyin": "A: Zhè běn shū duō shao qián? B: Shí kuài qián. A: Guì ma? B: Bú guì, hěn pián yi.",
      "meaning": "Giá10đồng là giá hư cấu bằng đơn vị nhân dân tệ của bài; B nói không đắt. Không có tỷ giá, giá thật hay thao tác mua.",
      "readingMinutes": 2
    },
