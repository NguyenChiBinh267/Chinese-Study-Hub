  "blocks": [
    {
      "id": "l257-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "请 làm lời nhờ lịch sự. 位 là lượng từ lịch sự cho người; chỉ nhắc ở đây, không tính thành mục từ mới. 人 là người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t0",
      "type": "teaching",
      "title": "Nhắc lại · 帮 · giúp",
      "text": "帮 có thể đứng trước người và hoạt động: 帮我拿书. Cần rõ ai được giúp và làm việc gì.",
      "hanzi": "请帮我拿一下书。",
      "pinyin": "Qǐng bāng wǒ ná yíxià shū.",
      "meaning": "Làm ơn giúp tôi lấy sách một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t1",
      "type": "teaching",
      "title": "Nhắc lại · 帮忙 · giúp một tay",
      "text": "帮忙 dùng như hoạt động giúp đỡ: 请来帮忙. Không đặt người ngay sau toàn từ theo kiểu 帮忙我.",
      "hanzi": "你能来帮忙吗？",
      "pinyin": "Nǐ néng lái bāngmáng ma?",
      "meaning": "Bạn có thể đến giúp một tay không?",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t2",
      "type": "teaching",
      "title": "Nhắc lại · 告诉 · nói cho biết",
      "text": "告诉 thường nêu người nhận thông tin: 告诉我. 诉 đọc nhẹ trong từ này.",
      "hanzi": "请告诉我你的名字。",
      "pinyin": "Qǐng gàosu wǒ nǐ de míngzi.",
      "meaning": "Làm ơn cho tôi biết tên bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t3",
      "type": "teaching",
      "title": "Nhắc lại · 介绍 · giới thiệu",
      "text": "介绍 là làm người nghe biết một người/sự việc. 给你介绍一位老师 là giới thiệu một giáo viên với bạn.",
      "hanzi": "我给你介绍一位老师。",
      "pinyin": "Wǒ gěi nǐ jièshào yí wèi lǎoshī.",
      "meaning": "Tôi giới thiệu một giáo viên với bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t4",
      "type": "teaching",
      "title": "Nhắc lại · 不好意思 · xin lỗi nhẹ hoặc thấy ngại",
      "text": "不好意思 dùng khi làm phiền hoặc cảm thấy ngại, không chỉ là ‘ý nghĩa không tốt’. Tình huống nghiêm trọng cần cách xin lỗi phù hợp hơn.",
      "hanzi": "不好意思，我没听懂。",
      "pinyin": "Bù hǎoyìsi, wǒ méi tīng dǒng.",
      "meaning": "Xin lỗi, tôi nghe chưa hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-t5",
      "type": "teaching",
      "title": "Nhắc lại · 让 · cho phép hoặc yêu cầu ai làm",
      "text": "Trong 请让他进来, 让 là động từ cho phép người kia vào. Không dạy nghĩa giới từ cấp cao hơn.",
      "hanzi": "请让他进来。",
      "pinyin": "Qǐng ràng tā jìnlái.",
      "meaning": "Làm ơn cho anh ấy vào.",
      "readingMinutes": 1
    },
    {
      "id": "l257-t0-l217-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "让 + người + hoạt động có thể nói cho phép hoặc yêu cầu người đó làm. Mẫu 请让他进来 nghĩa là hãy cho anh ấy vào; không tự suy ra mọi 让 đều là bắt buộc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l257-t0-l217-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：不好意思，你能来帮忙吗？乙：可以。甲：请帮我拿书。我给你介绍一位老师。乙：好，请告诉我老师的名字。",
      "pinyin": "Jiǎ: Bù hǎoyìsi, nǐ néng lái bāngmáng ma? Yǐ: Kěyǐ. Jiǎ: Qǐng bāng wǒ ná shū. Wǒ gěi nǐ jièshào yí wèi lǎoshī. Yǐ: Hǎo, qǐng gàosu wǒ lǎoshī de míngzi.",
      "meaning": "A: Xin lỗi làm phiền, bạn đến giúp được không? B: Được. A: Giúp tôi lấy sách nhé. Tôi giới thiệu một giáo viên với bạn. B: Được, hãy cho tôi biết tên thầy/cô.",
      "readingMinutes": 2
    },
