  "blocks": [
    {
      "id": "l143-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l143-t0",
      "type": "teaching",
      "title": "天气 · thời tiết",
      "text": "天气 là thời tiết, không phải một con số ngày đếm trong 三天.",
      "hanzi": "天气很好。",
      "pinyin": "Tiān qì hěn hǎo.",
      "meaning": "Thời tiết tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l143-t1",
      "type": "teaching",
      "title": "冷 · lạnh",
      "text": "冷 tả lạnh trong câu thời tiết; không tự nói nhiệt độ đo được bao nhiêu.",
      "hanzi": "天气很冷。",
      "pinyin": "Tiān qì hěn lěng.",
      "meaning": "Thời tiết lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l143-t2",
      "type": "teaching",
      "title": "热 · nóng",
      "text": "热 nói nóng; không suy một mức nhiệt hoặc lời khuyên y tế từ câu mẫu.",
      "hanzi": "这里很热。",
      "pinyin": "Zhè lǐ hěn rè.",
      "meaning": "Ở đây nóng.",
      "readingMinutes": 1
    },
    {
      "id": "l143-t3",
      "type": "teaching",
      "title": "太 · quá; rất (cảm thán)",
      "text": "太 trong 太冷了 nhấn cảm thán; không đổi nó thành 很 mà bỏ qua giới hạn câu được hỏi.",
      "hanzi": "太冷了！",
      "pinyin": "Tài lěng le!",
      "meaning": "Lạnh quá!",
      "readingMinutes": 1
    },
    {
      "id": "l143-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "天气 nói thời tiết; 冷/热 là lạnh/nóng trong các câu này. 太 + tính từ + 了 tạo lời cảm thán như 太冷了！Không coi câu cảm thán của một nhân vật là dự báo thời tiết thật. 今天/怎么样 được chú giải để hiểu hội thoại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l143-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：今天天气怎么样？\nB：很冷。\nA：太冷了！\nB：是。",
      "pinyin": "A: Jīn tiān tiān qì zěn me yàng? B: Hěn lěng. A: Tài lěng le! B: Shì.",
      "meaning": "今天 jīn tiān = hôm nay; 怎么样 zěn me yàng = thế nào. Đoạn hư cấu nói trời lạnh, không có số đo hay dự báo thật.",
      "readingMinutes": 2
    },
