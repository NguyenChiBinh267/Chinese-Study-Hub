  "blocks": [
    {
      "id": "l454-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 考官 kǎoguān: giám khảo; 等候 děnghòu: đợi; 独立 dúlì: độc lập; 项目 xiàngmù: dự án; 举例 jǔlì: nêu ví dụ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l454-t0",
      "type": "teaching",
      "title": "面试 · phỏng vấn",
      "text": "面试 là đánh giá qua trao đổi trực tiếp, khác 笔试 là thi viết.",
      "hanzi": "我明天参加面试。",
      "pinyin": "Wǒ míngtiān cānjiā miànshì.",
      "meaning": "Mai tôi dự phỏng vấn.",
      "readingMinutes": 1
    },
    {
      "id": "l454-t1",
      "type": "teaching",
      "title": "考生 · thí sinh",
      "text": "考生 là người dự thi; phỏng vấn tuyển chọn có thể gọi 考生 trong bối cảnh bài.",
      "hanzi": "考生在门外等候。",
      "pinyin": "Kǎoshēng zài mén wài děnghòu.",
      "meaning": "Thí sinh đợi ngoài cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l454-t2",
      "type": "teaching",
      "title": "能力 · năng lực",
      "text": "能力 là khả năng làm việc gì; dùng 有能力、提高能力.",
      "hanzi": "这份工作需要交流能力。",
      "pinyin": "Zhè fèn gōngzuò xūyào jiāoliú nénglì.",
      "meaning": "Việc này cần năng lực giao tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l454-t3",
      "type": "teaching",
      "title": "能够 · có thể",
      "text": "能够 + động từ chỉ khả năng/điều kiện; không tự bảo đảm đã thực hiện.",
      "hanzi": "我能够独立完成这项工作。",
      "pinyin": "Wǒ nénggòu dúlì wánchéng zhè xiàng gōngzuò.",
      "meaning": "Tôi có thể tự hoàn thành công việc này.",
      "readingMinutes": 1
    },
    {
      "id": "l454-t4",
      "type": "teaching",
      "title": "合格 · đạt yêu cầu",
      "text": "合格 nghĩa đạt tiêu chuẩn được nêu; bài không suy ra đủ điều kiện nghề nghiệp thực.",
      "hanzi": "材料检查合格了。",
      "pinyin": "Cáiliào jiǎnchá hégé le.",
      "meaning": "Hồ sơ/vật liệu đã qua kiểm tra đạt yêu cầu.",
      "readingMinutes": 1
    },
    {
      "id": "l454-t5",
      "type": "teaching",
      "title": "仅 · chỉ",
      "text": "仅 chỉ giới hạn, thường trước số lượng; không dùng như liên từ nhưng. Nhận diện chữ 仅 trong 仅; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我仅有一次面试经历。",
      "pinyin": "Wǒ jǐn yǒu yí cì miànshì jīnglì.",
      "meaning": "Tôi chỉ có một lần trải nghiệm phỏng vấn.",
      "readingMinutes": 1
    },
    {
      "id": "l454-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "仅 + số lượng hoặc thành phần giới hạn tương tự 只, hơi trang trọng: 我仅有一次面试经历. Không đồng nghĩa 已经. Trong bài 仅 giới hạn số lần, không phủ nhận những năng lực khác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l454-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "材料检查合格的考生可以参加面试。小何对考官说：“我仅有一次面试经历，但以前做过小组项目，能够独立整理材料，也有交流能力。”考官请他举例，而不是只说自己“什么都会”。小何于是说明上次怎样帮助小组解决问题。",
      "pinyin": "Cáiliào jiǎnchá hégé de kǎoshēng kěyǐ cānjiā miànshì. Xiǎo Hé duì kǎoguān shuō: “Wǒ jǐn yǒu yí cì miànshì jīnglì, dàn yǐqián zuò guo xiǎozǔ xiàngmù, nénggòu dúlì zhěnglǐ cáiliào, yě yǒu jiāoliú nénglì.” Kǎoguān qǐng tā jǔlì, ér bú shì zhǐ shuō zìjǐ “shénme dōu huì”. Xiǎo Hé yúshì shuōmíng shàng cì zěnyàng bāngzhù xiǎozǔ jiějué wèntí.",
      "meaning": "Hà nói chỉ từng phỏng vấn một lần nhưng có kinh nghiệm dự án nhóm. Người phỏng vấn yêu cầu ví dụ cụ thể thay vì tự nhận biết hết. Hà giải thích cách đã hỗ trợ nhóm.",
      "readingMinutes": 2
    },
    {
