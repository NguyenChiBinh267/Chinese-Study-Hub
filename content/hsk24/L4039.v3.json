  "blocks": [
    {
      "id": "l4039-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t0",
      "type": "teaching",
      "title": "孙女 · cháu nội gái",
      "text": "孙女 thường chỉ con gái của con trai; cháu ngoại gái là 外孙女. Nhận diện chữ 孙 trong 孙女; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "奶奶给孙女写了一封信。",
      "pinyin": "Nǎi nai gěi sūn nǚ xiě le yì fēng xìn.",
      "meaning": "Bà nội viết thư cho cháu nội gái.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t1",
      "type": "teaching",
      "title": "孙子 · cháu nội trai",
      "text": "孙子 trong nghĩa bài là con trai của con trai; 外孙 là cháu ngoại trai.",
      "hanzi": "爷爷教孙子种花。",
      "pinyin": "Yé ye jiāo sūn zi zhòng huā.",
      "meaning": "Ông nội dạy cháu nội trai trồng hoa.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t2",
      "type": "teaching",
      "title": "兄弟 · anh em trai",
      "text": "兄弟 gộp anh/em trai, không xác định ai lớn tuổi hơn.",
      "hanzi": "他们是亲兄弟。",
      "pinyin": "Tā men shì qīn xiōng dì.",
      "meaning": "Họ là anh em ruột.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t3",
      "type": "teaching",
      "title": "少年 · thiếu niên",
      "text": "少年 chỉ giai đoạn/người tuổi thiếu niên, không phải mọi người trẻ.",
      "hanzi": "他少年时很喜欢画画。",
      "pinyin": "Tā shào nián shí hěn xǐ huan huà huà.",
      "meaning": "Thuở thiếu niên anh ấy rất thích vẽ.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t4",
      "type": "teaching",
      "title": "中年 · trung niên",
      "text": "中年 là giai đoạn giữa đời; bài không đặt ranh tuổi cứng.",
      "hanzi": "照片里的爸爸已经是中年了。",
      "pinyin": "Zhào piàn lǐ de bà ba yǐ jīng shì zhōng nián le.",
      "meaning": "Người bố trong ảnh đã ở tuổi trung niên.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-t5",
      "type": "teaching",
      "title": "一生 · cả đời",
      "text": "一生 nhấn toàn bộ đời người, không chỉ một ngày.",
      "hanzi": "她希望一生都能做喜欢的事。",
      "pinyin": "Tā xī wàng yì shēng dōu néng zuò xǐ huan de shì.",
      "meaning": "Cô ấy mong cả đời được làm điều mình thích.",
      "readingMinutes": 1
    },
    {
      "id": "l4039-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一大张纸 đặt tính từ 大 trước lượng từ 张, nhấn khổ giấy lớn. Không phải 一张大纸 là cách duy nhất có thể diễn đạt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4039-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "奶奶用一大张纸画家谱，标出自己的孙女和孙子。她介绍爸爸和叔叔是兄弟，如今都到了中年，又讲他们少年时的故事。孙女说，希望一生都能听到这些家庭故事。",
      "pinyin": "Nǎi nai yòng yí dà zhāng zhǐ huà jiā pǔ, biāo chū zì jǐ de sūn nǚ hé sūn zi. Tā jiè shào bà ba hé shū shu shì xiōng dì, rú jīn dōu dào le zhōng nián, yòu jiǎng tā men shào nián shí de gù shi. Sūn nǚ shuō, xī wàng yì shēng dōu néng tīng dào zhè xiē jiā tíng gù shi.",
      "meaning": "Bà nội vẽ gia phả và kể chuyện bố, chú thời còn thiếu niên.",
      "readingMinutes": 2
    },
    {
