  "blocks": [
    {
      "id": "l359-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 门 mén: lượng từ môn/ngôn ngữ; 篇 piān: lượng từ bài viết; 作为 zuòwéi: với tư cách; 课程 kèchéng: khóa học; 规定 guīdìng: quy định.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l359-t0",
      "type": "teaching",
      "title": "外语 · ngoại ngữ",
      "text": "外语 là ngôn ngữ khác tiếng bản thân/theo bối cảnh, không phải tên riêng chỉ tiếng Anh. 中文也可能是某人的外语.",
      "hanzi": "她想学一门外语。",
      "pinyin": "Tā xiǎng xué yì mén wàiyǔ.",
      "meaning": "Cô ấy muốn học một ngoại ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l359-t1",
      "type": "teaching",
      "title": "语言 · ngôn ngữ",
      "text": "语言 là tên chung ngôn ngữ; 外语 là một cách phân loại theo người/bối cảnh, không phải hai nhóm không giao nhau.",
      "hanzi": "这个学校教三种语言。",
      "pinyin": "Zhège xuéxiào jiāo sān zhǒng yǔyán.",
      "meaning": "Trường này dạy ba ngôn ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l359-t2",
      "type": "teaching",
      "title": "留学 · du học",
      "text": "留学 là đi học ở nước ngoài; 留学生 là người, không đặt 留学 làm danh từ người sau 一名.",
      "hanzi": "他想去中国留学。",
      "pinyin": "Tā xiǎng qù Zhōngguó liúxué.",
      "meaning": "Cậu ấy muốn du học Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l359-t3",
      "type": "teaching",
      "title": "来自 · đến từ",
      "text": "来自 nhận địa điểm/nguồn xuất xứ; 来自越南 là từ Việt Nam đến, không nói đích đang muốn đi.",
      "hanzi": "我的同学来自越南。",
      "pinyin": "Wǒ de tóngxué láizì Yuènán.",
      "meaning": "Bạn học tôi đến từ Việt Nam.",
      "readingMinutes": 1
    },
    {
      "id": "l359-t4",
      "type": "teaching",
      "title": "有关 · liên quan/có liên quan",
      "text": "有关 trong 与…有关 nói có liên quan; không tự nói nguyên nhân. 与学习有关 là liên quan học, chưa khẳng định do học gây ra.",
      "hanzi": "这个问题与留学有关。",
      "pinyin": "Zhège wèntí yǔ liúxué yǒuguān.",
      "meaning": "Câu hỏi này liên quan đến du học.",
      "readingMinutes": 1
    },
    {
      "id": "l359-t5",
      "type": "teaching",
      "title": "关于 · về/liên quan chủ đề",
      "text": "关于 dẫn chủ đề để nói/viết; 关于学习的文章 là bài viết về học, không có nghĩa bài viết luôn đáng tin.",
      "hanzi": "这是一篇关于语言的文章。",
      "pinyin": "Zhè shì yì piān guānyú yǔyán de wénzhāng.",
      "meaning": "Đây là bài viết về ngôn ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l359-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "关于+chủ đề dẫn nội dung: 关于留学的文章. 有关 có thể là có liên quan hoặc về trong bối cảnh khác. 来自+địa điểm nêu xuất xứ, không thay cho 去+đích đến.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l359-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林的同学来自越南，想去中国留学。她学中文作为外语，也喜欢了解不同语言。今天她读一篇关于留学的文章，只记录与课程有关的信息，没有把个人经历当成所有学校的规定。",
      "pinyin": "Xiǎo Lín de tóngxué láizì Yuènán, xiǎng qù Zhōngguó liúxué. Tā xué Zhōngwén zuòwéi wàiyǔ, yě xǐhuan liǎojiě bù tóng yǔyán. Jīntiān tā dú yì piān guānyú liúxué de wénzhāng, zhǐ jìlù yǔ kèchéng yǒuguān de xìnxī, méiyǒu bǎ gè rén jīnglì dàngchéng suǒyǒu xuéxiào de guīdìng.",
      "meaning": "Bạn học Lâm từ Việt Nam, muốn du học Trung Quốc. Cô học tiếng Trung như ngoại ngữ và đọc bài về du học, chỉ ghi thông tin liên quan khóa học, không coi trải nghiệm cá nhân là quy định chung.",
      "readingMinutes": 2
    },
    {
      "id": "l359-b0",
      "type": "exercise",
      "exerciseVersionId": "l359-v1-e0"
    },
