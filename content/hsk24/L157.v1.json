  "blocks": [
    {
      "id": "l157-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l157-t0",
      "type": "teaching",
      "title": "商店 · cửa hàng (dạng shāngdiàn)",
      "text": "商店 là tên chung của cửa hàng; đề nêu âm để phân biệt với mục một chữ 店.",
      "hanzi": "我去商店。",
      "pinyin": "Wǒ qù shāng diàn.",
      "meaning": "Tôi đến cửa hàng.",
      "readingMinutes": 1
    },
    {
      "id": "l157-t1",
      "type": "teaching",
      "title": "超市 · siêu thị",
      "text": "超市 là siêu thị; tên không cho biết địa chỉ, quy mô hoặc mọi mặt hàng thực tế.",
      "hanzi": "那是超市。",
      "pinyin": "Nà shì chāo shì.",
      "meaning": "Kia là siêu thị.",
      "readingMinutes": 1
    },
    {
      "id": "l157-t2",
      "type": "teaching",
      "title": "店 · tiệm; cửa hàng (dạng diàn)",
      "text": "店 là mục một chữ; trong 我的店 nói tiệm của tôi ở tình huống hư cấu.",
      "hanzi": "这是我的店。",
      "pinyin": "Zhè shì wǒ de diàn.",
      "meaning": "Đây là tiệm của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l157-t3",
      "type": "teaching",
      "title": "书店 · hiệu sách; nhà sách",
      "text": "书店 là cửa hàng sách, khác bản thân một quyển sách.",
      "hanzi": "这里有一家书店。",
      "pinyin": "Zhè lǐ yǒu yì jiā shū diàn.",
      "meaning": "Ở đây có một hiệu sách.",
      "readingMinutes": 1
    },
    {
      "id": "l157-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Chỗ + 有 + số lượng + danh từ nói ở đó có gì: 这里有一家书店. 家 trong 一家书店 là lượng từ cho cửa hàng, khác nghĩa nhà/gia đình trong 我家. 商店/店 là từ chung, 超市/书店 là loại địa điểm cụ thể; không suy cửa hàng thật chỉ bán duy nhất một mặt hàng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l157-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这里有书店吗？\nB：有，这里有一家书店。\nA：超市在哪儿？\nB：在那边。",
      "pinyin": "A: Zhè lǐ yǒu shū diàn ma? B: Yǒu, zhè lǐ yǒu yì jiā shū diàn. A: Chāo shì zài nǎr? B: Zài nà biān.",
      "meaning": "B xác nhận ở đây có một hiệu sách, còn siêu thị ở bên kia; không có địa chỉ thật hay yêu cầu đi mua hàng.",
      "readingMinutes": 2
    },
