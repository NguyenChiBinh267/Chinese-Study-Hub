  "blocks": [
    {
      "id": "l193-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder0",
      "type": "teaching",
      "title": "多 · nhiều",
      "text": "Nhắc nghĩa đã học: nhiều. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我有很多朋友。",
      "pinyin": "Wǒ yǒu hěn duō péng you.",
      "meaning": "Tôi có nhiều bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder1",
      "type": "teaching",
      "title": "零 · không; số0",
      "text": "Nhắc nghĩa đã học: không; số0. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "零、三、五。",
      "pinyin": "Líng, sān, wǔ.",
      "meaning": "Không, ba, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder2",
      "type": "teaching",
      "title": "一点儿 · một ít; một chút (dạng yìdiǎnr)",
      "text": "Nhắc nghĩa đã học: một ít; một chút (dạng yìdiǎnr). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "请喝一点儿牛奶。",
      "pinyin": "Qǐng hē yì diǎnr niú nǎi.",
      "meaning": "Mời uống một chút sữa bò.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder3",
      "type": "teaching",
      "title": "有点儿 · hơi; có phần (dạng yǒudiǎnr)",
      "text": "Nhắc nghĩa đã học: hơi; có phần (dạng yǒudiǎnr). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我今天有点儿忙。",
      "pinyin": "Wǒ jīn tiān yǒu diǎnr máng.",
      "meaning": "Hôm nay tôi hơi bận.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder4",
      "type": "teaching",
      "title": "再 · lại; thêm lần nữa (dạng zài)",
      "text": "Nhắc nghĩa đã học: lại; thêm lần nữa (dạng zài). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我想再读一下这个字。",
      "pinyin": "Wǒ xiǎng zài dú yí xià zhè ge zì.",
      "meaning": "Tôi muốn đọc lại chữ này một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reminder5",
      "type": "teaching",
      "title": "火车 · tàu hỏa; xe lửa",
      "text": "Nhắc nghĩa đã học: tàu hỏa; xe lửa. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我们明天坐火车去学校。",
      "pinyin": "Wǒ men míng tiān zuò huǒ chē qù xué xiào.",
      "meaning": "Ngày mai chúng tôi đi tàu hỏa đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l193-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：我们明天坐火车去学校，好吗？\nB：好，我想在火车上读书。\nA：你有几本书？\nB：我有两本书。",
      "pinyin": "A: Wǒ men míng tiān zuò huǒ chē qù xué xiào, hǎo ma? B: Hǎo, wǒ xiǎng zài huǒ chē shang dú shū. A: Nǐ yǒu jǐ běn shū? B: Wǒ yǒu liǎng běn shū.",
      "meaning": "Hai nhân vật đồng ý đi tàu trong truyện; B muốn đọc trên tàu và có hai quyển sách. Không đặt vé hoặc lưu hành trình thật.",
      "readingMinutes": 2
    },
