  "blocks": [
    {
      "id": "l1105-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1105-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Phần làm rõ danh từ thường đứng trước danh từ: 我的书 (sách của tôi), 新书 (sách mới), 一杯水 (một cốc nước). Không phải mọi tính từ trước danh từ đều bắt buộc có 的: 新书 và 热水 trong mẫu này không cần 的. Đây là các mẫu cụ thể, không phải quy tắc “bỏ 的 với mọi tính từ”. Lượng từ đi theo số trước danh từ; không đổi thành 水一杯 khi đề yêu cầu cụm mẫu này.",
      "hanzi": "我的新书。\n一杯热水。",
      "pinyin": "Wǒ de xīn shū. Yì bēi rè shuǐ.",
      "meaning": "Sách mới của tôi. Một cốc nước nóng.",
      "readingMinutes": 3
    },
    {
      "id": "l1105-reminder0",
      "type": "teaching",
      "title": "新 · mới",
      "text": "Nhắc nghĩa đã học: mới. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这本书很新。",
      "pinyin": "Zhè běn shū hěn xīn.",
      "meaning": "Quyển sách này mới.",
      "readingMinutes": 1
    },
    {
      "id": "l1105-reminder1",
      "type": "teaching",
      "title": "书 · sách",
      "text": "Nhắc nghĩa đã học: sách. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这是我的书。",
      "pinyin": "Zhè shì wǒ de shū.",
      "meaning": "Đây là sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1105-reminder2",
      "type": "teaching",
      "title": "水 · nước",
      "text": "Nhắc nghĩa đã học: nước. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我喝水。",
      "pinyin": "Wǒ hē shuǐ.",
      "meaning": "Tôi uống nước.",
      "readingMinutes": 1
    },
    {
      "id": "l1105-reminder3",
      "type": "teaching",
      "title": "杯子 · cốc; ly (vật chứa)",
      "text": "Nhắc nghĩa đã học: cốc; ly (vật chứa). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我的杯子在桌子上。",
      "pinyin": "Wǒ de bēi zi zài zhuō zi shang.",
      "meaning": "Cốc của tôi ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l1105-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这是你的新书吗？\nB：是，这是我的新书。\nA：你想喝什么？\nB：我想喝一杯热水。",
      "pinyin": "A: Zhè shì nǐ de xīn shū ma? B: Shì, zhè shì wǒ de xīn shū. A: Nǐ xiǎng hē shén me? B: Wǒ xiǎng hē yì bēi rè shuǐ.",
      "meaning": "B nhận sách mới là của mình và muốn uống một cốc nước nóng. Cụm 我的/新/一杯/热 bổ sung thông tin khác nhau cho danh từ.",
      "readingMinutes": 2
    },
