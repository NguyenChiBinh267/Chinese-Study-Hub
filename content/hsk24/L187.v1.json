  "blocks": [
    {
      "id": "l187-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder0",
      "type": "teaching",
      "title": "外 · ngoài; bên ngoài (dạng một chữ)",
      "text": "Nhắc nghĩa đã học: ngoài; bên ngoài (dạng một chữ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我在学校外。",
      "pinyin": "Wǒ zài xué xiào wài.",
      "meaning": "Tôi ở ngoài trường.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder1",
      "type": "teaching",
      "title": "去 · đi; tới (nơi khác)",
      "text": "Nhắc nghĩa đã học: đi; tới (nơi khác). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我们去公司。",
      "pinyin": "Wǒ men qù gōng sī.",
      "meaning": "Chúng tôi đến công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder2",
      "type": "teaching",
      "title": "找 · tìm",
      "text": "Nhắc nghĩa đã học: tìm. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "林先生找安女士。",
      "pinyin": "Lín xiān sheng zhǎo Ān nǚ shì.",
      "meaning": "Ông Lâm tìm bà/chị An.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder3",
      "type": "teaching",
      "title": "工作 · làm việc; công việc",
      "text": "Nhắc nghĩa đã học: làm việc; công việc. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我爸爸在医院工作。",
      "pinyin": "Wǒ bà ba zài yī yuàn gōng zuò.",
      "meaning": "Bố tôi làm việc ở bệnh viện.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder4",
      "type": "teaching",
      "title": "医生 · bác sĩ",
      "text": "Nhắc nghĩa đã học: bác sĩ. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "林先生是医生。",
      "pinyin": "Lín xiān sheng shì yī shēng.",
      "meaning": "Ông Lâm là bác sĩ.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reminder5",
      "type": "teaching",
      "title": "医院 · bệnh viện",
      "text": "Nhắc nghĩa đã học: bệnh viện. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "她回医院了。",
      "pinyin": "Tā huí yī yuàn le.",
      "meaning": "Cô ấy trở lại bệnh viện rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l187-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你去哪儿？\nB：我去医院见安医生。\nA：安医生是女士吗？\nB：是，她是医生，在医院工作。",
      "pinyin": "A: Nǐ qù nǎr? B: Wǒ qù yī yuàn jiàn Ān yī shēng. A: Ān yī shēng shì nǚ shì ma? B: Shì, tā shì yī shēng, zài yī yuàn gōng zuò.",
      "meaning": "B đến bệnh viện để gặp bác sĩ An. Lời đáp nói rõ người được nhắc là nữ; không suy nghề hoặc giới tính chỉ từ tên.",
      "readingMinutes": 2
    },
