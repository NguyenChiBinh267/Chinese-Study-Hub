  "blocks": [
    {
      "id": "l474-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 可靠 kěkào: đáng tin; 陌生人 mòshēngrén: người lạ; 操作 cāozuò: thao tác; 输入 shūrù: nhập. Không nhập thông tin riêng trong bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l474-t0",
      "type": "teaching",
      "title": "密码 · mật khẩu",
      "text": "密码 là chuỗi bí mật dùng xác thực; bài không yêu cầu nhập mật khẩu thật. Nhận diện chữ 密 trong 密码; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "不要把密码告诉陌生人。",
      "pinyin": "Bú yào bǎ mìmǎ gàosu mòshēngrén.",
      "meaning": "Đừng nói mật khẩu cho người lạ.",
      "readingMinutes": 1
    },
    {
      "id": "l474-t1",
      "type": "teaching",
      "title": "判断 · phán đoán",
      "text": "判断 cần dựa thông tin/lý do, khác đoán mò 猜.",
      "hanzi": "先判断信息是否可靠。",
      "pinyin": "Xiān pànduàn xìnxī shìfǒu kěkào.",
      "meaning": "Trước hết xét thông tin có đáng tin không.",
      "readingMinutes": 1
    },
    {
      "id": "l474-t2",
      "type": "teaching",
      "title": "怀疑 · nghi ngờ",
      "text": "怀疑 thể hiện chưa tin/chưa rõ, không chứng minh đối tượng sai.",
      "hanzi": "他怀疑这条消息不真实。",
      "pinyin": "Tā huáiyí zhè tiáo xiāoxi bù zhēnshí.",
      "meaning": "Anh nghi tin này không thật.",
      "readingMinutes": 1
    },
    {
      "id": "l474-t3",
      "type": "teaching",
      "title": "考虑 · cân nhắc",
      "text": "考虑 là suy xét lựa chọn, không đồng nghĩa đã quyết định.",
      "hanzi": "我还需要考虑一下。",
      "pinyin": "Wǒ hái xūyào kǎolǜ yíxià.",
      "meaning": "Tôi còn cần cân nhắc.",
      "readingMinutes": 1
    },
    {
      "id": "l474-t4",
      "type": "teaching",
      "title": "看法 · cách nhìn, ý kiến",
      "text": "看法 là nhận xét của người nói, chưa phải kết luận có bằng chứng.",
      "hanzi": "请说说你的看法。",
      "pinyin": "Qǐng shuōshuo nǐ de kànfǎ.",
      "meaning": "Hãy nói cách nhìn của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l474-t5",
      "type": "teaching",
      "title": "能否 · có... hay không",
      "text": "能否 ghép nghĩa 能不能, thường trong câu hỏi gián tiếp hơi trang trọng.",
      "hanzi": "请确认能否参加。",
      "pinyin": "Qǐng quèrèn néng fǒu cānjiā.",
      "meaning": "Hãy xác nhận có thể tham gia không.",
      "readingMinutes": 1
    },
    {
      "id": "l474-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不管……都…… nêu kết quả giữ nguyên với các trường hợp khác nhau: 不管别人怎么说，都要先判断信息. Đây là mẫu vô điều kiện dùng 不管; cùng họ với 无论 nhưng gắn hàng nguồn riêng. Bài chỉ luyện lời nhắc, không đánh giá an toàn thật của mật khẩu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l474-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "练习课上，老师展示一条虚构消息，要求填写密码才能看活动安排。小郑怀疑消息不真实，先问能否从学校通知确认，再说自己的看法。老师提醒：“不管别人怎么说，都要先判断信息，考虑清楚再操作。”练习中没有人输入真实密码。",
      "pinyin": "Liànxí kè shàng, lǎoshī zhǎnshì yì tiáo xūgòu xiāoxi, yāoqiú tiánxiě mìmǎ cái néng kàn huódòng ānpái. Xiǎo Zhèng huáiyí xiāoxi bù zhēnshí, xiān wèn néng fǒu cóng xuéxiào tōngzhī quèrèn, zài shuō zìjǐ de kànfǎ. Lǎoshī tíxǐng: “Bùguǎn biérén zěnme shuō, dōu yào xiān pànduàn xìnxī, kǎolǜ qīngchu zài cāozuò.” Liànxí zhōng méiyǒu rén shūrù zhēnshí mìmǎ.",
      "meaning": "Lớp xem tin hư cấu yêu cầu mật khẩu. Trịnh nghi ngờ, muốn xác nhận từ thông báo trường. Thầy nhắc đánh giá thông tin trước khi thao tác. Không ai nhập mật khẩu thật trong bài.",
      "readingMinutes": 2
    },
