  "blocks": [
    {
      "id": "l4043-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t0",
      "type": "teaching",
      "title": "停车 · đỗ xe; dừng xe",
      "text": "停车 nói dừng/đỗ phương tiện, không phải bãi xe.",
      "hanzi": "司机正在找地方停车。",
      "pinyin": "Sī jī zhèng zài zhǎo dì fang tíng chē.",
      "meaning": "Tài xế đang tìm chỗ đỗ xe.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t1",
      "type": "teaching",
      "title": "停车场 · bãi đỗ xe",
      "text": "停车场 là địa điểm dành để đỗ xe.",
      "hanzi": "停车场在楼后面。",
      "pinyin": "Tíng chē chǎng zài lóu hòu mian.",
      "meaning": "Bãi đỗ xe ở sau tòa nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t2",
      "type": "teaching",
      "title": "十字路口 · ngã tư",
      "text": "十字路口 chỉ chỗ đường giao nhau hình chữ thập.",
      "hanzi": "地图上标着一个十字路口。",
      "pinyin": "Dì tú shàng biāo zhe yí ge shí zì lù kǒu.",
      "meaning": "Bản đồ đánh dấu một ngã tư.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t3",
      "type": "teaching",
      "title": "售票员 · nhân viên bán vé",
      "text": "售票员 là người bán vé, không phải mọi lái xe.",
      "hanzi": "售票员给我看了路线图。",
      "pinyin": "Shòu piào yuán gěi wǒ kàn le lù xiàn tú.",
      "meaning": "Nhân viên bán vé cho tôi xem sơ đồ tuyến.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t4",
      "type": "teaching",
      "title": "转机 · chuyển chuyến máy bay",
      "text": "转机1 là động từ chuyển sang máy bay khác; không phải bước ngoặt tình hình.",
      "hanzi": "我们要在另一座城市转机。",
      "pinyin": "Wǒ men yào zài lìng yí zuò chéng shì zhuǎn jī.",
      "meaning": "Chúng tôi phải chuyển máy bay ở thành phố khác.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-t5",
      "type": "teaching",
      "title": "趟 · lượng từ cho lượt đi",
      "text": "趟 đếm lượt di chuyển, khác 辆 đếm xe. Nhận diện chữ 趟 trong 趟; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "今天我跑了两趟。",
      "pinyin": "Jīn tiān wǒ pǎo le liǎng tàng.",
      "meaning": "Hôm nay tôi đi hai lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l4043-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "拿不了 (ná bu liǎo) biểu thị không đủ khả năng cầm/mang; 了 ở đây không đọc le. Không tự đổi thành chưa làm xong trong mọi ngữ cảnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4043-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里，小李坐了一趟车到机场，随后还要转机。售票员给他看图，指出十字路口旁的停车场。小李的箱子太重，一个人拿不了，于是请朋友帮忙。这里不是实际出行路线。",
      "pinyin": "Gù shi lǐ, Xiǎo Lǐ zuò le yí tàng chē dào jī chǎng, suí hòu hái yào zhuǎn jī. Shòu piào yuán gěi tā kàn tú, zhǐ chū shí zì lù kǒu páng de tíng chē chǎng. Xiǎo Lǐ de xiāng zi tài zhòng, yí ge rén ná bu liǎo, yú shì qǐng péng you bāng máng. Zhè lǐ bú shì shí jì chū xíng lù xiàn.",
      "meaning": "Trong hành trình hư cấu, Tiểu Lý hỏi sơ đồ và nhờ bạn mang hộ chiếc vali nặng.",
      "readingMinutes": 2
    },
