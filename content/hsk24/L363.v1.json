  "blocks": [
    {
      "id": "l363-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 公开 gōngkāi: công khai; 默认 mòrèn: mặc định; 设备 shèbèi: thiết bị. Chưa có kiểm thử nghe nhạc hay tác vụ chụp ảnh thật trong ứng dụng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l363-t0",
      "type": "teaching",
      "title": "运动会 · đại hội/hội thi thể thao",
      "text": "运动会 là hoạt động có nhiều phần thi thể thao theo bài; không đồng nghĩa mọi cuộc họp vì có 会.",
      "hanzi": "学校明天开运动会。",
      "pinyin": "Xuéxiào míngtiān kāi yùndònghuì.",
      "meaning": "Ngày mai trường tổ chức hội thi thể thao.",
      "readingMinutes": 1
    },
    {
      "id": "l363-t1",
      "type": "teaching",
      "title": "运动员 · vận động viên",
      "text": "运动员 chỉ người thi/chơi thể thao với vai trò vận động viên; 员 là yếu tố chỉ người, không phải mọi khán giả.",
      "hanzi": "这位运动员是我们的同学。",
      "pinyin": "Zhè wèi yùndòngyuán shì wǒmen de tóngxué.",
      "meaning": "Vận động viên này là bạn học chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l363-t2",
      "type": "teaching",
      "title": "晚会 · buổi liên hoan/văn nghệ tối",
      "text": "晚会 là hoạt động tụ họp văn nghệ buổi tối, không phải mọi 会 họp diễn ra muộn. Đọc lịch để biết hoạt động.",
      "hanzi": "晚上学校有晚会。",
      "pinyin": "Wǎnshang xuéxiào yǒu wǎnhuì.",
      "meaning": "Buổi tối trường có liên hoan văn nghệ.",
      "readingMinutes": 1
    },
    {
      "id": "l363-t3",
      "type": "teaching",
      "title": "音乐 · âm nhạc",
      "text": "音乐 đọc yuè, khác lè trong 快乐; bài đọc nói nghe nhạc nhưng không có audio đánh giá khả năng nghe.",
      "hanzi": "她喜欢听音乐。",
      "pinyin": "Tā xǐhuan tīng yīnyuè.",
      "meaning": "Cô ấy thích nghe nhạc.",
      "readingMinutes": 1
    },
    {
      "id": "l363-t4",
      "type": "teaching",
      "title": "拍照 · chụp ảnh",
      "text": "拍照 là hoạt động chụp ảnh; 给运动员拍照 là chụp cho vận động viên, không nhận người trực tiếp sau 照 như tân ngữ tùy ý.",
      "hanzi": "我给同学拍照。",
      "pinyin": "Wǒ gěi tóngxué pāi zhào.",
      "meaning": "Tôi chụp ảnh cho bạn học.",
      "readingMinutes": 1
    },
    {
      "id": "l363-t5",
      "type": "teaching",
      "title": "相机 · máy ảnh",
      "text": "相机 là máy ảnh, khác 照片 là ảnh sản phẩm. 带相机说 mang thiết bị, không phải tấm ảnh.",
      "hanzi": "这台相机是借来的。",
      "pinyin": "Zhè tái xiàngjī shì jiè lái de.",
      "meaning": "Máy ảnh này là đồ mượn.",
      "readingMinutes": 1
    },
    {
      "id": "l363-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一边听音乐，一边拍照 mô tả hai hành động đồng thời của cùng chủ thể trong cảnh. 不 phải lúc nào cũng nên đa nhiệm; chỉ luyện quan hệ song song trong văn bản.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l363-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "白天学校开运动会，小林用借来的相机给运动员拍照。晚上有晚会，他一边听音乐，一边拍照。朋友问照片能不能公开，他说先问被拍的人，不因为参加活动就默认同意。",
      "pinyin": "Báitiān xuéxiào kāi yùndònghuì, Xiǎo Lín yòng jiè lái de xiàngjī gěi yùndòngyuán pāi zhào. Wǎnshang yǒu wǎnhuì, tā yìbiān tīng yīnyuè, yìbiān pāi zhào. Péngyou wèn zhàopiàn néng bu néng gōngkāi, tā shuō xiān wèn bèi pāi de rén, bù yīnwèi cānjiā huódòng jiù mòrèn tóngyì.",
      "meaning": "Ban ngày Lâm chụp vận động viên bằng máy ảnh mượn, tối chụp ở văn nghệ. Cậu nói cần hỏi người trong ảnh trước khi công khai, không tự coi tham gia là đồng ý.",
      "readingMinutes": 2
    },
    {
