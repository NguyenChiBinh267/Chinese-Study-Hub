  "blocks": [
    {
      "id": "l1160-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder0",
      "type": "teaching",
      "title": "东西 · đồ; vật",
      "text": "Từ đã học 东西 có 2 chữ. Chữ 西 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 西 với 四 / 酉 / 画; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是什么东西？",
      "pinyin": "Zhè shì shén me dōng xi?",
      "meaning": "Đây là đồ gì?",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder1",
      "type": "teaching",
      "title": "和 · và",
      "text": "Từ đã học 和 có 1 chữ. Chữ 和 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 和 với 知 / 扣 / 种; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我爸爸和我妈妈喜欢茶。",
      "pinyin": "Wǒ bà ba hé wǒ mā ma xǐ huan chá.",
      "meaning": "Bố và mẹ tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder2",
      "type": "teaching",
      "title": "有 · có",
      "text": "Từ đã học 有 có 1 chữ. Chữ 有 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 有 với 右 / 育 / 月; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我家有三口人。",
      "pinyin": "Wǒ jiā yǒu sān kǒu rén.",
      "meaning": "Gia đình tôi có ba người.",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder3",
      "type": "teaching",
      "title": "它 · nó (vật hoặc con vật)",
      "text": "Từ đã học 它 có 1 chữ. Chữ 它 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 它 với 宝 / 宅 / 他; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "它是我的狗。",
      "pinyin": "Tā shì wǒ de gǒu.",
      "meaning": "Nó là chó của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder4",
      "type": "teaching",
      "title": "只 · con (lượng từ)",
      "text": "Từ đã học 只 có 1 chữ. Chữ 只 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 只 với 兄 / 员 / 号; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这只猫是我的。",
      "pinyin": "Zhè zhī māo shì wǒ de.",
      "meaning": "Con mèo này là của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reminder5",
      "type": "teaching",
      "title": "小 · nhỏ; bé",
      "text": "Từ đã học 小 có 1 chữ. Chữ 小 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 小 với 少 / 水 / 木; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这只猫很小。",
      "pinyin": "Zhè zhī māo hěn xiǎo.",
      "meaning": "Con mèo này nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l1160-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这个饭店怎么样？\nB：米饭很好吃。\nA：你吃饺子吗？\nB：不，我吃米饭。",
      "pinyin": "A: Zhè ge fàn diàn zěn me yàng? B: Mǐ fàn hěn hǎo chī. A: Nǐ chī jiǎo zi ma? B: Bù, wǒ chī mǐ fàn.",
      "meaning": "B khen cơm và chọn cơm, không chọn sủi cảo.",
      "readingMinutes": 2
    },
