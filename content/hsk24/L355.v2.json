  "blocks": [
    {
      "id": "l355-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 要求 yāoqiú: yêu cầu; 答案 dá’àn: đáp án; 会议 huìyì: cuộc họp. 不同 bù tóng: khác nhau; phân biệt hết giờ với xong việc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l355-t0",
      "type": "teaching",
      "title": "完成 · hoàn thành",
      "text": "完成 nêu đạt xong nhiệm vụ; 结束 chỉ chấm dứt, có thể chưa hoàn thành mục tiêu. 完成作业 có tân ngữ bài tập.",
      "hanzi": "我已经完成作业了。",
      "pinyin": "Wǒ yǐjīng wánchéng zuòyè le.",
      "meaning": "Tôi đã hoàn thành bài tập.",
      "readingMinutes": 1
    },
    {
      "id": "l355-t1",
      "type": "teaching",
      "title": "结束 · kết thúc",
      "text": "结束 nói hoạt động/khoảng thời gian chấm dứt; 会议结束 chưa bảo đảm mọi việc đã giải quyết.",
      "hanzi": "会议四点结束。",
      "pinyin": "Huìyì sì diǎn jiéshù.",
      "meaning": "Cuộc họp kết thúc lúc bốn giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l355-t2",
      "type": "teaching",
      "title": "直到 · cho đến/tới tận",
      "text": "直到 nêu mốc kéo dài hoặc điểm tới, 常 đi với 才 để nói mãi tới mốc mới xảy ra. Không phải mọi 直到 đều có phủ định.",
      "hanzi": "我直到十点才完成。",
      "pinyin": "Wǒ zhídào shí diǎn cái wánchéng.",
      "meaning": "Mãi đến mười giờ tôi mới hoàn thành.",
      "readingMinutes": 1
    },
    {
      "id": "l355-t3",
      "type": "teaching",
      "title": "先 · trước/trước tiên",
      "text": "先 đánh dấu việc làm trước trong chuỗi, thường trước động từ. 先看再写 chưa nói việc nào đã làm xong.",
      "hanzi": "我们先看要求。",
      "pinyin": "Wǒmen xiān kàn yāoqiú.",
      "meaning": "Chúng tôi xem yêu cầu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l355-t4",
      "type": "teaching",
      "title": "然后 · sau đó/rồi",
      "text": "然后 nối bước tiếp trong câu kể/kế hoạch; khác 以后 là mốc sau một khoảng/thời điểm trong nhiều cấu trúc.",
      "hanzi": "先读课文，然后回答。",
      "pinyin": "Xiān dú kèwén, ránhòu huídá.",
      "meaning": "Đọc bài trước rồi trả lời.",
      "readingMinutes": 1
    },
    {
      "id": "l355-t5",
      "type": "teaching",
      "title": "最后 · cuối cùng/sau cùng",
      "text": "最后 nêu bước hay vị trí cuối trong chuỗi; 不 đồng nghĩa “cuối cùng thành công” nếu không nói kết quả.",
      "hanzi": "最后我们检查答案。",
      "pinyin": "Zuìhòu wǒmen jiǎnchá dá'àn.",
      "meaning": "Cuối cùng chúng tôi kiểm tra đáp án.",
      "readingMinutes": 1
    },
    {
      "id": "l355-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "从九点起 bắt đầu từ chín giờ; 直到十点才完成 kéo dài đến mười giờ mới hoàn thành. 先/然后/最后 xác định trình tự, không tự làm điều sau xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l355-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "从九点起，小林先看要求，然后做题，最后检查。他直到十点才完成作业。课十点半结束，所以完成作业的时间和课结束的时间不同。",
      "pinyin": "Cóng jiǔ diǎn qǐ, Xiǎo Lín xiān kàn yāoqiú, ránhòu zuò tí, zuìhòu jiǎnchá. Tā zhídào shí diǎn cái wánchéng zuòyè. Kè shí diǎn bàn jiéshù, suǒyǐ wánchéng zuòyè de shíjiān hé kè jiéshù de shíjiān bù tóng.",
      "meaning": "Lâm bắt đầu chín giờ, xem yêu cầu, làm rồi kiểm tra. Mười giờ mới hoàn thành, còn tiết học mười giờ rưỡi kết thúc: hai mốc khác nhau.",
      "readingMinutes": 2
    },
