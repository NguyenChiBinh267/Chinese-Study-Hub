  "blocks": [
    {
      "id": "l350-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 画册 huàcè: sách tranh; 合 hé: hợp; 重要 zhòngyào: quan trọng; 画画儿 huà huàr: vẽ. Đọc pinyin từ tách âm kě ài/xǐ ài, giữ thanh điệu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l350-t0",
      "type": "teaching",
      "title": "感兴趣 · cảm thấy hứng thú",
      "text": "感兴趣 thường dùng 对…感兴趣; không nói 很感一个兴趣. Cụm chỉ thái độ, khác 兴趣 là danh từ.",
      "hanzi": "她对画画儿感兴趣。",
      "pinyin": "Tā duì huà huàr gǎn xìngqù.",
      "meaning": "Cô ấy hứng thú với vẽ.",
      "readingMinutes": 1
    },
    {
      "id": "l350-t1",
      "type": "teaching",
      "title": "兴趣 · sở thích/hứng thú",
      "text": "兴趣 là danh từ; 有兴趣 là có hứng thú, 什么兴趣 hỏi sở thích. Không thay toàn bộ 感兴趣 bằng 兴趣 sau 很.",
      "hanzi": "他的兴趣是看书。",
      "pinyin": "Tā de xìngqù shì kàn shū.",
      "meaning": "Sở thích của cậu ấy là đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l350-t2",
      "type": "teaching",
      "title": "喜爱 · yêu thích",
      "text": "喜爱 diễn tả yêu thích người/vật, thường mạnh hoặc mang sắc thái viết hơn 喜欢. Dấu ’ trong pinyin nguồn chỉ ranh giới âm, không đổi thanh.",
      "hanzi": "孩子们喜爱这个故事。",
      "pinyin": "Háizimen xǐ’ài zhège gùshi.",
      "meaning": "Các em yêu thích câu chuyện này.",
      "readingMinutes": 1
    },
    {
      "id": "l350-t3",
      "type": "teaching",
      "title": "可爱 · đáng yêu",
      "text": "可爱 mô tả dễ thương/đáng yêu; không phải “có thể yêu” chia hai vị từ. Đây là đánh giá của người nói, không áp cho mọi người.",
      "hanzi": "这只小猫很可爱。",
      "pinyin": "Zhè zhī xiǎo māo hěn kě’ài.",
      "meaning": "Chú mèo nhỏ này đáng yêu.",
      "readingMinutes": 1
    },
    {
      "id": "l350-t4",
      "type": "teaching",
      "title": "礼物 · quà tặng",
      "text": "礼物 là đồ tặng, không tự phải đắt tiền. 送礼物 nêu tặng quà, khác 给钱 mọi trường hợp.",
      "hanzi": "我想给妹妹选一件礼物。",
      "pinyin": "Wǒ xiǎng gěi mèimei xuǎn yí jiàn lǐwù.",
      "meaning": "Tôi muốn chọn một món quà cho em gái.",
      "readingMinutes": 1
    },
    {
      "id": "l350-t5",
      "type": "teaching",
      "title": "做客 · đến làm khách/đến chơi nhà ai",
      "text": "做客 nói mình đến làm khách, 请客 là mời đãi người khác. 去朋友家做客 xác định nhà đến, không phải nhận khách ở nhà mình.",
      "hanzi": "周末我去朋友家做客。",
      "pinyin": "Zhōumò wǒ qù péngyou jiā zuò kè.",
      "meaning": "Cuối tuần tôi đến nhà bạn chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l350-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对孩子来说，这个故事很有意思 nêu góc nhìn/đối tượng đánh giá. 不 suy ra mọi trẻ đều thích cùng món quà; hỏi sở thích cụ thể.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l350-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "周末小林去朋友家做客，想给孩子带礼物。他先问孩子的兴趣，知道她对画画儿感兴趣，也喜爱小猫。小林选了一本有可爱小猫的画册。他说：对孩子来说，合兴趣比价格更重要。",
      "pinyin": "Zhōumò Xiǎo Lín qù péngyou jiā zuò kè, xiǎng gěi háizi dài lǐwù. Tā xiān wèn háizi de xìngqù, zhīdào tā duì huà huàr gǎn xìngqù, yě xǐ’ài xiǎo māo. Xiǎo Lín xuǎn le yì běn yǒu kě’ài xiǎo māo de huàcè. Tā shuō: Duì háizi lái shuō, hé xìngqù bǐ jiàgé gèng zhòngyào.",
      "meaning": "Lâm hỏi sở thích trước khi chọn quà cho trẻ khi đến nhà bạn. Biết em thích vẽ và mèo, cậu chọn sách tranh mèo; ưu tiên hợp sở thích hơn giá.",
      "readingMinutes": 2
    },
    {
