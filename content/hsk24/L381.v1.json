  "blocks": [
    {
      "id": "l381-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 种 zhòng: trồng; 生长 shēngzhǎng: sinh trưởng; 长度 chángdù: độ dài; 起床 qǐ chuáng: thức dậy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l381-t0",
      "type": "teaching",
      "title": "不久 · không lâu/sắp hoặc mới đây tùy mốc",
      "text": "不久 nói khoảng không lâu, có thể 不久以前 hoặc 不久以后. Không tự là thời tương lai nếu thiếu mốc.",
      "hanzi": "不久以后，他回来了。",
      "pinyin": "Bùjiǔ yǐhòu, tā huílai le.",
      "meaning": "Không lâu sau, anh ấy quay lại.",
      "readingMinutes": 1
    },
    {
      "id": "l381-t1",
      "type": "teaching",
      "title": "才 · mãi…mới (phó từ thời gian)",
      "text": "才1 trong 十点才来 nêu đến muộn hơn chờ đợi; khác 才 chỉ số lượng ít ở nghĩa khác. Chữ 1 không gõ trong câu.",
      "hanzi": "他十点才来。",
      "pinyin": "Tā shí diǎn cái lái.",
      "meaning": "Mãi mười giờ cậu ấy mới đến.",
      "readingMinutes": 1
    },
    {
      "id": "l381-t2",
      "type": "teaching",
      "title": "刚刚 · vừa mới",
      "text": "刚刚 nêu ngay trước thời điểm đang kể, không tự là đúng một phút. 刚刚到 chỉ vừa đến, chưa nói đã nghỉ đủ.",
      "hanzi": "我们刚刚到了。",
      "pinyin": "Wǒmen gānggāng dào le.",
      "meaning": "Chúng tôi vừa đến rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l381-t3",
      "type": "teaching",
      "title": "平时 · bình thường/ngày thường",
      "text": "平时 nói thói quen hoặc thời gian thường ngày, khác 今天/现在 một lần cụ thể. 平时早不保证今天早.",
      "hanzi": "他平时七点起床。",
      "pinyin": "Tā píngshí qī diǎn qǐ chuáng.",
      "meaning": "Bình thường cậu ấy dậy bảy giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l381-t4",
      "type": "teaching",
      "title": "长 · mọc/lớn lên; trưởng trong từ ghép",
      "text": "长 zhǎng trong 长高 là lớn/cao lên, khác cháng là dài. 校长的长也读zhǎng，但功能是职位成分，未作同一用法题.",
      "hanzi": "这棵树长高了。",
      "pinyin": "Zhè kē shù zhǎng gāo le.",
      "meaning": "Cây này đã mọc cao hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l381-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "刚刚 nêu vừa mới xảy ra; 才1 trong 十点才来 nhấn muộn hơn kỳ vọng. 平时 nêu thường ngày, 不久 nêu khoảng không lâu tùy mốc. Chưa đo chính xác số phút của 刚刚.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l381-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林平时很早来，今天却十点才来。他说自己刚刚到，路上等车等了很久。不久以后朋友也到了。两人发现去年种的小树长高了，这说的是生长，不是长度的长cháng。",
      "pinyin": "Xiǎo Lín píngshí hěn zǎo lái, jīntiān què shí diǎn cái lái. Tā shuō zìjǐ gānggāng dào, lù shàng děng chē děng le hěn jiǔ. Bùjiǔ yǐhòu péngyou yě dào le. Liǎng rén fāxiàn qùnián zhòng de xiǎo shù zhǎng gāo le, zhè shuō de shì shēngzhǎng, bú shì chángdù de cháng.",
      "meaning": "Lâm thường đến sớm nhưng hôm nay mãi mười giờ mới đến vì chờ xe. Không lâu sau bạn đến; họ thấy cây trồng năm trước cao lên, phân biệt zhǎng với cháng.",
      "readingMinutes": 2
    },
    {
      "id": "l381-b0",
      "type": "exercise",
      "exerciseVersionId": "l381-v1-e0"
