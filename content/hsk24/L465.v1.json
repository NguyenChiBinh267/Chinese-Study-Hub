  "blocks": [
    {
      "id": "l465-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 尝 cháng: nếm; 少量 shǎoliàng: lượng ít; 家乡 jiāxiāng: quê nhà. Chỉ luyện gọi món, không khuyến nghị dinh dưỡng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l465-t0",
      "type": "teaching",
      "title": "快餐 · đồ ăn nhanh",
      "text": "快餐 nói kiểu bữa ăn phục vụ nhanh, không tự khẳng định dinh dưỡng tốt hay xấu.",
      "hanzi": "中午他买了一份快餐。",
      "pinyin": "Zhōngwǔ tā mǎi le yí fèn kuàicān.",
      "meaning": "Trưa anh mua một suất ăn nhanh.",
      "readingMinutes": 1
    },
    {
      "id": "l465-t1",
      "type": "teaching",
      "title": "馒头 · màn thầu, bánh bột hấp",
      "text": "馒头 thường là bánh hấp không nhân trong phạm vi bài; không đồng nhất 包子.",
      "hanzi": "她买了两个馒头。",
      "pinyin": "Tā mǎi le liǎng ge mántou.",
      "meaning": "Cô mua hai bánh màn thầu.",
      "readingMinutes": 1
    },
    {
      "id": "l465-t2",
      "type": "teaching",
      "title": "美食 · món ngon",
      "text": "美食 là cách đánh giá món ăn ngon, không phải tên một món duy nhất.",
      "hanzi": "他喜欢介绍家乡美食。",
      "pinyin": "Tā xǐhuan jièshào jiāxiāng měishí.",
      "meaning": "Anh thích giới thiệu món ngon quê nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l465-t3",
      "type": "teaching",
      "title": "烤 · nướng",
      "text": "烤 là cách làm chín bằng nhiệt khô, khác 煮 là nấu/luộc trong nước. Nhận diện chữ 烤 trong 烤; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这家店可以烤鱼。",
      "pinyin": "Zhè jiā diàn kěyǐ kǎo yú.",
      "meaning": "Quán này có thể nướng cá.",
      "readingMinutes": 1
    },
    {
      "id": "l465-t4",
      "type": "teaching",
      "title": "辣 · cay",
      "text": "辣 tả vị cay; 不辣 chỉ độ cay, không phải lời bảo đảm không có thành phần gây dị ứng.",
      "hanzi": "请做得不太辣。",
      "pinyin": "Qǐng zuò de bú tài là.",
      "meaning": "Xin làm không cay lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l465-t5",
      "type": "teaching",
      "title": "零食 · đồ ăn vặt",
      "text": "零食 là thức ăn dùng ngoài bữa chính trong ngữ cảnh, không thay mọi bữa ăn bằng nó.",
      "hanzi": "她没有把零食当午饭。",
      "pinyin": "Tā méiyǒu bǎ língshí dàng wǔfàn.",
      "meaning": "Cô không coi đồ ăn vặt là bữa trưa.",
      "readingMinutes": 1
    },
    {
      "id": "l465-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "顿 đếm bữa ăn: 一顿饭、吃了三顿. Không thay bằng 个 trước 饭 trong cách đếm bữa này. Trong câu 我们一起吃了一顿午饭, 一顿 giữ cùng danh từ 午饭 để tránh đáp án thứ tự khác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l465-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小马和朋友一起吃了一顿午饭。朋友想尝家乡美食，选了烤鱼，请店员做得不太辣。小马时间少，买了一份快餐和两个馒头。他们下午还要参观，所以只买少量零食带走，没有再加一道大菜。",
      "pinyin": "Xiǎo Mǎ hé péngyou yìqǐ chī le yí dùn wǔfàn. Péngyou xiǎng cháng jiāxiāng měishí, xuǎn le kǎo yú, qǐng diànyuán zuò de bú tài là. Xiǎo Mǎ shíjiān shǎo, mǎi le yí fèn kuàicān hé liǎng ge mántou. Tāmen xiàwǔ hái yào cānguān, suǒyǐ zhǐ mǎi shǎoliàng língshí dài zǒu, méiyǒu zài jiā yí dào dà cài.",
      "meaning": "Mã và bạn ăn trưa. Bạn gọi cá nướng ít cay, Mã chọn suất nhanh và màn thầu vì ít thời gian. Họ chỉ mua ít đồ ăn vặt mang đi trước buổi tham quan.",
      "readingMinutes": 2
    },
