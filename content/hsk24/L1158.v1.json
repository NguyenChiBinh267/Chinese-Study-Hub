  "blocks": [
    {
      "id": "l1158-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1158-reminder0",
      "type": "teaching",
      "title": "二 · hai (số đếm)",
      "text": "Từ đã học 二 có 1 chữ. Chữ 二 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 二 với 三 / 工 / 上; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "一、二、三。",
      "pinyin": "Yī, èr, sān.",
      "meaning": "Một, hai, ba.",
      "readingMinutes": 1
    },
    {
      "id": "l1158-reminder1",
      "type": "teaching",
      "title": "五 · năm",
      "text": "Từ đã học 五 có 1 chữ. Chữ 五 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 五 với 互 / 正 / 王; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "三、四、五。",
      "pinyin": "Sān, sì, wǔ.",
      "meaning": "Ba, bốn, năm.",
      "readingMinutes": 1
    },
    {
      "id": "l1158-reminder2",
      "type": "teaching",
      "title": "四 · bốn",
      "text": "Từ đã học 四 có 1 chữ. Chữ 四 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 四 với 西 / 匹 / 回; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "二、三、四。",
      "pinyin": "Èr, sān, sì.",
      "meaning": "Hai, ba, bốn.",
      "readingMinutes": 1
    },
    {
      "id": "l1158-reminder3",
      "type": "teaching",
      "title": "七 · bảy",
