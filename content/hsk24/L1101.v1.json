  "blocks": [
    {
      "id": "l1101-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1101-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "和 + người có thể nêu người cùng tham gia hành động: 我想和朋友读书. Trong mẫu này, 我 là người bày tỏ mong muốn, 和朋友 nêu người cùng đọc. So sánh 书和笔: 和 nối hai tên đồ vật; không dùng nghĩa “và” để dịch máy mọi câu. 下课以后 được chú giải “sau giờ học”; 以后 là từ hỗ trợ ở đây, không cộng thêm mục từ HSK1. Các câu luyện sau phần nhắc chỉ chấm mẫu đã nêu, không chấm hội thoại tự do.",
      "hanzi": "我想和朋友读书。",
      "pinyin": "Wǒ xiǎng hé péng you dú shū.",
      "meaning": "Tôi muốn đọc sách cùng bạn.",
      "readingMinutes": 3
    },
    {
      "id": "l1101-reminder0",
      "type": "teaching",
      "title": "朋友 · bạn; bạn bè",
      "text": "Nhắc nghĩa đã học: bạn; bạn bè. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "你好，朋友！",
      "pinyin": "Nǐ hǎo, péng you!",
      "meaning": "Chào bạn!",
      "readingMinutes": 1
    },
    {
      "id": "l1101-reminder1",
      "type": "teaching",
      "title": "想 · muốn; nghĩ (theo ngữ cảnh)",
      "text": "Nhắc nghĩa đã học: muốn; nghĩ (theo ngữ cảnh). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我想喝茶。",
      "pinyin": "Wǒ xiǎng hē chá.",
      "meaning": "Tôi muốn uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1101-reminder2",
      "type": "teaching",
      "title": "读书 · đọc sách; đi học (tùy ngữ cảnh)",
      "text": "Nhắc nghĩa đã học: đọc sách; đi học (tùy ngữ cảnh). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我喜欢读书。",
      "pinyin": "Wǒ xǐ huan dú shū.",
      "meaning": "Tôi thích đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l1101-reminder3",
      "type": "teaching",
      "title": "学校 · trường học",
      "text": "Nhắc nghĩa đã học: trường học. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "这是我们的学校。",
      "pinyin": "Zhè shì wǒ men de xué xiào.",
      "meaning": "Đây là trường của chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1101-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：下课以后，你想做什么？\nB：我想和朋友读书。\nA：在哪儿？\nB：在学校。",
      "pinyin": "A: Xià kè yǐ hòu, nǐ xiǎng zuò shén me? B: Wǒ xiǎng hé péng you dú shū. A: Zài nǎr? B: Zài xué xiào.",
      "meaning": "以后 yǐ hòu = sau đó; ở đây 下课以后 là sau giờ học. B muốn đọc sách cùng bạn tại trường; chưa khẳng định kế hoạch đã diễn ra.",
      "readingMinutes": 2
    },
