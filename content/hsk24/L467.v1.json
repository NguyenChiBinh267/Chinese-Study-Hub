  "blocks": [
    {
      "id": "l467-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 热身 rè shēn: khởi động; 顺序 shùnxù: thứ tự; 缩短 suōduǎn: rút ngắn; 场边 chǎng biān: mép sân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l467-t0",
      "type": "teaching",
      "title": "接着 · tiếp đó",
      "text": "接着 nối bước tiếp theo, không đồng nghĩa nguyên nhân.",
      "hanzi": "先热身，接着练习。",
      "pinyin": "Xiān rè shēn, jiēzhe liànxí.",
      "meaning": "Khởi động trước rồi tập.",
      "readingMinutes": 1
    },
    {
      "id": "l467-t1",
      "type": "teaching",
      "title": "结果 · kết quả",
      "text": "结果 là danh từ kết quả hoặc từ nối kết cục; bài dùng danh từ 练习的结果.",
      "hanzi": "教练记录了练习的结果。",
      "pinyin": "Jiàoliàn jìlù le liànxí de jiéguǒ.",
      "meaning": "Huấn luyện viên ghi kết quả tập.",
      "readingMinutes": 1
    },
    {
      "id": "l467-t2",
      "type": "teaching",
      "title": "进行 · tiến hành",
      "text": "进行 + hoạt động, như 进行练习; không trực tiếp dùng 进行一个人.",
      "hanzi": "比赛明天进行。",
      "pinyin": "Bǐsài míngtiān jìnxíng.",
      "meaning": "Cuộc thi diễn ra ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l467-t3",
      "type": "teaching",
      "title": "快速 · nhanh, nhanh chóng",
      "text": "快速 bổ nghĩa hành động/cách thức; không có nghĩa càng nhanh càng đúng.",
      "hanzi": "队员快速走到场边。",
      "pinyin": "Duìyuán kuàisù zǒu dào chǎng biān.",
      "meaning": "Đội viên nhanh chóng tới mép sân.",
      "readingMinutes": 1
    },
    {
      "id": "l467-t4",
      "type": "teaching",
      "title": "来不及 · không kịp",
      "text": "来不及 + hành động nói không đủ thời gian; khác 不会 là chưa biết làm. Nhận diện chữ 及 trong 来不及; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "现在出门就来不及坐那班车了。",
      "pinyin": "Xiànzài chūmén jiù láibují zuò nà bān chē le.",
      "meaning": "Bây giờ ra cửa thì không kịp chuyến đó nữa.",
      "readingMinutes": 1
    },
    {
      "id": "l467-t5",
      "type": "teaching",
      "title": "来得及 · kịp",
      "text": "来得及 có đủ thời gian để làm; dùng 还来得及 khi vẫn còn kịp.",
      "hanzi": "早点儿结束还来得及坐车。",
      "pinyin": "Zǎo diǎnr jiéshù hái láidejí zuò chē.",
      "meaning": "Kết thúc sớm thì vẫn kịp đi xe.",
      "readingMinutes": 1
    },
    {
      "id": "l467-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "要是 nêu điều kiện giả định, 就 nêu cách xử lý, 否则 nêu hậu quả nếu không làm như vậy. Ví dụ 要是时间不够，就缩短练习，否则来不及坐车. Câu chuyện chưa nói mọi buổi tập đều phải ngắn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l467-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "比赛明天进行，队员今天只做短时间练习。大家先热身，接着按顺序上场，教练记录结果。有人要坐车回家，教练说：“要是时间不够，就缩短练习，否则来不及坐车。”队员快速收好东西，确认还来得及再离开。",
      "pinyin": "Bǐsài míngtiān jìnxíng, duìyuán jīntiān zhǐ zuò duǎn shíjiān liànxí. Dàjiā xiān rè shēn, jiēzhe àn shùnxù shàng chǎng, jiàoliàn jìlù jiéguǒ. Yǒu rén yào zuò chē huí jiā, jiàoliàn shuō: “Yàoshi shíjiān bù gòu, jiù suōduǎn liànxí, fǒuzé láibují zuò chē.” Duìyuán kuàisù shōu hǎo dōngxi, quèrèn hái láidejí zài líkāi.",
      "meaning": "Thi ngày mai nên hôm nay nhóm tập ngắn. Huấn luyện viên ghi kết quả, nhắc rút ngắn nếu thiếu thời gian để còn kịp xe. Họ cất đồ và kiểm tra giờ trước khi rời đi.",
      "readingMinutes": 2
    },
    {
