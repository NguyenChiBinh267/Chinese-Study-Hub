  "blocks": [
    {
      "id": "l348-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 钟 zhōng: đồng hồ; 隔 gé: cách một khoảng; 才 cái: mãi/mới theo ngữ cảnh. Giá chỉ là dữ liệu hư cấu để đọc từ, không phải báo giá thị trường.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l348-t0",
      "type": "teaching",
      "title": "半天 · nửa ngày; lâu theo khẩu ngữ",
      "text": "半天 có thể là nửa ngày hoặc “mãi/lâu” theo khẩu ngữ; phải dựa câu. 学了半天 ở lịch buổi sáng là học nửa ngày trong bài.",
      "hanzi": "我们上午学了半天。",
      "pinyin": "Wǒmen shàngwǔ xué le bàntiān.",
      "meaning": "Chúng tôi học nửa ngày vào buổi sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l348-t1",
      "type": "teaching",
      "title": "久 · lâu",
      "text": "久 nói thời gian dài, không đo độ dài đồ vật. 等了很久 là đã chờ lâu, chưa có số phút chính xác.",
      "hanzi": "我在这里等了很久。",
      "pinyin": "Wǒ zài zhèlǐ děng le hěn jiǔ.",
      "meaning": "Tôi đã chờ ở đây lâu.",
      "readingMinutes": 1
    },
    {
      "id": "l348-t2",
      "type": "teaching",
      "title": "好多 · rất nhiều",
      "text": "好多 là nhiều trong khẩu ngữ, không nêu số chính xác. 好多人 nêu nhiều người, không phải “người tốt”.",
      "hanzi": "今天来了好多人。",
      "pinyin": "Jīntiān lái le hǎoduō rén.",
      "meaning": "Hôm nay có rất nhiều người đến.",
      "readingMinutes": 1
    },
    {
      "id": "l348-t3",
      "type": "teaching",
      "title": "好久 · rất lâu",
      "text": "好久 nhấn mạnh lâu, 常 dùng 好久不见 là lâu không gặp. Đây không phải thời gian tốt theo nghĩa từng chữ.",
      "hanzi": "我们好久不见了。",
      "pinyin": "Wǒmen hǎojiǔ bú jiàn le.",
      "meaning": "Chúng ta lâu không gặp rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l348-t4",
      "type": "teaching",
      "title": "刻 · một phần tư giờ; khắc",
      "text": "刻 trong 一刻钟 là mười lăm phút; chưa dạy nghĩa khắc/chạm. 三点一刻 không phải ba giờ một phút.",
      "hanzi": "现在是三点一刻。",
      "pinyin": "Xiànzài shì sān diǎn yí kè.",
      "meaning": "Bây giờ là ba giờ mười lăm.",
      "readingMinutes": 1
    },
    {
      "id": "l348-t5",
      "type": "teaching",
      "title": "角 · hào; 1/10 nhân dân tệ",
      "text": "角 trong giá tiền là một phần mười 元, cùng giá trị đơn vị 毛 khẩu ngữ; khác 角 ở hình học hay vai diễn, chưa học ở đây.",
      "hanzi": "这张纸两角钱。",
      "pinyin": "Zhè zhāng zhǐ liǎng jiǎo qián.",
      "meaning": "Tờ giấy này giá hai hào.",
      "readingMinutes": 1
    },
    {
      "id": "l348-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一刻钟 là mười lăm phút; 三点一刻 là ba giờ mười lăm. 毛/角 là một phần mười 元 trong hệ tiền đang mô tả; 不 phải mọi “毛” đều chỉ tiền. Bài luyện đọc đơn vị, không giao dịch.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l348-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林学了半天，下午去买纸。店里有好多人，他觉得等了好久，看钟才知道只过了一刻钟。纸的价格写着每张两角。他跟朋友说好久不见，没有说他们只隔了十五分钟。",
      "pinyin": "Xiǎo Lín xué le bàntiān, xiàwǔ qù mǎi zhǐ. Diàn lǐ yǒu hǎoduō rén, tā juéde děng le hǎojiǔ, kàn zhōng cái zhīdào zhǐ guò le yí kè zhōng. Zhǐ de jiàgé xiě zhe měi zhāng liǎng jiǎo. Tā gēn péngyou shuō hǎojiǔ bú jiàn, méiyǒu shuō tāmen zhǐ gé le shíwǔ fēnzhōng.",
      "meaning": "Lâm học nửa ngày rồi mua giấy. Cửa hàng đông, cảm thấy chờ lâu nhưng mới mười lăm phút. Giấy ghi giá hai hào một tờ; lời “lâu không gặp” là chuyện khác.",
      "readingMinutes": 2
    },
    {
