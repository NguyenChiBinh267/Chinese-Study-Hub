  "blocks": [
    {
      "id": "l448-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 允许 yǔnxǔ: cho phép; 指挥 zhǐhuī: chỉ huy; 沿 yán: dọc theo; 影响 yǐngxiǎng: ảnh hưởng; 路线 lùxiàn: tuyến đường.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l448-t0",
      "type": "teaching",
      "title": "加油站 · trạm xăng",
      "text": "加油站 là nơi tiếp nhiên liệu; không phải bến xe khách.",
      "hanzi": "加油站在下一条街。",
      "pinyin": "Jiāyóuzhàn zài xià yì tiáo jiē.",
      "meaning": "Trạm xăng ở phố kế tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l448-t1",
      "type": "teaching",
      "title": "交警 · cảnh sát giao thông",
      "text": "交警 là cách gọi rút gọn 交通警察; không đồng nghĩa bảo vệ bãi xe.",
      "hanzi": "交警正在指挥交通。",
      "pinyin": "Jiāojǐng zhèngzài zhǐhuī jiāotōng.",
      "meaning": "Cảnh sát giao thông đang điều phối giao thông.",
      "readingMinutes": 1
    },
    {
      "id": "l448-t2",
      "type": "teaching",
      "title": "交通 · giao thông",
      "text": "交通 nói hoạt động/hệ thống đi lại; không đếm như một chiếc xe.",
      "hanzi": "这条街的交通很方便。",
      "pinyin": "Zhè tiáo jiē de jiāotōng hěn fāngbiàn.",
      "meaning": "Giao thông phố này thuận tiện.",
      "readingMinutes": 1
    },
    {
      "id": "l448-t3",
      "type": "teaching",
      "title": "街道 · đường phố",
      "text": "街道 là phố trong khu dân cư/đô thị; khác mọi 公路 đều là 街道.",
      "hanzi": "这条街道很安静。",
      "pinyin": "Zhè tiáo jiēdào hěn ānjìng.",
      "meaning": "Phố này yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l448-t4",
      "type": "teaching",
      "title": "节约 · tiết kiệm",
      "text": "节约 dùng cho thời gian/tài nguyên; không đồng nghĩa càng rẻ càng tốt.",
      "hanzi": "提前看地图可以节约时间。",
      "pinyin": "Tíqián kàn dìtú kěyǐ jiéyuē shíjiān.",
      "meaning": "Xem bản đồ trước giúp tiết kiệm thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l448-t5",
      "type": "teaching",
      "title": "禁止 · cấm",
      "text": "禁止 + hành vi, trên biển 禁止停车; không thêm 不 để tạo phủ định kép ngoài ý muốn. Nhận diện chữ 禁 trong 禁止; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这里禁止停车。",
      "pinyin": "Zhèlǐ jìnzhǐ tíngchē.",
      "meaning": "Ở đây cấm đỗ xe.",
      "readingMinutes": 1
    },
    {
      "id": "l448-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "否则 nối hậu quả có thể xảy ra nếu không làm điều vừa nói: 请按规定停车，否则会影响交通. Không có nghĩa dù vậy. Bài dùng hậu quả giả định; không khẳng định chế tài hay luật địa phương.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l448-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老王想找加油站，先把车停在允许停车的地方，再向交警问路。交警指着地图说：“沿这条街道走，下一个路口就到。前面禁止停车，请按规定停车，否则会影响交通。”老王记下路线，觉得先看清地图能节约时间。",
      "pinyin": "Lǎo Wáng xiǎng zhǎo jiāyóuzhàn, xiān bǎ chē tíng zài yǔnxǔ tíngchē de dìfang, zài xiàng jiāojǐng wèn lù. Jiāojǐng zhǐzhe dìtú shuō: “Yán zhè tiáo jiēdào zǒu, xià yí ge lùkǒu jiù dào. Qiánmiàn jìnzhǐ tíngchē, qǐng àn guīdìng tíngchē, fǒuzé huì yǐngxiǎng jiāotōng.” Lǎo Wáng jì xià lùxiàn, juéde xiān kàn qīng dìtú néng jiéyuē shíjiān.",
      "meaning": "Vương đỗ ở chỗ cho phép rồi hỏi trạm xăng. Cảnh sát chỉ đường và nhắc phía trước cấm đỗ; đỗ sai có thể ảnh hưởng giao thông. Vương ghi tuyến đường để tiết kiệm thời gian.",
      "readingMinutes": 2
    },
    {
