  "blocks": [
    {
      "id": "l4035-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t0",
      "type": "teaching",
      "title": "塑料 · nhựa",
      "text": "塑料 là vật liệu nhựa, không phải mọi bao bì. Nhận diện chữ 塑 trong 塑料; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个桶是塑料做的。",
      "pinyin": "Zhè ge tǒng shì sù liào zuò de.",
      "meaning": "Cái xô này làm bằng nhựa.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t1",
      "type": "teaching",
      "title": "桶 · xô; thùng",
      "text": "桶 đựng nước/rác và dùng như đơn vị chứa.",
      "hanzi": "门边放着一个桶。",
      "pinyin": "Mén biān fàng zhe yí ge tǒng.",
      "meaning": "Cạnh cửa đặt một cái xô.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t2",
      "type": "teaching",
      "title": "扔 · ném; vứt",
      "text": "扔 chỉ vứt/ném vật đi, khác đẩy 推.",
      "hanzi": "不要把垃圾扔在地上。",
      "pinyin": "Bú yào bǎ lā jī rēng zài dì shàng.",
      "meaning": "Đừng vứt rác xuống đất.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t3",
      "type": "teaching",
      "title": "吸 · hít; hút",
      "text": "吸 trong câu là hít không khí, không phải hấp dẫn.",
      "hanzi": "她走到外面吸了一口气。",
      "pinyin": "Tā zǒu dào wài miàn xī le yì kǒu qì.",
      "meaning": "Cô ấy ra ngoài hít một hơi.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t4",
      "type": "teaching",
      "title": "烟 · khói; thuốc lá",
      "text": "烟 ở đây là khói, không chỉ một điếu thuốc.",
      "hanzi": "这里有烟，先别进去。",
      "pinyin": "Zhè lǐ yǒu yān, xiān bié jìn qù.",
      "meaning": "Ở đây có khói, khoan vào.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-t5",
      "type": "teaching",
      "title": "卫生 · vệ sinh",
      "text": "卫生 nói tình trạng sạch hoặc việc giữ sạch.",
      "hanzi": "大家轮流打扫，保持卫生。",
      "pinyin": "Dà jiā lún liú dǎ sǎo, bǎo chí wèi shēng.",
      "meaning": "Mọi người luân phiên dọn để giữ vệ sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l4035-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "倒也得倒，不倒也得倒 nhấn mạnh cuối cùng vẫn phải đổ rác. Đây là lời nói mạnh của nhân vật, không phải yêu cầu giao tiếp lịch sự mặc định.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4035-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "大家清理公共房间，把塑料放到指定的桶里，不往地上扔。窗外有人烧东西，屋里有烟，小田到外面透气，不想吸进烟。负责倒垃圾的人说：“倒也得倒，不倒也得倒，不能拖。”大家约好轮流保持卫生。",
      "pinyin": "Dà jiā qīng lǐ gōng gòng fáng jiān, bǎ sù liào fàng dào zhǐ dìng de tǒng lǐ, bù wǎng dì shàng rēng. Chuāng wài yǒu rén shāo dōng xi, wū lǐ yǒu yān, Xiǎo Tián dào wài miàn tòu qì, bù xiǎng xī jìn yān. Fù zé dào lā jī de rén shuō: “Dào yě děi dào, bú dào yě děi dào, bù néng tuō.” Dà jiā yuē hǎo lún liú bǎo chí wèi shēng.",
      "meaning": "Nhóm phân công dọn vệ sinh; người phụ trách tự nhắc không trì hoãn đổ rác.",
      "readingMinutes": 2
    },
    {
