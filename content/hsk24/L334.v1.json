  "blocks": [
    {
      "id": "l334-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 份 fèn: phần; 送 sòng: giao; 分钟 fēnzhōng: phút; 愿意 yuànyì: sẵn lòng. Không dùng tính từ 热情 để suy ra khách đã đồng ý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l334-t0",
      "type": "teaching",
      "title": "方便面 · mì ăn liền",
      "text": "方便面 là tên loại thực phẩm; không dùng 方便 như bảo đảm tốt cho sức khỏe. Không gộp mọi loại mì vào tên này.",
      "hanzi": "今天我不吃方便面。",
      "pinyin": "Jīntiān wǒ bù chī fāngbiànmiàn.",
      "meaning": "Hôm nay tôi không ăn mì ăn liền.",
      "readingMinutes": 1
    },
    {
      "id": "l334-t1",
      "type": "teaching",
      "title": "外卖 · đồ ăn giao/đem đi",
      "text": "外卖 trong 叫外卖 là đồ ăn đặt giao; có thể dùng hành vi bán mang đi ở ngữ cảnh khác, bài chỉ dạy danh từ đồ ăn.",
      "hanzi": "我们叫了两份外卖。",
      "pinyin": "Wǒmen jiào le liǎng fèn wàimài.",
      "meaning": "Chúng tôi đặt hai phần đồ ăn giao.",
      "readingMinutes": 1
    },
    {
      "id": "l334-t2",
      "type": "teaching",
      "title": "服务 · phục vụ/dịch vụ",
      "text": "服务 có thể là hoạt động phục vụ hoặc danh từ chất lượng dịch vụ; 服务很好 là đánh giá, không phải món ăn.",
      "hanzi": "这家店的服务很好。",
      "pinyin": "Zhè jiā diàn de fúwù hěn hǎo.",
      "meaning": "Dịch vụ quán này rất tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l334-t3",
      "type": "teaching",
      "title": "请客 · mời đãi khách",
      "text": "请客 thường nêu đứng ra mời/đãi bữa; ai trả bao nhiêu cần ngữ cảnh. 我请客 là lời đề nghị đãi, chưa là biên nhận đã thanh toán.",
      "hanzi": "今天我请客。",
      "pinyin": "Jīntiān wǒ qǐng kè.",
      "meaning": "Hôm nay tôi đãi.",
      "readingMinutes": 1
    },
    {
      "id": "l334-t4",
      "type": "teaching",
      "title": "客人 · khách",
      "text": "客人 là người đến chơi hoặc khách được phục vụ; không tự cho biết quốc tịch/tuổi. 客人来了 chỉ khách đã đến.",
      "hanzi": "客人已经到家了。",
      "pinyin": "Kèrén yǐjīng dào jiā le.",
      "meaning": "Khách đã đến nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l334-t5",
      "type": "teaching",
      "title": "热情 · nhiệt tình/niềm nở",
      "text": "热情 mô tả thái độ niềm nở; khác 热 là nhiệt độ. 对客人很热情 nói cách đón tiếp.",
      "hanzi": "她对客人很热情。",
      "pinyin": "Tā duì kèrén hěn rèqíng.",
      "meaning": "Cô ấy rất niềm nở với khách.",
      "readingMinutes": 1
    },
    {
      "id": "l334-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "这家店的服务是很好的 nhấn mạnh đánh giá của người nói. 虽然…可是… có thể thêm mặt hạn chế; đánh giá tốt không đồng nghĩa mọi khách đều hài lòng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l334-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "客人到了。小林热情地说：今天我请客，不吃方便面了，叫外卖吧。小王：这家店的服务是很好的，可是现在送来要四十分钟。小林：那我们先问问客人愿不愿意等。",
      "pinyin": "Kèrén dào le. Xiǎo Lín rèqíng de shuō: Jīntiān wǒ qǐng kè, bù chī fāngbiànmiàn le, jiào wàimài ba. Xiǎo Wáng: Zhè jiā diàn de fúwù shì hěn hǎo de, kěshì xiànzài sòng lái yào sìshí fēnzhōng. Xiǎo Lín: Nà wǒmen xiān wènwen kèrén yuàn bu yuànyì děng.",
      "meaning": "Lâm đề nghị đãi khách bằng đồ giao. Vương đánh giá dịch vụ tốt nhưng phải chờ bốn mươi phút; họ sẽ hỏi khách có muốn chờ không.",
      "readingMinutes": 2
    },
    {
      "id": "l334-b0",
      "type": "exercise",
      "exerciseVersionId": "l334-v1-e0"
    },
    {
      "id": "l334-b1",
      "type": "exercise",
