  "blocks": [
    {
      "id": "l219-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "学生 là học sinh, 老师 là giáo viên. 一位/一名 đều đếm người trong ngữ cảnh phù hợp; không suy ra dùng được cho mọi đồ vật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l219-t0",
      "type": "teaching",
      "title": "班 · lớp, tập thể học sinh",
      "text": "Trong 我们班, 班 là danh từ lớp học. Không dạy nghĩa lượng từ cho chuyến xe thuộc cấp cao hơn.",
      "hanzi": "我们班有二十名学生。",
      "pinyin": "Wǒmen bān yǒu èrshí míng xuésheng.",
      "meaning": "Lớp chúng tôi có hai mươi học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l219-t1",
      "type": "teaching",
      "title": "高中 · trung học phổ thông",
      "text": "高中 là cấp trung học phổ thông; không phải mọi trường có tòa nhà cao. Không gán tuổi chính xác nếu câu không nêu.",
      "hanzi": "我姐姐在高中学习。",
      "pinyin": "Wǒ jiějie zài gāozhōng xuéxí.",
      "meaning": "Chị tôi học trung học phổ thông.",
      "readingMinutes": 1
    },
    {
      "id": "l219-t2",
      "type": "teaching",
      "title": "开学 · bắt đầu kỳ học, khai giảng",
      "text": "开学 nói trường bắt đầu kỳ học, khác 开始 một hoạt động bất kỳ.",
      "hanzi": "我们学校明天开学。",
      "pinyin": "Wǒmen xuéxiào míngtiān kāixué.",
      "meaning": "Trường chúng tôi bắt đầu kỳ học ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l219-t3",
      "type": "teaching",
      "title": "考 · thi, kiểm tra trong việc học",
      "text": "考 trong câu này nói dự thi môn học. Không tự mở rộng sang nghĩa khảo cứu khác.",
      "hanzi": "我们明天考中文。",
      "pinyin": "Wǒmen míngtiān kǎo Zhōngwén.",
      "meaning": "Ngày mai chúng tôi thi tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l219-t4",
      "type": "teaching",
      "title": "名 · lượng từ đếm người trong thông tin",
      "text": "Bài luyện 名 trong 两名学生. Nghĩa danh từ tên cũng có trong mục từ nhưng chưa phải đáp án của ngữ cảnh này.",
      "hanzi": "两名学生在教室里。",
      "pinyin": "Liǎng míng xuésheng zài jiàoshì li.",
      "meaning": "Hai học sinh đang ở trong lớp.",
      "readingMinutes": 1
    },
    {
      "id": "l219-t5",
      "type": "teaching",
      "title": "位 · lượng từ lịch sự cho người",
      "text": "位 dùng cho người: 一位老师. Không nhầm vị trí ‘chỗ ngồi’ trong từ ghép khác.",
      "hanzi": "这位老师教我们中文。",
      "pinyin": "Zhè wèi lǎoshī jiāo wǒmen Zhōngwén.",
      "meaning": "Giáo viên này dạy chúng tôi tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l219-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "位 là lượng từ lịch sự cho người; 名 dùng trong thông tin số người: 一名学生、两位老师. Không dùng 位 để đếm lớp hoặc môn thi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l219-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "我们高中明天开学。我们班有二十名学生，两位老师教我们中文。老师说：星期五考中文，今天一起看书吧。",
      "pinyin": "Wǒmen gāozhōng míngtiān kāixué. Wǒmen bān yǒu èrshí míng xuésheng, liǎng wèi lǎoshī jiāo wǒmen Zhōngwén. Lǎoshī shuō: Xīngqīwǔ kǎo Zhōngwén, jīntiān yìqǐ kàn shū ba.",
      "meaning": "Trường phổ thông của chúng tôi khai giảng ngày mai. Lớp có hai mươi học sinh, hai giáo viên dạy tiếng Trung. Giáo viên nói: Thứ sáu thi tiếng Trung, hôm nay cùng đọc sách nhé.",
      "readingMinutes": 2
    },
