  "blocks": [
    {
      "id": "l49007-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder0",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder1",
      "type": "teaching",
      "title": "理发 · cắt tóc",
      "text": "理发 nói việc cắt/sửa tóc, khác chải tóc.",
      "hanzi": "我周末去理发。",
      "pinyin": "Wǒ zhōu mò qù lǐ fà.",
      "meaning": "Cuối tuần tôi đi cắt tóc.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder2",
      "type": "teaching",
      "title": "眼镜 · kính đeo mắt",
      "text": "眼镜 là kính đeo, dùng lượng từ 副.",
      "hanzi": "他的眼镜放在桌上。",
      "pinyin": "Tā de yǎn jìng fàng zài zhuō shàng.",
      "meaning": "Kính của anh ấy ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder3",
      "type": "teaching",
      "title": "牙膏 · kem đánh răng",
      "text": "牙膏 khác 牙刷 là bàn chải. Nhận diện chữ 膏 trong 牙膏; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "牙膏放在杯子旁边。",
      "pinyin": "Yá gāo fàng zài bēi zi páng biān.",
      "meaning": "Kem đánh răng ở cạnh cốc.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder4",
      "type": "teaching",
      "title": "纸巾 · khăn giấy",
      "text": "纸巾 là giấy dùng lau, không phải khăn vải.",
      "hanzi": "请给我一张纸巾。",
      "pinyin": "Qǐng gěi wǒ yì zhāng zhǐ jīn.",
      "meaning": "Cho tôi một tờ khăn giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder5",
      "type": "teaching",
      "title": "脱 · cởi; tháo",
      "text": "脱 thường dùng với quần áo/giày, không dùng thay 拿 cho mọi đồ.",
      "hanzi": "进屋后，他脱了外套。",
      "pinyin": "Jìn wū hòu, tā tuō le wài tào.",
      "meaning": "Vào phòng anh ấy cởi áo khoác.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder6",
      "type": "teaching",
      "title": "身 · lượng từ bộ quần áo mặc trên người",
      "text": "身 trong 一身衣服 chỉ cả bộ mặc trên người.",
      "hanzi": "他穿了一身新衣服。",
      "pinyin": "Tā chuān le yì shēn xīn yī fu.",
      "meaning": "Anh ấy mặc một bộ quần áo mới.",
      "readingMinutes": 1
    },
    {
      "id": "l49007-reminder7",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把眼镜擦一擦 nêu đồ vật được tác động trước động từ lặp, nghĩa lau kính một lượt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l49007-reminder8",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小明理发后回家，先脱外套，再找眼镜。桌上放着牙膏和纸巾。他把眼镜擦一擦，换了一身干净衣服，准备去见朋友。",
      "pinyin": "Xiǎo Míng lǐ fà hòu huí jiā, xiān tuō wài tào, zài zhǎo yǎn jìng. Zhuō shàng fàng zhe yá gāo hé zhǐ jīn. Tā bǎ yǎn jìng cā yi cā, huàn le yì shēn gān jìng yī fu, zhǔn bèi qù jiàn péng you.",
      "meaning": "Tiểu Minh về sau khi cắt tóc, lau kính và thay quần áo.",
      "readingMinutes": 2
    },
    {
