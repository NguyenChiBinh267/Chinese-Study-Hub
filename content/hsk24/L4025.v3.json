  "blocks": [
    {
      "id": "l4025-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t0",
      "type": "teaching",
      "title": "不必 · không cần phải",
      "text": "不必 phủ định sự cần thiết, không phải cấm làm.",
      "hanzi": "你不必再跑一趟。",
      "pinyin": "Nǐ bú bì zài pǎo yí tàng.",
      "meaning": "Bạn không cần đi thêm một chuyến.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t1",
      "type": "teaching",
      "title": "客气 · khách sáo",
      "text": "客气 ở 别客气 nhắc người kia cứ tự nhiên.",
      "hanzi": "我们是朋友，别客气。",
      "pinyin": "Wǒ men shì péng you, bié kè qi.",
      "meaning": "Chúng ta là bạn, đừng khách sáo.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t2",
      "type": "teaching",
      "title": "礼貌 · lễ phép; lịch sự",
      "text": "礼貌 nói cách ứng xử tôn trọng người khác.",
      "hanzi": "问路时要有礼貌。",
      "pinyin": "Wèn lù shí yào yǒu lǐ mào.",
      "meaning": "Khi hỏi đường cần lịch sự.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t3",
      "type": "teaching",
      "title": "麻烦 · làm phiền; phiền phức",
      "text": "麻烦你… là cách nhờ giúp, không phải trách người nghe. Nhận diện chữ 麻 trong 麻烦; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "麻烦你帮我看一下。",
      "pinyin": "Má fan nǐ bāng wǒ kàn yí xià.",
      "meaning": "Phiền bạn xem giúp tôi một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t4",
      "type": "teaching",
      "title": "耐心 · kiên nhẫn",
      "text": "耐心 có thể làm danh từ; 有耐心 là có tính kiên nhẫn.",
      "hanzi": "她很有耐心，解释了两遍。",
      "pinyin": "Tā hěn yǒu nài xīn, jiě shì le liǎng biàn.",
      "meaning": "Cô ấy kiên nhẫn, giải thích hai lần.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-t5",
      "type": "teaching",
      "title": "嗯 · ừ; vâng",
      "text": "嗯 ở đây đáp lại lời đề nghị; đọc ǹg theo mục nguồn.",
      "hanzi": "嗯，我明白了。",
      "pinyin": "Ǹg, wǒ míng bai le.",
      "meaning": "Vâng, tôi hiểu rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l4025-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "嗯 là thán từ đáp lời; nguồn từ vựng ghi ǹg. Trong tình huống này nó thể hiện đã nghe và đồng ý. Sắc thái còn phụ thuộc ngữ điệu; bài chữ không kiểm tra nghe/nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4025-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小方有礼貌地说：“麻烦你帮我看一下表格。”同事很有耐心：“你不必再跑一趟，我现在帮你看。”小方道谢，同事笑着说：“别客气！”小方回答：“嗯，我明白了。”",
      "pinyin": "Xiǎo Fāng yǒu lǐ mào de shuō: “Má fan nǐ bāng wǒ kàn yí xià biǎo gé.” Tóng shì hěn yǒu nài xīn: “Nǐ bú bì zài pǎo yí tàng, wǒ xiàn zài bāng nǐ kàn.” Xiǎo Fāng dào xiè, tóng shì xiào zhe shuō: “Bié kè qi!” Xiǎo Fāng huí dá: “Ǹg, wǒ míng bai le.”",
      "meaning": "Đồng nghiệp xem giúp biểu mẫu ngay, Tiểu Phương không cần đi thêm chuyến nữa.",
      "readingMinutes": 2
    },
