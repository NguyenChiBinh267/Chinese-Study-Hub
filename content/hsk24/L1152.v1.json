  "blocks": [
    {
      "id": "l1152-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder0",
      "type": "teaching",
      "title": "喝 · uống",
      "text": "Từ đã học 喝 có 1 chữ. Chữ 喝 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 喝 với 渴 / 唱 / 问; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：我喜欢茶。你呢？\nB：我喜欢喝茶。",
      "pinyin": "A: wǒ xǐ huan chá. nǐ ne?\nB: wǒ xǐ huan hē chá.",
      "meaning": "A: Tôi thích trà. Còn bạn?\nB: Tôi thích uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder1",
      "type": "teaching",
      "title": "茶 · trà",
      "text": "Từ đã học 茶 có 1 chữ. Chữ 茶 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 茶 với 菜 / 余 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：我喜欢茶。你呢？\nB：我喜欢喝茶。",
      "pinyin": "A: wǒ xǐ huan chá. nǐ ne?\nB: wǒ xǐ huan hē chá.",
      "meaning": "A: Tôi thích trà. Còn bạn?\nB: Tôi thích uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder2",
      "type": "teaching",
      "title": "喜欢 · thích",
      "text": "Từ đã học 喜欢 có 2 chữ. Chữ 欢 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 欢 với 欠 / 观 / 权; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "A：我喜欢茶。你呢？\nB：我喜欢喝茶。",
      "pinyin": "A: wǒ xǐ huan chá. nǐ ne?\nB: wǒ xǐ huan hē chá.",
      "meaning": "A: Tôi thích trà. Còn bạn?\nB: Tôi thích uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder3",
      "type": "teaching",
      "title": "不 · không",
      "text": "Từ đã học 不 có 1 chữ. Chữ 不 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 不 với 下 / 卜 / 木; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我不是安。",
      "pinyin": "Wǒ bú shì Ān.",
      "meaning": "Tôi không phải An.",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder4",
      "type": "teaching",
      "title": "也 · cũng",
      "text": "Từ đã học 也 có 1 chữ. Chữ 也 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 也 với 池 / 地 / 他; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我也喜欢茶。",
      "pinyin": "Wǒ yě xǐ huan chá.",
      "meaning": "Tôi cũng thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reminder5",
      "type": "teaching",
      "title": "吗 · không; à (cuối câu hỏi)",
      "text": "Từ đã học 吗 có 1 chữ. Chữ 吗 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 吗 với 妈 / 蚂 / 码; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你是安吗？",
      "pinyin": "Nǐ shì Ān ma?",
      "meaning": "Bạn là An phải không?",
      "readingMinutes": 1
    },
    {
      "id": "l1152-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你想喝什么？\nB：我想喝茶。\nA：请喝茶。\nB：谢谢。",
