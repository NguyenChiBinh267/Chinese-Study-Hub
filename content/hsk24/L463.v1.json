  "blocks": [
    {
      "id": "l463-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 结论 jiélùn: kết luận; 词义 cíyì: nghĩa từ. Bài chỉ chấm câu trả lời có giới hạn, chưa chấm giải thích tự do.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l463-t0",
      "type": "teaching",
      "title": "肯定 · chắc chắn; khẳng định",
      "text": "肯定 trong 我不肯定 biểu thị mức chắc của người nói, chưa phải sự thật được xác nhận.",
      "hanzi": "我不肯定自己理解得对不对。",
      "pinyin": "Wǒ bù kěndìng zìjǐ lǐjiě de duì bu duì.",
      "meaning": "Tôi chưa chắc mình hiểu đúng không.",
      "readingMinutes": 1
    },
    {
      "id": "l463-t1",
      "type": "teaching",
      "title": "理解 · hiểu",
      "text": "理解 là nắm ý/nguyên lý, khác chỉ nghe thấy hoặc nhớ âm.",
      "hanzi": "请先理解这句话。",
      "pinyin": "Qǐng xiān lǐjiě zhè jù huà.",
      "meaning": "Hãy hiểu câu này trước.",
      "readingMinutes": 1
    },
    {
      "id": "l463-t2",
      "type": "teaching",
      "title": "例如 · ví dụ như",
      "text": "例如 mở ví dụ cụ thể, thường đứng trước phần liệt kê/giải thích.",
      "hanzi": "有些方法很简单，例如每天读一页。",
      "pinyin": "Yǒuxiē fāngfǎ hěn jiǎndān, lìrú měi tiān dú yí yè.",
      "meaning": "Có cách rất đơn giản, như mỗi ngày đọc một trang.",
      "readingMinutes": 1
    },
    {
      "id": "l463-t3",
      "type": "teaching",
      "title": "例子 · ví dụ",
      "text": "例子 là danh từ, dùng 举一个例子; không dùng như liên từ 例如.",
      "hanzi": "请举一个生活中的例子。",
      "pinyin": "Qǐng jǔ yí ge shēnghuó zhōng de lìzi.",
      "meaning": "Hãy nêu ví dụ trong đời sống.",
      "readingMinutes": 1
    },
    {
      "id": "l463-t4",
      "type": "teaching",
      "title": "究竟 · rốt cuộc",
      "text": "究竟 đánh dấu câu hỏi truy tìm rõ, như 究竟是什么意思; không mặc định giọng gây hấn. Nhận diện chữ 竟 trong 究竟; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个词究竟是什么意思？",
      "pinyin": "Zhè ge cí jiūjìng shì shénme yìsi?",
      "meaning": "Từ này rốt cuộc nghĩa là gì?",
      "readingMinutes": 1
    },
    {
      "id": "l463-t5",
      "type": "teaching",
      "title": "竟然 · không ngờ lại",
      "text": "竟然 nêu điều trái dự kiến đã được nhận thấy; khác 也许 là chưa chắc.",
      "hanzi": "他竟然把两个例子看成同一个。",
      "pinyin": "Tā jìngrán bǎ liǎng ge lìzi kàn chéng tóng yí ge.",
      "meaning": "Không ngờ anh ấy coi hai ví dụ là một.",
      "readingMinutes": 1
    },
    {
      "id": "l463-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "就是说 diễn giải lại ý trước bằng cách khác: 答案要有例子，就是说，不能只写结论. Vế sau cần giữ nghĩa, không đổi thành một điều kiện mới. Bài dùng để làm rõ yêu cầu học tập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l463-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小钟不肯定自己理解了要求，问老师：“答案究竟要写什么？”老师说：“要有例子，就是说，不能只写结论。例如，谈节约时，可以说自己怎样减少浪费。”小钟才发现，自己竟然把“解释词义”和“举例”看成同一件事。",
      "pinyin": "Xiǎo Zhōng bù kěndìng zìjǐ lǐjiě le yāoqiú, wèn lǎoshī: “Dáàn jiūjìng yào xiě shénme?” Lǎoshī shuō: “Yào yǒu lìzi, jiùshìshuō, bù néng zhǐ xiě jiélùn. Lìrú, tán jiéyuē shí, kěyǐ shuō zìjǐ zěnyàng jiǎnshǎo làngfèi.” Xiǎo Zhōng cái fāxiàn, zìjǐ jìngrán bǎ “jiěshì cíyì” hé “jǔlì” kàn chéng tóng yí jiàn shì.",
      "meaning": "Chung hỏi yêu cầu câu trả lời. Thầy giải thích cần ví dụ, không chỉ kết luận. Chung nhận ra đã nhầm giải nghĩa với nêu ví dụ.",
      "readingMinutes": 2
    },
    {
