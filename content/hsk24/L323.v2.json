  "blocks": [
    {
      "id": "l323-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 道 dào: lượng từ câu/bài; 部分 bùfen: phần; 步 bù: bước; 解释 jiěshì: giải thích.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l323-t0",
      "type": "teaching",
      "title": "帮助 · giúp đỡ/sự giúp đỡ",
      "text": "帮助 có thể là động từ hoặc danh từ; 谢谢你的帮助 là cảm ơn sự giúp đỡ, 帮助我 là giúp tôi.",
      "hanzi": "谢谢你的帮助。",
      "pinyin": "Xièxie nǐ de bāngzhù.",
      "meaning": "Cảm ơn sự giúp đỡ của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l323-t1",
      "type": "teaching",
      "title": "办法 · cách làm/biện pháp",
      "text": "办法 là cách xử lý một việc; 想办法 là tìm cách, chưa khẳng định cách đó hữu hiệu.",
      "hanzi": "我们一起想办法。",
      "pinyin": "Wǒmen yìqǐ xiǎng bànfǎ.",
      "meaning": "Chúng ta cùng tìm cách.",
      "readingMinutes": 1
    },
    {
      "id": "l323-t2",
      "type": "teaching",
      "title": "难题 · bài toán/vấn đề khó",
      "text": "难题 là danh từ chỉ vấn đề khó, khác 难 là tính từ khó; 一个难题 đếm một vấn đề.",
      "hanzi": "这道题是个难题。",
      "pinyin": "Zhè dào tí shì ge nántí.",
      "meaning": "Câu này là một bài khó.",
      "readingMinutes": 1
    },
    {
      "id": "l323-t3",
      "type": "teaching",
      "title": "难 · khó",
      "text": "难 trong bài đánh giá độ khó thực hiện; 很难 chứ không dùng 很难题. Không đánh đồng chưa làm được với không thể học.",
      "hanzi": "这道题对我来说很难。",
      "pinyin": "Zhè dào tí duì wǒ lái shuō hěn nán.",
      "meaning": "Bài này khó đối với tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l323-t4",
      "type": "teaching",
      "title": "容易 · dễ",
      "text": "容易 nói dễ thực hiện hoặc dễ xảy ra tùy ngữ cảnh; 很容易 là đánh giá của người nói, không bảo đảm ai cũng làm được.",
      "hanzi": "这道题比较容易。",
      "pinyin": "Zhè dào tí bǐjiào róngyì.",
      "meaning": "Bài này tương đối dễ.",
      "readingMinutes": 1
    },
    {
      "id": "l323-t5",
      "type": "teaching",
      "title": "明白 · hiểu/rõ",
      "text": "明白 thường có thể làm động từ “hiểu” hoặc tính từ “rõ”; 我明白了 nêu đã hiểu điều vừa giải thích, không phải đã thuộc tất cả.",
      "hanzi": "听了你的解释，我明白了。",
      "pinyin": "Tīng le nǐ de jiěshì, wǒ míngbai le.",
      "meaning": "Nghe bạn giải thích, tôi đã hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l323-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "看得懂 là có khả năng hiểu khi đọc; 看不懂 là không hiểu được. 得 ở giữa động từ và bổ ngữ đọc de, khác 得 dé “đạt được” và děi “phải”. Chỉ luyện 看得懂/看不懂.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l323-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：这个难题我看不懂。小王：我帮助你，先看容易的部分，再一起想办法。小林：现在我明白这一步了，可是最后一步还很难。小王：我们再问老师。",
      "pinyin": "Xiǎo Lín: Zhège nántí wǒ kàn bu dǒng. Xiǎo Wáng: Wǒ bāngzhù nǐ, xiān kàn róngyì de bùfen, zài yìqǐ xiǎng bànfǎ. Xiǎo Lín: Xiànzài wǒ míngbai zhè yí bù le, kěshì zuìhòu yí bù hái hěn nán. Xiǎo Wáng: Wǒmen zài wèn lǎoshī.",
      "meaning": "Lâm không hiểu bài khó. Vương giúp xem phần dễ trước; Lâm mới hiểu một bước, bước cuối vẫn khó nên sẽ hỏi thầy.",
      "readingMinutes": 2
    },
