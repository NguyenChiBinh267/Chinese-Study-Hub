  "blocks": [
    {
      "id": "l4032-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t0",
      "type": "teaching",
      "title": "责任 · trách nhiệm",
      "text": "责任 là phần việc/nghĩa vụ cần đảm nhận, không chỉ quyền lợi.",
      "hanzi": "他认真履行自己的责任。",
      "pinyin": "Tā rèn zhēn lǚ xíng zì jǐ de zé rèn.",
      "meaning": "Anh ấy nghiêm túc thực hiện trách nhiệm.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t1",
      "type": "teaching",
      "title": "招聘 · tuyển dụng",
      "text": "招聘 là phía đơn vị tìm người, khác 应聘 là ứng viên xin việc. Nhận diện chữ 聘 trong 招聘; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "学院正在招聘教师。",
      "pinyin": "Xué yuàn zhèng zài zhāo pìn jiào shī.",
      "meaning": "Học viện đang tuyển giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t2",
      "type": "teaching",
      "title": "应聘 · ứng tuyển",
      "text": "应聘 nói người tham gia xin một vị trí.",
      "hanzi": "她想应聘这个岗位。",
      "pinyin": "Tā xiǎng yìng pìn zhè ge gǎng wèi.",
      "meaning": "Cô ấy muốn ứng tuyển vị trí này.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t3",
      "type": "teaching",
      "title": "职业 · nghề nghiệp",
      "text": "职业 chỉ nghề/công việc, không phải chuyên ngành học.",
      "hanzi": "她正在考虑未来的职业。",
      "pinyin": "Tā zhèng zài kǎo lǜ wèi lái de zhí yè.",
      "meaning": "Cô ấy đang cân nhắc nghề nghiệp tương lai.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t4",
      "type": "teaching",
      "title": "专业 · chuyên ngành; chuyên môn",
      "text": "专业 ở đây là lĩnh vực đào tạo/chuyên môn.",
      "hanzi": "我的专业是语言教学。",
      "pinyin": "Wǒ de zhuān yè shì yǔ yán jiào xué.",
      "meaning": "Chuyên ngành của tôi là dạy ngôn ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-t5",
      "type": "teaching",
      "title": "院长 · viện trưởng; hiệu trưởng học viện",
      "text": "院长 là người đứng đầu một 学院/机构 phù hợp ngữ cảnh.",
      "hanzi": "院长介绍了学院的情况。",
      "pinyin": "Yuàn zhǎng jiè shào le xué yuàn de qíng kuàng.",
      "meaning": "Viện trưởng giới thiệu tình hình học viện.",
      "readingMinutes": 1
    },
    {
      "id": "l4032-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung một yêu cầu bên cạnh yêu cầu đã nêu, hai vế cùng hướng. Không dùng để biểu thị chọn một trong hai.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4032-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "故事里的学院招聘教师，小安准备应聘。她向院长询问工作责任和职业发展。院长说：“这个岗位不仅需要专业知识，还需要耐心。”小安决定先读清招聘说明，再提交材料。",
      "pinyin": "Gù shi lǐ de xué yuàn zhāo pìn jiào shī, Xiǎo Ān zhǔn bèi yìng pìn. Tā xiàng yuàn zhǎng xún wèn gōng zuò zé rèn hé zhí yè fā zhǎn. Yuàn zhǎng shuō: “Zhè ge gǎng wèi bù jǐn xū yào zhuān yè zhī shi, hái xū yào nài xīn.” Xiǎo Ān jué dìng xiān dú qīng zhāo pìn shuō míng, zài tí jiāo cái liào.",
      "meaning": "Tiểu An hỏi rõ trách nhiệm và yêu cầu trước khi ứng tuyển ở học viện hư cấu.",
      "readingMinutes": 2
    },
