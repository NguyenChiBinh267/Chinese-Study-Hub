  "blocks": [
    {
      "id": "l370-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 俩 liǎ: hai người; 匹 pǐ: lượng từ ngựa; 参观 cānguān: tham quan; 包括 bāokuò: bao gồm. Không có thao tác cưỡi/chăm ngựa thực trong bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l370-t0",
      "type": "teaching",
      "title": "姐妹 · chị em gái",
      "text": "姐妹 nói quan hệ giữa chị/em gái; không tự nói là sinh đôi. 她们是姐妹 xác định quan hệ, không phải 夫妻.",
      "hanzi": "她们是姐妹，一起工作。",
      "pinyin": "Tāmen shì jiěmèi, yìqǐ gōngzuò.",
      "meaning": "Họ là chị em gái, cùng làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l370-t1",
      "type": "teaching",
      "title": "马 · ngựa",
      "text": "马 là ngựa, 一匹马 dùng 匹; không gọi mọi thú nuôi bằng 马. 骑马 là cưỡi ngựa, chưa là bài huấn luyện.",
      "hanzi": "农场里有两匹马。",
      "pinyin": "Nóngchǎng lǐ yǒu liǎng pǐ mǎ.",
      "meaning": "Nông trại có hai con ngựa.",
      "readingMinutes": 1
    },
    {
      "id": "l370-t2",
      "type": "teaching",
      "title": "养 · nuôi/trồng tùy đối tượng",
      "text": "养 trong 养马 là nuôi ngựa; không đồng nghĩa cho ăn một lần. Bài không dạy kỹ thuật chăm động vật.",
      "hanzi": "姐妹俩在农场养马。",
      "pinyin": "Jiěmèi liǎ zài nóngchǎng yǎng mǎ.",
      "meaning": "Hai chị em nuôi ngựa ở nông trại.",
      "readingMinutes": 1
    },
    {
      "id": "l370-t3",
      "type": "teaching",
      "title": "生活 · cuộc sống/sống",
      "text": "生活 là danh từ cuộc sống hoặc động từ sống; 农场生活 nói đời sống nông trại, 生活在这里 là sống ở đây.",
      "hanzi": "她们喜欢农场的生活。",
      "pinyin": "Tāmen xǐhuan nóngchǎng de shēnghuó.",
      "meaning": "Họ thích cuộc sống nông trại.",
      "readingMinutes": 1
    },
    {
      "id": "l370-t4",
      "type": "teaching",
      "title": "咱们 · chúng ta (gồm người nghe)",
      "text": "咱们 thường bao gồm người nghe trong ngữ cảnh rủ cùng làm; không dịch “chúng tôi” loại người nghe trong lời này.",
      "hanzi": "咱们一起去看马吧。",
      "pinyin": "Zánmen yìqǐ qù kàn mǎ ba.",
      "meaning": "Chúng ta cùng đi xem ngựa nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l370-t5",
      "type": "teaching",
      "title": "游客 · du khách/khách tham quan",
      "text": "游客 là người đến tham quan/du lịch, không phải mọi 客人 là du khách. 游客可来自本地或外地.",
      "hanzi": "今天有游客来农场。",
      "pinyin": "Jīntiān yǒu yóukè lái nóngchǎng.",
      "meaning": "Hôm nay có du khách đến nông trại.",
      "readingMinutes": 1
    },
    {
      "id": "l370-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "咱们 trong lời hướng dẫn rủ khách cùng đi, gồm người nói và người nghe. 姐妹 là quan hệ chị em gái, không tự nói ai là chị nếu chưa nêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l370-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "姐妹俩在农场养马，喜欢这里的生活。今天游客来了，姐姐说：咱们一起去看马吧。她先介绍自己的工作经历，再说参观要求。游客只是来看，不因此就能自己骑马。",
      "pinyin": "Jiěmèi liǎ zài nóngchǎng yǎng mǎ, xǐhuan zhèlǐ de shēnghuó. Jīntiān yóukè lái le, jiějie shuō: Zánmen yìqǐ qù kàn mǎ ba. Tā xiān jièshào zìjǐ de gōngzuò jīnglì, zài shuō cānguān yāoqiú. Yóukè zhǐ shì lái kàn, bù yīncǐ jiù néng zìjǐ qí mǎ.",
      "meaning": "Hai chị em nuôi ngựa, đón khách và giới thiệu kinh nghiệm làm việc cùng yêu cầu tham quan. Lời rủ gồm cả khách, nhưng tham quan chưa có nghĩa tự được cưỡi.",
      "readingMinutes": 2
    },
    {
