  "blocks": [
    {
      "id": "l314-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc thời gian, chủ ngữ–động từ–tân ngữ, 的 và câu hỏi cơ bản. HSK1/2 prerequisite vẫn chưa được xác nhận. 接到 jiē dào: nhận được; 见面 jiànmiàn: gặp mặt; 从…起: từ lúc…trở đi. Các mốc của chuyện là hư cấu, không phải lịch hẹn thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l314-t0",
      "type": "teaching",
      "title": "刚 · vừa mới",
      "text": "刚 đứng trước động từ như 刚到. Không thay trực tiếp mọi vị trí danh từ thời gian của 刚才; 刚以后 không dùng trong mẫu đang học.",
      "hanzi": "我刚到家。",
      "pinyin": "Wǒ gāng dào jiā.",
      "meaning": "Tôi vừa về tới nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l314-t1",
      "type": "teaching",
      "title": "刚才 · lúc nãy",
      "text": "刚才 chỉ thời gian vừa qua; có thể ở đầu câu. 刚才有人找你 kể có người tìm lúc nãy, không phải sắp tìm.",
      "hanzi": "刚才有人给你打电话。",
      "pinyin": "Gāngcái yǒu rén gěi nǐ dǎ diànhuà.",
      "meaning": "Lúc nãy có người gọi bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l314-t2",
      "type": "teaching",
      "title": "一直 · suốt/liên tục",
      "text": "一直 nêu sự kéo dài hoặc không gián đoạn theo khoảng đang nói. 一直等 nêu chờ suốt; không tự đưa số phút chính xác.",
      "hanzi": "从早上起，我一直在等电话。",
      "pinyin": "Cóng zǎoshang qǐ, wǒ yìzhí zài děng diànhuà.",
      "meaning": "Từ sáng tôi chờ điện thoại suốt.",
      "readingMinutes": 1
    },
    {
      "id": "l314-t3",
      "type": "teaching",
      "title": "马上 · ngay/sắp ngay",
      "text": "马上 diễn tả hành động sắp làm rất gần theo lời nói. Không dùng để chứng minh việc đã hoàn tất hoặc hứa độ trễ chính xác.",
      "hanzi": "我马上给他打电话。",
      "pinyin": "Wǒ mǎshàng gěi tā dǎ diànhuà.",
      "meaning": "Tôi sẽ gọi anh ấy ngay.",
      "readingMinutes": 1
    },
    {
      "id": "l314-t4",
      "type": "teaching",
      "title": "后来 · sau đó/về sau",
      "text": "后来 dùng kể diễn biến sau một mốc đã qua. Không dùng như lời hẹn tương lai theo mẫu 明天后来.",
      "hanzi": "我先去车站，后来又回家了。",
      "pinyin": "Wǒ xiān qù chēzhàn, hòulái yòu huí jiā le.",
      "meaning": "Tôi đi ga trước, sau đó lại về nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l314-t5",
      "type": "teaching",
      "title": "终于 · cuối cùng cũng",
      "text": "终于 nêu kết thúc sau chờ đợi hoặc cố gắng theo ngữ cảnh, thường có sắc thái mong đợi. 不只是排列最后一项; không chỉ liệt kê mục cuối.",
      "hanzi": "等了很久，我终于接到电话了。",
      "pinyin": "Děng le hěn jiǔ, wǒ zhōngyú jiē dào diànhuà le.",
      "meaning": "Chờ lâu rồi cuối cùng tôi cũng nhận được cuộc gọi.",
      "readingMinutes": 1
    },
    {
      "id": "l314-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "从早上起 xác định mốc bắt đầu. 一直 nêu khoảng liên tục từ mốc đó. 刚 là phó từ trước động từ; 刚才 là danh từ thời gian có thể làm chủ đề. 马上 hướng tới việc sắp làm; 后来 kể tiếp chuyện đã qua; 终于 nhấn kết thúc sau chờ đợi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l314-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：从早上起，我一直在等电话。小李：刚才有人找你，你不在。小安：我刚回来，马上给他打电话。后来，小安终于接到了朋友的电话，知道明天在哪儿见面。",
      "pinyin": "Xiǎo Ān: Cóng zǎoshang qǐ, wǒ yìzhí zài děng diànhuà. Xiǎo Lǐ: Gāngcái yǒu rén zhǎo nǐ, nǐ bú zài. Xiǎo Ān: Wǒ gāng huílái, mǎshàng gěi tā dǎ diànhuà. Hòulái, Xiǎo Ān zhōngyú jiē dào le péngyou de diànhuà, zhīdào míngtiān zài nǎr jiànmiàn.",
      "meaning": "An chờ điện thoại từ sáng. Lý nói lúc nãy có người tìm khi An vắng. An vừa về và sẽ gọi ngay. Về sau An cuối cùng nhận cuộc gọi của bạn và biết chỗ gặp ngày mai.",
      "readingMinutes": 2
    },
