  "blocks": [
    {
      "id": "l449-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 独自 dúzì: một mình; 前台 qiántái: lễ tân; 确认 quèrèn: xác nhận. Nhận diện chữ 确 trong 确认 què rèn (xác nhận); 确 có bộ 石 bên trái, khác 却、角、解. Đây là chữ hỗ trợ gắn trực tiếp danh sách HSK4.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l449-t0",
      "type": "teaching",
      "title": "假日 · ngày nghỉ",
      "text": "假日 là ngày nghỉ nói chung; có thể không phải kỳ nghỉ dài. Nhận diện chữ 假 trong 假日; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "假日旅馆里人很多。",
      "pinyin": "Jiàrì lǚguǎn lǐ rén hěn duō.",
      "meaning": "Ngày nghỉ nhà nghỉ đông khách.",
      "readingMinutes": 1
    },
    {
      "id": "l449-t1",
      "type": "teaching",
      "title": "节假日 · ngày lễ và ngày nghỉ",
      "text": "节假日 gộp ngày lễ và ngày nghỉ, dùng trong thông báo lịch.",
      "hanzi": "节假日的车票要提前订。",
      "pinyin": "Jiéjiàrì de chēpiào yào tíqián dìng.",
      "meaning": "Vé xe ngày lễ/nghỉ cần đặt sớm.",
      "readingMinutes": 1
    },
    {
      "id": "l449-t2",
      "type": "teaching",
      "title": "旅行 · du lịch, đi xa",
      "text": "旅行 nhấn mạnh chuyến đi, khác 度假 nhấn mạnh kỳ nghỉ.",
      "hanzi": "这次旅行要三天。",
      "pinyin": "Zhè cì lǚxíng yào sān tiān.",
      "meaning": "Chuyến đi này kéo dài ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l449-t3",
      "type": "teaching",
      "title": "旅客 · hành khách, khách lữ hành",
      "text": "旅客 chỉ người đang đi xa/lưu trú khi đi, khác 乘客 tập trung việc đi phương tiện.",
      "hanzi": "旅客可以在这里问路。",
      "pinyin": "Lǚkè kěyǐ zài zhèlǐ wèn lù.",
      "meaning": "Du khách có thể hỏi đường ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l449-t4",
      "type": "teaching",
      "title": "旅馆 · nhà nghỉ, khách sạn nhỏ",
      "text": "旅馆 là cơ sở lưu trú; từ này không bảo đảm hạng sao hay chất lượng.",
      "hanzi": "我们订了一家小旅馆。",
      "pinyin": "Wǒmen dìng le yì jiā xiǎo lǚguǎn.",
      "meaning": "Chúng tôi đặt một nhà nghỉ nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l449-t5",
      "type": "teaching",
      "title": "目的地 · điểm đến",
      "text": "目的地 là nơi muốn tới, không phải mục tiêu trừu tượng 目标.",
      "hanzi": "目的地离车站很近。",
      "pinyin": "Mùdìdì lí chēzhàn hěn jìn.",
      "meaning": "Điểm đến ở gần ga.",
      "readingMinutes": 1
    },
    {
      "id": "l449-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对于 + đối tượng được bàn đến đứng ở đầu câu hoặc trước nhận xét: 对于第一次旅行的旅客，交通方便很重要. Không dùng 对于 thay cho 给 để chỉ người nhận đồ vật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l449-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "节假日快到了，小宋准备第一次独自旅行。她的目的地是一座小城，先看地图，再订车站旁的小旅馆。前台说假日旅客多，最好提前确认。对于第一次旅行的旅客，交通方便比房间里的电视更重要，她同意这个建议。",
      "pinyin": "Jiéjiàrì kuài dào le, Xiǎo Sòng zhǔnbèi dì yī cì dúzì lǚxíng. Tā de mùdìdì shì yí zuò xiǎo chéng, xiān kàn dìtú, zài dìng chēzhàn páng de xiǎo lǚguǎn. Qiántái shuō jiàrì lǚkè duō, zuìhǎo tíqián quèrèn. Duìyú dì yī cì lǚxíng de lǚkè, jiāotōng fāngbiàn bǐ fángjiān lǐ de diànshì gèng zhòngyào, tā tóngyì zhè ge jiànyì.",
      "meaning": "Tống lần đầu đi một mình, chọn nhà nghỉ cạnh ga ở thành phố nhỏ. Lễ đông khách nên cần xác nhận sớm. Cô đồng ý rằng giao thông thuận tiện quan trọng hơn tivi trong phòng.",
      "readingMinutes": 2
    },
    {
