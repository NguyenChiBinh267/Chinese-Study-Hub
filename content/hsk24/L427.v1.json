  "blocks": [
    {
      "id": "l427-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 加课 jiā kè: thêm buổi học; 仍 réng: vẫn; 理由 lǐyóu: lý do; 结论 jiélùn: kết luận; 全校 quán xiào: toàn trường. Số liệu hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l427-t0",
      "type": "teaching",
      "title": "调查 · điều tra, khảo sát",
      "text": "调查 là thu thập/tìm hiểu thông tin; kết quả từ một nhóm không tự đại diện mọi người.",
      "hanzi": "我们调查了十二位同学的意见。",
      "pinyin": "Wǒmen diàochá le shí èr wèi tóngxué de yìjiàn.",
      "meaning": "Chúng tôi khảo sát ý kiến mười hai bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l427-t1",
      "type": "teaching",
      "title": "多数 · đa số",
      "text": "多数 nói phần lớn trong tập đang xét; không đồng nghĩa tất cả hoặc mọi nhóm ở nơi khác.",
      "hanzi": "多数同学希望早点儿出发。",
      "pinyin": "Duōshù tóngxué xīwàng zǎo diǎnr chūfā.",
      "meaning": "Đa số bạn muốn đi sớm hơn một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l427-t2",
      "type": "teaching",
      "title": "反对 · phản đối",
      "text": "反对 nhận đề xuất/hành động; không tự có nghĩa ghét người đưa ý kiến. Nhận diện chữ 反 trong 反对; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他们反对这个安排。",
      "pinyin": "Tāmen fǎnduì zhège ānpái.",
      "meaning": "Họ phản đối cách sắp xếp này.",
      "readingMinutes": 1
    },
    {
      "id": "l427-t3",
      "type": "teaching",
      "title": "吃惊 · ngạc nhiên",
      "text": "吃惊 nói cảm giác bất ngờ trước thông tin; chưa cho biết thông tin đó đúng hay sai.",
      "hanzi": "听到这个结果，他很吃惊。",
      "pinyin": "Tīngdào zhège jiéguǒ, tā hěn chījīng.",
      "meaning": "Nghe kết quả này, anh ấy rất ngạc nhiên.",
      "readingMinutes": 1
    },
    {
      "id": "l427-t4",
      "type": "teaching",
      "title": "此外 · ngoài ra",
      "text": "此外 bổ sung ý, không biểu thị quan hệ trái ngược như 不过 trong nghĩa đang học.",
      "hanzi": "此外，我们还需要问老师。",
      "pinyin": "Cǐwài, wǒmen hái xūyào wèn lǎoshī.",
      "meaning": "Ngoài ra, chúng ta còn cần hỏi giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l427-t5",
      "type": "teaching",
      "title": "不过 · tuy nhiên, nhưng",
      "text": "不过 ở đây là liên từ chuyển ý tương phản; chưa dạy nghĩa phó từ “chỉ” của cấp sau.",
      "hanzi": "这个计划不错，不过时间太紧。",
      "pinyin": "Zhège jìhuà búcuò, búguò shíjiān tài jǐn.",
      "meaning": "Kế hoạch này khá tốt, nhưng thời gian quá gấp.",
      "readingMinutes": 1
    },
    {
      "id": "l427-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "尽管+A，但是+B thừa nhận A nhưng B vẫn xảy ra. Đề giữ đúng hướng: đa số phản đối là điều được nhượng bộ; người đề xuất vẫn giải thích là kết quả. Không đảo hai vế chỉ vì cả hai trật tự có thể đúng cú pháp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l427-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "调查只问了十二位同学，其中八位反对周末加课。小关有点儿吃惊，不过愿意继续解释。尽管多数人反对，但是他仍愿意说明理由。此外，大家还打算听老师的意见，不能把十二人的结果说成全校结论。",
      "pinyin": "Diàochá zhǐ wèn le shí èr wèi tóngxué, qízhōng bā wèi fǎnduì zhōumò jiā kè. Xiǎo Guān yǒudiǎnr chījīng, búguò yuànyì jìxù jiěshì. Jǐnguǎn duōshù rén fǎnduì, dànshì tā réng yuànyì shuōmíng lǐyóu. Cǐwài, dàjiā hái dǎsuàn tīng lǎoshī de yìjiàn, bù néng bǎ shí èr rén de jiéguǒ shuō chéng quán xiào jiélùn.",
      "meaning": "Trong 12 người được hỏi, 8 người phản đối học thêm cuối tuần. Quan ngạc nhiên nhưng vẫn giải thích; kết quả nhóm nhỏ chưa đại diện toàn trường.",
      "readingMinutes": 2
    },
