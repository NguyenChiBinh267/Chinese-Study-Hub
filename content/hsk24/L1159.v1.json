  "blocks": [
    {
      "id": "l1159-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder0",
      "type": "teaching",
      "title": "十 · mười",
      "text": "Từ đã học 十 có 1 chữ. Chữ 十 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 十 với 干 / 千 / 土; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "八、九、十。",
      "pinyin": "Bā, jiǔ, shí.",
      "meaning": "Tám, chín, mười.",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder1",
      "type": "teaching",
      "title": "本 · quyển; cuốn (lượng từ)",
      "text": "Từ đã học 本 có 1 chữ. Chữ 本 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 本 với 木 / 未 / 末; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有一本书。",
      "pinyin": "Wǒ yǒu yì běn shū.",
      "meaning": "Tôi có một quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder2",
      "type": "teaching",
      "title": "桌子 · bàn",
      "text": "Từ đã học 桌子 có 2 chữ. Chữ 桌 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 桌 với 卓 / 早 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是桌子。",
      "pinyin": "Zhè shì zhuō zi.",
      "meaning": "Đây là bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder3",
      "type": "teaching",
      "title": "椅子 · ghế",
      "text": "Từ đã học 椅子 có 2 chữ. Chữ 椅 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 椅 với 倚 / 奇 / 骑; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那是椅子。",
      "pinyin": "Nà shì yǐ zi.",
      "meaning": "Kia là ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder4",
      "type": "teaching",
      "title": "东西 · đồ; vật",
      "text": "Từ đã học 东西 có 2 chữ. Chữ 东 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 东 với 车 / 乐 / 陈; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是什么东西？",
      "pinyin": "Zhè shì shén me dōng xi?",
      "meaning": "Đây là đồ gì?",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reminder5",
      "type": "teaching",
      "title": "汉字 · chữ Hán",
      "text": "Từ đã học 汉字 có 2 chữ. Chữ 汉 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 汉 với 汗 / 江 / 汊; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喜欢汉字。",
      "pinyin": "Wǒ xǐ huan Hàn zì.",
      "meaning": "Tôi thích chữ Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l1159-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：现在几点？\nB：现在九点，上课了。\nA：好，我们读书。",
      "pinyin": "A: Xiàn zài jǐ diǎn? B: Xiàn zài jiǔ diǎn, shàng kè le. A: Hǎo, wǒ men dú shū.",
      "meaning": "Trong truyện9giờ và vào giờ học; không phải giờ máy hiện tại.",
      "readingMinutes": 2
    },
