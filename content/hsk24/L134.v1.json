  "blocks": [
    {
      "id": "l134-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l134-t0",
      "type": "teaching",
      "title": "公司 · công ty",
      "text": "公司 chỉ công ty; không tự cho biết tòa nhà, quy mô hay ngành nghề.",
      "hanzi": "这是我姐姐的公司。",
      "pinyin": "Zhè shì wǒ jiě jie de gōng sī.",
      "meaning": "Đây là công ty của chị gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l134-t1",
      "type": "teaching",
      "title": "工作 · làm việc; công việc",
      "text": "工作 trong 在公司工作 là động từ làm việc; trong 我的工作 là danh từ theo ngữ cảnh.",
      "hanzi": "我在公司工作。",
      "pinyin": "Wǒ zài gōng sī gōng zuò.",
      "meaning": "Tôi làm việc ở công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l134-t2",
      "type": "teaching",
      "title": "上班 · đi làm; vào ca làm",
      "text": "上班 không buộc phải là tới một văn phòng trong mọi tình huống; bài dùng lịch công việc đơn giản.",
      "hanzi": "我妈妈上班。",
      "pinyin": "Wǒ mā ma shàng bān.",
      "meaning": "Mẹ tôi đi làm.",
      "readingMinutes": 1
    },
    {
      "id": "l134-t3",
      "type": "teaching",
      "title": "下班 · tan ca; hết giờ làm",
      "text": "下班 là kết thúc ca/lượt làm việc; 了 = rồi trong ví dụ.",
      "hanzi": "我下班了。",
      "pinyin": "Wǒ xià bān le.",
      "meaning": "Tôi tan ca rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l134-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "工作 có thể là công việc hoặc hành động làm việc theo câu. 在公司工作 nói làm việc ở công ty; không tự gán ngành nghề. 上班 nói đi/làm ca làm việc, 下班 là hết ca; không hiểu 下班 là nghỉ việc vĩnh viễn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l134-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你姐姐在哪儿工作？\nB：在公司工作。\nA：她下班了吗？\nB：下班了，她回家了。",
      "pinyin": "A: Nǐ jiě jie zài nǎr gōng zuò? B: Zài gōng sī gōng zuò. A: Tā xià bān le ma? B: Xià bān le, tā huí jiā le.",
      "meaning": "了 le trong đoạn báo tình trạng đã xảy ra. Chị gái B làm ở công ty và đã về nhà sau khi tan ca.",
      "readingMinutes": 2
    },
