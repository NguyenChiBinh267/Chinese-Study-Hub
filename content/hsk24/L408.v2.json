  "blocks": [
    {
      "id": "l408-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 对照 duìzhào: đối chiếu; 修改 xiūgǎi: sửa; 原稿 yuángǎo: bản gốc; 版本 bǎnběn: phiên bản. Ví dụ 答案 ghi dá àn để thấy ranh giới âm tiết.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l408-t0",
      "type": "teaching",
      "title": "打印 · in",
      "text": "打印 biến nội dung trên máy thành bản in; phân biệt 复印 là sao chụp bản giấy. Nhận diện chữ 印 trong 打印; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请把改好的文章打印出来。",
      "pinyin": "Qǐng bǎ gǎi hǎo de wénzhāng dǎyìn chūlái.",
      "meaning": "Hãy in bài viết đã sửa ra.",
      "readingMinutes": 1
    },
    {
      "id": "l408-t1",
      "type": "teaching",
      "title": "打印机 · máy in",
      "text": "打印机 là thiết bị; đặt sau dùng máy 用, không dùng như động từ 打印.",
      "hanzi": "这台打印机没有纸了。",
      "pinyin": "Zhè tái dǎyìnjī méiyǒu zhǐ le.",
      "meaning": "Máy in này hết giấy rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l408-t2",
      "type": "teaching",
      "title": "答案 · đáp án",
      "text": "答案 có hai âm a liền nhau nhưng nguồn tách bằng dấu nháy dá’àn; pinyin luyện nhận dá àn, không đổi thanh.",
      "hanzi": "请先做题，再看答案。",
      "pinyin": "Qǐng xiān zuò tí, zài kàn dá àn.",
      "meaning": "Hãy làm bài trước rồi mới xem đáp án.",
      "readingMinutes": 1
    },
    {
      "id": "l408-t3",
      "type": "teaching",
      "title": "词语 · từ ngữ",
      "text": "词语 là đơn vị từ/ngữ trong câu; không đồng nghĩa chỉ chữ viết đơn lẻ.",
      "hanzi": "我把不懂的词语写在本子上。",
      "pinyin": "Wǒ bǎ bù dǒng de cíyǔ xiě zài běnzi shàng.",
      "meaning": "Tôi ghi từ ngữ chưa hiểu vào vở.",
      "readingMinutes": 1
    },
    {
      "id": "l408-t4",
      "type": "teaching",
      "title": "猜 · đoán",
      "text": "猜 là suy ra khi chưa biết chắc; cần đối chiếu, không gọi dự đoán là đáp án đã xác nhận.",
      "hanzi": "你先猜一下这个词的意思。",
      "pinyin": "Nǐ xiān cāi yíxià zhège cí de yìsi.",
      "meaning": "Bạn thử đoán nghĩa từ này trước.",
      "readingMinutes": 1
    },
    {
      "id": "l408-t5",
      "type": "teaching",
      "title": "重新 · làm lại, lại từ đầu",
      "text": "重新 đặt trước động từ chỉ làm lại sau điều chỉnh; bài không coi mọi 再 đều thay được.",
      "hanzi": "我改了两处，准备重新打印。",
      "pinyin": "Wǒ gǎi le liǎng chù, zhǔnbèi chóngxīn dǎyìn.",
      "meaning": "Tôi sửa hai chỗ, định in lại.",
      "readingMinutes": 1
    },
    {
      "id": "l408-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "重新+động từ chỉ làm lại, thường sau khi thay đổi/sửa. Không nhất thiết chỉ lặp đúng bản cũ. 重新打印 bản đã sửa khác 再看一遍 chỉ đọc lại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l408-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "阿兰先猜生词的意思，再查词典，最后对照答案。她发现两个词语用错了，便修改文章。给打印机加好纸以后，她重新打印了一份。这次重印的是改好的文章，不是原来的错误版本。",
      "pinyin": "Ā Lán xiān cāi shēngcí de yìsi, zài chá cídiǎn, zuìhòu duìzhào dá àn. Tā fāxiàn liǎng ge cíyǔ yòng cuò le, biàn xiūgǎi wénzhāng. Gěi dǎyìnjī jiā hǎo zhǐ yǐhòu, tā chóngxīn dǎyìn le yí fèn. Zhè cì chóngyìn de shì gǎi hǎo de wénzhāng, bú shì yuánlái de cuòwù bǎnběn.",
      "meaning": "Lan đoán, tra từ điển rồi đối chiếu đáp án. Cô sửa hai từ dùng sai và in lại bản đã sửa sau khi thêm giấy.",
      "readingMinutes": 2
    },
    {
      "id": "l408-b0",
      "type": "exercise",
      "exerciseVersionId": "l408-v2-e0"
