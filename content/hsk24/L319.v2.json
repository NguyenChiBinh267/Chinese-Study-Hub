  "blocks": [
    {
      "id": "l319-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 穿 chuān: mặc/mang; 口袋 kǒudai: túi áo/quần; 件 jiàn, 条 tiáo và 双 shuāng là lượng từ được giải thích tại ví dụ. 蓝 lán: xanh lam; 合适 héshì: phù hợp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l319-t0",
      "type": "teaching",
      "title": "衬衫 · áo sơ mi",
      "text": "衬衫 là áo sơ mi, thuộc loại 上衣; hai từ có thể bao hàm nhau nên cần ngữ cảnh nói rõ kiểu áo, không dùng làm đáp án loại trừ khi hỏi chung.",
      "hanzi": "这件白衬衫有两个口袋。",
      "pinyin": "Zhè jiàn bái chènshān yǒu liǎng ge kǒudai.",
      "meaning": "Áo sơ mi trắng này có hai túi.",
      "readingMinutes": 1
    },
    {
      "id": "l319-t1",
      "type": "teaching",
      "title": "大衣 · áo khoác dài",
      "text": "大衣 thường là áo khoác dài mặc ngoài; 大 không có nghĩa chọn cỡ lớn của mọi áo.",
      "hanzi": "冬天我穿这件大衣。",
      "pinyin": "Dōngtiān wǒ chuān zhè jiàn dàyī.",
      "meaning": "Mùa đông tôi mặc chiếc áo khoác dài này.",
      "readingMinutes": 1
    },
    {
      "id": "l319-t2",
      "type": "teaching",
      "title": "短裤 · quần đùi/quần ngắn",
      "text": "短裤 chỉ quần ngắn; 裤 là phần tên đồ quần, không dùng cho váy.",
      "hanzi": "夏天他常穿短裤。",
      "pinyin": "Xiàtiān tā cháng chuān duǎnkù.",
      "meaning": "Mùa hè anh ấy hay mặc quần ngắn.",
      "readingMinutes": 1
    },
    {
      "id": "l319-t3",
      "type": "teaching",
      "title": "裙子 · váy",
      "text": "裙子 là váy, 子 đọc nhẹ; 一条裙子 dùng lượng từ 条, không phải 件 trong ví dụ này.",
      "hanzi": "她买了一条蓝裙子。",
      "pinyin": "Tā mǎi le yì tiáo lán qúnzi.",
      "meaning": "Cô ấy mua một chiếc váy xanh lam.",
      "readingMinutes": 1
    },
    {
      "id": "l319-t4",
      "type": "teaching",
      "title": "上衣 · áo mặc phần thân trên",
      "text": "上衣 là tên khái quát áo phần trên; 衬衫 là một loại cụ thể. Khi dịch “áo thân trên” ở đây cần từ chung.",
      "hanzi": "这件上衣很合适。",
      "pinyin": "Zhè jiàn shàngyī hěn héshì.",
      "meaning": "Chiếc áo này rất vừa/phù hợp.",
      "readingMinutes": 1
    },
    {
      "id": "l319-t5",
      "type": "teaching",
      "title": "鞋 · giày",
      "text": "鞋 là giày; 一双鞋 chỉ một đôi, khác 一只鞋 một chiếc. Từ này không chỉ quần áo mặc trên thân.",
      "hanzi": "这双鞋有点儿小。",
      "pinyin": "Zhè shuāng xié yǒudiǎnr xiǎo.",
      "meaning": "Đôi giày này hơi nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l319-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "或者 nối phương án trong câu trần thuật: 买衬衫或者上衣. Câu hỏi trực tiếp chọn A hay B thường dùng 还是; bài luyện 或者 trong kế hoạch, không đổi tùy ý hai từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l319-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：夏天我想买短裤和一双鞋。小王：我先看看衬衫或者别的上衣。小林：这条裙子呢？小王：也不错，可是今天不买。冬天穿的大衣也先不买。",
      "pinyin": "Xiǎo Lín: Xiàtiān wǒ xiǎng mǎi duǎnkù hé yì shuāng xié. Xiǎo Wáng: Wǒ xiān kànkan chènshān huòzhě bié de shàngyī. Xiǎo Lín: Zhè tiáo qúnzi ne? Xiǎo Wáng: Yě búcuò, kěshì jīntiān bù mǎi. Dōngtiān chuān de dàyī yě xiān bù mǎi.",
      "meaning": "Lâm muốn mua quần ngắn và giày. Vương xem sơ mi hoặc áo khác, chưa mua váy và áo khoác mùa đông.",
      "readingMinutes": 2
    },
    {
