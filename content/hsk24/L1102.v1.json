  "blocks": [
    {
      "id": "l1102-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1102-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "对 + người trong 老师对我很好 nêu đối tượng được đối xử/đánh giá: thầy cô đối với tôi rất tốt. Đây là chức năng giới từ, khác 对 mang nghĩa “đúng” ở bài từ vựng L138. Các câu ngữ pháp về nghĩa mới là CONTEXT_ONLY, không dùng thẻ 对 nghĩa “đúng” để ghi nhận nghĩa giới từ. Từ mức độ 很 đứng trước 好; không đưa 对我 ra sau 好 theo trật tự Việt.",
      "hanzi": "老师对我很好。",
      "pinyin": "Lǎo shī duì wǒ hěn hǎo.",
      "meaning": "Thầy/cô đối xử rất tốt với tôi.",
      "readingMinutes": 3
    },
    {
      "id": "l1102-reminder0",
      "type": "teaching",
      "title": "工作 · làm việc; công việc",
      "text": "Nhắc nghĩa đã học: làm việc; công việc. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我在公司工作。",
      "pinyin": "Wǒ zài gōng sī gōng zuò.",
      "meaning": "Tôi làm việc ở công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l1102-reminder1",
      "type": "teaching",
      "title": "忙 · bận",
      "text": "Nhắc nghĩa đã học: bận. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我很忙。",
      "pinyin": "Wǒ hěn máng.",
      "meaning": "Tôi bận.",
      "readingMinutes": 1
    },
    {
      "id": "l1102-reminder2",
      "type": "teaching",
      "title": "老师 · giáo viên; thầy/cô",
      "text": "Nhắc nghĩa đã học: giáo viên; thầy/cô. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "她是我的老师。",
      "pinyin": "Tā shì wǒ de lǎo shī.",
      "meaning": "Cô ấy là giáo viên của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1102-reminder3",
      "type": "teaching",
      "title": "高兴 · vui; vui mừng",
      "text": "Nhắc nghĩa đã học: vui; vui mừng. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "认识你，我很高兴。",
      "pinyin": "Rèn shi nǐ, wǒ hěn gāo xìng.",
      "meaning": "Tôi vui được biết bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1102-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你在哪儿工作？\nB：我在学校工作。\nA：工作怎么样？\nB：工作不忙，我很高兴。老师对我很好。",
      "pinyin": "A: Nǐ zài nǎr gōng zuò? B: Wǒ zài xué xiào gōng zuò. A: Gōng zuò zěn me yàng? B: Gōng zuò bù máng, wǒ hěn gāo xìng. Lǎo shī duì wǒ hěn hǎo.",
      "meaning": "Người B trong truyện làm việc tại trường, nhận xét công việc không bận và vui; thầy/cô đối xử tốt với B. Đây là đánh giá hư cấu, không phải đánh giá nghề thật.",
      "readingMinutes": 2
    },
    {
