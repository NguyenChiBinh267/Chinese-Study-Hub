  "blocks": [
    {
      "id": "l4066-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t0",
      "type": "teaching",
      "title": "取得 · đạt được",
      "text": "取得 thường đi với kết quả hoặc sự tiến bộ có được.",
      "hanzi": "小组取得了进步。",
      "pinyin": "Xiǎo zǔ qǔ dé le jìn bù.",
      "meaning": "Nhóm đã có tiến bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t1",
      "type": "teaching",
      "title": "取消 · hủy bỏ",
      "text": "取消 nói bỏ một sắp xếp, khác 推迟 là dời sang sau.",
      "hanzi": "我们没有取消演出。",
      "pinyin": "Wǒ men méi yǒu qǔ xiāo yǎn chū.",
      "meaning": "Chúng tôi không hủy biểu diễn.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t2",
      "type": "teaching",
      "title": "推迟 · hoãn lại",
      "text": "推迟 thay đổi thời điểm sang muộn hơn.",
      "hanzi": "排练推迟到周五。",
      "pinyin": "Pái liàn tuī chí dào zhōu wǔ.",
      "meaning": "Buổi tập dời đến thứ sáu.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t3",
      "type": "teaching",
      "title": "暂时 · tạm thời",
      "text": "暂时 giới hạn một tình trạng trong hiện tại. Nhận diện chữ 暂 trong 暂时; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们暂时借用小教室。",
      "pinyin": "Wǒ men zàn shí jiè yòng xiǎo jiào shì.",
      "meaning": "Chúng tôi tạm dùng phòng học nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t4",
      "type": "teaching",
      "title": "暂停 · tạm dừng",
      "text": "暂停 là dừng hoạt động trong một thời gian.",
      "hanzi": "老师让大家暂停练习。",
      "pinyin": "Lǎo shī ràng dà jiā zàn tíng liàn xí.",
      "meaning": "Giáo viên cho mọi người tạm dừng tập.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-t5",
      "type": "teaching",
      "title": "再次 · một lần nữa",
      "text": "再次 chỉ lặp lại hành động; không khẳng định lần nào cũng như nhau.",
      "hanzi": "周五我们再次见面。",
      "pinyin": "Zhōu wǔ wǒ men zài cì jiàn miàn.",
      "meaning": "Thứ sáu chúng tôi gặp lại.",
      "readingMinutes": 1
    },
    {
      "id": "l4066-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 nêu sự điều chỉnh: hoãn lần tập không có nghĩa hủy mục tiêu. 暂时 và 暂停 đều có ý tạm thời, nhưng 暂停 là dừng một hoạt động.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4066-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小组取得了一些进步，不过大教室临时不能用。老师暂停了今天的练习，把排练推迟到周五，没有取消演出。大家暂时借用小教室讨论，约好周五再次见面。",
      "pinyin": "Xiǎo zǔ qǔ dé le yì xiē jìn bù, bú guò dà jiào shì lín shí bù néng yòng. Lǎo shī zàn tíng le jīn tiān de liàn xí, bǎ pái liàn tuī chí dào zhōu wǔ, méi yǒu qǔ xiāo yǎn chū. Dà jiā zàn shí jiè yòng xiǎo jiào shì tǎo lùn, yuē hǎo zhōu wǔ zài cì jiàn miàn.",
      "meaning": "Buổi tập hoãn đến thứ sáu vì phòng lớn không dùng được; buổi diễn vẫn giữ.",
      "readingMinutes": 2
    },
    {
