  "blocks": [
    {
      "id": "l453-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 面对 miànduì: đối diện; 观众 guānzhòng: khán giả; 轻松 qīngsōng: nhẹ nhõm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l453-t0",
      "type": "teaching",
      "title": "激动 · xúc động, phấn khích",
      "text": "激动 nói cảm xúc mạnh, chưa xác định vui hay buồn nếu thiếu ngữ cảnh.",
      "hanzi": "听到消息，她很激动。",
      "pinyin": "Tīng dào xiāoxi, tā hěn jīdòng.",
      "meaning": "Nghe tin, cô rất xúc động.",
      "readingMinutes": 1
    },
    {
      "id": "l453-t1",
      "type": "teaching",
      "title": "紧张 · căng thẳng",
      "text": "紧张 có thể nói tâm lý hoặc tình hình gấp; ở đây là tâm lý trước thi.",
      "hanzi": "上台以前我很紧张。",
      "pinyin": "Shàng tái yǐqián wǒ hěn jǐnzhāng.",
      "meaning": "Trước khi lên sân khấu tôi rất căng thẳng.",
      "readingMinutes": 1
    },
    {
      "id": "l453-t2",
      "type": "teaching",
      "title": "冷静 · bình tĩnh",
      "text": "冷静 là trạng thái/thái độ, không phải nhiệt độ thấp như 寒冷.",
      "hanzi": "他先让自己冷静下来。",
      "pinyin": "Tā xiān ràng zìjǐ lěngjìng xià lái.",
      "meaning": "Anh ấy để mình bình tĩnh lại trước.",
      "readingMinutes": 1
    },
    {
      "id": "l453-t3",
      "type": "teaching",
      "title": "感觉 · cảm thấy; cảm giác",
      "text": "感觉 có thể nhận mệnh đề; không coi cảm giác là bằng chứng kết quả.",
      "hanzi": "我感觉比上次轻松。",
      "pinyin": "Wǒ gǎnjué bǐ shàng cì qīngsōng.",
      "meaning": "Tôi thấy thoải mái hơn lần trước.",
      "readingMinutes": 1
    },
    {
      "id": "l453-t4",
      "type": "teaching",
      "title": "感受 · cảm nhận",
      "text": "感受 là trải nghiệm/cảm nhận của bản thân; ở đây dùng danh từ 谈感受.",
      "hanzi": "老师请我们谈谈感受。",
      "pinyin": "Lǎoshī qǐng wǒmen tántan gǎnshòu.",
      "meaning": "Thầy mời chúng tôi chia sẻ cảm nhận.",
      "readingMinutes": 1
    },
    {
      "id": "l453-t5",
      "type": "teaching",
      "title": "后悔 · hối tiếc",
      "text": "后悔 là tiếc về quyết định/hành động trước đó, khác lo điều chưa xảy ra. Nhận diện chữ 悔 trong 后悔; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我后悔没有早点儿练习。",
      "pinyin": "Wǒ hòuhuǐ méiyǒu zǎo diǎnr liànxí.",
      "meaning": "Tôi tiếc đã không luyện sớm hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l453-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "却 đặt sau chủ ngữ, trước vị ngữ để nêu điều trái dự kiến: 他准备了很久，却还是很紧张. Không đặt 却 trước chủ ngữ như 但是 trong mọi câu. Nó không phủ nhận việc đã chuẩn bị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l453-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小周准备了很久，上台前却还是很紧张。他先喝口水，让自己冷静下来。比赛结束后，老师请大家谈感受。小周说：“我感觉比上次轻松，也很激动。虽然没有获奖，我不后悔参加，因为学到了怎样面对观众。”",
      "pinyin": "Xiǎo Zhōu zhǔnbèi le hěn jiǔ, shàng tái qián què háishi hěn jǐnzhāng. Tā xiān hē kǒu shuǐ, ràng zìjǐ lěngjìng xià lái. Bǐsài jiéshù hòu, lǎoshī qǐng dàjiā tán gǎnshòu. Xiǎo Zhōu shuō: “Wǒ gǎnjué bǐ shàng cì qīngsōng, yě hěn jīdòng. Suīrán méiyǒu huòjiǎng, wǒ bù hòuhuǐ cānjiā, yīnwèi xué dào le zěnyàng miànduì guānzhòng.”",
      "meaning": "Châu đã chuẩn bị lâu nhưng vẫn hồi hộp. Sau thi, cậu thấy nhẹ nhõm hơn và không tiếc tham gia dù chưa đoạt giải vì đã học đối diện khán giả.",
      "readingMinutes": 2
    },
    {
      "id": "l453-b0",
      "type": "exercise",
      "exerciseVersionId": "l453-v1-e0"
