  "blocks": [
    {
      "id": "l4062-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t0",
      "type": "teaching",
      "title": "是否 · có hay không",
      "text": "是否 đặt vấn đề cần xác nhận, không tự khẳng định đúng.",
      "hanzi": "请问是否还有名额？",
      "pinyin": "Qǐng wèn shì fǒu hái yǒu míng é?",
      "meaning": "Xin hỏi còn chỗ hay không?",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t1",
      "type": "teaching",
      "title": "适合 · phù hợp",
      "text": "适合 nói sự phù hợp giữa người, mục đích và lựa chọn.",
      "hanzi": "这个班适合初学者。",
      "pinyin": "Zhè ge bān shì hé chū xué zhě.",
      "meaning": "Lớp này phù hợp người mới học.",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t2",
      "type": "teaching",
      "title": "适应 · thích nghi",
      "text": "适应 nói quá trình quen với môi trường hay cách làm.",
      "hanzi": "我还在适应新的上课方式。",
      "pinyin": "Wǒ hái zài shì yìng xīn de shàng kè fāng shì.",
      "meaning": "Tôi vẫn đang thích nghi với cách học mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t3",
      "type": "teaching",
      "title": "估计 · ước tính",
      "text": "估计 biểu thị phán đoán chưa chắc, cần kiểm tra lại. Nhận diện chữ 估 trong 估计; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我估计每周能来两次。",
      "pinyin": "Wǒ gū jì měi zhōu néng lái liǎng cì.",
      "meaning": "Tôi ước tính mỗi tuần đến được hai lần.",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t4",
      "type": "teaching",
      "title": "实际上 · trên thực tế",
      "text": "实际上 dẫn điều thực tế để điều chỉnh một nhận định.",
      "hanzi": "实际上，我只能周末来。",
      "pinyin": "Shí jì shàng, wǒ zhǐ néng zhōu mò lái.",
      "meaning": "Thực tế tôi chỉ đến được cuối tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l4062-t5",
      "type": "teaching",
      "title": "实际 · thực tế",
      "text": "实际 trong 实际情况 bổ nghĩa cho tình hình cụ thể.",
      "hanzi": "老师先了解实际情况。",
      "pinyin": "Lǎo shī xiān liǎo jiě shí jì qíng kuàng.",
      "meaning": "Giáo viên tìm hiểu tình hình thực tế trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4062-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 nối nhận định trước với hạn chế hoặc điều chỉnh sau; ước tính phải tách khỏi thông tin đã xác nhận.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4062-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安问是否还有名额，老师说这个班适合初学者。小安估计每周能来两次，不过实际上只能周末来。老师了解实际情况后建议她先选周末班，慢慢适应新的上课方式。",
      "pinyin": "Xiǎo Ān wèn shì fǒu hái yǒu míng é, lǎo shī shuō zhè ge bān shì hé chū xué zhě. Xiǎo Ān gū jì měi zhōu néng lái liǎng cì, bú guò shí jì shàng zhǐ néng zhōu mò lái. Lǎo shī liǎo jiě shí jì qíng kuàng hòu jiàn yì tā xiān xuǎn zhōu mò bān, màn màn shì yìng xīn de shàng kè fāng shì.",
      "meaning": "Tiểu An điều chỉnh lựa chọn lớp sau khi đối chiếu lịch thực tế.",
      "readingMinutes": 2
    },
    {
