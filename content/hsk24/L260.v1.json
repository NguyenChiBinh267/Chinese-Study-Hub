  "blocks": [
    {
      "id": "l260-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "我/他/她 chỉ người; 小 là nhỏ. 儿 trong 男孩儿、女孩儿、小孩儿 ghi âm uốn lưỡi, không tách thành một âm ér riêng trong mục từ này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t0",
      "type": "teaching",
      "title": "Nhắc lại · 姓 · mang họ, họ",
      "text": "我姓王 dùng 姓 như động từ; câu trả lời chỉ họ, không yêu cầu tên đầy đủ. Không dùng 是 sau 姓 trong mẫu này.",
      "hanzi": "我姓王，你呢？",
      "pinyin": "Wǒ xìng Wáng, nǐ ne?",
      "meaning": "Tôi họ Vương, còn bạn?",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t1",
      "type": "teaching",
      "title": "Nhắc lại · 姓名 · họ và tên",
      "text": "姓名 gồm họ lẫn tên, thường gặp trên biểu mẫu. Nếu chỉ viết họ thì thông tin có thể chưa đủ.",
      "hanzi": "请在这里写你的姓名。",
      "pinyin": "Qǐng zài zhèlǐ xiě nǐ de xìngmíng.",
      "meaning": "Hãy viết họ và tên của bạn ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t2",
      "type": "teaching",
      "title": "Nhắc lại · 男孩儿 · bé trai, cậu bé",
      "text": "男孩儿 là một đứa trẻ nam. Đừng dùng mọi người đàn ông trưởng thành làm ví dụ của từ này.",
      "hanzi": "这个男孩儿姓李。",
      "pinyin": "Zhège nánháir xìng Lǐ.",
      "meaning": "Cậu bé này họ Lý.",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t3",
      "type": "teaching",
      "title": "Nhắc lại · 女孩儿 · bé gái, cô bé",
      "text": "女孩儿 là một đứa trẻ nữ; 女 giữ âm ü và thanh ba trong nǚ.",
      "hanzi": "那个女孩儿是我妹妹。",
      "pinyin": "Nàge nǚháir shì wǒ mèimei.",
      "meaning": "Cô bé kia là em gái tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t4",
      "type": "teaching",
      "title": "Nhắc lại · 小孩儿 · trẻ con, một đứa trẻ",
      "text": "小孩儿 không tự cho biết giới tính. Chỉ kết luận trai/gái khi câu có thông tin thêm.",
      "hanzi": "两个小孩儿在看书。",
      "pinyin": "Liǎng ge xiǎoháir zài kàn shū.",
      "meaning": "Hai đứa trẻ đang đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-t5",
      "type": "teaching",
      "title": "Nhắc lại · 小时候 · hồi còn nhỏ",
      "text": "小时候 chỉ quãng đời còn nhỏ, không phải một giờ ngắn. Âm cuối hou đọc nhẹ theo mục từ.",
      "hanzi": "我小时候住在这里。",
      "pinyin": "Wǒ xiǎoshíhou zhù zài zhèlǐ.",
      "meaning": "Hồi nhỏ tôi sống ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l260-t0-l220-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "自己 có thể nhấn mạnh tự mình làm: 自己写姓名. Nhắc lại cấu trúc để điền thông tin, không dùng tên tự điền làm bằng chứng danh tính thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l260-t0-l220-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "王老师：请自己写姓名。男孩儿：我姓李，叫李安。女孩儿：我姓王，叫王月。老师：我小时候也在这所学校学习。",
      "pinyin": "Wáng lǎoshī: Qǐng zìjǐ xiě xìngmíng. Nánháir: Wǒ xìng Lǐ, jiào Lǐ Ān. Nǚháir: Wǒ xìng Wáng, jiào Wáng Yuè. Lǎoshī: Wǒ xiǎoshíhou yě zài zhè suǒ xuéxiào xuéxí.",
      "meaning": "Cô/thầy Vương: Hãy tự viết họ tên. Bé trai: Em họ Lý, tên Lý An. Bé gái: Em họ Vương, tên Vương Nguyệt. Giáo viên: Hồi nhỏ thầy/cô cũng học ở trường này.",
      "readingMinutes": 2
    },
    {
      "id": "l260-b0",
