  "blocks": [
    {
      "id": "l4040-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t0",
      "type": "teaching",
      "title": "男士 · quý ông; người đàn ông",
      "text": "男士 là cách gọi lịch sự người nam trưởng thành.",
      "hanzi": "那位男士正在等车。",
      "pinyin": "Nà wèi nán shì zhèng zài děng chē.",
      "meaning": "Quý ông kia đang đợi xe.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t1",
      "type": "teaching",
      "title": "男性 · nam giới",
      "text": "男性 là thuật ngữ phân loại, khác xưng hô 男士. Nhận diện chữ 性 trong 男性; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "表格上有男性这一项。",
      "pinyin": "Biǎo gé shàng yǒu nán xìng zhè yí xiàng.",
      "meaning": "Trên biểu mẫu có mục nam giới.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t2",
      "type": "teaching",
      "title": "女性 · nữ giới",
      "text": "女性 là thuật ngữ phân loại, không tự cho biết tính cách.",
      "hanzi": "这本书介绍几位女性作家。",
      "pinyin": "Zhè běn shū jiè shào jǐ wèi nǚ xìng zuò jiā.",
      "meaning": "Sách giới thiệu mấy nhà văn nữ.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t3",
      "type": "teaching",
      "title": "性别 · giới tính",
      "text": "性别 là thông tin giới tính, không đồng nghĩa tính cách.",
      "hanzi": "这张表没有要求填写性别。",
      "pinyin": "Zhè zhāng biǎo méi yǒu yāo qiú tián xiě xìng bié.",
      "meaning": "Phiếu này không yêu cầu điền giới tính.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t4",
      "type": "teaching",
      "title": "性格 · tính cách",
      "text": "性格 chỉ đặc điểm tâm tính tương đối ổn định.",
      "hanzi": "她的性格很开朗。",
      "pinyin": "Tā de xìng gé hěn kāi lǎng.",
      "meaning": "Tính cô ấy rất cởi mở.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-t5",
      "type": "teaching",
      "title": "性 · tính; tính chất trong hậu tố",
      "text": "性 có thể tạo danh từ về đặc tính, như 可能性; không dùng riêng thay mọi từ 性格.",
      "hanzi": "我们讨论了这种可能性。",
      "pinyin": "Wǒ men tǎo lùn le zhè zhǒng kě néng xìng.",
      "meaning": "Chúng tôi bàn về khả năng này.",
      "readingMinutes": 1
    },
    {
      "id": "l4040-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 đưa nhận xét giới hạn: có thông tin trên biểu mẫu nhưng không đủ để suy ra tính cách.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4040-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "一位男士来参加读书会。他介绍几位女性作家，也讨论故事发展的可能性。报名表可以记录男性、女性等性别信息，不过单凭这些信息不能判断一个人的性格。这次表格没有要求填写性别。",
      "pinyin": "Yí wèi nán shì lái cān jiā dú shū huì. Tā jiè shào jǐ wèi nǚ xìng zuò jiā, yě tǎo lùn gù shi fā zhǎn de kě néng xìng. Bào míng biǎo kě yǐ jì lù nán xìng, nǚ xìng děng xìng bié xìn xī, bú guò dān píng zhè xiē xìn xī bù néng pàn duàn yí ge rén de xìng gé. Zhè cì biǎo gé méi yǒu yāo qiú tián xiě xìng bié.",
      "meaning": "Bài phân biệt cách xưng hô, giới tính, tính cách và thành tố 性 trong 可能性.",
      "readingMinutes": 2
    },
