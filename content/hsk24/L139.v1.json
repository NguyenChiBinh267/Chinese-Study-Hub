  "blocks": [
    {
      "id": "l139-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l139-t0",
      "type": "teaching",
      "title": "电话 · điện thoại",
      "text": "电话 ở ví dụ gọi tên thiết bị; chưa nói số điện thoại hoặc người sở hữu.",
      "hanzi": "这是电话。",
      "pinyin": "Zhè shì diàn huà.",
      "meaning": "Đây là điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l139-t1",
      "type": "teaching",
      "title": "手机 · điện thoại di động",
      "text": "手机 là thiết bị di động, không đồng nghĩa mọi máy tính.",
      "hanzi": "我的手机很新。",
      "pinyin": "Wǒ de shǒu jī hěn xīn.",
      "meaning": "Điện thoại di động của tôi mới.",
      "readingMinutes": 1
    },
    {
      "id": "l139-t2",
      "type": "teaching",
      "title": "打电话 · gọi điện thoại",
      "text": "打电话 là cụm gọi điện; không suy người nhận nếu câu chưa cho.",
      "hanzi": "我打电话。",
      "pinyin": "Wǒ dǎ diàn huà.",
      "meaning": "Tôi gọi điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l139-t3",
      "type": "teaching",
      "title": "喂 · a lô (mở đầu điện thoại)",
      "text": "喂 trong mục từ này đọc wèi và mở cuộc gọi; số1 ở nguồn phân biệt mục, không phải chữ phải nhập.",
      "hanzi": "喂，您好！",
      "pinyin": "Wèi, nín hǎo!",
      "meaning": "A lô, xin chào!",
      "readingMinutes": 1
    },
    {
      "id": "l139-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "喂 wèi là lời mở đầu điện thoại trong bài, khác động từ cho ăn ở ngữ cảnh khác. 电话 là điện thoại/liên lạc qua điện thoại, 手机 là điện thoại di động; 打电话 là gọi điện, không dịch 打 ở đây thành đánh. Bài chỉ đọc cuộc gọi mô phỏng, không tự gọi hoặc gửi tin nhắn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l139-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：喂，你好！\nB：你好，请问是林先生吗？\nA：是。你是安女士吗？\nB：是。",
      "pinyin": "A: Wèi, nǐ hǎo! B: Nǐ hǎo, qǐng wèn shì Lín xiān sheng ma? A: Shì. Nǐ shì Ān nǚ shì ma? B: Shì.",
      "meaning": "Cuộc gọi viết mô phỏng xác nhận hai người: Lâm được gọi 先生, An được gọi 女士. Không có thao tác liên lạc thật.",
      "readingMinutes": 2
    },
