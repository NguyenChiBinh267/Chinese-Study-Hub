  "blocks": [
    {
      "id": "l254-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "医生 là bác sĩ; 医院 là bệnh viện; 看医生 là đi khám. Bài luyện ngôn ngữ mô tả, không đưa khuyến nghị thuốc hay chẩn đoán.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t0",
      "type": "teaching",
      "title": "Nhắc lại · 身体 · cơ thể, thể trạng",
      "text": "身体 có thể nói cơ thể hoặc thể trạng trong 身体很好. Không dùng mỗi từ này để chẩn đoán bộ phận bị bệnh.",
      "hanzi": "你身体怎么样？",
      "pinyin": "Nǐ shēntǐ zěnmeyàng?",
      "meaning": "Sức khỏe bạn thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t1",
      "type": "teaching",
      "title": "Nhắc lại · 舒服 · dễ chịu",
      "text": "舒服 đọc âm sau nhẹ. 不舒服 nói không dễ chịu/không khỏe, không xác định một bệnh cụ thể.",
      "hanzi": "我今天不太舒服。",
      "pinyin": "Wǒ jīntiān bú tài shūfu.",
      "meaning": "Hôm nay tôi không khỏe lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t2",
      "type": "teaching",
      "title": "Nhắc lại · 疼 · đau",
      "text": "Trong bài dùng tính từ mô tả đau: 头疼. Không mở rộng sang nghĩa động từ thương yêu ở cấp khác.",
      "hanzi": "我的头很疼。",
      "pinyin": "Wǒ de tóu hěn téng.",
      "meaning": "Đầu tôi rất đau.",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t3",
      "type": "teaching",
      "title": "Nhắc lại · 药 · thuốc",
      "text": "药 chỉ thuốc nói chung. Tên từ không cho biết loại thuốc, liều hay cách dùng; bài không hướng dẫn tự uống.",
      "hanzi": "桌子上有药。",
      "pinyin": "Zhuōzi shang yǒu yào.",
      "meaning": "Trên bàn có thuốc.",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t4",
      "type": "teaching",
      "title": "Nhắc lại · 药店 · hiệu thuốc",
      "text": "药店 là nơi bán thuốc, khác 医院 là bệnh viện. Có hiệu thuốc gần nhà không có nghĩa phải tự mua thuốc.",
      "hanzi": "我家旁边有一家药店。",
      "pinyin": "Wǒ jiā pángbiān yǒu yì jiā yàodiàn.",
      "meaning": "Bên nhà tôi có một hiệu thuốc.",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-t5",
      "type": "teaching",
      "title": "Nhắc lại · 累 · mệt",
      "text": "累 ở đây là tính từ mệt. Chưa phân tích nghĩa gây mệt hay kết quả làm ai mệt trong cấu trúc khác.",
      "hanzi": "今天工作很多，我很累。",
      "pinyin": "Jīntiān gōngzuò hěn duō, wǒ hěn lèi.",
      "meaning": "Hôm nay nhiều việc, tôi rất mệt.",
      "readingMinutes": 1
    },
    {
      "id": "l254-t0-l214-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "因为 nêu nguyên nhân, 所以 nêu kết quả trong lời kể. Câu mô tả cảm giác không đủ để xác định một bệnh; chỉ chấm hiểu thông tin đã nêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l254-t0-l214-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你怎么了？乙：我头疼，身体不太舒服。甲：你今天去上班吗？乙：因为不舒服，所以我去看医生。",
      "pinyin": "Jiǎ: Nǐ zěnme le? Yǐ: Wǒ tóu téng, shēntǐ bú tài shūfu. Jiǎ: Nǐ jīntiān qù shàng bān ma? Yǐ: Yīnwèi bù shūfu, suǒyǐ wǒ qù kàn yīshēng.",
      "meaning": "A: Bạn sao vậy? B: Tôi đau đầu, không khỏe lắm. A: Hôm nay bạn đi làm không? B: Vì không khỏe nên tôi đi khám.",
      "readingMinutes": 2
    },
