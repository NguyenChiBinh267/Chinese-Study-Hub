  "blocks": [
    {
      "id": "l440-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 车间 chējiān: phân xưởng; 生产 shēngchǎn: sản xuất; 分组 fēnzǔ: chia nhóm; 发放 fāfàng: cấp/phát; tình huống lao động hư cấu, không phải tư vấn pháp lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l440-t0",
      "type": "teaching",
      "title": "工厂 · nhà máy",
      "text": "工厂 là cơ sở sản xuất; không đồng nghĩa mọi 公司 đều có nhà xưởng. Nhận diện chữ 厂 trong 工厂; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这家工厂生产桌子。",
      "pinyin": "Zhè jiā gōngchǎng shēngchǎn zhuōzi.",
      "meaning": "Nhà máy này sản xuất bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l440-t1",
      "type": "teaching",
      "title": "工人 · công nhân",
      "text": "工人 là người làm công việc lao động sản xuất trong ngữ cảnh xưởng.",
      "hanzi": "工人正在检查材料。",
      "pinyin": "Gōngrén zhèngzài jiǎnchá cáiliào.",
      "meaning": "Công nhân đang kiểm tra vật liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l440-t2",
      "type": "teaching",
      "title": "工资 · tiền lương",
      "text": "工资 là khoản trả cho lao động; bài không suy ra thu nhập thực của ngành nào.",
      "hanzi": "公司每月按时发工资。",
      "pinyin": "Gōngsī měi yuè ànshí fā gōngzī.",
      "meaning": "Công ty trả lương đúng hạn hằng tháng.",
      "readingMinutes": 1
    },
    {
      "id": "l440-t3",
      "type": "teaching",
      "title": "干活儿 · làm việc lao động",
      "text": "干活儿 đọc gàn huór, có âm cuốn lưỡi; 干 nghĩa làm khác gān khô.",
      "hanzi": "大家一起干活儿。",
      "pinyin": "Dàjiā yìqǐ gàn huór.",
      "meaning": "Mọi người cùng làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l440-t4",
      "type": "teaching",
      "title": "共同 · cùng, chung",
      "text": "共同 thường bổ nghĩa hoạt động có sự tham gia chung, như 共同完成.",
      "hanzi": "我们共同完成这项工作。",
      "pinyin": "Wǒmen gòngtóng wánchéng zhè xiàng gōngzuò.",
      "meaning": "Chúng tôi cùng hoàn thành công việc này.",
      "readingMinutes": 1
    },
    {
      "id": "l440-t5",
      "type": "teaching",
      "title": "共 · tổng cộng",
      "text": "共 đứng trước số lượng; không dùng nó một mình để diễn đạt làm chung một việc.",
      "hanzi": "车间里共有六名工人。",
      "pinyin": "Chējiān lǐ gòng yǒu liù míng gōngrén.",
      "meaning": "Trong xưởng có tổng cộng sáu công nhân.",
      "readingMinutes": 1
    },
    {
      "id": "l440-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "共 + số lượng tổng hợp: 车间里共有六名工人. 共 nói tổng cộng, không mang nghĩa mọi người đều như 全. 共同 + động từ nhấn mạnh cùng làm; không thay tùy ý 共 bằng 共同 trước số đếm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l440-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "这家小工厂的车间里共有六名工人。大家先检查材料，再分组干活儿。负责人说：“这项工作需要我们共同完成，发现问题要及时说明。”新工人还问了工资的发放时间，公司答复每月按时发。",
      "pinyin": "Zhè jiā xiǎo gōngchǎng de chējiān lǐ gòng yǒu liù míng gōngrén. Dàjiā xiān jiǎnchá cáiliào, zài fēnzǔ gàn huór. Fùzérén shuō: “Zhè xiàng gōngzuò xūyào wǒmen gòngtóng wánchéng, fāxiàn wèntí yào jíshí shuōmíng.” Xīn gōngrén hái wèn le gōngzī de fāfàng shíjiān, gōngsī dáfù měi yuè ànshí fā.",
      "meaning": "Xưởng nhỏ có tổng cộng sáu công nhân. Họ kiểm tra vật liệu rồi chia nhóm làm. Người phụ trách yêu cầu cùng hoàn thành và báo vấn đề kịp thời. Công ty nói lương trả đúng hạn mỗi tháng.",
      "readingMinutes": 2
    },
    {
      "id": "l440-b0",
      "type": "exercise",
      "exerciseVersionId": "l440-v1-e0"
    },
