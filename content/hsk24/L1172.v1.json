  "blocks": [
    {
      "id": "l1172-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder0",
      "type": "teaching",
      "title": "水 · nước",
      "text": "Từ đã học 水 có 1 chữ. Chữ 水 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 水 với 永 / 冰 / 木; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喝水。",
      "pinyin": "Wǒ hē shuǐ.",
      "meaning": "Tôi uống nước.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder1",
      "type": "teaching",
      "title": "米饭 · cơm (gạo đã nấu)",
      "text": "Từ đã học 米饭 có 2 chữ. Chữ 米 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 米 với 来 / 木 / 未; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我吃了米饭。",
      "pinyin": "Wǒ chī le mǐ fàn.",
      "meaning": "Tôi đã ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder2",
      "type": "teaching",
      "title": "菜 · rau; món ăn (theo ngữ cảnh)",
      "text": "Từ đã học 菜 có 1 chữ. Chữ 菜 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 菜 với 采 / 茶 / 莱; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我吃菜。",
      "pinyin": "Wǒ chī cài.",
      "meaning": "Tôi ăn rau/món rau.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder3",
      "type": "teaching",
      "title": "牛奶 · sữa bò",
      "text": "Từ đã học 牛奶 có 2 chữ. Chữ 牛 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 牛 với 午 / 生 / 年; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我喜欢喝牛奶。",
      "pinyin": "Wǒ xǐ huan hē niú nǎi.",
      "meaning": "Tôi thích uống sữa bò.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder4",
      "type": "teaching",
      "title": "面包 · bánh mì",
      "text": "Từ đã học 面包 có 2 chữ. Chữ 面 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 面 với 而 / 回 / 百; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我吃面包。",
      "pinyin": "Wǒ chī miàn bāo.",
      "meaning": "Tôi ăn bánh mì.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reminder5",
      "type": "teaching",
      "title": "面条儿 · mì sợi (dạng hóa r)",
      "text": "Từ đã học 面条儿 có 3 chữ. Chữ 条 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 条 với 各 / 余 / 亲; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我吃面条儿。",
      "pinyin": "Wǒ chī miàn tiáor.",
      "meaning": "Tôi ăn mì sợi.",
      "readingMinutes": 1
    },
    {
      "id": "l1172-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你想吃什么水果？\nB：我想吃苹果。\nA：你有几个苹果？\nB：三个。",
      "pinyin": "A: Nǐ xiǎng chī shén me shuǐ guǒ? B: Wǒ xiǎng chī píng guǒ. A: Nǐ yǒu jǐ ge píng guǒ? B: Sān ge.",
      "meaning": "B muốn ăn táo và nói có3quả.",
      "readingMinutes": 2
    },
