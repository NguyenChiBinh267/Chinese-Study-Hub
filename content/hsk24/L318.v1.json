  "blocks": [
    {
      "id": "l318-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 比较 bǐjiào: tương đối; 舒服 shūfu: dễ chịu; 选 xuǎn: chọn. Đây là đọc tình huống một địa điểm, chưa học dự báo nghe.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l318-t0",
      "type": "teaching",
      "title": "春天 · mùa xuân",
      "text": "春天 chỉ mùa xuân; thời tiết cụ thể phụ thuộc địa điểm, không phải nơi nào mùa xuân cũng ấm.",
      "hanzi": "这里的春天不太冷。",
      "pinyin": "Zhèlǐ de chūntiān bú tài lěng.",
      "meaning": "Mùa xuân ở đây không lạnh lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l318-t1",
      "type": "teaching",
      "title": "冬天 · mùa đông",
      "text": "冬天 là mùa đông; 冬天去 là đi vào mùa đông, không cần 在 trước mọi cụm thời gian.",
      "hanzi": "我不想冬天去那里。",
      "pinyin": "Wǒ bù xiǎng dōngtiān qù nàli.",
      "meaning": "Tôi không muốn đến đó vào mùa đông.",
      "readingMinutes": 1
    },
    {
      "id": "l318-t2",
      "type": "teaching",
      "title": "季节 · mùa",
      "text": "季节 là tên loại khoảng thời gian theo mùa; hỏi 什么季节, không dùng nó thay tên riêng 春天.",
      "hanzi": "你最喜欢什么季节？",
      "pinyin": "Nǐ zuì xǐhuan shénme jìjié?",
      "meaning": "Bạn thích mùa nào nhất?",
      "readingMinutes": 1
    },
    {
      "id": "l318-t3",
      "type": "teaching",
      "title": "秋天 · mùa thu",
      "text": "秋天 là mùa thu, theo thứ tự bốn mùa sau 夏天 và trước 冬天; không đồng nghĩa mỗi ngày mát.",
      "hanzi": "我们打算秋天去看朋友。",
      "pinyin": "Wǒmen dǎsuàn qiūtiān qù kàn péngyou.",
      "meaning": "Chúng tôi định thăm bạn vào mùa thu.",
      "readingMinutes": 1
    },
    {
      "id": "l318-t4",
      "type": "teaching",
      "title": "四季 · bốn mùa",
      "text": "四季 gộp xuân, hạ, thu, đông; không phải mùa thứ tư. 四季都… diễn tả phạm vi cả bốn mùa.",
      "hanzi": "这个城市四季都有人来。",
      "pinyin": "Zhège chéngshì sìjì dōu yǒu rén lái.",
      "meaning": "Thành phố này cả bốn mùa đều có người đến.",
      "readingMinutes": 1
    },
    {
      "id": "l318-t5",
      "type": "teaching",
      "title": "夏天 · mùa hè",
      "text": "夏天 là mùa hè; 太热了 đánh giá nóng quá tại địa điểm đang nói, không phải định nghĩa khí hậu toàn cầu.",
      "hanzi": "这里的夏天很热。",
      "pinyin": "Zhèlǐ de xiàtiān hěn rè.",
      "meaning": "Mùa hè ở đây rất nóng.",
      "readingMinutes": 1
    },
    {
      "id": "l318-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "如果…就… nêu giả thiết và kết quả theo kế hoạch: 如果冬天太冷，我们就春天去. Chưa nói điều kiện đã xảy ra; 就 đứng trước động từ sau chủ ngữ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l318-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：那里四季都冷吗？小王：不是。冬天很冷，夏天很热，春天和秋天比较舒服。小林：那我们选什么季节？小王：如果冬天太冷，我们就春天去。",
      "pinyin": "Xiǎo Lín: Nàli sìjì dōu lěng ma? Xiǎo Wáng: Bú shì. Dōngtiān hěn lěng, xiàtiān hěn rè, chūntiān hé qiūtiān bǐjiào shūfu. Xiǎo Lín: Nà wǒmen xuǎn shénme jìjié? Xiǎo Wáng: Rúguǒ dōngtiān tài lěng, wǒmen jiù chūntiān qù.",
      "meaning": "Hai bạn đối chiếu thời tiết tại nơi định đến và dự kiến đi mùa xuân nếu mùa đông quá lạnh.",
      "readingMinutes": 2
    },
    {
