  "blocks": [
    {
      "id": "l4018-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t0",
      "type": "teaching",
      "title": "填写 · điền",
      "text": "填写 là điền thông tin vào chỗ trống/biểu mẫu; không chỉ viết văn tự do. Nhận diện chữ 填 trong 填写; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请填写这张表格。",
      "pinyin": "Qǐng tián xiě zhè zhāng biǎo gé.",
      "meaning": "Xin điền biểu mẫu này.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t1",
      "type": "teaching",
      "title": "文件 · tài liệu; tệp",
      "text": "文件 có thể là văn bản công việc hoặc tệp; ở đây là tài liệu cuộc họp trên giấy.",
      "hanzi": "桌上的文件需要检查。",
      "pinyin": "Zhuō shàng de wén jiàn xū yào jiǎn chá.",
      "meaning": "Tài liệu trên bàn cần được kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t2",
      "type": "teaching",
      "title": "资料 · tư liệu; hồ sơ",
      "text": "资料 là thông tin/vật liệu tham khảo, không nhất thiết là một văn bản có tên riêng như 文件.",
      "hanzi": "她准备了介绍项目的资料。",
      "pinyin": "Tā zhǔn bèi le jiè shào xiàng mù de zī liào.",
      "meaning": "Cô ấy chuẩn bị tư liệu giới thiệu dự án.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t3",
      "type": "teaching",
      "title": "整理 · sắp xếp; chỉnh lý",
      "text": "整理 là phân loại, sắp lại cho có trật tự; không nhất thiết vứt bỏ tài liệu.",
      "hanzi": "我按日期整理资料。",
      "pinyin": "Wǒ àn rì qī zhěng lǐ zī liào.",
      "meaning": "Tôi sắp tư liệu theo ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t4",
      "type": "teaching",
      "title": "提前 · sớm hơn; trước thời hạn",
      "text": "提前 đặt việc trước mốc dự định; khác 以前 chỉ quá khứ.",
      "hanzi": "请提前十分钟到会议室。",
      "pinyin": "Qǐng tí qián shí fēn zhōng dào huì yì shì.",
      "meaning": "Xin đến phòng họp sớm mười phút.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-t5",
      "type": "teaching",
      "title": "提醒 · nhắc nhở",
      "text": "提醒 là làm người khác nhớ điều cần chú ý, không phải thay họ hoàn thành nhiệm vụ.",
      "hanzi": "同事提醒我带上文件。",
      "pinyin": "Tóng shì tí xǐng wǒ dài shàng wén jiàn.",
      "meaning": "Đồng nghiệp nhắc tôi mang tài liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4018-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把文件看一看 đặt đối tượng 文件 trước cụm động từ lặp 看一看, nghĩa xem qua tài liệu. Chỉ luyện dạng động từ một âm tiết 看, không khẳng định đã luyện toàn bộ các biến thể của hàng nguồn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4018-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "明天要开会，小方今天填写报名表，并按日期整理项目资料。同事提醒他提前十分钟到会议室，不要忘了带文件。小方把文件看一看，发现少了一页，马上补上。确认准备完成以后，他才把资料放进包里。",
      "pinyin": "Míng tiān yào kāi huì, Xiǎo Fāng jīn tiān tián xiě bào míng biǎo, bìng àn rì qī zhěng lǐ xiàng mù zī liào. Tóng shì tí xǐng tā tí qián shí fēn zhōng dào huì yì shì, bú yào wàng le dài wén jiàn. Xiǎo Fāng bǎ wén jiàn kàn yi kàn, fā xiàn shǎo le yí yè, mǎ shàng bǔ shàng. Què rèn zhǔn bèi wán chéng yǐ hòu, tā cái bǎ zī liào fàng jìn bāo lǐ.",
      "meaning": "Tiểu Phương điền phiếu, sắp hồ sơ và kiểm tra; phát hiện thiếu một trang nên bổ sung trước khi bỏ vào túi.",
      "readingMinutes": 2
    },
    {
