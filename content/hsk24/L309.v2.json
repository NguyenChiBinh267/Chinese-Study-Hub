  "blocks": [
    {
      "id": "l309-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 不/没, 很, số lượng và địa điểm. HSK1/2 chưa hoàn chỉnh; chỉ khám phá DRAFT. 医生 yīshēng: bác sĩ; 情况 qíngkuàng: tình trạng (hỗ trợ); 早点儿 zǎo diǎnr: sớm một chút; 祝 zhù: chúc. Hội thoại không dùng để quyết định điều trị hoặc chấm nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l309-t0",
      "type": "teaching",
      "title": "感冒 · cảm/cảm lạnh",
      "text": "感冒 trong lời kể là tên một tình trạng bệnh thông thường; có thể dùng như danh từ hoặc động từ. Học liệu chỉ luyện ngôn ngữ, không hướng dẫn tự chẩn đoán.",
      "hanzi": "小安说他感冒了。",
      "pinyin": "Xiǎo Ān shuō tā gǎnmào le.",
      "meaning": "An nói bạn bị cảm.",
      "readingMinutes": 1
    },
    {
      "id": "l309-t1",
      "type": "teaching",
      "title": "发烧 · sốt",
      "text": "发烧 mô tả bị sốt theo lời kể. Bài không đặt ngưỡng nhiệt độ hoặc suy ra nguyên nhân bệnh từ từ này.",
      "hanzi": "他昨天发烧了，今天来问医生。",
      "pinyin": "Tā zuótiān fāshāo le, jīntiān lái wèn yīshēng.",
      "meaning": "Bạn sốt hôm qua, hôm nay đến hỏi bác sĩ.",
      "readingMinutes": 1
    },
    {
      "id": "l309-t2",
      "type": "teaching",
      "title": "病人 · người bệnh/bệnh nhân",
      "text": "病人 là người đang bệnh hoặc được nói như bệnh nhân trong bối cảnh khám. Không dùng từ này để tự xác định tình trạng của một người ngoài ngữ cảnh.",
      "hanzi": "医生正在和病人说话。",
      "pinyin": "Yīshēng zhèngzài hé bìngrén shuō huà.",
      "meaning": "Bác sĩ đang nói chuyện với bệnh nhân.",
      "readingMinutes": 1
    },
    {
      "id": "l309-t3",
      "type": "teaching",
      "title": "检查 · kiểm tra/khám kiểm tra",
      "text": "检查 chỉ việc xem xét kiểm tra; trong 医生检查身体 là khám/kiểm tra cơ thể. Kết quả chưa được nói nên không thể suy ra bệnh cụ thể.",
      "hanzi": "医生说要检查一下。",
      "pinyin": "Yīshēng shuō yào jiǎnchá yíxià.",
      "meaning": "Bác sĩ nói cần kiểm tra một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l309-t4",
      "type": "teaching",
      "title": "担心 · lo lắng",
      "text": "担心 diễn tả lo về người/việc, như 担心朋友. Cảm xúc lo không phải bằng chứng xác nhận nguy hiểm hoặc chẩn đoán.",
      "hanzi": "妈妈很担心我。",
      "pinyin": "Māma hěn dānxīn wǒ.",
      "meaning": "Mẹ lo cho tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l309-t5",
      "type": "teaching",
      "title": "健康 · khỏe mạnh/sức khỏe tốt",
      "text": "健康 trong 身体健康 miêu tả khỏe. Bài học không chứng nhận sức khỏe hoặc khẳng định hết sốt là đã khỏe hoàn toàn.",
      "hanzi": "我们都希望家人身体健康。",
      "pinyin": "Wǒmen dōu xīwàng jiārén shēntǐ jiànkāng.",
      "meaning": "Chúng tôi đều mong người nhà khỏe mạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l309-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "……的话，就…… đặt giả định trước kết quả/hành động trong tình huống. 你不舒服的话，就告诉我 là lời đề nghị báo thông tin, không phải một chẩn đoán.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l309-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
