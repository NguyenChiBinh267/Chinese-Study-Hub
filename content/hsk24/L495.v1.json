  "blocks": [
    {
      "id": "l495-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder0",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 暑假 shǔjià: nghỉ hè; 活动室 huódòngshì: phòng sinh hoạt; 满头 mǎn tóu: khắp đầu; địa điểm hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder1",
      "type": "teaching",
      "title": "郊区 · ngoại ô",
      "text": "郊区 là vùng ven đô, khác 农村 nói khu vực nông thôn; hai khái niệm có thể giao nhau tùy nơi. Nhận diện chữ 郊 trong 郊区; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她现在住在郊区。",
      "pinyin": "Tā xiànzài zhù zài jiāoqū.",
      "meaning": "Hiện cô sống ngoại ô.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder2",
      "type": "teaching",
      "title": "老家 · quê nhà cũ",
      "text": "老家 thường là quê gốc/nhà ở quê, không đơn giản mọi nhà có tuổi.",
      "hanzi": "暑假我回老家看母亲。",
      "pinyin": "Shǔjià wǒ huí lǎojiā kàn mǔqīn.",
      "meaning": "Nghỉ hè tôi về quê thăm mẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder3",
      "type": "teaching",
      "title": "老年 · tuổi già, cao tuổi",
      "text": "老年 dùng trong 老年人、老年生活; không gọi trực tiếp một người là 一个老年.",
      "hanzi": "社区有老年活动室。",
      "pinyin": "Shèqū yǒu lǎonián huódòngshì.",
      "meaning": "Khu dân cư có phòng sinh hoạt người cao tuổi.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder4",
      "type": "teaching",
      "title": "农村 · nông thôn",
      "text": "农村 chỉ khu vực/làng quê với đặc điểm dân cư, không suy ra nghèo hay giàu từ tên gọi.",
      "hanzi": "他的老家在农村。",
      "pinyin": "Tā de lǎojiā zài nóngcūn.",
      "meaning": "Quê anh ở nông thôn.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder5",
      "type": "teaching",
      "title": "内 · bên trong, trong phạm vi",
      "text": "内 thường đứng sau nơi/khoảng thời gian, như 室内、三天内.",
      "hanzi": "请在三天内回复。",
      "pinyin": "Qǐng zài sān tiān nèi huífù.",
      "meaning": "Hãy trả lời trong ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder6",
      "type": "teaching",
      "title": "汗 · mồ hôi",
      "text": "汗 là chất lỏng tiết khi nóng/vận động; ví dụ không suy ra bệnh.",
      "hanzi": "走到家时他满头是汗。",
      "pinyin": "Zǒu dào jiā shí tā mǎn tóu shì hàn.",
      "meaning": "Về đến nhà đầu anh đẫm mồ hôi.",
      "readingMinutes": 1
    },
    {
      "id": "l495-reminder7",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "尤其 nhấn mạnh một trường hợp nổi bật trong nhận xét: 这里夏天很热，尤其是中午. Không có nghĩa chỉ có duy nhất trường hợp đó. Bài phân biệt đặc điểm một nơi hư cấu với kết luận về toàn bộ nông thôn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l495-reminder8",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小程住在郊区，老家在农村。暑假回去时，他走到家就满头是汗。母亲说这里夏天很热，尤其是中午。村里有老年活动室，老人可以在室内看书。他先陪母亲休息，再给朋友回信，介绍家附近的新变化。",
      "pinyin": "Xiǎo Chéng zhù zài jiāoqū, lǎojiā zài nóngcūn. Shǔjià huí qù shí, tā zǒu dào jiā jiù mǎn tóu shì hàn. Mǔqīn shuō zhèlǐ xiàtiān hěn rè, yóuqí shì zhōngwǔ. Cūn lǐ yǒu lǎonián huódòngshì, lǎorén kěyǐ zài shìnèi kàn shū. Tā xiān péi mǔqīn xiūxi, zài gěi péngyou huí xìn, jièshào jiā fùjìn de xīn biànhuà.",
      "meaning": "Trình sống ngoại ô, quê ở một làng. Về hè nóng, nhất là trưa. Làng có phòng cho người cao tuổi đọc trong nhà. Anh nghỉ cùng mẹ rồi viết thư kể thay đổi quanh nhà.",
      "readingMinutes": 2
    },
