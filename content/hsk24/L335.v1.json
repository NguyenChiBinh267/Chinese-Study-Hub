  "blocks": [
    {
      "id": "l335-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 块 kuài: miếng; 口感 kǒugǎn: cảm nhận vị/kết cấu khi ăn; 咸 xián: mặn chỉ dùng đối chiếu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l335-t0",
      "type": "teaching",
      "title": "冰 · đá (nước đông)",
      "text": "冰 trong 加冰 là đá nước, không phải tên mọi đồ ăn lạnh. 不加冰 chưa có nghĩa đồ uống ấm.",
      "hanzi": "这杯水里没有冰。",
      "pinyin": "Zhè bēi shuǐ lǐ méiyǒu bīng.",
      "meaning": "Cốc nước này không có đá.",
      "readingMinutes": 1
    },
    {
      "id": "l335-t1",
      "type": "teaching",
      "title": "冰激凌 · kem",
      "text": "冰激凌 là món kem; 冰 riêng chỉ đá, không thể thay cả tên món.",
      "hanzi": "她买了一个冰激凌。",
      "pinyin": "Tā mǎi le yí ge bīngjīlíng.",
      "meaning": "Cô ấy mua một cây/phần kem.",
      "readingMinutes": 1
    },
    {
      "id": "l335-t2",
      "type": "teaching",
      "title": "蛋糕 · bánh kem/bánh ngọt dạng cake",
      "text": "蛋糕 là loại cake, không nhất thiết mọi bánh đều có lớp kem; 块 đếm miếng trong ví dụ.",
      "hanzi": "我们分一块蛋糕。",
      "pinyin": "Wǒmen fēn yí kuài dàngāo.",
      "meaning": "Chúng tôi chia một miếng bánh ngọt.",
      "readingMinutes": 1
    },
    {
      "id": "l335-t3",
      "type": "teaching",
      "title": "糖 · đường/kẹo",
      "text": "糖 trong 加糖 là đường, 一块糖 có thể là kẹo hay viên đường tùy tình huống. Bài chọn nghĩa đường cho vào nước.",
      "hanzi": "我喝水不加糖。",
      "pinyin": "Wǒ hē shuǐ bù jiā táng.",
      "meaning": "Tôi uống nước không thêm đường.",
      "readingMinutes": 1
    },
    {
      "id": "l335-t4",
      "type": "teaching",
      "title": "甜 · ngọt",
      "text": "甜 chỉ vị ngọt; 不甜 không tự chứng minh thành phần không đường. Rất ngọt nói 很甜, không cần 是.",
      "hanzi": "这个蛋糕不太甜。",
      "pinyin": "Zhège dàngāo bú tài tián.",
      "meaning": "Bánh này không ngọt lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l335-t5",
      "type": "teaching",
      "title": "西瓜 · dưa hấu",
      "text": "西瓜 là dưa hấu; 一块西瓜 là một miếng, 一个西瓜 là một quả. 瓜 không tự chỉ mọi quả giống nhau.",
      "hanzi": "请给我一块西瓜。",
      "pinyin": "Qǐng gěi wǒ yí kuài xīguā.",
      "meaning": "Hãy cho tôi một miếng dưa hấu.",
      "readingMinutes": 1
    },
    {
      "id": "l335-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一点儿也不甜 phủ định hoàn toàn độ ngọt trong cảm nhận được kể; khác 不太甜 là không ngọt lắm. Không suy ra không có đường chỉ từ cảm nhận.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l335-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "桌上有蛋糕、冰激凌和西瓜。小林选了西瓜，喝不加冰的水。小王尝了一口蛋糕，说不太甜。小林说：我的水没加糖，一点儿也不甜。两人只是在说自己的口感。",
      "pinyin": "Zhuō shàng yǒu dàngāo, bīngjīlíng hé xīguā. Xiǎo Lín xuǎn le xīguā, hē bù jiā bīng de shuǐ. Xiǎo Wáng cháng le yì kǒu dàngāo, shuō bú tài tián. Xiǎo Lín shuō: Wǒ de shuǐ méi jiā táng, yìdiǎnr yě bù tián. Liǎng rén zhǐ shì zài shuō zìjǐ de kǒugǎn.",
      "meaning": "Lâm chọn dưa hấu và nước không đá, không đường. Vương nói bánh không ngọt lắm. Lâm nói nước hoàn toàn không ngọt; đây là cảm nhận của hai người.",
      "readingMinutes": 2
    },
