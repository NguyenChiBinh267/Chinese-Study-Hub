  "blocks": [
    {
      "id": "l4054-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t0",
      "type": "teaching",
      "title": "用来 · dùng để",
      "text": "用来 đứng trước động từ chỉ mục đích sử dụng.",
      "hanzi": "这把尺用来量长度。",
      "pinyin": "Zhè bǎ chǐ yòng lái liáng cháng dù.",
      "meaning": "Thước này dùng để đo chiều dài.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t1",
      "type": "teaching",
      "title": "用于 · được dùng vào; dùng cho",
      "text": "用于 thường gặp trong văn viết, theo sau lĩnh vực/mục đích.",
      "hanzi": "这些工具用于课堂演示。",
      "pinyin": "Zhè xiē gōng jù yòng yú kè táng yǎn shì.",
      "meaning": "Các công cụ này dùng cho minh họa trong lớp.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t2",
      "type": "teaching",
      "title": "算 · tính; tính toán",
      "text": "算 ở đây là thực hiện phép tính, khác đo bằng thước.",
      "hanzi": "请算一下两次记录的差。",
      "pinyin": "Qǐng suàn yí xià liǎng cì jì lù de chā.",
      "meaning": "Hãy tính chênh lệch giữa hai lần ghi.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t3",
      "type": "teaching",
      "title": "数 · số",
      "text": "数 đọc shù khi là danh từ con số; không đọc shǔ của động từ đếm.",
      "hanzi": "这个数比十小。",
      "pinyin": "Zhè ge shù bǐ shí xiǎo.",
      "meaning": "Con số này nhỏ hơn mười.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t4",
      "type": "teaching",
      "title": "详细 · chi tiết",
      "text": "详细 tả mức độ đầy đủ của lời giải thích/tài liệu. Nhận diện chữ 详 trong 详细; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她作了详细的说明。",
      "pinyin": "Tā zuò le xiáng xì de shuō míng.",
      "meaning": "Cô ấy giải thích chi tiết.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-t5",
      "type": "teaching",
      "title": "准确 · chính xác",
      "text": "准确 tả đúng với thực tế/chuẩn; không chỉ nhiều chữ số.",
      "hanzi": "请确认记录是否准确。",
      "pinyin": "Qǐng què rèn jì lù shì fǒu zhǔn què.",
      "meaning": "Hãy xác nhận bản ghi có chính xác không.",
      "readingMinutes": 1
    },
    {
      "id": "l4054-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… nối hai việc đều cần làm trong cuộc trình bày, không phải hai lựa chọn loại trừ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4054-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "这些工具用于课堂演示，尺用来量长度，计算器用来算差。小组详细说明每个数的单位：“不仅要写结果，还要说明怎么测量，才能检查记录是否准确。”",
      "pinyin": "Zhè xiē gōng jù yòng yú kè táng yǎn shì, chǐ yòng lái liáng cháng dù, jì suàn qì yòng lái suàn chā. Xiǎo zǔ xiáng xì shuō míng měi ge shù de dān wèi: “Bù jǐn yào xiě jié guǒ, hái yào shuō míng zěn me cè liáng, cái néng jiǎn chá jì lù shì fǒu zhǔn què.”",
      "meaning": "Nhóm ghi đơn vị và cách đo để người khác kiểm tra kết quả.",
      "readingMinutes": 2
    },
    {
