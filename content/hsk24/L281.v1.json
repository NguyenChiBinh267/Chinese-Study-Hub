  "blocks": [
    {
      "id": "l281-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder0",
      "type": "teaching",
      "title": "丈夫 · chồng",
      "text": "丈夫 trong quan hệ gia đình là chồng; 夫 đọc nhẹ. Không dịch theo từng chữ thành đàn ông nói chung.",
      "hanzi": "她的丈夫是老师。",
      "pinyin": "Tā de zhàngfu shì lǎoshī.",
      "meaning": "Chồng cô ấy là giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder1",
      "type": "teaching",
      "title": "自己 · bản thân, tự mình",
      "text": "自己 chỉ chính người đang được nói đến. 我自己做 nhấn mạnh tôi tự làm; không mặc định đang ở một mình.",
      "hanzi": "这些事情我自己做。",
      "pinyin": "Zhèxiē shìqing wǒ zìjǐ zuò.",
      "meaning": "Những việc này tôi tự làm.",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder2",
      "type": "teaching",
      "title": "经常 · thường xuyên",
      "text": "经常 nói việc lặp lại khá thường xuyên, không nhất thiết mỗi ngày.",
      "hanzi": "我经常跑步。",
      "pinyin": "Wǒ jīngcháng pǎobù.",
      "meaning": "Tôi thường xuyên chạy bộ.",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder3",
      "type": "teaching",
      "title": "有时 · đôi lúc",
      "text": "有时 đặt trước hoạt động để nói chỉ xảy ra vào một số lúc; không đồng nghĩa luôn luôn.",
      "hanzi": "我有时在家运动。",
      "pinyin": "Wǒ yǒushí zài jiā yùndòng.",
      "meaning": "Đôi lúc tôi vận động ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder4",
      "type": "teaching",
      "title": "游泳 · bơi",
      "text": "游泳 chỉ bơi, không phải đi du lịch. 游泳 và 旅游 đều có 游 nhưng nghĩa toàn từ khác.",
      "hanzi": "星期天我们去游泳。",
      "pinyin": "Xīngqītiān wǒmen qù yóuyǒng.",
      "meaning": "Chủ nhật chúng tôi đi bơi.",
      "readingMinutes": 1
    },
    {
      "id": "l281-reminder5",
      "type": "teaching",
      "title": "爱好 · sở thích",
      "text": "爱好 ở đây là danh từ trong 我的爱好. Không nhầm với 喜欢 khi điền câu 是我的爱好.",
      "hanzi": "打篮球是我的爱好。",
      "pinyin": "Dǎ lánqiú shì wǒ de àihào.",
      "meaning": "Chơi bóng rổ là sở thích của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l281-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "今天是奶奶的生日。我和妻子去看奶奶，爷爷也在家。我们一起吃饭。奶奶说：今天我很高兴。",
      "pinyin": "Jīntiān shì nǎinai de shēngrì. Wǒ hé qīzi qù kàn nǎinai, yéye yě zài jiā. Wǒmen yìqǐ chī fàn. Nǎinai shuō: Jīntiān wǒ hěn gāoxìng.",
      "meaning": "Hôm nay là sinh nhật bà nội. Tôi cùng vợ đến thăm bà, ông nội cũng ở nhà. Chúng tôi cùng ăn cơm. Bà nói: Hôm nay bà rất vui.",
      "readingMinutes": 2
    },
    {
      "id": "l281-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你经常做什么运动？乙：我经常跑步，有时游泳。甲：你和谁一起跑步？乙：有时和朋友一起，有时自己去。",
      "pinyin": "Jiǎ: Nǐ jīngcháng zuò shénme yùndòng? Yǐ: Wǒ jīngcháng pǎobù, yǒushí yóuyǒng. Jiǎ: Nǐ hé shéi yìqǐ pǎobù? Yǐ: Yǒushí hé péngyou yìqǐ, yǒushí zìjǐ qù.",
      "meaning": "A: Bạn thường tập môn gì? B: Tôi thường chạy bộ, đôi lúc bơi. A: Bạn chạy với ai? B: Có lúc với bạn, có lúc tự đi.",
      "readingMinutes": 2
    },
    {
      "id": "l281-context2",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的爱好是什么？乙：我喜欢踢足球，也喜欢跳舞。甲：星期天一起踢球吧。乙：好！我妹妹不踢球，她去跳舞。",
      "pinyin": "Jiǎ: Nǐ de àihào shì shénme? Yǐ: Wǒ xǐhuan tī zúqiú, yě xǐhuan tiàowǔ. Jiǎ: Xīngqītiān yìqǐ tī qiú ba. Yǐ: Hǎo! Wǒ mèimei bù tī qiú, tā qù tiàowǔ.",
      "meaning": "A: Sở thích của bạn là gì? B: Tôi thích đá bóng, cũng thích nhảy múa. A: Chủ nhật cùng đá bóng nhé. B: Được! Em gái tôi không đá bóng, em đi nhảy múa.",
      "readingMinutes": 2
    },
