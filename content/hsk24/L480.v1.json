  "blocks": [
    {
      "id": "l480-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 修改 xiūgǎi: sửa; 补充 bǔchōng: bổ sung; 表达 biǎodá: diễn đạt; 报告 bàogào: báo cáo.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l480-t0",
      "type": "teaching",
      "title": "不论 · bất luận",
      "text": "不论 thường kết hợp 都/也, không dùng kết luận tùy tiện khi thiếu các trường hợp so sánh.",
      "hanzi": "不论题目难不难，都要认真读。",
      "pinyin": "Búlùn tímù nán bu nán, dōu yào rènzhēn dú.",
      "meaning": "Bất luận đề khó không, đều cần đọc kỹ.",
      "readingMinutes": 1
    },
    {
      "id": "l480-t1",
      "type": "teaching",
      "title": "不管 · bất kể",
      "text": "不管 gần nghĩa 不论 trong cấu trúc bất kể; còn nghĩa không quản chưa dạy.",
      "hanzi": "不管结果怎样，我们都总结经验。",
      "pinyin": "Bùguǎn jiéguǒ zěnyàng, wǒmen dōu zǒngjié jīngyàn.",
      "meaning": "Bất kể kết quả thế nào, chúng tôi đều rút kinh nghiệm.",
      "readingMinutes": 1
    },
    {
      "id": "l480-t2",
      "type": "teaching",
      "title": "部分 · bộ phận, phần",
      "text": "部分 bù fen với fen nhẹ chỉ một phần, không tự nói quá nửa.",
      "hanzi": "这部分材料需要修改。",
      "pinyin": "Zhè bùfen cáiliào xūyào xiūgǎi.",
      "meaning": "Phần tài liệu này cần sửa.",
      "readingMinutes": 1
    },
    {
      "id": "l480-t3",
      "type": "teaching",
      "title": "方面 · phương diện",
      "text": "方面 dùng cho mặt/góc xem xét; khác 部分 là bộ phận cấu thành.",
      "hanzi": "我们从两个方面讨论。",
      "pinyin": "Wǒmen cóng liǎng ge fāngmiàn tǎolùn.",
      "meaning": "Chúng tôi thảo luận từ hai phương diện.",
      "readingMinutes": 1
    },
    {
      "id": "l480-t4",
      "type": "teaching",
      "title": "分为 · chia thành",
      "text": "分为 + các nhóm/phần chỉ phân loại; khác 分给 là chia cho ai.",
      "hanzi": "材料分为三类。",
      "pinyin": "Cáiliào fēnwéi sān lèi.",
      "meaning": "Tài liệu chia thành ba loại.",
      "readingMinutes": 1
    },
    {
      "id": "l480-t5",
      "type": "teaching",
      "title": "份 · bản, suất, phần (lượng từ)",
      "text": "份 đếm bản tài liệu/suất ăn; ở đây 一份报告, không đếm cây. Nhận diện chữ 份 trong 份; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请准备一份报告。",
      "pinyin": "Qǐng zhǔnbèi yí fèn bàogào.",
      "meaning": "Hãy chuẩn bị một bản báo cáo.",
      "readingMinutes": 1
    },
    {
      "id": "l480-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一 + lượng từ + 比 + 一 + lượng từ + tính từ biểu thị tăng dần qua từng đơn vị: 报告一份比一份清楚. Không có nghĩa chỉ đúng hai bản. Bài so sánh bản trình bày qua các lần luyện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l480-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小组把材料分为三类，先修改需要补充的部分，再从内容和表达两个方面讨论。老师看了几次练习，说：“报告一份比一份清楚。”不论题目难不难，大家都先读要求；不管结果怎样，最后都总结经验。",
      "pinyin": "Xiǎozǔ bǎ cáiliào fēnwéi sān lèi, xiān xiūgǎi xūyào bǔchōng de bùfen, zài cóng nèiróng hé biǎodá liǎng ge fāngmiàn tǎolùn. Lǎoshī kàn le jǐ cì liànxí, shuō: “Bàogào yí fèn bǐ yí fèn qīngchu.” Búlùn tímù nán bu nán, dàjiā dōu xiān dú yāoqiú; bùguǎn jiéguǒ zěnyàng, zuìhòu dōu zǒngjié jīngyàn.",
      "meaning": "Nhóm phân tài liệu ba loại, bổ sung phần còn thiếu và thảo luận nội dung/cách diễn đạt. Thầy nhận xét mỗi bản rõ hơn. Dù đề khó hay kết quả thế nào, nhóm vẫn đọc yêu cầu và rút kinh nghiệm.",
      "readingMinutes": 2
    },
    {
