  "blocks": [
    {
      "id": "l361-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 举行 jǔxíng: tổ chức; 画展 huàzhǎn: triển lãm tranh; 参观 cānguān: tham quan; 知名程度 zhīmíng chéngdù: mức độ được biết; 理由 lǐyóu: lý do.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l361-t0",
      "type": "teaching",
      "title": "画家 · họa sĩ",
      "text": "画家 gọi người chuyên vẽ/người làm nghề hội họa, 家 ở đây là hậu tố chỉ người; không phải căn nhà chứa tranh.",
      "hanzi": "这位画家住在这里。",
      "pinyin": "Zhè wèi huàjiā zhù zài zhèlǐ.",
      "meaning": "Họa sĩ này sống ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l361-t1",
      "type": "teaching",
      "title": "名人 · người nổi tiếng",
      "text": "名人 là người được nhiều người biết; không đồng nghĩa người luôn đúng hay có chuyên môn mọi lĩnh vực.",
      "hanzi": "今天有一位名人来学校。",
      "pinyin": "Jīntiān yǒu yí wèi míngrén lái xuéxiào.",
      "meaning": "Hôm nay có một người nổi tiếng đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l361-t2",
      "type": "teaching",
      "title": "有名 · nổi tiếng",
      "text": "有名 là được biết nhiều theo phạm vi/ngữ cảnh; 画家很有名 không tự chứng minh từng bức tranh đẹp.",
      "hanzi": "这位画家很有名。",
      "pinyin": "Zhè wèi huàjiā hěn yǒumíng.",
      "meaning": "Họa sĩ này rất nổi tiếng.",
      "readingMinutes": 1
    },
    {
      "id": "l361-t3",
      "type": "teaching",
      "title": "世界 · thế giới",
      "text": "世界 chỉ thế giới; 世界各地 là nhiều nơi trên thế giới, chưa nói mọi nơi không có ngoại lệ.",
      "hanzi": "她想看世界各地的画。",
      "pinyin": "Tā xiǎng kàn shìjiè gè dì de huà.",
      "meaning": "Cô ấy muốn xem tranh ở nhiều nơi trên thế giới.",
      "readingMinutes": 1
    },
    {
      "id": "l361-t4",
      "type": "teaching",
      "title": "市 · thành phố (đơn vị địa danh)",
      "text": "市 trong 本市 là thành phố này, thường sau tên địa danh ở Trung Quốc; không phải 市 trường trong mọi từ ghép.",
      "hanzi": "这次活动在本市举行。",
      "pinyin": "Zhè cì huódòng zài běn shì jǔxíng.",
      "meaning": "Hoạt động này tổ chức ở thành phố này.",
      "readingMinutes": 1
    },
    {
      "id": "l361-t5",
      "type": "teaching",
      "title": "外地 · địa phương khác/nơi khác",
      "text": "外地 là nơi khác với địa phương đang nói, không nhất thiết là nước ngoài. 外地来的人 có thể cùng một quốc gia.",
      "hanzi": "他从外地来看画。",
      "pinyin": "Tā cóng wàidì lái kàn huà.",
      "meaning": "Anh ấy từ địa phương khác đến xem tranh.",
      "readingMinutes": 1
    },
    {
      "id": "l361-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "—家 trong 画家 chỉ người có chuyên môn/nghề liên quan, khác 家 là nhà. 有名 không tự chứng minh giỏi ở mọi kỹ năng; 世界 nêu phạm vi thế giới trong bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l361-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "本市举行画展，一位有名的画家来了，也有外地的名人来参观。小林想看世界各地的画。他说：有名是知名程度，不是每一幅画都必须喜欢的理由。",
      "pinyin": "Běn shì jǔxíng huàzhǎn, yí wèi yǒumíng de huàjiā lái le, yě yǒu wàidì de míngrén lái cānguān. Xiǎo Lín xiǎng kàn shìjiè gè dì de huà. Tā shuō: Yǒumíng shì zhīmíng chéngdù, bú shì měi yì fú huà dōu bìxū xǐhuan de lǐyóu.",
      "meaning": "Thành phố mở triển lãm, có họa sĩ và người nổi tiếng từ nơi khác đến. Lâm muốn xem tranh nhiều nơi nhưng không coi nổi tiếng là buộc phải thích mọi tranh.",
      "readingMinutes": 2
    },
    {
      "id": "l361-b0",
      "type": "exercise",
      "exerciseVersionId": "l361-v1-e0"
    },
    {
