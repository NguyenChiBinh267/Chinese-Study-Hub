  "blocks": [
    {
      "id": "l450-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 入口 rùkǒu: lối vào; 欣赏 xīnshǎng: thưởng thức/ngắm; 古老 gǔlǎo: cổ xưa; 集合 jíhé: tập trung.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l450-t0",
      "type": "teaching",
      "title": "江 · sông lớn",
      "text": "江 thường trong tên sông và cách nói 江边; không dùng cho mọi dòng suối nhỏ.",
      "hanzi": "这条江经过两座城。",
      "pinyin": "Zhè tiáo jiāng jīngguò liǎng zuò chéng.",
      "meaning": "Sông này chảy qua hai thành phố.",
      "readingMinutes": 1
    },
    {
      "id": "l450-t1",
      "type": "teaching",
      "title": "景点 · điểm tham quan",
      "text": "景点 là một điểm có thể tham quan; 景区 có thể gồm nhiều 景点. Nhận diện chữ 景 trong 景点; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个景点离入口不远。",
      "pinyin": "Zhè ge jǐngdiǎn lí rùkǒu bù yuǎn.",
      "meaning": "Điểm tham quan này không xa lối vào.",
      "readingMinutes": 1
    },
    {
      "id": "l450-t2",
      "type": "teaching",
      "title": "景区 · khu thắng cảnh",
      "text": "景区 là khu vực du lịch/cảnh quan có phạm vi; không chỉ một điểm.",
      "hanzi": "景区里有三个景点。",
      "pinyin": "Jǐngqū lǐ yǒu sān ge jǐngdiǎn.",
      "meaning": "Khu thắng cảnh có ba điểm tham quan.",
      "readingMinutes": 1
    },
    {
      "id": "l450-t3",
      "type": "teaching",
      "title": "景色 · cảnh sắc",
      "text": "景色 và 风景 thường gần nghĩa; bài chỉ yêu cầu dạng chứa chữ 色.",
      "hanzi": "江边的景色很美。",
      "pinyin": "Jiāng biān de jǐngsè hěn měi.",
      "meaning": "Cảnh sắc bên sông đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l450-t4",
      "type": "teaching",
      "title": "美景 · cảnh đẹp",
      "text": "美景 là danh từ cảnh đẹp; khác 美丽 là tính từ.",
      "hanzi": "游客停下来欣赏美景。",
      "pinyin": "Yóukè tíng xià lái xīnshǎng měijǐng.",
      "meaning": "Khách dừng lại ngắm cảnh đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l450-t5",
      "type": "teaching",
      "title": "美丽 · đẹp",
      "text": "美丽 là tính từ tả vẻ đẹp, không dùng như danh từ đếm 一处美丽.",
      "hanzi": "这里有一座美丽的桥。",
      "pinyin": "Zhèlǐ yǒu yí zuò měilì de qiáo.",
      "meaning": "Ở đây có cây cầu đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l450-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅……还…… nối hai ưu điểm/ý cùng hướng; vế sau bổ sung hoặc nâng mức: 景区不仅有江边美景，还有古老的房子. Không tự biến một nhận xét thành chứng cứ khách quan.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l450-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "景区地图上标出三个景点：江边的桥、老街和小山。导游说：“这里不仅有江边美景，还有古老的房子。”游客走到桥上，看见美丽的景色，想多停一会儿。导游提醒大家，下午先去老街，再上小山，不要错过集合时间。",
      "pinyin": "Jǐngqū dìtú shàng biāo chū sān ge jǐngdiǎn: jiāng biān de qiáo, lǎo jiē hé xiǎo shān. Dǎoyóu shuō: “Zhèlǐ bùjǐn yǒu jiāng biān měijǐng, hái yǒu gǔlǎo de fángzi.” Yóukè zǒu dào qiáo shàng, kànjiàn měilì de jǐngsè, xiǎng duō tíng yíhuìr. Dǎoyóu tíxǐng dàjiā, xiàwǔ xiān qù lǎo jiē, zài shàng xiǎo shān, bú yào cuòguò jíhé shíjiān.",
      "meaning": "Bản đồ có cầu, phố cổ và núi nhỏ. Hướng dẫn nói ngoài cảnh sông còn có nhà cổ. Chiều đoàn đi phố trước rồi núi; cần nhớ giờ tập trung.",
      "readingMinutes": 2
    },
