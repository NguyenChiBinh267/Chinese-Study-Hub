  "blocks": [
    {
      "id": "l4019-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t0",
      "type": "teaching",
      "title": "演 · diễn",
      "text": "演 là động từ diễn vai/vở; khác 演员 là người diễn.",
      "hanzi": "他在短剧里演一位老师。",
      "pinyin": "Tā zài duǎn jù lǐ yǎn yí wèi lǎo shī.",
      "meaning": "Anh ấy diễn một giáo viên trong kịch ngắn.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t1",
      "type": "teaching",
      "title": "演唱 · hát biểu diễn",
      "text": "演唱 là trình bày bài hát trước người nghe, không phải mọi lần hát tự do.",
      "hanzi": "她演唱了一首新歌。",
      "pinyin": "Tā yǎn chàng le yì shǒu xīn gē.",
      "meaning": "Cô ấy trình bày một bài hát mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t2",
      "type": "teaching",
      "title": "演出 · biểu diễn; buổi diễn",
      "text": "演出 ở đây là hoạt động/buổi biểu diễn, không chỉ một diễn viên.",
      "hanzi": "演出下午三点开始。",
      "pinyin": "Yǎn chū xià wǔ sān diǎn kāi shǐ.",
      "meaning": "Buổi diễn bắt đầu lúc ba giờ chiều.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t3",
      "type": "teaching",
      "title": "演员 · diễn viên",
      "text": "演员 chỉ người biểu diễn vai hoặc tiết mục, không phải tên tác phẩm.",
      "hanzi": "这位演员正在准备上台。",
      "pinyin": "Zhè wèi yǎn yuán zhèng zài zhǔn bèi shàng tái.",
      "meaning": "Diễn viên này đang chuẩn bị lên sân khấu.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t4",
      "type": "teaching",
      "title": "首 · lượng từ cho bài hát, bài thơ",
      "text": "首 dùng để đếm bài hát/thơ, khác 首都 là thủ đô.",
      "hanzi": "节目单上有两首歌。",
      "pinyin": "Jié mù dān shàng yǒu liǎng shǒu gē.",
      "meaning": "Trên chương trình có hai bài hát.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-t5",
      "type": "teaching",
      "title": "弹 · đàn; chơi nhạc cụ dây/phím",
      "text": "弹 đọc tán khi nói chơi đàn; không dùng âm dàn của viên đạn ở đây. Nhận diện chữ 弹 trong 弹; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他会弹钢琴。",
      "pinyin": "Tā huì tán gāng qín.",
      "meaning": "Anh ấy biết chơi piano.",
      "readingMinutes": 1
    },
    {
      "id": "l4019-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "嗯 (ńg) trong lời đáp biểu thị đã nghe/đồng ý ở tình huống này. Nghĩa và ngữ điệu phụ thuộc ngữ cảnh; bài chỉ đọc văn bản, không kiểm tra phát âm hoặc nghe. Hàng nguồn còn có 啊 chưa được bao phủ toàn bộ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4019-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社团的演出下午三点开始。小文在短剧里演老师，其他演员帮忙准备道具。接着，小兰演唱一首歌，小陈弹钢琴。负责人问：“节目单准备好了吗？”小文回答：“嗯，准备好了。”这是一段阅读材料，没有配套音乐或表演视频。",
      "pinyin": "Shè tuán de yǎn chū xià wǔ sān diǎn kāi shǐ. Xiǎo Wén zài duǎn jù lǐ yǎn lǎo shī, qí tā yǎn yuán bāng máng zhǔn bèi dào jù. Jiē zhe, Xiǎo Lán yǎn chàng yì shǒu gē, Xiǎo Chén tán gāng qín. Fù zé rén wèn: “Jié mù dān zhǔn bèi hǎo le ma?” Xiǎo Wén huí dá: “Ńg, zhǔn bèi hǎo le.” Zhè shì yí duàn yuè dú cái liào, méi yǒu pèi tào yīn yuè huò biǎo yǎn shì pín.",
      "meaning": "Câu lạc bộ chuẩn bị kịch và bài hát; 嗯 là lời đáp đã chuẩn bị xong. Bài chỉ có chữ, không có nhạc hay video.",
      "readingMinutes": 2
    },
