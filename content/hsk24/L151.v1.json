  "blocks": [
    {
      "id": "l151-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l151-t0",
      "type": "teaching",
      "title": "起床 · dậy; ra khỏi giường",
      "text": "起床 nói việc dậy khỏi giường; câu không tự cho biết giờ cụ thể.",
      "hanzi": "我早上起床。",
      "pinyin": "Wǒ zǎo shang qǐ chuáng.",
      "meaning": "Tôi dậy vào buổi sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l151-t1",
      "type": "teaching",
      "title": "睡 · ngủ (dạng một chữ)",
      "text": "睡 là mục một chữ; 睡觉 cũng có thể dùng ở nhiều câu nhưng là mục khác.",
      "hanzi": "我想睡。",
      "pinyin": "Wǒ xiǎng shuì.",
      "meaning": "Tôi muốn ngủ.",
      "readingMinutes": 1
    },
    {
      "id": "l151-t2",
      "type": "teaching",
      "title": "睡觉 · ngủ (dạng hai chữ)",
      "text": "睡觉 là cụm hai chữ chỉ ngủ; giữ đúng dạng được hỏi, không suy khác biệt nghĩa tuyệt đối với 睡.",
      "hanzi": "我晚上睡觉。",
      "pinyin": "Wǒ wǎn shang shuì jiào.",
      "meaning": "Tôi ngủ buổi tối.",
      "readingMinutes": 1
    },
    {
      "id": "l151-t3",
      "type": "teaching",
      "title": "了 · rồi; trợ từ le",
      "text": "了 nhẹ trong mục này; ở 起床了 báo đã dậy/chuyển trạng thái, khác cách đọc liǎo ở mục/ngữ cảnh khác.",
      "hanzi": "我起床了。",
      "pinyin": "Wǒ qǐ chuáng le.",
      "meaning": "Tôi dậy rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l151-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "起床 là ra khỏi giường/thức dậy để bắt đầu sinh hoạt; không đồng nghĩa chỉ tỉnh giấc mà vẫn nằm. 睡 và 睡觉 đều có thể nói ngủ, nên đề yêu cầu rõ từ một chữ hoặc cả cụm. 了 ở 我起床了 báo tình trạng mới; không biến mọi 了 thành dấu quá khứ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l151-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你起床了吗？\nB：起床了。\nA：你昨天晚上睡觉了吗？\nB：睡觉了。",
      "pinyin": "A: Nǐ qǐ chuáng le ma? B: Qǐ chuáng le. A: Nǐ zuó tiān wǎn shang shuì jiào le ma? B: Shuì jiào le.",
      "meaning": "B xác nhận đã dậy và đã ngủ tối hôm qua. Không có dữ kiện về thời lượng hoặc chất lượng giấc ngủ để đánh giá sức khỏe.",
      "readingMinutes": 2
    },
