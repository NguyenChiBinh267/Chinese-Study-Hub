  "blocks": [
    {
      "id": "l386-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder0",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 颗 kē: lượng từ răng; 把 bǎ trong 一把牙刷 là lượng từ, khác giới từ ở 把衣服放进…. 进 jìn: vào; 长 zhǎng: mọc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder1",
      "type": "teaching",
      "title": "牙 · răng",
      "text": "牙 là răng; 一颗牙 chỉ một chiếc. 刷牙 là đánh răng, không phải 洗牙 trong mọi ngữ cảnh.",
      "hanzi": "孩子长了一颗新牙。",
      "pinyin": "Háizi zhǎng le yì kē xīn yá.",
      "meaning": "Đứa trẻ mọc một chiếc răng mới.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder2",
      "type": "teaching",
      "title": "牙刷 · bàn chải đánh răng",
      "text": "牙刷 là dụng cụ để đánh răng, khác 牙 là răng và 刷 là động tác chải. 一把牙刷 dùng 把 đếm dụng cụ.",
      "hanzi": "这是我的牙刷。",
      "pinyin": "Zhè shì wǒ de yáshuā.",
      "meaning": "Đây là bàn chải đánh răng của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder3",
      "type": "teaching",
      "title": "刷 · chải/đánh (bằng bàn chải)",
      "text": "刷 nhận tân ngữ như 牙; 刷牙 là đánh răng, 刷鞋 là chải giày. Không gộp mọi động tác rửa vào 刷.",
      "hanzi": "我早上刷牙。",
      "pinyin": "Wǒ zǎoshang shuā yá.",
      "meaning": "Buổi sáng tôi đánh răng.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder4",
      "type": "teaching",
      "title": "洗澡 · tắm",
      "text": "洗澡 là tắm; đối tượng người thường không đặt thẳng sau từ. 给孩子洗澡 là tắm cho trẻ, khác 洗澡孩子.",
      "hanzi": "我晚上洗澡。",
      "pinyin": "Wǒ wǎnshang xǐ zǎo.",
      "meaning": "Buổi tối tôi tắm.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder5",
      "type": "teaching",
      "title": "习惯 · thói quen; quen với",
      "text": "习惯 có thể là danh từ hoặc động từ; 生活习惯 là thói quen sinh hoạt, 习惯这里的生活 là quen cuộc sống nơi đây.",
      "hanzi": "我还不习惯这里的生活。",
      "pinyin": "Wǒ hái bù xíguàn zhèlǐ de shēnghuó.",
      "meaning": "Tôi còn chưa quen cuộc sống ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder6",
      "type": "teaching",
      "title": "脏 · bẩn",
      "text": "脏 zāng là bẩn trong bài; khác zàng ở từ chỉ nội tạng. 衣服脏了 mô tả quần áo đã bẩn, không đánh giá con người.",
      "hanzi": "这件衣服脏了，要洗。",
      "pinyin": "Zhè jiàn yīfu zāng le, yào xǐ.",
      "meaning": "Chiếc áo này bẩn rồi, cần giặt.",
      "readingMinutes": 1
    },
    {
      "id": "l386-reminder7",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "先…再/然后… xếp thứ tự hành động. 先刷牙，再洗澡 nêu kế hoạch cụ thể; không phải quy tắc bắt buộc cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l386-reminder8",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林刚搬家，还不习惯新的生活。晚上他先拿自己的牙刷刷牙，然后洗澡，把脏衣服放进洗衣机。姐姐说：牙刷不要跟别人的放在一起，先找好自己的。",
      "pinyin": "Xiǎo Lín gāng bān jiā, hái bù xíguàn xīn de shēnghuó. Wǎnshang tā xiān ná zìjǐ de yáshuā shuā yá, ránhòu xǐ zǎo, bǎ zāng yīfu fàng jìn xǐyījī. Jiějie shuō: Yáshuā bú yào gēn biéren de fàng zài yìqǐ, xiān zhǎo hǎo zìjǐ de.",
      "meaning": "Lâm mới chuyển nhà nên chưa quen. Tối cậu lấy bàn chải của mình đánh răng, tắm rồi cho quần áo bẩn vào máy giặt; chị nhắc phân biệt bàn chải của mỗi người.",
      "readingMinutes": 2
    },
