  "blocks": [
    {
      "id": "l4007-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t0",
      "type": "teaching",
      "title": "散步 · đi dạo",
      "text": "散步 là đi bộ thư thả để thư giãn; không chỉ mọi hình thức di chuyển bằng chân.",
      "hanzi": "我们晚饭后去散步。",
      "pinyin": "Wǒ men wǎn fàn hòu qù sàn bù.",
      "meaning": "Sau bữa tối chúng tôi đi dạo.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t1",
      "type": "teaching",
      "title": "森林 · rừng",
      "text": "森林 chỉ vùng rừng có hệ cây cối rộng; khác một cụm cây nhỏ trong khu phố.",
      "hanzi": "这片森林里有很多植物。",
      "pinyin": "Zhè piàn sēn lín lǐ yǒu hěn duō zhí wù.",
      "meaning": "Khu rừng này có nhiều thực vật.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t2",
      "type": "teaching",
      "title": "树林 · rặng cây; khu có cây",
      "text": "树林 là khu tập trung cây; có thể nhỏ hơn 森林, không mặc định là rừng nguyên sinh.",
      "hanzi": "公园北边有一片树林。",
      "pinyin": "Gōng yuán běi bian yǒu yí piàn shù lín.",
      "meaning": "Phía bắc công viên có một rặng cây.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t3",
      "type": "teaching",
      "title": "叶子 · lá cây",
      "text": "叶子 chỉ lá, không phải cánh hoa; 子 đọc nhẹ.",
      "hanzi": "秋天的叶子变黄了。",
      "pinyin": "Qiū tiān de yè zi biàn huáng le.",
      "meaning": "Lá cây vào mùa thu đã chuyển vàng.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t4",
      "type": "teaching",
      "title": "植物 · thực vật",
      "text": "植物 bao gồm cây, cỏ và nhiều dạng sống khác; không đồng nghĩa chỉ cây gỗ. Nhận diện chữ 植 trong 植物; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "老师带我们观察植物。",
      "pinyin": "Lǎo shī dài wǒ men guān chá zhí wù.",
      "meaning": "Thầy cô dẫn chúng tôi quan sát thực vật.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-t5",
      "type": "teaching",
      "title": "土 · đất",
      "text": "土 trong ngữ cảnh trồng cây là đất, không phải quốc gia hoặc sắc thái quê mùa.",
      "hanzi": "花盆里的土有点儿干。",
      "pinyin": "Huā pén lǐ de tǔ yǒu diǎnr gān.",
      "meaning": "Đất trong chậu hoa hơi khô.",
      "readingMinutes": 1
    },
    {
      "id": "l4007-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一草一木 là cụm cố định theo mẫu 一A一B, nghĩa là từng ngọn cỏ, từng cây, nhấn mạnh mọi cây cỏ. Không tự ghép tùy ý mọi danh từ theo mẫu này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4007-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "星期天，我们去公园散步。北边的树林不大，不能跟真正的森林相比。老师让我们观察植物：有的叶子很宽，有的很细。花盆里的土有点儿干。大家只看、不摘叶子。老师说：“请爱护这里的一草一木。”",
      "pinyin": "Xīng qī tiān, wǒ men qù gōng yuán sàn bù. Běi bian de shù lín bú dà, bù néng gēn zhēn zhèng de sēn lín xiāng bǐ. Lǎo shī ràng wǒ men guān chá zhí wù: yǒu de yè zi hěn kuān, yǒu de hěn xì. Huā pén lǐ de tǔ yǒu diǎnr gān. Dà jiā zhǐ kàn, bù zhāi yè zi. Lǎo shī shuō: “Qǐng ài hù zhè lǐ de yì cǎo yì mù.”",
      "meaning": "Cả nhóm quan sát lá và đất, chỉ ngắm chứ không hái; phân biệt rặng cây công viên với rừng lớn.",
      "readingMinutes": 2
    },
