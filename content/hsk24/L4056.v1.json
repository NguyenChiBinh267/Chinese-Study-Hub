  "blocks": [
    {
      "id": "l4056-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t0",
      "type": "teaching",
      "title": "提 · xách; mang bằng tay",
      "text": "提 trong câu là xách vật, khác 提到 nhắc tới.",
      "hanzi": "画里的人提着一只包。",
      "pinyin": "Huà lǐ de rén tí zhe yì zhī bāo.",
      "meaning": "Người trong tranh xách một chiếc túi.",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t1",
      "type": "teaching",
      "title": "特点 · đặc điểm",
      "text": "特点 là nét riêng giúp mô tả, không mặc định ưu điểm.",
      "hanzi": "这幅画有什么特点？",
      "pinyin": "Zhè fú huà yǒu shén me tè diǎn?",
      "meaning": "Bức tranh này có đặc điểm gì?",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t2",
      "type": "teaching",
      "title": "有着 · có; mang",
      "text": "有着 thường dùng văn viết để nêu đặc điểm đang có.",
      "hanzi": "这幅画有着鲜明的色彩。",
      "pinyin": "Zhè fú huà yǒu zhe xiān míng de sè cǎi.",
      "meaning": "Bức tranh này có màu sắc nổi bật.",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t3",
      "type": "teaching",
      "title": "印象 · ấn tượng",
      "text": "印象 là cảm nhận/nhớ lại, có thể khác giữa người xem. Nhận diện chữ 象 trong 印象; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这幅画给我留下了深刻印象。",
      "pinyin": "Zhè fú huà gěi wǒ liú xià le shēn kè yìn xiàng.",
      "meaning": "Bức tranh để lại ấn tượng sâu sắc với tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t4",
      "type": "teaching",
      "title": "样子 · dáng vẻ; hình dạng",
      "text": "样子 nói vẻ ngoài, không tự cho biết tính cách.",
      "hanzi": "他画出了人物走路的样子。",
      "pinyin": "Tā huà chū le rén wù zǒu lù de yàng zi.",
      "meaning": "Anh ấy vẽ dáng đi của nhân vật.",
      "readingMinutes": 1
    },
    {
      "id": "l4056-t5",
      "type": "teaching",
      "title": "眼前 · trước mắt",
      "text": "眼前 chỉ ngay trước người quan sát trong không gian.",
      "hanzi": "眼前的画有很多细节。",
      "pinyin": "Yǎn qián de huà yǒu hěn duō xì jié.",
      "meaning": "Bức tranh trước mắt có nhiều chi tiết.",
      "readingMinutes": 1
    },
    {
      "id": "l4056-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "有的是 + danh từ nhấn mạnh có nhiều, không thiếu; câu này nói còn nhiều chi tiết để quan sát, không khẳng định mọi người giải thích giống nhau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4056-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "京剧是中国传统戏曲的一种，表演把唱、念和动作结合起来。这段文字描述一幅京剧人物画：画中人提着包，有着鲜明的服饰特点。小安想象人物走路的样子，说眼前的画给他留下深刻印象。老师说：“有的是细节可以观察，先描述，再解释。”本页没有实际图片。",
      "pinyin": "Jīng jù shì Zhōng guó chuán tǒng xì qǔ de yì zhǒng, biǎo yǎn bǎ chàng, niàn hé dòng zuò jié hé qǐ lái. Zhè duàn wén zì miáo shù yì fú Jīng jù rén wù huà: huà zhōng rén tí zhe bāo, yǒu zhe xiān míng de fú shì tè diǎn. Xiǎo Ān xiǎng xiàng rén wù zǒu lù de yàng zi, shuō yǎn qián de huà gěi tā liú xià shēn kè yìn xiàng. Lǎo shī shuō: “Yǒu de shì xì jié kě yǐ guān chá, xiān miáo shù, zài jiě shì.” Běn yè méi yǒu shí jì tú piàn.",
      "meaning": "Đoạn chữ miêu tả tranh nhân vật kinh kịch; người học đọc mô tả, không có ảnh thật.",
      "readingMinutes": 2
    },
