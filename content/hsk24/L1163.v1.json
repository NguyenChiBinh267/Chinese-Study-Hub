  "blocks": [
    {
      "id": "l1163-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder0",
      "type": "teaching",
      "title": "说 · nói",
      "text": "Từ đã học 说 có 1 chữ. Chữ 说 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 说 với 悦 / 税 / 脱; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我说汉语。",
      "pinyin": "Wǒ shuō Hàn yǔ.",
      "meaning": "Tôi nói tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder1",
      "type": "teaching",
      "title": "会 · biết; có khả năng đã học",
      "text": "Từ đã học 会 có 1 chữ. Chữ 会 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 会 với 云 / 今 / 令; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我会写汉字。",
      "pinyin": "Wǒ huì xiě Hàn zì.",
      "meaning": "Tôi biết viết chữ Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder2",
      "type": "teaching",
      "title": "可以 · có thể; được phép",
      "text": "Từ đã học 可以 có 2 chữ. Chữ 可 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 可 với 司 / 何 / 句; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我可以读这本书吗？",
      "pinyin": "Wǒ kě yǐ dú zhè běn shū ma?",
      "meaning": "Tôi có thể đọc quyển sách này không?",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder3",
      "type": "teaching",
      "title": "知道 · biết (thông tin)",
      "text": "Từ đã học 知道 có 2 chữ. Chữ 道 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 道 với 首 / 通 / 这; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我知道你的名字。",
      "pinyin": "Wǒ zhī dào nǐ de míng zi.",
      "meaning": "Tôi biết tên bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder4",
      "type": "teaching",
      "title": "想 · muốn; nghĩ (theo ngữ cảnh)",
      "text": "Từ đã học 想 có 1 chữ. Chữ 想 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 想 với 相 / 箱 / 念; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我想喝茶。",
      "pinyin": "Wǒ xiǎng hē chá.",
      "meaning": "Tôi muốn uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1163-reminder5",
      "type": "teaching",
      "title": "要 · muốn; lấy; cần (theo ngữ cảnh)",
      "text": "Từ đã học 要 có 1 chữ. Chữ 要 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 要 với 耍 / 西 / 票; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我要茶。",
      "pinyin": "Wǒ yào chá.",
      "meaning": "Tôi muốn trà.",
      "readingMinutes": 1
    },
