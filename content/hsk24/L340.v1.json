  "blocks": [
    {
      "id": "l340-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 座 zuò: lượng từ núi; 互相 hùxiāng: lẫn nhau; 提醒 tíxǐng: nhắc; 脚下 jiǎo xià: dưới chân. Đây là bài đọc từ vựng, không chứng nhận kỹ năng leo núi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l340-t0",
      "type": "teaching",
      "title": "地 · đất/mặt đất",
      "text": "地 dì là đất trong 地上, không phải trợ từ de đứng trước động từ. 土地 và 地面 hỗ trợ nghĩa, chưa đếm mục mới.",
      "hanzi": "地上有水。",
      "pinyin": "Dì shàng yǒu shuǐ.",
      "meaning": "Trên đất có nước.",
      "readingMinutes": 1
    },
    {
      "id": "l340-t1",
      "type": "teaching",
      "title": "山 · núi",
      "text": "山 là núi; 山上 có thể là trên núi, không nhất thiết đúng đỉnh. 上山 là lên núi.",
      "hanzi": "那座山很高。",
      "pinyin": "Nà zuò shān hěn gāo.",
      "meaning": "Ngọn núi đó cao.",
      "readingMinutes": 1
    },
    {
      "id": "l340-t2",
      "type": "teaching",
      "title": "爬 · leo/trèo",
      "text": "爬 trong 爬山 là leo núi, có thể là đi bộ lên đường núi; không nhất thiết bò bằng bốn chân.",
      "hanzi": "我们明天去爬山。",
      "pinyin": "Wǒmen míngtiān qù pá shān.",
      "meaning": "Ngày mai chúng tôi đi leo núi.",
      "readingMinutes": 1
    },
    {
      "id": "l340-t3",
      "type": "teaching",
      "title": "害怕 · sợ",
      "text": "害怕 diễn tả cảm giác sợ, có thể nhận tân ngữ; 害怕走夜路 là sợ đi đường ban đêm. Không tự chứng minh nguy hiểm đã xảy ra.",
      "hanzi": "她害怕一个人上山。",
      "pinyin": "Tā hàipà yí ge rén shàng shān.",
      "meaning": "Cô ấy sợ lên núi một mình.",
      "readingMinutes": 1
    },
    {
      "id": "l340-t4",
      "type": "teaching",
      "title": "怕 · sợ/ngại",
      "text": "怕 có thể gần nghĩa 害怕; câu luyện đặt trong ngữ cảnh sợ lạnh. Đề không dùng hai từ này làm hai lựa chọn loại trừ khi đều đúng.",
      "hanzi": "我怕冷，多带了一件衣服。",
      "pinyin": "Wǒ pà lěng, duō dài le yí jiàn yīfu.",
      "meaning": "Tôi sợ lạnh nên mang thêm một áo.",
      "readingMinutes": 1
    },
    {
      "id": "l340-t5",
      "type": "teaching",
      "title": "小心 · cẩn thận/coi chừng",
      "text": "小心 là chú ý tránh sơ suất/nguy hiểm; 小心脚下提醒 nhìn chỗ chân. Không phải phép bảo đảm an toàn chỉ vì đã nghe nhắc.",
      "hanzi": "下山时要小心。",
      "pinyin": "Xià shān shí yào xiǎoxīn.",
      "meaning": "Khi xuống núi cần cẩn thận.",
      "readingMinutes": 1
    },
    {
      "id": "l340-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "向山上走 nêu hướng đi, khác 在山上走 nêu nơi đi. 向 ở đây là giới từ trước hướng, không phải động từ sở thích.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l340-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林向山上走，看见地上有水就停下来。朋友说自己怕冷，也害怕一个人爬山，所以今天跟大家一起走。下山时，他们互相提醒小心，没有为了快就走不认识的小路。",
      "pinyin": "Xiǎo Lín xiàng shān shàng zǒu, kànjiàn dì shàng yǒu shuǐ jiù tíng xiàlái. Péngyou shuō zìjǐ pà lěng, yě hàipà yí ge rén pá shān, suǒyǐ jīntiān gēn dàjiā yìqǐ zǒu. Xià shān shí, tāmen hùxiāng tíxǐng xiǎoxīn, méiyǒu wèile kuài jiù zǒu bú rènshi de xiǎo lù.",
      "meaning": "Lâm dừng khi thấy nước trên đất. Bạn sợ lạnh và ngại leo một mình nên đi cùng nhóm. Họ nhắc nhau cẩn thận, không chọn đường lạ chỉ để đi nhanh.",
      "readingMinutes": 2
    },
    {
