  "blocks": [
    {
      "id": "l4005-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t0",
      "type": "teaching",
      "title": "人生 · cuộc đời",
      "text": "人生 là cuộc đời/con đường sống, khác 日子 chỉ từng ngày hoặc cuộc sống thường nhật.",
      "hanzi": "她用日记记录人生的变化。",
      "pinyin": "Tā yòng rì jì jì lù rén shēng de biàn huà.",
      "meaning": "Cô ấy dùng nhật ký ghi thay đổi của cuộc đời.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t1",
      "type": "teaching",
      "title": "日常 · thường ngày",
      "text": "日常 bổ nghĩa danh từ như 日常生活, không thay cho danh từ 日期.",
      "hanzi": "他喜欢记录日常生活。",
      "pinyin": "Tā xǐ huan jì lù rì cháng shēng huó.",
      "meaning": "Anh ấy thích ghi lại sinh hoạt thường ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t2",
      "type": "teaching",
      "title": "日记 · nhật ký",
      "text": "日记 là bản ghi riêng theo ngày, không phải lịch in ngày tháng.",
      "hanzi": "我每天晚上写日记。",
      "pinyin": "Wǒ měi tiān wǎn shang xiě rì jì.",
      "meaning": "Tối nào tôi cũng viết nhật ký.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t3",
      "type": "teaching",
      "title": "日期 · ngày tháng",
      "text": "日期 là thông tin ngày tháng cụ thể trên lịch/tài liệu; không chỉ một khoảng đời.",
      "hanzi": "请在第一页写上日期。",
      "pinyin": "Qǐng zài dì yī yè xiě shàng rì qī.",
      "meaning": "Xin ghi ngày tháng trên trang đầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t4",
      "type": "teaching",
      "title": "日子 · ngày; cuộc sống",
      "text": "日子 trong 日子过得很好 chỉ cuộc sống hằng ngày; không phải ngày tháng định danh trên lịch.",
      "hanzi": "那时候的日子很快乐。",
      "pinyin": "Nà shí hou de rì zi hěn kuài lè.",
      "meaning": "Cuộc sống hồi đó rất vui.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-t5",
      "type": "teaching",
      "title": "童年 · tuổi thơ",
      "text": "童年 là giai đoạn còn nhỏ trong cuộc đời; không phải mọi quá khứ của một người. Nhận diện chữ 童 trong 童年; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这张照片让我想起童年。",
      "pinyin": "Zhè zhāng zhào piàn ràng wǒ xiǎng qǐ tóng nián.",
      "meaning": "Bức ảnh này khiến tôi nhớ tuổi thơ.",
      "readingMinutes": 1
    },
    {
      "id": "l4005-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "谁不想……呢？ là câu hỏi tu từ: ai mà chẳng muốn…, ngụ ý mọi người đều muốn. Không phải câu hỏi cần tìm tên một người; câu luyện chỉ diễn đạt mong muốn của nhân vật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4005-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小雨翻开童年的日记，每页都有日期。那时的日常生活很简单：上学、画画、和朋友玩。她觉得人生变化很大，但那些快乐的日子一直留在心里。她在今天的日记里写道：“谁不想把日子过好呢？我要继续记录生活。”",
      "pinyin": "Xiǎo Yǔ fān kāi tóng nián de rì jì, měi yè dōu yǒu rì qī. Nà shí de rì cháng shēng huó hěn jiǎn dān: shàng xué, huà huà, hé péng you wán. Tā jué de rén shēng biàn huà hěn dà, dàn nà xiē kuài lè de rì zi yì zhí liú zài xīn lǐ. Tā zài jīn tiān de rì jì lǐ xiě dào: “Shéi bù xiǎng bǎ rì zi guò hǎo ne? Wǒ yào jì xù jì lù shēng huó.”",
      "meaning": "Tiểu Vũ đọc lại nhật ký tuổi thơ có ghi ngày; cô muốn tiếp tục ghi lại cuộc sống.",
      "readingMinutes": 2
    },
