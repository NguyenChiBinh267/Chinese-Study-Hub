  "blocks": [
    {
      "id": "l4045-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t0",
      "type": "teaching",
      "title": "月份 · tháng trong năm",
      "text": "月份 nói tháng theo lịch, không chỉ độ dài một tháng.",
      "hanzi": "请在表上写清月份。",
      "pinyin": "Qǐng zài biǎo shàng xiě qīng yuè fèn.",
      "meaning": "Hãy ghi rõ tháng trên bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t1",
      "type": "teaching",
      "title": "早晨 · sáng sớm",
      "text": "早晨 là khoảng thời gian sáng, khác 早餐 là bữa sáng. Nhận diện chữ 晨 trong 早晨; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "早晨我们一起准备饭菜。",
      "pinyin": "Zǎo chen wǒ men yì qǐ zhǔn bèi fàn cài.",
      "meaning": "Sáng sớm chúng tôi cùng chuẩn bị thức ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t2",
      "type": "teaching",
      "title": "夜 · đêm",
      "text": "夜 có thể dùng trong 一夜, chỉ một đêm.",
      "hanzi": "他写了一夜的信。",
      "pinyin": "Tā xiě le yí yè de xìn.",
      "meaning": "Anh ấy viết thư cả một đêm.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t3",
      "type": "teaching",
      "title": "夜晚 · ban đêm; đêm tối",
      "text": "夜晚 là danh từ thời gian, bài chọn yêu cầu dạng hai chữ.",
      "hanzi": "夜晚的院子很安静。",
      "pinyin": "Yè wǎn de yuàn zi hěn ān jìng.",
      "meaning": "Khoảng sân ban đêm rất yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t4",
      "type": "teaching",
      "title": "星星 · ngôi sao",
      "text": "星星 là sao trên trời; tiếng 星 thứ hai đọc nhẹ.",
      "hanzi": "孩子们在看星星。",
      "pinyin": "Hái zi men zài kàn xīng xing.",
      "meaning": "Bọn trẻ đang ngắm sao.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-t5",
      "type": "teaching",
      "title": "晚安 · chúc ngủ ngon",
      "text": "晚安 là lời chúc trước lúc chia tay/ngủ, không chỉ thời gian buổi tối.",
      "hanzi": "睡觉前，大家互道晚安。",
      "pinyin": "Shuì jiào qián, dà jiā hù dào wǎn ān.",
      "meaning": "Trước khi ngủ mọi người chúc nhau ngủ ngon.",
      "readingMinutes": 1
    },
    {
      "id": "l4045-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既…又… nối hai hoạt động cùng diễn ra trong bối cảnh: vừa ngắm trăng vừa trò chuyện. Đây là chuyện một gia đình, không coi mọi gia đình đều có cùng tập quán.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4045-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小云在日历上记下月份和团聚日期。中秋节早晨，全家一起做饭；夜晚既赏月，又聊天，孩子们还找星星。夜深了，大家互道晚安。这是故事里一家人的过节方式。",
      "pinyin": "Xiǎo Yún zài rì lì shàng jì xià yuè fèn hé tuán jù rì qī. Zhōng qiū jié zǎo chen, quán jiā yì qǐ zuò fàn; yè wǎn jì shǎng yuè, yòu liáo tiān, hái zi men hái zhǎo xīng xing. Yè shēn le, dà jiā hù dào wǎn ān. Zhè shì gù shi lǐ yì jiā rén de guò jié fāng shì.",
      "meaning": "Gia đình trong truyện nấu ăn buổi sáng, ngắm trăng và trò chuyện ban đêm vào Trung thu.",
      "readingMinutes": 2
    },
    {
