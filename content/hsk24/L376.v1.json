  "blocks": [
    {
      "id": "l376-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 情境 qíngjìng: tình huống; 换 huàn: đổi; 记 jì: ghi/nhớ. Luyện câu quen không tự thành bằng chứng độc lập hay mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l376-t0",
      "type": "teaching",
      "title": "为了 · để/vì mục đích",
      "text": "为了 nêu mục tiêu của hành động, khác 因为 nêu nguyên nhân. 为了学好而练未保证已学好.",
      "hanzi": "为了学好中文，我每天练习。",
      "pinyin": "Wèile xué hǎo Zhōngwén, wǒ měi tiān liànxí.",
      "meaning": "Để học tốt tiếng Trung tôi luyện hằng ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l376-t1",
      "type": "teaching",
      "title": "一边 · vừa… (trong vừa…vừa…)",
      "text": "一边…一边… nêu hai việc đồng thời; 一边也可指 một bên ở ngữ cảnh khác. Bài chỉ luyện phó từ song song.",
      "hanzi": "她一边看，一边记。",
      "pinyin": "Tā yìbiān kàn, yìbiān jì.",
      "meaning": "Cô ấy vừa xem vừa ghi.",
      "readingMinutes": 1
    },
    {
      "id": "l376-t2",
      "type": "teaching",
      "title": "越 · càng…càng…",
      "text": "越…越… liên hệ mức thay đổi, 越来越 là ngày càng. Không hiểu 越 riêng là mọi quan hệ nhân quả đã chứng minh.",
      "hanzi": "这段话越练越清楚。",
      "pinyin": "Zhè duàn huà yuè liàn yuè qīngchu.",
      "meaning": "Đoạn lời này càng luyện càng rõ.",
      "readingMinutes": 1
    },
    {
      "id": "l376-t3",
      "type": "teaching",
      "title": "又 · lại; vừa…vừa… tùy cấu trúc",
      "text": "又 ở 今天又练了一遍 nói việc lặp đã xảy ra; 再 thường nêu lần kế tiếp chưa xảy ra. 又…又… thêm hai tính chất, không phải mọi 又 đều “lại”.",
      "hanzi": "我今天又练了一遍。",
      "pinyin": "Wǒ jīntiān yòu liàn le yí biàn.",
      "meaning": "Hôm nay tôi lại luyện một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l376-t4",
      "type": "teaching",
      "title": "特别 · đặc biệt/rất",
      "text": "特别 có thể tính chất đặc biệt hoặc phó từ rất; 特别认真 là rất chăm chú, không phải tên một kỹ năng mới.",
      "hanzi": "她今天特别认真。",
      "pinyin": "Tā jīntiān tèbié rènzhēn.",
      "meaning": "Hôm nay cô ấy đặc biệt cẩn thận.",
      "readingMinutes": 1
    },
    {
      "id": "l376-t5",
      "type": "teaching",
      "title": "挺 · khá/rất (phó từ khẩu ngữ)",
      "text": "挺 + tính từ thường khẩu ngữ, như 挺有用; không dùng cho mọi danh từ. Chưa dạy động từ đứng thẳng của 挺.",
      "hanzi": "这个办法挺有用。",
      "pinyin": "Zhège bànfǎ tǐng yǒuyòng.",
      "meaning": "Cách này khá hữu ích.",
      "readingMinutes": 1
    },
    {
      "id": "l376-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "越练越清楚 nói mức độ thay đổi theo việc luyện trong trải nghiệm đang kể, chưa chứng minh quy luật cho mọi người. 为了 nêu mục đích, 一边 nêu đồng thời, 又 nêu lặp/thêm tùy câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l376-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "为了说清楚，小林今天又练了一遍。他一边看要求，一边记问题，练得特别认真。他说这段话越练越清楚，这个办法挺有用；但还要换一个新情境看看能不能用。",
      "pinyin": "Wèile shuō qīngchu, Xiǎo Lín jīntiān yòu liàn le yí biàn. Tā yìbiān kàn yāoqiú, yìbiān jì wèntí, liàn de tèbié rènzhēn. Tā shuō zhè duàn huà yuè liàn yuè qīngchu, zhège bànfǎ tǐng yǒuyòng; dàn hái yào huàn yí ge xīn qíngjìng kànkan néng bu néng yòng.",
      "meaning": "Để nói rõ, Lâm luyện lại, vừa xem yêu cầu vừa ghi vấn đề. Cậu thấy đoạn quen rõ hơn và cách làm hữu ích nhưng còn cần thử trong tình huống mới.",
      "readingMinutes": 2
    },
    {
