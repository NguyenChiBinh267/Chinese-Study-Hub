  "blocks": [
    {
      "id": "l322-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 支 zhī: lượng từ bút; 张 zhāng: lượng từ tờ; 借 jiè: mượn; 查 chá: tra cứu. 电子 diànzǐ: điện tử, hỗ trợ cấu tạo từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l322-t0",
      "type": "teaching",
      "title": "笔记 · ghi chép",
      "text": "笔记 là nội dung ghi lại để học/làm việc; 记笔记 là ghi chép, khác 本子 là cuốn vở vật chất.",
      "hanzi": "我把笔记写在自己的本子上。",
      "pinyin": "Wǒ bǎ bǐjì xiě zài zìjǐ de běnzi shàng.",
      "meaning": "Tôi viết ghi chép vào vở của mình.",
      "readingMinutes": 1
    },
    {
      "id": "l322-t1",
      "type": "teaching",
      "title": "铅笔 · bút chì",
      "text": "铅笔 là bút chì; không dùng từ này để gọi mọi loại 笔. Bài phân biệt vật viết với giấy viết.",
      "hanzi": "这支铅笔是我的。",
      "pinyin": "Zhè zhī qiānbǐ shì wǒ de.",
      "meaning": "Chiếc bút chì này là của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l322-t2",
      "type": "teaching",
      "title": "字典 · từ điển chữ",
      "text": "字典 dùng tra chữ và thông tin đọc/nghĩa tùy cuốn; không phải sách nào cũng tra được cùng nội dung.",
      "hanzi": "我用字典查这个字。",
      "pinyin": "Wǒ yòng zìdiǎn chá zhège zì.",
      "meaning": "Tôi dùng từ điển tra chữ này.",
      "readingMinutes": 1
    },
    {
      "id": "l322-t3",
      "type": "teaching",
      "title": "图书馆 · thư viện",
      "text": "图书馆 là nơi đọc/mượn sách; 书店 là nơi bán sách. Không suy ra mọi thư viện đều miễn phí hoặc cùng nội quy.",
      "hanzi": "图书馆里有很多书。",
      "pinyin": "Túshūguǎn lǐ yǒu hěn duō shū.",
      "meaning": "Trong thư viện có nhiều sách.",
      "readingMinutes": 1
    },
    {
      "id": "l322-t4",
      "type": "teaching",
      "title": "电子书 · sách điện tử",
      "text": "电子书 là sách dạng điện tử; cần thiết bị phù hợp để đọc, không nhất thiết là tài liệu nghe.",
      "hanzi": "我在手机上看电子书。",
      "pinyin": "Wǒ zài shǒujī shàng kàn diànzǐshū.",
      "meaning": "Tôi đọc sách điện tử trên điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l322-t5",
      "type": "teaching",
      "title": "纸 · giấy",
      "text": "纸 là giấy, 一张纸 là một tờ. Không dùng 纸 thay cho bài tập hoặc sách hoàn chỉnh khi chưa có ngữ cảnh.",
      "hanzi": "请给我一张纸。",
      "pinyin": "Qǐng gěi wǒ yì zhāng zhǐ.",
      "meaning": "Hãy cho tôi một tờ giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l322-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把笔记写在纸上 nêu đối tượng ghi và nơi ghi; 把书放回去 có kết quả hướng về chỗ cũ. Ở đây luyện chỗ ghi chép, không viết lên sách thư viện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l322-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林在图书馆看电子书，用字典查不认识的字。他带了铅笔和纸，把笔记写在自己的纸上。老师说：不要在借来的书上写字。",
      "pinyin": "Xiǎo Lín zài túshūguǎn kàn diànzǐshū, yòng zìdiǎn chá bú rènshi de zì. Tā dài le qiānbǐ hé zhǐ, bǎ bǐjì xiě zài zìjǐ de zhǐ shàng. Lǎoshī shuō: Bú yào zài jiè lái de shū shàng xiě zì.",
      "meaning": "Lâm đọc sách điện tử ở thư viện và tra chữ bằng từ điển. Lâm ghi lên giấy riêng; thầy nhắc không viết lên sách mượn.",
      "readingMinutes": 2
    },
    {
