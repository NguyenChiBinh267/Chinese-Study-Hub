  "blocks": [
    {
      "id": "l188-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder0",
      "type": "teaching",
      "title": "病 · bệnh; sự ốm đau",
      "text": "Nhắc nghĩa đã học: bệnh; sự ốm đau. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "她没有病，也想休息。",
      "pinyin": "Tā méi yǒu bìng, yě xiǎng xiū xi.",
      "meaning": "Cô ấy không có bệnh, cũng muốn nghỉ ngơi.",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder1",
      "type": "teaching",
      "title": "忙 · bận",
      "text": "Nhắc nghĩa đã học: bận. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的老师不忙。",
      "pinyin": "Wǒ de lǎo shī bù máng.",
      "meaning": "Giáo viên của tôi không bận.",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder2",
      "type": "teaching",
      "title": "请问 · xin hỏi",
      "text": "Nhắc nghĩa đã học: xin hỏi. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "请问，你认识安女士吗？",
      "pinyin": "Qǐng wèn, nǐ rèn shi Ān nǚ shì ma?",
      "meaning": "Xin hỏi, bạn biết bà/chị An không?",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder3",
      "type": "teaching",
      "title": "手机 · điện thoại di động",
      "text": "Nhắc nghĩa đã học: điện thoại di động. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "她的手机在房间里。",
      "pinyin": "Tā de shǒu jī zài fáng jiān lǐ.",
      "meaning": "Điện thoại của cô ấy ở trong phòng.",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder4",
      "type": "teaching",
      "title": "电脑 · máy tính",
      "text": "Nhắc nghĩa đã học: máy tính. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "这是我同学的电脑。",
      "pinyin": "Zhè shì wǒ tóng xué de diàn nǎo.",
      "meaning": "Đây là máy tính của bạn học tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l188-reminder5",
      "type": "teaching",
      "title": "电影院 · rạp chiếu phim",
      "text": "Nhắc nghĩa đã học: rạp chiếu phim. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我姐姐也去电影院。",
      "pinyin": "Wǒ jiě jie yě qù diàn yǐng yuàn.",
      "meaning": "Chị gái tôi cũng đến rạp chiếu phim.",
      "readingMinutes": 1
    },
    {
      "id": "l188-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：喂，安女士，您好！\nB：您好！\nA：请问，您忙吗？\nB：不忙。我想去电影院。\nA：我也想去。",
      "pinyin": "A: Wèi, Ān nǚ shì, nín hǎo! B: Nín hǎo! A: Qǐng wèn, nín máng ma? B: Bù máng. Wǒ xiǎng qù diàn yǐng yuàn. A: Wǒ yě xiǎng qù.",
      "meaning": "Cuộc gọi hư cấu: B không bận và muốn đến rạp; A cũng muốn đi. Không có bằng chứng họ đã tới hay đã xem phim.",
      "readingMinutes": 2
    },
