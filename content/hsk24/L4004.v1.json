  "blocks": [
    {
      "id": "l4004-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t0",
      "type": "teaching",
      "title": "亲戚 · họ hàng",
      "text": "亲戚 chỉ quan hệ thân tộc, rộng hơn gia đình cùng nhà; âm 戚 nhẹ trong từ này. Nhận diện chữ 戚 trong 亲戚; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "周末亲戚来我家吃饭。",
      "pinyin": "Zhōu mò qīn qi lái wǒ jiā chī fàn.",
      "meaning": "Cuối tuần họ hàng đến nhà tôi ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t1",
      "type": "teaching",
      "title": "青年 · thanh niên",
      "text": "青年 chỉ người ở tuổi thanh niên, không đồng nghĩa với mọi trẻ nhỏ.",
      "hanzi": "几位青年帮忙搬桌子。",
      "pinyin": "Jǐ wèi qīng nián bāng máng bān zhuō zi.",
      "meaning": "Mấy thanh niên giúp chuyển bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t2",
      "type": "teaching",
      "title": "全 · đều; toàn bộ",
      "text": "全 có thể làm phó từ trước động từ. Câu điền của bài yêu cầu dạng một chữ, để phân biệt 全都.",
      "hanzi": "客人全来了。",
      "pinyin": "Kè rén quán lái le.",
      "meaning": "Khách đều đã đến.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t3",
      "type": "teaching",
      "title": "全部 · toàn bộ",
      "text": "全部 có thể chỉ toàn bộ một tập hợp; ở đây làm thành phần trước danh từ 材料.",
      "hanzi": "全部材料都准备好了。",
      "pinyin": "Quán bù cái liào dōu zhǔn bèi hǎo le.",
      "meaning": "Toàn bộ nguyên liệu đã được chuẩn bị.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t4",
      "type": "teaching",
      "title": "全都 · tất cả đều",
      "text": "全都 là phó từ trước vị ngữ, không dùng 全都材料 như cụm danh từ 全部材料.",
      "hanzi": "孩子们全都在院子里玩。",
      "pinyin": "Hái zi men quán dōu zài yuàn zi lǐ wán.",
      "meaning": "Bọn trẻ đều chơi trong sân.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-t5",
      "type": "teaching",
      "title": "热闹 · nhộn nhịp; đông vui",
      "text": "热闹 miêu tả không khí đông người, sôi nổi; không có nghĩa nhiệt độ cao.",
      "hanzi": "今天家里特别热闹。",
      "pinyin": "Jīn tiān jiā lǐ tè bié rè nao.",
      "meaning": "Hôm nay nhà rất đông vui.",
      "readingMinutes": 1
    },
    {
      "id": "l4004-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一屋子人 mượn danh từ 屋子 làm lượng từ, nghĩa là người đầy một phòng. Không phải đúng một người hay một ngôi nhà. Chỉ luyện tiểu mẫu 屋子 trong hàng nguồn gồm nhiều lượng từ mượn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4004-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "周末，亲戚全来了。几位青年搬好桌子，把全部材料放进厨房。孩子们全都在院子里玩，一屋子大人一边包饺子一边聊天。奶奶说：“今天真热闹！大家先准备饭菜，吃完以后再一起收拾。”",
      "pinyin": "Zhōu mò, qīn qi quán lái le. Jǐ wèi qīng nián bān hǎo zhuō zi, bǎ quán bù cái liào fàng jìn chú fáng. Hái zi men quán dōu zài yuàn zi lǐ wán, yì wū zi dà rén yì biān bāo jiǎo zi yì biān liáo tiān. Nǎi nai shuō: “Jīn tiān zhēn rè nao! Dà jiā xiān zhǔn bèi fàn cài, chī wán yǐ hòu zài yì qǐ shōu shi.”",
      "meaning": "Người lớn gói sủi cảo, trẻ chơi ngoài sân; cả nhà chia việc chuẩn bị rồi dọn sau bữa ăn.",
      "readingMinutes": 2
    },
    {
