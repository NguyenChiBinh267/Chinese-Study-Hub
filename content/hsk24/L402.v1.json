  "blocks": [
    {
      "id": "l402-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 进站 jìn zhàn: vào ga/bến; 市中心 shì zhōngxīn: trung tâm; 手续 shǒuxù: thủ tục; 查看 chákàn: xem kiểm. Không suy thông báo hư cấu thành quy định giao thông thực tế. HSK3 đã có dạy từ vựng nháp, các kỹ năng khác và duyệt ngôn ngữ vẫn thiếu. Có thể đọc lại L375 về điều kiện, L384 về lời khuyên, L357 về kế hoạch học; không tự cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l402-t0",
      "type": "teaching",
      "title": "安检 · kiểm tra an ninh/làm kiểm tra an ninh",
      "text": "安检 trong 请先安检 nói thực hiện kiểm tra an ninh; không tự biết quy định đồ được mang nếu chỉ biết từ này.",
      "hanzi": "进站前，请先安检。",
      "pinyin": "Jìn zhàn qián, qǐng xiān ānjiǎn.",
      "meaning": "Trước vào ga, hãy làm kiểm tra an ninh trước.",
      "readingMinutes": 1
    },
    {
      "id": "l402-t1",
      "type": "teaching",
      "title": "背 · đeo/cõng trên lưng",
      "text": "背 bēi là mang/cõng trên lưng, khác bèi trong 背后 hoặc học thuộc ở ngữ cảnh khác. Bài giữ đúng động từ mang trên lưng.",
      "hanzi": "他背着一个包。",
      "pinyin": "Tā bēi zhe yí ge bāo.",
      "meaning": "Anh ấy đeo một túi trên lưng.",
      "readingMinutes": 1
    },
    {
      "id": "l402-t2",
      "type": "teaching",
      "title": "背包 · ba lô",
      "text": "背包 là ba lô/túi đeo lưng, 背读bēi; không phải mọi 包 đều là ba lô. 一个背包 đếm đồ mang theo.",
      "hanzi": "我的票在背包里。",
      "pinyin": "Wǒ de piào zài bēibāo lǐ.",
      "meaning": "Vé tôi ở trong ba lô.",
      "readingMinutes": 1
    },
    {
      "id": "l402-t3",
      "type": "teaching",
      "title": "乘客 · hành khách",
      "text": "乘客 là người đi trên phương tiện với vai trò hành khách, khác 司机 người lái và 游客 khách tham quan. Một người có thể đổi vai theo tình huống.",
      "hanzi": "乘客在这里等车。",
      "pinyin": "Chéngkè zài zhèlǐ děng chē.",
      "meaning": "Hành khách chờ xe ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l402-t4",
      "type": "teaching",
      "title": "乘坐 · đi/ngồi (phương tiện, trang trọng)",
      "text": "乘坐 thường trong văn viết/thông báo đi phương tiện, gần 坐 nhưng không dùng cho ngồi ghế trong mọi câu. 乘坐列车是搭乘.",
      "hanzi": "我们乘坐这辆车去市中心。",
      "pinyin": "Wǒmen chéngzuò zhè liàng chē qù shì zhōngxīn.",
      "meaning": "Chúng tôi đi chiếc xe này đến trung tâm thành phố.",
      "readingMinutes": 1
    },
    {
      "id": "l402-t5",
      "type": "teaching",
      "title": "出行 · đi lại/ra đi",
      "text": "出行 nói đi lại/ra ngoài cho chuyến, khác 出发 mốc khởi hành. 出行前看通知不是已经出发.",
      "hanzi": "出行前请查看通知。",
      "pinyin": "Chūxíng qián qǐng chákàn tōngzhī.",
      "meaning": "Trước chuyến đi hãy xem thông báo.",
      "readingMinutes": 1
    },
    {
      "id": "l402-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "按时出行/按时到达 nêu đúng mốc của kế hoạch. 不等于提前 (đến sớm) hoặc đã hoàn tất các bước trước đó. Hướng dẫn trong đoạn là thông báo hư cấu tại một bến.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l402-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林背着背包，准备乘坐去市中心的车。他先看这座车站的通知：乘客按时到，进站前先安检。票在背包里，他没有因为已经带票就以为所有手续都完成了。出行计划有变化时，还要看新的通知。",
      "pinyin": "Xiǎo Lín bēi zhe bēibāo, zhǔnbèi chéngzuò qù shì zhōngxīn de chē. Tā xiān kàn zhè zuò chēzhàn de tōngzhī: Chéngkè ànshí dào, jìn zhàn qián xiān ānjiǎn. Piào zài bēibāo lǐ, tā méiyǒu yīnwèi yǐjīng dài piào jiù yǐwéi suǒyǒu shǒuxù dōu wánchéng le. Chūxíng jìhuà yǒu biànhuà shí, hái yào kàn xīn de tōngzhī.",
      "meaning": "Lâm mang ba lô để đi xe vào trung tâm, đọc thông báo bến về giờ đến và kiểm tra an ninh. Có vé chưa nghĩa hoàn tất mọi bước; khi kế hoạch đổi còn xem thông báo mới.",
      "readingMinutes": 2
    },
    {
