  "blocks": [
    {
      "id": "l473-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 钥匙 yàoshi: chìa khóa; 想起 xiǎng qǐ: nhớ ra. Đoạn không đánh giá sức khỏe hay tính cách người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l473-t0",
      "type": "teaching",
      "title": "困 · buồn ngủ",
      "text": "困 tả muốn ngủ trong bài, khác 困难 là khó khăn.",
      "hanzi": "他今天很困。",
      "pinyin": "Tā jīntiān hěn kùn.",
      "meaning": "Hôm nay anh ấy buồn ngủ.",
      "readingMinutes": 1
    },
    {
      "id": "l473-t1",
      "type": "teaching",
      "title": "懒 · lười",
      "text": "懒 tả không muốn bỏ công; không suy từ một lần mệt/buồn ngủ thành tính cách. Nhận diện chữ 懒 trong 懒; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "不能因为一次迟到就说他懒。",
      "pinyin": "Bù néng yīnwèi yí cì chídào jiù shuō tā lǎn.",
      "meaning": "Không thể chỉ vì một lần muộn mà nói anh lười.",
      "readingMinutes": 1
    },
    {
      "id": "l473-t2",
      "type": "teaching",
      "title": "老是 · cứ hay, luôn",
      "text": "老是 tần suất lặp, thường kèm thái độ phàn nàn; không có nghĩa tuổi già.",
      "hanzi": "他最近老是忘记带钥匙。",
      "pinyin": "Tā zuìjìn lǎoshì wàngjì dài yàoshi.",
      "meaning": "Gần đây anh cứ quên mang chìa khóa.",
      "readingMinutes": 1
    },
    {
      "id": "l473-t3",
      "type": "teaching",
      "title": "放松 · thư giãn",
      "text": "放松 là giảm căng thẳng/thả lỏng; không mặc định bỏ hết trách nhiệm.",
      "hanzi": "她听音乐放松一下。",
      "pinyin": "Tā tīng yīnyuè fàngsōng yíxià.",
      "meaning": "Cô nghe nhạc thư giãn chút.",
      "readingMinutes": 1
    },
    {
      "id": "l473-t4",
      "type": "teaching",
      "title": "恐怕 · e rằng, có lẽ",
      "text": "恐怕 biểu thị lo ngại/phỏng đoán; 已经 chỉ thời gian đã, không phải từ nói mức chắc chắn.",
      "hanzi": "今天恐怕要改时间。",
      "pinyin": "Jīntiān kǒngpà yào gǎi shíjiān.",
      "meaning": "Hôm nay e phải đổi giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l473-t5",
      "type": "teaching",
      "title": "忽然 · bỗng nhiên",
      "text": "忽然 chỉ thay đổi bất ngờ, không đồng nghĩa lặp lại thường xuyên 老是.",
      "hanzi": "他忽然想起忘了带钥匙。",
      "pinyin": "Tā hūrán xiǎng qǐ wàng le dài yàoshi.",
      "meaning": "Anh bỗng nhớ quên mang chìa khóa.",
      "readingMinutes": 1
    },
    {
      "id": "l473-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "说不定 + mệnh đề nêu phỏng đoán chưa chắc: 休息一下，说不定就不困了. Không phải bảo đảm nghỉ sẽ hết buồn ngủ, cũng không chẩn đoán nguyên nhân. Bài chỉ diễn đạt kế hoạch và khả năng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l473-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小范最近老是忘记带钥匙。今天他很困，忽然想起下午还约了朋友。朋友没有说他懒，而是问他要不要改时间。小范说：“恐怕要晚一点儿。我先放松一下，说不定休息后会好一些。”他们商量后把见面时间改到周日。",
      "pinyin": "Xiǎo Fàn zuìjìn lǎoshì wàngjì dài yàoshi. Jīntiān tā hěn kùn, hūrán xiǎng qǐ xiàwǔ hái yuē le péngyou. Péngyou méiyǒu shuō tā lǎn, ér shì wèn tā yào bu yào gǎi shíjiān. Xiǎo Fàn shuō: “Kǒngpà yào wǎn yìdiǎnr. Wǒ xiān fàngsōng yíxià, shuōbudìng xiūxi hòu huì hǎo yìxiē.” Tāmen shāngliang hòu bǎ jiànmiàn shíjiān gǎi dào Zhōurì.",
      "meaning": "Phạm hay quên chìa khóa và hôm nay buồn ngủ. Bạn hỏi có cần đổi hẹn thay vì gán lười. Phạm muốn nghỉ, chỉ phỏng đoán có thể khá hơn. Hai người đổi hẹn sang chủ nhật.",
      "readingMinutes": 2
    },
