  "blocks": [
    {
      "id": "l4071-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t0",
      "type": "teaching",
      "title": "专门 · chuyên; riêng để",
      "text": "专门 chỉ làm riêng cho một mục đích, không đồng nghĩa một chuyên ngành.",
      "hanzi": "我专门留了半小时看语法。",
      "pinyin": "Wǒ zhuān mén liú le bàn xiǎo shí kàn yǔ fǎ.",
      "meaning": "Tôi dành riêng nửa giờ xem ngữ pháp.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t1",
      "type": "teaching",
      "title": "自习 · tự học; giờ tự học",
      "text": "自习 ở đây là giờ học chủ động tại trường.",
      "hanzi": "晚自习时，教室很安静。",
      "pinyin": "Wǎn zì xí shí, jiào shì hěn ān jìng.",
      "meaning": "Giờ tự học tối phòng rất yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t2",
      "type": "teaching",
      "title": "预习 · chuẩn bị bài trước",
      "text": "预习 nói đọc/làm quen nội dung trước khi được dạy. Nhận diện chữ 预 trong 预习; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我先预习明天的课。",
      "pinyin": "Wǒ xiān yù xí míng tiān de kè.",
      "meaning": "Tôi chuẩn bị bài ngày mai trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t3",
      "type": "teaching",
      "title": "语法 · ngữ pháp",
      "text": "语法 nói quy tắc kết hợp từ/câu, không phải số từ thuộc được.",
      "hanzi": "这本书解释了几个语法问题。",
      "pinyin": "Zhè běn shū jiě shì le jǐ ge yǔ fǎ wèn tí.",
      "meaning": "Sách giải thích vài vấn đề ngữ pháp.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t4",
      "type": "teaching",
      "title": "知识 · kiến thức",
      "text": "知识 là điều hiểu biết; xem qua chưa chứng minh vận dụng được.",
      "hanzi": "他想把知识用在练习里。",
      "pinyin": "Tā xiǎng bǎ zhī shi yòng zài liàn xí lǐ.",
      "meaning": "Anh ấy muốn vận dụng kiến thức vào bài tập.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-t5",
      "type": "teaching",
      "title": "总结 · tổng kết",
      "text": "总结 là gom lại điểm chính và điều rút ra, không chỉ chép nguyên bài.",
      "hanzi": "下课后，我们总结常见错误。",
      "pinyin": "Xià kè hòu, wǒ men zǒng jié cháng jiàn cuò wù.",
      "meaning": "Sau giờ chúng tôi tổng kết lỗi thường gặp.",
      "readingMinutes": 1
    },
    {
      "id": "l4071-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 đưa thông tin đã biết làm lý do thực hiện bước tiếp theo. 预习 trước giờ học; 自习 là tự học trong một khoảng thời gian, có thể ôn hoặc chuẩn bị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4071-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "晚自习时，小周专门留了半小时预习明天的语法课。他把不懂的地方写下来。第二天下课后，大家总结常见错误。老师说：“既然知道问题在哪儿，就用这些知识再做一题，看看是否会用。”",
      "pinyin": "Wǎn zì xí shí, Xiǎo Zhōu zhuān mén liú le bàn xiǎo shí yù xí míng tiān de yǔ fǎ kè. Tā bǎ bù dǒng de dì fang xiě xià lái. Dì èr tiān xià kè hòu, dà jiā zǒng jié cháng jiàn cuò wù. Lǎo shī shuō: “Jì rán zhī dào wèn tí zài nǎr, jiù yòng zhè xiē zhī shi zài zuò yì tí, kàn kan shì fǒu huì yòng.”",
      "meaning": "Nhóm thử vận dụng lại sau khi biết lỗi, thay vì xem việc đọc là đã thành thạo.",
      "readingMinutes": 2
    },
    {
