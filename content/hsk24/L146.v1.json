  "blocks": [
    {
      "id": "l146-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l146-t0",
      "type": "teaching",
      "title": "年 · năm (đơn vị thời gian)",
      "text": "年 trong 一年/三年 là đơn vị năm; khác 今天 chỉ một ngày.",
      "hanzi": "一年、三年。",
      "pinyin": "Yì nián, sān nián.",
      "meaning": "Một năm, ba năm.",
      "readingMinutes": 1
    },
    {
      "id": "l146-t1",
      "type": "teaching",
      "title": "今年 · năm nay",
      "text": "今年 theo thời điểm người nói trong truyện, không phải một nhãn năm cố định.",
      "hanzi": "今年我上学。",
      "pinyin": "Jīn nián wǒ shàng xué.",
      "meaning": "Năm nay tôi đi học.",
      "readingMinutes": 1
    },
    {
      "id": "l146-t2",
      "type": "teaching",
      "title": "明年 · năm sau; năm tới",
      "text": "明年 là năm tiếp sau năm nay, không đồng nghĩa 明天 ngày mai.",
      "hanzi": "明年我工作。",
      "pinyin": "Míng nián wǒ gōng zuò.",
      "meaning": "Năm sau tôi làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l146-t3",
      "type": "teaching",
      "title": "去年 · năm trước; năm ngoái",
      "text": "去年 là năm trước năm nay trong ngữ cảnh, không chỉ bất kỳ năm xa nào.",
      "hanzi": "去年我在学校。",
      "pinyin": "Qù nián wǒ zài xué xiào.",
      "meaning": "Năm ngoái tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l146-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "年 là năm/đơn vị đếm năm; 三年 là ba năm. 今年/明年/去年 là năm nay/năm sau/năm trước theo thời điểm người nói. Đặt thời gian trước hành động trong các ví dụ; không tự suy một năm dương lịch cố định hoặc đổi đuôi động từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l146-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你今年上学吗？\nB：今年不上学，我今年工作。\nA：去年呢？\nB：去年我上学。明年我也工作。",
      "pinyin": "A: Nǐ jīn nián shàng xué ma? B: Jīn nián bù shàng xué, wǒ jīn nián gōng zuò. A: Qù nián ne? B: Qù nián wǒ shàng xué. Míng nián wǒ yě gōng zuò.",
      "meaning": "B đi học năm trước, làm việc năm nay và nói năm sau cũng làm việc. Không nêu năm dương lịch hoặc nghề cụ thể.",
      "readingMinutes": 2
    },
