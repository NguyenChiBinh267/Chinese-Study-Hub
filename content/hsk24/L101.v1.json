  "blocks": [
    {
      "id": "l101-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l101-t0",
      "type": "teaching",
      "title": "好 · tốt; được",
      "text": "好 trong 好！là lời đáp đồng ý theo ngữ cảnh; không có nghĩa câu nào cũng cần 是.",
      "hanzi": "好，我喝茶。",
      "pinyin": "Hǎo, wǒ hē chá.",
      "meaning": "Được, tôi uống trà.",
      "readingMinutes": 1
    },
    {
      "id": "l101-t1",
      "type": "teaching",
      "title": "是 · là",
      "text": "是 nối chủ thể với tên hay loại, như 我是安; tên 安 chỉ minh họa.",
      "hanzi": "我是安。",
      "pinyin": "Wǒ shì Ān.",
      "meaning": "Tôi là An.",
      "readingMinutes": 1
    },
    {
      "id": "l101-t2",
      "type": "teaching",
      "title": "吗 · không; à (cuối câu hỏi)",
      "text": "吗 đặt cuối một câu hỏi có/không, không mang thanh đầy đủ trong cách dùng này.",
      "hanzi": "你是安吗？",
      "pinyin": "Nǐ shì Ān ma?",
      "meaning": "Bạn là An phải không?",
      "readingMinutes": 1
    },
    {
      "id": "l101-t3",
      "type": "teaching",
      "title": "不 · không",
      "text": "不 đứng trước động từ/cụm cần phủ định; trong 不是, lời nói thường đọc bú shì, nhưng mục từ đơn ghi bù.",
      "hanzi": "我不是安。",
      "pinyin": "Wǒ bú shì Ān.",
      "meaning": "Tôi không phải An.",
      "readingMinutes": 1
    },
    {
      "id": "l101-t4",
      "type": "teaching",
      "title": "也 · cũng",
      "text": "也 đứng trước phần vị ngữ; không đặt tùy ý ở cuối câu theo trật tự tiếng Việt.",
      "hanzi": "我也喜欢茶。",
      "pinyin": "Wǒ yě xǐ huan chá.",
      "meaning": "Tôi cũng thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l101-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "是 nối người với tên hoặc loại: 我是安。不 đứng trước 是 để phủ định: 我不是安。吗 đặt cuối lời hỏi có/không; 也 đứng trước 是 để thêm một người cùng tình trạng. Không dùng 是 trước mọi tính từ. 好 ở lời chào/nhận xét; đây chỉ là các mẫu ngắn đầu tiên.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l101-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你好！你是安吗？\nB：是，我是安。你喜欢茶吗？\nA：我喜欢茶。\nB：我也喜欢茶。\nA：好！",
      "pinyin": "A: Nǐ hǎo! Nǐ shì Ān ma? B: Shì, wǒ shì Ān. Nǐ xǐ huan chá ma? A: Wǒ xǐ huan chá. B: Wǒ yě xǐ huan chá. A: Hǎo!",
      "meaning": "A hỏi tên của B. Cả hai đều nói thích trà; không suy sở thích từ lời chào.",
      "readingMinutes": 2
    },
