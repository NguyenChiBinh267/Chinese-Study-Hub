  "blocks": [
    {
      "id": "l443-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 采用 cǎiyòng: áp dụng; 进度 jìndù: tiến độ; 支持 zhīchí: hỗ trợ; 内部 nèibù: nội bộ. Không khẳng định cải tiến thật hay chuẩn lao động.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l443-t0",
      "type": "teaching",
      "title": "技术 · kỹ thuật, công nghệ",
      "text": "技术 nói phương pháp/kỹ năng chuyên môn; ở đây là công nghệ sản xuất.",
      "hanzi": "工厂采用了新技术。",
      "pinyin": "Gōngchǎng cǎiyòng le xīn jìshù.",
      "meaning": "Nhà máy áp dụng công nghệ mới.",
      "readingMinutes": 1
    },
    {
      "id": "l443-t1",
      "type": "teaching",
      "title": "加班 · làm thêm giờ",
      "text": "加班 là làm ngoài giờ làm thông thường; ví dụ không coi làm thêm là điều bắt buộc.",
      "hanzi": "今天不用加班。",
      "pinyin": "Jīntiān bú yòng jiābān.",
      "meaning": "Hôm nay không cần làm thêm giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l443-t2",
      "type": "teaching",
      "title": "加快 · đẩy nhanh",
      "text": "加快 thường đi với 速度、进度; khác 提高质量 là nâng chất lượng.",
      "hanzi": "新方法加快了进度。",
      "pinyin": "Xīn fāngfǎ jiākuài le jìndù.",
      "meaning": "Phương pháp mới đẩy nhanh tiến độ.",
      "readingMinutes": 1
    },
    {
      "id": "l443-t3",
      "type": "teaching",
      "title": "加强 · tăng cường",
      "text": "加强 đi với 管理、检查、联系, không nói 加强速度.",
      "hanzi": "我们加强了检查。",
      "pinyin": "Wǒmen jiāqiáng le jiǎnchá.",
      "meaning": "Chúng tôi tăng cường kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l443-t4",
      "type": "teaching",
      "title": "获得 · đạt được, giành được",
      "text": "获得 dùng với kết quả, cơ hội hay phần thưởng, trang trọng hơn 得到. Nhận diện chữ 获 trong 获得; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "小组获得了公司的支持。",
      "pinyin": "Xiǎozǔ huòdé le gōngsī de zhīchí.",
      "meaning": "Nhóm nhận được hỗ trợ của công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l443-t5",
      "type": "teaching",
      "title": "获奖 · đoạt giải",
      "text": "获奖 nhấn mạnh nhận giải trong một cuộc đánh giá/thi; không đồng nghĩa mọi lời khen.",
      "hanzi": "获奖以后，她感谢了同事。",
      "pinyin": "Huòjiǎng yǐhòu, tā gǎnxiè le tóngshì.",
      "meaning": "Sau khi đoạt giải, cô cảm ơn đồng nghiệp.",
      "readingMinutes": 1
    },
    {
      "id": "l443-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "并且 nối hai vị ngữ/ý cùng hướng, vế sau bổ sung thông tin: 小组加快了进度，并且加强了检查. Không dùng để chỉ hai ý trái ngược. Hai động từ 加快/加强 cần tân ngữ thích hợp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l443-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "工厂的小组采用新技术，加快了进度，并且加强了检查。大家不用天天加班，也能按时完成工作。小组获得了公司的支持，后来在内部比赛中获奖。负责人提醒大家，得奖以后也不能少做检查。",
      "pinyin": "Gōngchǎng de xiǎozǔ cǎiyòng xīn jìshù, jiākuài le jìndù, bìngqiě jiāqiáng le jiǎnchá. Dàjiā bú yòng tiāntiān jiābān, yě néng ànshí wánchéng gōngzuò. Xiǎozǔ huòdé le gōngsī de zhīchí, hòulái zài nèibù bǐsài zhōng huòjiǎng. Fùzérén tíxǐng dàjiā, dé jiǎng yǐhòu yě bù néng shǎo zuò jiǎnchá.",
      "meaning": "Nhóm áp dụng kỹ thuật mới, tăng tiến độ và kiểm tra, hoàn thành đúng hạn mà không phải ngày nào cũng làm thêm. Họ được hỗ trợ rồi đoạt giải nội bộ, vẫn phải giữ kiểm tra.",
      "readingMinutes": 2
    },
    {
