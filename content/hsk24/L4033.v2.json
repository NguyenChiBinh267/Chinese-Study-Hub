  "blocks": [
    {
      "id": "l4033-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t0",
      "type": "teaching",
      "title": "省 · tỉnh",
      "text": "省1 trong nguồn là danh từ đơn vị hành chính, không phải tiết kiệm. Nhận diện chữ 省 trong 省; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "四川是中国的一个省。",
      "pinyin": "Sì chuān shì Zhōng guó de yí ge shěng.",
      "meaning": "Tứ Xuyên là một tỉnh của Trung Quốc.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t1",
      "type": "teaching",
      "title": "家乡 · quê hương",
      "text": "家乡 chỉ nơi quê nhà, khác nhà đang ở.",
      "hanzi": "我的家乡在山里。",
      "pinyin": "Wǒ de jiā xiāng zài shān lǐ.",
      "meaning": "Quê tôi ở miền núi.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t2",
      "type": "teaching",
      "title": "全球 · toàn cầu",
      "text": "全球 chỉ phạm vi cả thế giới, không riêng một nước.",
      "hanzi": "这张图介绍全球气候。",
      "pinyin": "Zhè zhāng tú jiè shào quán qiú qì hòu.",
      "meaning": "Hình này giới thiệu khí hậu toàn cầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t3",
      "type": "teaching",
      "title": "气候 · khí hậu",
      "text": "气候 là đặc điểm thời tiết lâu dài, khác thời tiết một ngày.",
      "hanzi": "家乡的气候比较干燥。",
      "pinyin": "Jiā xiāng de qì hòu bǐ jiào gān zào.",
      "meaning": "Khí hậu quê tôi khá khô.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t4",
      "type": "teaching",
      "title": "气温 · nhiệt độ không khí",
      "text": "气温 nói nhiệt độ không khí, khác thân nhiệt.",
      "hanzi": "今天气温有点儿低。",
      "pinyin": "Jīn tiān qì wēn yǒu diǎnr dī.",
      "meaning": "Hôm nay nhiệt độ không khí hơi thấp.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-t5",
      "type": "teaching",
      "title": "云 · mây",
      "text": "云 là mây trên trời trong câu, không phải lưu trữ đám mây.",
      "hanzi": "山上的云很多。",
      "pinyin": "Shān shàng de yún hěn duō.",
      "meaning": "Trên núi có nhiều mây.",
      "readingMinutes": 1
    },
    {
      "id": "l4033-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung đặc điểm; không suy ra văn hóa hay con người chỉ từ khí hậu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4033-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小田介绍家乡所在的省，又展示全球气候图。他说：“介绍一个地方，不仅要看今天的气温，还要了解长期的气候。”照片里的山上有云，但一张照片不能说明全年的天气。",
      "pinyin": "Xiǎo Tián jiè shào jiā xiāng suǒ zài de shěng, yòu zhǎn shì quán qiú qì hòu tú. Tā shuō: “Jiè shào yí ge dì fang, bù jǐn yào kàn jīn tiān de qì wēn, hái yào liǎo jiě cháng qī de qì hòu.” Zhào piàn lǐ de shān shàng yǒu yún, dàn yì zhāng zhào piàn bù néng shuō míng quán nián de tiān qì.",
      "meaning": "Tiểu Điền phân biệt nhiệt độ một ngày với khí hậu dài hạn.",
      "readingMinutes": 2
    },
    {
