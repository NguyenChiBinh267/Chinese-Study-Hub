  "blocks": [
    {
      "id": "l120-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l120-t0",
      "type": "teaching",
      "title": "大学 · trường đại học; bậc đại học",
      "text": "大学 là nơi/cấp học; muốn gọi người học dùng 大学生 trong ví dụ.",
      "hanzi": "这是大学。",
      "pinyin": "Zhè shì dà xué.",
      "meaning": "Đây là trường đại học.",
      "readingMinutes": 1
    },
    {
      "id": "l120-t1",
      "type": "teaching",
      "title": "大学生 · sinh viên đại học",
      "text": "大学生 nói người học ở đại học; không tự kết luận ngành học hay bằng cấp đã đạt.",
      "hanzi": "我姐姐是大学生。",
      "pinyin": "Wǒ jiě jie shì dà xué shēng.",
      "meaning": "Chị gái tôi là sinh viên đại học.",
      "readingMinutes": 1
    },
    {
      "id": "l120-t2",
      "type": "teaching",
      "title": "汉语 · tiếng Hán; tiếng Trung",
      "text": "汉语 là tên ngôn ngữ; khóa này luyện tiếng phổ thông, không đồng nhất mọi biến thể với một giọng duy nhất.",
      "hanzi": "我喜欢汉语。",
      "pinyin": "Wǒ xǐ huan Hàn yǔ.",
      "meaning": "Tôi thích tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l120-t3",
      "type": "teaching",
      "title": "中文 · tiếng Trung; tiếng Hoa",
      "text": "中文 có thể chỉ ngôn ngữ hoặc văn bản tiếng Trung tùy câu; không chỉ riêng chữ Hán như 汉字.",
      "hanzi": "我们学习中文。",
      "pinyin": "Wǒ men xué xí Zhōng wén.",
      "meaning": "Chúng tôi học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l120-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Danh từ chỉ ngôn ngữ có thể làm đối tượng của động từ: 我喜欢汉语. 汉语 và 中文 đều có thể chỉ tiếng Trung theo ngữ cảnh; không ép 汉语 luôn chỉ nói và 中文 luôn chỉ viết. 大学 là trường/cấp đại học, 大学生 là sinh viên. 学习 “học” được chú giải để chuyển sang nhóm học tập tiếp theo.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l120-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你是大学生吗？\nB：是。\nA：你喜欢汉语吗？\nB：喜欢。我姐姐也喜欢汉语。",
      "pinyin": "A: Nǐ shì dà xué shēng ma? B: Shì. A: Nǐ xǐ huan Hàn yǔ ma? B: Xǐ huan. Wǒ jiě jie yě xǐ huan Hàn yǔ.",
      "meaning": "学习 xué xí = học, sẽ học riêng ở nhóm sau. B là sinh viên và nói cả mình lẫn chị gái đều thích tiếng Trung.",
      "readingMinutes": 2
    },
    {
