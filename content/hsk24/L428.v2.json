  "blocks": [
    {
      "id": "l428-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 洞 dòng: lỗ; 门后 mén hòu: sau cửa; 门口 ménkǒu: cửa ra vào; 验证 yànzhèng: kiểm chứng. Bộ phận chữ chỉ gợi nhận diện, chưa dạy đủ quy tắc cấu tạo chữ. 满意 mǎnyì: hài lòng. Lời hứa là ý định, không phải bằng chứng tương lai.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l428-t0",
      "type": "teaching",
      "title": "待 · ở lại, nán ở",
      "text": "待 đọc dāi khi ở lại tại chỗ; không dùng đọc dài của từ đồng hình ở nghĩa chờ/đối đãi khác. Nhận diện chữ 待 trong 待; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我想在家待一会儿。",
      "pinyin": "Wǒ xiǎng zài jiā dāi yíhuìr.",
      "meaning": "Tôi muốn ở nhà một lát.",
      "readingMinutes": 1
    },
    {
      "id": "l428-t1",
      "type": "teaching",
      "title": "戴 · đội, đeo (đồ trên người)",
      "text": "戴 dùng với mũ/kính/trang sức, khác 带 là mang theo. Bài luyện dạng có bộ 戈 trong chữ.",
      "hanzi": "出门前他戴上了帽子。",
      "pinyin": "Chū mén qián tā dài shàng le màozi.",
      "meaning": "Trước khi ra ngoài anh ấy đội mũ.",
      "readingMinutes": 1
    },
    {
      "id": "l428-t2",
      "type": "teaching",
      "title": "袋子 · túi",
      "text": "袋子 là đồ đựng, đọc dàizi âm 子 nhẹ; khác 戴 dài dù cùng âm đầu.",
      "hanzi": "她把书放进袋子里。",
      "pinyin": "Tā bǎ shū fàng jìn dàizi lǐ.",
      "meaning": "Cô ấy bỏ sách vào túi.",
      "readingMinutes": 1
    },
    {
      "id": "l428-t3",
      "type": "teaching",
      "title": "底 · đáy, phần dưới cùng",
      "text": "底 là phần đáy ở 杯底、袋底; không tự là mọi vị trí ở dưới một vật.",
      "hanzi": "袋底有一个小洞。",
      "pinyin": "Dài dǐ yǒu yí ge xiǎo dòng.",
      "meaning": "Đáy túi có một lỗ nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l428-t4",
      "type": "teaching",
      "title": "底下 · phía dưới",
      "text": "底下 chỉ vị trí bên dưới; khác 底 là phần đáy của chính đồ vật.",
      "hanzi": "桌子底下还有一只鞋。",
      "pinyin": "Zhuōzi dǐxia hái yǒu yì zhī xié.",
      "meaning": "Dưới bàn còn một chiếc giày.",
      "readingMinutes": 1
    },
    {
      "id": "l428-t5",
      "type": "teaching",
      "title": "挂 · treo",
      "text": "挂 nói treo đồ hoặc một số nghĩa khác tùy tân ngữ; bài chỉ treo túi vào móc.",
      "hanzi": "请把袋子挂在门后。",
      "pinyin": "Qǐng bǎ dàizi guà zài mén hòu.",
      "meaning": "Hãy treo túi sau cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l428-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "再也不+V diễn đạt từ nay không làm nữa theo lời người nói; 再也没+V nói quá khứ không tái diễn sau mốc. Lời hứa không tự chứng minh tương lai đã xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l428-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小庄打算在家待一会儿。他找帽子时，看见袋子掉在桌子底下，袋底还有一个洞。整理好后，他戴上帽子，把袋子挂在门后，并说：“我再也不把袋子放在门口了。”他对整理后的房间很满意。",
      "pinyin": "Xiǎo Zhuāng dǎsuàn zài jiā dāi yíhuìr. Tā zhǎo màozi shí, kànjiàn dàizi diào zài zhuōzi dǐxia, dài dǐ hái yǒu yí ge dòng. Zhěnglǐ hǎo hòu, tā dài shàng màozi, bǎ dàizi guà zài mén hòu, bìng shuō: “Wǒ zài yě bù bǎ dàizi fàng zài ménkǒu le.” Tā duì zhěnglǐ hòu de fángjiān hěn mǎnyì.",
      "meaning": "Trang tìm thấy túi dưới bàn, đáy có lỗ. Anh treo túi sau cửa, nói không để ở cửa ra vào nữa và hài lòng với phòng đã gọn.",
      "readingMinutes": 2
    },
    {
