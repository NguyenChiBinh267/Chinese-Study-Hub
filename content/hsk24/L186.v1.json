  "blocks": [
    {
      "id": "l186-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder0",
      "type": "teaching",
      "title": "哪里 · ở đâu (dạng có âm tiết lǐ)",
      "text": "Nhắc nghĩa đã học: ở đâu (dạng có âm tiết lǐ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "你妹妹的学校在哪里？",
      "pinyin": "Nǐ mèi mei de xué xiào zài nǎ lǐ?",
      "meaning": "Trường em gái bạn ở đâu?",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder1",
      "type": "teaching",
      "title": "这里 · ở đây; chỗ này (dạng có âm tiết lǐ)",
      "text": "Nhắc nghĩa đã học: ở đây; chỗ này (dạng có âm tiết lǐ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的书在这里。",
      "pinyin": "Wǒ de shū zài zhè lǐ.",
      "meaning": "Sách của tôi ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder2",
      "type": "teaching",
      "title": "哪些 · những cái nào; những người nào",
      "text": "Nhắc nghĩa đã học: những cái nào; những người nào. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "哪些是你姐姐的书？",
      "pinyin": "Nǎ xiē shì nǐ jiě jie de shū?",
      "meaning": "Những cuốn nào là sách của chị gái bạn?",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder3",
      "type": "teaching",
      "title": "住 · sống; ở; cư trú",
      "text": "Nhắc nghĩa đã học: sống; ở; cư trú. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的老师住在那儿。",
      "pinyin": "Wǒ de lǎo shī zhù zài nàr.",
      "meaning": "Giáo viên của tôi sống ở kia.",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder4",
      "type": "teaching",
      "title": "前 · trước; phía trước",
      "text": "Nhắc nghĩa đã học: trước; phía trước. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "狗在桌子前。",
      "pinyin": "Gǒu zài zhuō zi qián.",
      "meaning": "Chó ở phía trước bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l186-reminder5",
      "type": "teaching",
      "title": "后 · sau; phía sau",
      "text": "Nhắc nghĩa đã học: sau; phía sau. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "猫在桌子后。",
      "pinyin": "Māo zài zhuō zi hòu.",
      "meaning": "Mèo ở phía sau bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l186-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这些是你的书吗？\nB：不是，这些是我老师的书。\nA：你的书在哪里？\nB：在房间里，在桌子上。",
      "pinyin": "A: Zhè xiē shì nǐ de shū ma? B: Bú shì, zhè xiē shì wǒ lǎo shī de shū. A: Nǐ de shū zài nǎ lǐ? B: Zài fáng jiān lǐ, zài zhuō zi shang.",
      "meaning": "Nhóm sách được chỉ ban đầu là của giáo viên. Sách của B ở trong phòng, trên bàn; đọc lời phủ định để không trộn hai nhóm.",
      "readingMinutes": 2
    },
