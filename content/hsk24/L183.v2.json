  "blocks": [
    {
      "id": "l183-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder0",
      "type": "teaching",
      "title": "书 · sách",
      "text": "Nhắc nghĩa đã học: sách. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我喜欢那本书。",
      "pinyin": "Wǒ xǐ huan nà běn shū.",
      "meaning": "Tôi thích quyển sách kia.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder1",
      "type": "teaching",
      "title": "本 · quyển; cuốn (lượng từ)",
      "text": "Nhắc nghĩa đã học: quyển; cuốn (lượng từ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "这是我的一本书。",
      "pinyin": "Zhè shì wǒ de yì běn shū.",
      "meaning": "Đây là một quyển sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder2",
      "type": "teaching",
      "title": "字 · chữ; ký tự",
      "text": "Nhắc nghĩa đã học: chữ; ký tự. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "那个字是“女”。",
      "pinyin": "Nà ge zì shì “nǚ”.",
      "meaning": "Chữ kia là 女.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder3",
      "type": "teaching",
      "title": "有 · có",
      "text": "Nhắc nghĩa đã học: có. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我妈妈有一本书。",
      "pinyin": "Wǒ mā ma yǒu yì běn shū.",
      "meaning": "Mẹ tôi có một quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder4",
      "type": "teaching",
      "title": "爱 · yêu; yêu thương",
      "text": "Nhắc nghĩa đã học: yêu; yêu thương. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我爱我爸爸和我妈妈。",
      "pinyin": "Wǒ ài wǒ bà ba hé wǒ mā ma.",
      "meaning": "Tôi yêu thương bố và mẹ tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reminder5",
      "type": "teaching",
      "title": "它 · nó (vật hoặc con vật)",
      "text": "Nhắc nghĩa đã học: nó (vật hoặc con vật). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "它不是你的狗，它是我的狗。",
      "pinyin": "Tā bú shì nǐ de gǒu, tā shì wǒ de gǒu.",
      "meaning": "Nó không phải chó của bạn, nó là chó của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l183-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：这本书是你的吗？\nB：不是，是我姐姐的。\nA：你有书吗？\nB：有，我有三本书。",
      "pinyin": "A: Zhè běn shū shì nǐ de ma? B: Bú shì, shì wǒ jiě jie de. A: Nǐ yǒu shū ma? B: Yǒu, wǒ yǒu sān běn shū.",
      "meaning": "Quyển được chỉ là của chị gái B. B có ba quyển sách riêng; không gộp hai thông tin thành một.",
      "readingMinutes": 2
    },
