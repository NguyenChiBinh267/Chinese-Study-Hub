  "blocks": [
    {
      "id": "l423-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 山脚 shānjiǎo: chân núi; 地区 dìqū: khu vực; 访问 fǎngwèn: thăm; 派 pài: cử; 位置 wèizhi: vị trí. Các địa danh đều hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l423-t0",
      "type": "teaching",
      "title": "村 · làng",
      "text": "村 là đơn vị/khu cư trú nông thôn trong lời mô tả; 一座村/一个村 tùy cách nói. Nhận diện chữ 村 trong 村; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个村在山脚下。",
      "pinyin": "Zhège cūn zài shān jiǎo xià.",
      "meaning": "Làng này ở chân núi.",
      "readingMinutes": 1
    },
    {
      "id": "l423-t1",
      "type": "teaching",
      "title": "北部 · miền/bộ phận phía bắc",
      "text": "北部 chỉ phần phía bắc của một vùng được nêu, không tự là chính bắc so với người nói.",
      "hanzi": "地图上的北部有一条河。",
      "pinyin": "Dìtú shàng de běibù yǒu yì tiáo hé.",
      "meaning": "Phía bắc trên bản đồ có một con sông.",
      "readingMinutes": 1
    },
    {
      "id": "l423-t2",
      "type": "teaching",
      "title": "东部 · miền/bộ phận phía đông",
      "text": "东部 nói phần phía đông của một vùng; cần biết đang nói tỉnh, thành phố hay nước nào.",
      "hanzi": "这个地区的东部靠海。",
      "pinyin": "Zhège dìqū de dōngbù kào hǎi.",
      "meaning": "Phần phía đông của vùng này giáp biển.",
      "readingMinutes": 1
    },
    {
      "id": "l423-t3",
      "type": "teaching",
      "title": "各地 · các nơi",
      "text": "各地 là danh từ chỉ các nơi trong phạm vi nói tới; không đồng nhất với từng cá nhân.",
      "hanzi": "各地的学生来这里交流。",
      "pinyin": "Gèdì de xuésheng lái zhèlǐ jiāoliú.",
      "meaning": "Học sinh từ các nơi đến đây giao lưu.",
      "readingMinutes": 1
    },
    {
      "id": "l423-t4",
      "type": "teaching",
      "title": "各个 · từng, các (trước danh từ)",
      "text": "各个 nhấn từng đơn vị trong một tập; sau đó cần đối tượng như 村、学校.",
      "hanzi": "他们访问了各个村。",
      "pinyin": "Tāmen fǎngwèn le gègè cūn.",
      "meaning": "Họ đã tới thăm từng làng.",
      "readingMinutes": 1
    },
    {
      "id": "l423-t5",
      "type": "teaching",
      "title": "各 · mỗi, các",
      "text": "各 thường đi cùng lượng từ hoặc tên loại, như 各班、各组; không tự đứng thay mọi danh từ.",
      "hanzi": "请各组派一个人来。",
      "pinyin": "Qǐng gè zǔ pài yí ge rén lái.",
      "meaning": "Mời mỗi nhóm cử một người tới.",
      "readingMinutes": 1
    },
    {
      "id": "l423-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "各+loại/đơn vị+N nêu từng phần trong một tập: 各个村 đều là từng làng. 各地 nói các nơi, không tự là mọi nơi trên thế giới; cần đọc phạm vi của đoạn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l423-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "地理课用的是一张虚构地区的地图。北部有河，东部靠海，中间有三个村。来自各地的学生分成各组，介绍图上各个村的位置。这里的“各地”只指参加活动的几个地方，不表示全世界。",
      "pinyin": "Dìlǐ kè yòng de shì yì zhāng xūgòu dìqū de dìtú. Běibù yǒu hé, dōngbù kào hǎi, zhōngjiān yǒu sān ge cūn. Láizì gèdì de xuésheng fēn chéng gè zǔ, jièshào tú shàng gègè cūn de wèizhi. Zhèlǐ de “gèdì” zhǐ zhǐ cānjiā huódòng de jǐ ge dìfang, bù biǎoshì quán shìjiè.",
      "meaning": "Bản đồ hư cấu có sông ở bắc, biển ở đông và ba làng ở giữa. Các nơi là vài nơi dự hoạt động, không phải toàn thế giới.",
      "readingMinutes": 2
    },
    {
