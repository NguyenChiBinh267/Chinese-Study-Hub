  "blocks": [
    {
      "id": "l184-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder0",
      "type": "teaching",
      "title": "猫 · mèo",
      "text": "Nhắc nghĩa đã học: mèo. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "那只猫不是我的。",
      "pinyin": "Nà zhī māo bú shì wǒ de.",
      "meaning": "Con mèo kia không phải của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder1",
      "type": "teaching",
      "title": "小 · nhỏ; bé",
      "text": "Nhắc nghĩa đã học: nhỏ; bé. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的学校很小。",
      "pinyin": "Wǒ de xué xiào hěn xiǎo.",
      "meaning": "Trường tôi nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder2",
      "type": "teaching",
      "title": "新 · mới",
      "text": "Nhắc nghĩa đã học: mới. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "那是我的新书。",
      "pinyin": "Nà shì wǒ de xīn shū.",
      "meaning": "Kia là sách mới của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder3",
      "type": "teaching",
      "title": "老师 · giáo viên; thầy/cô",
      "text": "Nhắc nghĩa đã học: giáo viên; thầy/cô. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我认识你的老师。",
      "pinyin": "Wǒ rèn shi nǐ de lǎo shī.",
      "meaning": "Tôi biết giáo viên của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder4",
      "type": "teaching",
      "title": "小学生 · học sinh tiểu học",
      "text": "Nhắc nghĩa đã học: học sinh tiểu học. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我弟弟也是小学生。",
      "pinyin": "Wǒ dì di yě shì xiǎo xué shēng.",
      "meaning": "Em trai tôi cũng là học sinh tiểu học.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reminder5",
      "type": "teaching",
      "title": "汉语 · tiếng Hán; tiếng Trung",
      "text": "Nhắc nghĩa đã học: tiếng Hán; tiếng Trung. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我和我姐姐喜欢汉语。",
      "pinyin": "Wǒ hé wǒ jiě jie xǐ huan Hàn yǔ.",
      "meaning": "Tôi và chị gái tôi thích tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l184-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你是小学生吗？\nB：不是，我是大学生。\nA：你弟弟呢？\nB：他是小学生。我们喜欢汉语。",
      "pinyin": "A: Nǐ shì xiǎo xué shēng ma? B: Bú shì, wǒ shì dà xué shēng. A: Nǐ dì di ne? B: Tā shì xiǎo xué shēng. Wǒ men xǐ huan Hàn yǔ.",
      "meaning": "B là sinh viên đại học, em trai B học tiểu học. B nói cả hai thích tiếng Trung; không suy tuổi cụ thể.",
      "readingMinutes": 2
    },
