  "blocks": [
    {
      "id": "l49008-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49008-reminder0",
      "type": "teaching",
      "title": "眼镜 · kính đeo mắt",
      "text": "眼镜 là kính đeo, dùng lượng từ 副.",
      "hanzi": "他的眼镜放在桌上。",
      "pinyin": "Tā de yǎn jìng fàng zài zhuō shàng.",
      "meaning": "Kính của anh ấy ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l49008-reminder1",
      "type": "teaching",
      "title": "牙膏 · kem đánh răng",
      "text": "牙膏 khác 牙刷 là bàn chải. Nhận diện chữ 膏 trong 牙膏; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "牙膏放在杯子旁边。",
      "pinyin": "Yá gāo fàng zài bēi zi páng biān.",
      "meaning": "Kem đánh răng ở cạnh cốc.",
      "readingMinutes": 1
    },
    {
      "id": "l49008-reminder2",
      "type": "teaching",
      "title": "纸巾 · khăn giấy",
      "text": "纸巾 là giấy dùng lau, không phải khăn vải.",
      "hanzi": "请给我一张纸巾。",
      "pinyin": "Qǐng gěi wǒ yì zhāng zhǐ jīn.",
      "meaning": "Cho tôi một tờ khăn giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l49008-reminder3",
      "type": "teaching",
      "title": "脱 · cởi; tháo",
      "text": "脱 thường dùng với quần áo/giày, không dùng thay 拿 cho mọi đồ.",
      "hanzi": "进屋后，他脱了外套。",
      "pinyin": "Jìn wū hòu, tā tuō le wài tào.",
      "meaning": "Vào phòng anh ấy cởi áo khoác.",
      "readingMinutes": 1
