  "blocks": [
    {
      "id": "l145-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l145-t0",
      "type": "teaching",
      "title": "现在 · bây giờ; hiện tại",
      "text": "现在 xác định lúc hiện tại; 在 trong từ này không được tách ra để thay cả từ bằng 在.",
      "hanzi": "我现在在学校。",
      "pinyin": "Wǒ xiàn zài zài xué xiào.",
      "meaning": "Bây giờ tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l145-t1",
      "type": "teaching",
      "title": "今天 · hôm nay",
      "text": "今天 là ngày hiện tại của người đang nói trong tình huống, không phải một ngày cố định trên lịch.",
      "hanzi": "我今天上课。",
      "pinyin": "Wǒ jīn tiān shàng kè.",
      "meaning": "Hôm nay tôi học trên lớp.",
      "readingMinutes": 1
    },
    {
      "id": "l145-t2",
      "type": "teaching",
      "title": "明天 · ngày mai",
      "text": "明天 là ngày tiếp sau hôm nay; bài không khẳng định ngày tháng cụ thể.",
      "hanzi": "我明天上班。",
      "pinyin": "Wǒ míng tiān shàng bān.",
      "meaning": "Ngày mai tôi đi làm.",
      "readingMinutes": 1
    },
    {
      "id": "l145-t3",
      "type": "teaching",
      "title": "昨天 · hôm qua",
      "text": "昨天 là ngày trước hôm nay; không tự dùng nó cho mọi thời điểm đã qua.",
      "hanzi": "我昨天休息。",
      "pinyin": "Wǒ zuó tiān xiū xi.",
      "meaning": "Hôm qua tôi nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l145-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "现在/今天/明天/昨天 xác định thời điểm. Trong 我今天上课, thời gian đứng sau chủ ngữ và trước hành động; 今天我上课 cũng có thể dùng theo ngữ cảnh. Không cần biến đổi đuôi động từ để nói ngày trước/sau; câu sắp xếp dùng các mảnh cố định của ví dụ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l145-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你今天上课吗？\nB：今天不上课，我明天上课。\nA：昨天呢？\nB：我昨天休息。",
      "pinyin": "A: Nǐ jīn tiān shàng kè ma? B: Jīn tiān bù shàng kè, wǒ míng tiān shàng kè. A: Zuó tiān ne? B: Wǒ zuó tiān xiū xi.",
      "meaning": "B không học trên lớp hôm nay, học ngày mai và đã nghỉ hôm qua. Đọc rõ từ thời gian và phủ định.",
      "readingMinutes": 2
    },
