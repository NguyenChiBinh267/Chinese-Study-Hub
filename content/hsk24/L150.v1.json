  "blocks": [
    {
      "id": "l150-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l150-t0",
      "type": "teaching",
      "title": "下午 · buổi chiều",
      "text": "下午 là phần sau trưa, không đồng nghĩa cả ban ngày.",
      "hanzi": "我下午读书。",
      "pinyin": "Wǒ xià wǔ dú shū.",
      "meaning": "Tôi đọc sách buổi chiều.",
      "readingMinutes": 1
    },
    {
      "id": "l150-t1",
      "type": "teaching",
      "title": "晚上 · buổi tối; buổi đêm",
      "text": "晚上 chỉ buổi tối/đêm trong lịch sinh hoạt; 上 nhẹ theo pinyin mục từ.",
      "hanzi": "我晚上回家。",
      "pinyin": "Wǒ wǎn shang huí jiā.",
      "meaning": "Tôi về nhà buổi tối.",
      "readingMinutes": 1
    },
    {
      "id": "l150-t2",
      "type": "teaching",
      "title": "晚 · muộn; trễ",
      "text": "晚 là muộn theo mốc so sánh trong tình huống, không tự là danh từ buổi tối.",
      "hanzi": "太晚了！",
      "pinyin": "Tài wǎn le!",
      "meaning": "Muộn quá!",
      "readingMinutes": 1
    },
    {
      "id": "l150-t3",
      "type": "teaching",
      "title": "白天 · ban ngày",
      "text": "白天 đối với buổi tối/đêm trong mẫu này; không dùng thay chính xác một ngày24giờ ở mọi câu.",
      "hanzi": "我白天工作。",
      "pinyin": "Wǒ bái tiān gōng zuò.",
      "meaning": "Tôi làm việc ban ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l150-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "太晚了！là câu cảm thán không cần gắn thêm một người làm chủ ngữ. 晚 nói muộn; 晚上 là buổi tối/đêm; 下午 là buổi chiều sau trưa. 白天 là phần ban ngày, không có một dải giờ cố định giống nhau ở mọi nơi/mùa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l150-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你下午做什么？\nB：我下午读书。\nA：晚上呢？\nB：我晚上回家。",
      "pinyin": "A: Nǐ xià wǔ zuò shén me? B: Wǒ xià wǔ dú shū. A: Wǎn shang ne? B: Wǒ wǎn shang huí jiā.",
      "meaning": "做 zuò = làm, sẽ học thành mục từ ở nhóm cuối. B đọc sách chiều và về nhà tối; không tự suy giờ cụ thể.",
      "readingMinutes": 2
    },
