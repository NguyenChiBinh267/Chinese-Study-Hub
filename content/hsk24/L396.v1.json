  "blocks": [
    {
      "id": "l396-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder0",
      "type": "teaching",
      "title": "环境 · môi trường/khung cảnh",
      "text": "环境 mô tả điều kiện xung quanh như yên tĩnh, sạch. Không coi đây chỉ là thời tiết hoặc một đồ vật riêng.",
      "hanzi": "这里的环境很安静。",
      "pinyin": "Zhèlǐ de huánjìng hěn ānjìng.",
      "meaning": "Môi trường ở đây yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder1",
      "type": "teaching",
      "title": "带 · mang theo",
      "text": "带 ở đây là động từ mang người/vật cùng đi. 带到车站 chỉ điểm đến; không dùng nghĩa danh từ dây/đai.",
      "hanzi": "请把包带到车站。",
      "pinyin": "Qǐng bǎ bāo dài dào chēzhàn.",
      "meaning": "Hãy mang túi đến ga.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder2",
      "type": "teaching",
      "title": "接 · đón",
      "text": "接 trong 去车站接朋友 là tới đón bạn. Khác tiếp nhận cuộc gọi trong 接电话; bài chỉ chấm nghĩa đón người theo ngữ cảnh.",
      "hanzi": "我今天去车站接朋友。",
      "pinyin": "Wǒ jīntiān qù chēzhàn jiē péngyou.",
      "meaning": "Hôm nay tôi đến ga đón bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder3",
      "type": "teaching",
      "title": "感冒 · cảm/cảm lạnh",
      "text": "感冒 trong lời kể là tên một tình trạng bệnh thông thường; có thể dùng như danh từ hoặc động từ. Học liệu chỉ luyện ngôn ngữ, không hướng dẫn tự chẩn đoán.",
      "hanzi": "小安说他感冒了。",
      "pinyin": "Xiǎo Ān shuō tā gǎnmào le.",
      "meaning": "An nói bạn bị cảm.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder4",
      "type": "teaching",
      "title": "发烧 · sốt",
      "text": "发烧 mô tả bị sốt theo lời kể. Bài không đặt ngưỡng nhiệt độ hoặc suy ra nguyên nhân bệnh từ từ này.",
      "hanzi": "他昨天发烧了，今天来问医生。",
      "pinyin": "Tā zuótiān fāshāo le, jīntiān lái wèn yīshēng.",
      "meaning": "Bạn sốt hôm qua, hôm nay đến hỏi bác sĩ.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder5",
      "type": "teaching",
      "title": "检查 · kiểm tra/khám kiểm tra",
      "text": "检查 chỉ việc xem xét kiểm tra; trong 医生检查身体 là khám/kiểm tra cơ thể. Kết quả chưa được nói nên không thể suy ra bệnh cụ thể.",
      "hanzi": "医生说要检查一下。",
      "pinyin": "Yīshēng shuō yào jiǎnchá yíxià.",
      "meaning": "Bác sĩ nói cần kiểm tra một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l396-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对我来说 giới hạn nhận xét theo góc nhìn người nói. Một nơi thuận tiện cho người cần tàu điện không có nghĩa thuận tiện cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l396-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：这家宾馆怎么样？小李：对我来说，这个地方很方便，附近有地铁站。小安：环境呢？小李：晚上很安静。我们见面的地点就在宾馆门口，不用去车站。",
      "pinyin": "Xiǎo Ān: Zhè jiā bīnguǎn zěnmeyàng? Xiǎo Lǐ: Duì wǒ lái shuō, zhège dìfang hěn fāngbiàn, fùjìn yǒu dìtiězhàn. Xiǎo Ān: Huánjìng ne? Xiǎo Lǐ: Wǎnshang hěn ānjìng. Wǒmen jiànmiàn de dìdiǎn jiù zài bīnguǎn ménkǒu, búyòng qù chēzhàn.",
      "meaning": "An hỏi khách sạn. Lý thấy nơi này tiện vì gần ga tàu điện, buổi tối yên tĩnh. Hai người gặp ngay cửa khách sạn, không phải cửa ga.",
      "readingMinutes": 2
    },
