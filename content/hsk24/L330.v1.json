  "blocks": [
    {
      "id": "l330-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 农场 nóngchǎng: nông trại; 种类 zhǒnglèi: chủng loại; 头 tóu: lượng từ bò; 数 shǔ: đếm; 山羊 shānyáng: dê; 绵羊 miányáng: cừu, hỗ trợ phân biệt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l330-t0",
      "type": "teaching",
      "title": "动物 · động vật",
      "text": "动物 là từ chung chỉ động vật; gồm nhiều loài. 一种动物 khác 一只动物 về đơn vị đếm.",
      "hanzi": "我们今天认识三种动物。",
      "pinyin": "Wǒmen jīntiān rènshi sān zhǒng dòngwù.",
      "meaning": "Hôm nay chúng tôi tìm hiểu ba loài động vật.",
      "readingMinutes": 1
    },
    {
      "id": "l330-t1",
      "type": "teaching",
      "title": "动物园 · vườn thú",
      "text": "动物园 là nơi nuôi/trưng bày động vật theo bài, khác công viên nói chung. Không tự suy ra mọi nơi có cùng loài.",
      "hanzi": "动物园今天九点开门。",
      "pinyin": "Dòngwùyuán jīntiān jiǔ diǎn kāi mén.",
      "meaning": "Hôm nay vườn thú mở cửa lúc chín giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l330-t2",
      "type": "teaching",
      "title": "大熊猫 · gấu trúc lớn",
      "text": "大熊猫 là tên loài gấu trúc lớn, không phân tích thành mèo lớn. Dùng 只 đếm cá thể trong bài.",
      "hanzi": "我们看见了一只大熊猫。",
      "pinyin": "Wǒmen kànjiàn le yì zhī dàxióngmāo.",
      "meaning": "Chúng tôi nhìn thấy một con gấu trúc lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l330-t3",
      "type": "teaching",
      "title": "鸡 · gà",
      "text": "鸡 chỉ gà nói chung; 母鸡/公鸡 mới phân biệt mái/trống, chưa có thông tin thì không tự thêm giới.",
      "hanzi": "农场里有十只鸡。",
      "pinyin": "Nóngchǎng lǐ yǒu shí zhī jī.",
      "meaning": "Nông trại có mười con gà.",
      "readingMinutes": 1
    },
    {
      "id": "l330-t4",
      "type": "teaching",
      "title": "牛 · bò",
      "text": "牛 chỉ bò nói chung theo ngữ cảnh nông trại; bài không dạy nghĩa khẩu ngữ khen “giỏi”. 一头牛 dùng 头 đếm.",
      "hanzi": "那头牛正在吃草。",
      "pinyin": "Nà tóu niú zhèngzài chī cǎo.",
      "meaning": "Con bò đó đang ăn cỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l330-t5",
      "type": "teaching",
      "title": "羊 · dê/cừu (từ chung)",
      "text": "羊 có phạm vi dê/cừu tùy loại; 山羊 và 绵羊 mới chỉ cụ thể. Không dịch chắc “dê” khi đoạn chưa phân biệt.",
      "hanzi": "老师说这也是一种羊。",
      "pinyin": "Lǎoshī shuō zhè yě shì yì zhǒng yáng.",
      "meaning": "Thầy nói đây cũng là một loại dê/cừu.",
      "readingMinutes": 1
    },
    {
      "id": "l330-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一种动物 là một loài/loại động vật; 一只动物 là một con. 只/种 thay đổi điều đang đếm; không cộng số loài như số cá thể.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l330-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林先去动物园看大熊猫，再去农场看鸡、牛和羊。老师说：一种动物不是一只动物。农场有十只鸡、两头牛，还有羊。小林只记了种类，没有数清羊有几只。",
      "pinyin": "Xiǎo Lín xiān qù dòngwùyuán kàn dàxióngmāo, zài qù nóngchǎng kàn jī, niú hé yáng. Lǎoshī shuō: Yì zhǒng dòngwù bú shì yì zhī dòngwù. Nóngchǎng yǒu shí zhī jī, liǎng tóu niú, hái yǒu yáng. Xiǎo Lín zhǐ jì le zhǒnglèi, méiyǒu shǔ qīng yáng yǒu jǐ zhī.",
      "meaning": "Lâm xem gấu trúc ở vườn thú rồi đến nông trại xem gà, bò, dê/cừu. Thầy phân biệt số loài với số con; Lâm chưa đếm rõ số dê/cừu.",
      "readingMinutes": 2
    },
    {
