  "blocks": [
    {
      "id": "l4009-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t0",
      "type": "teaching",
      "title": "温度 · nhiệt độ",
      "text": "温度 nói nhiệt độ nói chung, có thể là nước/không khí; khác riêng thân nhiệt 体温. Nhận diện chữ 温 trong 温度; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "小组每天记录水的温度。",
      "pinyin": "Xiǎo zǔ měi tiān jì lù shuǐ de wēn dù.",
      "meaning": "Nhóm ghi nhiệt độ nước mỗi ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t1",
      "type": "teaching",
      "title": "摄氏度 · độ C",
      "text": "摄氏度 là đơn vị nhiệt độ, đặt sau số; không đọc thành độ dài hoặc phần trăm.",
      "hanzi": "今天水温是二十摄氏度。",
      "pinyin": "Jīn tiān shuǐ wēn shì èr shí shè shì dù.",
      "meaning": "Nhiệt độ nước hôm nay là hai mươi độ C.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t2",
      "type": "teaching",
      "title": "下降 · giảm xuống",
      "text": "下降 chỉ mức hoặc vị trí đi xuống, đối lập 上升; không nhất thiết là động tác đi xuống cầu thang.",
      "hanzi": "夜里温度下降了。",
      "pinyin": "Yè lǐ wēn dù xià jiàng le.",
      "meaning": "Ban đêm nhiệt độ đã giảm.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t3",
      "type": "teaching",
      "title": "污染 · ô nhiễm",
      "text": "污染 chỉ sự làm bẩn môi trường hoặc tình trạng ô nhiễm, khác một mẩu rác cụ thể.",
      "hanzi": "大家讨论河水污染的问题。",
      "pinyin": "Dà jiā tǎo lùn hé shuǐ wū rǎn de wèn tí.",
      "meaning": "Mọi người bàn vấn đề ô nhiễm nước sông.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t4",
      "type": "teaching",
      "title": "严重 · nghiêm trọng",
      "text": "严重 nhấn mức độ đáng kể của vấn đề; không dùng thay cho 严格 nói yêu cầu chặt chẽ.",
      "hanzi": "这只是故事，不代表真实污染很严重。",
      "pinyin": "Zhè zhǐ shì gù shi, bú dài biǎo zhēn shí wū rǎn hěn yán zhòng.",
      "meaning": "Đây chỉ là câu chuyện, không có nghĩa ô nhiễm thật nghiêm trọng.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-t5",
      "type": "teaching",
      "title": "增加 · tăng thêm",
      "text": "增加 là tăng số lượng/mức độ; câu này nói tăng số lần đo, không suy ra ô nhiễm tăng.",
      "hanzi": "小组决定增加记录次数。",
      "pinyin": "Xiǎo zǔ jué dìng zēng jiā jì lù cì shù.",
      "meaning": "Nhóm quyết định tăng số lần ghi nhận.",
      "readingMinutes": 1
    },
    {
      "id": "l4009-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "由于 + cụm danh từ nêu nguyên nhân: 由于温度下降，… Chỉ dạy cách đặt cụm nguyên nhân trước mệnh đề; số liệu trong chuyện là giả định cho bài học, không là kết quả khảo sát thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4009-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "课堂上，小组用虚构的记录练习写报告：昨天水温二十二摄氏度，今天二十摄氏度。由于温度下降，大家增加了一次记录。老师提醒：“温度变化不能证明污染严重。讨论河水污染，还需要其他资料。不要把故事里的数字当成真实调查。”",
      "pinyin": "Kè táng shàng, xiǎo zǔ yòng xū gòu de jì lù liàn xí xiě bào gào: zuó tiān shuǐ wēn èr shí èr shè shì dù, jīn tiān èr shí shè shì dù. Yóu yú wēn dù xià jiàng, dà jiā zēng jiā le yí cì jì lù. Lǎo shī tí xǐng: “Wēn dù biàn huà bù néng zhèng míng wū rǎn yán zhòng. Tǎo lùn hé shuǐ wū rǎn, hái xū yào qí tā zī liào. Bú yào bǎ gù shi lǐ de shù zì dàng chéng zhēn shí diào chá.”",
      "meaning": "Nhóm luyện báo cáo với số liệu hư cấu; thay đổi nhiệt độ không đủ để kết luận mức ô nhiễm.",
      "readingMinutes": 2
    },
    {
      "id": "l4009-b0",
      "type": "exercise",
      "exerciseVersionId": "l4009-v1-e0"
    },
