  "blocks": [
    {
      "id": "l4076-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t0",
      "type": "teaching",
      "title": "既 · vừa; đã…lại…",
      "text": "既 trong 既认真又耐心 cùng 又 tạo cặp hai đặc điểm.",
      "hanzi": "她既认真又耐心。",
      "pinyin": "Tā jì rèn zhēn yòu nài xīn.",
      "meaning": "Cô ấy vừa nghiêm túc vừa kiên nhẫn.",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t1",
      "type": "teaching",
      "title": "连 · ngay cả; đến cả",
      "text": "连 dẫn trường hợp được nhấn mạnh trong 连…都…; ở bài dùng như giới từ.",
      "hanzi": "连老师都觉得这题难。",
      "pinyin": "Lián lǎo shī dōu jué de zhè tí nán.",
      "meaning": "Ngay cả giáo viên cũng thấy câu này khó.",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t2",
      "type": "teaching",
      "title": "困难 · khó khăn",
      "text": "困难 nói việc khó hoặc trở ngại, không phải chứng minh người học kém.",
      "hanzi": "这个练习有些困难。",
      "pinyin": "Zhè ge liàn xí yǒu xiē kùn nan.",
      "meaning": "Bài luyện này có chút khó khăn.",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t3",
      "type": "teaching",
      "title": "可惜 · đáng tiếc",
      "text": "可惜 biểu thị tiếc điều không như mong muốn.",
      "hanzi": "可惜，我们错过了说明。",
      "pinyin": "Kě xī, wǒ men cuò guò le shuō míng.",
      "meaning": "Tiếc là chúng tôi bỏ lỡ phần giải thích.",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t4",
      "type": "teaching",
      "title": "巧 · khéo; trùng hợp đúng lúc",
      "text": "巧 trong 真巧 là gặp sự trùng hợp, không khẳng định kỹ thuật khéo ở đây.",
      "hanzi": "真巧，你也在这里！",
      "pinyin": "Zhēn qiǎo, nǐ yě zài zhè lǐ!",
      "meaning": "Trùng hợp thật, bạn cũng ở đây!",
      "readingMinutes": 1
    },
    {
      "id": "l4076-t5",
      "type": "teaching",
      "title": "俩 · hai người; cả hai",
      "text": "俩 ở 我们俩 đã có nghĩa hai người, không nói 我们俩个人. Nhận diện chữ 俩 trong 俩; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们俩一起查资料。",
      "pinyin": "Wǒ men liǎ yì qǐ chá zī liào.",
      "meaning": "Hai chúng tôi cùng tra tài liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4076-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既…又… gắn hai đặc điểm cùng tồn tại. 连…都… nhấn mạnh một trường hợp; 俩 nghĩa hai người, không thêm 个 sau 俩 khi nói 我们俩.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4076-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "“真巧，你也来查资料！”小安说。两人错过了说明，觉得可惜。练习有困难，连老师都说要仔细看。他们决定一起查资料。小林既认真又耐心，说：“我们俩先找出问题，再去请教。”",
      "pinyin": "“Zhēn qiǎo, nǐ yě lái chá zī liào!” Xiǎo Ān shuō. Liǎng rén cuò guò le shuō míng, jué de kě xī. Liàn xí yǒu kùn nan, lián lǎo shī dōu shuō yào zǐ xì kàn. Tā men jué dìng yì qǐ chá zī liào. Xiǎo Lín jì rèn zhēn yòu nài xīn, shuō: “Wǒ men liǎ xiān zhǎo chū wèn tí, zài qù qǐng jiào.”",
      "meaning": "Hai người cùng tìm điểm chưa hiểu rồi mới hỏi, thay vì coi khó khăn là kết luận năng lực.",
      "readingMinutes": 2
    },
