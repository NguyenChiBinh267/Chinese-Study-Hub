  "blocks": [
    {
      "id": "l210-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "学校 là trường; 从 là từ mốc xuất phát; 到 là đến đích. Gần/xa luôn cần hiểu mốc so sánh, không tự suy ra số phút đi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l210-t0",
      "type": "teaching",
      "title": "远 · xa",
      "text": "远 mô tả khoảng cách lớn so với mốc; nếu không có số đo thì chưa biết chính xác bao nhiêu mét.",
      "hanzi": "车站离这里很远。",
      "pinyin": "Chēzhàn lí zhèlǐ hěn yuǎn.",
      "meaning": "Ga ở rất xa đây.",
      "readingMinutes": 1
    },
    {
      "id": "l210-t1",
      "type": "teaching",
      "title": "近 · gần",
      "text": "近 đối lập với 远. Cùng âm jìn với 进 nhưng chữ và nghĩa khác.",
      "hanzi": "学校离我家很近。",
      "pinyin": "Xuéxiào lí wǒ jiā hěn jìn.",
      "meaning": "Trường rất gần nhà tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l210-t2",
      "type": "teaching",
      "title": "离 · cách, xét khoảng cách đến một mốc",
      "text": "Trong A离B很近, 离 nối nơi A với mốc B. Bài không dạy nghĩa rời khỏi trong từ ghép khác.",
      "hanzi": "酒店离车站不远。",
      "pinyin": "Jiǔdiàn lí chēzhàn bù yuǎn.",
      "meaning": "Khách sạn cách ga không xa.",
      "readingMinutes": 1
    },
    {
      "id": "l210-t3",
      "type": "teaching",
      "title": "路 · đường đi",
      "text": "路 là đường; 问路 là hỏi đường, không hỏi tên phương tiện.",
      "hanzi": "这条路上有一家饭馆。",
      "pinyin": "Zhè tiáo lù shang yǒu yì jiā fànguǎn.",
      "meaning": "Trên con đường này có một quán ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l210-t4",
      "type": "teaching",
      "title": "走路 · đi bộ",
      "text": "走路 nói di chuyển bằng chân; không dùng cho đi tàu hoặc xe buýt.",
      "hanzi": "我每天走路去学校。",
      "pinyin": "Wǒ měitiān zǒulù qù xuéxiào.",
      "meaning": "Ngày nào tôi cũng đi bộ đến trường.",
      "readingMinutes": 1
    },
    {
      "id": "l210-t5",
      "type": "teaching",
      "title": "门口 · chỗ cửa, lối vào",
      "text": "门口 là khu vực cửa vào, không phải chỉ cánh cửa. 在门口等 là đứng đợi ở cửa.",
      "hanzi": "我们在学校门口等你。",
      "pinyin": "Wǒmen zài xuéxiào ménkǒu děng nǐ.",
      "meaning": "Chúng tôi đợi bạn ở cổng trường.",
      "readingMinutes": 1
    },
    {
      "id": "l210-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "从 dẫn điểm bắt đầu, 到 dẫn đích: 从学校到车站. 离 trong bài nói khoảng cách giữa hai nơi; không đảo sang nghĩa rời đi trong bài này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l210-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：从这里到学校远吗？乙：不远，走路十分钟。甲：在哪儿等你？乙：在学校门口。",
      "pinyin": "Jiǎ: Cóng zhèlǐ dào xuéxiào yuǎn ma? Yǐ: Bù yuǎn, zǒulù shí fēnzhōng. Jiǎ: Zài nǎr děng nǐ? Yǐ: Zài xuéxiào ménkǒu.",
      "meaning": "A: Từ đây đến trường có xa không? B: Không xa, đi bộ mười phút. A: Đợi bạn ở đâu? B: Ở cổng trường.",
      "readingMinutes": 2
    },
    {
