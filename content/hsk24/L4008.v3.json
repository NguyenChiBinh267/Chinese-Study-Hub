  "blocks": [
    {
      "id": "l4008-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t0",
      "type": "teaching",
      "title": "稍 · hơi; một chút",
      "text": "稍 thường dùng trong văn viết hoặc chỉ dẫn ngắn, như 稍等; bài điền yêu cầu dạng một chữ.",
      "hanzi": "请稍等，我马上来。",
      "pinyin": "Qǐng shāo děng, wǒ mǎ shàng lái.",
      "meaning": "Xin đợi chút, tôi đến ngay.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t1",
      "type": "teaching",
      "title": "稍微 · hơi; một chút",
      "text": "稍微 là phó từ mức độ nhỏ trước động từ/tính từ; pinyin của từ hai chữ này là shāo wēi; bài hiện tại chỉ yêu cầu nhận diện chữ còn thiếu. Nhận diện chữ 微 trong 稍微; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "今天的练习稍微难一点儿。",
      "pinyin": "Jīn tiān de liàn xí shāo wēi nán yì diǎnr.",
      "meaning": "Bài luyện hôm nay hơi khó hơn một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t2",
      "type": "teaching",
      "title": "少量 · lượng ít",
      "text": "少量 bổ nghĩa thứ đếm theo lượng, như 少量练习; không có nghĩa số ít người.",
      "hanzi": "老师只留了少量作业。",
      "pinyin": "Lǎo shī zhǐ liú le shǎo liàng zuò yè.",
      "meaning": "Thầy cô chỉ giao ít bài tập.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t3",
      "type": "teaching",
      "title": "少数 · số ít; thiểu số",
      "text": "少数 chỉ số ít thành viên, đối lập 多数; khác 少量 nói lượng.",
      "hanzi": "只有少数同学选了这门课。",
      "pinyin": "Zhǐ yǒu shǎo shù tóng xué xuǎn le zhè mén kè.",
      "meaning": "Chỉ số ít bạn chọn môn này.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t4",
      "type": "teaching",
      "title": "少见 · ít gặp",
      "text": "少见 miêu tả điều hiếm gặp, không chỉ số lượng ít của một vật.",
      "hanzi": "这种教学方法并不少见。",
      "pinyin": "Zhè zhǒng jiào xué fāng fǎ bìng bù shǎo jiàn.",
      "meaning": "Phương pháp dạy này không hiếm gặp.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-t5",
      "type": "teaching",
      "title": "甚至 · thậm chí",
      "text": "甚至 đưa ví dụ ở mức cao hơn điều vừa nói, không dùng như từ chỉ đồng thời.",
      "hanzi": "他太累了，甚至忘了吃饭。",
      "pinyin": "Tā tài lèi le, shèn zhì wàng le chī fàn.",
      "meaning": "Anh ấy quá mệt, thậm chí quên ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l4008-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "X是X，Y是Y phân rõ hai phạm trù, như 学习是学习，休息是休息: học ra học, nghỉ ra nghỉ. Không phải câu nhượng bộ X是X，可是… chỉ lặp một phạm trù.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4008-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "新老师只留少量作业，让大家稍微放慢速度。只有少数同学觉得任务太少；这种看法并不少见。有个同学以前学到深夜，甚至忘了吃饭。老师说：“请稍等，听我说完。学习是学习，休息是休息，安排时间也要认真。”",
      "pinyin": "Xīn lǎo shī zhǐ liú shǎo liàng zuò yè, ràng dà jiā shāo wēi fàng màn sù dù. Zhǐ yǒu shǎo shù tóng xué jué de rèn wu tài shǎo; zhè zhǒng kàn fǎ bìng bù shǎo jiàn. Yǒu ge tóng xué yǐ qián xué dào shēn yè, shèn zhì wàng le chī fàn. Lǎo shī shuō: “Qǐng shāo děng, tīng wǒ shuō wán. Xué xí shì xué xí, xiū xi shì xiū xi, ān pái shí jiān yě yào rèn zhēn.”",
      "meaning": "Thầy cô giảm lượng bài và nhắc chia thời gian học, nghỉ; đây là quan điểm nhân vật về học tập.",
      "readingMinutes": 2
    },
