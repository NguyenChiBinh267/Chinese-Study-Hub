  "blocks": [
    {
      "id": "l283-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder0",
      "type": "teaching",
      "title": "跳舞 · nhảy múa, khiêu vũ",
      "text": "跳舞 nói nhảy theo hoạt động múa/nhạc, không phải mọi cú nhảy lên. 舞 đọc thanh ba.",
      "hanzi": "妹妹喜欢跳舞。",
      "pinyin": "Mèimei xǐhuan tiàowǔ.",
      "meaning": "Em gái thích nhảy múa.",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder1",
      "type": "teaching",
      "title": "快乐 · vui vẻ",
      "text": "快乐 dùng nói trạng thái vui hoặc lời chúc như 生日快乐. Không dùng 快乐 để nói tốc độ nhanh.",
      "hanzi": "生日快乐！",
      "pinyin": "Shēngrì kuàilè!",
      "meaning": "Chúc sinh nhật vui vẻ!",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder2",
      "type": "teaching",
      "title": "疼 · đau",
      "text": "Trong bài dùng tính từ mô tả đau: 头疼. Không mở rộng sang nghĩa động từ thương yêu ở cấp khác.",
      "hanzi": "我的头很疼。",
      "pinyin": "Wǒ de tóu hěn téng.",
      "meaning": "Đầu tôi rất đau.",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder3",
      "type": "teaching",
      "title": "药 · thuốc",
      "text": "药 chỉ thuốc nói chung. Tên từ không cho biết loại thuốc, liều hay cách dùng; bài không hướng dẫn tự uống.",
      "hanzi": "桌子上有药。",
      "pinyin": "Zhuōzi shang yǒu yào.",
      "meaning": "Trên bàn có thuốc.",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder4",
      "type": "teaching",
      "title": "累 · mệt",
      "text": "累 ở đây là tính từ mệt. Chưa phân tích nghĩa gây mệt hay kết quả làm ai mệt trong cấu trúc khác.",
      "hanzi": "今天工作很多，我很累。",
      "pinyin": "Jīntiān gōngzuò hěn duō, wǒ hěn lèi.",
      "meaning": "Hôm nay nhiều việc, tôi rất mệt.",
      "readingMinutes": 1
    },
    {
      "id": "l283-reminder5",
      "type": "teaching",
      "title": "阴 · trời âm u",
      "text": "阴 nói trời nhiều mây/âm u, chưa tự cho biết có mưa. Đừng tự thêm thông tin mưa vào đáp án.",
      "hanzi": "今天是阴天，不太热。",
      "pinyin": "Jīntiān shì yīntiān, bú tài rè.",
      "meaning": "Hôm nay trời âm u, không nóng lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l283-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的爱好是什么？乙：我喜欢踢足球，也喜欢跳舞。甲：星期天一起踢球吧。乙：好！我妹妹不踢球，她去跳舞。",
      "pinyin": "Jiǎ: Nǐ de àihào shì shénme? Yǐ: Wǒ xǐhuan tī zúqiú, yě xǐhuan tiàowǔ. Jiǎ: Xīngqītiān yìqǐ tī qiú ba. Yǐ: Hǎo! Wǒ mèimei bù tī qiú, tā qù tiàowǔ.",
      "meaning": "A: Sở thích của bạn là gì? B: Tôi thích đá bóng, cũng thích nhảy múa. A: Chủ nhật cùng đá bóng nhé. B: Được! Em gái tôi không đá bóng, em đi nhảy múa.",
      "readingMinutes": 2
    },
    {
      "id": "l283-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你怎么了？乙：我头疼，身体不太舒服。甲：你今天去上班吗？乙：因为不舒服，所以我去看医生。",
      "pinyin": "Jiǎ: Nǐ zěnme le? Yǐ: Wǒ tóu téng, shēntǐ bú tài shūfu. Jiǎ: Nǐ jīntiān qù shàng bān ma? Yǐ: Yīnwèi bù shūfu, suǒyǐ wǒ qù kàn yīshēng.",
      "meaning": "A: Bạn sao vậy? B: Tôi đau đầu, không khỏe lắm. A: Hôm nay bạn đi làm không? B: Vì không khỏe nên tôi đi khám.",
      "readingMinutes": 2
    },
    {
      "id": "l283-context2",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：今天是晴天，我们去游泳吧？乙：是晴天，但是很冷。甲：那我们去书店吧。乙：好，因为书店离这里远，所以我们坐地铁去。",
      "pinyin": "Jiǎ: Jīntiān shì qíngtiān, wǒmen qù yóuyǒng ba? Yǐ: Shì qíngtiān, dànshì hěn lěng. Jiǎ: Nà wǒmen qù shūdiàn ba. Yǐ: Hǎo, yīnwèi shūdiàn lí zhèlǐ yuǎn, suǒyǐ wǒmen zuò dìtiě qù.",
      "meaning": "A: Hôm nay trời quang, đi bơi nhé? B: Trời quang nhưng rất lạnh. A: Vậy đến hiệu sách nhé. B: Được, vì hiệu sách xa đây nên chúng ta đi tàu điện ngầm.",
      "readingMinutes": 2
    },
