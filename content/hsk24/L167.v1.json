  "blocks": [
    {
      "id": "l167-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l167-t0",
      "type": "teaching",
      "title": "看 · nhìn; xem (dạng kàn)",
      "text": "看 trong 看电视 là xem tivi; đây là hoạt động được kể, không phải bài nghe/xem có chấm điểm.",
      "hanzi": "我正在看电视。",
      "pinyin": "Wǒ zhèng zài kàn diàn shì.",
      "meaning": "Tôi đang xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l167-t1",
      "type": "teaching",
      "title": "做 · làm (dạng zuò)",
      "text": "做 dùng cho làm một việc, như 做什么; khác chữ 坐 cùng âm zuò.",
      "hanzi": "你在做什么？",
      "pinyin": "Nǐ zài zuò shén me?",
      "meaning": "Bạn đang làm gì?",
      "readingMinutes": 1
    },
    {
      "id": "l167-t2",
      "type": "teaching",
      "title": "做饭 · nấu ăn (dạng zuò fàn)",
      "text": "做饭 là nấu ăn; không dùng riêng 做 để mặc định là nấu ăn trong mọi câu.",
      "hanzi": "妈妈正在做饭。",
      "pinyin": "Mā ma zhèng zài zuò fàn.",
      "meaning": "Mẹ đang nấu ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l167-t3",
      "type": "teaching",
      "title": "正在 · đang (dạng zhèngzài)",
      "text": "正在 đứng trước cụm hành động trong bài; không tự chứng minh hành động kéo dài bao lâu.",
      "hanzi": "我正在读书。",
      "pinyin": "Wǒ zhèng zài dú shū.",
      "meaning": "Tôi đang đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l167-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "正在 + động từ nói hành động đang diễn ra tại thời điểm được nói: 妈妈正在做饭. Trong mẫu này 正在 đứng trước hành động, khác 在 + nơi chốn. 做 là làm; 做饭 là nấu ăn, không gán cả nghĩa nấu ăn cho mọi 做. 看 trong 看电视 là xem, khác 看见 nêu nhìn thấy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l167-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：妈妈在做什么？\nB：她正在做饭。\nA：爸爸呢？\nB：他正在看电视。",
      "pinyin": "A: Mā ma zài zuò shén me? B: Tā zhèng zài zuò fàn. A: Bà ba ne? B: Tā zhèng zài kàn diàn shì.",
      "meaning": "Đoạn mô tả hai hành động cùng thời điểm trong truyện; không suy đó là thói quen hoặc vai trò cố định của nam/nữ.",
      "readingMinutes": 2
    },
