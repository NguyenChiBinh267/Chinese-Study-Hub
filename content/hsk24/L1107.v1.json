  "blocks": [
    {
      "id": "l1107-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1107-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "Khi ngữ cảnh hiện tại rõ, động từ + 呢 cũng có thể mô tả việc đang làm: 我读书呢. Câu không bắt buộc lúc nào cũng phải hiện 正在; từ này có thể thêm để làm rõ. Không dùng mỗi chữ 呢 để tự suy mọi câu đều là hành động đang diễn ra: 你呢 là hỏi lại, 桌子上有什么呢 có thể là câu hỏi. Bài chỉ chấm mẫu với hành động được nêu rõ.",
      "hanzi": "我读书呢。",
      "pinyin": "Wǒ dú shū ne.",
      "meaning": "Tôi đang đọc sách đây.",
      "readingMinutes": 3
    },
    {
      "id": "l1107-reminder0",
      "type": "teaching",
      "title": "读书 · đọc sách; đi học (tùy ngữ cảnh)",
      "text": "Nhắc nghĩa đã học: đọc sách; đi học (tùy ngữ cảnh). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我喜欢读书。",
      "pinyin": "Wǒ xǐ huan dú shū.",
      "meaning": "Tôi thích đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l1107-reminder1",
      "type": "teaching",
      "title": "现在 · bây giờ; hiện tại",
      "text": "Nhắc nghĩa đã học: bây giờ; hiện tại. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我现在在学校。",
      "pinyin": "Wǒ xiàn zài zài xué xiào.",
      "meaning": "Bây giờ tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l1107-reminder2",
      "type": "teaching",
      "title": "忙 · bận",
      "text": "Nhắc nghĩa đã học: bận. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我很忙。",
      "pinyin": "Wǒ hěn máng.",
      "meaning": "Tôi bận.",
      "readingMinutes": 1
    },
    {
      "id": "l1107-reminder3",
      "type": "teaching",
      "title": "说 · nói",
      "text": "Nhắc nghĩa đã học: nói. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我说汉语。",
      "pinyin": "Wǒ shuō Hàn yǔ.",
      "meaning": "Tôi nói tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l1107-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你现在忙吗？\nB：我读书呢。\nA：好，我明天再说。",
      "pinyin": "A: Nǐ xiàn zài máng ma? B: Wǒ dú shū ne. A: Hǎo, wǒ míng tiān zài shuō.",
      "meaning": "B đang đọc sách trong thời điểm được hỏi. A nói sẽ nói thêm vào ngày mai; không suy cuộc trò chuyện đã diễn ra ngày mai.",
      "readingMinutes": 2
    },
