  "blocks": [
    {
      "id": "l244-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "老师 là giáo viên; 学 là học; 明天 là ngày mai. 没有/没 phủ định sự việc đã xảy ra. Nhắc lại các nghĩa hỗ trợ, không tính thành mục từ mới HSK2.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t0",
      "type": "teaching",
      "title": "Nhắc lại · 书包 · cặp sách",
      "text": "书包 là cặp dùng mang sách vở; không dùng thay cho mọi loại túi.",
      "hanzi": "我的书在书包里。",
      "pinyin": "Wǒ de shū zài shūbāo li.",
      "meaning": "Sách của tôi ở trong cặp.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t1",
      "type": "teaching",
      "title": "Nhắc lại · 教室 · phòng học",
      "text": "教室 đọc jiàoshì; chữ 教 trong từ này đọc jiào, khác động từ 教 jiāo ở dưới.",
      "hanzi": "学生都在教室里。",
      "pinyin": "Xuésheng dōu zài jiàoshì li.",
      "meaning": "Các học sinh đều ở trong phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t2",
      "type": "teaching",
      "title": "Nhắc lại · 题 · câu hỏi hoặc bài toán trong bài tập",
      "text": "题 dùng cho câu/bài cần làm trong bài tập, không phải mọi câu hỏi giao tiếp. Hỏi ‘câu này’ dùng 这道题; 道 là lượng từ hỗ trợ SUPPLEMENTARY, cấp chưa kiểm chứng.",
      "hanzi": "这道题我没看懂。",
      "pinyin": "Zhè dào tí wǒ méi kàn dǒng.",
      "meaning": "Câu bài tập này tôi đọc chưa hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t3",
      "type": "teaching",
      "title": "Nhắc lại · 考试 · kiểm tra hoặc kỳ thi",
      "text": "考试 có thể là việc thi hoặc một kỳ thi; 明天有考试 nói ngày mai có bài kiểm tra. Không suy ra đây là kỳ HSK chính thức.",
      "hanzi": "我们明天有考试。",
      "pinyin": "Wǒmen míngtiān yǒu kǎoshì.",
      "meaning": "Ngày mai chúng tôi có bài kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t4",
      "type": "teaching",
      "title": "Nhắc lại · 教 · dạy",
      "text": "Động từ dạy đọc jiāo: 教我们中文. Không đọc jiào như trong 教室.",
      "hanzi": "王老师教我们中文。",
      "pinyin": "Wáng lǎoshī jiāo wǒmen Zhōngwén.",
      "meaning": "Thầy/cô Vương dạy chúng tôi tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-t5",
      "type": "teaching",
      "title": "Nhắc lại · 懂 · hiểu",
      "text": "懂 nói hiểu nội dung hoặc lời nói; 不懂 có thể nói chưa hiểu nói chung, 没看懂 nói lần đọc chưa hiểu.",
      "hanzi": "这个字是什么意思？我不懂。",
      "pinyin": "Zhège zì shì shénme yìsi? Wǒ bù dǒng.",
      "meaning": "Chữ này nghĩa là gì? Tôi không hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l244-t0-l204-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "Đặt 懂 sau 看 hoặc 听 để nói đạt kết quả hiểu: 看懂 là đọc xem và hiểu. 没看懂 nghĩa là đã đọc nhưng chưa hiểu; không dùng 不看懂 để kể kết quả chưa đạt của lần đọc này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l244-t0-l204-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：明天有考试。学生：老师，这道题我没看懂。老师：我们一起看。学生：好，我的书在书包里。",
      "pinyin": "Lǎoshī: Míngtiān yǒu kǎoshì. Xuésheng: Lǎoshī, zhè dào tí wǒ méi kàn dǒng. Lǎoshī: Wǒmen yìqǐ kàn. Xuésheng: Hǎo, wǒ de shū zài shūbāo li.",
      "meaning": "Giáo viên: Ngày mai có bài kiểm tra. Học sinh: Thầy/cô ơi, em đọc câu này chưa hiểu. Giáo viên: Chúng ta cùng xem. Học sinh: Vâng, sách của em ở trong cặp.",
      "readingMinutes": 2
    },
