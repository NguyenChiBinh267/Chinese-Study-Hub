  "blocks": [
    {
      "id": "l111-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l111-t0",
      "type": "teaching",
      "title": "书 · sách",
      "text": "书 chỉ sách; 一本书 là một quyển sách, không phải 一书.",
      "hanzi": "这是我的书。",
      "pinyin": "Zhè shì wǒ de shū.",
      "meaning": "Đây là sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l111-t1",
      "type": "teaching",
      "title": "本 · quyển; cuốn (lượng từ)",
      "text": "本 trong 一本书 là lượng từ cho sách, không dịch là gốc trong câu này.",
      "hanzi": "我有一本书。",
      "pinyin": "Wǒ yǒu yì běn shū.",
      "meaning": "Tôi có một quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l111-t2",
      "type": "teaching",
      "title": "个 · cái; người (lượng từ phổ biến)",
      "text": "个 đếm người/vật ở các trường hợp được học; không dùng 一个人 để chỉ số quyển sách.",
      "hanzi": "一个朋友。",
      "pinyin": "Yí ge péng you.",
      "meaning": "Một người bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l111-t3",
      "type": "teaching",
      "title": "桌子 · bàn",
      "text": "桌子 là bàn; âm 子 nhẹ trong mục từ này.",
      "hanzi": "这是桌子。",
      "pinyin": "Zhè shì zhuō zi.",
      "meaning": "Đây là bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l111-t4",
      "type": "teaching",
      "title": "椅子 · ghế",
      "text": "椅子 là ghế, không đồng nghĩa bàn; so sánh chữ đầu để tránh lẫn hai đồ dùng.",
      "hanzi": "那是椅子。",
      "pinyin": "Nà shì yǐ zi.",
      "meaning": "Kia là ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l111-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Số + lượng từ + danh từ: 一本书, 一个朋友. 本 thường đếm sách, 个 là lượng từ phổ biến nhưng không thay đúng mọi lượng từ. 桌子/椅子 là bàn/ghế; ví dụ giới thiệu đối tượng không cần thêm lượng từ sau 是 nếu chỉ gọi loại. 有 được chú giải là có, sẽ thành mục từ ở bài gia đình.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l111-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这是你的书吗？\nB：是，我有一本书。\nA：那是桌子吗？\nB：不是，那是椅子。",
      "pinyin": "A: Zhè shì nǐ de shū ma? B: Shì, wǒ yǒu yì běn shū. A: Nà shì zhuō zi ma? B: Bú shì, nà shì yǐ zi.",
      "meaning": "有 yǒu là có. B nói có một quyển sách và sửa đối tượng ở xa là ghế, không phải bàn. 一 đứng trước 本 đọc yì trong câu; pinyin mục 一 vẫn yī.",
      "readingMinutes": 2
    },
