  "blocks": [
    {
      "id": "l331-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 沿着 yánzhe: dọc theo; 流向 liú xiàng: chảy về; 天空 tiānkōng: bầu trời; 晴 qíng: quang/nắng; 记录 jìlù: ghi chép; 气候 qìhòu: khí hậu. Không biến quan sát một ngày thành xu hướng. 升起 shēng qǐ: lên/nhô lên; 轮 lún: lượng từ mặt trăng trong câu; từ hỗ trợ, chưa xác minh cấp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l331-t0",
      "type": "teaching",
      "title": "风 · gió",
      "text": "风 là gió; 刮风 là có gió, 风大 là gió mạnh. Không dùng 很风 như tính từ thông thường.",
      "hanzi": "今天风很大。",
      "pinyin": "Jīntiān fēng hěn dà.",
      "meaning": "Hôm nay gió mạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l331-t1",
      "type": "teaching",
      "title": "刮 · thổi (gió); cạo tùy ngữ cảnh",
      "text": "刮 trong 刮风 nói gió thổi; chưa dạy mọi nghĩa cạo. 刮起了风 nêu bắt đầu nổi gió.",
      "hanzi": "外面刮风了。",
      "pinyin": "Wàimian guā fēng le.",
      "meaning": "Ngoài trời có gió rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l331-t2",
      "type": "teaching",
      "title": "太阳 · mặt trời",
      "text": "太阳 là mặt trời; 太阳出来了 nói mặt trời ló ra trong cảnh, không phải dự báo mọi nơi.",
      "hanzi": "太阳出来了，天亮了。",
      "pinyin": "Tàiyáng chūlái le, tiān liàng le.",
      "meaning": "Mặt trời lên, trời sáng rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l331-t3",
      "type": "teaching",
      "title": "月亮 · mặt trăng",
      "text": "月亮 là mặt trăng, 亮 đọc nhẹ trong mục từ; không đồng nhất với 月 là tháng.",
      "hanzi": "晚上我们看月亮。",
      "pinyin": "Wǎnshang wǒmen kàn yuèliang.",
      "meaning": "Buổi tối chúng tôi ngắm trăng.",
      "readingMinutes": 1
    },
    {
      "id": "l331-t4",
      "type": "teaching",
      "title": "海 · biển",
      "text": "海 là biển, không phải mọi dòng nước lớn. 海边 là ven biển, 河边 là bờ sông.",
      "hanzi": "他们住在海边。",
      "pinyin": "Tāmen zhù zài hǎi biān.",
      "meaning": "Họ sống ven biển.",
      "readingMinutes": 1
    },
    {
      "id": "l331-t5",
      "type": "teaching",
      "title": "河 · sông",
      "text": "河 là sông; 一条河 dùng 条. Không suy ra nước sông uống được từ câu mô tả.",
      "hanzi": "公园旁边有一条河。",
      "pinyin": "Gōngyuán pángbiān yǒu yì tiáo hé.",
      "meaning": "Cạnh công viên có một con sông.",
      "readingMinutes": 1
    },
    {
      "id": "l331-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "天空中升起了一轮月亮 nêu nơi xuất hiện trước rồi sự vật mới sau; 月亮出来了 là chủ thể đã biết. Bài luyện cấu trúc 处所+动词+了+事物, không đánh giá thiên văn học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l331-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "白天太阳出来了，小林沿着河走。河流向海。晚上刮起了风，天空中升起了一轮月亮。他回家以后写下：今天白天晴，晚上有风。这是一天天气的记录，不是整个地方的气候结论。",
      "pinyin": "Báitiān tàiyáng chūlái le, Xiǎo Lín yánzhe hé zǒu. Hé liú xiàng hǎi. Wǎnshang guā qǐ le fēng, tiānkōng zhōng shēng qǐ le yì lún yuèliang. Tā huí jiā yǐhòu xiě xià: Jīntiān báitiān qíng, wǎnshang yǒu fēng. Zhè shì yì tiān tiānqì de jìlù, bú shì zhěng ge dìfang de qìhòu jiélùn.",
      "meaning": "Lâm đi dọc sông ban ngày trời nắng, tối nổi gió và có trăng. Cậu ghi thời tiết một ngày, không rút kết luận khí hậu cả vùng.",
      "readingMinutes": 2
    },
    {
