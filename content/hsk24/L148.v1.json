  "blocks": [
    {
      "id": "l148-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l148-t0",
      "type": "teaching",
      "title": "星期日 · Chủ nhật (dạng kết thúc bằng rì)",
      "text": "星期日 cùng ngày với 星期天; đừng gán hai tên này thành hai ngày khác nhau.",
      "hanzi": "星期日我休息。",
      "pinyin": "Xīng qī rì wǒ xiū xi.",
      "meaning": "Chủ nhật tôi nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l148-t1",
      "type": "teaching",
      "title": "星期天 · Chủ nhật (dạng kết thúc bằng tiān)",
      "text": "星期天 là tên khác của Chủ nhật; đề âm đọc này giữ chữ 天 ở cuối.",
      "hanzi": "我星期天不上班。",
      "pinyin": "Wǒ xīng qī tiān bù shàng bān.",
      "meaning": "Tôi không đi làm vào Chủ nhật.",
      "readingMinutes": 1
    },
    {
      "id": "l148-t2",
      "type": "teaching",
      "title": "时候 · lúc; khi (dạng shíhou)",
      "text": "时候 trong 什么时候 hỏi lúc nào; âm sau nhẹ theo mục từ.",
      "hanzi": "你什么时候上课？",
      "pinyin": "Nǐ shén me shí hou shàng kè?",
      "meaning": "Bạn lên lớp khi nào?",
      "readingMinutes": 1
    },
    {
      "id": "l148-t3",
      "type": "teaching",
      "title": "时间 · thời gian (dạng shíjiān)",
      "text": "时间 trong 有时间 nói có thời gian rảnh cho việc đang nêu; không có giờ cụ thể nếu chưa nói.",
      "hanzi": "我有时间。",
      "pinyin": "Wǒ yǒu shí jiān.",
      "meaning": "Tôi có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l148-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "星期日/星期天 cùng chỉ Chủ nhật; bài phân biệt cách đọc/chữ cuối khi yêu cầu hình thức. 什么 + 时候 tạo câu hỏi khi nào: 你什么时候上课？时间 trong 有时间 nói có thời gian. Hai danh từ thời gian có chỗ giao nhau, nên đề từ vựng luôn chỉ rõ mục/âm đang hỏi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l148-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你星期天上班吗？\nB：不上班，我有时间。\nA：你什么时候读书？\nB：星期日我读书。",
      "pinyin": "A: Nǐ xīng qī tiān shàng bān ma? B: Bù shàng bān, wǒ yǒu shí jiān. A: Nǐ shén me shí hou dú shū? B: Xīng qī rì wǒ dú shū.",
      "meaning": "星期天 và 星期日 cùng Chủ nhật. B không đi làm và đọc sách vào ngày ấy; đoạn không nêu giờ.",
      "readingMinutes": 2
    },
