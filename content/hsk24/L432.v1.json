  "blocks": [
    {
      "id": "l432-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 聚餐 jùcān: ăn chung; 饮料 yǐnliào: đồ uống; 主人 zhǔrén: chủ nhà. Không đánh đồng 干杯 với bắt buộc uống cồn. Mọi lựa chọn đồ uống trong đoạn là hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l432-t0",
      "type": "teaching",
      "title": "白酒 · rượu trắng Trung Quốc",
      "text": "白酒 là loại rượu chưng cất thường gọi bạch tửu; ở đây chỉ nhận diện từ, không hướng dẫn uống hay giới thiệu nhãn hàng.",
      "hanzi": "桌上有白酒，也有果汁。",
      "pinyin": "Zhuō shàng yǒu báijiǔ, yě yǒu guǒzhī.",
      "meaning": "Trên bàn có rượu trắng và nước trái cây.",
      "readingMinutes": 1
    },
    {
      "id": "l432-t1",
      "type": "teaching",
      "title": "干杯 · nâng cốc chúc nhau",
      "text": "干杯 là lời/hành động nâng cốc trong giao tiếp; không bắt buộc đồ uống có cồn hoặc phải uống hết trong tình huống bài.",
      "hanzi": "我们用果汁干杯。",
      "pinyin": "Wǒmen yòng guǒzhī gānbēi.",
      "meaning": "Chúng tôi nâng cốc bằng nước trái cây.",
      "readingMinutes": 1
    },
    {
      "id": "l432-t2",
      "type": "teaching",
      "title": "顿 · bữa (lượng từ)",
      "text": "顿 đếm bữa ăn như 一顿饭, không phải tên món; bài không dạy nghĩa động từ ở cấp khác. Nhận diện chữ 顿 trong 顿; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "谢谢你请我吃这顿饭。",
      "pinyin": "Xièxie nǐ qǐng wǒ chī zhè dùn fàn.",
      "meaning": "Cảm ơn bạn mời tôi bữa này.",
      "readingMinutes": 1
    },
    {
      "id": "l432-t3",
      "type": "teaching",
      "title": "倒 · rót, đổ vào",
      "text": "倒 đọc dào khi rót chất lỏng; không dùng dǎo là ngã/đổ sập, và chưa dạy nghĩa phó từ của cấp sau.",
      "hanzi": "请把果汁倒进杯子里。",
      "pinyin": "Qǐng bǎ guǒzhī dào jìn bēizi lǐ.",
      "meaning": "Hãy rót nước trái cây vào cốc.",
      "readingMinutes": 1
    },
    {
      "id": "l432-t4",
      "type": "teaching",
      "title": "果汁 · nước trái cây",
      "text": "果汁 là nước từ trái cây trong cách gọi thông thường; tên gọi chưa cho biết thành phần của từng sản phẩm thật.",
      "hanzi": "她想喝一杯果汁。",
      "pinyin": "Tā xiǎng hē yì bēi guǒzhī.",
      "meaning": "Cô ấy muốn uống một cốc nước trái cây.",
      "readingMinutes": 1
    },
    {
      "id": "l432-t5",
      "type": "teaching",
      "title": "盒子 · hộp",
      "text": "盒子 là đồ đựng có dạng hộp, đọc hézi âm 子 nhẹ; khác 杯子 là cốc để uống.",
      "hanzi": "这个盒子里装着饼干。",
      "pinyin": "Zhège hézi lǐ zhuāng zhe bǐnggān.",
      "meaning": "Trong hộp này có bánh quy.",
      "readingMinutes": 1
    },
    {
      "id": "l432-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不是A，就是B giới hạn vào hai khả năng trong ngữ cảnh, khác 不是A，而是B là bác A xác nhận B. Câu mẫu chỉ nói hai lựa chọn đã được xác nhận trong đoạn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l432-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "聚餐前，主人把饼干放进盒子，又把果汁倒进杯子。桌上虽然也有白酒，但客人都选择了果汁或茶：他们杯子里不是果汁，就是茶。大家用自己的饮料干杯，感谢主人准备这一顿饭。",
      "pinyin": "Jùcān qián, zhǔrén bǎ bǐnggān fàng jìn hézi, yòu bǎ guǒzhī dào jìn bēizi. Zhuō shàng suīrán yě yǒu báijiǔ, dàn kèrén dōu xuǎnzé le guǒzhī huò chá: Tāmen bēizi lǐ bú shì guǒzhī, jiù shì chá. Dàjiā yòng zìjǐ de yǐnliào gānbēi, gǎnxiè zhǔrén zhǔnbèi zhè yí dùn fàn.",
      "meaning": "Chủ nhà chuẩn bị bánh và nước. Dù trên bàn có rượu, khách chọn nước trái cây hoặc trà rồi nâng cốc cảm ơn bữa ăn.",
      "readingMinutes": 2
    },
