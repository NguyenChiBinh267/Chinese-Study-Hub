  "blocks": [
    {
      "id": "l1109-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1109-grammar",
      "type": "teaching",
      "title": "Cách nói và lỗi thường gặp",
      "text": "都 đứng trước vị ngữ và nói toàn bộ thành viên trong phạm vi đang nhắc: 我们都学习汉语. Phải đọc rõ chủ thể; 我们 chỉ nhóm người nói, không tự bao gồm mọi người trên thế giới. 我们都不是学生 phủ định với cả nhóm, khác 我们不都是学生 là không phải tất cả đều là học sinh. Bài giới thiệu tương phản này bằng dịch nghĩa có dữ kiện, không chấm suy đoán tình trạng thực của người học.",
      "hanzi": "我们都学习汉语。",
      "pinyin": "Wǒ men dōu xué xí Hàn yǔ.",
      "meaning": "Chúng tôi đều học tiếng Hán.",
      "readingMinutes": 3
    },
    {
      "id": "l1109-reminder0",
      "type": "teaching",
      "title": "都 · đều; tất cả (dạng dōu)",
      "text": "Nhắc nghĩa đã học: đều; tất cả (dạng dōu). Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我们都学习汉语。",
      "pinyin": "Wǒ men dōu xué xí Hàn yǔ.",
      "meaning": "Chúng tôi đều học tiếng Hán.",
      "readingMinutes": 1
    },
    {
      "id": "l1109-reminder1",
      "type": "teaching",
      "title": "我们 · chúng tôi; chúng ta",
      "text": "Nhắc nghĩa đã học: chúng tôi; chúng ta. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我们喜欢茶。",
      "pinyin": "Wǒ men xǐ huan chá.",
      "meaning": "Chúng tôi thích trà.",
      "readingMinutes": 1
    },
    {
      "id": "l1109-reminder2",
      "type": "teaching",
      "title": "你们 · các bạn",
      "text": "Nhắc nghĩa đã học: các bạn. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "你们叫什么名字？",
      "pinyin": "Nǐ men jiào shén me míng zi?",
      "meaning": "Các bạn tên là gì?",
      "readingMinutes": 1
    },
    {
      "id": "l1109-reminder3",
      "type": "teaching",
      "title": "学生 · học sinh; sinh viên",
      "text": "Nhắc nghĩa đã học: học sinh; sinh viên. Đọc ví dụ trong phạm vi nghĩa đã học; không đổi thẻ ôn.",
      "hanzi": "我是学生。",
      "pinyin": "Wǒ shì xué shēng.",
      "meaning": "Tôi là học sinh/sinh viên.",
      "readingMinutes": 1
    },
    {
      "id": "l1109-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你们都是学生吗？\nB：不是，我们不都是学生。\nA：你们都学习汉语吗？\nB：对，我们都学习汉语。",
      "pinyin": "A: Nǐ men dōu shì xué shēng ma? B: Bú shì, wǒ men bù dōu shì xué shēng. A: Nǐ men dōu xué xí Hàn yǔ ma? B: Duì, wǒ men dōu xué xí Hàn yǔ.",
      "meaning": "B nói không phải toàn bộ nhóm đều là học sinh; toàn nhóm đều học tiếng Hán. Không suy rằng không ai là học sinh.",
      "readingMinutes": 2
    },
