  "blocks": [
    {
      "id": "l4027-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t0",
      "type": "teaching",
      "title": "普通 · bình thường; phổ thông",
      "text": "普通 tả sự thông thường, không đồng nghĩa chất lượng thấp. Nhận diện chữ 普 trong 普通; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这是一本普通的练习册。",
      "pinyin": "Zhè shì yì běn pǔ tōng de liàn xí cè.",
      "meaning": "Đây là một quyển bài tập bình thường.",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t1",
      "type": "teaching",
      "title": "普通话 · tiếng phổ thông Trung Quốc",
      "text": "普通话 là tên một dạng ngôn ngữ chung, không phải mọi phương ngữ.",
      "hanzi": "她每天练习普通话。",
      "pinyin": "Tā měi tiān liàn xí pǔ tōng huà.",
      "meaning": "Cô ấy luyện tiếng phổ thông hằng ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t2",
      "type": "teaching",
      "title": "流利 · trôi chảy",
      "text": "流利 nói cách diễn đạt ít ngập ngừng; không bảo đảm mọi câu đều đúng.",
      "hanzi": "他能流利地介绍自己。",
      "pinyin": "Tā néng liú lì de jiè shào zì jǐ.",
      "meaning": "Anh ấy có thể tự giới thiệu trôi chảy.",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t3",
      "type": "teaching",
      "title": "区别 · khác biệt; phân biệt",
      "text": "区别 ở câu này là điểm khác nhau giữa hai cách nói.",
      "hanzi": "这两个词有什么区别？",
      "pinyin": "Zhè liǎng ge cí yǒu shén me qū bié?",
      "meaning": "Hai từ này có khác biệt gì?",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t4",
      "type": "teaching",
      "title": "内容 · nội dung",
      "text": "内容 chỉ điều được truyền đạt, khác tốc độ nói.",
      "hanzi": "请先想好介绍的内容。",
      "pinyin": "Qǐng xiān xiǎng hǎo jiè shào de nèi róng.",
      "meaning": "Hãy nghĩ trước nội dung giới thiệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4027-t5",
      "type": "teaching",
      "title": "说法 · cách nói",
      "text": "说法 chỉ cách diễn đạt hoặc quan điểm, không phải tốc độ phát âm.",
      "hanzi": "这种说法更自然。",
      "pinyin": "Zhè zhǒng shuō fǎ gèng zì rán.",
      "meaning": "Cách nói này tự nhiên hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l4027-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既…又… nối hai đặc điểm cùng đúng: 既普通又实用. Không dùng để biểu thị tương phản hoặc quan hệ nguyên nhân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4027-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小文用一本普通的练习册练普通话。她先准备内容，再比较两种说法的区别。朋友说：“这个方法既普通，又实用。慢慢练，不必一开始就说得很流利。”",
      "pinyin": "Xiǎo Wén yòng yì běn pǔ tōng de liàn xí cè liàn pǔ tōng huà. Tā xiān zhǔn bèi nèi róng, zài bǐ jiào liǎng zhǒng shuō fǎ de qū bié. Péng you shuō: “Zhè ge fāng fǎ jì pǔ tōng, yòu shí yòng. Màn man liàn, bú bì yì kāi shǐ jiù shuō de hěn liú lì.”",
      "meaning": "Tiểu Văn chuẩn bị nội dung rồi so sánh cách nói; bạn khuyên luyện dần.",
      "readingMinutes": 2
    },
    {
