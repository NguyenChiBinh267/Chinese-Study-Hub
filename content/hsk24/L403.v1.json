  "blocks": [
    {
      "id": "l403-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 方面 fāngmiàn: mặt/khía cạnh; 齐 qí、齐全 qíquán: đủ; 清单 qīngdān: danh sách; 逐项 zhú xiàng: từng mục; 核对 héduì: đối chiếu. Hồ sơ và phòng ban hư cấu. HSK3 đã có dạy từ vựng nháp, các kỹ năng khác và duyệt ngôn ngữ vẫn thiếu. Có thể đọc lại L375 về điều kiện, L384 về lời khuyên, L357 về kế hoạch học; không tự cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l403-t0",
      "type": "teaching",
      "title": "办公 · làm việc văn phòng",
      "text": "办公 là hoạt động làm công việc văn phòng, 办公室 là nơi. 在家办公 nói làm tại nhà, không tự có văn phòng riêng.",
      "hanzi": "她今天在家办公。",
      "pinyin": "Tā jīntiān zài jiā bàngōng.",
      "meaning": "Hôm nay cô ấy làm việc văn phòng ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l403-t1",
      "type": "teaching",
      "title": "办理 · làm/xử lý (thủ tục)",
      "text": "办理 thường nhận 手续、业务 để xử lý thủ tục, trang trọng hơn 办. 办理中不是已经办完.",
      "hanzi": "请先办理登记手续。",
      "pinyin": "Qǐng xiān bànlǐ dēngjì shǒuxù.",
      "meaning": "Hãy làm thủ tục đăng ký trước.",
      "readingMinutes": 1
    },
    {
      "id": "l403-t2",
      "type": "teaching",
      "title": "办事 · giải quyết công việc",
      "text": "办事 là xử lý việc/công việc thực tế; 来办事 nói đến làm việc, chưa tự là đi làm ở đơn vị đó.",
      "hanzi": "他来这个部门办事。",
      "pinyin": "Tā lái zhège bùmén bàn shì.",
      "meaning": "Anh ấy đến phòng ban này giải quyết việc.",
      "readingMinutes": 1
    },
    {
      "id": "l403-t3",
      "type": "teaching",
      "title": "部门 · phòng ban/bộ phận",
      "text": "部门 là bộ phận trong tổ chức, khác 门 là cửa vật lý. 不同部门可能分工不同，未给出真实组织规则.",
      "hanzi": "两个部门一起准备材料。",
      "pinyin": "Liǎng ge bùmén yìqǐ zhǔnbèi cáiliào.",
      "meaning": "Hai phòng ban cùng chuẩn bị hồ sơ.",
      "readingMinutes": 1
    },
    {
      "id": "l403-t4",
      "type": "teaching",
      "title": "材料 · tài liệu/vật liệu",
      "text": "材料 theo cảnh hồ sơ là tài liệu cần nộp, theo sản xuất có thể là vật liệu. Bài dạy nghĩa hồ sơ, không gộp mọi giấy tờ đều đủ điều kiện.",
      "hanzi": "材料还没准备齐。",
      "pinyin": "Cáiliào hái méi zhǔnbèi qí.",
      "meaning": "Hồ sơ còn chưa chuẩn bị đủ.",
      "readingMinutes": 1
    },
    {
      "id": "l403-t5",
      "type": "teaching",
      "title": "查看 · xem/kiểm tra bằng cách xem",
      "text": "查看 là xem kiểm thông tin/trạng thái; 看到 nhìn thấy chưa tự là đã kiểm đúng. 查看清单说 đối chiếu danh sách, không chứng minh đã được duyệt.",
      "hanzi": "请先查看材料清单。",
      "pinyin": "Qǐng xiān chákàn cáiliào qīngdān.",
      "meaning": "Hãy xem danh sách hồ sơ trước.",
      "readingMinutes": 1
    },
    {
      "id": "l403-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "在材料准备方面 giới hạn khía cạnh đang bàn: về chuẩn bị hồ sơ. Không suy từ một khâu làm tốt sang mọi mặt; 方面 đứng sau cụm danh từ chỉ lĩnh vực.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l403-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林到一个部门办事，发现工作人员今天在家办公。他先查看通知，知道办理登记需要准备材料。在材料准备方面，两个部门的要求不完全一样，所以他逐项核对清单，没有把上次交过的材料直接当作本次齐全。",
      "pinyin": "Xiǎo Lín dào yí ge bùmén bàn shì, fāxiàn gōngzuò rényuán jīntiān zài jiā bàngōng. Tā xiān chákàn tōngzhī, zhīdào bànlǐ dēngjì xūyào zhǔnbèi cáiliào. Zài cáiliào zhǔnbèi fāngmiàn, liǎng ge bùmén de yāoqiú bù wánquán yíyàng, suǒyǐ tā zhú xiàng héduì qīngdān, méiyǒu bǎ shàng cì jiāo guo de cáiliào zhíjiē dàngzuò běn cì qíquán.",
      "meaning": "Lâm đến giải quyết việc và thấy nhân viên làm ở nhà. Cậu xem thông báo, biết cần hồ sơ; yêu cầu hai bộ phận khác nhau nên đối chiếu từng mục, không coi hồ sơ lần trước đương nhiên đủ lần này.",
      "readingMinutes": 2
    },
    {
