  "blocks": [
    {
      "id": "l4022-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t0",
      "type": "teaching",
      "title": "租 · thuê; cho thuê",
      "text": "租 là dùng/cho dùng tài sản theo thỏa thuận; ngữ cảnh quyết định thuê vào hay cho thuê. Không nêu quy định hợp đồng thật.",
      "hanzi": "他们准备租一间小房间。",
      "pinyin": "Tā men zhǔn bèi zū yì jiān xiǎo fáng jiān.",
      "meaning": "Họ chuẩn bị thuê một phòng nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t1",
      "type": "teaching",
      "title": "钥匙 · chìa khóa",
      "text": "钥匙 là vật mở khóa; 匙 thường đọc nhẹ trong từ này, không đọc chí của 汤匙. Nhận diện chữ 钥 trong 钥匙; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我把钥匙放进包里。",
      "pinyin": "Wǒ bǎ yào shi fàng jìn bāo lǐ.",
      "meaning": "Tôi bỏ chìa khóa vào túi.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t2",
      "type": "teaching",
      "title": "外套 · áo khoác",
      "text": "外套 là lớp áo khoác ngoài, không phải bất kỳ bộ quần áo nào.",
      "hanzi": "这件外套放在衣柜里。",
      "pinyin": "Zhè jiàn wài tào fàng zài yī guì lǐ.",
      "meaning": "Áo khoác này để trong tủ quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t3",
      "type": "teaching",
      "title": "袜子 · tất; vớ",
      "text": "袜子 đi ở chân bên trong giày; khác 外套 là áo khoác.",
      "hanzi": "请把袜子装进这个袋子。",
      "pinyin": "Qǐng bǎ wà zi zhuāng jìn zhè ge dài zi.",
      "meaning": "Hãy bỏ tất vào túi này.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t4",
      "type": "teaching",
      "title": "躺 · nằm",
      "text": "躺 chỉ tư thế nằm của người/động vật, không phải nằm ở vị trí địa lý.",
      "hanzi": "他累了，在沙发上躺了一会儿。",
      "pinyin": "Tā lèi le, zài shā fā shàng tǎng le yí huìr.",
      "meaning": "Anh ấy mệt nên nằm trên ghế sofa một lúc.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-t5",
      "type": "teaching",
      "title": "抬 · nhấc; khiêng",
      "text": "抬 là nâng/khiêng lên, như cùng khiêng bàn; khác 拿 cầm một vật thông thường.",
      "hanzi": "两个人一起抬桌子。",
      "pinyin": "Liǎng ge rén yì qǐ tái zhuō zi.",
      "meaning": "Hai người cùng khiêng bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4022-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "你收拾你的吧 là cách nói để người kia tiếp tục phần việc của họ, người nói xử lý phần khác. Có thể nghe suồng sã; bài chỉ dùng giữa hai bạn thân đã phân công, không coi là cách nói lịch sự với mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4022-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安和朋友准备搬到新租的房间。他们先抬桌子，再把外套和袜子装好。朋友累了，在沙发上躺了一会儿。后来小安发现钥匙不见了，对正在收拾的朋友说：“你收拾你的吧，我来找钥匙。”最后钥匙就在小安的包里。",
      "pinyin": "Xiǎo Ān hé péng you zhǔn bèi bān dào xīn zū de fáng jiān. Tā men xiān tái zhuō zi, zài bǎ wài tào hé wà zi zhuāng hǎo. Péng you lèi le, zài shā fā shàng tǎng le yí huìr. Hòu lái Xiǎo Ān fā xiàn yào shi bú jiàn le, duì zhèng zài shōu shi de péng you shuō: “Nǐ shōu shi nǐ de ba, wǒ lái zhǎo yào shi.” Zuì hòu yào shi jiù zài Xiǎo Ān de bāo lǐ.",
      "meaning": "Hai bạn thu dọn để chuyển vào phòng mới thuê. Tiểu An nhận phần tìm chìa khóa, để bạn tiếp tục dọn; cuối cùng chìa trong túi mình.",
      "readingMinutes": 2
    },
