  "blocks": [
    {
      "id": "l452-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 训练 xùnliàn: tập luyện; 负担 fùdān: gánh nặng; 教练 jiàoliàn: huấn luyện viên. Chỉ học ngôn ngữ trong tình huống hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l452-t0",
      "type": "teaching",
      "title": "健身 · tập luyện thể hình",
      "text": "健身 là hoạt động rèn sức khỏe/thể lực; không hứa chữa bệnh.",
      "hanzi": "她每周去健身三次。",
      "pinyin": "Tā měi zhōu qù jiànshēn sān cì.",
      "meaning": "Cô ấy tập thể hình ba lần mỗi tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l452-t1",
      "type": "teaching",
      "title": "健身房 · phòng tập thể hình",
      "text": "健身房 là nơi tập, không đồng nghĩa bệnh viện hay cơ sở điều trị.",
      "hanzi": "健身房离我家很近。",
      "pinyin": "Jiànshēnfáng lí wǒ jiā hěn jìn.",
      "meaning": "Phòng tập gần nhà tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l452-t2",
      "type": "teaching",
      "title": "减轻 · giảm nhẹ",
      "text": "减轻 đi với mức gánh nặng, đau hay áp lực; ở đây 减轻训练负担.",
      "hanzi": "我们先减轻训练负担。",
      "pinyin": "Wǒmen xiān jiǎnqīng xùnliàn fùdān.",
      "meaning": "Trước hết chúng tôi giảm gánh nặng tập luyện.",
      "readingMinutes": 1
    },
    {
      "id": "l452-t3",
      "type": "teaching",
      "title": "咳 · ho",
      "text": "咳 ké là động từ ho, ngắn hơn 咳嗽; không nhầm hāi của tiếng than. Nhận diện chữ 咳 trong 咳; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他说了两句就开始咳。",
      "pinyin": "Tā shuō le liǎng jù jiù kāishǐ ké.",
      "meaning": "Anh ấy nói hai câu đã bắt đầu ho.",
      "readingMinutes": 1
    },
    {
      "id": "l452-t4",
      "type": "teaching",
      "title": "咳嗽 · ho",
      "text": "咳嗽 đọc ké sou với sou nhẹ; gần nghĩa 咳, bài hỏi dạng hai chữ khi nhập.",
      "hanzi": "她今天有点儿咳嗽。",
      "pinyin": "Tā jīntiān yǒu diǎnr késou.",
      "meaning": "Hôm nay cô ấy hơi ho.",
      "readingMinutes": 1
    },
    {
      "id": "l452-t5",
      "type": "teaching",
      "title": "难受 · khó chịu",
      "text": "难受 chỉ cảm giác khó chịu thân thể/tinh thần; chưa nêu nguyên nhân y học.",
      "hanzi": "我今天身体很难受。",
      "pinyin": "Wǒ jīntiān shēntǐ hěn nánshòu.",
      "meaning": "Hôm nay tôi thấy người khó chịu.",
      "readingMinutes": 1
    },
    {
      "id": "l452-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "恐怕 trước nhận định biểu thị lo ngại/ước đoán: 今天恐怕去不了健身房. Nó không phải chẩn đoán và không khẳng định kết quả chắc chắn. Câu chuyện chỉ luyện cách hoãn hẹn, không đưa phác đồ chữa bệnh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l452-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小徐本来约朋友去健身房，可今天身体难受，说几句话就咳，还一直咳嗽。他打电话说：“今天恐怕去不了健身房，我们改天再约吧。”朋友同意先取消这次安排。上周讨论的训练计划，也准备请教练看看怎样减轻训练负担。",
      "pinyin": "Xiǎo Xú běnlái yuē péngyou qù jiànshēnfáng, kě jīntiān shēntǐ nánshòu, shuō jǐ jù huà jiù ké, hái yìzhí késou. Tā dǎ diànhuà shuō: “Jīntiān kǒngpà qù bù liǎo jiànshēnfáng, wǒmen gǎi tiān zài yuē ba.” Péngyou tóngyì xiān qǔxiāo zhè cì ānpái. Shàng zhōu tǎolùn de xùnliàn jìhuà, yě zhǔnbèi qǐng jiàoliàn kànkan zěnyàng jiǎnqīng xùnliàn fùdān.",
      "meaning": "Từ khó chịu và ho nên gọi hoãn buổi tập. Hai người cũng định nhờ huấn luyện viên xem kế hoạch giảm gánh nặng tập. Đoạn không kết luận bệnh hay điều trị.",
      "readingMinutes": 2
    },
    {
