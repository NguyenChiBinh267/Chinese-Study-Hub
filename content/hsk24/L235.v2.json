  "blocks": [
    {
      "id": "l235-prereq",
      "type": "teaching",
      "title": "Kiến thức hỗ trợ",
      "text": "Nhắc 我/你/他, 是/有/在, số và câu hỏi cơ bản; HSK1 chưa hoàn chỉnh. Từ hỗ trợ trong ngữ cảnh được giải thích tại mỗi mục; không cộng từ mới hay cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l235-reminder0",
      "type": "teaching",
      "title": "Nhắc từ đã học · 姓",
      "text": "我姓王 dùng 姓 như động từ; câu trả lời chỉ họ, không yêu cầu tên đầy đủ. Không dùng 是 sau 姓 trong mẫu này.",
      "hanzi": "我姓王，你呢？",
      "pinyin": "Wǒ xìng Wáng, nǐ ne?",
      "meaning": "Tôi họ Vương, còn bạn?",
      "readingMinutes": 1
    },
    {
      "id": "l235-reminder1",
      "type": "teaching",
      "title": "Nhắc từ đã học · 班",
      "text": "Trong 我们班, 班 là danh từ lớp học. Không dạy nghĩa lượng từ cho chuyến xe thuộc cấp cao hơn.",
      "hanzi": "我们班有二十名学生。",
      "pinyin": "Wǒmen bān yǒu èrshí míng xuésheng.",
      "meaning": "Lớp chúng tôi có hai mươi học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l235-reminder2",
      "type": "teaching",
      "title": "Nhắc từ đã học · 词",
      "text": "词 là đơn vị từ, không phải mọi chữ Hán đơn lẻ. Một từ có thể có nhiều chữ, như 书包.",
      "hanzi": "这个词是什么意思？",
      "pinyin": "Zhège cí shì shénme yìsi?",
      "meaning": "Từ này có nghĩa gì?",
      "readingMinutes": 1
    },
    {
      "id": "l235-reminder3",
      "type": "teaching",
      "title": "Nhắc từ đã học · 高中",
      "text": "高中 là cấp trung học phổ thông; không phải mọi trường có tòa nhà cao. Không gán tuổi chính xác nếu câu không nêu.",
      "hanzi": "我姐姐在高中学习。",
      "pinyin": "Wǒ jiějie zài gāozhōng xuéxí.",
      "meaning": "Chị tôi học trung học phổ thông.",
      "readingMinutes": 1
    },
    {
      "id": "l235-grammar0",
      "type": "teaching",
      "title": "Cách nói 1",
      "text": "是……的 dùng nhấn thông tin của việc đã xảy ra. Trong ví dụ, 去年 là trọng tâm thời gian; không dùng mẫu này để tự động đánh dấu mọi câu quá khứ. 去年: năm ngoái.",
      "hanzi": "我是去年开始学中文的。",
      "pinyin": "Wǒ shì qùnián kāishǐ xué Zhōngwén de.",
      "meaning": "Tôi bắt đầu học tiếng Trung vào năm ngoái.",
      "readingMinutes": 1
    },
    {
      "id": "l235-grammar1",
      "type": "teaching",
      "title": "Cách nói 2",
      "text": "Danh ngữ chỉ tuổi có thể làm vị ngữ: 他今年十六岁. Câu nói tuổi trực tiếp thường không cần 是; 是 có thể xuất hiện để nhấn mạnh hoặc đính chính trong ngữ cảnh riêng.",
      "hanzi": "王同学今年十六岁。",
      "pinyin": "Wáng tóngxué jīnnián shíliù suì.",
      "meaning": "Bạn Vương năm nay 16 tuổi.",
      "readingMinutes": 1
    },
    {
      "id": "l235-grammar2",
      "type": "teaching",
      "title": "Cách nói 3",
      "text": "AA như 红红的苹果 tả màu nổi bật; AABB như 高高兴兴 diễn tả vẻ vui vẻ. 高高兴兴地来上课 dùng 地 khi làm trạng ngữ. Không phải tính từ nào cũng lặp tự do.",
      "hanzi": "她高高兴兴地来上课。",
      "pinyin": "Tā gāogāoxìngxìng de lái shàng kè.",
      "meaning": "Cô ấy vui vẻ đến học.",
      "readingMinutes": 1
    },
    {
      "id": "l235-grammar3",
      "type": "teaching",
      "title": "Cách nói 4",
      "text": "Trong 男孩儿跟女孩儿都…, 跟 nối hai nhóm ngang hàng và đều thuộc chủ ngữ. Khác 我跟奶奶一起去: 跟奶奶 diễn tả người đi cùng.",
      "hanzi": "男孩儿跟女孩儿都喜欢中文。",
      "pinyin": "Nánháir gēn nǚháir dōu xǐhuan Zhōngwén.",
      "meaning": "Nam và nữ đều thích tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l235-scene",
      "type": "teaching",
      "title": "Tình huống mới",
      "text": "Đọc thông tin người học, kể thời điểm bắt đầu và phân biệt nối danh từ với đi cùng.",
      "hanzi": "我姓王，今年十六岁，是高中学生。我是去年开始在这个班学中文的。我喜欢学新词。这个班的男孩儿跟女孩儿都喜欢中文，大家高高兴兴地来上课。",
      "pinyin": "Wǒ xìng Wáng, jīnnián shíliù suì, shì gāozhōng xuésheng. Wǒ shì qùnián kāishǐ zài zhège bān xué Zhōngwén de. Wǒ xǐhuan xué xīn cí. Zhège bān de nánháir gēn nǚháir dōu xǐhuan Zhōngwén, dàjiā gāogāoxìngxìng de lái shàng kè.",
      "meaning": "Tôi họ Vương, 16 tuổi, học sinh trung học phổ thông. Tôi bắt đầu học tiếng Trung ở lớp này vào năm ngoái. Tôi thích học từ mới. Nam và nữ trong lớp đều thích tiếng Trung; mọi người vui vẻ đến học.",
      "readingMinutes": 2
    },
    {
