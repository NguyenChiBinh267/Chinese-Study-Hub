  "blocks": [
    {
      "id": "l4070-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t0",
      "type": "teaching",
      "title": "琴 · đàn; nhạc cụ có dây/phím",
      "text": "琴 là tên chung theo ngữ cảnh; 弹琴 không tự xác định loại đàn cụ thể. Nhận diện chữ 琴 trong 琴; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她每天练习弹琴。",
      "pinyin": "Tā měi tiān liàn xí tán qín.",
      "meaning": "Cô ấy tập đàn hằng ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t1",
      "type": "teaching",
      "title": "艺术 · nghệ thuật",
      "text": "艺术 chỉ lĩnh vực sáng tạo như âm nhạc, hội họa.",
      "hanzi": "他对艺术很感兴趣。",
      "pinyin": "Tā duì yì shù hěn gǎn xìng qù.",
      "meaning": "Anh ấy rất hứng thú với nghệ thuật.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t2",
      "type": "teaching",
      "title": "杂志 · tạp chí",
      "text": "杂志 là ấn phẩm định kỳ, không phải mọi quyển sách.",
      "hanzi": "我借了一本艺术杂志。",
      "pinyin": "Wǒ jiè le yì běn yì shù zá zhì.",
      "meaning": "Tôi mượn một tạp chí nghệ thuật.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t3",
      "type": "teaching",
      "title": "阅读 · đọc; hoạt động đọc",
      "text": "阅读 dùng khi nói hoạt động tiếp nhận nội dung chữ viết.",
      "hanzi": "阅读以后，请写下问题。",
      "pinyin": "Yuè dú yǐ hòu, qǐng xiě xià wèn tí.",
      "meaning": "Đọc xong hãy ghi lại câu hỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t4",
      "type": "teaching",
      "title": "作文 · bài văn; làm văn",
      "text": "作文 ở đây là bài viết của người học.",
      "hanzi": "她写了一篇关于音乐的作文。",
      "pinyin": "Tā xiě le yì piān guān yú yīn yuè de zuò wén.",
      "meaning": "Cô ấy viết một bài văn về âm nhạc.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-t5",
      "type": "teaching",
      "title": "自学 · tự học",
      "text": "自学 nói học chủ động ngoài giờ có người trực tiếp dạy; vẫn có thể dùng tài liệu hoặc nhờ góp ý.",
      "hanzi": "他利用周末自学。",
      "pinyin": "Tā lì yòng zhōu mò zì xué.",
      "meaning": "Anh ấy tận dụng cuối tuần tự học.",
      "readingMinutes": 1
    },
    {
      "id": "l4070-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不仅…还… bổ sung hoạt động thứ hai. Bài này chỉ có văn bản mô tả việc học đàn và đọc; không có âm thanh để kiểm tra kỹ năng nghe.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4070-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安对艺术感兴趣，周末自学弹琴，也借艺术杂志阅读。她不仅练琴，还写了一篇关于音乐的作文。遇到不懂的内容，她写下问题，下次请老师解释。她不把看过一遍当作已经学会。",
      "pinyin": "Xiǎo Ān duì yì shù gǎn xìng qù, zhōu mò zì xué tán qín, yě jiè yì shù zá zhì yuè dú. Tā bù jǐn liàn qín, hái xiě le yì piān guān yú yīn yuè de zuò wén. Yù dào bù dǒng de nèi róng, tā xiě xià wèn tí, xià cì qǐng lǎo shī jiě shì. Tā bù bǎ kàn guo yí biàn dàng zuò yǐ jīng xué huì.",
      "meaning": "Tiểu An kết hợp luyện đàn, đọc tạp chí và viết bài; chỗ chưa hiểu được ghi lại để hỏi.",
      "readingMinutes": 2
    },
