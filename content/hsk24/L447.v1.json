  "blocks": [
    {
      "id": "l447-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 原价 yuánjià: giá gốc; 现价 xiànjià: giá hiện tại; 包装 bāozhuāng: bao bì; 标签 biāoqiān: nhãn; 考虑 kǎolǜ: cân nhắc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l447-t0",
      "type": "teaching",
      "title": "价格 · giá cả",
      "text": "价格 thường dùng khi trình bày/so sánh giá hàng hóa; trung tính hơi trang trọng.",
      "hanzi": "这件外套的价格降低了。",
      "pinyin": "Zhè jiàn wàitào de jiàgé jiàngdī le.",
      "meaning": "Giá áo khoác này đã giảm.",
      "readingMinutes": 1
    },
    {
      "id": "l447-t1",
      "type": "teaching",
      "title": "价钱 · giá tiền",
      "text": "价钱 gần nghĩa 价格, thông dụng trong hỏi mua. Bài này phân biệt theo yêu cầu hình thức chứ không nói từ kia sai nghĩa.",
      "hanzi": "请问这件衣服价钱多少？",
      "pinyin": "Qǐngwèn zhè jiàn yīfu jiàqián duōshao?",
      "meaning": "Xin hỏi áo này giá bao nhiêu?",
      "readingMinutes": 1
    },
    {
      "id": "l447-t2",
      "type": "teaching",
      "title": "减 · trừ, giảm",
      "text": "减 là động từ làm bớt số lượng; 三百减五十 là 300 trừ 50.",
      "hanzi": "三百减五十是二百五十。",
      "pinyin": "Sānbǎi jiǎn wǔshí shì èrbǎi wǔshí.",
      "meaning": "Ba trăm trừ năm mươi là hai trăm năm mươi.",
      "readingMinutes": 1
    },
    {
      "id": "l447-t3",
      "type": "teaching",
      "title": "减少 · giảm bớt",
      "text": "减少 đi với số lượng/tần suất, ví dụ 减少浪费; khác giảm mức giá thường dùng 降低价格.",
      "hanzi": "商店减少了包装。",
      "pinyin": "Shāngdiàn jiǎnshǎo le bāozhuāng.",
      "meaning": "Cửa hàng giảm bớt bao bì.",
      "readingMinutes": 1
    },
    {
      "id": "l447-t4",
      "type": "teaching",
      "title": "降低 · hạ thấp",
      "text": "降低 thường đi với mức độ như 价格、温度, không nói 降低人数 theo cách dùng mục tiêu. Nhận diện chữ 降 trong 降低; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "商店降低了部分商品的价格。",
      "pinyin": "Shāngdiàn jiàngdī le bùfen shāngpǐn de jiàgé.",
      "meaning": "Cửa hàng hạ giá một số mặt hàng.",
      "readingMinutes": 1
    },
    {
      "id": "l447-t5",
      "type": "teaching",
      "title": "降价 · giảm giá",
      "text": "降价 là giá được hạ, thường không trực tiếp nhận 价格 làm tân ngữ.",
      "hanzi": "这件外套今天降价了。",
      "pinyin": "Zhè jiàn wàitào jīntiān jiàngjià le.",
      "meaning": "Áo khoác này hôm nay giảm giá.",
      "readingMinutes": 1
    },
    {
      "id": "l447-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "由于 nêu nguyên nhân, 因此 nêu kết quả suy ra: 由于价格降低了，因此来买的人多了. Đây là quan hệ trong câu chuyện, không phải quy luật kinh tế luôn đúng. Không đảo kết quả thành nguyên nhân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l447-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "外套原价三百元，今天减五十元，现价二百五十元。店员说部分商品降价了，商店还减少了包装。小叶先问价钱，再核对标签。由于这件外套的价格降低了，因此来问的人多了；小叶仍然先考虑自己是否需要。",
      "pinyin": "Wàitào yuánjià sānbǎi yuán, jīntiān jiǎn wǔshí yuán, xiànjià èrbǎi wǔshí yuán. Diànyuán shuō bùfen shāngpǐn jiàngjià le, shāngdiàn hái jiǎnshǎo le bāozhuāng. Xiǎo Yè xiān wèn jiàqián, zài héduì biāoqiān. Yóuyú zhè jiàn wàitào de jiàgé jiàngdī le, yīncǐ lái wèn de rén duō le; Xiǎo Yè réngrán xiān kǎolǜ zìjǐ shìfǒu xūyào.",
      "meaning": "Áo từ 300 giảm 50 còn 250 tệ. Một số món hạ giá, cửa hàng cũng giảm bao bì. Diệp kiểm tra nhãn và nhu cầu dù có nhiều người hỏi vì giá giảm.",
      "readingMinutes": 2
    },
