  "blocks": [
    {
      "id": "l284-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder0",
      "type": "teaching",
      "title": "慢 · chậm",
      "text": "慢 nói tốc độ thấp; không tự đồng nghĩa với trễ giờ. 走得慢 là đi chậm, 得 dẫn phần mô tả mức độ.",
      "hanzi": "爷爷走得很慢。",
      "pinyin": "Yéye zǒu de hěn màn.",
      "meaning": "Ông nội đi rất chậm.",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder1",
      "type": "teaching",
      "title": "因为 · vì, bởi vì",
      "text": "因为 giới thiệu nguyên nhân được nêu trong lời nói. Ở đây luyện liên từ nối mệnh đề, không phân tích mọi cách dùng giới từ.",
      "hanzi": "因为今天很冷，我不去游泳。",
      "pinyin": "Yīnwèi jīntiān hěn lěng, wǒ bú qù yóuyǒng.",
      "meaning": "Vì hôm nay lạnh, tôi không đi bơi.",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder2",
      "type": "teaching",
      "title": "所以 · nên, cho nên",
      "text": "所以 đưa phần kết quả, không đặt vào chỗ nêu nguyên nhân. Có thể đi với 因为 trong mẫu đã học.",
      "hanzi": "今天很冷，所以我们在家。",
      "pinyin": "Jīntiān hěn lěng, suǒyǐ wǒmen zài jiā.",
      "meaning": "Hôm nay lạnh nên chúng tôi ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder3",
      "type": "teaching",
      "title": "开始 · bắt đầu",
      "text": "开始 có thể là động từ hoặc danh từ; ở đây nói hoạt động bắt đầu, không phải làm xong.",
      "hanzi": "考试九点开始。",
      "pinyin": "Kǎoshì jiǔ diǎn kāishǐ.",
      "meaning": "Bài kiểm tra bắt đầu lúc chín giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder4",
      "type": "teaching",
      "title": "完 · xong, hoàn tất",
      "text": "完 sau động từ nói đạt kết quả xong: 看完. 看了 chỉ đã đọc, chưa tự bảo đảm đọc hết.",
      "hanzi": "我看完这本书了。",
      "pinyin": "Wǒ kàn wán zhè běn shū le.",
      "meaning": "Tôi đọc xong quyển sách này rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l284-reminder5",
      "type": "teaching",
      "title": "记得 · nhớ, còn nhớ",
      "text": "记得 thường chỉ giữ được thông tin trong trí nhớ; không phải mọi cách học thuộc. 得 trong từ này đọc nhẹ.",
      "hanzi": "我记得明天有考试。",
      "pinyin": "Wǒ jìde míngtiān yǒu kǎoshì.",
      "meaning": "Tôi nhớ ngày mai có bài kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l284-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：今天是晴天，我们去游泳吧？乙：是晴天，但是很冷。甲：那我们去书店吧。乙：好，因为书店离这里远，所以我们坐地铁去。",
      "pinyin": "Jiǎ: Jīntiān shì qíngtiān, wǒmen qù yóuyǒng ba? Yǐ: Shì qíngtiān, dànshì hěn lěng. Jiǎ: Nà wǒmen qù shūdiàn ba. Yǐ: Hǎo, yīnwèi shūdiàn lí zhèlǐ yuǎn, suǒyǐ wǒmen zuò dìtiě qù.",
      "meaning": "A: Hôm nay trời quang, đi bơi nhé? B: Trời quang nhưng rất lạnh. A: Vậy đến hiệu sách nhé. B: Được, vì hiệu sách xa đây nên chúng ta đi tàu điện ngầm.",
      "readingMinutes": 2
    },
    {
      "id": "l284-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：考试快要开始了，你记得拿书吗？乙：记得，我已经拿来了。甲：这本书你看完了吗？乙：还没有，今天我想看完。",
      "pinyin": "Jiǎ: Kǎoshì kuàiyào kāishǐ le, nǐ jìde ná shū ma? Yǐ: Jìde, wǒ yǐjīng ná lái le. Jiǎ: Zhè běn shū nǐ kàn wán le ma? Yǐ: Hái méiyǒu, jīntiān wǒ xiǎng kàn wán.",
      "meaning": "A: Bài kiểm tra sắp bắt đầu, bạn nhớ lấy sách không? B: Nhớ, tôi lấy đến rồi. A: Bạn đọc xong quyển sách này chưa? B: Chưa, hôm nay tôi muốn đọc xong.",
      "readingMinutes": 2
    },
