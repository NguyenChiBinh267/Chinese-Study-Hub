  "blocks": [
    {
      "id": "l4044-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t0",
      "type": "teaching",
      "title": "邀请 · mời",
      "text": "邀请 là mời tham gia, không bảo đảm người được mời đã đồng ý.",
      "hanzi": "她邀请朋友周末来家里。",
      "pinyin": "Tā yāo qǐng péng you zhōu mò lái jiā lǐ.",
      "meaning": "Cô ấy mời bạn cuối tuần đến nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t1",
      "type": "teaching",
      "title": "约 · hẹn",
      "text": "约 là thỏa thuận thời gian gặp/làm việc.",
      "hanzi": "我们约好六点见。",
      "pinyin": "Wǒ men yuē hǎo liù diǎn jiàn.",
      "meaning": "Chúng tôi hẹn sáu giờ gặp.",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t2",
      "type": "teaching",
      "title": "约会 · cuộc hẹn; hẹn hò",
      "text": "约会 là cuộc hẹn, thường có sắc thái tình cảm tùy ngữ cảnh.",
      "hanzi": "这是他们第一次约会。",
      "pinyin": "Zhè shì tā men dì yī cì yuē huì.",
      "meaning": "Đây là lần hẹn hò đầu tiên của họ.",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t3",
      "type": "teaching",
      "title": "浪漫 · lãng mạn",
      "text": "浪漫 tả không khí/cách thể hiện tình cảm, không phải mọi cuộc gặp.",
      "hanzi": "她觉得这封信很浪漫。",
      "pinyin": "Tā jué de zhè fēng xìn hěn làng màn.",
      "meaning": "Cô ấy thấy bức thư rất lãng mạn.",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t4",
      "type": "teaching",
      "title": "祝 · chúc",
      "text": "祝 dùng trước lời mong điều tốt đẹp, như 祝你顺利.",
      "hanzi": "祝你演出顺利！",
      "pinyin": "Zhù nǐ yǎn chū shùn lì!",
      "meaning": "Chúc buổi diễn của bạn suôn sẻ!",
      "readingMinutes": 1
    },
    {
      "id": "l4044-t5",
      "type": "teaching",
      "title": "祝贺 · chúc mừng",
      "text": "祝贺 hướng tới thành quả/tin vui đã có, khác chúc cho tương lai. Nhận diện chữ 贺 trong 祝贺; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "大家祝贺他取得好成绩。",
      "pinyin": "Dà jiā zhù hè tā qǔ dé hǎo chéng jì.",
      "meaning": "Mọi người chúc mừng anh ấy đạt kết quả tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l4044-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不见面也能祝贺 nói việc không gặp trực tiếp không ngăn gửi lời chúc. Đây chỉ là tiểu mẫu không cần điều kiện A vẫn làm được B.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4044-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林邀请朋友看演出，约好六点见。朋友说自己那天有约会，不能来，但先说“祝你演出顺利”。演出后，她写信祝贺小林。小林觉得手写的信很浪漫：“不见面也能祝贺，谢谢你！”",
      "pinyin": "Xiǎo Lín yāo qǐng péng you kàn yǎn chū, yuē hǎo liù diǎn jiàn. Péng you shuō zì jǐ nà tiān yǒu yuē huì, bù néng lái, dàn xiān shuō “Zhù nǐ yǎn chū shùn lì”. Yǎn chū hòu, tā xiě xìn zhù hè Xiǎo Lín. Xiǎo Lín jué de shǒu xiě de xìn hěn làng màn: “Bú jiàn miàn yě néng zhù hè, xiè xie nǐ!”",
      "meaning": "Bạn không tới xem nhưng gửi lời chúc trước buổi diễn và thư chúc mừng sau đó.",
      "readingMinutes": 2
    },
