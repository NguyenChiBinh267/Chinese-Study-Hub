  "blocks": [
    {
      "id": "l352-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 正式 zhèngshì: chính thức; 真话 zhēnhuà: lời thật; 听到 tīngdào: nghe được, chỉ là nội dung đoạn đọc, không phải kiểm thử nghe thực.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l352-t0",
      "type": "teaching",
      "title": "心里 · trong lòng/trong suy nghĩ",
      "text": "心里 nói nội tâm hoặc ý nghĩ, không phải vị trí giải phẫu dùng trong y khoa. 心里想 nêu điều nghĩ thầm.",
      "hanzi": "我心里有一个问题。",
      "pinyin": "Wǒ xīnlǐ yǒu yí ge wèntí.",
      "meaning": "Trong lòng tôi có một thắc mắc.",
      "readingMinutes": 1
    },
    {
      "id": "l352-t1",
      "type": "teaching",
      "title": "相信 · tin/tin tưởng",
      "text": "相信 là tin người/thông tin, chưa chứng minh thông tin đúng. 我相信你 là thái độ tin tưởng của chủ thể.",
      "hanzi": "我相信你说的是真话。",
      "pinyin": "Wǒ xiāngxìn nǐ shuō de shì zhēnhuà.",
      "meaning": "Tôi tin điều bạn nói là thật.",
      "readingMinutes": 1
    },
    {
      "id": "l352-t2",
      "type": "teaching",
      "title": "听说 · nghe nói",
      "text": "听说 đánh dấu nhận thông tin qua lời người khác; không tự là đã kiểm chứng hay một bài nghe có audio.",
      "hanzi": "听说学校明天放假。",
      "pinyin": "Tīngshuō xuéxiào míngtiān fàng jià.",
      "meaning": "Nghe nói ngày mai trường nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l352-t3",
      "type": "teaching",
      "title": "以为 · tưởng/đã cho rằng",
      "text": "以为 thường nêu suy nghĩ trước có thể sai; 我以为放假了 chưa khẳng định thực tế nghỉ. Cần đối chiếu câu sau.",
      "hanzi": "我以为今天不上课。",
      "pinyin": "Wǒ yǐwéi jīntiān bú shàng kè.",
      "meaning": "Tôi tưởng hôm nay không học.",
      "readingMinutes": 1
    },
    {
      "id": "l352-t4",
      "type": "teaching",
      "title": "认为 · cho rằng/nhận định",
      "text": "认为 nêu quan điểm hay đánh giá; không hàm ý chắc chắn sai như khuynh hướng 以为 trong ví dụ đối chiếu, cũng không tự là chứng cứ.",
      "hanzi": "我认为先看通知比较好。",
      "pinyin": "Wǒ rènwéi xiān kàn tōngzhī bǐjiào hǎo.",
      "meaning": "Tôi cho rằng xem thông báo trước tốt hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l352-t5",
      "type": "teaching",
      "title": "看来 · xem ra/có vẻ",
      "text": "看来 ở đầu câu đưa kết luận từ thông tin hiện có, vẫn có thể sửa khi biết thêm. 不 phải hành động quay đầu nhìn lại.",
      "hanzi": "看来明天还要上课。",
      "pinyin": "Kànlái míngtiān hái yào shàng kè.",
      "meaning": "Xem ra ngày mai vẫn phải đi học.",
      "readingMinutes": 1
    },
    {
      "id": "l352-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "看来 nêu kết luận dựa trên điều vừa biết, chưa chắc chắn tuyệt đối. 在我看来 nêu quan điểm cá nhân; 以为常 đưa niềm tin trước đó có thể sai, không là bằng chứng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l352-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林听说学校放假，心里很开心。他说：我以为明天不上课。朋友说：我相信你听到了，但我认为先看正式通知比较好。两人看完通知才说：看来明天还要上课。",
      "pinyin": "Xiǎo Lín tīngshuō xuéxiào fàng jià, xīnlǐ hěn kāixīn. Tā shuō: Wǒ yǐwéi míngtiān bú shàng kè. Péngyou shuō: Wǒ xiāngxìn nǐ tīngdào le, dàn wǒ rènwéi xiān kàn zhèngshì tōngzhī bǐjiào hǎo. Liǎng rén kàn wán tōngzhī cái shuō: Kànlái míngtiān hái yào shàng kè.",
      "meaning": "Lâm vui vì nghe tin nghỉ. Bạn tin cậu đã nghe nhưng đề nghị kiểm tra thông báo chính thức. Xem xong họ nhận ra ngày mai vẫn học.",
      "readingMinutes": 2
    },
    {
