  "blocks": [
    {
      "id": "l117-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l117-t0",
      "type": "teaching",
      "title": "新 · mới",
      "text": "新 tả đồ vật mới; không có nghĩa chỉ một món chưa từng thuộc về ai trong mọi ngữ cảnh.",
      "hanzi": "这本书很新。",
      "pinyin": "Zhè běn shū hěn xīn.",
      "meaning": "Quyển sách này mới.",
      "readingMinutes": 1
    },
    {
      "id": "l117-t1",
      "type": "teaching",
      "title": "好看 · đẹp; dễ nhìn",
      "text": "好看 trong câu khen hình thức con mèo đẹp; không lấy nghĩa này cho mọi động từ 看 đứng riêng.",
      "hanzi": "那只猫很好看。",
      "pinyin": "Nà zhī māo hěn hǎo kàn.",
      "meaning": "Con mèo kia đẹp/dễ nhìn.",
      "readingMinutes": 1
    },
    {
      "id": "l117-t2",
      "type": "teaching",
      "title": "漂亮 · đẹp; xinh",
      "text": "漂亮 tả vẻ đẹp ở ví dụ; đọc piào liang với âm sau nhẹ theo mục từ.",
      "hanzi": "那只猫很漂亮。",
      "pinyin": "Nà zhī māo hěn piào liang.",
      "meaning": "Con mèo kia đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l117-t3",
      "type": "teaching",
      "title": "很 · rất; yếu tố mức độ",
      "text": "很 đứng trước tính từ trong câu này, không đặt sau tính từ theo trật tự tiếng Việt.",
      "hanzi": "我的学校很大。",
      "pinyin": "Wǒ de xué xiào hěn dà.",
      "meaning": "Trường tôi rộng/lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l117-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Câu miêu tả có thể theo mẫu chủ thể + 很 + tính từ: 这本书很新. 很 không nhất thiết nhấn “rất” mạnh trong mọi câu, nhưng có thể mang mức độ theo ngữ cảnh. 好看/漂亮 đều tả đẹp trong các ví dụ; không coi chúng thay nhau đúng ở mọi kết hợp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l117-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你的书很新。\nB：谢谢。\nA：那只猫很好看。\nB：是，很漂亮。",
      "pinyin": "A: Nǐ de shū hěn xīn. B: Xiè xie. A: Nà zhī māo hěn hǎo kàn. B: Shì, hěn piào liang.",
      "meaning": "学校 xué xiào trong ví dụ là trường học, sẽ học thành mục từ ở bài sau. Trong đoạn, A khen sách mới rồi nói con mèo đẹp; không suy chủ của con mèo.",
      "readingMinutes": 2
    },
