  "blocks": [
    {
      "id": "l164-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l164-t0",
      "type": "teaching",
      "title": "有的 · một số trong nhóm đã nêu (dạng yǒude)",
      "text": "有的 có thể thay các đối tượng đã biết; 的 nhẹ trong mục này.",
      "hanzi": "这些书，有的是新的。",
      "pinyin": "Zhè xiē shū, yǒu de shì xīn de.",
      "meaning": "Trong số sách này, có những quyển mới.",
      "readingMinutes": 1
    },
    {
      "id": "l164-t1",
      "type": "teaching",
      "title": "有点儿 · hơi; có phần (dạng yǒudiǎnr)",
      "text": "有点儿 trong 有点儿忙 nói mức độ hơi bận; không thay thẳng vào mẫu lượng nước 一点儿水.",
      "hanzi": "我有点儿忙。",
      "pinyin": "Wǒ yǒu diǎnr máng.",
      "meaning": "Tôi hơi bận.",
      "readingMinutes": 1
    },
    {
      "id": "l164-t2",
      "type": "teaching",
      "title": "一下 · một chút; một lượt ngắn (dạng yíxià)",
      "text": "一下 sau động từ làm nhẹ lời yêu cầu; đây không phải số đo thời gian chính xác.",
      "hanzi": "请读一下这个字。",
      "pinyin": "Qǐng dú yí xià zhè ge zì.",
      "meaning": "Xin đọc chữ này một chút/một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l164-t3",
      "type": "teaching",
      "title": "再 · lại; thêm lần nữa (dạng zài)",
      "text": "再 trong 请再说 nói thêm một lượt theo yêu cầu, khác 在 chỉ vị trí dù cùng âm zài.",
      "hanzi": "请再说。",
      "pinyin": "Qǐng zài shuō.",
      "meaning": "Xin nói lại.",
      "readingMinutes": 1
    },
    {
      "id": "l164-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động từ + 一下 thường nói làm một chút hoặc làm nhẹ lời yêu cầu: 请读一下这个字. Không quy nó thành chính xác một giây. 有点儿 đứng trước tính từ để nói hơi trong mẫu 有点儿忙; khác lượng 一点儿水. 有的 chỉ một số trong nhóm đã nêu; 再 trong 请再说 yêu cầu nói thêm lần nữa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l164-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：请读一下这个字。\nB：好。\nA：请再说。\nB：我有点儿忙。\nA：没关系。",
      "pinyin": "A: Qǐng dú yí xià zhè ge zì. B: Hǎo. A: Qǐng zài shuō. B: Wǒ yǒu diǎnr máng. A: Méi guān xi.",
      "meaning": "A đưa lời yêu cầu đọc/nói lại; B nói hơi bận. Đoạn viết không xác nhận người học đã đọc hoặc phát âm đúng.",
      "readingMinutes": 2
    },
