  "blocks": [
    {
      "id": "l201-t0",
      "type": "teaching",
      "title": "Chọn vở và bút",
      "text": "白色 chỉ màu trắng. 本子 là vở; khi đếm dùng 一本本子. 笔 ở đây là danh từ ‘bút’, dùng 一支笔. 支 (zhī) là lượng từ bổ sung SUPPLEMENTARY cho vật thon dài; chưa xác minh cấp trong syllabus, không tính vào 200 mục từ HSK2. 长 đọc cháng khi nói chiều dài. Không đổi thành zhǎng trong nghĩa này.",
      "hanzi": "这是白色的本子。这支笔很长。",
      "pinyin": "Zhè shì báisè de běnzi. Zhè zhī bǐ hěn cháng.",
      "meaning": "Đây là vở màu trắng. Cây bút này dài.",
      "readingMinutes": 3
    },
    {
      "id": "l201-t1",
      "type": "teaching",
      "title": "So sánh hai vật",
      "text": "Đặt vật A trước 比, vật B sau 比, rồi tính từ: A 比 B 长. Muốn nói A dài hơn B, không thêm 很 trước 长 trong mẫu này. Đảo A và B sẽ đảo ý so sánh. Chỉ dùng nghĩa dài của 长.",
      "hanzi": "这支笔比那支笔长。",
      "pinyin": "Zhè zhī bǐ bǐ nà zhī bǐ cháng.",
      "meaning": "Cây bút này dài hơn cây bút kia.",
      "readingMinutes": 3
    },
    {
      "id": "l201-t2",
      "type": "teaching",
      "title": "Đọc trong cửa hàng",
      "text": "Đọc câu hỏi để phân biệt chọn màu với so sánh chiều dài. Ở câu trả lời cuối, người mua chọn cây dài hơn, chưa có thông tin về giá. Không tự suy ra cây dài hơn đắt hơn.",
      "hanzi": "甲：你要什么颜色的本子？乙：我要白色的。甲：这支笔比那支笔长。乙：我要这支。",
      "pinyin": "Jiǎ: Nǐ yào shénme yánsè de běnzi? Yǐ: Wǒ yào báisè de. Jiǎ: Zhè zhī bǐ bǐ nà zhī bǐ cháng. Yǐ: Wǒ yào zhè zhī.",
      "meaning": "A: Bạn muốn vở màu gì? B: Tôi muốn màu trắng. A: Cây bút này dài hơn cây kia. B: Tôi muốn cây này.",
      "readingMinutes": 3
    },
