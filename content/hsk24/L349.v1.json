  "blocks": [
    {
      "id": "l349-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 却 què: nhưng/lại; 急得 jí de: lo đến mức; 断定 duàndìng: khẳng định chỉ dùng đối chiếu. Cảm xúc trong bài không là đánh giá tâm lý người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l349-t0",
      "type": "teaching",
      "title": "开心 · vui",
      "text": "开心 nói cảm thấy vui/hân hoan, không phải mở tim theo từng chữ. 很开心 là trạng thái, không nhất thiết mọi lúc đều vui.",
      "hanzi": "收到朋友的信，我很开心。",
      "pinyin": "Shōudào péngyou de xìn, wǒ hěn kāixīn.",
      "meaning": "Nhận thư bạn, tôi rất vui.",
      "readingMinutes": 1
    },
    {
      "id": "l349-t1",
      "type": "teaching",
      "title": "哭 · khóc",
      "text": "哭 là khóc; nhìn thấy khóc không đủ biết vui hay buồn nếu chưa có ngữ cảnh. 别哭 chỉ lời an ủi, không xóa cảm xúc.",
      "hanzi": "孩子找不到妈妈，哭了。",
      "pinyin": "Háizi zhǎo bu dào māma, kū le.",
      "meaning": "Đứa trẻ không tìm thấy mẹ nên khóc.",
      "readingMinutes": 1
    },
    {
      "id": "l349-t2",
      "type": "teaching",
      "title": "难过 · buồn/đau lòng",
      "text": "难过 là buồn hoặc cảm thấy khó chịu tùy ngữ cảnh; khác 难 là khó làm. 别难过 là lời an ủi.",
      "hanzi": "听到这个消息，她很难过。",
      "pinyin": "Tīngdào zhège xiāoxi, tā hěn nánguò.",
      "meaning": "Nghe tin này, cô ấy rất buồn.",
      "readingMinutes": 1
    },
    {
      "id": "l349-t3",
      "type": "teaching",
      "title": "生气 · giận/tức",
      "text": "生气 thường có thể tách trong 生我的气; 对…生气 nói giận về ai/việc. Không phải “sinh ra không khí”.",
      "hanzi": "他因为迟到的事生气了。",
      "pinyin": "Tā yīnwèi chídào de shì shēngqì le.",
      "meaning": "Anh ấy giận vì chuyện đến muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l349-t4",
      "type": "teaching",
      "title": "着急 · sốt ruột/lo cuống",
      "text": "着急 là lo và sốt ruột về việc gấp hoặc chưa rõ; 着 ở đây đọc zháo, khác trợ từ zhe.",
      "hanzi": "找不到票，她很着急。",
      "pinyin": "Zhǎo bu dào piào, tā hěn zháojí.",
      "meaning": "Không tìm thấy vé, cô ấy rất sốt ruột.",
      "readingMinutes": 1
    },
    {
      "id": "l349-t5",
      "type": "teaching",
      "title": "急 · gấp/vội; lo",
      "text": "急 trong 别急 là đừng vội/đừng sốt ruột; 这件事很急 là việc gấp. Đề giữ mục từ một chữ để tránh trùng 着急.",
      "hanzi": "别急，我们还有时间。",
      "pinyin": "Bié jí, wǒmen hái yǒu shíjiān.",
      "meaning": "Đừng vội, chúng ta còn thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l349-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "看起来难过 là có vẻ buồn theo quan sát, chưa chắc biết nguyên nhân. 极了 có thể tăng mức cảm xúc, nhưng không dùng để suy ra chẩn đoán.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l349-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林昨天收到信很开心，今天却看起来难过。朋友没有马上说他生气，只问发生了什么。小林说孩子找不到票，急得哭了，自己也着急。朋友说：别急，先一起找。",
      "pinyin": "Xiǎo Lín zuótiān shōudào xìn hěn kāixīn, jīntiān què kàn qǐlái nánguò. Péngyou méiyǒu mǎshàng shuō tā shēngqì, zhǐ wèn fāshēng le shénme. Xiǎo Lín shuō háizi zhǎo bu dào piào, jí de kū le, zìjǐ yě zháojí. Péngyou shuō: Bié jí, xiān yìqǐ zhǎo.",
      "meaning": "Hôm qua Lâm vui vì nhận thư, hôm nay có vẻ buồn. Bạn hỏi thay vì đoán cậu giận. Lâm kể trẻ không thấy vé, lo đến khóc; họ cùng tìm.",
      "readingMinutes": 2
    },
    {
