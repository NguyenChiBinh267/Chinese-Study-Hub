  "blocks": [
    {
      "id": "l4020-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t0",
      "type": "teaching",
      "title": "食品 · thực phẩm",
      "text": "食品 nói thực phẩm như loại sản phẩm, hay thấy ở nhãn hàng/bao bì; khác 食堂 là nơi ăn.",
      "hanzi": "请看清食品包装上的日期。",
      "pinyin": "Qǐng kàn qīng shí pǐn bāo zhuāng shàng de rì qī.",
      "meaning": "Hãy nhìn rõ ngày tháng trên bao bì thực phẩm.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t1",
      "type": "teaching",
      "title": "食堂 · nhà ăn; căng tin",
      "text": "食堂 là nơi phục vụ bữa ăn trong trường/cơ quan, không chỉ một món ăn.",
      "hanzi": "学校食堂今天有汤。",
      "pinyin": "Xué xiào shí táng jīn tiān yǒu tāng.",
      "meaning": "Nhà ăn trường hôm nay có canh.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t2",
      "type": "teaching",
      "title": "食物 · thức ăn",
      "text": "食物 nói đồ ăn nói chung; câu điền yêu cầu từ kết thúc bằng 物 để tách với 食品.",
      "hanzi": "桌上的食物不要浪费。",
      "pinyin": "Zhuō shàng de shí wù bú yào làng fèi.",
      "meaning": "Đừng lãng phí thức ăn trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t3",
      "type": "teaching",
      "title": "汤 · canh; súp",
      "text": "汤 là món nước/canh trong bữa ăn; không dùng thay mọi thức uống.",
      "hanzi": "我想要一碗汤。",
      "pinyin": "Wǒ xiǎng yào yì wǎn tāng.",
      "meaning": "Tôi muốn một bát canh.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t4",
      "type": "teaching",
      "title": "酸 · chua",
      "text": "酸 tả vị chua trong bài này; không phải chua xót hay axit hóa học. Nhận diện chữ 酸 trong 酸; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这个西红柿有点儿酸。",
      "pinyin": "Zhè ge xī hóng shì yǒu diǎnr suān.",
      "meaning": "Quả cà chua này hơi chua.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-t5",
      "type": "teaching",
      "title": "咸 · mặn",
      "text": "咸 nói vị mặn của món ăn; không đồng nghĩa với 辣 là cay.",
      "hanzi": "这碗汤太咸了。",
      "pinyin": "Zhè wǎn tāng tài xián le.",
      "meaning": "Bát canh này mặn quá.",
      "readingMinutes": 1
    },
    {
      "id": "l4020-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "咸是咸，不过… lặp tính từ để thừa nhận một điểm rồi nói ý ngược/giới hạn: mặn thì có mặn, nhưng tôi chỉ nếm một chút. Khác mẫu X是X，Y是Y phân biệt hai phạm trù.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4020-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校食堂让同学们谈谈食物的味道。小平说西红柿有点儿酸，小丽觉得汤有点儿咸。朋友问她喝了多少，她回答：“咸是咸，不过我只尝了一口。”工作人员记录意见，并提醒大家不要浪费食物，购买包装食品时看清日期。",
      "pinyin": "Xué xiào shí táng ràng tóng xué men tán tan shí wù de wèi dào. Xiǎo Píng shuō xī hóng shì yǒu diǎnr suān, Xiǎo Lì jué de tāng yǒu diǎnr xián. Péng you wèn tā hē le duō shao, tā huí dá: “Xián shì xián, bú guò wǒ zhǐ cháng le yì kǒu.” Gōng zuò rén yuán jì lù yì jiàn, bìng tí xǐng dà jiā bú yào làng fèi shí wù, gòu mǎi bāo zhuāng shí pǐn shí kàn qīng rì qī.",
      "meaning": "Học sinh góp ý vị chua, mặn; Tiểu Lệ chỉ nếm một ngụm canh. Nhân viên ghi ý kiến.",
      "readingMinutes": 2
    },
