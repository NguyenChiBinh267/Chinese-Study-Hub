  "blocks": [
    {
      "id": "l192-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder0",
      "type": "teaching",
      "title": "水果 · trái cây; hoa quả",
      "text": "Nhắc nghĩa đã học: trái cây; hoa quả. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我去超市买水果。",
      "pinyin": "Wǒ qù chāo shì mǎi shuǐ guǒ.",
      "meaning": "Tôi đến siêu thị mua trái cây.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder1",
      "type": "teaching",
      "title": "书店 · hiệu sách; nhà sách",
      "text": "Nhắc nghĩa đã học: hiệu sách; nhà sách. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的书店在学校前。",
      "pinyin": "Wǒ de shū diàn zài xué xiào qián.",
      "meaning": "Hiệu sách của tôi ở phía trước trường.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder2",
      "type": "teaching",
      "title": "买 · mua",
      "text": "Nhắc nghĩa đã học: mua. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我明天买衣服。",
      "pinyin": "Wǒ míng tiān mǎi yī fu.",
      "meaning": "Ngày mai tôi mua quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder3",
      "type": "teaching",
      "title": "钱 · tiền",
      "text": "Nhắc nghĩa đã học: tiền. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我有十块钱。",
      "pinyin": "Wǒ yǒu shí kuài qián.",
      "meaning": "Tôi có10đồng trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder4",
      "type": "teaching",
      "title": "元 · đồng/nguyên (đơn vị yuán trong ví dụ)",
      "text": "Nhắc nghĩa đã học: đồng/nguyên (đơn vị yuán trong ví dụ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "这个杯子三元。",
      "pinyin": "Zhè ge bēi zi sān yuán.",
      "meaning": "Chiếc cốc này3nguyên trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reminder5",
      "type": "teaching",
      "title": "杯子 · cốc; ly (vật chứa)",
      "text": "Nhắc nghĩa đã học: cốc; ly (vật chứa). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我不买那个杯子。",
      "pinyin": "Wǒ bù mǎi nà ge bēi zi.",
      "meaning": "Tôi không mua chiếc cốc kia.",
      "readingMinutes": 1
    },
    {
      "id": "l192-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你去哪儿？\nB：我去超市买水果。\nA：这个杯子多少钱？\nB：三元。我不买杯子，我买苹果。",
      "pinyin": "A: Nǐ qù nǎr? B: Wǒ qù chāo shì mǎi shuǐ guǒ. A: Zhè ge bēi zi duō shao qián? B: Sān yuán. Wǒ bù mǎi bēi zi, wǒ mǎi píng guǒ.",
      "meaning": "B đến siêu thị mua trái cây, chọn táo và không mua cốc. Giá3nguyên là dữ kiện hư cấu trong bài, không phải giá thật hoặc giao dịch.",
      "readingMinutes": 2
    },
