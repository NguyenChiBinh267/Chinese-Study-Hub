  "blocks": [
    {
      "id": "l239-prereq",
      "type": "teaching",
      "title": "Kiến thức hỗ trợ",
      "text": "Nhắc 我/你/他, 是/有/在, số và câu hỏi cơ bản; HSK1 chưa hoàn chỉnh. Từ hỗ trợ trong ngữ cảnh được giải thích tại mỗi mục; không cộng từ mới hay cấp mastery.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l239-reminder0",
      "type": "teaching",
      "title": "Nhắc từ đã học · 教室",
      "text": "教室 đọc jiàoshì; chữ 教 trong từ này đọc jiào, khác động từ 教 jiāo ở dưới.",
      "hanzi": "学生都在教室里。",
      "pinyin": "Xuésheng dōu zài jiàoshì li.",
      "meaning": "Các học sinh đều ở trong phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l239-reminder1",
      "type": "teaching",
      "title": "Nhắc từ đã học · 考试",
      "text": "考试 có thể là việc thi hoặc một kỳ thi; 明天有考试 nói ngày mai có bài kiểm tra. Không suy ra đây là kỳ HSK chính thức.",
      "hanzi": "我们明天有考试。",
      "pinyin": "Wǒmen míngtiān yǒu kǎoshì.",
      "meaning": "Ngày mai chúng tôi có bài kiểm tra.",
      "readingMinutes": 1
    },
    {
      "id": "l239-reminder2",
      "type": "teaching",
      "title": "Nhắc từ đã học · 运动",
      "text": "有时 đặt trước hoạt động để nói chỉ xảy ra vào một số lúc; không đồng nghĩa luôn luôn.",
      "hanzi": "我有时在家运动。",
      "pinyin": "Wǒ yǒushí zài jiā yùndòng.",
      "meaning": "Đôi lúc tôi vận động ở nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l239-reminder3",
      "type": "teaching",
      "title": "Nhắc từ đã học · 游泳",
      "text": "游泳 chỉ bơi, không phải đi du lịch. 游泳 và 旅游 đều có 游 nhưng nghĩa toàn từ khác.",
      "hanzi": "星期天我们去游泳。",
      "pinyin": "Xīngqītiān wǒmen qù yóuyǒng.",
      "meaning": "Chủ nhật chúng tôi đi bơi.",
      "readingMinutes": 1
    },
    {
      "id": "l239-grammar0",
      "type": "teaching",
      "title": "Cách nói 1",
      "text": "请小王告诉大家 đặt người được nhờ trước hành động; 小王 vừa là đối tượng của 请 vừa là người thực hiện 告诉. Đây là cấu trúc kiêm ngữ trong ngữ cảnh yêu cầu.",
      "hanzi": "请小王告诉大家。",
      "pinyin": "Qǐng Xiǎo Wáng gàosu dàjiā.",
      "meaning": "Nhờ Vương báo mọi người.",
      "readingMinutes": 1
    },
    {
      "id": "l239-grammar1",
      "type": "teaching",
      "title": "Cách nói 2",
      "text": "游半个小时 nói thời gian bơi; không phải số lần bơi. 半个小时 là nửa giờ, không phải nửa lần.",
      "hanzi": "他游了半个小时。",
      "pinyin": "Tā yóu le bàn ge xiǎoshí.",
      "meaning": "Bạn ấy đã bơi nửa giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l239-grammar2",
      "type": "teaching",
      "title": "Cách nói 3",
      "text": "一号教室 là phòng học số 1: số + 号 dùng làm nhãn thứ tự/đánh số, không dùng 第. Một phòng học theo số lượng là 一间教室. 第二节课 trong đoạn chỉ nhắc lại mẫu có 第 đã thuộc nền HSK1, không dùng để chứng minh dòng HSK2 này.",
      "hanzi": "我们在一号教室上课。",
      "pinyin": "Wǒmen zài yī hào jiàoshì shàng kè.",
      "meaning": "Chúng tôi học ở phòng số 1.",
      "readingMinutes": 1
    },
    {
      "id": "l239-grammar3",
      "type": "teaching",
      "title": "Cách nói 4",
      "text": "两次 trong 每周游泳两次 nêu số lượt, không nêu tổng thời lượng. Cần phân biệt với 每次游半个小时.",
      "hanzi": "他每周游泳两次。",
      "pinyin": "Tā měi zhōu yóuyǒng liǎng cì.",
      "meaning": "Bạn ấy bơi hai lần mỗi tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l239-scene",
      "type": "teaching",
      "title": "Tình huống mới",
      "text": "Đọc thông báo học và hoạt động; phân biệt số lần, thời lượng và thứ tự.",
      "hanzi": "老师说：请小王告诉大家，第二节课在一号教室上。考试以后，我们去运动。小王每周游泳两次，每次游半个小时。今天他想请老师教他游泳，但老师说要先做准备。",
      "pinyin": "Lǎoshī shuō: Qǐng Xiǎo Wáng gàosu dàjiā, dì èr jié kè zài yī hào jiàoshì shàng. Kǎoshì yǐhòu, wǒmen qù yùndòng. Xiǎo Wáng měi zhōu yóuyǒng liǎng cì, měi cì yóu bàn ge xiǎoshí. Jīntiān tā xiǎng qǐng lǎoshī jiāo tā yóuyǒng, dàn lǎoshī shuō yào xiān zuò zhǔnbèi.",
      "meaning": "Thầy nhờ Vương báo mọi người tiết thứ hai học tại phòng số 1. Sau kỳ kiểm tra, cả lớp vận động. Vương bơi hai lần mỗi tuần, mỗi lần nửa giờ. Hôm nay bạn muốn nhờ thầy dạy bơi, nhưng thầy nói phải chuẩn bị trước.",
      "readingMinutes": 2
    },
    {
