  "blocks": [
    {
      "id": "l4003-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t0",
      "type": "teaching",
      "title": "签证 · thị thực; visa",
      "text": "签证 là giấy phép nhập cảnh theo ngữ cảnh; bài không đưa quy định xin visa của nước nào.",
      "hanzi": "她来取签证。",
      "pinyin": "Tā lái qǔ qiān zhèng.",
      "meaning": "Cô ấy đến nhận visa.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t1",
      "type": "teaching",
      "title": "前方 · phía trước",
      "text": "前方 chỉ vị trí phía trước người đang đi; không chỉ thời gian trước đây.",
      "hanzi": "前方有一座桥。",
      "pinyin": "Qián fāng yǒu yí zuò qiáo.",
      "meaning": "Phía trước có một cây cầu.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t2",
      "type": "teaching",
      "title": "前后 · trước và sau",
      "text": "前后 ở đây nói hai phía trước/sau của tòa nhà; có thể chỉ xấp xỉ thời gian trong ngữ cảnh khác.",
      "hanzi": "楼的前后都有树。",
      "pinyin": "Lóu de qián hòu dōu yǒu shù.",
      "meaning": "Trước và sau tòa nhà đều có cây.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t3",
      "type": "teaching",
      "title": "桥 · cầu",
      "text": "桥 nối hai bờ, dùng lượng từ 座; không phải 桥牌. Nhận diện chữ 桥 trong 桥; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "过桥以后向右走。",
      "pinyin": "Guò qiáo yǐ hòu xiàng yòu zǒu.",
      "meaning": "Qua cầu rồi đi sang phải.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t4",
      "type": "teaching",
      "title": "区 · khu; quận",
      "text": "区 chỉ khu vực hành chính trong 城区; không nhầm với động từ 去.",
      "hanzi": "办事处在这个区。",
      "pinyin": "Bàn shì chù zài zhè ge qū.",
      "meaning": "Văn phòng làm việc nằm trong khu này.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-t5",
      "type": "teaching",
      "title": "取 · lấy; nhận",
      "text": "取 thường dùng khi nhận đồ/giấy tờ đã để sẵn, như 取票、取签证.",
      "hanzi": "请明天下午来取。",
      "pinyin": "Qǐng míng tiān xià wǔ lái qǔ.",
      "meaning": "Xin chiều mai đến nhận.",
      "readingMinutes": 1
    },
    {
      "id": "l4003-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động từ + 得了/不了 (liǎo) biểu thị có/không thể thực hiện hoặc hoàn tất: 办不了. Phân biệt với trợ từ 了 (le). Tình huống giấy tờ hư cấu, không mô tả thủ tục thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4003-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小周问：“这个区的办事处怎么走？”路人说：“前方过桥以后向右走，楼的前后都有树。”到了办事处，工作人员说：“你的材料还不齐，今天办不了签证。这是故事里的安排，请先带走清单，明天下午再来取补充表格。”",
      "pinyin": "Xiǎo Zhōu wèn: “Zhè ge qū de bàn shì chù zěn me zǒu?” Lù rén shuō: “Qián fāng guò qiáo yǐ hòu xiàng yòu zǒu, lóu de qián hòu dōu yǒu shù.” Dào le bàn shì chù, gōng zuò rén yuán shuō: “Nǐ de cái liào hái bù qí, jīn tiān bàn bu liǎo qiān zhèng. Zhè shì gù shi lǐ de ān pái, qǐng xiān dài zǒu qīng dān, míng tiān xià wǔ zài lái qǔ bǔ chōng biǎo gé.”",
      "meaning": "Tiểu Chu qua cầu đến văn phòng. Trong tình huống hư cấu này, hồ sơ thiếu nên hôm nay chưa làm được visa; chiều mai đến lấy biểu mẫu bổ sung.",
      "readingMinutes": 2
    },
    {
