  "blocks": [
    {
      "id": "l391-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder0",
      "type": "teaching",
      "title": "简单 · đơn giản",
      "text": "简单 mô tả ít phức tạp; không nhất thiết đồng nghĩa không cần luyện. 对我来说很简单 là đơn giản đối với tôi.",
      "hanzi": "这个句子很简单。",
      "pinyin": "Zhège jùzi hěn jiǎndān.",
      "meaning": "Câu này rất đơn giản.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder1",
      "type": "teaching",
      "title": "懂得 · hiểu/biết rõ",
      "text": "懂得 thường chỉ hiểu điều, đạo lý hoặc cách làm. Trong 懂得这个方法 là hiểu phương pháp; khác chỉ nhớ mặt chữ.",
      "hanzi": "现在我懂得这个方法了。",
      "pinyin": "Xiànzài wǒ dǒngde zhège fāngfǎ le.",
      "meaning": "Giờ tôi đã hiểu phương pháp này.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder2",
      "type": "teaching",
      "title": "成绩 · kết quả/thành tích học tập",
      "text": "成绩 nói kết quả học hoặc công việc theo ngữ cảnh. 成绩不错 không đưa ra số điểm cụ thể, cũng không chứng minh nguyên nhân kết quả.",
      "hanzi": "这次考试的成绩不错。",
      "pinyin": "Zhè cì kǎoshì de chéngjì búcuò.",
      "meaning": "Kết quả kiểm tra lần này khá tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder3",
      "type": "teaching",
      "title": "得分 · ghi/đạt điểm",
      "text": "得分 là đạt điểm theo cách chấm của hoạt động. 得 đọc dé ở đây, không phải děi nghĩa phải.",
      "hanzi": "他在比赛中得分了。",
      "pinyin": "Tā zài bǐsài zhōng défēn le.",
      "meaning": "Bạn ấy ghi được điểm trong cuộc thi.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder4",
      "type": "teaching",
      "title": "比赛 · cuộc thi/thi đấu",
      "text": "比赛 có thể là danh từ cuộc thi hoặc động từ thi đấu. 本次比赛 là cuộc thi này; bài không mô phỏng đề HSK chính thức.",
      "hanzi": "我们想参加中文比赛。",
      "pinyin": "Wǒmen xiǎng cānjiā Zhōngwén bǐsài.",
      "meaning": "Chúng tôi muốn tham gia cuộc thi tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder5",
      "type": "teaching",
      "title": "聪明 · thông minh",
      "text": "聪明 nhận xét khả năng hiểu nhanh; không đồng nghĩa mọi việc đều làm tốt hay không cần luyện. Không suy ra phẩm chất từ một điểm số.",
      "hanzi": "这个孩子很聪明，也很爱学习。",
      "pinyin": "Zhège háizi hěn cōngmíng, yě hěn ài xuéxí.",
      "meaning": "Đứa trẻ này thông minh và cũng thích học.",
      "readingMinutes": 1
    },
    {
      "id": "l391-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "先 đặt trước việc thứ nhất, 再/然后 nối bước kế tiếp. Ví dụ 先复习课文，再练习写句子. 再 ở đây là làm bước sau, không dùng để kể một lần lặp đã xảy ra như 又.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l391-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我记了很多新词，还是不会写句子。老师：先复习课文，再练习写简单的句子。小安：只记词不够吗？老师：也要懂得词在句子里怎样用。小安：我明白了，这个方法我想试试。",
      "pinyin": "Xiǎo Ān: Wǒ jì le hěn duō xīn cí, háishi bú huì xiě jùzi. Lǎoshī: Xiān fùxí kèwén, zài liànxí xiě jiǎndān de jùzi. Xiǎo Ān: Zhǐ jì cí bú gòu ma? Lǎoshī: Yě yào dǒngde cí zài jùzi lǐ zěnyàng yòng. Xiǎo Ān: Wǒ míngbai le, zhège fāngfǎ wǒ xiǎng shìshi.",
      "meaning": "An đã ghi nhiều từ nhưng chưa viết được câu. Thầy khuyên ôn bài rồi luyện câu đơn giản, hiểu cách dùng từ trong câu. An muốn thử phương pháp đó.",
      "readingMinutes": 2
    },
