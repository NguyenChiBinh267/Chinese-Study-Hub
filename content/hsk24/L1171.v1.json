  "blocks": [
    {
      "id": "l1171-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder0",
      "type": "teaching",
      "title": "时候 · lúc; khi (dạng shíhou)",
      "text": "Từ đã học 时候 có 2 chữ. Chữ 候 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 候 với 侯 / 修 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "你什么时候上课？",
      "pinyin": "Nǐ shén me shí hou shàng kè?",
      "meaning": "Bạn lên lớp khi nào?",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder1",
      "type": "teaching",
      "title": "晚 · muộn; trễ",
      "text": "Từ đã học 晚 có 1 chữ. Chữ 晚 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 晚 với 免 / 挽 / 兔; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我晚上回家。",
      "pinyin": "Wǒ wǎn shang huí jiā.",
      "meaning": "Tôi về nhà buổi tối.",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder2",
      "type": "teaching",
      "title": "了 · rồi; trợ từ le",
      "text": "Từ đã học 了 có 1 chữ. Chữ 了 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 了 với 子 / 予 / 孑; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我起床了。",
      "pinyin": "Wǒ qǐ chuáng le.",
      "meaning": "Tôi dậy rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder3",
      "type": "teaching",
      "title": "睡 · ngủ (dạng một chữ)",
      "text": "Từ đã học 睡 có 1 chữ. Chữ 睡 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 睡 với 垂 / 眠 / 眼; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我想睡。",
      "pinyin": "Wǒ xiǎng shuì.",
      "meaning": "Tôi muốn ngủ.",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder4",
      "type": "teaching",
      "title": "分 · phút (mục fēn)",
      "text": "Từ đã học 分 có 1 chữ. Chữ 分 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 分 với 公 / 六 / 八; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "现在三点十分。",
      "pinyin": "Xiàn zài sān diǎn shí fēn.",
      "meaning": "Bây giờ3giờ10phút trong truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reminder5",
      "type": "teaching",
      "title": "分钟 · phút (khoảng thời gian, dạng fēnzhōng)",
      "text": "Từ đã học 分钟 có 2 chữ. Chữ 钟 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 钟 với 种 / 冲 / 仲; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我休息五分钟。",
      "pinyin": "Wǒ xiū xi wǔ fēn zhōng.",
      "meaning": "Tôi nghỉ năm phút.",
      "readingMinutes": 1
    },
    {
      "id": "l1171-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你买哪个杯子？\nB：我买白色的。\nA：这个白色的怎么样？\nB：很好。",
      "pinyin": "A: Nǐ mǎi nǎ ge bēi zi? B: Wǒ mǎi bái sè de. A: Zhè ge bái sè de zěn me yàng? B: Hěn hǎo.",
      "meaning": "B chọn cốc màu trắng. 白色 bái sè = màu trắng, từ hỗ trợ ở đây, không cộng thêm ordinal HSK1 mới.",
      "readingMinutes": 2
    },
