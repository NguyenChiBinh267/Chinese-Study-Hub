  "blocks": [
    {
      "id": "l325-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 位 wèi: lượng từ lịch sự cho người; 米 mǐ: mét; 看起来 kàn qǐlái: trông có vẻ; 差不多 chàbuduō: gần như, không phải chính xác bằng nhau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l325-t0",
      "type": "teaching",
      "title": "矮 · thấp (chiều cao)",
      "text": "矮 nói chiều cao thấp, khác 小 chỉ nhỏ/ít tuổi tùy ngữ cảnh. Cần mốc so sánh khi so người.",
      "hanzi": "我比哥哥矮一点儿。",
      "pinyin": "Wǒ bǐ gēge ǎi yìdiǎnr.",
      "meaning": "Tôi thấp hơn anh một chút.",
      "readingMinutes": 1
    },
    {
      "id": "l325-t1",
      "type": "teaching",
      "title": "身高 · chiều cao cơ thể",
      "text": "身高 là số đo chiều cao, không phải chiều dài mọi vật. Hỏi 身高多少 không tự đánh giá cao/thấp tốt/xấu.",
      "hanzi": "他的身高是一米七。",
      "pinyin": "Tā de shēngāo shì yì mǐ qī.",
      "meaning": "Chiều cao anh ấy là một mét bảy.",
      "readingMinutes": 1
    },
    {
      "id": "l325-t2",
      "type": "teaching",
      "title": "胖 · béo/mập",
      "text": "胖 mô tả vóc dáng; trong giao tiếp tránh áp đặt nhận xét không được hỏi. Bài không cho lời khuyên giảm cân.",
      "hanzi": "照片里的我比现在胖。",
      "pinyin": "Zhàopiàn lǐ de wǒ bǐ xiànzài pàng.",
      "meaning": "Tôi trong ảnh mập hơn hiện nay.",
      "readingMinutes": 1
    },
    {
      "id": "l325-t3",
      "type": "teaching",
      "title": "瘦 · gầy",
      "text": "瘦 là gầy, không đồng nghĩa chắc chắn khỏe hoặc thiếu ăn. 不胖 chưa nhất thiết là 瘦.",
      "hanzi": "他看起来很瘦。",
      "pinyin": "Tā kàn qǐlái hěn shòu.",
      "meaning": "Trông anh ấy gầy.",
      "readingMinutes": 1
    },
    {
      "id": "l325-t4",
      "type": "teaching",
      "title": "年轻 · trẻ tuổi",
      "text": "年轻 nói tuổi còn trẻ tương đối, không thay cho 新 trong “đồ mới”. 看起来年轻 chỉ ấn tượng nhìn.",
      "hanzi": "这位老师很年轻。",
      "pinyin": "Zhè wèi lǎoshī hěn niánqīng.",
      "meaning": "Thầy/cô này còn trẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l325-t5",
      "type": "teaching",
      "title": "老 · già/lớn tuổi; cũ tùy ngữ cảnh",
      "text": "老 ở bài dùng đối chiếu tuổi với 年轻. 老朋友 là bạn lâu năm, không tự là bạn già; chưa dạy mọi nghĩa của 老.",
      "hanzi": "爷爷说自己老了。",
      "pinyin": "Yéye shuō zìjǐ lǎo le.",
      "meaning": "Ông nói mình đã già.",
      "readingMinutes": 1
    },
    {
      "id": "l325-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "A比B更高 nhấn mạnh A cao hơn B; 矮 là thấp về chiều cao, không dùng cho tuổi. 胖/瘦 ở đây chỉ mô tả nhân vật tự nói, không kết luận sức khỏe hay giá trị con người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l325-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：照片里谁是你？小王：左边的。我那时年轻，也比现在胖一点儿。小林：身高呢？小王：那时比哥哥矮，现在跟他差不多。不能只看胖瘦就说一个人健康不健康。",
      "pinyin": "Xiǎo Lín: Zhàopiàn lǐ shéi shì nǐ? Xiǎo Wáng: Zuǒbian de. Wǒ nà shí niánqīng, yě bǐ xiànzài pàng yìdiǎnr. Xiǎo Lín: Shēngāo ne? Xiǎo Wáng: Nà shí bǐ gēge ǎi, xiànzài gēn tā chàbuduō. Bù néng zhǐ kàn pàng shòu jiù shuō yí ge rén jiànkāng bu jiànkāng.",
      "meaning": "Vương tự so ảnh cũ: trẻ hơn và mập hơn hiện nay, khi ấy thấp hơn anh, hiện cao gần bằng. Không thể chỉ dựa vóc dáng để kết luận sức khỏe.",
      "readingMinutes": 2
    },
    {
