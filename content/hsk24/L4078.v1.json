  "blocks": [
    {
      "id": "l4078-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t0",
      "type": "teaching",
      "title": "硕士 · thạc sĩ",
      "text": "硕士 là bậc/bằng học vị trong ngữ cảnh, không đại diện mọi người học cao. Nhận diện chữ 硕 trong 硕士; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她正在读硕士。",
      "pinyin": "Tā zhèng zài dú shuò shì.",
      "meaning": "Cô ấy đang học thạc sĩ.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t1",
      "type": "teaching",
      "title": "正常 · bình thường",
      "text": "正常 ở đây nói sinh hoạt theo nhịp thường lệ.",
      "hanzi": "开学后，生活恢复正常。",
      "pinyin": "Kāi xué hòu, shēng huó huī fù zhèng cháng.",
      "meaning": "Khai giảng rồi sinh hoạt trở lại bình thường.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t2",
      "type": "teaching",
      "title": "正好 · vừa đúng; vừa hay",
      "text": "正好 nói sự trùng khớp thời gian/điều kiện trong tình huống.",
      "hanzi": "周末我正好有空。",
      "pinyin": "Zhōu mò wǒ zhèng hǎo yǒu kòng.",
      "meaning": "Cuối tuần tôi vừa hay rảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t3",
      "type": "teaching",
      "title": "自然 · đương nhiên; tự nhiên",
      "text": "自然 trong 自然要考虑 diễn đạt điều nhân vật cho là cần; mục nguồn còn có nghĩa tự nhiên/thiên nhiên.",
      "hanzi": "选择课程，自然要考虑时间。",
      "pinyin": "Xuǎn zé kè chéng, zì rán yào kǎo lǜ shí jiān.",
      "meaning": "Chọn khóa học đương nhiên cần xét thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t4",
      "type": "teaching",
      "title": "作为 · với tư cách; làm",
      "text": "作为1 mở vai trò của chủ thể, không phải mọi nghĩa danh từ 作风.",
      "hanzi": "作为学生，我还要继续学习。",
      "pinyin": "Zuò wéi xué sheng, wǒ hái yào jì xù xué xí.",
      "meaning": "Là sinh viên tôi vẫn cần học tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-t5",
      "type": "teaching",
      "title": "最终 · cuối cùng; sau cùng",
      "text": "最终 nêu kết quả cuối quá trình đang kể, không có nghĩa vĩnh viễn không thay đổi.",
      "hanzi": "她最终选择了周末课程。",
      "pinyin": "Tā zuì zhōng xuǎn zé le zhōu mò kè chéng.",
      "meaning": "Cuối cùng cô ấy chọn khóa cuối tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l4078-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 đặt giới hạn cho kỳ vọng. 自然 trong câu này nghĩa đương nhiên, là lời nhấn của nhân vật; không phải quy luật rằng một bằng cấp bảo đảm kết quả.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4078-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安正在读硕士，开学后生活恢复正常。作为学生，她自然要考虑学习时间，周末正好有空。她最终选择周末课程，不过不认为读了一个学位就会解决所有问题，还要继续练习和请教。",
      "pinyin": "Xiǎo Ān zhèng zài dú shuò shì, kāi xué hòu shēng huó huī fù zhèng cháng. Zuò wéi xué sheng, tā zì rán yào kǎo lǜ xué xí shí jiān, zhōu mò zhèng hǎo yǒu kòng. Tā zuì zhōng xuǎn zé zhōu mò kè chéng, bú guò bù rèn wéi dú le yí ge xué wèi jiù huì jiě jué suǒ yǒu wèn tí, hái yào jì xù liàn xí hé qǐng jiào.",
      "meaning": "Tiểu An chọn khóa theo lịch rảnh, không coi bằng cấp là bảo đảm giải quyết mọi vấn đề.",
      "readingMinutes": 2
    },
    {
