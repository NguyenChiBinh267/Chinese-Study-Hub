  "blocks": [
    {
      "id": "l382-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 对方 duìfāng: phía/người kia; 认定 rèndìng: khẳng định/cho chắc; 钥匙 yàoshi: chìa khóa chỉ ví dụ nghĩa; 丢 diū: mất.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l382-t0",
      "type": "teaching",
      "title": "旧 · cũ",
      "text": "旧 nói đã dùng/cũ, khác 老 về tuổi người hoặc quan hệ lâu năm. 旧书未必无用，也未必很久以前出版.",
      "hanzi": "这本旧书是爷爷的。",
      "pinyin": "Zhè běn jiù shū shì yéye de.",
      "meaning": "Sách cũ này là của ông.",
      "readingMinutes": 1
    },
    {
      "id": "l382-t1",
      "type": "teaching",
      "title": "认得 · nhận ra/biết mặt",
      "text": "认得 nói nhận ra/biết mặt, 不认得不等于从未见过; 认得他 chưa biết tên. 得 ở đây đọc nhẹ de, không phải dé/děi.",
      "hanzi": "我认得他，可不知道名字。",
      "pinyin": "Wǒ rènde tā, kě bù zhīdào míngzi.",
      "meaning": "Tôi nhận ra anh ấy nhưng không biết tên.",
      "readingMinutes": 1
    },
    {
      "id": "l382-t2",
      "type": "teaching",
      "title": "遇见 · gặp tình cờ/gặp",
      "text": "遇见 thường gặp người/đối tượng trong cảnh, có thể gần 遇到 khi nói gặp người. Bài không dùng hai từ làm lựa chọn loại trừ nếu cùng đúng.",
      "hanzi": "我在图书馆遇见了老同学。",
      "pinyin": "Wǒ zài túshūguǎn yùjiàn le lǎo tóngxué.",
      "meaning": "Tôi gặp bạn học cũ ở thư viện.",
      "readingMinutes": 1
    },
    {
      "id": "l382-t3",
      "type": "teaching",
      "title": "只是 · chỉ là/chỉ có điều",
      "text": "只是 có thể giới hạn hoặc chuyển nhẹ: 想去，只是没空. 不必将它解释成每次都“là” sau 只.",
      "hanzi": "我想帮忙，只是现在没时间。",
      "pinyin": "Wǒ xiǎng bāng máng, zhǐshì xiànzài méi shíjiān.",
      "meaning": "Tôi muốn giúp, chỉ có điều giờ không có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l382-t4",
      "type": "teaching",
      "title": "怎么办 · làm sao bây giờ/xử lý thế nào",
      "text": "怎么办 hỏi cách giải quyết trước vấn đề, không phải tên một hành động. 钥匙丢了怎么办 không tự có đáp án duy nhất ngoài bài.",
      "hanzi": "找不到旧书，怎么办？",
      "pinyin": "Zhǎo bu dào jiù shū, zěnme bàn?",
      "meaning": "Không tìm thấy sách cũ, phải làm sao?",
      "readingMinutes": 1
    },
    {
      "id": "l382-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "只是 trong 我认得他，只是不知道名字 đưa giới hạn/điều bổ sung trái kỳ vọng. Không phủ định việc nhận ra; 怎么办 hỏi nên xử lý ra sao, khác 怎么做 tập trung cách làm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l382-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林找不到爷爷的旧书，问怎么办。他在图书馆遇见老同学，认得对方，只是不记得名字。两人先核对借书记录，没有因为认得对方就认定书在对方那里。",
      "pinyin": "Xiǎo Lín zhǎo bu dào yéye de jiù shū, wèn zěnme bàn. Tā zài túshūguǎn yùjiàn lǎo tóngxué, rènde duìfāng, zhǐshì bú jìde míngzi. Liǎng rén xiān héduì jiè shū jìlù, méiyǒu yīnwèi rènde duìfāng jiù rèndìng shū zài duìfāng nàli.",
      "meaning": "Lâm không thấy sách cũ của ông, gặp bạn học cũ ở thư viện nhưng không nhớ tên. Họ tra lượt mượn, không kết luận người quen đang giữ sách chỉ vì nhận ra nhau.",
      "readingMinutes": 2
    },
    {
