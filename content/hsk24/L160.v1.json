  "blocks": [
    {
      "id": "l160-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l160-t0",
      "type": "teaching",
      "title": "衣服 · quần áo",
      "text": "衣服 gọi quần áo; 一件衣服 chỉ một món trong ví dụ, không phải toàn bộ tủ đồ.",
      "hanzi": "我买衣服。",
      "pinyin": "Wǒ mǎi yī fu.",
      "meaning": "Tôi mua quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l160-t1",
      "type": "teaching",
      "title": "穿 · mặc; mang trên người",
      "text": "穿 trong 穿衣服 nói mặc quần áo; không thay bằng 吃/喝 trong mẫu này.",
      "hanzi": "我穿衣服。",
      "pinyin": "Wǒ chuān yī fu.",
      "meaning": "Tôi mặc quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l160-t2",
      "type": "teaching",
      "title": "件 · chiếc; món (lượng từ quần áo)",
      "text": "件 trong 一件衣服 là lượng từ đếm; không dịch thành một việc ở câu này.",
      "hanzi": "我有一件衣服。",
      "pinyin": "Wǒ yǒu yí jiàn yī fu.",
      "meaning": "Tôi có một món quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l160-t3",
      "type": "teaching",
      "title": "杯子 · cốc; ly (vật chứa)",
      "text": "杯子 là chiếc cốc, không tự chỉ một lượng nước; 一杯水 là một cụm lượng khác.",
      "hanzi": "我的杯子在桌子上。",
      "pinyin": "Wǒ de bēi zi zài zhuō zi shang.",
      "meaning": "Cốc của tôi ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l160-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "件 đếm một món quần áo trong 一件衣服. 杯 có thể là lượng từ mượn từ vật chứa: 一杯水 là một cốc nước; 杯子 là tên vật chiếc cốc. Đừng đồng nhất vật chứa với lượng nước hoặc coi mọi danh từ đều dùng 个.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l160-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你买什么？\nB：我买一件衣服。\nA：这个杯子是你的吗？\nB：是，我想喝一杯水。",
      "pinyin": "A: Nǐ mǎi shén me? B: Wǒ mǎi yí jiàn yī fu. A: Zhè ge bēi zi shì nǐ de ma? B: Shì, wǒ xiǎng hē yì bēi shuǐ.",
      "meaning": "B mua một món quần áo và nói chiếc cốc là của mình; B muốn một cốc nước. Đề không tự chấm việc viết tay hoặc lượng nước thực.",
      "readingMinutes": 2
    },
