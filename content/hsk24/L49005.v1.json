  "blocks": [
    {
      "id": "l49005-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder0",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder1",
      "type": "teaching",
      "title": "点名 · điểm danh",
      "text": "点名 là gọi tên để kiểm tra có mặt.",
      "hanzi": "老师上课前先点名。",
      "pinyin": "Lǎo shī shàng kè qián xiān diǎn míng.",
      "meaning": "Thầy cô điểm danh trước tiết học.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder2",
      "type": "teaching",
      "title": "师生 · thầy và trò",
      "text": "师生 gộp giáo viên và học sinh, không chỉ giáo viên.",
      "hanzi": "师生一起参加活动。",
      "pinyin": "Shī shēng yì qǐ cān jiā huó dòng.",
      "meaning": "Thầy trò cùng tham gia hoạt động.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder3",
      "type": "teaching",
      "title": "试题 · đề thi; câu hỏi thi",
      "text": "试题 là nội dung câu hỏi, khác kết quả thi.",
      "hanzi": "请先读清楚试题。",
      "pinyin": "Qǐng xiān dú qīng chu shì tí.",
      "meaning": "Hãy đọc rõ đề thi trước.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder4",
      "type": "teaching",
      "title": "暑假 · nghỉ hè",
      "text": "暑假 là kỳ nghỉ mùa hè, khác mọi ngày nghỉ. Nhận diện chữ 暑 trong 暑假; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "暑假我想回家。",
      "pinyin": "Shǔ jià wǒ xiǎng huí jiā.",
      "meaning": "Nghỉ hè tôi muốn về nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder5",
      "type": "teaching",
      "title": "时间表 · thời gian biểu",
      "text": "时间表 liệt kê việc gắn với thời điểm.",
      "hanzi": "学校发了新的时间表。",
      "pinyin": "Xué xiào fā le xīn de shí jiān biǎo.",
      "meaning": "Trường phát thời gian biểu mới.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder6",
      "type": "teaching",
      "title": "条件 · điều kiện",
      "text": "条件 chỉ yêu cầu hoặc hoàn cảnh cần có.",
      "hanzi": "报名条件写在表上。",
      "pinyin": "Bào míng tiáo jiàn xiě zài biǎo shàng.",
      "meaning": "Điều kiện đăng ký ghi trên bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l49005-reminder7",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 nêu điều đã biết/được chấp nhận, 就 dẫn kết luận hoặc đề nghị. Khác 如果 đặt điều kiện chưa chắc xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l49005-reminder8",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校发了时间表，师生一起讨论暑假活动。老师点名后介绍报名条件，再发练习试题。小林说：“既然时间已经确定，我们就早点儿准备。”",
      "pinyin": "Xué xiào fā le shí jiān biǎo, shī shēng yì qǐ tǎo lùn shǔ jià huó dòng. Lǎo shī diǎn míng hòu jiè shào bào míng tiáo jiàn, zài fā liàn xí shì tí. Xiǎo Lín shuō: “Jì rán shí jiān yǐ jīng què dìng, wǒ men jiù zǎo diǎnr zhǔn bèi.”",
      "meaning": "Thầy trò bàn hoạt động hè sau khi đã xác định thời gian.",
      "readingMinutes": 2
    },
    {
