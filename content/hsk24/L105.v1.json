  "blocks": [
    {
      "id": "l105-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l105-t0",
      "type": "teaching",
      "title": "这 · này; đây (dạng một chữ)",
      "text": "这 là dạng một chữ chỉ phía gần/người nói; 这个 là tổ hợp dài hơn.",
      "hanzi": "这是茶。",
      "pinyin": "Zhè shì chá.",
      "meaning": "Đây là trà.",
      "readingMinutes": 1
    },
    {
      "id": "l105-t1",
      "type": "teaching",
      "title": "那 · kia; đó (dạng một chữ)",
      "text": "那 là dạng một chữ chỉ đối tượng phía kia trong ngữ cảnh, không chỉ mọi việc xa về thời gian.",
      "hanzi": "那是茶吗？",
      "pinyin": "Nà shì chá ma?",
      "meaning": "Kia là trà phải không?",
      "readingMinutes": 1
    },
    {
      "id": "l105-t2",
      "type": "teaching",
      "title": "这个 · cái này; người này (hai chữ)",
      "text": "这个 gồm 这 + 个, nói một đối tượng đã được chỉ; không tự thêm giới tính.",
      "hanzi": "我喜欢这个。",
      "pinyin": "Wǒ xǐ huan zhè ge.",
      "meaning": "Tôi thích cái này.",
      "readingMinutes": 1
    },
    {
      "id": "l105-t3",
      "type": "teaching",
      "title": "那个 · cái kia; người kia (hai chữ)",
      "text": "那个 là dạng hai chữ chỉ đối tượng kia; phân biệt vị trí được chỉ trong bài.",
      "hanzi": "我不喜欢那个。",
      "pinyin": "Wǒ bù xǐ huan nà ge.",
      "meaning": "Tôi không thích cái kia.",
      "readingMinutes": 1
    },
    {
      "id": "l105-t4",
      "type": "teaching",
      "title": "的 · của; yếu tố nối bổ nghĩa",
      "text": "的 ở 我的茶 nói trà của tôi; bài này chưa khái quát mọi cách dùng 的.",
      "hanzi": "这是我的茶。",
      "pinyin": "Zhè shì wǒ de chá.",
      "meaning": "Đây là trà của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l105-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "这/那 chỉ này/kia; 这个/那个 là dạng có 个 để chỉ một đối tượng đang được nói tới. 的 trong 我的茶 chỉ quan hệ “trà của tôi”. Khi bài yêu cầu dạng một chữ 这/那, không thay bằng dạng hai chữ; đây là giới hạn hình thức của câu hỏi, không kết luận dạng kia sai trong mọi câu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l105-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这是我的茶。那是你的茶吗？\nB：是。我喜欢这个，不喜欢那个。\nA：好。",
      "pinyin": "A: Zhè shì wǒ de chá. Nà shì nǐ de chá ma? B: Shì. Wǒ xǐ huan zhè ge, bù xǐ huan nà ge. A: Hǎo.",
      "meaning": "Đoạn dùng vị trí được chỉ: 这/这个 “này”, 那/那个 “kia”. Không hỏi người học đoán từ hình ảnh không tồn tại.",
      "readingMinutes": 2
    },
    {
