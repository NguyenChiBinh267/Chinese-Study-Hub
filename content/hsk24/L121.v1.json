  "blocks": [
    {
      "id": "l121-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l121-t0",
      "type": "teaching",
      "title": "学 · học",
      "text": "学 trong 学汉语 nói học tiếng Trung; cách dùng cụ thể cần xem đối tượng theo sau.",
      "hanzi": "我学汉语。",
      "pinyin": "Wǒ xué Hàn yǔ.",
      "meaning": "Tôi học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l121-t1",
      "type": "teaching",
      "title": "学习 · học; học tập",
      "text": "学习 có thể có đối tượng như 汉语; không phải câu nào cũng phải thêm một danh từ sau nó.",
      "hanzi": "我们学习汉语。",
      "pinyin": "Wǒ men xué xí Hàn yǔ.",
      "meaning": "Chúng tôi học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l121-t2",
      "type": "teaching",
      "title": "写 · viết",
      "text": "写 + tên/chữ là viết nội dung đó; biết chọn đáp án không chứng minh đã viết tay được.",
      "hanzi": "请写你的名字。",
      "pinyin": "Qǐng xiě nǐ de míng zi.",
      "meaning": "Xin viết tên của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l121-t3",
      "type": "teaching",
      "title": "读书 · đọc sách; đi học (tùy ngữ cảnh)",
      "text": "读书 trong câu này là đọc sách; không gán nghĩa đi học cho mọi lần xuất hiện.",
      "hanzi": "我喜欢读书。",
      "pinyin": "Wǒ xǐ huan dú shū.",
      "meaning": "Tôi thích đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l121-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "学/学习 đều nói học trong các câu của bài; không ép một từ luôn trang trọng hoặc chỉ dành cho một lứa tuổi. 写 + đối tượng là viết gì, 读书 là đọc sách/học theo ngữ cảnh. Trong 我学习汉语, 汉语 là đối tượng của hành động, không đặt trước động từ theo trật tự tùy ý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l121-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你学什么？\nB：我学汉语。你呢？\nA：我也学习汉语。我喜欢读书。\nB：请写你的名字。\nA：好。",
      "pinyin": "A: Nǐ xué shén me? B: Wǒ xué Hàn yǔ. Nǐ ne? A: Wǒ yě xué xí Hàn yǔ. Wǒ xǐ huan dú shū. B: Qǐng xiě nǐ de míng zi. A: Hǎo.",
      "meaning": "Hai người học tiếng Trung. B yêu cầu A viết tên, không yêu cầu chấm một bài văn tự do.",
      "readingMinutes": 2
    },
    {
