  "blocks": [
    {
      "id": "l198-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder0",
      "type": "teaching",
      "title": "天气 · thời tiết",
      "text": "Nhắc nghĩa đã học: thời tiết. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我觉得这里的天气很好。",
      "pinyin": "Wǒ jué de zhè lǐ de tiān qì hěn hǎo.",
      "meaning": "Tôi thấy thời tiết ở đây tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder1",
      "type": "teaching",
      "title": "雨 · mưa (danh từ)",
      "text": "Nhắc nghĩa đã học: mưa (danh từ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "明天有雨吗？",
      "pinyin": "Míng tiān yǒu yǔ ma?",
      "meaning": "Ngày mai có mưa không?",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder2",
      "type": "teaching",
      "title": "昨天 · hôm qua",
      "text": "Nhắc nghĩa đã học: hôm qua. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我昨天在学校上课。",
      "pinyin": "Wǒ zuó tiān zài xué xiào shàng kè.",
      "meaning": "Hôm qua tôi học trên lớp ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder3",
      "type": "teaching",
      "title": "星期 · tuần; yếu tố gọi thứ",
      "text": "Nhắc nghĩa đã học: tuần; yếu tố gọi thứ. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我星期一读书。",
      "pinyin": "Wǒ xīng qī yī dú shū.",
      "meaning": "Tôi đọc sách vào thứ Hai.",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder4",
      "type": "teaching",
      "title": "时间 · thời gian (dạng shíjiān)",
      "text": "Nhắc nghĩa đã học: thời gian (dạng shíjiān). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我没有时间去电影院。",
      "pinyin": "Wǒ méi yǒu shí jiān qù diàn yǐng yuàn.",
      "meaning": "Tôi không có thời gian đến rạp chiếu phim.",
      "readingMinutes": 1
    },
    {
      "id": "l198-reminder5",
      "type": "teaching",
      "title": "白天 · ban ngày",
      "text": "Nhắc nghĩa đã học: ban ngày. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我白天在学校。",
      "pinyin": "Wǒ bái tiān zài xué xiào.",
      "meaning": "Ban ngày tôi ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l198-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你昨天去哪儿了？\nB：我昨天去学校了。\nA：今天呢？\nB：今天下雨，我在家。",
      "pinyin": "A: Nǐ zuó tiān qù nǎr le? B: Wǒ zuó tiān qù xué xiào le. A: Jīn tiān ne? B: Jīn tiān xià yǔ, wǒ zài jiā.",
      "meaning": "Trong truyện B đến trường hôm qua, còn hôm nay ở nhà khi có mưa. Bài chữ không phải dự báo hoặc kiểm tra nghe.",
      "readingMinutes": 2
    },
