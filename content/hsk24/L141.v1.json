  "blocks": [
    {
      "id": "l141-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l141-t0",
      "type": "teaching",
      "title": "唱 · hát",
      "text": "唱 đi với 歌 để nói hát; không dùng 写 nếu đang nói hát bằng giọng.",
      "hanzi": "我唱歌。",
      "pinyin": "Wǒ chàng gē.",
      "meaning": "Tôi hát.",
      "readingMinutes": 1
    },
    {
      "id": "l141-t1",
      "type": "teaching",
      "title": "歌 · bài hát; ca khúc",
      "text": "歌 là bài hát, không phải rạp phim hoặc người hát.",
      "hanzi": "我听歌。",
      "pinyin": "Wǒ tīng gē.",
      "meaning": "Tôi nghe bài hát.",
      "readingMinutes": 1
    },
    {
      "id": "l141-t2",
      "type": "teaching",
      "title": "好听 · hay; dễ nghe (âm thanh)",
      "text": "好听 tả âm thanh nghe hay; không dùng nó thay 好看 cho vẻ ngoài trong mọi trường hợp.",
      "hanzi": "歌很好听。",
      "pinyin": "Gē hěn hǎo tīng.",
      "meaning": "Bài hát hay/dễ nghe.",
      "readingMinutes": 1
    },
    {
      "id": "l141-t3",
      "type": "teaching",
      "title": "好玩儿 · vui; thú vị để chơi/trải nghiệm (dạng hóa r)",
      "text": "好玩儿 có hóa r ở cuối; bài không bỏ 儿 khi đề yêu cầu đúng mục từ nguồn này.",
      "hanzi": "这里很好玩儿。",
      "pinyin": "Zhè lǐ hěn hǎo wánr.",
      "meaning": "Ở đây vui/thú vị để chơi.",
      "readingMinutes": 1
    },
    {
      "id": "l141-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "唱 + 歌 tạo hành động hát; 听歌 là nghe bài hát. 好听 khen âm thanh hay; 好玩儿 khen nơi/hoạt động thú vị để chơi hoặc trải nghiệm. Nhận xét là lời nhân vật trong văn bản, không có âm thanh để người học tự chấm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l141-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你喜欢唱歌吗？\nB：喜欢。\nA：你唱的歌很好听。\nB：谢谢！",
      "pinyin": "A: Nǐ xǐ huan chàng gē ma? B: Xǐ huan. A: Nǐ chàng de gē hěn hǎo tīng. B: Xiè xie!",
      "meaning": "A khen bài B hát; đây chỉ là nhận xét được ghi trong lời thoại, không có audio để đánh giá nghe hoặc hát.",
      "readingMinutes": 2
    },
