  "blocks": [
    {
      "id": "l489-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 祝福 zhùfú: lời chúc; 金额 jīn é: số tiền; 日记 rìjì: nhật ký; đây là gia đình hư cấu, không trình bày quy tắc phong tục bắt buộc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l489-t0",
      "type": "teaching",
      "title": "母女 · mẹ và con gái",
      "text": "母女 là quan hệ mẹ–con gái của hai người, khác hai phụ nữ bất kỳ.",
      "hanzi": "这对母女一起做饭。",
      "pinyin": "Zhè duì mǔnǚ yìqǐ zuò fàn.",
      "meaning": "Hai mẹ con gái cùng nấu ăn.",
      "readingMinutes": 1
    },
    {
      "id": "l489-t1",
      "type": "teaching",
      "title": "母亲 · mẹ",
      "text": "母亲 là từ hơi trang trọng cho mẹ, có thể dùng kể chuyện; gọi thân mật thường 妈妈.",
      "hanzi": "她给母亲打电话。",
      "pinyin": "Tā gěi mǔqīn dǎ diànhuà.",
      "meaning": "Cô gọi điện cho mẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l489-t2",
      "type": "teaching",
      "title": "母子 · mẹ và con trai",
      "text": "母子 là quan hệ mẹ–con trai; khác 母女 là mẹ–con gái.",
      "hanzi": "母子二人在车站见面。",
      "pinyin": "Mǔzǐ èr rén zài chēzhàn jiànmiàn.",
      "meaning": "Hai mẹ con trai gặp ở ga.",
      "readingMinutes": 1
    },
    {
      "id": "l489-t3",
      "type": "teaching",
      "title": "联系 · liên hệ, liên lạc",
      "text": "联系 dùng 与/跟某人联系, không đồng nghĩa đã gặp trực tiếp. Nhận diện chữ 联 trong 联系; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们以后常联系。",
      "pinyin": "Wǒmen yǐhòu cháng liánxì.",
      "meaning": "Sau này mình thường liên lạc nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l489-t4",
      "type": "teaching",
      "title": "留下 · để lại, giữ lại",
      "text": "留下 nói giữ lại hoặc để lại người/vật/dấu vết; bài dùng 留下地址.",
      "hanzi": "请留下联系地址。",
      "pinyin": "Qǐng liúxia liánxì dìzhǐ.",
      "meaning": "Xin để lại địa chỉ liên hệ.",
      "readingMinutes": 1
    },
    {
      "id": "l489-t5",
      "type": "teaching",
      "title": "红包 · phong bao đỏ, lì xì",
      "text": "红包 trong bài là phong bao chúc mừng; không suy ra mức tiền hay nghĩa vụ nhận tiền thực.",
      "hanzi": "母亲准备了一个红包。",
      "pinyin": "Mǔqīn zhǔnbèi le yí ge hóngbāo.",
      "meaning": "Mẹ chuẩn bị một phong bao đỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l489-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "怎么也 + phủ định nhấn mạnh dù cố/đổi cách thế nào cũng không: 我怎么也忘不了这次见面. Khác câu hỏi 怎么办. Ở đây là cách kể không quên được, không đánh giá trí nhớ người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l489-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "一家人周末见面，母亲和女儿一起做饭，母子二人去车站接人。母亲准备了一个红包，表达祝福，没有规定金额。离开前，大家留下联系地址，说以后常联系。小宁在日记里写：“我怎么也忘不了这次见面。”",
      "pinyin": "Yì jiā rén zhōumò jiànmiàn, mǔqīn hé nǚér yìqǐ zuò fàn, mǔzǐ èr rén qù chēzhàn jiē rén. Mǔqīn zhǔnbèi le yí ge hóngbāo, biǎodá zhùfú, méiyǒu guīdìng jīn é. Líkāi qián, dàjiā liúxia liánxì dìzhǐ, shuō yǐhòu cháng liánxì. Xiǎo Níng zài rìjì lǐ xiě: “Wǒ zěnme yě wàng bù liǎo zhè cì jiànmiàn.”",
      "meaning": "Gia đình gặp cuối tuần, mẹ và con gái nấu, mẹ và con trai đón khách. Phong bao thể hiện lời chúc, không quy định số tiền. Mọi người để địa chỉ liên lạc. Ninh ghi đây là cuộc gặp khó quên.",
      "readingMinutes": 2
    },
    {
