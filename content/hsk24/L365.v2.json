  "blocks": [
    {
      "id": "l365-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 被 bèi: bị/được trong câu bị động; 伤 shāng: thương tích; 来访 láifǎng: đến thăm; 病人 bìngrén: người bệnh. Bài đọc không hướng dẫn điều trị hay đánh giá bệnh. 得 de + 很好 hěn hǎo: bổ ngữ cách thức/mức độ trong 被家人照顾得很好, không phải chứng nhận y khoa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l365-t0",
      "type": "teaching",
      "title": "出生 · sinh ra/chào đời",
      "text": "出生 nói sự kiện sinh ra; 出生在… nêu địa điểm, 出生于… thường văn viết. Không suy ra tuổi nếu thiếu năm hiện tại.",
      "hanzi": "她的妹妹在这家医院出生。",
      "pinyin": "Tā de mèimei zài zhè jiā yīyuàn chūshēng.",
      "meaning": "Em gái cô ấy sinh ở bệnh viện này.",
      "readingMinutes": 1
    },
    {
      "id": "l365-t1",
      "type": "teaching",
      "title": "出院 · xuất viện",
      "text": "出院 là rời bệnh viện sau điều trị/lưu viện theo cảnh; không tự chứng minh khỏi hoàn toàn hay không cần chăm sóc.",
      "hanzi": "他昨天出院了。",
      "pinyin": "Tā zuótiān chū yuàn le.",
      "meaning": "Hôm qua anh ấy xuất viện.",
      "readingMinutes": 1
    },
    {
      "id": "l365-t2",
      "type": "teaching",
      "title": "住院 · nằm viện",
      "text": "住院 nói nhập/nằm viện điều trị; không phải sống cạnh viện. 住院三天 là nằm viện ba ngày.",
      "hanzi": "她住院三天了。",
      "pinyin": "Tā zhù yuàn sān tiān le.",
      "meaning": "Cô ấy đã nằm viện ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l365-t3",
      "type": "teaching",
      "title": "照顾 · chăm sóc/trông nom",
      "text": "照顾 là chăm sóc người/việc theo cảnh; 照顾病人 nói trông nom, không tự xác nhận có chuyên môn y khoa.",
      "hanzi": "家人照顾住院的爷爷。",
      "pinyin": "Jiārén zhàogù zhùyuàn de yéye.",
      "meaning": "Người nhà chăm ông đang nằm viện.",
      "readingMinutes": 1
    },
    {
      "id": "l365-t4",
      "type": "teaching",
      "title": "受 · chịu/nhận (tác động)",
      "text": "受 trong 受伤 là chịu thương tích; 受了伤 tách trợ từ giữa 受 và 伤. Không suy ra loại hay mức độ chấn thương.",
      "hanzi": "他受了伤，正在休息。",
      "pinyin": "Tā shòu le shāng, zhèngzài xiūxi.",
      "meaning": "Anh ấy bị thương và đang nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l365-t5",
      "type": "teaching",
      "title": "受到 · nhận/chịu được tác động",
      "text": "受到 + tác động như 欢迎/影响 nêu đã nhận/chịu; thường khác nhận vật hữu hình bằng 收到. 受到欢迎不等于所有人都喜欢.",
      "hanzi": "来访的同学受到了欢迎。",
      "pinyin": "Láifǎng de tóngxué shòudào le huānyíng.",
      "meaning": "Bạn học đến thăm được chào đón.",
      "readingMinutes": 1
    },
    {
      "id": "l365-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "他被家人照顾得很好 nêu người nhận tác động trước, tác nhân sau 被. Chỉ luyện câu bị động có tác nhân và hành động rõ; không dùng 被 cho mọi cảm xúc hoặc đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l365-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "爷爷受了伤，住院三天，昨天出院了。他被家人照顾得很好，还要按医生的安排休息。来访的同学受到了欢迎。妹妹在这家医院出生，但不是这次住院的病人。",
      "pinyin": "Yéye shòu le shāng, zhù yuàn sān tiān, zuótiān chū yuàn le. Tā bèi jiārén zhàogù de hěn hǎo, hái yào àn yīshēng de ānpái xiūxi. Láifǎng de tóngxué shòudào le huānyíng. Mèimei zài zhè jiā yīyuàn chūshēng, dàn bú shì zhè cì zhùyuàn de bìngrén.",
      "meaning": "Ông bị thương, nằm viện ba ngày rồi xuất viện hôm qua; gia đình chăm và ông vẫn nghỉ theo sắp xếp của bác sĩ. Bạn đến thăm được chào đón. Em gái sinh ở viện này nhưng không phải bệnh nhân lần này.",
      "readingMinutes": 2
    },
    {
