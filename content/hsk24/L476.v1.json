  "blocks": [
    {
      "id": "l476-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 成就感 chéngjiùgǎn: cảm giác thành tựu; 否定 fǒudìng: phủ nhận; 总结 zǒngjié: tổng kết. Không suy ra tình trạng tâm lý từ bài tập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l476-t0",
      "type": "teaching",
      "title": "烦 · phiền, bực",
      "text": "烦 nói cảm giác bị làm phiền hoặc việc gây phiền; trong 心里烦 là trạng thái tâm lý. Nhận diện chữ 烦 trong 烦; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "事情太多，我心里有点儿烦。",
      "pinyin": "Shìqing tài duō, wǒ xīnli yǒu diǎnr fán.",
      "meaning": "Nhiều việc quá, tôi hơi bực.",
      "readingMinutes": 1
    },
    {
      "id": "l476-t1",
      "type": "teaching",
      "title": "烦恼 · lo phiền, phiền muộn",
      "text": "烦恼 trong mục nguồn là tính từ trạng thái lo phiền, như 她最近很烦恼. Danh từ nỗi phiền trong 说出烦恼 là cách dùng bổ sung trong đoạn.",
      "hanzi": "她最近很烦恼。",
      "pinyin": "Tā zuìjìn hěn fánnǎo.",
      "meaning": "Gần đây cô ấy rất phiền muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l476-t2",
      "type": "teaching",
      "title": "感 · cảm giác, cảm",
      "text": "感 trong 成就感 là thành tố chỉ cảm giác; không dùng một mình thay mọi 感觉.",
      "hanzi": "完成小目标让我有成就感。",
      "pinyin": "Wánchéng xiǎo mùbiāo ràng wǒ yǒu chéngjiùgǎn.",
      "meaning": "Hoàn thành mục tiêu nhỏ cho tôi cảm giác thành tựu.",
      "readingMinutes": 1
    },
    {
      "id": "l476-t3",
      "type": "teaching",
      "title": "美好 · tốt đẹp",
      "text": "美好 tả trải nghiệm/ước vọng tốt đẹp, không chỉ vẻ ngoài đẹp.",
      "hanzi": "我们留下了美好的回忆。",
      "pinyin": "Wǒmen liúxià le měihǎo de huíyì.",
      "meaning": "Chúng tôi lưu lại kỷ niệm đẹp.",
      "readingMinutes": 1
    },
    {
      "id": "l476-t4",
      "type": "teaching",
      "title": "难忘 · khó quên",
      "text": "难忘 là tính từ đáng nhớ; có thể cho cả trải nghiệm vui và buồn, cần ngữ cảnh.",
      "hanzi": "这是一次难忘的经历。",
      "pinyin": "Zhè shì yí cì nánwàng de jīnglì.",
      "meaning": "Đây là trải nghiệm khó quên.",
      "readingMinutes": 1
    },
    {
      "id": "l476-t5",
      "type": "teaching",
      "title": "内心 · nội tâm, trong lòng",
      "text": "内心 nói thế giới/cảm xúc bên trong; không suy ra từ vẻ mặt nếu thiếu lời kể.",
      "hanzi": "她把内心的想法写下来。",
      "pinyin": "Tā bǎ nèixīn de xiǎngfǎ xiě xià lái.",
      "meaning": "Cô viết suy nghĩ trong lòng ra.",
      "readingMinutes": 1
    },
    {
      "id": "l476-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "X是X先承认 một mặt, 就是/不过再提出 hạn chế: 活动好是好，就是时间太短. Dịch tự nhiên: hoạt động hay thì hay, chỉ có thời gian quá ngắn. Không hiểu lặp X là lỗi thừa; cần đọc thái độ nhượng bộ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l476-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "活动结束后，小云写下内心的想法。完成小目标让她有成就感，也留下美好的回忆。她说这是一次难忘的经历，但事情太多时也会心里烦。朋友听她说出烦恼，没有马上否定。小云总结：“活动好是好，就是时间太短。”",
      "pinyin": "Huódòng jiéshù hòu, Xiǎo Yún xiě xià nèixīn de xiǎngfǎ. Wánchéng xiǎo mùbiāo ràng tā yǒu chéngjiùgǎn, yě liúxià měihǎo de huíyì. Tā shuō zhè shì yí cì nánwàng de jīnglì, dàn shìqing tài duō shí yě huì xīnli fán. Péngyou tīng tā shuō chū fánnǎo, méiyǒu mǎshàng fǒudìng. Xiǎo Yún zǒngjié: “Huódòng hǎo shì hǎo, jiùshì shíjiān tài duǎn.”",
      "meaning": "Vân viết cảm xúc sau hoạt động: có thành tựu, kỷ niệm đẹp nhưng nhiều việc cũng khiến bực. Bạn lắng nghe. Cô đánh giá hay nhưng thời gian ngắn.",
      "readingMinutes": 2
    },
