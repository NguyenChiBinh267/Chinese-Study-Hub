  "blocks": [
    {
      "id": "l4075-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t0",
      "type": "teaching",
      "title": "之 · của; yếu tố nối trong văn viết",
      "text": "之1 ở 一年之中 là trợ từ trong cụm, không phải đại từ nó của văn cổ trong bài. Nhận diện chữ 之 trong 之; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "一年之中，他最喜欢秋天。",
      "pinyin": "Yì nián zhī zhōng, tā zuì xǐ huan qiū tiān.",
      "meaning": "Trong năm anh ấy thích mùa thu nhất.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t1",
      "type": "teaching",
      "title": "之后 · sau",
      "text": "之后 đặt sau mốc hoặc sự việc để chỉ sau đó.",
      "hanzi": "上课之后，我们去图书馆。",
      "pinyin": "Shàng kè zhī hòu, wǒ men qù tú shū guǎn.",
      "meaning": "Sau giờ học chúng tôi đến thư viện.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t2",
      "type": "teaching",
      "title": "之前 · trước",
      "text": "之前 chỉ trước mốc, đối lập 之后 ở bài.",
      "hanzi": "上课之前，请先读一遍。",
      "pinyin": "Shàng kè zhī qián, qǐng xiān dú yí biàn.",
      "meaning": "Trước giờ xin đọc một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t3",
      "type": "teaching",
      "title": "之间 · giữa",
      "text": "之间 ở 两个日期之间 chỉ khoảng giữa hai mốc.",
      "hanzi": "两个日期之间隔了三天。",
      "pinyin": "Liǎng ge rì qī zhī jiān gé le sān tiān.",
      "meaning": "Hai ngày đó cách nhau ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t4",
      "type": "teaching",
      "title": "之中 · trong số; bên trong",
      "text": "之中 đặt sau phạm vi được xét, ở đây là một nhóm người.",
      "hanzi": "这些读者之中，有两位老师。",
      "pinyin": "Zhè xiē dú zhě zhī zhōng, yǒu liǎng wèi lǎo shī.",
      "meaning": "Trong số người đọc có hai giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-t5",
      "type": "teaching",
      "title": "自 · từ; kể từ",
      "text": "自 trong 自上周起 là giới từ mở mốc bắt đầu, tương đối văn viết.",
      "hanzi": "自上周起，阅览室延长开放时间。",
      "pinyin": "Zì shàng zhōu qǐ, yuè lǎn shì yán cháng kāi fàng shí jiān.",
      "meaning": "Từ tuần trước phòng đọc mở lâu hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l4075-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "此外 thêm một thông tin. 之 trong văn viết có thể nối phần bổ nghĩa với danh từ; các tổ hợp 之前、之后、之间、之中 cần đọc như cả cụm, không thay chữ tùy ý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4075-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "自上周起，老师请大家上课之前预习，上课之后总结。小安把两个日期之间的安排写下来。此外，她发现这些读者之中有两位老师。一年之中，他们秋天来得最多，这只是故事中这个小组的情况。",
      "pinyin": "Zì shàng zhōu qǐ, lǎo shī qǐng dà jiā shàng kè zhī qián yù xí, shàng kè zhī hòu zǒng jié. Xiǎo Ān bǎ liǎng ge rì qī zhī jiān de ān pái xiě xià lái. Cǐ wài, tā fā xiàn zhè xiē dú zhě zhī zhōng yǒu liǎng wèi lǎo shī. Yì nián zhī zhōng, tā men qiū tiān lái de zuì duō, zhè zhǐ shì gù shi zhōng zhè ge xiǎo zǔ de qíng kuàng.",
      "meaning": "Bài phân biệt trước, sau, giữa hai mốc và trong một tập hợp; số liệu chỉ thuộc nhóm hư cấu.",
      "readingMinutes": 2
    },
