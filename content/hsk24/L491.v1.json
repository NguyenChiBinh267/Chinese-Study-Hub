  "blocks": [
    {
      "id": "l491-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 展览 zhǎnlǎn: triển lãm; 作品 zuòpǐn: tác phẩm; 作者 zuòzhě: tác giả; bổ sung ngoài sáu mục từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l491-t0",
      "type": "teaching",
      "title": "并 · và, đồng thời",
      "text": "并 trong câu mục tiêu nối hai hành động; khác 并不 là nhấn mạnh phủ định. Nhận diện chữ 并 trong 并; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "工作人员介绍作品，并回答问题。",
      "pinyin": "Gōngzuò rényuán jièshào zuòpǐn, bìng huídá wèntí.",
      "meaning": "Nhân viên giới thiệu tác phẩm và trả lời câu hỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l491-t1",
      "type": "teaching",
      "title": "并且 · và còn, đồng thời",
      "text": "并且 nối ý cùng hướng, gần 并 trong ngữ cảnh này; bài nêu đúng dạng khi hỏi.",
      "hanzi": "作品有趣，并且容易理解。",
      "pinyin": "Zuòpǐn yǒuqù, bìngqiě róngyì lǐjiě.",
      "meaning": "Tác phẩm thú vị và dễ hiểu.",
      "readingMinutes": 1
    },
    {
      "id": "l491-t2",
      "type": "teaching",
      "title": "不光 · không chỉ",
      "text": "不光 thường đi với 还/也; gần 不仅, không khẳng định từ kia sai trong mọi câu.",
      "hanzi": "这里不光有画，还有照片。",
      "pinyin": "Zhèlǐ bùguāng yǒu huà, hái yǒu zhàopiàn.",
      "meaning": "Ở đây không chỉ có tranh còn có ảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l491-t3",
      "type": "teaching",
      "title": "不仅 · không những",
      "text": "不仅 thường dùng 不仅……还……; hơi trang trọng hơn 不光.",
      "hanzi": "展览不仅有趣，还能学到知识。",
      "pinyin": "Zhǎnlǎn bùjǐn yǒuqù, hái néng xué dào zhīshi.",
      "meaning": "Triển lãm không chỉ thú vị còn học được kiến thức.",
      "readingMinutes": 1
    },
    {
      "id": "l491-t4",
      "type": "teaching",
      "title": "多么 · biết bao, thật là",
      "text": "多么 trong cảm thán nhấn mạnh mức độ, không hỏi số lượng như 多少.",
      "hanzi": "这些作品多么美啊！",
      "pinyin": "Zhèxiē zuòpǐn duōme měi a!",
      "meaning": "Các tác phẩm đẹp biết bao!",
      "readingMinutes": 1
    },
    {
      "id": "l491-t5",
      "type": "teaching",
      "title": "各种 · các loại, đủ loại",
      "text": "各种 + danh từ nói nhiều loại, khác 各个 nhấn từng đơn vị riêng.",
      "hanzi": "这里展示各种作品。",
      "pinyin": "Zhèlǐ zhǎnshì gèzhǒng zuòpǐn.",
      "meaning": "Ở đây trưng bày các loại tác phẩm.",
      "readingMinutes": 1
    },
    {
      "id": "l491-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "并 dùng nối hai hành động cùng hướng, hơi văn viết: 工作人员介绍作品，并回答问题. Chủ ngữ sau 并 có thể lược khi cùng người. Không lẫn 并 không hề trong 并不; bài chỉ luyện nghĩa liên từ này.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l491-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "展览里有各种作品，不光有画，还有照片。工作人员介绍作品，并回答问题。小欣觉得展览不仅有趣，还能学到知识，并且容易看懂。她对朋友说：“这些作品多么美啊！”朋友先读作者介绍，再选自己想细看的部分。",
      "pinyin": "Zhǎnlǎn lǐ yǒu gèzhǒng zuòpǐn, bùguāng yǒu huà, hái yǒu zhàopiàn. Gōngzuò rényuán jièshào zuòpǐn, bìng huídá wèntí. Xiǎo Xīn juéde zhǎnlǎn bùjǐn yǒuqù, hái néng xué dào zhīshi, bìngqiě róngyì kàn dǒng. Tā duì péngyou shuō: “Zhèxiē zuòpǐn duōme měi a!” Péngyou xiān dú zuòzhě jièshào, zài xuǎn zìjǐ xiǎng xì kàn de bùfen.",
      "meaning": "Triển lãm có tranh và ảnh. Nhân viên giới thiệu, trả lời. Hân thấy thú vị, học được điều mới, dễ hiểu và khen đẹp. Bạn đọc giới thiệu tác giả rồi chọn phần xem kỹ.",
      "readingMinutes": 2
    },
    {
