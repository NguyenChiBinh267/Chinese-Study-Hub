  "blocks": [
    {
      "id": "l425-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 容量 róngliàng: sức chứa; 公斤 gōngjīn: kilôgam; 预算 yùsuàn: ngân sách; 前者/后者 qiánzhě/hòuzhě: cái trước/cái sau; 装 zhuāng: chứa/đựng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l425-t0",
      "type": "teaching",
      "title": "倍 · lần (bội số)",
      "text": "倍 đếm số lần của cùng một đại lượng; 两倍 có nghĩa nhân hai, không tự là cộng hai đơn vị. Nhận diện chữ 倍 trong 倍; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "大盒子的容量是小盒子的两倍。",
      "pinyin": "Dà hézi de róngliàng shì xiǎo hézi de liǎng bèi.",
      "meaning": "Sức chứa hộp lớn bằng hai lần hộp nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l425-t1",
      "type": "teaching",
      "title": "超过 · vượt quá",
      "text": "超过 chỉ lớn hơn một mốc/giới hạn; chưa hàm ý vi phạm nếu không có quy tắc kèm theo.",
      "hanzi": "总重量不能超过十公斤。",
      "pinyin": "Zǒng zhòngliàng bù néng chāoguò shí gōngjīn.",
      "meaning": "Tổng khối lượng không được vượt mười kilôgam.",
      "readingMinutes": 1
    },
    {
      "id": "l425-t2",
      "type": "teaching",
      "title": "低 · thấp",
      "text": "低 ở 价格低 là mức thấp, không dùng thay 矮 để nói chiều cao người trong mọi câu.",
      "hanzi": "小盒子的价格比较低。",
      "pinyin": "Xiǎo hézi de jiàgé bǐjiào dī.",
      "meaning": "Giá hộp nhỏ tương đối thấp.",
      "readingMinutes": 1
    },
    {
      "id": "l425-t3",
      "type": "teaching",
      "title": "低于 · thấp hơn (mốc)",
      "text": "低于 nhận mốc so sánh; cần cùng đơn vị, không so một giá tiền với một khối lượng.",
      "hanzi": "这个价格低于我的预算。",
      "pinyin": "Zhège jiàgé dīyú wǒ de yùsuàn.",
      "meaning": "Giá này thấp hơn ngân sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l425-t4",
      "type": "teaching",
      "title": "够 · đủ",
      "text": "够 nói đạt lượng cần trong ngữ cảnh; không tự có nghĩa dư thừa.",
      "hanzi": "两个小盒子就够了。",
      "pinyin": "Liǎng ge xiǎo hézi jiù gòu le.",
      "meaning": "Hai hộp nhỏ là đủ rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l425-t5",
      "type": "teaching",
      "title": "不够 · không đủ",
      "text": "不够 là chưa đạt mức cần; bài hỏi đúng dạng hai chữ, không chỉ một tiếng phủ định.",
      "hanzi": "一个小盒子不够装这些书。",
      "pinyin": "Yí ge xiǎo hézi búgòu zhuāng zhèxiē shū.",
      "meaning": "Một hộp nhỏ không đủ đựng số sách này.",
      "readingMinutes": 1
    },
    {
      "id": "l425-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "A是B的两倍 nói A bằng hai lần B. Không nhầm với 比B多两倍 là thêm hai lần B. Bài dùng số hư cấu, luôn nêu đơn vị và cùng đại lượng để so sánh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l425-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "店员说明：大盒子能装二十本同样的书，小盒子能装十本，所以前者容量是后者的两倍。小方有十五本书，一个小盒子不够，两个就够。她还确认总重量不超过规定，并选择低于预算的价格。",
      "pinyin": "Diànyuán shuōmíng: Dà hézi néng zhuāng èrshí běn tóngyàng de shū, xiǎo hézi néng zhuāng shí běn, suǒyǐ qiánzhě róngliàng shì hòuzhě de liǎng bèi. Xiǎo Fāng yǒu shíwǔ běn shū, yí ge xiǎo hézi búgòu, liǎng ge jiù gòu. Tā hái quèrèn zǒng zhòngliàng bù chāoguò guīdìng, bìng xuǎnzé dīyú yùsuàn de jiàgé.",
      "meaning": "Hộp lớn đựng 20 quyển cùng loại, hộp nhỏ 10; tỷ lệ sức chứa là hai lần. Phương có 15 quyển nên cần hai hộp nhỏ nếu chọn loại nhỏ.",
      "readingMinutes": 2
    },
    {
