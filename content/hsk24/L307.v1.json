  "blocks": [
    {
      "id": "l307-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 先/再, thời gian đứng trước động từ, 在 và lượng từ cơ bản. Prerequisite HSK1/2 vẫn chưa chứng nhận. 公园 gōngyuán: công viên; 东边/南边/西边/北边 là phương hướng + 边; các tổ hợp dùng để hiểu vị trí, không tính thêm mục từ. Chỉ dẫn là tình huống hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l307-t0",
      "type": "teaching",
      "title": "东 · đông",
      "text": "东 là hướng đông; 往东走 nói đi về đông. Không suy ra mọi nơi bên phải bản đồ đều là đông nếu bản đồ không xác định hướng.",
      "hanzi": "学校在车站的东边。",
      "pinyin": "Xuéxiào zài chēzhàn de dōngbian.",
      "meaning": "Trường ở phía đông ga.",
      "readingMinutes": 1
    },
    {
      "id": "l307-t1",
      "type": "teaching",
      "title": "南 · nam",
      "text": "南 là hướng nam, khác 男 chỉ nam giới dù cùng đọc nán. 在南边 mô tả vị trí, không chỉ đi xuống cầu thang.",
      "hanzi": "我们往南走。",
      "pinyin": "Wǒmen wǎng nán zǒu.",
      "meaning": "Chúng tôi đi về phía nam.",
      "readingMinutes": 1
    },
    {
      "id": "l307-t2",
      "type": "teaching",
      "title": "西 · tây",
      "text": "西 là hướng tây. 日落方向 chỉ là hỗ trợ giải nghĩa thông thường, bài không yêu cầu suy hướng ngoài trời.",
      "hanzi": "宾馆在公园西边。",
      "pinyin": "Bīnguǎn zài gōngyuán xībian.",
      "meaning": "Khách sạn ở phía tây công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l307-t3",
      "type": "teaching",
      "title": "北 · bắc",
      "text": "北 là hướng bắc. 北京 là tên riêng, không thay cho từ chỉ hướng trong câu 往北走.",
      "hanzi": "请往北走，再往东走。",
      "pinyin": "Qǐng wǎng běi zǒu, zài wǎng dōng zǒu.",
      "meaning": "Hãy đi bắc rồi đi đông.",
      "readingMinutes": 1
    },
    {
      "id": "l307-t4",
      "type": "teaching",
      "title": "方向 · phương hướng",
      "text": "方向 là hướng đi hoặc hướng chỉ; 你走错方向了 nói nhầm hướng, không nhất thiết nhầm địa điểm hẹn.",
      "hanzi": "我不知道车站在哪个方向。",
      "pinyin": "Wǒ bù zhīdào chēzhàn zài nǎ ge fāngxiàng.",
      "meaning": "Tôi không biết ga ở hướng nào.",
      "readingMinutes": 1
    },
    {
      "id": "l307-t5",
      "type": "teaching",
      "title": "中间 · ở giữa",
      "text": "中间 nói vị trí giữa hai hoặc nhiều đối tượng theo ngữ cảnh. Phân biệt 与 中/中午: bài chỉ dạy nghĩa vị trí giữa.",
      "hanzi": "学校在车站和宾馆中间。",
      "pinyin": "Xuéxiào zài chēzhàn hé bīnguǎn zhōngjiān.",
      "meaning": "Trường ở giữa ga và khách sạn.",
      "readingMinutes": 1
    },
    {
      "id": "l307-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "东南西北 là phương hướng; 中间 là vị trí giữa các vật/người xác định. Phạm vi bài luyện bốn hướng đơn và 中间; các tên vùng 北方/东方… trong dòng nguồn chưa được luyện đầy đủ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l307-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我想去车站，应该往哪个方向走？小李：先往北走，再往东走。学校在车站和宾馆中间。小安：公园呢？小李：在学校南边，宾馆在公园西边。",
      "pinyin": "Xiǎo Ān: Wǒ xiǎng qù chēzhàn, yīnggāi wǎng nǎ ge fāngxiàng zǒu? Xiǎo Lǐ: Xiān wǎng běi zǒu, zài wǎng dōng zǒu. Xuéxiào zài chēzhàn hé bīnguǎn zhōngjiān. Xiǎo Ān: Gōngyuán ne? Xiǎo Lǐ: Zài xuéxiào nánbian, bīnguǎn zài gōngyuán xībian.",
      "meaning": "An hỏi đường đến ga. Lý hướng dẫn đi bắc rồi đông; trường nằm giữa ga và khách sạn. Công viên ở nam trường; khách sạn ở tây công viên. Đây là mô tả ngôn ngữ, không có bản đồ tỉ lệ.",
      "readingMinutes": 2
    },
    {
