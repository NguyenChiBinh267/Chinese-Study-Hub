  "blocks": [
    {
      "id": "l163-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l163-t0",
      "type": "teaching",
      "title": "一半 · một nửa",
      "text": "一半 là một nửa của toàn thể đang nói; không tự xác định toàn thể có bao nhiêu phần tử.",
      "hanzi": "这些苹果，一半是我的。",
      "pinyin": "Zhè xiē píng guǒ, yí bàn shì wǒ de.",
      "meaning": "Những quả táo này, một nửa là của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l163-t1",
      "type": "teaching",
      "title": "一点儿 · một ít; một chút (dạng yìdiǎnr)",
      "text": "一点儿 ở ví dụ là lượng nước nhỏ; giữ hóa r khi hỏi đúng mục nguồn.",
      "hanzi": "我想喝一点儿水。",
      "pinyin": "Wǒ xiǎng hē yì diǎnr shuǐ.",
      "meaning": "Tôi muốn uống một chút nước.",
      "readingMinutes": 1
    },
    {
      "id": "l163-t2",
      "type": "teaching",
      "title": "一些 · một số; một ít (dạng yìxiē)",
      "text": "一些 thường đi với danh từ; không coi nó là một con số chính xác.",
      "hanzi": "我有一些书。",
      "pinyin": "Wǒ yǒu yì xiē shū.",
      "meaning": "Tôi có một số sách.",
      "readingMinutes": 1
    },
    {
      "id": "l163-t3",
      "type": "teaching",
      "title": "有些 · một số (dạng yǒuxiē trong mẫu danh từ)",
      "text": "有些 trong 有些书 chỉ một số sách; bài chưa khái quát mọi cách dùng mức độ của từ này.",
      "hanzi": "有些书是新的。",
      "pinyin": "Yǒu xiē shū shì xīn de.",
      "meaning": "Một số sách là sách mới.",
      "readingMinutes": 1
    },
    {
      "id": "l163-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一半 là một nửa của một lượng/nhóm đã nêu. 一点儿 và 一些 nói một ít/một số, không ấn định số chính xác; 一点儿 nhấn lượng nhỏ trong ví dụ. 有些 + danh từ nói một số đối tượng. Các từ gần nghĩa có chỗ giao nhau nên câu từ vựng nêu rõ âm của mục được hỏi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l163-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这些苹果都是你的吗？\nB：不是，一半是我的，一半是我姐姐的。\nA：你有一些书吗？\nB：有。",
      "pinyin": "A: Zhè xiē píng guǒ dōu shì nǐ de ma? B: Bú shì, yí bàn shì wǒ de, yí bàn shì wǒ jiě jie de. A: Nǐ yǒu yì xiē shū ma? B: Yǒu.",
      "meaning": "都 dōu = đều/tất cả, học mục riêng ở nhóm cuối. B nhận một nửa táo; nửa còn lại là của chị. Không nêu tổng số táo.",
      "readingMinutes": 2
    },
