  "blocks": [
    {
      "id": "l446-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 擦 cā: lau; 空 có hai mục nguồn cùng chữ: kōng và kòng. 免得 miǎnde: để tránh; 丢掉 diūdiào: vứt/mất; 留下 liúxia: giữ lại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l446-t0",
      "type": "teaching",
      "title": "家具 · đồ nội thất",
      "text": "家具 là tên tập hợp, không dùng 一个家具; đếm bằng 件 khi cần.",
      "hanzi": "客厅里的家具不多。",
      "pinyin": "Kètīng lǐ de jiājù bù duō.",
      "meaning": "Phòng khách không có nhiều đồ nội thất.",
      "readingMinutes": 1
    },
    {
      "id": "l446-t1",
      "type": "teaching",
      "title": "客厅 · phòng khách",
      "text": "客厅 là phòng sinh hoạt/tiếp khách trong nhà, khác 客房 là phòng cho khách ở.",
      "hanzi": "我们在客厅讨论。",
      "pinyin": "Wǒmen zài kètīng tǎolùn.",
      "meaning": "Chúng tôi thảo luận ở phòng khách.",
      "readingMinutes": 1
    },
    {
      "id": "l446-t2",
      "type": "teaching",
      "title": "镜子 · gương",
      "text": "镜子 là đồ soi; không đồng nhất với 眼镜 là kính đeo. Nhận diện chữ 镜 trong 镜子; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请把镜子擦一遍。",
      "pinyin": "Qǐng bǎ jìngzi cā yí biàn.",
      "meaning": "Hãy lau gương một lượt.",
      "readingMinutes": 1
    },
    {
      "id": "l446-t3",
      "type": "teaching",
      "title": "空 · trống rỗng",
      "text": "空 đọc kōng khi tả vật rỗng/trống; khác kòng là thời gian rảnh/chỗ trống.",
      "hanzi": "这个盒子是空的。",
      "pinyin": "Zhè ge hézi shì kōng de.",
      "meaning": "Hộp này rỗng.",
      "readingMinutes": 1
    },
    {
      "id": "l446-t4",
      "type": "teaching",
      "title": "空 · thời gian rảnh",
      "text": "空 đọc kòng trong 有空、没空. Bài yêu cầu pinyin để phân biệt với kōng, không đòi phân biệt hai chữ viết giống nhau.",
      "hanzi": "我下午有空。",
      "pinyin": "Wǒ xiàwǔ yǒu kòng.",
      "meaning": "Chiều tôi rảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l446-t5",
      "type": "teaching",
      "title": "毛巾 · khăn mặt, khăn lau",
      "text": "毛巾 là khăn vải; dùng khăn phù hợp bề mặt, ví dụ không phải hướng dẫn vệ sinh chuyên môn.",
      "hanzi": "她拿来一条干毛巾。",
      "pinyin": "Tā ná lái yì tiáo gān máojīn.",
      "meaning": "Cô ấy mang một chiếc khăn khô tới.",
      "readingMinutes": 1
    },
    {
      "id": "l446-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把 đưa vật đã xác định lên trước động từ; bổ ngữ 一遍 nêu số lần thực hiện: 把镜子擦一遍. Ở bài này động từ 擦 cần thao tác cụ thể, không chỉ 把镜子擦 là đủ. Không đảo vật và người làm.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l446-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "新家客厅里的家具不多，墙边放着一面镜子和一个空盒子。小方下午有空，想整理一下。他拿来一条干毛巾，对弟弟说：“请把镜子擦一遍，再把毛巾放回去。”弟弟先问哪个盒子要留下，免得把有用的东西丢掉。",
      "pinyin": "Xīn jiā kètīng lǐ de jiājù bù duō, qiáng biān fàngzhe yí miàn jìngzi hé yí ge kōng hézi. Xiǎo Fāng xiàwǔ yǒu kòng, xiǎng zhěnglǐ yíxià. Tā ná lái yì tiáo gān máojīn, duì dìdi shuō: “Qǐng bǎ jìngzi cā yí biàn, zài bǎ máojīn fàng huí qù.” Dìdi xiān wèn nǎ ge hézi yào liúxià, miǎnde bǎ yǒuyòng de dōngxi diūdiào.",
      "meaning": "Phòng khách mới ít đồ. Phương rảnh buổi chiều nên nhờ em lau gương rồi cất khăn. Em hỏi hộp nào cần giữ để tránh vứt đồ hữu ích.",
      "readingMinutes": 2
    },
    {
