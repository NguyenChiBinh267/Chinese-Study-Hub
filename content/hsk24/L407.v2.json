  "blocks": [
    {
      "id": "l407-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 食品 shípǐn: thực phẩm; 生产 shēngchǎn: sản xuất; 销售 xiāoshòu: bán hàng; 接待员 jiēdàiyuán: người đón tiếp; 名单 míngdān: danh sách; 通向 tōngxiàng: dẫn tới.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l407-t0",
      "type": "teaching",
      "title": "参观 · tham quan",
      "text": "参观 thường nhận địa điểm có tổ chức như nhà máy/bảo tàng, không dùng thay mọi hoạt động ngắm. Nhận diện chữ 观 trong 参观; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我们明天参观一家食品厂。",
      "pinyin": "Wǒmen míngtiān cānguān yì jiā shípǐn chǎng.",
      "meaning": "Ngày mai chúng tôi tham quan một nhà máy thực phẩm.",
      "readingMinutes": 1
    },
    {
      "id": "l407-t1",
      "type": "teaching",
      "title": "厂 · nhà máy, xưởng",
      "text": "厂 chỉ nơi sản xuất, thường gặp trong 食品厂; không đồng nhất 部门 là phòng ban.",
      "hanzi": "这家厂只生产面包。",
      "pinyin": "Zhè jiā chǎng zhǐ shēngchǎn miànbāo.",
      "meaning": "Nhà máy này chỉ sản xuất bánh mì.",
      "readingMinutes": 1
    },
    {
      "id": "l407-t2",
      "type": "teaching",
      "title": "出差 · đi công tác",
      "text": "出差 là đi vì công việc; có thể kèm nơi đến, khác du lịch tự do.",
      "hanzi": "她下周要去上海出差。",
      "pinyin": "Tā xià zhōu yào qù Shànghǎi chūchāi.",
      "meaning": "Tuần tới cô ấy đi công tác Thượng Hải.",
      "readingMinutes": 1
    },
    {
      "id": "l407-t3",
      "type": "teaching",
      "title": "部 · bộ phận; bộ (lượng từ)",
      "text": "部 trong 销售部 là bộ phận. Bài giới hạn nghĩa tổ chức này, chưa dạy đủ cách đếm phim/sách.",
      "hanzi": "销售部在二楼。",
      "pinyin": "Xiāoshòu bù zài èr lóu.",
      "meaning": "Bộ phận bán hàng ở tầng hai.",
      "readingMinutes": 1
    },
    {
      "id": "l407-t4",
      "type": "teaching",
      "title": "出口 · lối ra",
      "text": "出口 ở đây là danh từ chỉ lối ra; không phải động từ xuất khẩu được xếp sang cấp khác.",
      "hanzi": "请从右边的出口离开。",
      "pinyin": "Qǐng cóng yòubian de chūkǒu líkāi.",
      "meaning": "Hãy ra bằng lối bên phải.",
      "readingMinutes": 1
    },
    {
      "id": "l407-t5",
      "type": "teaching",
      "title": "查找 · tra tìm",
      "text": "查找 nhấn quá trình tìm trong danh sách/tài liệu; không bảo đảm đã tìm được kết quả.",
      "hanzi": "我在名单里查找他的名字。",
      "pinyin": "Wǒ zài míngdān lǐ cházhǎo tā de míngzi.",
      "meaning": "Tôi tra tìm tên anh ấy trong danh sách.",
      "readingMinutes": 1
    },
    {
      "id": "l407-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "首先 nêu bước đầu, 然后 nêu bước tiếp theo. Mệnh lệnh theo lộ trình cần phân biệt 出口 với 入口, và 查找 là tìm thông tin chứ không nhất thiết đã tìm thấy.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l407-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小王出差时参观一家食品厂。接待员请他首先在一楼查找参观名单，然后去二楼销售部。参观结束后，大家从右边的出口离开。左边的门通向工作区，不能随便进去。",
      "pinyin": "Xiǎo Wáng chūchāi shí cānguān yì jiā shípǐn chǎng. Jiēdàiyuán qǐng tā shǒuxiān zài yì lóu cházhǎo cānguān míngdān, ránhòu qù èr lóu xiāoshòu bù. Cānguān jiéshù hòu, dàjiā cóng yòubian de chūkǒu líkāi. Zuǒbian de mén tōngxiàng gōngzuò qū, bù néng suíbiàn jìn qù.",
      "meaning": "Vương công tác rồi tham quan nhà máy. Trước hết tra danh sách ở tầng một, sau đó lên bộ phận bán hàng tầng hai. Kết thúc ra bên phải, không vào khu làm việc bên trái.",
      "readingMinutes": 2
    },
    {
