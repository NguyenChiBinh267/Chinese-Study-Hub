  "blocks": [
    {
      "id": "l4050-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t0",
      "type": "teaching",
      "title": "生 · sinh ra; tạo ra",
      "text": "生1 là động từ; 生 trong 熟能生巧 nghĩa là tạo ra.",
      "hanzi": "熟能生巧。",
      "pinyin": "Shú néng shēng qiǎo.",
      "meaning": "Luyện quen thì nảy khéo; luyện tập giúp thành thạo.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t1",
      "type": "teaching",
      "title": "生 · sống; chưa chín",
      "text": "生2 là tính từ; khác động từ 生 ở câu tục ngữ.",
      "hanzi": "这块肉还是生的。",
      "pinyin": "Zhè kuài ròu hái shì shēng de.",
      "meaning": "Miếng thịt này vẫn còn sống.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t2",
      "type": "teaching",
      "title": "剩 · còn lại; thừa lại",
      "text": "剩 nói phần còn sau khi dùng/làm, khác toàn bộ ban đầu. Nhận diện chữ 剩 trong 剩; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "桌上只剩一点儿材料。",
      "pinyin": "Zhuō shàng zhǐ shèng yì diǎnr cái liào.",
      "meaning": "Trên bàn chỉ còn chút nguyên liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t3",
      "type": "teaching",
      "title": "片 · lát; miếng mỏng",
      "text": "片 đếm miếng mỏng, khác 篇 đếm bài viết.",
      "hanzi": "请给我一片面包。",
      "pinyin": "Qǐng gěi wǒ yí piàn miàn bāo.",
      "meaning": "Cho tôi một lát bánh mì.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t4",
      "type": "teaching",
      "title": "苦 · đắng; vất vả",
      "text": "苦 chỉ vị đắng; 怕苦 dùng nghĩa bóng ngại vất vả.",
      "hanzi": "这杯茶有点儿苦。",
      "pinyin": "Zhè bēi chá yǒu diǎnr kǔ.",
      "meaning": "Cốc trà này hơi đắng.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-t5",
      "type": "teaching",
      "title": "随便 · tùy tiện; tùy ý",
      "text": "随便 trong câu phủ định là làm qua loa, không phải cho phép tự chọn.",
      "hanzi": "练习时不要随便应付。",
      "pinyin": "Liàn xí shí bú yào suí biàn yìng fu.",
      "meaning": "Khi luyện đừng làm qua loa.",
      "readingMinutes": 1
    },
    {
      "id": "l4050-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "无缘无故 nghĩa là không có lý do. Đặt trong lời nhắc không tự dưng thành thạo; câu tục ngữ cần được hiểu như lời khuyên luyện tập, không là bảo đảm mọi kết quả.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4050-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "烹饪课上，小安把生的菜切成一片一片，整理剩下的材料。老师说：“熟能生巧，意思是练熟了会更有技巧。不能随便应付，也不会无缘无故进步；练习要认真，不怕苦。”这里的两个“生”意思不同。",
      "pinyin": "Pēng rèn kè shàng, Xiǎo Ān bǎ shēng de cài qiē chéng yí piàn yí piàn, zhěng lǐ shèng xià de cái liào. Lǎo shī shuō: “Shú néng shēng qiǎo, yì si shì liàn shú le huì gèng yǒu jì qiǎo. Bù néng suí biàn yìng fu, yě bú huì wú yuán wú gù jìn bù; liàn xí yào rèn zhēn, bú pà kǔ.” Zhè lǐ de liǎng ge “shēng” yì si bù tóng.",
      "meaning": "Bài phân biệt 生 là tạo ra và chưa chín; giải thích tục ngữ như lời khuyên luyện nghiêm túc.",
      "readingMinutes": 2
    },
