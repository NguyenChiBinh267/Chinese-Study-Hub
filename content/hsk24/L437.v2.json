  "blocks": [
    {
      "id": "l437-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 紧张 jǐnzhāng: căng thẳng; 完美 wánměi: hoàn hảo; 愿意 yuànyì: sẵn lòng. 教师 jiàoshī: giáo viên; 活动 huódòng: hoạt động; từ hỗ trợ, chưa tính thêm vào 6 mục tiêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l437-t0",
      "type": "teaching",
      "title": "成功 · thành công",
      "text": "成功 nói kết quả đạt mục tiêu; chưa có kết quả thì không nói 已经成功了.",
      "hanzi": "这次活动很成功。",
      "pinyin": "Zhè cì huódòng hěn chénggōng.",
      "meaning": "Hoạt động lần này rất thành công.",
      "readingMinutes": 1
    },
    {
      "id": "l437-t1",
      "type": "teaching",
      "title": "成为 · trở thành",
      "text": "成为 nối chủ thể với vai trò hoặc trạng thái mới; sau nó không thêm 是.",
      "hanzi": "她想成为一名教师。",
      "pinyin": "Tā xiǎng chéngwéi yì míng jiàoshī.",
      "meaning": "Cô ấy muốn trở thành giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l437-t2",
      "type": "teaching",
      "title": "放弃 · từ bỏ",
      "text": "放弃 có thể đi với 机会 hoặc một việc đang theo đuổi; không phải nghỉ một lát.",
      "hanzi": "他没有放弃学习。",
      "pinyin": "Tā méiyǒu fàngqì xuéxí.",
      "meaning": "Anh ấy không từ bỏ việc học.",
      "readingMinutes": 1
    },
    {
      "id": "l437-t3",
      "type": "teaching",
      "title": "敢 · dám",
      "text": "敢 đứng trước động từ; ở đây nói vượt sự ngại ngùng khi hỏi. Nhận diện chữ 敢 trong 敢; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我现在敢问老师了。",
      "pinyin": "Wǒ xiànzài gǎn wèn lǎoshī le.",
      "meaning": "Bây giờ tôi đã dám hỏi thầy.",
      "readingMinutes": 1
    },
    {
      "id": "l437-t4",
      "type": "teaching",
      "title": "鼓励 · khích lệ",
      "text": "鼓励 ai làm gì dùng 鼓励 + người + động từ, không cần 让.",
      "hanzi": "朋友鼓励我再试一次。",
      "pinyin": "Péngyou gǔlì wǒ zài shì yí cì.",
      "meaning": "Bạn khích lệ tôi thử lại.",
      "readingMinutes": 1
    },
    {
      "id": "l437-t5",
      "type": "teaching",
      "title": "关键 · mấu chốt",
      "text": "关键 là yếu tố quyết định trong ngữ cảnh; không hứa một mẹo bảo đảm thành công.",
      "hanzi": "认真练习是关键。",
      "pinyin": "Rènzhēn liànxí shì guānjiàn.",
      "meaning": "Luyện tập nghiêm túc là mấu chốt.",
      "readingMinutes": 1
    },
    {
      "id": "l437-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "敢 + động từ chỉ đủ can đảm làm việc gì; 不敢 là chưa dám, không đồng nghĩa không biết làm. Ví dụ 我不敢问老师 → 我现在敢问老师了. Chưa đánh giá mức độ can đảm thật của người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l437-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林第一次讲中文时很紧张，差点儿放弃。朋友鼓励他说：“想成为教师，先要敢问问题。”他每天认真练习，第二次活动很成功。他觉得关键不是一次说得完美，而是愿意再试。",
      "pinyin": "Xiǎo Lín dì yī cì jiǎng Zhōngwén shí hěn jǐnzhāng, chàdiǎnr fàngqì. Péngyou gǔlì tā shuō: “Xiǎng chéngwéi jiàoshī, xiān yào gǎn wèn wèntí.” Tā měi tiān rènzhēn liànxí, dì èr cì huódòng hěn chénggōng. Tā juéde guānjiàn bú shì yí cì shuō de wánměi, ér shì yuànyì zài shì.",
      "meaning": "Lâm suýt bỏ cuộc vì căng thẳng khi nói tiếng Trung lần đầu. Bạn khích lệ cậu dám hỏi để hướng tới nghề giáo. Cậu luyện mỗi ngày, lần hai thành công; điều cậu rút ra là sẵn lòng thử lại, không phải nói hoàn hảo ngay.",
      "readingMinutes": 2
    },
