  "blocks": [
    {
      "id": "l197-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder0",
      "type": "teaching",
      "title": "读书 · đọc sách; đi học (tùy ngữ cảnh)",
      "text": "Nhắc nghĩa đã học: đọc sách; đi học (tùy ngữ cảnh). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我姐姐喜欢读书。",
      "pinyin": "Wǒ jiě jie xǐ huan dú shū.",
      "meaning": "Chị gái tôi thích đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder1",
      "type": "teaching",
      "title": "听 · nghe; lắng nghe",
      "text": "Nhắc nghĩa đã học: nghe; lắng nghe. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "请听我说汉语。",
      "pinyin": "Qǐng tīng wǒ shuō Hàn yǔ.",
      "meaning": "Xin nghe tôi nói tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder2",
      "type": "teaching",
      "title": "知道 · biết (thông tin)",
      "text": "Nhắc nghĩa đã học: biết (thông tin). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "他知道我住在哪儿。",
      "pinyin": "Tā zhī dào wǒ zhù zài nǎr.",
      "meaning": "Anh ấy biết tôi sống ở đâu.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder3",
      "type": "teaching",
      "title": "房间 · phòng; căn phòng",
      "text": "Nhắc nghĩa đã học: phòng; căn phòng. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的房间在这里。",
      "pinyin": "Wǒ de fáng jiān zài zhè lǐ.",
      "meaning": "Phòng của tôi ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder4",
      "type": "teaching",
      "title": "前 · trước; phía trước",
      "text": "Nhắc nghĩa đã học: trước; phía trước. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "猫在椅子前。",
      "pinyin": "Māo zài yǐ zi qián.",
      "meaning": "Mèo ở phía trước ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reminder5",
      "type": "teaching",
      "title": "后 · sau; phía sau",
      "text": "Nhắc nghĩa đã học: sau; phía sau. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我的书在桌子后。",
      "pinyin": "Wǒ de shū zài zhuō zi hòu.",
      "meaning": "Sách của tôi ở phía sau bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l197-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你知道老师在哪儿吗？\nB：在房间里。\nA：我能听见老师说话。\nB：我也能。",
      "pinyin": "A: Nǐ zhī dào lǎo shī zài nǎr ma? B: Zài fáng jiān lǐ. A: Wǒ néng tīng jiàn lǎo shī shuō huà. B: Wǒ yě néng.",
      "meaning": "B nói giáo viên ở trong phòng. Câu nghe được chỉ là lời nhân vật trong đoạn viết, không đánh giá nghe thật.",
      "readingMinutes": 2
    },
