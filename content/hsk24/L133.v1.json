  "blocks": [
    {
      "id": "l133-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l133-t0",
      "type": "teaching",
      "title": "回 · về; trở lại",
      "text": "回学校 là trở về trường; 回 không tự có nghĩa đã tới đích.",
      "hanzi": "我回学校。",
      "pinyin": "Wǒ huí xué xiào.",
      "meaning": "Tôi trở lại trường.",
      "readingMinutes": 1
    },
    {
      "id": "l133-t1",
      "type": "teaching",
      "title": "见 · gặp; thấy (theo ngữ cảnh)",
      "text": "见 trong 想见老师 là gặp giáo viên, không thay mọi hành động nhìn bằng mắt.",
      "hanzi": "我想见老师。",
      "pinyin": "Wǒ xiǎng jiàn lǎo shī.",
      "meaning": "Tôi muốn gặp giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l133-t2",
      "type": "teaching",
      "title": "找 · tìm",
      "text": "找 một vật/người là tìm; câu không tự chứng minh đã tìm thấy.",
      "hanzi": "我找我的书。",
      "pinyin": "Wǒ zhǎo wǒ de shū.",
      "meaning": "Tôi tìm sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l133-t3",
      "type": "teaching",
      "title": "怎么 · thế nào; bằng cách nào",
      "text": "怎么 trong câu hỏi cách viết tên, không phải hỏi tên là gì.",
      "hanzi": "你的名字怎么写？",
      "pinyin": "Nǐ de míng zi zěn me xiě?",
      "meaning": "Tên bạn viết thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l133-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "怎么 hỏi cách làm trong 你的名字怎么写？Không đồng nhất với 怎么样 hỏi đánh giá ở nhóm sau. 见 trong 想见老师 là muốn gặp giáo viên; 找 là tìm, chưa nói đã tìm được; 回 là trở về nơi đã được lấy làm mốc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l133-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你找谁？\nB：我找老师。我想见老师。\nA：老师在学校。\nB：好，我回学校。",
      "pinyin": "A: Nǐ zhǎo shéi? B: Wǒ zhǎo lǎo shī. Wǒ xiǎng jiàn lǎo shī. A: Lǎo shī zài xué xiào. B: Hǎo, wǒ huí xué xiào.",
      "meaning": "B tìm giáo viên và muốn gặp. B nói sẽ trở lại trường; đoạn không xác nhận đã gặp được.",
      "readingMinutes": 2
    },
    {
