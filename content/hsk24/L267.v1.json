  "blocks": [
    {
      "id": "l267-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "我/你 chỉ người; 不要 là đừng. Các câu về đau chỉ luyện ngôn ngữ, không phải chẩn đoán hay chỉ định điều trị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t0",
      "type": "teaching",
      "title": "Nhắc lại · 头 · đầu, bộ phận cơ thể",
      "text": "头 ở đây là danh từ đầu. Không dạy nghĩa lượng từ đếm động vật hoặc nghĩa tính từ ở cấp khác.",
      "hanzi": "我的头有点儿疼。",
      "pinyin": "Wǒ de tóu yǒudiǎnr téng.",
      "meaning": "Đầu tôi hơi đau.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t1",
      "type": "teaching",
      "title": "Nhắc lại · 手 · tay",
      "text": "手 chỉ bàn tay trong 洗手. Đừng nhầm với 首 dù cùng cách đọc trong một số ngữ cảnh khác.",
      "hanzi": "请洗手再吃饭。",
      "pinyin": "Qǐng xǐ shǒu zài chī fàn.",
      "meaning": "Hãy rửa tay rồi ăn cơm.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t2",
      "type": "teaching",
      "title": "Nhắc lại · 眼睛 · mắt",
      "text": "睛 đọc nhẹ trong 眼睛. Không phải mọi bộ phận nhìn thấy trên mặt đều gọi là 眼睛.",
      "hanzi": "我的眼睛有点儿累。",
      "pinyin": "Wǒ de yǎnjing yǒudiǎnr lèi.",
      "meaning": "Mắt tôi hơi mỏi.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t3",
      "type": "teaching",
      "title": "Nhắc lại · 洗 · rửa, giặt",
      "text": "洗 kết hợp với đối tượng: 洗手 rửa tay, 洗衣服 giặt quần áo. Không có một nghĩa tiếng Việt duy nhất cho mọi vật.",
      "hanzi": "妈妈在洗衣服。",
      "pinyin": "Māma zài xǐ yīfu.",
      "meaning": "Mẹ đang giặt quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t4",
      "type": "teaching",
      "title": "Nhắc lại · 洗手间 · nhà vệ sinh",
      "text": "洗手间 là cách gọi nhà vệ sinh lịch sự, không chỉ riêng chiếc bồn rửa tay. Pinyin từ điển giữ hai thanh ba ở xǐ/shǒu.",
      "hanzi": "洗手间在那边。",
      "pinyin": "Xǐshǒujiān zài nàbian.",
      "meaning": "Nhà vệ sinh ở bên kia.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-t5",
      "type": "teaching",
      "title": "Nhắc lại · 动 · cử động, di chuyển",
      "text": "动 trong 动一动 là cử động một chút. Không dùng nó làm tên một môn thể thao cụ thể.",
      "hanzi": "坐了很久，起来动一动吧。",
      "pinyin": "Zuò le hěn jiǔ, qǐlái dòng yi dòng ba.",
      "meaning": "Ngồi lâu rồi, đứng dậy cử động một chút nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l267-t0-l227-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "去洗手间洗手 nối nơi đi với hoạt động cùng người làm. Không thêm một chủ ngữ mới giữa 去 và 洗手.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l267-t0-l227-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的眼睛怎么了？乙：看书看得有点儿累。甲：我们去洗手间洗手，然后吃饭吧。乙：好，我也想起来动一动。",
      "pinyin": "Jiǎ: Nǐ de yǎnjing zěnme le? Yǐ: Kàn shū kàn de yǒudiǎnr lèi. Jiǎ: Wǒmen qù xǐshǒujiān xǐ shǒu, ránhòu chī fàn ba. Yǐ: Hǎo, wǒ yě xiǎng qǐlái dòng yi dòng.",
      "meaning": "A: Mắt bạn sao vậy? B: Đọc sách hơi mỏi. A: Chúng ta đến nhà vệ sinh rửa tay rồi ăn cơm nhé. B: Được, tôi cũng muốn đứng dậy cử động một chút.",
      "readingMinutes": 2
    },
