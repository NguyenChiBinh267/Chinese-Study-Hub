  "blocks": [
    {
      "id": "l469-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 实现 shíxiàn: thực hiện; 开设 kāishè: mở môn/lớp; 醒 xǐng: tỉnh giấc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l469-t0",
      "type": "teaching",
      "title": "理想 · lý tưởng",
      "text": "理想 là mục tiêu hướng đến; còn có tính từ lý tưởng/tốt như mong đợi, bài dùng danh từ.",
      "hanzi": "她的理想是成为教师。",
      "pinyin": "Tā de lǐxiǎng shì chéngwéi jiàoshī.",
      "meaning": "Lý tưởng của cô là trở thành giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l469-t1",
      "type": "teaching",
      "title": "梦 · giấc mơ",
      "text": "梦 trong 做梦 là giấc mơ khi ngủ; có thể ẩn dụ nhưng bài hỏi nghĩa ngủ. Nhận diện chữ 梦 trong 梦; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "昨晚我做了一个梦。",
      "pinyin": "Zuówǎn wǒ zuò le yí ge mèng.",
      "meaning": "Tối qua tôi có một giấc mơ.",
      "readingMinutes": 1
    },
    {
      "id": "l469-t2",
      "type": "teaching",
      "title": "梦想 · ước mơ",
      "text": "梦想 nói điều mong đạt trong đời, khác giấc mơ ngủ 梦 trong phạm vi bài.",
      "hanzi": "她想实现自己的梦想。",
      "pinyin": "Tā xiǎng shíxiàn zìjǐ de mèngxiǎng.",
      "meaning": "Cô muốn thực hiện ước mơ.",
      "readingMinutes": 1
    },
    {
      "id": "l469-t3",
      "type": "teaching",
      "title": "将来 · tương lai",
      "text": "将来 nói thời gian tương lai, có thể ở đầu câu hoặc làm danh từ.",
      "hanzi": "将来我想住在家乡。",
      "pinyin": "Jiānglái wǒ xiǎng zhù zài jiāxiāng.",
      "meaning": "Tương lai tôi muốn sống ở quê.",
      "readingMinutes": 1
    },
    {
      "id": "l469-t4",
      "type": "teaching",
      "title": "将 · sẽ",
      "text": "将 ở đây là phó từ thời gian, không đọc jiàng của nghĩa tướng.",
      "hanzi": "学校将开设新课程。",
      "pinyin": "Xuéxiào jiāng kāishè xīn kèchéng.",
      "meaning": "Trường sẽ mở môn mới.",
      "readingMinutes": 1
    },
    {
      "id": "l469-t5",
      "type": "teaching",
      "title": "将要 · sắp, sẽ",
      "text": "将要 gần 将, nhấn mạnh việc sắp đến trong câu thông báo; chưa xác nhận đã xảy ra.",
      "hanzi": "她将要参加第一次面试。",
      "pinyin": "Tā jiāngyào cānjiā dì yī cì miànshì.",
      "meaning": "Cô sắp dự lần phỏng vấn đầu.",
      "readingMinutes": 1
    },
    {
      "id": "l469-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "将/将要 + động từ chỉ việc sắp hoặc sẽ xảy ra, hơi trang trọng. 将来 là danh từ/thành phần thời gian về tương lai, không trực tiếp thay 将 trong mọi vị trí. Bài tách kế hoạch dự định khỏi kết quả đã đạt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l469-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小月小时候的理想是成为教师。昨晚她做了一个梦，梦见自己在课堂上讲故事。醒来以后，她仍然知道梦想需要一步步准备。学校将开设新课程，她将要参加面试。她说：“将来我希望把学到的方法带回家乡。”",
      "pinyin": "Xiǎo Yuè xiǎoshíhou de lǐxiǎng shì chéngwéi jiàoshī. Zuówǎn tā zuò le yí ge mèng, mèngjiàn zìjǐ zài kètáng shàng jiǎng gùshi. Xǐng lái yǐhòu, tā réngrán zhīdào mèngxiǎng xūyào yí bù bù zhǔnbèi. Xuéxiào jiāng kāishè xīn kèchéng, tā jiāngyào cānjiā miànshì. Tā shuō: “Jiānglái wǒ xīwàng bǎ xué dào de fāngfǎ dài huí jiāxiāng.”",
      "meaning": "Nguyệt mơ ngủ mình dạy học, nhưng biết ước mơ nghề giáo cần chuẩn bị từng bước. Trường sẽ mở môn mới và cô sắp phỏng vấn. Cô mong sau này đem phương pháp về quê.",
      "readingMinutes": 2
    },
    {
      "id": "l469-b0",
      "type": "exercise",
      "exerciseVersionId": "l469-v1-e0"
