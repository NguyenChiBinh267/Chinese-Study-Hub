  "blocks": [
    {
      "id": "l222-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "在 là ở; 桌子 là bàn. 一间房间 đếm phòng bằng 间; từ hỗ trợ 房间 chỉ căn phòng và chưa được tính thêm vào mục tiêu. 关 (guān, đóng) là SUPPLEMENTARY thuộc HSK3, chỉ giúp hiểu lời nhờ đóng cửa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l222-t0",
      "type": "teaching",
      "title": "床 · giường",
      "text": "床 là đồ dùng để nằm ngủ; không phải mọi mặt phẳng kê đồ.",
      "hanzi": "我的床旁边有一张桌子。",
      "pinyin": "Wǒ de chuáng pángbiān yǒu yì zhāng zhuōzi.",
      "meaning": "Bên giường tôi có một cái bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l222-t1",
      "type": "teaching",
      "title": "门 · cửa",
      "text": "门 là cửa; 门口 là khu vực chỗ cửa. 请关门 là đóng cửa, không yêu cầu ai đứng ở cửa.",
      "hanzi": "外面冷，请关门。",
      "pinyin": "Wàimiàn lěng, qǐng guān mén.",
      "meaning": "Ngoài lạnh, hãy đóng cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l222-t2",
      "type": "teaching",
      "title": "楼 · tòa nhà hoặc tầng trong cách nói số tầng",
      "text": "这里有一座楼 nói một tòa nhà; 二楼 là tầng hai. Bài này luyện số tầng trong 二楼.",
      "hanzi": "我的教室在二楼。",
      "pinyin": "Wǒ de jiàoshì zài èr lóu.",
      "meaning": "Phòng học của tôi ở tầng hai.",
      "readingMinutes": 1
    },
    {
      "id": "l222-t3",
      "type": "teaching",
      "title": "间 · lượng từ cho phòng",
      "text": "Ở 一间教室, 间 đọc jiān và là lượng từ. Không mở rộng sang nghĩa danh từ cấp cao hơn.",
      "hanzi": "二楼有一间教室。",
      "pinyin": "Èr lóu yǒu yì jiān jiàoshì.",
      "meaning": "Tầng hai có một phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l222-t4",
      "type": "teaching",
      "title": "上面 · phía trên",
      "text": "上面 có thể nói phía trên một mốc; trong 桌子上面 câu này là trên mặt bàn.",
      "hanzi": "书在桌子上面。",
      "pinyin": "Shū zài zhuōzi shàngmiàn.",
      "meaning": "Sách ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l222-t5",
      "type": "teaching",
      "title": "下面 · phía dưới",
      "text": "下面 ở đây là vị trí không gian phía dưới; không dùng để suy ra thứ tự bài tiếp theo.",
      "hanzi": "书包在桌子下面。",
      "pinyin": "Shūbāo zài zhuōzi xiàmiàn.",
      "meaning": "Cặp ở dưới bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l222-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "面 tạo từ vị trí trong 上面/下面. Nêu mốc rõ: 桌子下面; không suy ra vật ở bên trong bàn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l222-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的书包呢？乙：在桌子下面。甲：书也在下面吗？乙：不，书在桌子上面。我的房间在二楼。",
      "pinyin": "Jiǎ: Nǐ de shūbāo ne? Yǐ: Zài zhuōzi xiàmiàn. Jiǎ: Shū yě zài xiàmiàn ma? Yǐ: Bù, shū zài zhuōzi shàngmiàn. Wǒ de fángjiān zài èr lóu.",
      "meaning": "A: Cặp bạn đâu? B: Dưới bàn. A: Sách cũng ở dưới à? B: Không, sách ở trên bàn. Phòng tôi ở tầng hai.",
      "readingMinutes": 2
    },
