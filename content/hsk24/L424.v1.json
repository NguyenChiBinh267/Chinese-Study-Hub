  "blocks": [
    {
      "id": "l424-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 支持 zhīchí: ủng hộ; 修 xiū: sửa; 回忆 huíyì: ký ức; 温暖 wēnnuǎn: ấm áp; 责任感 zérèngǎn: ý thức trách nhiệm; 后缀 hòuzhuì: hậu tố.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l424-t0",
      "type": "teaching",
      "title": "父母 · cha mẹ",
      "text": "父母 gọi chung cha và mẹ, không phải hình thái số nhiều dùng cho mọi thân nhân. Nhận diện chữ 父 trong 父母; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "父母支持她继续学习。",
      "pinyin": "Fùmǔ zhīchí tā jìxù xuéxí.",
      "meaning": "Cha mẹ ủng hộ cô ấy tiếp tục học.",
      "readingMinutes": 1
    },
    {
      "id": "l424-t1",
      "type": "teaching",
      "title": "父亲 · cha, bố (trang trọng)",
      "text": "父亲 là cách gọi cha có sắc thái trang trọng hơn 爸爸 trong nhiều ngữ cảnh.",
      "hanzi": "父亲给我讲了小时候的事。",
      "pinyin": "Fùqīn gěi wǒ jiǎng le xiǎoshíhou de shì.",
      "meaning": "Cha kể tôi nghe chuyện hồi nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l424-t2",
      "type": "teaching",
      "title": "父女 · cha và con gái",
      "text": "父女 là quan hệ/cặp cha–con gái; không dùng khi cặp là cha–con trai.",
      "hanzi": "照片里的父女正在散步。",
      "pinyin": "Zhàopiàn lǐ de fùnǚ zhèngzài sànbù.",
      "meaning": "Cha và con gái trong ảnh đang đi dạo.",
      "readingMinutes": 1
    },
    {
      "id": "l424-t3",
      "type": "teaching",
      "title": "父子 · cha và con trai",
      "text": "父子 chỉ cặp cha–con trai; đây là một từ quan hệ, không phải mọi người đàn ông trong ảnh.",
      "hanzi": "那对父子一起修好了桌子。",
      "pinyin": "Nà duì fùzǐ yìqǐ xiū hǎo le zhuōzi.",
      "meaning": "Hai cha con ấy cùng sửa xong chiếc bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l424-t4",
      "type": "teaching",
      "title": "抱 · ôm, bế",
      "text": "抱 là giữ/ôm bằng tay, ở đây là ôm người; khác 背 bēi là cõng/mang trên lưng.",
      "hanzi": "孩子抱住了父亲。",
      "pinyin": "Háizi bào zhù le fùqīn.",
      "meaning": "Đứa trẻ ôm lấy cha.",
      "readingMinutes": 1
    },
    {
      "id": "l424-t5",
      "type": "teaching",
      "title": "感情 · tình cảm",
      "text": "感情 bao quát cảm xúc/quan hệ tình cảm giữa người; ý nghĩa cụ thể do ngữ cảnh, không nhất thiết là tình yêu.",
      "hanzi": "多年的合作加深了他们的感情。",
      "pinyin": "Duō nián de hézuò jiāshēn le tāmen de gǎnqíng.",
      "meaning": "Nhiều năm hợp tác làm tình cảm giữa họ sâu hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l424-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "让+người+động từ chỉ tác động khiến người đó làm/cảm thấy gì: 这段回忆让父亲想起家乡. Không nhầm với 被动句 khi chủ thể chịu một hành động do người khác gây ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l424-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "父亲拿出两张旧照片：一张是父女散步，另一张是父子一起修桌子。孩子听完故事抱住了他。父母说，这段回忆让父亲想起家乡，也让孩子感到家庭的温暖。家人的感情更深了。",
      "pinyin": "Fùqīn ná chū liǎng zhāng jiù zhàopiàn: Yì zhāng shì fùnǚ sànbù, lìng yì zhāng shì fùzǐ yìqǐ xiū zhuōzi. Háizi tīng wán gùshi bào zhù le tā. Fùmǔ shuō, zhè duàn huíyì ràng fùqīn xiǎngqǐ jiāxiāng, yě ràng háizi gǎndào jiātíng de wēnnuǎn. Jiārén de gǎnqíng gèng shēn le.",
      "meaning": "Cha cho xem ảnh cha–con gái đi dạo và cha–con trai sửa bàn. Chuyện gợi nhớ quê và cảm giác gia đình ấm áp. Tình cảm gia đình thêm sâu sắc.",
      "readingMinutes": 2
    },
    {
