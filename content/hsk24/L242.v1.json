  "blocks": [
    {
      "id": "l242-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l242-t0-l202-t0",
      "type": "teaching",
      "title": "Nhắc lại · Phương tiện và điểm đến",
      "text": "车站 là ga/trạm xe, cần đọc ngữ cảnh để biết loại trạm. 地铁 là tàu điện ngầm; 公交车 là xe buýt công cộng. Nói 坐地铁, 坐公交车. 打车 tự mang nghĩa bắt taxi/gọi xe; không hiểu thành ‘đánh xe’.",
      "hanzi": "我们坐地铁去车站。他打车去。",
      "pinyin": "Wǒmen zuò dìtiě qù chēzhàn. Tā dǎchē qù.",
      "meaning": "Chúng tôi đi tàu điện ngầm đến ga. Anh ấy đi bằng taxi/xe gọi.",
      "readingMinutes": 3
    },
    {
      "id": "l242-t0-l202-t1",
      "type": "teaching",
      "title": "Nhắc lại · Hỏi chọn một phương án",
      "text": "Dùng 还是 để đưa hai phương án trong câu hỏi. 你坐地铁还是坐公交车？ hỏi người nghe chọn cách nào; trả lời trực tiếp một phương án. Không cần thêm 吗 ở cuối câu hỏi lựa chọn này. Bài chỉ dạy 还是 trong câu hỏi lựa chọn, không dạy mọi nghĩa của từ.",
      "hanzi": "你坐地铁还是坐公交车？我坐地铁。",
      "pinyin": "Nǐ zuò dìtiě háishi zuò gōngjiāochē? Wǒ zuò dìtiě.",
      "meaning": "Bạn đi tàu điện ngầm hay xe buýt? Tôi đi tàu điện ngầm.",
      "readingMinutes": 3
    },
    {
      "id": "l242-t0-l202-t2",
      "type": "teaching",
      "title": "Nhắc lại · Đọc tin nhắn hẹn đi",
      "text": "Chú ý phân biệt kế hoạch của người nói và người được nhắc tới. Hai người chọn tàu điện ngầm, còn anh trai đi bằng taxi/xe gọi. Đoạn văn không cung cấp giá vé hay thời gian đến.",
      "hanzi": "甲：我们怎么去车站？坐地铁还是坐公交车？乙：坐地铁吧。甲：好。我哥哥打车去。",
      "pinyin": "Jiǎ: Wǒmen zěnme qù chēzhàn? Zuò dìtiě háishi zuò gōngjiāochē? Yǐ: Zuò dìtiě ba. Jiǎ: Hǎo. Wǒ gēge dǎchē qù.",
      "meaning": "A: Chúng ta đến ga thế nào? Tàu điện ngầm hay xe buýt? B: Đi tàu điện ngầm nhé. A: Được. Anh trai tôi đi taxi/xe gọi.",
      "readingMinutes": 3
    },
