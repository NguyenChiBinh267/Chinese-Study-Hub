  "blocks": [
    {
      "id": "l4055-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t0",
      "type": "teaching",
      "title": "证 · giấy chứng nhận; thẻ chứng nhận",
      "text": "证 là cách gọi gọn một giấy/thẻ chứng nhận trong bối cảnh.",
      "hanzi": "他的证放在包里。",
      "pinyin": "Tā de zhèng fàng zài bāo lǐ.",
      "meaning": "Thẻ chứng nhận của anh ấy ở trong túi.",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t1",
      "type": "teaching",
      "title": "证明 · chứng minh",
      "text": "证明 ở đây là động từ đưa bằng chứng, không phải mọi ý kiến cá nhân.",
      "hanzi": "这些材料能证明什么？",
      "pinyin": "Zhè xiē cái liào néng zhèng míng shén me?",
      "meaning": "Những tư liệu này chứng minh được gì?",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t2",
      "type": "teaching",
      "title": "正确 · đúng; chính xác",
      "text": "正确 tả sự đúng của nội dung/cách làm, không chỉ hình thức đẹp.",
      "hanzi": "答案不一定都正确。",
      "pinyin": "Dá àn bù yí dìng dōu zhèng què.",
      "meaning": "Đáp án chưa chắc đều đúng.",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t3",
      "type": "teaching",
      "title": "正式 · chính thức",
      "text": "正式 nói trạng thái chính thức, không tự đồng nghĩa nội dung đúng. Nhận diện chữ 式 trong 正式; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "展览明天正式开始。",
      "pinyin": "Zhǎn lǎn míng tiān zhèng shì kāi shǐ.",
      "meaning": "Triển lãm chính thức bắt đầu ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t4",
      "type": "teaching",
      "title": "真正 · thật sự; đúng nghĩa",
      "text": "真正 nhấn đúng bản chất, không chỉ có vẻ giống.",
      "hanzi": "我们想了解真正的原因。",
      "pinyin": "Wǒ men xiǎng liǎo jiě zhēn zhèng de yuán yīn.",
      "meaning": "Chúng tôi muốn hiểu nguyên nhân thực sự.",
      "readingMinutes": 1
    },
    {
      "id": "l4055-t5",
      "type": "teaching",
      "title": "著名 · nổi tiếng",
      "text": "著名 tả được nhiều người biết, không chứng nhận mọi phát biểu.",
      "hanzi": "展览介绍一位著名画家。",
      "pinyin": "Zhǎn lǎn jiè shào yí wèi zhù míng huà jiā.",
      "meaning": "Triển lãm giới thiệu một họa sĩ nổi tiếng.",
      "readingMinutes": 1
    },
    {
      "id": "l4055-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 giới hạn điều một chứng nhận có thể chứng minh. Không suy nội dung đúng chỉ vì văn bản có hình thức trang trọng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4055-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "虚构的展览明天正式开始，介绍一位著名画家。小林核对讲解员的证，也检查说明是否正确。负责人说：“证能证明参加过培训，不过不能证明每句话都对。我们还要查清真正的资料来源。”",
      "pinyin": "Xū gòu de zhǎn lǎn míng tiān zhèng shì kāi shǐ, jiè shào yí wèi zhù míng huà jiā. Xiǎo Lín hé duì jiǎng jiě yuán de zhèng, yě jiǎn chá shuō míng shì fǒu zhèng què. Fù zé rén shuō: “Zhèng néng zhèng míng cān jiā guo péi xùn, bú guò bù néng zhèng míng měi jù huà dōu duì. Wǒ men hái yào chá qīng zhēn zhèng de zī liào lái yuán.”",
      "meaning": "Nhóm xem cả chứng nhận lẫn nguồn tư liệu trước khi trình bày triển lãm hư cấu.",
      "readingMinutes": 2
    },
    {
