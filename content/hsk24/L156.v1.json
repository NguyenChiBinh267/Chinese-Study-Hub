  "blocks": [
    {
      "id": "l156-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l156-t0",
      "type": "teaching",
      "title": "水果 · trái cây; hoa quả",
      "text": "水果 là tên nhóm, không phải tên riêng một quả nhất định.",
      "hanzi": "我喜欢水果。",
      "pinyin": "Wǒ xǐ huan shuǐ guǒ.",
      "meaning": "Tôi thích trái cây.",
      "readingMinutes": 1
    },
    {
      "id": "l156-t1",
      "type": "teaching",
      "title": "苹果 · táo",
      "text": "苹果 là một loại trái cây; lượng từ 个 được dùng trong ví dụ đếm này.",
      "hanzi": "我有一个苹果。",
      "pinyin": "Wǒ yǒu yí ge píng guǒ.",
      "meaning": "Tôi có một quả táo.",
      "readingMinutes": 1
    },
    {
      "id": "l156-t2",
      "type": "teaching",
      "title": "面包 · bánh mì",
      "text": "面包 là bánh mì, không phải 面条儿 mì sợi dù cùng có chữ 面.",
      "hanzi": "我吃面包。",
      "pinyin": "Wǒ chī miàn bāo.",
      "meaning": "Tôi ăn bánh mì.",
      "readingMinutes": 1
    },
    {
      "id": "l156-t3",
      "type": "teaching",
      "title": "鸡蛋 · trứng gà",
      "text": "鸡蛋 nói trứng gà; câu này đếm quả trứng bằng 个.",
      "hanzi": "我有三个鸡蛋。",
      "pinyin": "Wǒ yǒu sān ge jī dàn.",
      "meaning": "Tôi có ba quả trứng gà.",
      "readingMinutes": 1
    },
    {
      "id": "l156-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Số + lượng từ + danh từ tạo cụm số lượng như 一个苹果/三个鸡蛋. 水果 là loại thực phẩm, 苹果 là một loại quả; 面包 và 鸡蛋 không tự thuộc nhóm trái cây. Ví dụ không yêu cầu suy dinh dưỡng hoặc nhận món từ ảnh không có.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l156-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你喜欢水果吗？\nB：喜欢，我喜欢苹果。\nA：你有几个苹果？\nB：我有三个苹果。",
      "pinyin": "A: Nǐ xǐ huan shuǐ guǒ ma? B: Xǐ huan, wǒ xǐ huan píng guǒ. A: Nǐ yǒu jǐ ge píng guǒ? B: Wǒ yǒu sān ge píng guǒ.",
      "meaning": "几个 jǐ ge = mấy cái/quả trong câu hỏi đếm. B có ba quả táo và thích táo; không suy số trứng hay bánh mì của B.",
      "readingMinutes": 2
    },
