  "blocks": [
    {
      "id": "l451-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 重视 zhòngshì: coi trọng; 情景 qíngjǐng: tình huống; 提出 tíchū: nêu ra. Hoạt động nói được kể trong đoạn, hệ thống không đo nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l451-t0",
      "type": "teaching",
      "title": "教师 · giáo viên",
      "text": "教师 chỉ nghề/vai trò giảng dạy, hơi trang trọng hơn 老师.",
      "hanzi": "她是一名中文教师。",
      "pinyin": "Tā shì yì míng Zhōngwén jiàoshī.",
      "meaning": "Cô ấy là giáo viên tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l451-t1",
      "type": "teaching",
      "title": "教授 · giáo sư",
      "text": "教授 trong bài là chức danh/người giảng đại học; không mặc định mọi giáo viên đều có chức danh này. Nhận diện chữ 授 trong 教授; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这位教授介绍了课程。",
      "pinyin": "Zhè wèi jiàoshòu jièshào le kèchéng.",
      "meaning": "Vị giáo sư giới thiệu môn học.",
      "readingMinutes": 1
    },
    {
      "id": "l451-t2",
      "type": "teaching",
      "title": "教学 · giảng dạy",
      "text": "教学 đọc jiào xué, chỉ hoạt động dạy và học; khác 教师 là người.",
      "hanzi": "学校重视口语教学。",
      "pinyin": "Xuéxiào zhòngshì kǒuyǔ jiàoxué.",
      "meaning": "Trường coi trọng giảng dạy khẩu ngữ.",
      "readingMinutes": 1
    },
    {
      "id": "l451-t3",
      "type": "teaching",
      "title": "课程 · môn học, khóa học",
      "text": "课程 nói nội dung học có cấu trúc; không đồng nghĩa một buổi 课.",
      "hanzi": "这门课程每周上两次。",
      "pinyin": "Zhè mén kèchéng měi zhōu shàng liǎng cì.",
      "meaning": "Môn này học hai buổi mỗi tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l451-t4",
      "type": "teaching",
      "title": "课堂 · lớp học, giờ học",
      "text": "课堂 ở 在课堂上 chỉ bối cảnh buổi học; không phải luôn chỉ căn phòng.",
      "hanzi": "学生在课堂上提问。",
      "pinyin": "Xuésheng zài kètáng shàng tíwèn.",
      "meaning": "Học sinh đặt câu hỏi trong giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l451-t5",
      "type": "teaching",
      "title": "口语 · khẩu ngữ",
      "text": "口语 là ngôn ngữ nói; bài đọc này chỉ giới thiệu, không chấm kỹ năng nói.",
      "hanzi": "我想提高中文口语。",
      "pinyin": "Wǒ xiǎng tígāo Zhōngwén kǒuyǔ.",
      "meaning": "Tôi muốn nâng khẩu ngữ tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l451-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一方面……另一方面…… trình bày hai mặt cùng tồn tại; không phải trình tự thời gian như 首先/其次. Ví dụ 课程一方面重视阅读，另一方面安排口语练习. Cả hai đều là thành phần khóa học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l451-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "新教师向教授了解课程安排。教授说：“这门课程一方面重视阅读，另一方面安排口语练习。课堂上让学生两人一组，先看情景，再交流。”教师记下教学方法，也准备让学生课后提出意见。",
      "pinyin": "Xīn jiàoshī xiàng jiàoshòu liǎojiě kèchéng ānpái. Jiàoshòu shuō: “Zhè mén kèchéng yì fāngmiàn zhòngshì yuèdú, lìng yì fāngmiàn ānpái kǒuyǔ liànxí. Kètáng shàng ràng xuésheng liǎng rén yì zǔ, xiān kàn qíngjǐng, zài jiāoliú.” Jiàoshī jì xià jiàoxué fāngfǎ, yě zhǔnbèi ràng xuésheng kè hòu tíchū yìjiàn.",
      "meaning": "Giáo viên mới hỏi giáo sư về môn học gồm đọc và luyện nói. Học sinh làm theo đôi, xem tình huống rồi trao đổi. Giáo viên ghi phương pháp và sẽ nhận góp ý sau giờ.",
      "readingMinutes": 2
    },
