  "blocks": [
    {
      "id": "l347-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 语境 yǔjìng: ngữ cảnh; 逐日 zhú rì: từng ngày; 统计 tǒngjì: thống kê; 次数 cìshù: số lần. Một lần làm không xác nhận thói quen.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l347-t0",
      "type": "teaching",
      "title": "常 · thường/hay",
      "text": "常 thường đứng trước động từ: 常看书. Không đặt 很常 thay cho 很常见; từ đơn và từ ghép khác kết cấu.",
      "hanzi": "她常看中文书。",
      "pinyin": "Tā cháng kàn Zhōngwén shū.",
      "meaning": "Cô ấy thường đọc sách tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l347-t1",
      "type": "teaching",
      "title": "常见 · thường thấy/phổ biến",
      "text": "常见 đánh giá thứ thường gặp, không tự là đúng hay nên làm. 常见的错误 vẫn là lỗi.",
      "hanzi": "这是一个常见的问题。",
      "pinyin": "Zhè shì yí ge chángjiàn de wèntí.",
      "meaning": "Đây là một vấn đề thường gặp.",
      "readingMinutes": 1
    },
    {
      "id": "l347-t2",
      "type": "teaching",
      "title": "常用 · thường dùng",
      "text": "常用 chỉ thường được dùng; 常用词 là từ hay dùng, không phải mọi từ đều thuộc cấp HSK nào chỉ vì quen thuộc.",
      "hanzi": "这些是常用的词。",
      "pinyin": "Zhèxiē shì chángyòng de cí.",
      "meaning": "Đây là những từ thường dùng.",
      "readingMinutes": 1
    },
    {
      "id": "l347-t3",
      "type": "teaching",
      "title": "常常 · thường xuyên",
      "text": "常常 gần nghĩa 常, thường trước động từ; chưa nói số lần chính xác. Đề phân biệt hai cách bằng yêu cầu đúng mục từ hai âm tiết.",
      "hanzi": "他常常在这里练习。",
      "pinyin": "Tā chángcháng zài zhèlǐ liànxí.",
      "meaning": "Cậu ấy thường luyện ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l347-t4",
      "type": "teaching",
      "title": "总 · luôn/cứ (phó từ ở bài)",
      "text": "总 ở trước động từ diễn tả sự lặp thường xuyên trong lời nhận xét. 总 số tổng hay đứng đầu/chung là nghĩa khác chưa được dạy ở đây.",
      "hanzi": "他总忘记带笔。",
      "pinyin": "Tā zǒng wàngjì dài bǐ.",
      "meaning": "Cậu ấy cứ quên mang bút.",
      "readingMinutes": 1
    },
    {
      "id": "l347-t5",
      "type": "teaching",
      "title": "总是 · luôn luôn/cứ thường",
      "text": "总是 diễn tả sự lặp theo cách khái quát; không phải cấu trúc 总 + động từ 是 “là” trong mọi câu. 说总是不等于统计验证.",
      "hanzi": "她总是先检查作业。",
      "pinyin": "Tā zǒngshì xiān jiǎnchá zuòyè.",
      "meaning": "Cô ấy luôn kiểm tra bài tập trước.",
      "readingMinutes": 1
    },
    {
      "id": "l347-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "常常、总是 thường đứng trước động từ: 他常常练习. 总是 biểu thị đều/thường xuyên theo khái quát của người nói, mạnh hơn 常常 nhưng không là số đo thống kê chính xác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l347-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林常看中文书，常常把常用的词记在本子上。老师说这些词很常见，但还是要看语境。他总忘记带笔，姐姐总是提醒他。这里的总、总是是人物的日常说法，不是逐日统计。",
      "pinyin": "Xiǎo Lín cháng kàn Zhōngwén shū, chángcháng bǎ chángyòng de cí jì zài běnzi shàng. Lǎoshī shuō zhèxiē cí hěn chángjiàn, dàn háishi yào kàn yǔjìng. Tā zǒng wàngjì dài bǐ, jiějie zǒngshì tíxǐng tā. Zhèlǐ de zǒng, zǒngshì shì rénwù de rìcháng shuōfǎ, bú shì zhú rì tǒngjì.",
      "meaning": "Lâm thường đọc và ghi từ hay dùng. Thầy nhắc phải xem ngữ cảnh. Cậu hay quên bút, chị hay nhắc; đó là lời khái quát hằng ngày, không phải thống kê từng ngày.",
      "readingMinutes": 2
    },
    {
      "id": "l347-b0",
      "type": "exercise",
      "exerciseVersionId": "l347-v1-e0"
    },
