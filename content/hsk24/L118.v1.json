  "blocks": [
    {
      "id": "l118-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l118-t0",
      "type": "teaching",
      "title": "学生 · học sinh; sinh viên",
      "text": "学生 là người học; không suy cấp học cụ thể nếu câu chưa nói.",
      "hanzi": "我是学生。",
      "pinyin": "Wǒ shì xué shēng.",
      "meaning": "Tôi là học sinh/sinh viên.",
      "readingMinutes": 1
    },
    {
      "id": "l118-t1",
      "type": "teaching",
      "title": "老师 · giáo viên; thầy/cô",
      "text": "老师 dùng cho giáo viên, không phân biệt giới tính trong chữ này.",
      "hanzi": "她是我的老师。",
      "pinyin": "Tā shì wǒ de lǎo shī.",
      "meaning": "Cô ấy là giáo viên của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l118-t2",
      "type": "teaching",
      "title": "同学 · bạn học",
      "text": "同学 nói quan hệ học cùng; không tự có nghĩa người yêu hay anh chị em.",
      "hanzi": "他是我的同学。",
      "pinyin": "Tā shì wǒ de tóng xué.",
      "meaning": "Anh ấy là bạn học của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l118-t3",
      "type": "teaching",
      "title": "学校 · trường học",
      "text": "学校 là trường, không phải từ chỉ riêng giáo viên hoặc môn học.",
      "hanzi": "这是我们的学校。",
      "pinyin": "Zhè shì wǒ men de xué xiào.",
      "meaning": "Đây là trường của chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l118-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "是 + danh từ giới thiệu vai trò: 我是学生。老师 và 学生 là giáo viên và người học; 同学 chỉ người học cùng trường/lớp theo tình huống, không tự đồng nghĩa bạn thân. 这/那 có thể làm chủ thể để giới thiệu trường: 这是我们的学校.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l118-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你是老师吗？\nB：不是，我是学生。\nA：他呢？\nB：他是我的同学。她是我们的老师。",
      "pinyin": "A: Nǐ shì lǎo shī ma? B: Bú shì, wǒ shì xué shēng. A: Tā ne? B: Tā shì wǒ de tóng xué. Tā shì wǒ men de lǎo shī.",
      "meaning": "B là học sinh/sinh viên. Người nam là bạn học, người nữ là giáo viên của nhóm; không suy từ âm tā đơn lẻ.",
      "readingMinutes": 2
    },
    {
