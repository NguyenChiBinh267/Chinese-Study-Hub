  "blocks": [
    {
      "id": "l4030-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t0",
      "type": "teaching",
      "title": "听力 · khả năng nghe hiểu",
      "text": "听力 ở đây là năng lực nghe ngôn ngữ, không phải bài audio đi kèm.",
      "hanzi": "她想提高汉语听力。",
      "pinyin": "Tā xiǎng tí gāo Hàn yǔ tīng lì.",
      "meaning": "Cô ấy muốn nâng khả năng nghe tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t1",
      "type": "teaching",
      "title": "听众 · người nghe; thính giả",
      "text": "听众 là người tiếp nhận chương trình/bài nói. Nhận diện chữ 众 trong 听众; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "听众给节目写了信。",
      "pinyin": "Tīng zhòng gěi jié mù xiě le xìn.",
      "meaning": "Thính giả viết thư cho chương trình.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t2",
      "type": "teaching",
      "title": "收听 · nghe chương trình",
      "text": "收听 dùng với phát thanh/chương trình, khác nghe lén.",
      "hanzi": "爷爷喜欢收听广播。",
      "pinyin": "Yé ye xǐ huan shōu tīng guǎng bō.",
      "meaning": "Ông thích nghe phát thanh.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t3",
      "type": "teaching",
      "title": "消息 · tin tức; tin nhắn",
      "text": "消息 là một tin được truyền tới; chưa chắc đã đúng.",
      "hanzi": "我收到了一条消息。",
      "pinyin": "Wǒ shōu dào le yì tiáo xiāo xi.",
      "meaning": "Tôi nhận một tin nhắn.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t4",
      "type": "teaching",
      "title": "信息 · thông tin",
      "text": "信息 là thông tin nói chung, có thể gồm nhiều mục dữ liệu.",
      "hanzi": "请核对时间信息。",
      "pinyin": "Qǐng hé duì shí jiān xìn xī.",
      "meaning": "Hãy đối chiếu thông tin thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-t5",
      "type": "teaching",
      "title": "转发 · chuyển tiếp; chia sẻ lại",
      "text": "转发 là gửi lại nội dung đã nhận, không xác nhận tính đúng.",
      "hanzi": "核对以后再转发。",
      "pinyin": "Hé duì yǐ hòu zài zhuǎn fā.",
      "meaning": "Đối chiếu xong rồi hãy chuyển tiếp.",
      "readingMinutes": 1
    },
    {
      "id": "l4030-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "还X呢 có thể dùng để bác lại hoặc mỉa một nhận định: 还说消息可靠呢，日期都错了。 Sắc thái không trung tính; chỉ luyện hiểu lời nhân vật, không coi là cách phản hồi lịch sự mặc định.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4030-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小雨想练听力，常收听广播，也给节目写过听众来信。她收到一条活动消息，发现时间信息不一致。朋友说：“还说消息可靠呢，日期都错了！”小雨决定先核对，不急着转发。",
      "pinyin": "Xiǎo Yǔ xiǎng liàn tīng lì, cháng shōu tīng guǎng bō, yě gěi jié mù xiě guo tīng zhòng lái xìn. Tā shōu dào yì tiáo huó dòng xiāo xi, fā xiàn shí jiān xìn xī bù yí zhì. Péng you shuō: “Hái shuō xiāo xi kě kào ne, rì qī dōu cuò le!” Xiǎo Yǔ jué dìng xiān hé duì, bù jí zhe zhuǎn fā.",
      "meaning": "Tiểu Vũ thấy thời gian không khớp và kiểm tra trước khi chia sẻ. Bài chỉ có chữ.",
      "readingMinutes": 2
    },
    {
