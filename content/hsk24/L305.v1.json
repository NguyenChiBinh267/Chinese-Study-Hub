  "blocks": [
    {
      "id": "l305-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 先/再, thời gian đứng trước động từ, 在 và lượng từ cơ bản. Prerequisite HSK1/2 vẫn chưa chứng nhận. 以前 yǐqián: trước; 以后 yǐhòu: sau; 带 dài: mang; 北京 Běijīng: Bắc Kinh; 上车 shàng chē: lên xe/tàu. Giấy tờ là nội dung hội thoại giả định, không phải hướng dẫn pháp lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l305-t0",
      "type": "teaching",
      "title": "出发 · khởi hành",
      "text": "出发 nhấn bắt đầu chuyến đi; không phải đã đến nơi. 明天八点出发 là giờ khởi hành, không phải giờ tới.",
      "hanzi": "我们明天早上八点出发。",
      "pinyin": "Wǒmen míngtiān zǎoshang bā diǎn chūfā.",
      "meaning": "Chúng tôi khởi hành lúc 8 giờ sáng mai.",
      "readingMinutes": 1
    },
    {
      "id": "l305-t1",
      "type": "teaching",
      "title": "行李 · hành lý",
      "text": "行李 chỉ đồ mang theo chuyến đi; thường dùng 件 khi đếm từng kiện. Không gọi giấy thông hành là hành lý khi hỏi loại giấy tờ.",
      "hanzi": "我的行李不多，只有一个包。",
      "pinyin": "Wǒ de xíngli bù duō, zhǐ yǒu yí ge bāo.",
      "meaning": "Hành lý tôi ít, chỉ có một túi.",
      "readingMinutes": 1
    },
    {
      "id": "l305-t2",
      "type": "teaching",
      "title": "高铁 · tàu/đường sắt cao tốc",
      "text": "高铁 trong 坐高铁 là đi tàu cao tốc. Từ này chỉ loại phương tiện/hệ thống, không mặc nhiên nói giờ hoặc giá vé.",
      "hanzi": "这次我们坐高铁去北京。",
      "pinyin": "Zhè cì wǒmen zuò gāotiě qù Běijīng.",
      "meaning": "Lần này chúng tôi đi tàu cao tốc tới Bắc Kinh.",
      "readingMinutes": 1
    },
    {
      "id": "l305-t3",
      "type": "teaching",
      "title": "护照 · hộ chiếu",
      "text": "护照 là giấy tờ định danh đi quốc tế. Bài luyện nhận biết từ, không khẳng định yêu cầu nhập cảnh hay đi tàu thực tế ở bất kỳ nước nào.",
      "hanzi": "请不要忘了带护照。",
      "pinyin": "Qǐng bú yào wàng le dài hùzhào.",
      "meaning": "Xin đừng quên mang hộ chiếu.",
      "readingMinutes": 1
    },
    {
      "id": "l305-t4",
      "type": "teaching",
      "title": "检票 · kiểm vé",
      "text": "检票 là kiểm tra vé; khác 买票 mua vé và 上车 lên xe/tàu. 检票口 là nơi kiểm vé, 口 là hỗ trợ.",
      "hanzi": "检票以后，我们再上车。",
      "pinyin": "Jiǎnpiào yǐhòu, wǒmen zài shàng chē.",
      "meaning": "Sau khi kiểm vé chúng tôi mới lên tàu.",
      "readingMinutes": 1
    },
    {
      "id": "l305-t5",
      "type": "teaching",
      "title": "地图 · bản đồ",
      "text": "地图 giúp xem vị trí và đường đi. 电子地图 là bản đồ điện tử, không phải tự động là vé hay lịch tàu.",
      "hanzi": "我在地图上找车站。",
      "pinyin": "Wǒ zài dìtú shang zhǎo chēzhàn.",
      "meaning": "Tôi tìm ga trên bản đồ.",
      "readingMinutes": 1
    },
    {
      "id": "l305-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "出发以前 và 出发以后 đặt sự việc làm mốc. 出发以前检票 là kiểm vé trước khi khởi hành; không đảo thành sau khi đi. 以前/以后 là hỗ trợ được giải thích, chưa tính thêm từ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l305-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我们几点出发？小李：八点。出发以前，先看看行李，别忘了护照和票。小安：我们坐高铁吗？小李：对。先检票，再上车。我在地图上找到了车站。",
      "pinyin": "Xiǎo Ān: Wǒmen jǐ diǎn chūfā? Xiǎo Lǐ: Bā diǎn. Chūfā yǐqián, xiān kànkan xíngli, bié wàng le hùzhào hé piào. Xiǎo Ān: Wǒmen zuò gāotiě ma? Xiǎo Lǐ: Duì. Xiān jiǎnpiào, zài shàng chē. Wǒ zài dìtú shang zhǎodào le chēzhàn.",
      "meaning": "An hỏi giờ khởi hành. Lý nói 8 giờ, nhắc kiểm hành lý, đừng quên hộ chiếu và vé trong chuyến đi của họ. Hai người đi tàu cao tốc, kiểm vé rồi lên tàu; Lý đã tìm ga trên bản đồ.",
      "readingMinutes": 2
    },
    {
