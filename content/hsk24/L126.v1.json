  "blocks": [
    {
      "id": "l126-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l126-t0",
      "type": "teaching",
      "title": "哪里 · ở đâu (dạng có âm tiết lǐ)",
      "text": "哪里 hỏi nơi chốn; khi đề chỉ rõ dạng có lǐ, không nhập dạng hóa r 哪儿.",
      "hanzi": "我的书在哪里？",
      "pinyin": "Wǒ de shū zài nǎ lǐ?",
      "meaning": "Sách của tôi ở đâu?",
      "readingMinutes": 1
    },
    {
      "id": "l126-t1",
      "type": "teaching",
      "title": "哪儿 · ở đâu (dạng hóa r)",
      "text": "哪儿 cùng chức năng hỏi nơi với 哪里, nhưng khác dạng chữ/âm được hỏi trong bài.",
      "hanzi": "你住在哪儿？",
      "pinyin": "Nǐ zhù zài nǎr?",
      "meaning": "Bạn sống ở đâu?",
      "readingMinutes": 1
    },
    {
      "id": "l126-t2",
      "type": "teaching",
      "title": "哪个 · cái nào; người nào (một đối tượng)",
      "text": "哪个 chọn một đối tượng trong nhóm; không dùng nó thay mọi câu hỏi địa điểm.",
      "hanzi": "你喜欢哪个？",
      "pinyin": "Nǐ xǐ huan nǎ ge?",
      "meaning": "Bạn thích cái nào?",
      "readingMinutes": 1
    },
    {
      "id": "l126-t3",
      "type": "teaching",
      "title": "问 · hỏi",
      "text": "问 là hành động hỏi; lời sau dấu hai chấm ở ví dụ là nội dung câu hỏi.",
      "hanzi": "我问你：这是谁的书？",
      "pinyin": "Wǒ wèn nǐ: zhè shì shéi de shū?",
      "meaning": "Tôi hỏi bạn: đây là sách của ai?",
      "readingMinutes": 1
    },
    {
      "id": "l126-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "哪里/哪儿 đều hỏi ở đâu; 哪儿 có hóa r, không đọc thành hai âm nǎ ér. 哪个 hỏi một đối tượng nào, khác hỏi nơi chốn. 问 là hỏi: 我问你 nói tôi hỏi bạn. Câu hỏi giữ từ hỏi ở vị trí thông tin cần biết, như 你住在哪儿？住 được chú giải là ở/cư trú và sẽ học riêng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l126-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：我问你：你喜欢哪个？\nB：我喜欢这个。\nA：你的书在哪里？\nB：在学校。",
      "pinyin": "A: Wǒ wèn nǐ: nǐ xǐ huan nǎ ge? B: Wǒ xǐ huan zhè ge. A: Nǐ de shū zài nǎ lǐ? B: Zài xué xiào.",
      "meaning": "住 zhù = sống/ở trong ví dụ; 在 zài = ở. B chọn cái này, rồi nói sách ở trường. Không suy vị trí sách từ một ảnh không được cung cấp.",
      "readingMinutes": 2
    },
