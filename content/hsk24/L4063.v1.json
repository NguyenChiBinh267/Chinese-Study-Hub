  "blocks": [
    {
      "id": "l4063-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t0",
      "type": "teaching",
      "title": "建议 · đề nghị; kiến nghị",
      "text": "建议 có thể là lời đề xuất hoặc hành động đề xuất.",
      "hanzi": "我建议先试一次。",
      "pinyin": "Wǒ jiàn yì xiān shì yí cì.",
      "meaning": "Tôi đề nghị thử một lần trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t1",
      "type": "teaching",
      "title": "商量 · bàn bạc",
      "text": "商量 nói trao đổi để tìm cách, không phải ra lệnh.",
      "hanzi": "我们一起商量时间。",
      "pinyin": "Wǒ men yì qǐ shāng liang shí jiān.",
      "meaning": "Chúng ta cùng bàn thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t2",
      "type": "teaching",
      "title": "主意 · ý kiến; cách nghĩ",
      "text": "主意 ở 有个主意 là nảy ra một cách giải quyết.",
      "hanzi": "她想出了一个好主意。",
      "pinyin": "Tā xiǎng chū le yí ge hǎo zhǔ yi.",
      "meaning": "Cô ấy nghĩ ra một ý hay.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t3",
      "type": "teaching",
      "title": "做法 · cách làm",
      "text": "做法 chỉ cách thực hiện, có thể cần điều chỉnh.",
      "hanzi": "这个做法还需要改进。",
      "pinyin": "Zhè ge zuò fǎ hái xū yào gǎi jìn.",
      "meaning": "Cách làm này còn cần cải thiện.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t4",
      "type": "teaching",
      "title": "另外 · ngoài ra",
      "text": "另外 bổ sung một việc riêng cần chú ý. Nhận diện chữ 另 trong 另外; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "另外，我们还要留出休息时间。",
      "pinyin": "Lìng wài, wǒ men hái yào liú chū xiū xi shí jiān.",
      "meaning": "Ngoài ra cần chừa thời gian nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-t5",
      "type": "teaching",
      "title": "讨厌 · ghét; khó chịu",
      "text": "讨厌 biểu đạt không thích mạnh; ở đây nhắm tiếng ồn, không công kích người.",
      "hanzi": "我讨厌一直响的噪声。",
      "pinyin": "Wǒ tǎo yàn yì zhí xiǎng de zào shēng.",
      "meaning": "Tôi ghét tiếng ồn vang mãi.",
      "readingMinutes": 1
    },
    {
      "id": "l4063-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "另外 bổ sung một điểm khác vào điều đã bàn. 商量 cần trao đổi; 建议 là một đề xuất, chưa phải quyết định của mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4063-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "同事商量活动时间。小文说：“我有个主意，先在小会议室试一次。”大家觉得这个做法可以改进。小文建议减少噪声，因为有人讨厌一直响的声音。另外，他们还要留出休息时间。",
      "pinyin": "Tóng shì shāng liang huó dòng shí jiān. Xiǎo Wén shuō: “Wǒ yǒu ge zhǔ yi, xiān zài xiǎo huì yì shì shì yí cì.” Dà jiā jué de zhè ge zuò fǎ kě yǐ gǎi jìn. Xiǎo Wén jiàn yì jiǎn shǎo zào shēng, yīn wèi yǒu rén tǎo yàn yì zhí xiǎng de shēng yīn. Lìng wài, tā men hái yào liú chū xiū xi shí jiān.",
      "meaning": "Nhóm thử quy mô nhỏ và giảm tiếng ồn, đồng thời chừa giờ nghỉ.",
      "readingMinutes": 2
    },
    {
