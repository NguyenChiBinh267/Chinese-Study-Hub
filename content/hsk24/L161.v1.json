  "blocks": [
    {
      "id": "l161-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l161-t0",
      "type": "teaching",
      "title": "多 · nhiều",
      "text": "多 trong 很多 tả số lượng nhiều; câu không cho biết chính xác bao nhiêu.",
      "hanzi": "我的书很多。",
      "pinyin": "Wǒ de shū hěn duō.",
      "meaning": "Sách của tôi nhiều.",
      "readingMinutes": 1
    },
    {
      "id": "l161-t1",
      "type": "teaching",
      "title": "少 · ít",
      "text": "少 trong 很少 tả ít theo ngữ cảnh; không tự bằng số0.",
      "hanzi": "我的书很少。",
      "pinyin": "Wǒ de shū hěn shǎo.",
      "meaning": "Sách của tôi ít.",
      "readingMinutes": 1
    },
    {
      "id": "l161-t2",
      "type": "teaching",
      "title": "几 · mấy; bao nhiêu (dạng jǐ)",
      "text": "几 trong 几本书 hỏi số lượng; đề nêu âm để phân biệt với 多少.",
      "hanzi": "你有几本书？",
      "pinyin": "Nǐ yǒu jǐ běn shū?",
      "meaning": "Bạn có mấy quyển sách?",
      "readingMinutes": 1
    },
    {
      "id": "l161-t3",
      "type": "teaching",
      "title": "两 · hai (dạng liǎng trước lượng từ)",
      "text": "两 trong 两本书 là hai; không thay mọi cách viết số二 trên lịch hay chuỗi đếm bằng 两.",
      "hanzi": "我有两本书。",
      "pinyin": "Wǒ yǒu liǎng běn shū.",
      "meaning": "Tôi có hai quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l161-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "几 thường hỏi số lượng nhỏ/được hình dung là không lớn; 多少 có phạm vi rộng hơn, không dùng một ranh10 tuyệt đối cho mọi câu. 两 thường đứng trước lượng từ như 两本书; 二 dùng trong chuỗi đếm/nhãn số đã học. 多/少 tả nhiều/ít theo ngữ cảnh, không phải số đếm cụ thể.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l161-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你有几本书？\nB：我有两本书。你呢？\nA：我的书很多。",
      "pinyin": "A: Nǐ yǒu jǐ běn shū? B: Wǒ yǒu liǎng běn shū. Nǐ ne? A: Wǒ de shū hěn duō.",
      "meaning": "B có hai quyển; A chỉ nói có nhiều, chưa cho một con số chính xác.",
      "readingMinutes": 2
    },
