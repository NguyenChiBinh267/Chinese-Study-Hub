  "blocks": [
    {
      "id": "l230-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "星期 là tuần/thứ; 小时 là giờ. 时 ở đây có nghĩa thời điểm/lúc, không dạy nghĩa lượng từ cấp cao hơn. 就/正 chỉ luyện cách dùng trong ngữ cảnh đã nêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l230-t0",
      "type": "teaching",
      "title": "周 · tuần",
      "text": "周 ở đây là danh từ tuần, 一周 là một tuần. Không dạy cách dùng lượng từ cấp cao hơn theo chú thích nguồn.",
      "hanzi": "我一周工作五天。",
      "pinyin": "Wǒ yì zhōu gōngzuò wǔ tiān.",
      "meaning": "Tôi làm việc năm ngày một tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l230-t1",
      "type": "teaching",
      "title": "时 · lúc, thời điểm",
      "text": "时 trong 吃饭时 chỉ lúc ăn cơm. Không dùng nó làm lượng từ đo thời lượng trong đáp án này.",
      "hanzi": "吃饭时，我不看手机。",
      "pinyin": "Chī fàn shí, wǒ bú kàn shǒujī.",
      "meaning": "Lúc ăn cơm, tôi không xem điện thoại.",
      "readingMinutes": 1
    },
    {
      "id": "l230-t2",
      "type": "teaching",
      "title": "次 · lượng từ đếm lần làm việc gì",
      "text": "一次 là một lần; 两次 là hai lần. Không nhầm số lần đi với thời lượng của mỗi lần.",
      "hanzi": "我一周去两次书店。",
      "pinyin": "Wǒ yì zhōu qù liǎng cì shūdiàn.",
      "meaning": "Tôi đến hiệu sách hai lần một tuần.",
      "readingMinutes": 1
    },
    {
      "id": "l230-t3",
      "type": "teaching",
      "title": "一会儿 · một lát",
      "text": "一会儿 ở đây là một khoảng ngắn; không bảo đảm đúng số phút cố định. Chỉ dạy nghĩa số lượng thời gian của cấp2.",
      "hanzi": "请等一会儿。",
      "pinyin": "Qǐng děng yíhuìr.",
      "meaning": "Làm ơn đợi một lát.",
      "readingMinutes": 1
    },
    {
      "id": "l230-t4",
      "type": "teaching",
      "title": "就 · liền, ngay khi trong mẫu một…thì…",
      "text": "就 trong 一到家就看书 nối việc làm ngay sau mốc về nhà. Không dùng nghĩa giới từ chú thích cấp cao hơn.",
      "hanzi": "我一到家就看书。",
      "pinyin": "Wǒ yí dào jiā jiù kàn shū.",
      "meaning": "Tôi vừa về đến nhà là đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l230-t5",
      "type": "teaching",
      "title": "正 · đang, đúng lúc diễn ra hành động",
      "text": "正 là phó từ trước động từ trong 正工作. Không dùng nghĩa tính từ ngay thẳng/chính diện của cấp cao hơn.",
      "hanzi": "他正工作呢。",
      "pinyin": "Tā zhèng gōngzuò ne.",
      "meaning": "Anh ấy đang làm việc đấy.",
      "readingMinutes": 1
    },
    {
      "id": "l230-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一到……就…… nói vừa đến mốc/sự việc A thì làm B ngay. Không tự hiểu mọi 就 đều là cấu trúc này; ví dụ còn có cách nhấn mạnh khác chưa chấm ở đây.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l230-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你一周工作几天？乙：五天。我一到家就看书，一周还去两次书店。甲：现在能说话吗？乙：我正工作呢，请等一会儿。",
      "pinyin": "Jiǎ: Nǐ yì zhōu gōngzuò jǐ tiān? Yǐ: Wǔ tiān. Wǒ yí dào jiā jiù kàn shū, yì zhōu hái qù liǎng cì shūdiàn. Jiǎ: Xiànzài néng shuō huà ma? Yǐ: Wǒ zhèng gōngzuò ne, qǐng děng yíhuìr.",
      "meaning": "A: Một tuần bạn làm mấy ngày? B: Năm ngày. Vừa về nhà tôi đọc sách, mỗi tuần còn đến hiệu sách hai lần. A: Giờ nói chuyện được không? B: Tôi đang làm việc, làm ơn đợi một lát.",
      "readingMinutes": 2
    },
    {
