  "blocks": [
    {
      "id": "l343-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 学生卡 xuéshengkǎ: thẻ học sinh; 消息 xiāoxi: tin; 文件 wénjiàn: tài liệu; 任何 rènhé: bất kỳ, đối chiếu. Không nhập thông tin thẻ thật vào bài học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l343-t0",
      "type": "teaching",
      "title": "关机 · tắt máy",
      "text": "关机 là tắt nguồn thiết bị; khác 关灯 là tắt đèn, không suy ra máy hỏng khi tắt.",
      "hanzi": "离开以前请关机。",
      "pinyin": "Líkāi yǐqián qǐng guān jī.",
      "meaning": "Trước khi đi hãy tắt máy.",
      "readingMinutes": 1
    },
    {
      "id": "l343-t1",
      "type": "teaching",
      "title": "开机 · bật máy",
      "text": "开机 là bật nguồn máy; khác 开会 là họp. 开机以后才看文件 nói thứ tự trên thiết bị.",
      "hanzi": "我先开机，再看文件。",
      "pinyin": "Wǒ xiān kāi jī, zài kàn wénjiàn.",
      "meaning": "Tôi bật máy trước rồi xem tài liệu.",
      "readingMinutes": 1
    },
    {
      "id": "l343-t2",
      "type": "teaching",
      "title": "发 · gửi/phát",
      "text": "发 fā trong 发邮件 là gửi; khác 发 fa ở 头发. Không tính nhớ một cách đọc là đã biết mọi từ chứa 发.",
      "hanzi": "请把消息发给我。",
      "pinyin": "Qǐng bǎ xiāoxi fā gěi wǒ.",
      "meaning": "Hãy gửi tin cho tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l343-t3",
      "type": "teaching",
      "title": "网站 · trang web/website",
      "text": "网站 là một website, không tự bảo đảm đáng tin hay an toàn; 这个网站 nêu nơi đọc trực tuyến.",
      "hanzi": "这个网站有学校的通知。",
      "pinyin": "Zhège wǎngzhàn yǒu xuéxiào de tōngzhī.",
      "meaning": "Website này có thông báo của trường.",
      "readingMinutes": 1
    },
    {
      "id": "l343-t4",
      "type": "teaching",
      "title": "卡 · thẻ",
      "text": "卡 là tên chung thẻ, cần bổ nghĩa để biết loại như 银行卡、学生卡. 不 phải mọi 卡 đều dùng thanh toán.",
      "hanzi": "这张卡是学生卡。",
      "pinyin": "Zhè zhāng kǎ shì xuéshengkǎ.",
      "meaning": "Thẻ này là thẻ học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l343-t5",
      "type": "teaching",
      "title": "信用卡 · thẻ tín dụng",
      "text": "信用卡 là thẻ tín dụng, khác thẻ ghi nợ/ngân hàng nói chung. Bài học tên từ, không hướng dẫn vay hay mở tài khoản.",
      "hanzi": "这张不是学生卡，是信用卡。",
      "pinyin": "Zhè zhāng bú shì xuéshengkǎ, shì xìnyòngkǎ.",
      "meaning": "Thẻ này không phải thẻ học sinh, là thẻ tín dụng.",
      "readingMinutes": 1
    },
    {
      "id": "l343-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把名单发给同事 nêu đối tượng đã xác định và người nhận. 给 đứng sau 发 trong kết cấu này; không tự suy ra thư đã tới.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l343-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林先开机，在学校网站看通知，再把消息发给同事。离开以前他关机，把学生卡带走。桌上的信用卡不是他的，他没有拿。开机、发消息和拿卡是不同的事情。",
      "pinyin": "Xiǎo Lín xiān kāi jī, zài xuéxiào wǎngzhàn kàn tōngzhī, zài bǎ xiāoxi fā gěi tóngshì. Líkāi yǐqián tā guān jī, bǎ xuéshengkǎ dài zǒu. Zhuō shàng de xìnyòngkǎ bú shì tā de, tā méiyǒu ná. Kāi jī, fā xiāoxi hé ná kǎ shì bù tóng de shìqing.",
      "meaning": "Lâm bật máy, xem thông báo trường và gửi tin cho đồng nghiệp. Trước đi cậu tắt máy, mang thẻ học sinh, không lấy thẻ tín dụng của người khác.",
      "readingMinutes": 2
    },
    {
