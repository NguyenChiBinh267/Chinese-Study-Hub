  "blocks": [
    {
      "id": "l419-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 录像 lùxiàng: ghi hình; 演出 yǎnchū: biểu diễn; 鼓掌 gǔzhǎng: vỗ tay; 主持人 zhǔchírén: người dẫn chương trình; 亲自 qīnzì: đích thân.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l419-t0",
      "type": "teaching",
      "title": "钢琴 · đàn piano",
      "text": "钢琴 là tên nhạc cụ; 弹钢琴 là chơi piano, không dùng 拉 trong cách kết hợp này. Nhận diện chữ 钢 trong 钢琴; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "姐姐会弹钢琴。",
      "pinyin": "Jiějie huì tán gāngqín.",
      "meaning": "Chị gái biết chơi piano.",
      "readingMinutes": 1
    },
    {
      "id": "l419-t1",
      "type": "teaching",
      "title": "歌声 · tiếng hát",
      "text": "歌声 là âm thanh người hát, khác 歌手 là người và 歌词 là lời bài hát.",
      "hanzi": "窗外传来了熟悉的歌声。",
      "pinyin": "Chuāng wài chuán lái le shúxī de gēshēng.",
      "meaning": "Ngoài cửa sổ vang tới tiếng hát quen thuộc.",
      "readingMinutes": 1
    },
    {
      "id": "l419-t2",
      "type": "teaching",
      "title": "歌手 · ca sĩ",
      "text": "歌手 chỉ người hát, không tự cho biết nổi tiếng hay hát chuyên nghiệp ở mọi ngữ cảnh.",
      "hanzi": "这位歌手还会弹钢琴。",
      "pinyin": "Zhè wèi gēshǒu hái huì tán gāngqín.",
      "meaning": "Ca sĩ này còn biết chơi piano.",
      "readingMinutes": 1
    },
    {
      "id": "l419-t3",
      "type": "teaching",
      "title": "观看 · xem, theo dõi",
      "text": "观看 thường nhận buổi biểu diễn/trận đấu/hình ảnh có chủ đích; không thay mọi nghĩa đọc/xem của 看.",
      "hanzi": "我们一起观看了学校的演出。",
      "pinyin": "Wǒmen yìqǐ guānkàn le xuéxiào de yǎnchū.",
      "meaning": "Chúng tôi cùng xem buổi biểu diễn của trường.",
      "readingMinutes": 1
    },
    {
      "id": "l419-t4",
      "type": "teaching",
      "title": "观众 · khán giả",
      "text": "观众 là người xem một hoạt động/truyền thông; bài không đồng nhất mọi người ở gần đều là khán giả.",
      "hanzi": "演出结束后，观众站起来鼓掌。",
      "pinyin": "Yǎnchū jiéshù hòu, guānzhòng zhàn qǐlái gǔzhǎng.",
      "meaning": "Kết thúc biểu diễn, khán giả đứng dậy vỗ tay.",
      "readingMinutes": 1
    },
    {
      "id": "l419-t5",
      "type": "teaching",
      "title": "播放 · phát (âm thanh, video)",
      "text": "播放 là phát/trình chiếu âm thanh hoặc video; trong đoạn là bản ghi hình. Chỉ từ 播放 không chứng minh là phát trực tiếp hay bản ghi.",
      "hanzi": "老师播放了一段演出录像。",
      "pinyin": "Lǎoshī bōfàng le yí duàn yǎnchū lùxiàng.",
      "meaning": "Giáo viên phát một đoạn ghi hình buổi diễn.",
      "readingMinutes": 1
    },
    {
      "id": "l419-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "连+A+都+V nêu trường hợp được xem là nổi bật; vế 更 đẩy mức độ ở trường hợp khác. Đó là đánh giá trong ngữ cảnh, không phải kết luận về mọi trẻ em/người lớn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l419-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "音乐课上，老师播放一段录像。一位歌手边弹钢琴边唱歌，观众听到歌声后鼓掌。录像中的主持人说，连孩子都喜欢他的歌，大人更喜欢。同学们观看的是录像，没有亲自参加那场演出。",
      "pinyin": "Yīnyuè kè shàng, lǎoshī bōfàng yí duàn lùxiàng. Yí wèi gēshǒu biān tán gāngqín biān chàng gē, guānzhòng tīngdào gēshēng hòu gǔzhǎng. Lùxiàng zhōng de zhǔchírén shuō, lián háizi dōu xǐhuan tā de gē, dàrén gèng xǐhuan. Tóngxuémen guānkàn de shì lùxiàng, méiyǒu qīnzì cānjiā nà chǎng yǎnchū.",
      "meaning": "Giáo viên phát ghi hình ca sĩ vừa đàn vừa hát. Lời so sánh trẻ em/người lớn là lời người dẫn trong video; học sinh đang xem ghi hình, chưa đến buổi diễn.",
      "readingMinutes": 2
    },
