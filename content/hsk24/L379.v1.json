  "blocks": [
    {
      "id": "l379-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 活 huó: việc; 椅子 yǐzi: ghế; 读者 dúzhě: người đọc; 文字 wénzì: văn bản. Không nhầm bài đọc về âm thanh thành đánh giá nghe.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l379-t0",
      "type": "teaching",
      "title": "干 · làm (việc)",
      "text": "干 gàn trong 干活 là làm việc, khác gān là khô. Bài không đọc từ này gān để tả quần áo đã khô.",
      "hanzi": "大家一起干活。",
      "pinyin": "Dàjiā yìqǐ gàn huó.",
      "meaning": "Mọi người cùng làm việc.",
      "readingMinutes": 1
    },
    {
      "id": "l379-t1",
      "type": "teaching",
      "title": "加 · thêm/cộng",
      "text": "加 có thể thêm đồ hoặc cộng số; 再加一把椅子 là thêm một ghế. Chưa có nghĩa lượng sau khi thêm nếu chưa đếm lại.",
      "hanzi": "请再加一把椅子。",
      "pinyin": "Qǐng zài jiā yì bǎ yǐzi.",
      "meaning": "Hãy thêm một chiếc ghế nữa.",
      "readingMinutes": 1
    },
    {
      "id": "l379-t2",
      "type": "teaching",
      "title": "起 · nổi lên/dậy/khởi lên",
      "text": "起 trong 风起了 là gió nổi lên; 起得早 thường là dậy sớm theo cảnh. Đây là động từ, chưa dạy mọi lượng từ 起.",
      "hanzi": "外面的风又起了。",
      "pinyin": "Wàimian de fēng yòu qǐ le.",
      "meaning": "Gió ngoài trời lại nổi lên.",
      "readingMinutes": 1
    },
    {
      "id": "l379-t3",
      "type": "teaching",
      "title": "站 · đứng",
      "text": "站 zhàn động từ đứng, khác 站 danh từ ga/trạm đã gặp trước. 站起来 là đứng dậy, 不 phải tự tạo một ga mới.",
      "hanzi": "请站起来。",
      "pinyin": "Qǐng zhàn qǐlái.",
      "meaning": "Hãy đứng dậy.",
      "readingMinutes": 1
    },
    {
      "id": "l379-t4",
      "type": "teaching",
      "title": "声 · tiếng; lượng từ tiếng phát ra",
      "text": "声 trong 叫了一声 đếm một tiếng gọi; 声音 là danh từ âm thanh. Không dùng 叫了一个声音 như dạng đếm mặc định này.",
      "hanzi": "他叫了一声。",
      "pinyin": "Tā jiào le yì shēng.",
      "meaning": "Anh ấy gọi một tiếng.",
      "readingMinutes": 1
    },
    {
      "id": "l379-t5",
      "type": "teaching",
      "title": "声音 · âm thanh/giọng",
      "text": "声音 là âm thanh/giọng được nghe/miêu tả; 声音大 là âm lớn. Không đánh giá nghe/phát âm người học vì bài chỉ có chữ.",
      "hanzi": "他的声音很大。",
      "pinyin": "Tā de shēngyīn hěn dà.",
      "meaning": "Giọng anh ấy rất to.",
      "readingMinutes": 1
    },
    {
      "id": "l379-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "叫了一声 đếm một tiếng gọi, 声音 là âm thanh/giọng nói như vật được mô tả. 一声不等于一个人；同一 người có thể gọi nhiều tiếng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l379-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "大家在屋里干活，为晚会加椅子。外面的风又起了。老师站起来叫了一声，声音很大，但大家只听到一次。读者只能根据文字知道这些，没有真的听到声音。",
      "pinyin": "Dàjiā zài wū lǐ gàn huó, wèi wǎnhuì jiā yǐzi. Wàimian de fēng yòu qǐ le. Lǎoshī zhàn qǐlái jiào le yì shēng, shēngyīn hěn dà, dàn dàjiā zhǐ tīngdào yí cì. Dúzhě zhǐ néng gēnjù wénzì zhīdào zhèxiē, méiyǒu zhēn de tīngdào shēngyīn.",
      "meaning": "Mọi người chuẩn bị ghế cho văn nghệ, ngoài trời nổi gió. Thầy đứng dậy gọi một tiếng lớn. Người đọc chỉ biết qua chữ; bài chưa có âm thanh thật.",
      "readingMinutes": 2
    },
    {
      "id": "l379-b0",
      "type": "exercise",
      "exerciseVersionId": "l379-v1-e0"
