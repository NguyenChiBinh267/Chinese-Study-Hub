  "blocks": [
    {
      "id": "l313-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc thời gian, chủ ngữ–động từ–tân ngữ, 的 và câu hỏi cơ bản. HSK1/2 prerequisite vẫn chưa được xác nhận. 只有 zhǐyǒu: chỉ khi; 才 cái: mới; 同意 tóngyì: đồng ý; 问题 wèntí: vấn đề; 定 dìng: định/chốt; 开会 kāi huì: họp. Không giả định lịch làm việc thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l313-t0",
      "type": "teaching",
      "title": "决定 · quyết định",
      "text": "决定 là quyết định một phương án sau cân nhắc hoặc quyết định dưới dạng danh từ. 不要把打算当成已经决定; ý định chưa tự là quyết định đã chốt.",
      "hanzi": "我们决定明天开会。",
      "pinyin": "Wǒmen juédìng míngtiān kāi huì.",
      "meaning": "Chúng tôi quyết định họp ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l313-t1",
      "type": "teaching",
      "title": "打算 · dự định/định",
      "text": "打算 diễn tả kế hoạch hoặc định làm, có thể đổi; không đồng nghĩa việc đã hoàn tất. 你有什么打算 hỏi dự định.",
      "hanzi": "我打算先问问经理。",
      "pinyin": "Wǒ dǎsuàn xiān wènwen jīnglǐ.",
      "meaning": "Tôi định hỏi quản lý trước.",
      "readingMinutes": 1
    },
    {
      "id": "l313-t2",
      "type": "teaching",
      "title": "机会 · cơ hội",
      "text": "机会 là cơ hội làm việc gì, không tự bảo đảm kết quả. 有机会发言 nói có dịp phát biểu, không nói chắc ai cũng đồng ý.",
      "hanzi": "我想找机会介绍这个方法。",
      "pinyin": "Wǒ xiǎng zhǎo jīhuì jièshào zhège fāngfǎ.",
      "meaning": "Tôi muốn tìm cơ hội giới thiệu cách này.",
      "readingMinutes": 1
    },
    {
      "id": "l313-t3",
      "type": "teaching",
      "title": "解决 · giải quyết",
      "text": "解决 thường đi với 问题/事情, nghĩa xử lý để vấn đề được giải quyết. 正在解决 chưa đồng nghĩa đã giải quyết xong.",
      "hanzi": "这个问题还没有解决。",
      "pinyin": "Zhège wèntí hái méiyǒu jiějué.",
      "meaning": "Vấn đề này chưa được giải quyết.",
      "readingMinutes": 1
    },
    {
      "id": "l313-t4",
      "type": "teaching",
      "title": "会议 · cuộc họp/hội nghị",
      "text": "会议 là danh từ hoạt động họp; 开会 là động từ họp, 会议不是动词. 会议时间 nói giờ cuộc họp.",
      "hanzi": "会议的时间还没定。",
      "pinyin": "Huìyì de shíjiān hái méi dìng.",
      "meaning": "Giờ họp chưa được ấn định.",
      "readingMinutes": 1
    },
    {
      "id": "l313-t5",
      "type": "teaching",
      "title": "经理 · quản lý/giám đốc theo ngữ cảnh",
      "text": "经理 là chức danh quản lý trong đơn vị; không suy ra quyền quyết định của mọi quản lý giống nhau. Quy tắc đồng ý trong bài chỉ thuộc tình huống giả định.",
      "hanzi": "经理想先了解这个问题。",
      "pinyin": "Jīnglǐ xiǎng xiān liǎojiě zhège wèntí.",
      "meaning": "Quản lý muốn tìm hiểu vấn đề này trước.",
      "readingMinutes": 1
    },
    {
      "id": "l313-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "只有经理同意，我们才开会 nêu sự đồng ý là điều kiện cần trong quy định được kể. Không suy ra có đồng ý thì chắc chắn mọi việc đã xảy ra. Khác 只要……就…… nêu điều kiện đủ theo kế hoạch.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l313-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我打算明天开一个会，找机会解决这个问题。小李：会议时间决定了吗？小安：还没有。只有经理同意，我们才开会。小李：那先问经理，再告诉大家。",
      "pinyin": "Xiǎo Ān: Wǒ dǎsuàn míngtiān kāi yí ge huì, zhǎo jīhuì jiějué zhège wèntí. Xiǎo Lǐ: Huìyì shíjiān juédìng le ma? Xiǎo Ān: Hái méiyǒu. Zhǐyǒu jīnglǐ tóngyì, wǒmen cái kāi huì. Xiǎo Lǐ: Nà xiān wèn jīnglǐ, zài gàosu dàjiā.",
      "meaning": "An định họp ngày mai để tìm cơ hội giải quyết vấn đề. Giờ họp chưa chốt. Trong tình huống này chỉ khi quản lý đồng ý nhóm mới họp; hai người sẽ hỏi trước rồi báo mọi người.",
      "readingMinutes": 2
    },
