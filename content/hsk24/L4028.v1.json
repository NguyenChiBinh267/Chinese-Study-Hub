  "blocks": [
    {
      "id": "l4028-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t0",
      "type": "teaching",
      "title": "葡萄 · nho",
      "text": "葡萄 là quả nho; âm 萄 thường đọc nhẹ. Nhận diện chữ 葡 trong 葡萄; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我买了一串葡萄。",
      "pinyin": "Wǒ mǎi le yí chuàn pú tao.",
      "meaning": "Tôi mua một chùm nho.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t1",
      "type": "teaching",
      "title": "葡萄酒 · rượu vang nho",
      "text": "葡萄酒 chỉ đồ uống làm từ nho, không đồng nghĩa nước nho.",
      "hanzi": "这瓶葡萄酒是送给叔叔的。",
      "pinyin": "Zhè píng pú tao jiǔ shì sòng gěi shū shu de.",
      "meaning": "Chai vang nho này để tặng chú.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t2",
      "type": "teaching",
      "title": "汽水 · nước ngọt có ga",
      "text": "汽水 là đồ uống có ga trong bài, không phải hơi nước.",
      "hanzi": "他选了一瓶汽水。",
      "pinyin": "Tā xuǎn le yì píng qì shuǐ.",
      "meaning": "Anh ấy chọn một chai nước ngọt có ga.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t3",
      "type": "teaching",
      "title": "巧克力 · sô cô la",
      "text": "巧克力 là tên thực phẩm, không tách thành nghĩa từng chữ.",
      "hanzi": "妹妹喜欢这块巧克力。",
      "pinyin": "Mèi mei xǐ huan zhè kuài qiǎo kè lì.",
      "meaning": "Em gái thích miếng sô cô la này.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t4",
      "type": "teaching",
      "title": "千克 · kilôgam",
      "text": "千克 là đơn vị khối lượng, bằng một kilôgam.",
      "hanzi": "这袋葡萄重一千克。",
      "pinyin": "Zhè dài pú tao zhòng yì qiān kè.",
      "meaning": "Túi nho này nặng một kilôgam.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-t5",
      "type": "teaching",
      "title": "鲜 · tươi",
      "text": "鲜 trong câu là tươi, không phải 鲜红 nghĩa đỏ tươi.",
      "hanzi": "今天的葡萄很鲜。",
      "pinyin": "Jīn tiān de pú tao hěn xiān.",
      "meaning": "Nho hôm nay rất tươi.",
      "readingMinutes": 1
    },
    {
      "id": "l4028-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "省一点儿是一点儿 nhấn mạnh tiết kiệm được chút nào hay chút ấy. Đây là một cách lặp trong lời nói, không phải quy tắc tài chính hay mẫu ghép tùy ý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4028-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小李准备聚会，买了一千克鲜葡萄和几块巧克力。朋友想喝汽水，叔叔收到一瓶葡萄酒。小李比较包装大小，说：“够用就好，省一点儿是一点儿，不必买太多。”",
      "pinyin": "Xiǎo Lǐ zhǔn bèi jù huì, mǎi le yì qiān kè xiān pú tao hé jǐ kuài qiǎo kè lì. Péng you xiǎng hē qì shuǐ, shū shu shōu dào yì píng pú tao jiǔ. Xiǎo Lǐ bǐ jiào bāo zhuāng dà xiǎo, shuō: “Gòu yòng jiù hǎo, shěng yì diǎnr shì yì diǎnr, bú bì mǎi tài duō.”",
      "meaning": "Tiểu Lý chọn lượng vừa đủ cho buổi gặp mặt, không mua quá nhiều.",
      "readingMinutes": 2
    },
    {
