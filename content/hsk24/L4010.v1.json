  "blocks": [
    {
      "id": "l4010-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t0",
      "type": "teaching",
      "title": "扫码 · quét mã",
      "text": "扫码 là dùng thiết bị đọc mã; bản thân thao tác không đảm bảo nội dung mã an toàn.",
      "hanzi": "老师用样品演示扫码。",
      "pinyin": "Lǎo shī yòng yàng pǐn yǎn shì sǎo mǎ.",
      "meaning": "Thầy cô dùng mẫu vật minh họa quét mã.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t1",
      "type": "teaching",
      "title": "使用 · sử dụng",
      "text": "使用 là động từ dùng thiết bị/phương pháp; khác 使用说明书 là tài liệu hướng dẫn.",
      "hanzi": "请先学习怎样使用设备。",
      "pinyin": "Qǐng xiān xué xí zěn yàng shǐ yòng shè bèi.",
      "meaning": "Hãy học cách sử dụng thiết bị trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t2",
      "type": "teaching",
      "title": "视频 · video",
      "text": "视频 là nội dung hình ảnh chuyển động; bài chỉ đọc chữ, không có video đi kèm. Nhận diện chữ 频 trong 视频; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "说明书里提到了一段视频。",
      "pinyin": "Shuō míng shū lǐ tí dào le yí duàn shì pín.",
      "meaning": "Sách hướng dẫn có nhắc một video.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t3",
      "type": "teaching",
      "title": "说明书 · sách hướng dẫn",
      "text": "说明书 là văn bản hướng dẫn sử dụng, khác hành động 说明 là giải thích.",
      "hanzi": "他把说明书放在桌上。",
      "pinyin": "Tā bǎ shuō míng shū fàng zài zhuō shàng.",
      "meaning": "Anh ấy đặt sách hướng dẫn lên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t4",
      "type": "teaching",
      "title": "说明 · giải thích; trình bày",
      "text": "说明 trong câu là động từ nói rõ cách dùng; không thay cho danh từ 说明书.",
      "hanzi": "老师说明了操作方法。",
      "pinyin": "Lǎo shī shuō míng le cāo zuò fāng fǎ.",
      "meaning": "Thầy cô giải thích cách thao tác.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-t5",
      "type": "teaching",
      "title": "信号 · tín hiệu",
      "text": "信号 ở đây là tín hiệu mạng; khác 信息 là nội dung thông tin.",
      "hanzi": "教室里的网络信号很好。",
      "pinyin": "Jiào shì lǐ de wǎng luò xìn hào hěn hǎo.",
      "meaning": "Tín hiệu mạng trong lớp rất tốt.",
      "readingMinutes": 1
    },
    {
      "id": "l4010-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Động tác/cách làm + 就是了 nêu cách xử lý được người nói coi là đủ: 按说明操作就是了. Câu luyện về thiết bị mẫu đã xác định, không khuyến khích mở đường dẫn lạ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4010-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师拿来一份说明书，说明怎样使用样品。二维码可以记录信息，设备用摄像头读出这些信息。大家只扫老师准备的示例码。网络信号好时，可以打开配套视频。老师说：“这是指定的样品，按说明操作就是了；不认识的码先别扫。”",
      "pinyin": "Lǎo shī ná lái yí fèn shuō míng shū, shuō míng zěn yàng shǐ yòng yàng pǐn. Èr wéi mǎ kě yǐ jì lù xìn xī, shè bèi yòng shè xiàng tóu dú chū zhè xiē xìn xī. Dà jiā zhǐ sǎo lǎo shī zhǔn bèi de shì lì mǎ. Wǎng luò xìn hào hǎo shí, kě yǐ dǎ kāi pèi tào shì pín. Lǎo shī shuō: “Zhè shì zhǐ dìng de yàng pǐn, àn shuō míng cāo zuò jiù shì le; bù rèn shi de mǎ xiān bié sǎo.”",
      "meaning": "Đoạn chữ giải thích mã lưu thông tin và thiết bị đọc bằng camera; cả lớp chỉ dùng mã mẫu giáo viên chuẩn bị. Không có video/audio thật trong bài.",
      "readingMinutes": 2
    },
    {
