  "blocks": [
    {
      "id": "l418-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 组队 zǔ duì: lập đội; 互相 hùxiāng: lẫn nhau; 却 què: nhưng lại; 整个 zhěng ge: toàn bộ. Đội và kết quả đều hư cấu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l418-t0",
      "type": "teaching",
      "title": "参赛 · tham gia thi đấu",
      "text": "参赛 chỉ tham gia cuộc thi/trận đấu, chưa hàm ý chiến thắng.",
      "hanzi": "我们第一次组队参赛。",
      "pinyin": "Wǒmen dì yī cì zǔ duì cānsài.",
      "meaning": "Chúng tôi lần đầu lập đội dự thi.",
      "readingMinutes": 1
    },
    {
      "id": "l418-t1",
      "type": "teaching",
      "title": "场 · trận, buổi (lượng từ chǎng)",
      "text": "场 đọc chǎng khi đếm trận đấu; bài giới hạn lượng từ, không dạy cách đọc cháng của từ đồng hình cấp khác.",
      "hanzi": "下午有两场比赛。",
      "pinyin": "Xiàwǔ yǒu liǎng chǎng bǐsài.",
      "meaning": "Chiều có hai trận đấu.",
      "readingMinutes": 1
    },
    {
      "id": "l418-t2",
      "type": "teaching",
      "title": "打败 · đánh bại",
      "text": "打败 nhận đối thủ bị thắng; hướng tác động không giống 输给 là thua trước ai. Nhận diện chữ 败 trong 打败; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "蓝队打败了红队。",
      "pinyin": "Lán duì dǎbài le Hóng duì.",
      "meaning": "Đội Xanh đánh bại đội Đỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l418-t3",
      "type": "teaching",
      "title": "队 · đội, nhóm",
      "text": "队 ở đây là danh từ tập thể; không nhận là lượng từ của cấp sau.",
      "hanzi": "我们队今天穿蓝色上衣。",
      "pinyin": "Wǒmen duì jīntiān chuān lánsè shàngyī.",
      "meaning": "Hôm nay đội chúng tôi mặc áo xanh.",
      "readingMinutes": 1
    },
    {
      "id": "l418-t4",
      "type": "teaching",
      "title": "队员 · thành viên đội",
      "text": "队员 là người thuộc đội, không phải ai cũng là người chỉ huy.",
      "hanzi": "每位队员都有自己的任务。",
      "pinyin": "Měi wèi duìyuán dōu yǒu zìjǐ de rènwu.",
      "meaning": "Mỗi thành viên đội có nhiệm vụ riêng.",
      "readingMinutes": 1
    },
    {
      "id": "l418-t5",
      "type": "teaching",
      "title": "队长 · đội trưởng",
      "text": "队长 là người đứng đầu đội trong bối cảnh này; không suy ra mọi người khác đều ít kinh nghiệm.",
      "hanzi": "队长先说明比赛安排。",
      "pinyin": "Duìzhǎng xiān shuōmíng bǐsài ānpái.",
      "meaning": "Đội trưởng giải thích lịch thi đấu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l418-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既…又… đặt hai tính chất/công việc song song, không tự nêu nhân quả. 主语+既+V1+又+V2 dùng cùng một chủ thể trong câu mẫu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l418-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "蓝队第一次参赛。队长既说明安排，又提醒队员互相帮助。下午有两场比赛：第一场蓝队打败了红队，第二场却输了。队员说，赢一场不等于赢了整个比赛。",
      "pinyin": "Lán duì dì yī cì cānsài. Duìzhǎng jì shuōmíng ānpái, yòu tíxǐng duìyuán hùxiāng bāngzhù. Xiàwǔ yǒu liǎng chǎng bǐsài: Dì yī chǎng Lán duì dǎbài le Hóng duì, dì èr chǎng què shū le. Duìyuán shuō, yíng yì chǎng bù děngyú yíng le zhěng ge bǐsài.",
      "meaning": "Đội Xanh thắng trận đầu nhưng thua trận thứ hai. Đội trưởng vừa phổ biến lịch vừa nhắc thành viên giúp nhau; thắng một trận không có nghĩa thắng cả giải.",
      "readingMinutes": 2
    },
    {
