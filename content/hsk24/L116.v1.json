  "blocks": [
    {
      "id": "l116-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l116-t0",
      "type": "teaching",
      "title": "猫 · mèo",
      "text": "猫 là mèo; không suy động vật từ đại từ 它 nếu chưa có lời giới thiệu.",
      "hanzi": "这只猫是我的。",
      "pinyin": "Zhè zhī māo shì wǒ de.",
      "meaning": "Con mèo này là của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l116-t1",
      "type": "teaching",
      "title": "只 · con (lượng từ)",
      "text": "只 trong 一只猫 đọc zhī, đếm một con vật ở ví dụ, không đọc zhǐ theo nghĩa chỉ.",
      "hanzi": "我有一只猫。",
      "pinyin": "Wǒ yǒu yì zhī māo.",
      "meaning": "Tôi có một con mèo.",
      "readingMinutes": 1
    },
    {
      "id": "l116-t2",
      "type": "teaching",
      "title": "小 · nhỏ; bé",
      "text": "小 trong 小猫 nói kích thước/đặc điểm nhỏ; không tự biến thành so sánh hơn.",
      "hanzi": "这只猫很小。",
      "pinyin": "Zhè zhī māo hěn xiǎo.",
      "meaning": "Con mèo này nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l116-t3",
      "type": "teaching",
      "title": "大 · to; lớn",
      "text": "大 ở ví dụ tả kích thước, không phải tên cấp học 大学.",
      "hanzi": "那只狗很大。",
      "pinyin": "Nà zhī gǒu hěn dà.",
      "meaning": "Con chó kia to.",
      "readingMinutes": 1
    },
    {
      "id": "l116-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "小/大 có thể trực tiếp làm vị ngữ miêu tả: 它很小. Không thêm 是 trước 很小 trong mẫu này. 只 zhī là lượng từ cho con vật ở ví dụ 一只猫; nguồn khác có thể có 只 zhǐ nhưng bài này không dạy nghĩa “chỉ”. 很 được chú giải là yếu tố mức độ, sẽ học riêng ở bài sau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l116-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你有猫吗？\nB：有，我有一只猫。\nA：它大吗？\nB：不大，它很小。",
      "pinyin": "A: Nǐ yǒu māo ma? B: Yǒu, wǒ yǒu yì zhī māo. A: Tā dà ma? B: Bú dà, tā hěn xiǎo.",
      "meaning": "很 hěn hỗ trợ câu miêu tả. B nói có một con mèo và con mèo nhỏ, không lớn. 一 đứng trước 只 zhī được đọc yì trong câu.",
      "readingMinutes": 2
    },
    {
