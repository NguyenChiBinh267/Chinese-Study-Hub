  "blocks": [
    {
      "id": "l306-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 先/再, thời gian đứng trước động từ, 在 và lượng từ cơ bản. Prerequisite HSK1/2 vẫn chưa chứng nhận. 安静 ānjìng: yên tĩnh; 见面 jiànmiàn: gặp mặt; 不用 búyòng: không cần. 对我来说 nhấn góc nhìn cá nhân; 这里/附近 đều cần ngữ cảnh chỉ nơi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l306-t0",
      "type": "teaching",
      "title": "宾馆 · khách sạn/nhà nghỉ",
      "text": "宾馆 là cơ sở lưu trú; cùng trường nghĩa 酒店 nhưng không phân cấp chất lượng chỉ từ tên gọi. Không suy ra giá hay hạng sao.",
      "hanzi": "我们在车站附近找了一家宾馆。",
      "pinyin": "Wǒmen zài chēzhàn fùjìn zhǎo le yì jiā bīnguǎn.",
      "meaning": "Chúng tôi tìm một khách sạn gần ga.",
      "readingMinutes": 1
    },
    {
      "id": "l306-t1",
      "type": "teaching",
      "title": "附近 · gần đây/vùng lân cận",
      "text": "附近 đứng sau địa điểm như 宾馆附近 hoặc chỉ khu vực gần nơi đang nói. Không cho khoảng cách chính xác nếu không có số đo.",
      "hanzi": "宾馆附近有一个地铁站。",
      "pinyin": "Bīnguǎn fùjìn yǒu yí ge dìtiězhàn.",
      "meaning": "Gần khách sạn có một ga tàu điện.",
      "readingMinutes": 1
    },
    {
      "id": "l306-t2",
      "type": "teaching",
      "title": "方便 · thuận tiện",
      "text": "方便 nói dễ/tiện cho việc gì theo hoàn cảnh. 这里坐车方便 nói thuận tiện đi xe, không khẳng định mọi dịch vụ đều tốt.",
      "hanzi": "这里坐地铁很方便。",
      "pinyin": "Zhèlǐ zuò dìtiě hěn fāngbiàn.",
      "meaning": "Ở đây đi tàu điện rất tiện.",
      "readingMinutes": 1
    },
    {
      "id": "l306-t3",
      "type": "teaching",
      "title": "地点 · địa điểm cụ thể",
      "text": "地点 thường là điểm được xác định cho sự kiện: 见面地点. Không dùng như mọi nghĩa của 地方 trong mọi câu.",
      "hanzi": "我们见面的地点在车站门口。",
      "pinyin": "Wǒmen jiànmiàn de dìdiǎn zài chēzhàn ménkǒu.",
      "meaning": "Điểm gặp nhau là cửa ga.",
      "readingMinutes": 1
    },
    {
      "id": "l306-t4",
      "type": "teaching",
      "title": "地方 · nơi/chỗ",
      "text": "地方 chỉ nơi/chỗ nói chung. 这个地方 rộng hơn một điểm hẹn; khác 地点 thường gắn với điểm xác định của hoạt động.",
      "hanzi": "这个地方离学校很近。",
      "pinyin": "Zhège dìfang lí xuéxiào hěn jìn.",
      "meaning": "Nơi này gần trường.",
      "readingMinutes": 1
    },
    {
      "id": "l306-t5",
      "type": "teaching",
      "title": "环境 · môi trường/khung cảnh",
      "text": "环境 mô tả điều kiện xung quanh như yên tĩnh, sạch. Không coi đây chỉ là thời tiết hoặc một đồ vật riêng.",
      "hanzi": "这里的环境很安静。",
      "pinyin": "Zhèlǐ de huánjìng hěn ānjìng.",
      "meaning": "Môi trường ở đây yên tĩnh.",
      "readingMinutes": 1
    },
    {
      "id": "l306-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "对我来说 giới hạn nhận xét theo góc nhìn người nói. Một nơi thuận tiện cho người cần tàu điện không có nghĩa thuận tiện cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l306-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：这家宾馆怎么样？小李：对我来说，这个地方很方便，附近有地铁站。小安：环境呢？小李：晚上很安静。我们见面的地点就在宾馆门口，不用去车站。",
      "pinyin": "Xiǎo Ān: Zhè jiā bīnguǎn zěnmeyàng? Xiǎo Lǐ: Duì wǒ lái shuō, zhège dìfang hěn fāngbiàn, fùjìn yǒu dìtiězhàn. Xiǎo Ān: Huánjìng ne? Xiǎo Lǐ: Wǎnshang hěn ānjìng. Wǒmen jiànmiàn de dìdiǎn jiù zài bīnguǎn ménkǒu, búyòng qù chēzhàn.",
      "meaning": "An hỏi khách sạn. Lý thấy nơi này tiện vì gần ga tàu điện, buổi tối yên tĩnh. Hai người gặp ngay cửa khách sạn, không phải cửa ga.",
      "readingMinutes": 2
    },
