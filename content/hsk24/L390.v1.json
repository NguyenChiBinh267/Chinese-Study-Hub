    },
    {
      "id": "l390-reminder1",
      "type": "teaching",
      "title": "黑板 · bảng lớp",
      "text": "黑板 gọi bảng dùng trong lớp; không bắt buộc mọi bảng thực tế có đúng màu đen. Phân biệt đồ dùng bảng với vở cá nhân.",
      "hanzi": "老师在黑板上写了三个词。",
      "pinyin": "Lǎoshī zài hēibǎn shang xiě le sān ge cí.",
      "meaning": "Thầy viết ba từ lên bảng.",
      "readingMinutes": 1
    },
    {
      "id": "l390-reminder2",
      "type": "teaching",
      "title": "句子 · câu",
      "text": "句子 diễn đạt một ý theo cấu trúc; khác một mục từ đơn lẻ. 这个句子 nói câu cụ thể, không phải cả quyển sách.",
      "hanzi": "请用这个词写一个句子。",
      "pinyin": "Qǐng yòng zhège cí xiě yí ge jùzi.",
      "meaning": "Hãy dùng từ này viết một câu.",
      "readingMinutes": 1
    },
    {
      "id": "l390-reminder3",
      "type": "teaching",
      "title": "复习 · ôn lại",
      "text": "复习 nhìn lại nội dung đã học. Đọc một bài hoàn toàn mới lần đầu không tự động gọi là 复习.",
      "hanzi": "考试前，我先复习课文。",
      "pinyin": "Kǎoshì qián, wǒ xiān fùxí kèwén.",
      "meaning": "Trước kiểm tra tôi ôn bài khóa trước.",
      "readingMinutes": 1
    },
    {
      "id": "l390-reminder4",
      "type": "teaching",
      "title": "练习 · luyện tập",
      "text": "练习 là làm để tập kỹ năng; có thể là động từ hoặc bài tập theo ngữ cảnh. 练习写句子 là luyện viết câu, không chỉ nhìn đáp án.",
      "hanzi": "我每天练习写三个句子。",
      "pinyin": "Wǒ měi tiān liànxí xiě sān ge jùzi.",
      "meaning": "Mỗi ngày tôi luyện viết ba câu.",
      "readingMinutes": 1
    },
    {
      "id": "l390-reminder5",
      "type": "teaching",
      "title": "简单 · đơn giản",
      "text": "简单 mô tả ít phức tạp; không nhất thiết đồng nghĩa không cần luyện. 对我来说很简单 là đơn giản đối với tôi.",
      "hanzi": "这个句子很简单。",
      "pinyin": "Zhège jùzi hěn jiǎndān.",
      "meaning": "Câu này rất đơn giản.",
      "readingMinutes": 1
    },
    {
      "id": "l390-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
