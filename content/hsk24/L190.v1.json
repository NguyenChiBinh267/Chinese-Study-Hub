  "blocks": [
    {
      "id": "l190-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder0",
      "type": "teaching",
      "title": "年 · năm (đơn vị thời gian)",
      "text": "Nhắc nghĩa đã học: năm (đơn vị thời gian). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我学汉语一年了。",
      "pinyin": "Wǒ xué Hàn yǔ yì nián le.",
      "meaning": "Tôi học tiếng Trung được một năm rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder1",
      "type": "teaching",
      "title": "月 · tháng (lịch hoặc đơn vị)",
      "text": "Nhắc nghĩa đã học: tháng (lịch hoặc đơn vị). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我五月去学校。",
      "pinyin": "Wǒ wǔ yuè qù xué xiào.",
      "meaning": "Tôi đến trường vào tháng5.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder2",
      "type": "teaching",
      "title": "时间 · thời gian (dạng shíjiān)",
      "text": "Nhắc nghĩa đã học: thời gian (dạng shíjiān). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我今天没有时间。",
      "pinyin": "Wǒ jīn tiān méi yǒu shí jiān.",
      "meaning": "Hôm nay tôi không có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder3",
      "type": "teaching",
      "title": "上午 · buổi sáng trước trưa (dạng shàngwǔ)",
      "text": "Nhắc nghĩa đã học: buổi sáng trước trưa (dạng shàngwǔ). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我妹妹上午上学。",
      "pinyin": "Wǒ mèi mei shàng wǔ shàng xué.",
      "meaning": "Em gái tôi đi học buổi sáng.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder4",
      "type": "teaching",
      "title": "晚上 · buổi tối; buổi đêm",
      "text": "Nhắc nghĩa đã học: buổi tối; buổi đêm. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我晚上想读书。",
      "pinyin": "Wǒ wǎn shang xiǎng dú shū.",
      "meaning": "Buổi tối tôi muốn đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reminder5",
      "type": "teaching",
      "title": "白天 · ban ngày",
      "text": "Nhắc nghĩa đã học: ban ngày. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "白天我在公司工作。",
      "pinyin": "Bái tiān wǒ zài gōng sī gōng zuò.",
      "meaning": "Ban ngày tôi làm việc ở công ty.",
      "readingMinutes": 1
    },
    {
      "id": "l190-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你星期日有时间吗？\nB：有。我上午读书，下午去学校。\nA：晚上呢？\nB：晚上我在家。",
      "pinyin": "A: Nǐ xīng qī rì yǒu shí jiān ma? B: Yǒu. Wǒ shàng wǔ dú shū, xià wǔ qù xué xiào. A: Wǎn shang ne? B: Wǎn shang wǒ zài jiā.",
      "meaning": "B có thời gian vào Chủ nhật: sáng đọc sách, chiều đến trường, tối ở nhà. Đây là lịch nhân vật, không phải lịch được lưu của người học.",
      "readingMinutes": 2
    },
