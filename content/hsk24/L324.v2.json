  "blocks": [
    {
      "id": "l324-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 上班 shàng bān: đi làm; 当作 dàngzuò: coi như. Phân biệt nghỉ theo lịch trường với xin phép cá nhân, không dạy quy định lao động thực tế.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l324-t0",
      "type": "teaching",
      "title": "工作日 · ngày làm việc",
      "text": "工作日 theo lịch làm việc cụ thể; không mặc định mọi thứ Hai–Sáu hay mọi người có cùng lịch.",
      "hanzi": "工作日我七点出门。",
      "pinyin": "Gōngzuòrì wǒ qī diǎn chū mén.",
      "meaning": "Ngày làm việc tôi ra khỏi nhà lúc bảy giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l324-t1",
      "type": "teaching",
      "title": "周末 · cuối tuần",
      "text": "周末 thường là cuối tuần; không tự bảo đảm ai cũng được nghỉ. 这个周末指 cuối tuần đang xét.",
      "hanzi": "这个周末我不出门。",
      "pinyin": "Zhège zhōumò wǒ bù chū mén.",
      "meaning": "Cuối tuần này tôi không ra ngoài.",
      "readingMinutes": 1
    },
    {
      "id": "l324-t2",
      "type": "teaching",
      "title": "放假 · được nghỉ/nghỉ lễ",
      "text": "放假 là cơ quan/trường nghỉ theo lịch; khác 请假 là cá nhân xin phép nghỉ.",
      "hanzi": "学校明天放假。",
      "pinyin": "Xuéxiào míngtiān fàng jià.",
      "meaning": "Ngày mai trường nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l324-t3",
      "type": "teaching",
      "title": "放学 · tan học",
      "text": "放学 chỉ kết thúc buổi học, không đồng nghĩa nghỉ cả kỳ hay tốt nghiệp.",
      "hanzi": "我放学以后回家。",
      "pinyin": "Wǒ fàng xué yǐhòu huí jiā.",
      "meaning": "Sau tan học tôi về nhà.",
      "readingMinutes": 1
    },
    {
      "id": "l324-t4",
      "type": "teaching",
      "title": "请假 · xin nghỉ phép/xin nghỉ học",
      "text": "请假 là xin phép nghỉ; 请假了 chưa tự cho biết được chấp thuận nếu ngữ cảnh không nói. 跟老师请假 là xin thầy cho nghỉ.",
      "hanzi": "他想跟老师请假。",
      "pinyin": "Tā xiǎng gēn lǎoshī qǐng jià.",
      "meaning": "Cậu ấy muốn xin thầy cho nghỉ.",
      "readingMinutes": 1
    },
    {
      "id": "l324-t5",
      "type": "teaching",
      "title": "休假 · nghỉ phép",
      "text": "休假 nói đang/hưởng thời gian nghỉ, không chỉ hành vi nộp đơn; 休假三天 là nghỉ ba ngày.",
      "hanzi": "她下周休假三天。",
      "pinyin": "Tā xià zhōu xiū jià sān tiān.",
      "meaning": "Tuần sau cô ấy nghỉ phép ba ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l324-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "请假以前先问老师 đặt mốc “trước khi xin nghỉ” ở đầu hoặc sau chủ ngữ, trước việc làm. 放学以后 là sau tan học; không đồng nghĩa đang nghỉ phép.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l324-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林：学校明天放假吗？小王：不放假，明天是工作日。我放学以后去看休假的姐姐。小林：那周末呢？小王：周末在家。请假以前，要先问老师，不能自己当作已经放假。",
      "pinyin": "Xiǎo Lín: Xuéxiào míngtiān fàng jià ma? Xiǎo Wáng: Bú fàng jià, míngtiān shì gōngzuòrì. Wǒ fàng xué yǐhòu qù kàn xiūjià de jiějie. Xiǎo Lín: Nà zhōumò ne? Xiǎo Wáng: Zhōumò zài jiā. Qǐng jià yǐqián, yào xiān wèn lǎoshī, bù néng zìjǐ dàngzuò yǐjīng fàng jià.",
      "meaning": "Ngày mai trường không nghỉ. Vương định thăm chị đang nghỉ phép sau tan học, cuối tuần ở nhà; muốn xin nghỉ phải hỏi thầy trước.",
      "readingMinutes": 2
    },
    {
      "id": "l324-b0",
      "type": "exercise",
      "exerciseVersionId": "l324-v2-e0"
    },
    {
