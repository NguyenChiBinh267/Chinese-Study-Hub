  "blocks": [
    {
      "id": "l445-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 读物 dúwù: tài liệu đọc; 耐心 nàixīn: kiên nhẫn; 承认 chéngrèn: thừa nhận; 具体 jùtǐ: cụ thể; 行为 xíngwéi: hành vi.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l445-t0",
      "type": "teaching",
      "title": "家庭 · gia đình",
      "text": "家庭 nhấn mạnh tập thể/đời sống gia đình, khác 家 còn chỉ nhà ở.",
      "hanzi": "这个家庭喜欢一起阅读。",
      "pinyin": "Zhè ge jiātíng xǐhuan yìqǐ yuèdú.",
      "meaning": "Gia đình này thích cùng đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l445-t1",
      "type": "teaching",
      "title": "家长 · cha mẹ, người giám hộ",
      "text": "家长 ở ngữ cảnh trường học là phụ huynh/người chăm sóc chính, không nhất thiết chỉ bố.",
      "hanzi": "老师请家长参加讨论。",
      "pinyin": "Lǎoshī qǐng jiāzhǎng cānjiā tǎolùn.",
      "meaning": "Thầy mời phụ huynh dự thảo luận.",
      "readingMinutes": 1
    },
    {
      "id": "l445-t2",
      "type": "teaching",
      "title": "教育 · giáo dục",
      "text": "教育 có thể chỉ hoạt động giáo dục; bài không dùng nó để mắng người.",
      "hanzi": "家庭教育需要耐心。",
      "pinyin": "Jiātíng jiàoyù xūyào nàixīn.",
      "meaning": "Giáo dục gia đình cần kiên nhẫn.",
      "readingMinutes": 1
    },
    {
      "id": "l445-t3",
      "type": "teaching",
      "title": "儿童 · trẻ em",
      "text": "儿童 là danh từ trang trọng, như 儿童读物; không gọi trực tiếp một trẻ là 儿童 trong hội thoại thân mật.",
      "hanzi": "这里有儿童读物。",
      "pinyin": "Zhèlǐ yǒu értóng dúwù.",
      "meaning": "Ở đây có sách dành cho trẻ em.",
      "readingMinutes": 1
    },
    {
      "id": "l445-t4",
      "type": "teaching",
      "title": "骄傲 · kiêu ngạo; tự hào",
      "text": "骄傲 có hai sắc thái: 为孩子骄傲 là tự hào, 骄傲得不听意见 là kiêu ngạo. Bài luyện sắc thái tự hào. Nhận diện chữ 骄 trong 骄傲; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我为孩子的诚实感到骄傲。",
      "pinyin": "Wǒ wèi háizi de chéngshí gǎndào jiāoào.",
      "meaning": "Tôi tự hào vì con trung thực.",
      "readingMinutes": 1
    },
    {
      "id": "l445-t5",
      "type": "teaching",
      "title": "批评 · phê bình",
      "text": "批评 là chỉ ra lỗi/thiếu sót; nên nói hành vi cụ thể, không đồng nhất với xúc phạm.",
      "hanzi": "老师批评了他迟到的行为。",
      "pinyin": "Lǎoshī pīpíng le tā chídào de xíngwéi.",
      "meaning": "Thầy phê bình việc cậu đi muộn.",
      "readingMinutes": 1
    },
    {
      "id": "l445-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "让 + người + động từ diễn đạt yêu cầu/cho phép hoặc khiến ai làm gì, tùy ngữ cảnh. Ở đây 家长让孩子自己说明原因 là cha mẹ yêu cầu con tự giải thích, không phải cho con tên gọi. Đối tượng của 让 đứng trước hành động.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l445-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "家长会上，老师介绍适合儿童的读物，也谈到家庭教育。小文的母亲说：“孩子做错事时，我先让他自己说明原因，再批评具体行为。这次他主动承认错误，我为他的诚实感到骄傲。”老师提醒大家多听孩子的想法。",
      "pinyin": "Jiāzhǎnghuì shàng, lǎoshī jièshào shìhé értóng de dúwù, yě tán dào jiātíng jiàoyù. Xiǎo Wén de mǔqīn shuō: “Háizi zuò cuò shì shí, wǒ xiān ràng tā zìjǐ shuōmíng yuányīn, zài pīpíng jùtǐ xíngwéi. Zhè cì tā zhǔdòng chéngrèn cuòwù, wǒ wèi tā de chéngshí gǎndào jiāoào.” Lǎoshī tíxǐng dàjiā duō tīng háizi de xiǎngfǎ.",
      "meaning": "Họp phụ huynh bàn sách trẻ em và giáo dục gia đình. Mẹ Văn cho con giải thích trước, rồi góp ý hành vi cụ thể. Bà tự hào vì con chủ động nhận lỗi.",
      "readingMinutes": 2
    },
