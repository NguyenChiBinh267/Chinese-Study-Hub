  "blocks": [
    {
      "id": "l185-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder0",
      "type": "teaching",
      "title": "学 · học",
      "text": "Nhắc nghĩa đã học: học. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我和我的同学学汉语。",
      "pinyin": "Wǒ hé wǒ de tóng xué xué Hàn yǔ.",
      "meaning": "Tôi và bạn học của tôi học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder1",
      "type": "teaching",
      "title": "上课 · vào học; học trên lớp",
      "text": "Nhắc nghĩa đã học: vào học; học trên lớp. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我们上课，也读书。",
      "pinyin": "Wǒ men shàng kè, yě dú shū.",
      "meaning": "Chúng tôi học trên lớp, cũng đọc sách.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder2",
      "type": "teaching",
      "title": "听见 · nghe thấy; nghe được",
      "text": "Nhắc nghĩa đã học: nghe thấy; nghe được. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我没有听见，请再说。",
      "pinyin": "Wǒ méi yǒu tīng jiàn, qǐng zài shuō.",
      "meaning": "Tôi chưa nghe thấy, xin nói lại.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder3",
      "type": "teaching",
      "title": "可以 · có thể; được phép",
      "text": "Nhắc nghĩa đã học: có thể; được phép. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "你可以读我的书。",
      "pinyin": "Nǐ kě yǐ dú wǒ de shū.",
      "meaning": "Bạn có thể đọc sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder4",
      "type": "teaching",
      "title": "想 · muốn; nghĩ (theo ngữ cảnh)",
      "text": "Nhắc nghĩa đã học: muốn; nghĩ (theo ngữ cảnh). Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我也想学汉语。",
      "pinyin": "Wǒ yě xiǎng xué Hàn yǔ.",
      "meaning": "Tôi cũng muốn học tiếng Trung.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reminder5",
      "type": "teaching",
      "title": "没有 · không có; chưa có",
      "text": "Nhắc nghĩa đã học: không có; chưa có. Đọc ví dụ mới, phân biệt với các mục còn lại; không đổi nghĩa gốc hay thẻ ôn.",
      "hanzi": "我没有新书。",
      "pinyin": "Wǒ méi yǒu xīn shū.",
      "meaning": "Tôi không có sách mới.",
      "readingMinutes": 1
    },
    {
      "id": "l185-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你可以读这本书。\nB：谢谢，我想学汉语。\nA：你会写名字吗？\nB：会，我也会读汉字。",
      "pinyin": "A: Nǐ kě yǐ dú zhè běn shū. B: Xiè xie, wǒ xiǎng xué Hàn yǔ. A: Nǐ huì xiě míng zi ma? B: Huì, wǒ yě huì dú Hàn zì.",
      "meaning": "A cho B đọc sách. B nói muốn học tiếng Trung, biết viết tên và đọc chữ Hán. Đây là lời nhân vật, không phải xác nhận kỹ năng người học.",
      "readingMinutes": 2
    },
