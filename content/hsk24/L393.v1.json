  "blocks": [
    {
      "id": "l393-guide",
      "type": "teaching",
      "title": "Ôn/chẩn đoán có hỗ trợ · không phải đề HSK",
      "text": "Nên thử trước khi đọc phần nhắc lại. Bài vẫn có gợi ý; không suy từ điểm này ra mastery. Nghe, nói, viết tay và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder0",
      "type": "teaching",
      "title": "努力 · cố gắng/chăm chỉ",
      "text": "努力 có thể làm động từ cố gắng hoặc tính từ chăm chỉ. 努力学习 là cố gắng học; đây là hành động, không phải bảo đảm điểm.",
      "hanzi": "她每天都努力学习。",
      "pinyin": "Tā měi tiān dōu nǔlì xuéxí.",
      "meaning": "Ngày nào cô ấy cũng cố gắng học.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder1",
      "type": "teaching",
      "title": "应该 · nên/phải theo điều hợp lý",
      "text": "应该 nêu điều nên làm theo lời khuyên hoặc phán đoán. 你应该问老师 là nên hỏi thầy; không mặc nhiên là luật bắt buộc.",
      "hanzi": "不懂的时候，你应该问老师。",
      "pinyin": "Bù dǒng de shíhou, nǐ yīnggāi wèn lǎoshī.",
      "meaning": "Khi không hiểu, bạn nên hỏi thầy.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder2",
      "type": "teaching",
      "title": "一定 · nhất định/chắc chắn",
      "text": "一定 trong 我一定会努力 bày tỏ quyết tâm; trong 他一定知道 là phán đoán chắc. Không biến lời quyết tâm thành bằng chứng năng lực thực tế.",
      "hanzi": "我一定会认真复习。",
      "pinyin": "Wǒ yídìng huì rènzhēn fùxí.",
      "meaning": "Tôi nhất định sẽ ôn nghiêm túc.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder3",
      "type": "teaching",
      "title": "出发 · khởi hành",
      "text": "出发 nhấn bắt đầu chuyến đi; không phải đã đến nơi. 明天八点出发 là giờ khởi hành, không phải giờ tới.",
      "hanzi": "我们明天早上八点出发。",
      "pinyin": "Wǒmen míngtiān zǎoshang bā diǎn chūfā.",
      "meaning": "Chúng tôi khởi hành lúc 8 giờ sáng mai.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder4",
      "type": "teaching",
      "title": "行李 · hành lý",
      "text": "行李 chỉ đồ mang theo chuyến đi; thường dùng 件 khi đếm từng kiện. Không gọi giấy thông hành là hành lý khi hỏi loại giấy tờ.",
      "hanzi": "我的行李不多，只有一个包。",
      "pinyin": "Wǒ de xíngli bù duō, zhǐ yǒu yí ge bāo.",
      "meaning": "Hành lý tôi ít, chỉ có một túi.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder5",
      "type": "teaching",
      "title": "护照 · hộ chiếu",
      "text": "护照 là giấy tờ định danh đi quốc tế. Bài luyện nhận biết từ, không khẳng định yêu cầu nhập cảnh hay đi tàu thực tế ở bất kỳ nước nào.",
      "hanzi": "请不要忘了带护照。",
      "pinyin": "Qǐng bú yào wàng le dài hùzhào.",
      "meaning": "Xin đừng quên mang hộ chiếu.",
      "readingMinutes": 1
    },
    {
      "id": "l393-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "只要 nêu điều kiện đủ trong lời quy định hoặc kế hoạch cụ thể. 只要明天不下雨，我们就参加比赛 nói kế hoạch của nhóm, không suy ra cố gắng luôn bảo đảm điểm cao. 只要 là hỗ trợ của bài, không cộng thêm từ mới.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l393-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "老师：只要明天不下雨，我们就参加学校的中文比赛。小安：小李很聪明，一定得分最多吗？老师：不能这样说，比赛结果还不知道。小安：我会努力准备，不只看成绩。",
      "pinyin": "Lǎoshī: Zhǐyào míngtiān bú xià yǔ, wǒmen jiù cānjiā xuéxiào de Zhōngwén bǐsài. Xiǎo Ān: Xiǎo Lǐ hěn cōngmíng, yídìng défēn zuì duō ma? Lǎoshī: Bù néng zhèyàng shuō, bǐsài jiéguǒ hái bù zhīdào. Xiǎo Ān: Wǒ huì nǔlì zhǔnbèi, bù zhǐ kàn chéngjì.",
      "meaning": "Thầy nói nếu mai không mưa thì nhóm tham gia cuộc thi tiếng Trung của trường. An hỏi liệu Lý thông minh có chắc đạt nhiều điểm nhất. Thầy nói chưa biết kết quả. An sẽ cố gắng chuẩn bị, không chỉ nhìn thành tích.",
      "readingMinutes": 2
    },
