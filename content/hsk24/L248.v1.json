  "blocks": [
    {
      "id": "l248-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "在 là ở; 这/那 chỉ này/kia. Vị trí tương đối phụ thuộc mốc đang nói, không mặc định là hướng địa lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t0",
      "type": "teaching",
      "title": "Nhắc lại · 左边 · bên trái",
      "text": "边 trong 左边 đọc nhẹ theo mục từ nguồn. Nêu mốc rõ: 学校的左边.",
      "hanzi": "书店在学校的左边。",
      "pinyin": "Shūdiàn zài xuéxiào de zuǒbian.",
      "meaning": "Hiệu sách ở bên trái trường.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t1",
      "type": "teaching",
      "title": "Nhắc lại · 右边 · bên phải",
      "text": "Đối lập với 左边. 边 đọc nhẹ trong mục từ này, không đổi thành biān khi làm bài pinyin của từ đã cho.",
      "hanzi": "饭馆在书店的右边。",
      "pinyin": "Fànguǎn zài shūdiàn de yòubian.",
      "meaning": "Quán ăn ở bên phải hiệu sách.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t2",
      "type": "teaching",
      "title": "Nhắc lại · 前面 · phía trước",
      "text": "前面 ở đây là vị trí không gian, không phải tự động chỉ thời gian trước đó. 面 giữ thanh bốn theo nguồn.",
      "hanzi": "老师在教室前面。",
      "pinyin": "Lǎoshī zài jiàoshì qiánmiàn.",
      "meaning": "Giáo viên ở phía trước phòng học.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t3",
      "type": "teaching",
      "title": "Nhắc lại · 后面 · phía sau",
      "text": "Chỉ phía sau mốc nói đến; không đồng nghĩa với bên phải. 面 giữ thanh bốn.",
      "hanzi": "书包在椅子后面。",
      "pinyin": "Shūbāo zài yǐzi hòumiàn.",
      "meaning": "Cặp sách ở sau ghế.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t4",
      "type": "teaching",
      "title": "Nhắc lại · 旁边 · bên cạnh",
      "text": "旁边 chỉ ở sát hoặc gần một bên, chưa xác định trái/phải.",
      "hanzi": "我家旁边有一家书店。",
      "pinyin": "Wǒ jiā pángbiān yǒu yì jiā shūdiàn.",
      "meaning": "Bên cạnh nhà tôi có một hiệu sách.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-t5",
      "type": "teaching",
      "title": "Nhắc lại · 里面 · bên trong",
      "text": "里面 chỉ không gian bên trong, có thể đặt sau mốc: 书包里面. Không dùng để chỉ phía trước.",
      "hanzi": "书包里面有两本书。",
      "pinyin": "Shūbāo lǐmiàn yǒu liǎng běn shū.",
      "meaning": "Trong cặp có hai quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l248-t0-l208-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "面 tạo thành một số từ vị trí như 前面, 后面, 里面. Không tự thêm 面 vào mọi từ; bài giữ nguyên từ đã học như 旁边.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l248-t0-l208-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的书包在哪里？乙：在椅子后面。甲：里面有我的书吗？乙：有，在本子旁边。",
      "pinyin": "Jiǎ: Nǐ de shūbāo zài nǎlǐ? Yǐ: Zài yǐzi hòumiàn. Jiǎ: Lǐmiàn yǒu wǒ de shū ma? Yǐ: Yǒu, zài běnzi pángbiān.",
      "meaning": "A: Cặp bạn ở đâu? B: Ở sau ghế. A: Trong đó có sách của tôi không? B: Có, bên cạnh quyển vở.",
      "readingMinutes": 2
    },
    {
