  "blocks": [
    {
      "id": "l332-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 确认 quèrèn: xác nhận; 方向 fāngxiàng: phương hướng; 银行 yínháng: ngân hàng. Nội dung là sơ đồ chữ hư cấu, không chỉ đường ngoài đời.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l332-t0",
      "type": "teaching",
      "title": "北方 · phía/vùng bắc",
      "text": "北方 là phía bắc hoặc miền bắc theo mốc đang nói; cần biết mốc, không tự đồng nhất với một tỉnh.",
      "hanzi": "这个城市在北方。",
      "pinyin": "Zhège chéngshì zài běifāng.",
      "meaning": "Thành phố này ở miền bắc.",
      "readingMinutes": 1
    },
    {
      "id": "l332-t1",
      "type": "teaching",
      "title": "南方 · phía/vùng nam",
      "text": "南方 là phía nam/miền nam theo bối cảnh, không phải tên riêng của một nước. 从南方来 nói từ miền nam đến.",
      "hanzi": "她从南方来。",
      "pinyin": "Tā cóng nánfāng lái.",
      "meaning": "Cô ấy đến từ miền nam.",
      "readingMinutes": 1
    },
    {
      "id": "l332-t2",
      "type": "teaching",
      "title": "东北 · đông bắc",
      "text": "东北 nằm giữa đông và bắc trên sơ đồ; không đảo thành 西北 khi xác định góc.",
      "hanzi": "学校在公园的东北。",
      "pinyin": "Xuéxiào zài gōngyuán de dōngběi.",
      "meaning": "Trường ở phía đông bắc công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l332-t3",
      "type": "teaching",
      "title": "东南 · đông nam",
      "text": "东南 nằm giữa đông và nam; chữ 南 quyết định nửa phía nam trong đối chiếu 东北.",
      "hanzi": "银行在学校的东南。",
      "pinyin": "Yínháng zài xuéxiào de dōngnán.",
      "meaning": "Ngân hàng ở đông nam trường.",
      "readingMinutes": 1
    },
    {
      "id": "l332-t4",
      "type": "teaching",
      "title": "西北 · tây bắc",
      "text": "西北 nằm giữa tây và bắc; 西 ở đầu ghép với 北, không phải một hướng nam.",
      "hanzi": "图书馆在公园的西北。",
      "pinyin": "Túshūguǎn zài gōngyuán de xīběi.",
      "meaning": "Thư viện ở tây bắc công viên.",
      "readingMinutes": 1
    },
    {
      "id": "l332-t5",
      "type": "teaching",
      "title": "西南 · tây nam",
      "text": "西南 nằm giữa tây và nam; dùng 地点+的西南 nêu vị trí tương đối trên sơ đồ.",
      "hanzi": "我家在学校的西南。",
      "pinyin": "Wǒ jiā zài xuéxiào de xīnán.",
      "meaning": "Nhà tôi ở tây nam trường.",
      "readingMinutes": 1
    },
    {
      "id": "l332-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "北方/南方 chỉ phía/vùng bắc hoặc nam. 东北, 东南, 西北, 西南 ghép hai hướng. Sơ đồ bài lấy bắc ở trên; đời thực phải kiểm tra ký hiệu, không mặc định mọi bản đồ cùng hướng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l332-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "这张图上，北方在上面，南方在下面。公园东北是学校，西北是图书馆。银行在学校东南，小林家在学校西南。出门以前，他们先确认图上的方向。",
      "pinyin": "Zhè zhāng tú shàng, běifāng zài shàngmian, nánfāng zài xiàmian. Gōngyuán dōngběi shì xuéxiào, xīběi shì túshūguǎn. Yínháng zài xuéxiào dōngnán, Xiǎo Lín jiā zài xuéxiào xīnán. Chū mén yǐqián, tāmen xiān quèrèn tú shàng de fāngxiàng.",
      "meaning": "Sơ đồ này có bắc ở trên, nam ở dưới. Trường ở đông bắc công viên, thư viện ở tây bắc. Ngân hàng ở đông nam trường, nhà Lâm ở tây nam trường.",
      "readingMinutes": 2
    },
    {
      "id": "l332-b0",
      "type": "exercise",
      "exerciseVersionId": "l332-v1-e0"
    },
