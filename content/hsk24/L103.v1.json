  "blocks": [
    {
      "id": "l103-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l103-t0",
      "type": "teaching",
      "title": "他 · anh ấy; ông ấy",
      "text": "他 dùng thay người nam trong tình huống đã biết; không đoán giới tính chỉ từ tên.",
      "hanzi": "他叫安。",
      "pinyin": "Tā jiào Ān.",
      "meaning": "Anh ấy tên An.",
      "readingMinutes": 1
    },
    {
      "id": "l103-t1",
      "type": "teaching",
      "title": "她 · cô ấy; bà ấy",
      "text": "她 cùng âm tā với 他, khác chữ viết và đối tượng đang được nhắc.",
      "hanzi": "她叫林。",
      "pinyin": "Tā jiào Lín.",
      "meaning": "Cô ấy tên Lâm.",
      "readingMinutes": 1
    },
    {
      "id": "l103-t2",
      "type": "teaching",
      "title": "男 · nam",
      "text": "男 có thể xuất hiện như nhãn giới tính trên phiếu; 性别 được chú giải là “giới tính”, không tính mục từ mới.",
      "hanzi": "性别：男。",
      "pinyin": "Xìng bié: nán.",
      "meaning": "Giới tính: nam.",
      "readingMinutes": 1
    },
    {
      "id": "l103-t3",
      "type": "teaching",
      "title": "女 · nữ",
      "text": "女 ở phiếu dưới đây là nhãn nữ, không phải toàn bộ nghĩa “con gái của ai”.",
      "hanzi": "性别：女。",
      "pinyin": "Xìng bié: nǚ.",
      "meaning": "Giới tính: nữ.",
      "readingMinutes": 1
    },
    {
      "id": "l103-t4",
      "type": "teaching",
      "title": "朋友 · bạn; bạn bè",
      "text": "朋友 gọi người bạn; không tự hiểu là 男朋友/女朋友.",
      "hanzi": "你好，朋友！",
      "pinyin": "Nǐ hǎo, péng you!",
      "meaning": "Chào bạn!",
      "readingMinutes": 1
    },
    {
      "id": "l103-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "他 và 她 đều đọc tā; trong bài chữ, 他 dùng cho người nam, 她 cho người nữ theo thông tin đã cho. Không thể phân biệt hai chữ chỉ từ âm tā. 男/女 trong phiếu là nhãn nam/nữ; 朋友 không tự có nghĩa người yêu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l103-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "Phiếu trong truyện ghi：安，男；林，女。\nA：我认识他，他叫安。\nB：我认识她，她叫林。\nA：你好，朋友！",
      "pinyin": "Phiếu: Ān, nán; Lín, nǚ. A: Wǒ rèn shi tā, tā jiào Ān. B: Wǒ rèn shi tā, tā jiào Lín. A: Nǐ hǎo, péng you!",
      "meaning": "Nam/nữ đã được ghi rõ trên phiếu hư cấu; không suy từ tên người hoặc từ âm tā.",
      "readingMinutes": 2
    },
