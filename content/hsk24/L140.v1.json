  "blocks": [
    {
      "id": "l140-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l140-t0",
      "type": "teaching",
      "title": "电脑 · máy tính",
      "text": "电脑 là máy tính, không phải màn hình hay phim đang chiếu trong mọi câu.",
      "hanzi": "我有电脑。",
      "pinyin": "Wǒ yǒu diàn nǎo.",
      "meaning": "Tôi có máy tính.",
      "readingMinutes": 1
    },
    {
      "id": "l140-t1",
      "type": "teaching",
      "title": "电视 · tivi; truyền hình",
      "text": "电视 trong 看电视 là xem tivi; 看 kàn được chú giải là xem, chưa tính từ mục tiêu mới của bài.",
      "hanzi": "我喜欢看电视。",
      "pinyin": "Wǒ xǐ huan kàn diàn shì.",
      "meaning": "Tôi thích xem tivi.",
      "readingMinutes": 1
    },
    {
      "id": "l140-t2",
      "type": "teaching",
      "title": "电影 · phim; điện ảnh",
      "text": "电影 chỉ phim/điện ảnh, không tự là địa điểm rạp chiếu.",
      "hanzi": "我喜欢电影。",
      "pinyin": "Wǒ xǐ huan diàn yǐng.",
      "meaning": "Tôi thích phim.",
      "readingMinutes": 1
    },
    {
      "id": "l140-t3",
      "type": "teaching",
      "title": "电影院 · rạp chiếu phim",
      "text": "电影院 là nơi xem phim; không bỏ 院 khi đề hỏi địa điểm này.",
      "hanzi": "我们去电影院。",
      "pinyin": "Wǒ men qù diàn yǐng yuàn.",
      "meaning": "Chúng tôi đến rạp chiếu phim.",
      "readingMinutes": 1
    },
    {
      "id": "l140-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "也 thêm một chủ thể cùng hành động/tình trạng: 我也喜欢电影. Đặt 也 sau chủ ngữ và trước động từ/cụm vị ngữ trong mẫu này. Phân biệt 电影 là phim và 电影院 là rạp; tên thiết bị/địa điểm không chứng minh đã xem hay nghe nội dung thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l140-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：你喜欢电影吗？\nB：喜欢。你呢？\nA：我也喜欢电影。\nB：我们去电影院，好吗？\nA：好！",
      "pinyin": "A: Nǐ xǐ huan diàn yǐng ma? B: Xǐ huan. Nǐ ne? A: Wǒ yě xǐ huan diàn yǐng. B: Wǒ men qù diàn yǐng yuàn, hǎo ma? A: Hǎo!",
      "meaning": "Hai người đều thích phim và đồng ý đến rạp. Đoạn chưa nói đã tới hoặc đã xem xong một bộ phim.",
      "readingMinutes": 2
    },
