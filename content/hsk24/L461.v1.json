  "blocks": [
    {
      "id": "l461-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 气温 qìwēn: nhiệt độ không khí; 清新 qīngxīn: trong lành; 预报 yùbào: dự báo; số liệu hư cấu, không phải thời tiết hiện tại.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l461-t0",
      "type": "teaching",
      "title": "降 · hạ xuống",
      "text": "降 jiàng trong 温度降了 nói giảm/hạ; không dùng đọc xiáng đầu hàng ở đây.",
      "hanzi": "气温降了五度。",
      "pinyin": "Qìwēn jiàng le wǔ dù.",
      "meaning": "Nhiệt độ không khí giảm năm độ.",
      "readingMinutes": 1
    },
    {
      "id": "l461-t1",
      "type": "teaching",
      "title": "降落 · hạ cánh",
      "text": "降落 nói máy bay/chim đáp xuống; khác 起飞 là cất cánh.",
      "hanzi": "飞机安全降落了。",
      "pinyin": "Fēijī ānquán jiàngluò le.",
      "meaning": "Máy bay hạ cánh an toàn.",
      "readingMinutes": 1
    },
    {
      "id": "l461-t2",
      "type": "teaching",
      "title": "降温 · giảm nhiệt",
      "text": "降温 là nhiệt độ hạ hoặc làm hạ nhiệt; ví dụ dự báo dùng nghĩa thời tiết.",
      "hanzi": "明天也许会降温。",
      "pinyin": "Míngtiān yěxǔ huì jiàngwēn.",
      "meaning": "Mai có thể nhiệt độ sẽ giảm.",
      "readingMinutes": 1
    },
    {
      "id": "l461-t3",
      "type": "teaching",
      "title": "零下 · dưới không độ",
      "text": "零下 đứng trước nhiệt độ âm; 零下三度 là -3 độ trong ngữ cảnh nhiệt độ.",
      "hanzi": "早晨气温是零下三度。",
      "pinyin": "Zǎochén qìwēn shì líng xià sān dù.",
      "meaning": "Sáng nhiệt độ âm ba độ.",
      "readingMinutes": 1
    },
    {
      "id": "l461-t4",
      "type": "teaching",
      "title": "空气 · không khí",
      "text": "空气 chỉ không khí; 空 đọc kōng, khác kòng trong 有空.",
      "hanzi": "雨后的空气很清新。",
      "pinyin": "Yǔ hòu de kōngqì hěn qīngxīn.",
      "meaning": "Không khí sau mưa trong lành.",
      "readingMinutes": 1
    },
    {
      "id": "l461-t5",
      "type": "teaching",
      "title": "暖和 · ấm áp",
      "text": "暖和 nuǎn huo với 和 nhẹ; thường dùng thời tiết/quần áo, không phải nước nóng sôi. Nhận diện chữ 暖 trong 暖和; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "屋里比外面暖和。",
      "pinyin": "Wū lǐ bǐ wàimiàn nuǎnhuo.",
      "meaning": "Trong nhà ấm hơn ngoài trời.",
      "readingMinutes": 1
    },
    {
      "id": "l461-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "也许 trước nhận định nêu khả năng chưa chắc: 明天也许会降温. Không thay đổi nó thành 已经 để kể sự việc đã xảy ra. Bài phân biệt dự báo có thể với nhiệt độ quan sát trong câu chuyện.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l461-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "旅行前，小姚读了一份虚构的天气记录：早晨零下三度，比昨天降了五度；明天也许会降温。她准备了暖和的外套。飞机降落后，她走出机场，觉得空气清新。朋友提醒，明天的天气还要看新的预报。",
      "pinyin": "Lǚxíng qián, Xiǎo Yáo dú le yí fèn xūgòu de tiānqì jìlù: zǎochén líng xià sān dù, bǐ zuótiān jiàng le wǔ dù; míngtiān yěxǔ huì jiàngwēn. Tā zhǔnbèi le nuǎnhuo de wàitào. Fēijī jiàngluò hòu, tā zǒu chū jīchǎng, juéde kōngqì qīngxīn. Péngyou tíxǐng, míngtiān de tiānqì hái yào kàn xīn de yùbào.",
      "meaning": "Dao đọc bản ghi thời tiết hư cấu âm ba độ, giảm năm độ; ngày mai chỉ là dự báo có thể lạnh hơn. Cô mang áo ấm và sẽ xem bản tin mới.",
      "readingMinutes": 2
    },
    {
