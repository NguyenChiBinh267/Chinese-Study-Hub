  "blocks": [
    {
      "id": "l315-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc thời gian, chủ ngữ–động từ–tân ngữ, 的 và câu hỏi cơ bản. HSK1/2 prerequisite vẫn chưa được xác nhận. 讲 jiǎng: kể/nói; 一边 yìbiān: vừa…vừa…; 新闻 xīnwén: tin tức chỉ dùng đối chiếu. “Nghe” trong câu chuyện là nội dung đọc; bài không có audio tham chiếu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l315-t0",
      "type": "teaching",
      "title": "节目 · tiết mục/chương trình",
      "text": "节目 là tiết mục hoặc chương trình cụ thể; không phải toàn bộ tên một ngày lễ. 第一个节目指节目次序.",
      "hanzi": "今天的第一个节目是讲故事。",
      "pinyin": "Jīntiān de dì yī ge jiémù shì jiǎng gùshi.",
      "meaning": "Tiết mục đầu hôm nay là kể chuyện.",
      "readingMinutes": 1
    },
    {
      "id": "l315-t1",
      "type": "teaching",
      "title": "表演 · biểu diễn",
      "text": "表演 là trình diễn cho người xem hoặc một màn trình diễn. 看表演 và 自己表演 khác vai trò người xem/người diễn.",
      "hanzi": "学生们正在表演。",
      "pinyin": "Xuésheng men zhèngzài biǎoyǎn.",
      "meaning": "Các học sinh đang biểu diễn.",
      "readingMinutes": 1
    },
    {
      "id": "l315-t2",
      "type": "teaching",
      "title": "节日 · ngày lễ",
      "text": "节日 là ngày dịp lễ; không đồng nghĩa tiết mục. Bài chỉ nói một hoạt động hư cấu, không khẳng định phong tục mọi nơi giống nhau.",
      "hanzi": "这个节日，学校有活动。",
      "pinyin": "Zhège jiérì, xuéxiào yǒu huódòng.",
      "meaning": "Dịp lễ này trường có hoạt động.",
      "readingMinutes": 1
    },
    {
      "id": "l315-t3",
      "type": "teaching",
      "title": "过节 · đón/mừng lễ",
      "text": "过节 nói trải qua/mừng dịp lễ theo ngữ cảnh. Không tự hàm ý cách tổ chức hoặc món ăn cụ thể ở mọi gia đình.",
      "hanzi": "我们今年在学校过节。",
      "pinyin": "Wǒmen jīnnián zài xuéxiào guòjié.",
      "meaning": "Năm nay chúng tôi đón lễ ở trường.",
      "readingMinutes": 1
    },
    {
      "id": "l315-t4",
      "type": "teaching",
      "title": "故事 · câu chuyện",
      "text": "故事 là câu chuyện được kể; có thể hư cấu hoặc có thật, cần thêm thông tin để phân biệt. 一个故事不等于一条新闻.",
      "hanzi": "爷爷给我们讲了一个故事。",
      "pinyin": "Yéye gěi wǒmen jiǎng le yí ge gùshi.",
      "meaning": "Ông kể cho chúng tôi một chuyện.",
      "readingMinutes": 1
    },
    {
      "id": "l315-t5",
      "type": "teaching",
      "title": "欢迎 · hoan nghênh/chào mừng",
      "text": "欢迎常用于迎接和表示愿意对方来; bài dùng để chào mừng người đến. 欢迎你来 không phải báo cáo người đó đã đến.",
      "hanzi": "欢迎你来我们学校。",
      "pinyin": "Huānyíng nǐ lái wǒmen xuéxiào.",
      "meaning": "Chào mừng bạn đến trường chúng tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l315-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "一边听，一边记 mô tả hai hành động cùng tiến hành. Khác 先听，再记: nghe trước rồi ghi sau. Không dùng mẫu đồng thời cho hai hành động không thể diễn ra cùng nhau trong tình huống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l315-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：今天是节日，学校有什么节目？小李：先看学生表演，再听老师讲故事。小安：我想一边听，一边记新词。小李：好，欢迎你来和我们一起过节。",
      "pinyin": "Xiǎo Ān: Jīntiān shì jiérì, xuéxiào yǒu shénme jiémù? Xiǎo Lǐ: Xiān kàn xuésheng biǎoyǎn, zài tīng lǎoshī jiǎng gùshi. Xiǎo Ān: Wǒ xiǎng yìbiān tīng, yìbiān jì xīn cí. Xiǎo Lǐ: Hǎo, huānyíng nǐ lái hé wǒmen yìqǐ guòjié.",
      "meaning": "An hỏi chương trình dịp lễ của trường. Lý nói xem học sinh diễn trước rồi nghe thầy kể chuyện. An muốn vừa nghe vừa ghi từ mới. Lý chào mừng An cùng đón lễ.",
      "readingMinutes": 2
    },
