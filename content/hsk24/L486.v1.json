  "blocks": [
    {
      "id": "l486-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder0",
      "type": "teaching",
      "title": "倍 · lần (bội số)",
      "text": "倍 đếm số lần của cùng một đại lượng; 两倍 có nghĩa nhân hai, không tự là cộng hai đơn vị. Nhận diện chữ 倍 trong 倍; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "大盒子的容量是小盒子的两倍。",
      "pinyin": "Dà hézi de róngliàng shì xiǎo hézi de liǎng bèi.",
      "meaning": "Sức chứa hộp lớn bằng hai lần hộp nhỏ.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder1",
      "type": "teaching",
      "title": "低 · thấp",
      "text": "低 ở 价格低 là mức thấp, không dùng thay 矮 để nói chiều cao người trong mọi câu.",
      "hanzi": "小盒子的价格比较低。",
      "pinyin": "Xiǎo hézi de jiàgé bǐjiào dī.",
      "meaning": "Giá hộp nhỏ tương đối thấp.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder2",
      "type": "teaching",
      "title": "够 · đủ",
      "text": "够 nói đạt lượng cần trong ngữ cảnh; không tự có nghĩa dư thừa.",
      "hanzi": "两个小盒子就够了。",
      "pinyin": "Liǎng ge xiǎo hézi jiù gòu le.",
      "meaning": "Hai hộp nhỏ là đủ rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder3",
      "type": "teaching",
      "title": "赶 · vội đi, đuổi cho kịp",
      "text": "赶 trong 赶车 là vội đi bắt xe; chưa có nghĩa chắc chắn đã bắt kịp. Nhận diện chữ 赶 trong 赶; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他们正在赶最后一班车。",
      "pinyin": "Tāmen zhèngzài gǎn zuìhòu yì bān chē.",
      "meaning": "Họ đang vội bắt chuyến xe cuối.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder4",
      "type": "teaching",
      "title": "赶紧 · nhanh lên, mau (khi cần ngay)",
      "text": "赶紧 đặt trước hành động thúc làm sớm, không phải đơn vị thời gian.",
      "hanzi": "快下雨了，赶紧把窗关上。",
      "pinyin": "Kuài xià yǔ le, gǎnjǐn bǎ chuāng guān shàng.",
      "meaning": "Sắp mưa rồi, mau đóng cửa sổ.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder5",
      "type": "teaching",
      "title": "反对 · phản đối",
      "text": "反对 nhận đề xuất/hành động; không tự có nghĩa ghét người đưa ý kiến. Nhận diện chữ 反 trong 反对; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他们反对这个安排。",
      "pinyin": "Tāmen fǎnduì zhège ānpái.",
      "meaning": "Họ phản đối cách sắp xếp này.",
      "readingMinutes": 1
    },
    {
      "id": "l486-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "A是B的两倍 nói A bằng hai lần B. Không nhầm với 比B多两倍 là thêm hai lần B. Bài dùng số hư cấu, luôn nêu đơn vị và cùng đại lượng để so sánh.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l486-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "店员说明：大盒子能装二十本同样的书，小盒子能装十本，所以前者容量是后者的两倍。小方有十五本书，一个小盒子不够，两个就够。她还确认总重量不超过规定，并选择低于预算的价格。",
      "pinyin": "Diànyuán shuōmíng: Dà hézi néng zhuāng èrshí běn tóngyàng de shū, xiǎo hézi néng zhuāng shí běn, suǒyǐ qiánzhě róngliàng shì hòuzhě de liǎng bèi. Xiǎo Fāng yǒu shíwǔ běn shū, yí ge xiǎo hézi búgòu, liǎng ge jiù gòu. Tā hái quèrèn zǒng zhòngliàng bù chāoguò guīdìng, bìng xuǎnzé dīyú yùsuàn de jiàgé.",
      "meaning": "Hộp lớn đựng 20 quyển cùng loại, hộp nhỏ 10; tỷ lệ sức chứa là hai lần. Phương có 15 quyển nên cần hai hộp nhỏ nếu chọn loại nhỏ.",
      "readingMinutes": 2
    },
