  "blocks": [
    {
      "id": "l482-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder0",
      "type": "teaching",
      "title": "饼干 · bánh quy",
      "text": "饼干 chỉ bánh quy thường giòn; đếm theo 块 hoặc gói, không mặc định mọi loại bánh đều là 饼干. Nhận diện chữ 饼 trong 饼干; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "她把饼干收好了。",
      "pinyin": "Tā bǎ bǐnggān shōu hǎo le.",
      "meaning": "Cô ấy đã cất gọn bánh quy.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder1",
      "type": "teaching",
      "title": "茶叶 · lá trà",
      "text": "茶叶 là nguyên liệu khô để pha; phân biệt nước trà đã pha 茶水 trong ngữ cảnh phục vụ.",
      "hanzi": "请把茶叶放进盒子。",
      "pinyin": "Qǐng bǎ cháyè fàng jìn hézi.",
      "meaning": "Hãy bỏ lá trà vào hộp.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder2",
      "type": "teaching",
      "title": "餐厅 · nhà hàng, phòng ăn",
      "text": "餐厅 có thể là nhà hàng hoặc khu ăn uống; ở đây nói nơi khách dùng bữa.",
      "hanzi": "这家餐厅晚上六点开门。",
      "pinyin": "Zhè jiā cāntīng wǎnshang liù diǎn kāi mén.",
      "meaning": "Nhà hàng này mở cửa lúc sáu giờ tối.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder3",
      "type": "teaching",
      "title": "厨房 · nhà bếp",
      "text": "厨房 là nơi chế biến, không phải khu khách ngồi ăn; ở đoạn chỉ nhân viên được vào.",
      "hanzi": "客人不能随便进入厨房。",
      "pinyin": "Kèrén bù néng suíbiàn jìnrù chúfáng.",
      "meaning": "Khách không được tùy tiện vào bếp.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder4",
      "type": "teaching",
      "title": "刀 · dao",
      "text": "刀 ở đây là vật dụng cắt trong bếp; chỉ đọc và nhận diện lời nhắc, không hướng dẫn thao tác thực tế.",
      "hanzi": "这把刀用完后要放好。",
      "pinyin": "Zhè bǎ dāo yòng wán hòu yào fàng hǎo.",
      "meaning": "Con dao này dùng xong phải cất gọn.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder5",
      "type": "teaching",
      "title": "窗 · cửa sổ (dạng đơn âm)",
      "text": "窗 thường gặp trong 开窗、关窗; cùng chỉ cửa sổ như 窗户, nên bài yêu cầu phân biệt dạng một chữ và hai chữ khi truy hồi. Nhận diện chữ 窗 trong 窗; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "屋里太热了，请开窗。",
      "pinyin": "Wū lǐ tài rè le, qǐng kāi chuāng.",
      "meaning": "Trong phòng nóng quá, hãy mở cửa sổ.",
      "readingMinutes": 1
    },
    {
      "id": "l482-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "把 đưa vật chịu tác động lên trước động từ. Trong 把饼干收好了, kết quả 收好 làm rõ đã cất gọn. Không đặt một tính từ bất kỳ sau 把 mà thiếu hành động xử lý.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l482-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "餐厅开门前，厨师先检查厨房。小许把饼干收好了，把茶叶放进盒子，又确认刀已经放好。六点客人来了，他请大家在餐厅等，不要随便进入厨房。",
      "pinyin": "Cāntīng kāi mén qián, chúshī xiān jiǎnchá chúfáng. Xiǎo Xǔ bǎ bǐnggān shōu hǎo le, bǎ cháyè fàng jìn hézi, yòu quèrèn dāo yǐjīng fàng hǎo. Liù diǎn kèrén lái le, tā qǐng dàjiā zài cāntīng děng, bú yào suíbiàn jìnrù chúfáng.",
      "meaning": "Trước giờ mở cửa, đầu bếp kiểm tra bếp. Hứa cất bánh, bỏ trà vào hộp và kiểm tra dao đã được cất. Khách được mời chờ ở nhà hàng.",
      "readingMinutes": 2
    },
