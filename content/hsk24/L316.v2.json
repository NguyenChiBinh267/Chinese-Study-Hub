  "blocks": [
    {
      "id": "l316-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc thời gian, chủ ngữ–động từ–tân ngữ, 的 và câu hỏi cơ bản. HSK1/2 prerequisite vẫn chưa được xác nhận. 来自 láizì: đến từ; 不同 bù tóng: khác nhau; 当地 dāngdì: địa phương (hỗ trợ chưa xác minh cấp); 感兴趣 gǎn xìngqù: hứng thú. Nhánh 除了…还… là bổ sung, không đồng nghĩa loại trừ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l316-t0",
      "type": "teaching",
      "title": "城市 · thành phố",
      "text": "城市 là đơn vị/khu đô thị theo ngữ cảnh, khác 国家 đất nước. 一个国家里可以有很多城市; không suy ra mọi thành phố giống nhau.",
      "hanzi": "我想了解这个城市的历史。",
      "pinyin": "Wǒ xiǎng liǎojiě zhège chéngshì de lìshǐ.",
      "meaning": "Tôi muốn tìm hiểu lịch sử thành phố này.",
      "readingMinutes": 1
    },
    {
      "id": "l316-t1",
      "type": "teaching",
      "title": "历史 · lịch sử",
      "text": "历史 nói những việc đã diễn ra và sự nghiên cứu/ghi chép về chúng. 一段历史不等于一个虚构故事; bài chỉ phân biệt cách dùng từ.",
      "hanzi": "老师介绍了学校的历史。",
      "pinyin": "Lǎoshī jièshào le xuéxiào de lìshǐ.",
      "meaning": "Thầy giới thiệu lịch sử trường.",
      "readingMinutes": 1
    },
    {
      "id": "l316-t2",
      "type": "teaching",
      "title": "国家 · đất nước/quốc gia",
      "text": "国家 chỉ quốc gia; không thay mọi chỗ của 家 (gia đình/nhà). 来自不同国家 nói đến từ các đất nước khác nhau.",
      "hanzi": "我们的同学来自不同的国家。",
      "pinyin": "Wǒmen de tóngxué láizì bù tóng de guójiā.",
      "meaning": "Bạn học chúng tôi đến từ các nước khác nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l316-t3",
      "type": "teaching",
      "title": "文化 · văn hóa",
      "text": "文化 là văn hóa theo ngữ cảnh như 语言和饮食文化. Không lấy một cá nhân hoặc một hoạt động để kết luận mọi người của một nước đều như nhau.",
      "hanzi": "我对这里的文化很感兴趣。",
      "pinyin": "Wǒ duì zhèlǐ de wénhuà hěn gǎn xìngqù.",
      "meaning": "Tôi hứng thú với văn hóa ở đây.",
      "readingMinutes": 1
    },
    {
      "id": "l316-t4",
      "type": "teaching",
      "title": "了解 · tìm hiểu/biết về",
      "text": "了解 dùng tìm hiểu hay có hiểu biết về người/việc. 想了解是意愿，不等于已经全面懂得; mong muốn hiểu không chứng minh đã biết đầy đủ.",
      "hanzi": "我们想多了解当地的生活。",
      "pinyin": "Wǒmen xiǎng duō liǎojiě dāngdì de shēnghuó.",
      "meaning": "Chúng tôi muốn tìm hiểu thêm cuộc sống địa phương.",
      "readingMinutes": 1
    },
    {
      "id": "l316-t5",
      "type": "teaching",
      "title": "留学生 · du học sinh",
      "text": "留学生 là người đi học ở nước ngoài theo ngữ cảnh. Không dùng riêng chữ 留 để chứng minh mọi nghĩa hay cấp từ 留学 đã được hoàn tất.",
      "hanzi": "她是一名留学生。",
      "pinyin": "Tā shì yì míng liúxuéshēng.",
      "meaning": "Cô ấy là một du học sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l316-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "除了读书，我们还问朋友 dùng 除了…还… để thêm cách làm: ngoài đọc sách còn hỏi bạn. Nhánh này không loại việc đầu ra; chưa luyện 除了…都… mang nghĩa loại trừ.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l316-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：你是留学生吗？小李：是，我来这里学习中文。小安：你已经了解这个国家的文化了吗？小李：只了解一点儿。我想先了解学校和这个城市的历史。除了读书，我还会问来自不同国家的同学。",
      "pinyin": "Xiǎo Ān: Nǐ shì liúxuéshēng ma? Xiǎo Lǐ: Shì, wǒ lái zhèlǐ xuéxí Zhōngwén. Xiǎo Ān: Nǐ yǐjīng liǎojiě zhège guójiā de wénhuà le ma? Xiǎo Lǐ: Zhǐ liǎojiě yìdiǎnr. Wǒ xiǎng xiān liǎojiě xuéxiào hé zhège chéngshì de lìshǐ. Chúle dú shū, wǒ hái huì wèn láizì bù tóng guójiā de tóngxué.",
      "meaning": "Lý là du học sinh học tiếng Trung. Khi được hỏi đã hiểu văn hóa đất nước này chưa, Lý nói chỉ hiểu chút ít, muốn tìm hiểu lịch sử trường và thành phố; ngoài đọc còn hỏi các bạn đến từ nhiều nước.",
      "readingMinutes": 2
    },
