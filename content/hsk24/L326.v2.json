  "blocks": [
    {
      "id": "l326-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 参加 cānjiā: tham gia; 性别 xìngbié: giới tính; 分任务 fēn rènwu: phân công nhiệm vụ. Hỗ trợ nghĩa, chưa xác nhận các mục từ này đã thuộc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l326-t0",
      "type": "teaching",
      "title": "大人 · người lớn",
      "text": "大人 đối chiếu trẻ em theo độ tuổi; không phải cách phổ thông để chỉ người cao lớn. 人 đọc nhẹ trong mục từ này.",
      "hanzi": "孩子跟大人一起进来。",
      "pinyin": "Háizi gēn dàren yìqǐ jìnlai.",
      "meaning": "Trẻ em đi vào cùng người lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l326-t1",
      "type": "teaching",
      "title": "老人 · người cao tuổi",
      "text": "老人 nói người lớn tuổi, không phải mọi người trưởng thành. 一位老人 dùng 位 biểu thị lịch sự.",
      "hanzi": "那位老人是我爷爷。",
      "pinyin": "Nà wèi lǎorén shì wǒ yéye.",
      "meaning": "Cụ ông đó là ông tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l326-t2",
      "type": "teaching",
      "title": "男人 · người đàn ông",
      "text": "男人 chỉ người nam trưởng thành trong bài; không tự cho biết nghề hay quan hệ với người nói.",
      "hanzi": "那个男人是她爸爸。",
      "pinyin": "Nà ge nánrén shì tā bàba.",
      "meaning": "Người đàn ông đó là bố cô ấy.",
      "readingMinutes": 1
    },
    {
      "id": "l326-t3",
      "type": "teaching",
      "title": "女人 · người phụ nữ",
      "text": "女人 chỉ người nữ trưởng thành, cần chú ý cách xưng hô theo tình huống; không tự là vợ người đứng cạnh.",
      "hanzi": "那个女人是我姐姐。",
      "pinyin": "Nà ge nǚrén shì wǒ jiějie.",
      "meaning": "Người phụ nữ đó là chị tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l326-t4",
      "type": "teaching",
      "title": "男生 · nam sinh",
      "text": "男生 trong bối cảnh trường là học sinh nam, không dùng thay mọi 男人 ngoài trường.",
      "hanzi": "我们班有十个男生。",
      "pinyin": "Wǒmen bān yǒu shí ge nánshēng.",
      "meaning": "Lớp chúng tôi có mười nam sinh.",
      "readingMinutes": 1
    },
    {
      "id": "l326-t5",
      "type": "teaching",
      "title": "女生 · nữ sinh",
      "text": "女生 trong trường chỉ học sinh nữ; 女 sinh đứng cùng 生 tạo từ về vai trò học sinh trong bài.",
      "hanzi": "她们都是这个班的女生。",
      "pinyin": "Tāmen dōu shì zhège bān de nǚshēng.",
      "meaning": "Họ đều là nữ sinh lớp này.",
      "readingMinutes": 1
    },
    {
      "id": "l326-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "其他 + danh từ nêu những người/vật khác với nhóm đã nói: 其他学生. 不 phải một giới hay nhóm nào đều có cùng tuổi; 一位老人 và 一个大人 khác tiêu chí.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l326-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "学校请大人跟孩子一起参加活动。一位老人来了，他是小林的爷爷。门口的男人和女人是小王的爸爸妈妈。男生、女生和其他学生一起准备，不按性别分任务。",
      "pinyin": "Xuéxiào qǐng dàren gēn háizi yìqǐ cānjiā huódòng. Yí wèi lǎorén lái le, tā shì Xiǎo Lín de yéye. Ménkǒu de nánrén hé nǚrén shì Xiǎo Wáng de bàba māma. Nánshēng, nǚshēng hé qítā xuésheng yìqǐ zhǔnbèi, bù àn xìngbié fēn rènwu.",
      "meaning": "Trường mời người lớn tham gia cùng trẻ em. Ông của Lâm và bố mẹ Vương đến. Các học sinh chuẩn bị cùng nhau, không phân việc theo giới.",
      "readingMinutes": 2
    },
    {
