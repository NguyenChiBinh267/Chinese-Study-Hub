  "blocks": [
    {
      "id": "l110-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l110-t0",
      "type": "teaching",
      "title": "六 · sáu",
      "text": "六 là số sáu, chữ khác 八; nhìn cả phần trên và dưới.",
      "hanzi": "六、七、八。",
      "pinyin": "Liù, qī, bā.",
      "meaning": "Sáu, bảy, tám.",
      "readingMinutes": 1
    },
    {
      "id": "l110-t1",
      "type": "teaching",
      "title": "七 · bảy",
      "text": "七 đọc qī với thanh một; không nhầm với 去 qù ở các bài sau.",
      "hanzi": "七、八。",
      "pinyin": "Qī, bā.",
      "meaning": "Bảy, tám.",
      "readingMinutes": 1
    },
    {
      "id": "l110-t2",
      "type": "teaching",
      "title": "八 · tám",
      "text": "八 là số tám, có hai nét tách; không phải 人 dù nét gần nhau.",
      "hanzi": "八、九、十。",
      "pinyin": "Bā, jiǔ, shí.",
      "meaning": "Tám, chín, mười.",
      "readingMinutes": 1
    },
    {
      "id": "l110-t3",
      "type": "teaching",
      "title": "九 · chín",
      "text": "九 đọc jiǔ, âm cuối ou; bài yêu cầu pinyin của số, không phải tên chữ Latin.",
      "hanzi": "九、十。",
      "pinyin": "Jiǔ, shí.",
      "meaning": "Chín, mười.",
      "readingMinutes": 1
    },
    {
      "id": "l110-t4",
      "type": "teaching",
      "title": "十 · mười",
      "text": "十 đứng riêng là mười; ghép với số khác để tạo số lớn hơn cần quy tắc tiếp theo.",
      "hanzi": "六、七、八、九、十。",
      "pinyin": "Liù, qī, bā, jiǔ, shí.",
      "meaning": "Sáu, bảy, tám, chín, mười.",
      "readingMinutes": 1
    },
    {
      "id": "l110-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Tiếp chuỗi sáu đến mười: 六七八九十. 十 đứng riêng là mười, không viết 一十 trong phép đếm thông thường. Chưa dùng các số này làm điểm số/điện thoại nếu tình huống không nói.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l110-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：六、七、八、九、十。\nB：九？\nA：不是九，是十。\nB：十。好！",
      "pinyin": "A: Liù, qī, bā, jiǔ, shí. B: Jiǔ? A: Bú shì jiǔ, shì shí. B: Shí. Hǎo!",
      "meaning": "B hỏi lại chín; A sửa rằng số đang nhấn mạnh là mười. Đọc toàn câu phủ định để không chọn nhầm.",
      "readingMinutes": 2
    },
