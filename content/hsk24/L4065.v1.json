  "blocks": [
    {
      "id": "l4065-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t0",
      "type": "teaching",
      "title": "顺便 · tiện thể",
      "text": "顺便 nói làm thêm việc khi đang làm việc chính.",
      "hanzi": "去图书馆时，我顺便还书。",
      "pinyin": "Qù tú shū guǎn shí, wǒ shùn biàn huán shū.",
      "meaning": "Khi đến thư viện tôi tiện trả sách.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t1",
      "type": "teaching",
      "title": "顺利 · thuận lợi",
      "text": "顺利 mô tả việc tiến triển không gặp trở ngại lớn.",
      "hanzi": "今天的参观很顺利。",
      "pinyin": "Jīn tiān de cān guān hěn shùn lì.",
      "meaning": "Chuyến tham quan hôm nay thuận lợi.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t2",
      "type": "teaching",
      "title": "顺序 · thứ tự",
      "text": "顺序 chỉ việc nào trước sau, không phải tốc độ. Nhận diện chữ 序 trong 顺序; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请按这个顺序参观。",
      "pinyin": "Qǐng àn zhè ge shùn xù cān guān.",
      "meaning": "Xin tham quan theo thứ tự này.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t3",
      "type": "teaching",
      "title": "首先 · trước tiên",
      "text": "首先 mở bước hoặc điểm đầu trong trình bày.",
      "hanzi": "首先，我们去看阅览室。",
      "pinyin": "Shǒu xiān, wǒ men qù kàn yuè lǎn shì.",
      "meaning": "Trước tiên chúng ta xem phòng đọc.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t4",
      "type": "teaching",
      "title": "由 · do; bởi",
      "text": "由 trong 由老师介绍 dẫn người phụ trách hành động.",
      "hanzi": "活动由老师介绍。",
      "pinyin": "Huó dòng yóu lǎo shī jiè shào.",
      "meaning": "Hoạt động do giáo viên giới thiệu.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-t5",
      "type": "teaching",
      "title": "准时 · đúng giờ",
      "text": "准时 nói vào thời điểm đã hẹn, khác 准 là chính xác nói chung.",
      "hanzi": "大家准时在门口见。",
      "pinyin": "Dà jiā zhǔn shí zài mén kǒu jiàn.",
      "meaning": "Mọi người gặp đúng giờ ở cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l4065-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "既然 dùng lịch đã thống nhất làm căn cứ. 首先 mở bước đầu, 顺序 là trật tự các bước; 顺利 nói tiến triển thuận lợi, không đồng nghĩa đúng thứ tự.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4065-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "参观由老师介绍，大家准时在门口见。首先看阅览室，再去书库，这是老师安排的顺序。小林去图书馆时顺便还书。既然顺序已经确定，大家就按计划走，参观很顺利。",
      "pinyin": "Cān guān yóu lǎo shī jiè shào, dà jiā zhǔn shí zài mén kǒu jiàn. Shǒu xiān kàn yuè lǎn shì, zài qù shū kù, zhè shì lǎo shī ān pái de shùn xù. Xiǎo Lín qù tú shū guǎn shí shùn biàn huán shū. Jì rán shùn xù yǐ jīng què dìng, dà jiā jiù àn jì huà zǒu, cān guān hěn shùn lì.",
      "meaning": "Nhóm xem phòng đọc trước rồi đến kho sách; Tiểu Lâm tiện trả sách.",
      "readingMinutes": 2
    },
