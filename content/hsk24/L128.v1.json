  "blocks": [
    {
      "id": "l128-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l128-t0",
      "type": "teaching",
      "title": "这些 · những cái này; những người này",
      "text": "这些 chỉ một nhóm ở phía này; không tự cho biết nhóm có đúng bao nhiêu thành viên.",
      "hanzi": "这些是我的书。",
      "pinyin": "Zhè xiē shì wǒ de shū.",
      "meaning": "Những cuốn này là sách của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l128-t1",
      "type": "teaching",
      "title": "那些 · những cái kia; những người kia",
      "text": "那些 chỉ nhóm được nêu ở phía kia, không thay dạng một đối tượng 那个 trong câu hỏi giới hạn hình thức.",
      "hanzi": "那些是新书。",
      "pinyin": "Nà xiē shì xīn shū.",
      "meaning": "Những cuốn kia là sách mới.",
      "readingMinutes": 1
    },
    {
      "id": "l128-t2",
      "type": "teaching",
      "title": "哪些 · những cái nào; những người nào",
      "text": "哪些 hỏi chọn những đối tượng trong nhóm; không hỏi số lượng chính xác như 几.",
      "hanzi": "你喜欢哪些书？",
      "pinyin": "Nǐ xǐ huan nǎ xiē shū?",
      "meaning": "Bạn thích những quyển sách nào?",
      "readingMinutes": 1
    },
    {
      "id": "l128-t3",
      "type": "teaching",
      "title": "些 · một số; yếu tố chỉ lượng không xác định",
      "text": "些 thường đi với 一/这/那/哪; 一些 trong ví dụ là một số, không cho một số đếm cụ thể.",
      "hanzi": "我有一些书。",
      "pinyin": "Wǒ yǒu yì xiē shū.",
      "meaning": "Tôi có một số sách.",
      "readingMinutes": 1
    },
    {
      "id": "l128-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "这些/那些 nói những đối tượng này/kia; 哪些 hỏi những đối tượng nào. 些 dùng trong các tổ hợp chỉ một số lượng không xác định như 一些; không dùng nó làm một con số chính xác. Phân biệt 一个/这个 chỉ một đối tượng với 这些 chỉ nhiều đối tượng trong tình huống.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l128-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：哪些是你的书？\nB：这些是我的书。\nA：那些呢？\nB：那些是我姐姐的书。",
      "pinyin": "A: Nǎ xiē shì nǐ de shū? B: Zhè xiē shì wǒ de shū. A: Nà xiē ne? B: Nà xiē shì wǒ jiě jie de shū.",
      "meaning": "A hỏi nhóm sách nào thuộc B. B nhận nhóm này; nhóm kia thuộc chị gái B. Không có số lượng cụ thể trong đoạn.",
      "readingMinutes": 2
    },
