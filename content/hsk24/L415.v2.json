  "blocks": [
    {
      "id": "l415-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 病人 bìngrén: người bệnh; 抬 tái: nâng; 陪 péi: đi cùng; 诊断 zhěnduàn: chẩn đoán; 是否 shìfǒu: có hay không. Không dùng câu hư cấu này để quyết định chăm sóc sức khỏe.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l415-t0",
      "type": "teaching",
      "title": "大夫 · bác sĩ (cách gọi dàifu)",
      "text": "大夫 ở đây đọc dàifu với âm 夫 nhẹ; không dùng cách đọc chức quan cổ dàfū.",
      "hanzi": "这位大夫正在听病人说明情况。",
      "pinyin": "Zhè wèi dàifu zhèngzài tīng bìngrén shuōmíng qíngkuàng.",
      "meaning": "Vị bác sĩ này đang nghe bệnh nhân trình bày.",
      "readingMinutes": 1
    },
    {
      "id": "l415-t1",
      "type": "teaching",
      "title": "护士 · điều dưỡng",
      "text": "护士 đọc hùshi trong từ điển nguồn; ở đây chỉ người tiếp nhận và hỏi thông tin.",
      "hanzi": "护士请他先坐下。",
      "pinyin": "Hùshi qǐng tā xiān zuò xià.",
      "meaning": "Điều dưỡng mời anh ấy ngồi xuống trước.",
      "readingMinutes": 1
    },
    {
      "id": "l415-t2",
      "type": "teaching",
      "title": "打针 · tiêm",
      "text": "打针 là cụm động–tân chỉ việc tiêm; việc nhắc từ này trong bài không có nghĩa ai cũng cần tiêm. Nhận diện chữ 针 trong 打针; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "孩子问今天要不要打针。",
      "pinyin": "Háizi wèn jīntiān yào bu yào dǎzhēn.",
      "meaning": "Đứa trẻ hỏi hôm nay có phải tiêm không.",
      "readingMinutes": 1
    },
    {
      "id": "l415-t3",
      "type": "teaching",
      "title": "肚子 · bụng",
      "text": "肚子 là cách gọi vùng bụng trong hội thoại; diễn tả đau bụng không xác định nguyên nhân.",
      "hanzi": "他指着肚子说这里不舒服。",
      "pinyin": "Tā zhǐ zhe dùzi shuō zhèlǐ bù shūfu.",
      "meaning": "Anh ấy chỉ bụng nói chỗ này khó chịu.",
      "readingMinutes": 1
    },
    {
      "id": "l415-t4",
      "type": "teaching",
      "title": "胳膊 · cánh tay",
      "text": "胳膊 đọc gēbo, âm 膊 nhẹ; không nhầm với riêng bàn tay 手.",
      "hanzi": "他把左边的胳膊抬起来。",
      "pinyin": "Tā bǎ zuǒbian de gēbo tái qǐlái.",
      "meaning": "Anh ấy giơ cánh tay trái lên.",
      "readingMinutes": 1
    },
    {
      "id": "l415-t5",
      "type": "teaching",
      "title": "鼻子 · mũi",
      "text": "鼻子 là bộ phận mũi; bài luyện nhận diện từ trong lời mô tả, không suy ra bệnh từ triệu chứng.",
      "hanzi": "她说鼻子有点儿不舒服。",
      "pinyin": "Tā shuō bízi yǒudiǎnr bù shūfu.",
      "meaning": "Cô ấy nói mũi hơi khó chịu.",
      "readingMinutes": 1
    },
    {
      "id": "l415-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "当+người/sự việc+thời điểm diễn ra nêu bối cảnh thời gian: 当护士问他时，他指了指胳膊. Không phải nghĩa 担任 làm nghề của 当. Bài chỉ luyện mô tả, không chẩn đoán hay hướng dẫn điều trị.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l415-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小田陪孩子到医院。孩子问要不要打针，护士说先请大夫了解情况。当护士问哪里不舒服时，孩子指了指鼻子，又说胳膊没事、肚子也不疼。段落没有给出诊断，也没有说最后是否打针。",
      "pinyin": "Xiǎo Tián péi háizi dào yīyuàn. Háizi wèn yào bu yào dǎzhēn, hùshi shuō xiān qǐng dàifu liǎojiě qíngkuàng. Dāng hùshi wèn nǎlǐ bù shūfu shí, háizi zhǐ le zhǐ bízi, yòu shuō gēbo méi shì, dùzi yě bù téng. Duànluò méiyǒu gěi chū zhěnduàn, yě méiyǒu shuō zuìhòu shìfǒu dǎzhēn.",
      "meaning": "Điều dưỡng hỏi chỗ khó chịu. Trẻ chỉ mũi và nói tay, bụng không sao. Chưa có kết luận chẩn đoán hay quyết định tiêm.",
      "readingMinutes": 2
    },
