  "blocks": [
    {
      "id": "l342-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 发 fā: gửi; 封 fēng: lượng từ thư; 地址 dìzhǐ: địa chỉ; 文件夹 wénjiànjiā: thư mục; 删除 shānchú: xóa chỉ đối chiếu.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l342-t0",
      "type": "teaching",
      "title": "名单 · danh sách tên",
      "text": "名单 là danh sách tên người, khác 菜单 là danh sách món. Danh sách chưa tự xác nhận mỗi người có mặt.",
      "hanzi": "请把名单发给我。",
      "pinyin": "Qǐng bǎ míngdān fā gěi wǒ.",
      "meaning": "Hãy gửi danh sách tên cho tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l342-t1",
      "type": "teaching",
      "title": "收 · thu/nhận/cất",
      "text": "收 trong 收信 là nhận thư; 收东西 có thể là cất/thu đồ, cần ngữ cảnh. Không gộp mọi nghĩa thành một bằng chứng đã thuộc.",
      "hanzi": "他每天收信。",
      "pinyin": "Tā měi tiān shōu xìn.",
      "meaning": "Anh ấy nhận thư hằng ngày.",
      "readingMinutes": 1
    },
    {
      "id": "l342-t2",
      "type": "teaching",
      "title": "收到 · nhận được",
      "text": "收到 nêu kết quả đã nhận; 没收到 là chưa/không nhận được, khác 没发 là chưa gửi.",
      "hanzi": "我已经收到你的邮件了。",
      "pinyin": "Wǒ yǐjīng shōudào nǐ de yóujiàn le.",
      "meaning": "Tôi đã nhận được thư điện tử của bạn.",
      "readingMinutes": 1
    },
    {
      "id": "l342-t3",
      "type": "teaching",
      "title": "邮件 · thư/bưu phẩm; email theo ngữ cảnh",
      "text": "邮件 ở bài là thư điện tử qua 邮箱; ở ngữ cảnh khác có thể là thư/bưu phẩm, chưa dạy mọi nghĩa.",
      "hanzi": "我给同事发了一封邮件。",
      "pinyin": "Wǒ gěi tóngshì fā le yì fēng yóujiàn.",
      "meaning": "Tôi gửi cho đồng nghiệp một email.",
      "readingMinutes": 1
    },
    {
      "id": "l342-t4",
      "type": "teaching",
      "title": "邮箱 · hộp thư/hòm thư điện tử",
      "text": "邮箱 trong địa chỉ liên lạc là hòm thư điện tử, khác 邮件 là từng thư. 不要把邮箱地址当成邮件正文.",
      "hanzi": "请检查邮箱地址。",
      "pinyin": "Qǐng jiǎnchá yóuxiāng dìzhǐ.",
      "meaning": "Hãy kiểm tra địa chỉ hòm thư.",
      "readingMinutes": 1
    },
    {
      "id": "l342-t5",
      "type": "teaching",
      "title": "信 · thư; tin (động từ ở ngữ cảnh khác)",
      "text": "信 trong 一封信 là lá thư; 我不信 dùng nghĩa tin. Bài chỉ luyện nghĩa thư ở ví dụ này, không đồng nhất hai chức năng.",
      "hanzi": "这封信是姐姐写的。",
      "pinyin": "Zhè fēng xìn shì jiějie xiě de.",
      "meaning": "Lá thư này do chị viết.",
      "readingMinutes": 1
    },
    {
      "id": "l342-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "收到 nhấn mạnh nhận được, 收 có thể là thu/nhận chưa nêu kết quả tương tự. 我发了邮件 không chứng minh đối phương 收到了; 到 là kết quả trong nghĩa bài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l342-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "同事说已经发了名单，小林却没收到邮件。他先检查邮箱地址，再看收信的文件夹，最后找到了。回家以后，他又收到姐姐写的一封信，是纸上的信，不是工作邮件。",
      "pinyin": "Tóngshì shuō yǐjīng fā le míngdān, Xiǎo Lín què méi shōudào yóujiàn. Tā xiān jiǎnchá yóuxiāng dìzhǐ, zài kàn shōu xìn de wénjiànjiā, zuìhòu zhǎodào le. Huí jiā yǐhòu, tā yòu shōudào jiějie xiě de yì fēng xìn, shì zhǐ shàng de xìn, bú shì gōngzuò yóujiàn.",
      "meaning": "Đồng nghiệp nói đã gửi danh sách nhưng Lâm chưa nhận được. Cậu kiểm tra địa chỉ và thư mục thư rồi tìm thấy; sau đó còn nhận thư giấy của chị.",
      "readingMinutes": 2
    },
    {
