  "blocks": [
    {
      "id": "l282-guide",
      "type": "teaching",
      "title": "Chẩn đoán mẫu · không phải đề HSK",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder0",
      "type": "teaching",
      "title": "足球 · bóng đá",
      "text": "足球 dùng với 踢 khi nói chơi bóng đá. Không chỉ dựa vào chữ 球 để chọn cách kết hợp.",
      "hanzi": "我喜欢踢足球。",
      "pinyin": "Wǒ xǐhuan tī zúqiú.",
      "meaning": "Tôi thích chơi bóng đá.",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder1",
      "type": "teaching",
      "title": "足球 · bóng đá",
      "text": "足球 dùng với 踢 khi nói chơi bóng đá. Không chỉ dựa vào chữ 球 để chọn cách kết hợp.",
      "hanzi": "我喜欢踢足球。",
      "pinyin": "Wǒ xǐhuan tī zúqiú.",
      "meaning": "Tôi thích chơi bóng đá.",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder2",
      "type": "teaching",
      "title": "跳舞 · nhảy múa, khiêu vũ",
      "text": "跳舞 nói nhảy theo hoạt động múa/nhạc, không phải mọi cú nhảy lên. 舞 đọc thanh ba.",
      "hanzi": "妹妹喜欢跳舞。",
      "pinyin": "Mèimei xǐhuan tiàowǔ.",
      "meaning": "Em gái thích nhảy múa.",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder3",
      "type": "teaching",
      "title": "快乐 · vui vẻ",
      "text": "快乐 dùng nói trạng thái vui hoặc lời chúc như 生日快乐. Không dùng 快乐 để nói tốc độ nhanh.",
      "hanzi": "生日快乐！",
      "pinyin": "Shēngrì kuàilè!",
      "meaning": "Chúc sinh nhật vui vẻ!",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder4",
      "type": "teaching",
      "title": "身体 · cơ thể, thể trạng",
      "text": "身体 có thể nói cơ thể hoặc thể trạng trong 身体很好. Không dùng mỗi từ này để chẩn đoán bộ phận bị bệnh.",
      "hanzi": "你身体怎么样？",
      "pinyin": "Nǐ shēntǐ zěnmeyàng?",
      "meaning": "Sức khỏe bạn thế nào?",
      "readingMinutes": 1
    },
    {
      "id": "l282-reminder5",
      "type": "teaching",
      "title": "舒服 · dễ chịu",
      "text": "舒服 đọc âm sau nhẹ. 不舒服 nói không dễ chịu/không khỏe, không xác định một bệnh cụ thể.",
      "hanzi": "我今天不太舒服。",
      "pinyin": "Wǒ jīntiān bú tài shūfu.",
      "meaning": "Hôm nay tôi không khỏe lắm.",
      "readingMinutes": 1
    },
    {
      "id": "l282-context0",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你的爱好是什么？乙：我喜欢踢足球，也喜欢跳舞。甲：星期天一起踢球吧。乙：好！我妹妹不踢球，她去跳舞。",
      "pinyin": "Jiǎ: Nǐ de àihào shì shénme? Yǐ: Wǒ xǐhuan tī zúqiú, yě xǐhuan tiàowǔ. Jiǎ: Xīngqītiān yìqǐ tī qiú ba. Yǐ: Hǎo! Wǒ mèimei bù tī qiú, tā qù tiàowǔ.",
      "meaning": "A: Sở thích của bạn là gì? B: Tôi thích đá bóng, cũng thích nhảy múa. A: Chủ nhật cùng đá bóng nhé. B: Được! Em gái tôi không đá bóng, em đi nhảy múa.",
      "readingMinutes": 2
    },
    {
      "id": "l282-context1",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你怎么了？乙：我头疼，身体不太舒服。甲：你今天去上班吗？乙：因为不舒服，所以我去看医生。",
      "pinyin": "Jiǎ: Nǐ zěnme le? Yǐ: Wǒ tóu téng, shēntǐ bú tài shūfu. Jiǎ: Nǐ jīntiān qù shàng bān ma? Yǐ: Yīnwèi bù shūfu, suǒyǐ wǒ qù kàn yīshēng.",
      "meaning": "A: Bạn sao vậy? B: Tôi đau đầu, không khỏe lắm. A: Hôm nay bạn đi làm không? B: Vì không khỏe nên tôi đi khám.",
      "readingMinutes": 2
    },
