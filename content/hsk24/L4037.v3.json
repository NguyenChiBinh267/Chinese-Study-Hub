  "blocks": [
    {
      "id": "l4037-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t0",
      "type": "teaching",
      "title": "教练 · huấn luyện viên",
      "text": "教练 là người hướng dẫn tập luyện, không phải mọi vận động viên.",
      "hanzi": "教练让大家先休息。",
      "pinyin": "Jiào liàn ràng dà jiā xiān xiū xi.",
      "meaning": "Huấn luyện viên cho mọi người nghỉ trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t1",
      "type": "teaching",
      "title": "排球 · bóng chuyền",
      "text": "排球 là môn hoặc quả bóng chuyền.",
      "hanzi": "我们下午打排球。",
      "pinyin": "Wǒ men xià wǔ dǎ pái qiú.",
      "meaning": "Chiều chúng tôi chơi bóng chuyền.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t2",
      "type": "teaching",
      "title": "加油 · cố lên; tiếp nhiên liệu",
      "text": "加油 ở đây là lời cổ vũ, không phải đổ xăng.",
      "hanzi": "同学们在旁边喊加油。",
      "pinyin": "Tóng xué men zài páng biān hǎn jiā yóu.",
      "meaning": "Các bạn đứng cạnh hô cố lên.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t3",
      "type": "teaching",
      "title": "厉害 · giỏi; dữ dội",
      "text": "厉害 tả năng lực cao trong câu này, khác bị bệnh nặng.",
      "hanzi": "她发球真厉害。",
      "pinyin": "Tā fā qiú zhēn lì hai.",
      "meaning": "Cô ấy phát bóng giỏi thật.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t4",
      "type": "teaching",
      "title": "力气 · sức; sức lực",
      "text": "力气 nói sức cơ thể, khác lực lượng tập thể.",
      "hanzi": "我现在没有力气了。",
      "pinyin": "Wǒ xiàn zài méi yǒu lì qi le.",
      "meaning": "Giờ tôi hết sức rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-t5",
      "type": "teaching",
      "title": "帅 · đẹp trai; bảnh",
      "text": "帅 tả ngoại hình/phong thái, không đồng nghĩa giỏi thể thao. Nhận diện chữ 帅 trong 帅; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他穿这件运动服很帅。",
      "pinyin": "Tā chuān zhè jiàn yùn dòng fú hěn shuài.",
      "meaning": "Anh ấy mặc bộ thể thao này rất bảnh.",
      "readingMinutes": 1
    },
    {
      "id": "l4037-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "让你休息你就休息 nhắc mạnh người nghe làm theo yêu cầu nghỉ. Chỉ dùng trong lời huấn luyện viên ở truyện; cách nhẹ hơn là 你先休息一下吧.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4037-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "排球训练时，同学们喊加油，觉得小林发球很厉害，穿运动服也很帅。但小林已经没有力气了。教练说：“让你休息你就休息，别逞强。”小林坐下喝水，等恢复后再练。",
      "pinyin": "Pái qiú xùn liàn shí, tóng xué men hǎn jiā yóu, jué de Xiǎo Lín fā qiú hěn lì hai, chuān yùn dòng fú yě hěn shuài. Dàn Xiǎo Lín yǐ jīng méi yǒu lì qi le. Jiào liàn shuō: “Ràng nǐ xiū xi nǐ jiù xiū xi, bié chěng qiáng.” Xiǎo Lín zuò xià hē shuǐ, děng huī fù hòu zài liàn.",
      "meaning": "Huấn luyện viên nhắc Tiểu Lâm đã mệt thì nghỉ, không cố quá sức.",
      "readingMinutes": 2
    },
    {
