  "blocks": [
    {
      "id": "l1175-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder0",
      "type": "teaching",
      "title": "便宜 · rẻ; không đắt",
      "text": "Từ đã học 便宜 có 2 chữ. Chữ 宜 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 宜 với 宣 / 且 / 直; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这本书很便宜。",
      "pinyin": "Zhè běn shū hěn pián yi.",
      "meaning": "Quyển sách này rẻ.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder1",
      "type": "teaching",
      "title": "件 · chiếc; món (lượng từ quần áo)",
      "text": "Từ đã học 件 có 1 chữ. Chữ 件 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 件 với 牛 / 伴 / 住; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有一件衣服。",
      "pinyin": "Wǒ yǒu yí jiàn yī fu.",
      "meaning": "Tôi có một món quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder2",
      "type": "teaching",
      "title": "杯子 · cốc; ly (vật chứa)",
      "text": "Từ đã học 杯子 có 2 chữ. Chữ 杯 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 杯 với 怀 / 坏 / 环; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我的杯子在桌子上。",
      "pinyin": "Wǒ de bēi zi zài zhuō zi shang.",
      "meaning": "Cốc của tôi ở trên bàn.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder3",
      "type": "teaching",
      "title": "穿 · mặc; mang trên người",
      "text": "Từ đã học 穿 có 1 chữ. Chữ 穿 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 穿 với 空 / 究 / 突; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我穿衣服。",
      "pinyin": "Wǒ chuān yī fu.",
      "meaning": "Tôi mặc quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder4",
      "type": "teaching",
      "title": "衣服 · quần áo",
      "text": "Từ đã học 衣服 có 2 chữ. Chữ 服 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 服 với 朋 / 月 / 报; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我买衣服。",
      "pinyin": "Wǒ mǎi yī fu.",
      "meaning": "Tôi mua quần áo.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reminder5",
      "type": "teaching",
      "title": "两 · hai (dạng liǎng trước lượng từ)",
      "text": "Từ đã học 两 có 1 chữ. Chữ 两 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 两 với 雨 / 丙 / 面; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我有两本书。",
      "pinyin": "Wǒ yǒu liǎng běn shū.",
      "meaning": "Tôi có hai quyển sách.",
      "readingMinutes": 1
    },
    {
      "id": "l1175-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你朋友现在在哪儿？\nB：她在中国。\nA：她学习什么？\nB：汉语。",
      "pinyin": "A: Nǐ péng you xiàn zài zài nǎr? B: Tā zài Zhōng guó. A: Tā xué xí shén me? B: Hàn yǔ.",
      "meaning": "Bạn của B ở Trung Quốc, học tiếng Hán; nơi ở không tự xác nhận quốc tịch.",
      "readingMinutes": 2
    },
