  "blocks": [
    {
      "id": "l49002-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder0",
      "type": "teaching",
      "title": "童年 · tuổi thơ",
      "text": "童年 là giai đoạn còn nhỏ trong cuộc đời; không phải mọi quá khứ của một người. Nhận diện chữ 童 trong 童年; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "这张照片让我想起童年。",
      "pinyin": "Zhè zhāng zhào piàn ràng wǒ xiǎng qǐ tóng nián.",
      "meaning": "Bức ảnh này khiến tôi nhớ tuổi thơ.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder1",
      "type": "teaching",
      "title": "任务 · nhiệm vụ",
      "text": "任务 là việc được giao cần hoàn thành; khác 活动 là cả hoạt động. Nhận diện chữ 任 trong 任务; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我的任务是检查名单。",
      "pinyin": "Wǒ de rèn wu shì jiǎn chá míng dān.",
      "meaning": "Nhiệm vụ của tôi là kiểm tra danh sách.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder2",
      "type": "teaching",
      "title": "任何 · bất kỳ",
      "text": "任何 bổ nghĩa danh từ; trong câu phủ định 不能把任何… nghĩa là không được bỏ sót bất kỳ… nào.",
      "hanzi": "不能漏掉任何一位客人。",
      "pinyin": "Bù néng lòu diào rèn hé yí wèi kè rén.",
      "meaning": "Không được bỏ sót bất kỳ vị khách nào.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder3",
      "type": "teaching",
      "title": "散步 · đi dạo",
      "text": "散步 là đi bộ thư thả để thư giãn; không chỉ mọi hình thức di chuyển bằng chân.",
      "hanzi": "我们晚饭后去散步。",
      "pinyin": "Wǒ men wǎn fàn hòu qù sàn bù.",
      "meaning": "Sau bữa tối chúng tôi đi dạo.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder4",
      "type": "teaching",
      "title": "森林 · rừng",
      "text": "森林 chỉ vùng rừng có hệ cây cối rộng; khác một cụm cây nhỏ trong khu phố.",
      "hanzi": "这片森林里有很多植物。",
      "pinyin": "Zhè piàn sēn lín lǐ yǒu hěn duō zhí wù.",
      "meaning": "Khu rừng này có nhiều thực vật.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder5",
      "type": "teaching",
      "title": "树林 · rặng cây; khu có cây",
      "text": "树林 là khu tập trung cây; có thể nhỏ hơn 森林, không mặc định là rừng nguyên sinh.",
      "hanzi": "公园北边有一片树林。",
      "pinyin": "Gōng yuán běi bian yǒu yí piàn shù lín.",
      "meaning": "Phía bắc công viên có một rặng cây.",
      "readingMinutes": 1
    },
    {
      "id": "l49002-reminder6",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "谁不想……呢？ là câu hỏi tu từ: ai mà chẳng muốn…, ngụ ý mọi người đều muốn. Không phải câu hỏi cần tìm tên một người; câu luyện chỉ diễn đạt mong muốn của nhân vật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l49002-reminder7",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小雨翻开童年的日记，每页都有日期。那时的日常生活很简单：上学、画画、和朋友玩。她觉得人生变化很大，但那些快乐的日子一直留在心里。她在今天的日记里写道：“谁不想把日子过好呢？我要继续记录生活。”",
      "pinyin": "Xiǎo Yǔ fān kāi tóng nián de rì jì, měi yè dōu yǒu rì qī. Nà shí de rì cháng shēng huó hěn jiǎn dān: shàng xué, huà huà, hé péng you wán. Tā jué de rén shēng biàn huà hěn dà, dàn nà xiē kuài lè de rì zi yì zhí liú zài xīn lǐ. Tā zài jīn tiān de rì jì lǐ xiě dào: “Shéi bù xiǎng bǎ rì zi guò hǎo ne? Wǒ yào jì xù jì lù shēng huó.”",
      "meaning": "Tiểu Vũ đọc lại nhật ký tuổi thơ có ghi ngày; cô muốn tiếp tục ghi lại cuộc sống.",
      "readingMinutes": 2
    },
