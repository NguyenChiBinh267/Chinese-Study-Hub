  "blocks": [
    {
      "id": "l4073-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t0",
      "type": "teaching",
      "title": "着 · bắt; cháy lên",
      "text": "着 đọc zháo ở 火着了, nói lửa đã bén; không đọc zhe.",
      "hanzi": "纸上的火着了。",
      "pinyin": "Zhǐ shàng de huǒ zháo le.",
      "meaning": "Lửa trên giấy đã bén.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t1",
      "type": "teaching",
      "title": "着火 · bốc cháy",
      "text": "着火 nói vật/nơi bắt lửa, đọc zháo huǒ.",
      "hanzi": "故事里，旧仓库着火了。",
      "pinyin": "Gù shi lǐ, jiù cāng kù zháo huǒ le.",
      "meaning": "Trong truyện, kho cũ bốc cháy.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t2",
      "type": "teaching",
      "title": "无 · không có",
      "text": "无 ở 此处无人 là cách viết gọn, tương đối trang trọng.",
      "hanzi": "门上写着：此处无人。",
      "pinyin": "Mén shàng xiě zhe: cǐ chù wú rén.",
      "meaning": "Trên cửa ghi: nơi này không có người.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t3",
      "type": "teaching",
      "title": "无法 · không thể",
      "text": "无法 biểu thị không có cách/khả năng thực hiện trong hoàn cảnh.",
      "hanzi": "照片太暗，无法看清号码。",
      "pinyin": "Zhào piàn tài àn, wú fǎ kàn qīng hào mǎ.",
      "meaning": "Ảnh quá tối nên không thể nhìn rõ số.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t4",
      "type": "teaching",
      "title": "细心 · cẩn thận; chú tâm",
      "text": "细心 ở đây tả người chú ý chi tiết. Nhận diện chữ 细 trong 细心; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "细心的读者发现了日期。",
      "pinyin": "Xì xīn de dú zhě fā xiàn le rì qī.",
      "meaning": "Người đọc cẩn thận phát hiện ngày tháng.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-t5",
      "type": "teaching",
      "title": "仔细 · kỹ; tỉ mỉ",
      "text": "仔细 ở 仔细阅读 bổ nghĩa cách đọc, không bảo đảm thông tin đúng.",
      "hanzi": "请仔细阅读故事的最后一段。",
      "pinyin": "Qǐng zǐ xì yuè dú gù shi de zuì hòu yí duàn.",
      "meaning": "Xin đọc kỹ đoạn cuối truyện.",
      "readingMinutes": 1
    },
    {
      "id": "l4073-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 giới hạn suy luận. 着 đọc zháo trong 火着了 và 着火, khác trợ từ zhe. Đây là tình huống đọc hư cấu, không phải hướng dẫn xử lý khẩn cấp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4073-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "社区活动室门口贴着照片和公告。公告说附近仓库着火，还用‘纸上的火着了’说明经过。照片上有‘此处无人’的旧标记，但照片太暗，无法看清号码。细心的居民仔细读日期，发现照片拍于前一天。社区管理员请居民区分照片日期与公告日期。不过，这张照片不能证明起火时有没有人。",
      "pinyin": "Shè qū huó dòng shì mén kǒu tiē zhe zhào piàn hé gōng gào. Gōng gào shuō fù jìn cāng kù zháo huǒ, hái yòng ‘zhǐ shàng de huǒ zháo le’ shuō míng jīng guò. Zhào piàn shàng yǒu ‘cǐ chù wú rén’ de jiù biāo jì, dàn zhào piàn tài àn, wú fǎ kàn qīng hào mǎ. Xì xīn de jū mín zǐ xì dú rì qī, fā xiàn zhào piàn pāi yú qián yì tiān. Shè qū guǎn lǐ yuán qǐng jū mín qū fēn zhào piàn rì qī yǔ gōng gào rì qī. Bú guò, zhè zhāng zhào piàn bù néng zhèng míng qǐ huǒ shí yǒu méi yǒu rén.",
      "meaning": "Cư dân đọc thông báo ở phòng sinh hoạt cộng đồng; người quản lý nhắc phân biệt ngày chụp ảnh với ngày thông báo. Ảnh hôm trước không chứng minh lúc cháy có người hay không. Đây là truyện hư cấu, không phải hướng dẫn ứng phó khẩn cấp.",
      "readingMinutes": 2
    },
