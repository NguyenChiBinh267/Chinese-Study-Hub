  "blocks": [
    {
      "id": "l466-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 顶 dǐng: lượng từ cho mũ; 大衣 dàyī: áo choàng/áo khoác dài.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l466-t0",
      "type": "teaching",
      "title": "干 · khô",
      "text": "干 gān nói không ướt, khác gàn làm trong 干活儿.",
      "hanzi": "这条毛巾已经干了。",
      "pinyin": "Zhè tiáo máojīn yǐjīng gān le.",
      "meaning": "Khăn đã khô.",
      "readingMinutes": 1
    },
    {
      "id": "l466-t1",
      "type": "teaching",
      "title": "厚 · dày",
      "text": "厚 tả chiều dày, khác 重 là nặng; quần áo dày không tự chứng minh phù hợp mọi thời tiết.",
      "hanzi": "这件毛衣比较厚。",
      "pinyin": "Zhè jiàn máoyī bǐjiào hòu.",
      "meaning": "Áo len này khá dày.",
      "readingMinutes": 1
    },
    {
      "id": "l466-t2",
      "type": "teaching",
      "title": "毛衣 · áo len",
      "text": "毛衣 là áo dệt len/kiểu áo len; không phải mọi áo khoác.",
      "hanzi": "她把毛衣放进包里。",
      "pinyin": "Tā bǎ máoyī fàng jìn bāo lǐ.",
      "meaning": "Cô cho áo len vào túi.",
      "readingMinutes": 1
    },
    {
      "id": "l466-t3",
      "type": "teaching",
      "title": "帽子 · mũ",
      "text": "帽子 là đồ đội đầu; lượng từ thường dùng 顶. Nhận diện chữ 帽 trong 帽子; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "我带了一顶帽子。",
      "pinyin": "Wǒ dài le yì dǐng màozi.",
      "meaning": "Tôi mang một chiếc mũ.",
      "readingMinutes": 1
    },
    {
      "id": "l466-t4",
      "type": "teaching",
      "title": "亮 · sáng",
      "text": "亮 nói ánh sáng rõ, không phải tả nhiệt độ nóng.",
      "hanzi": "屋里很亮，不用开灯。",
      "pinyin": "Wū lǐ hěn liàng, bú yòng kāi dēng.",
      "meaning": "Phòng sáng, không cần bật đèn.",
      "readingMinutes": 1
    },
    {
      "id": "l466-t5",
      "type": "teaching",
      "title": "凉 · mát; nguội",
      "text": "凉 liáng nói mát/nguội trong phạm vi nhiệt độ, khác 寒冷 là rất lạnh.",
      "hanzi": "早晨外面有点儿凉。",
      "pinyin": "Zǎochén wàimiàn yǒu diǎnr liáng.",
      "meaning": "Sáng ngoài trời hơi mát lạnh.",
      "readingMinutes": 1
    },
    {
      "id": "l466-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "稍微 + tính từ/động từ biểu thị mức độ ít: 毛衣稍微厚一点儿. Không mang nghĩa hoàn toàn. Dùng 一点儿 như phần của vị ngữ để giữ trật tự trong câu hỏi có giới hạn.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l466-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "屋里很亮，小罗不用开灯就找到了帽子。早晨外面有点儿凉，她选了一件稍微厚一点儿的毛衣。昨晚洗的毛巾已经干了，也放进包里。她出门前又看了一下天气，决定不带那件很厚的大衣。",
      "pinyin": "Wū lǐ hěn liàng, Xiǎo Luó bú yòng kāi dēng jiù zhǎo dào le màozi. Zǎochén wàimiàn yǒu diǎnr liáng, tā xuǎn le yí jiàn shāowēi hòu yìdiǎnr de máoyī. Zuówǎn xǐ de máojīn yǐjīng gān le, yě fàng jìn bāo lǐ. Tā chūmén qián yòu kàn le yíxià tiānqì, juédìng bú dài nà jiàn hěn hòu de dàyī.",
      "meaning": "La tìm mũ trong phòng sáng, chọn áo len dày hơn chút vì sáng mát. Khăn đã khô cũng được cho vào túi. Cô xem lại thời tiết và không mang áo choàng rất dày.",
      "readingMinutes": 2
    },
    {
