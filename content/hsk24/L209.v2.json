  "blocks": [
    {
      "id": "l209-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "出 là ra, 进 là vào, 回 là trở lại. 来 hướng về phía người nói/mốc nhìn; 去 hướng xa mốc đó. Phần giải thích này không chứng nhận đã nắm các từ HSK1.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l209-t0",
      "type": "teaching",
      "title": "出去 · đi ra xa mốc người nói",
      "text": "Người nói đang trong phòng: 他出去了 là anh ấy đi ra ngoài xa mốc đang đứng.",
      "hanzi": "他出去买东西了。",
      "pinyin": "Tā chūqù mǎi dōngxi le.",
      "meaning": "Anh ấy ra ngoài mua đồ rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l209-t1",
      "type": "teaching",
      "title": "出来 · ra về phía mốc người nói",
      "text": "Người nói đứng ngoài phòng có thể gọi 请出来. Không thay 来 bằng 去 mà giữ nguyên mốc.",
      "hanzi": "我在门口，你出来吧。",
      "pinyin": "Wǒ zài ménkǒu, nǐ chūlái ba.",
      "meaning": "Tôi ở cửa, bạn ra đây nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l209-t2",
      "type": "teaching",
      "title": "进来 · vào về phía mốc người nói",
      "text": "Người trong phòng mời người ngoài vào dùng 请进来. 来 không tự mang nghĩa tương lai.",
      "hanzi": "外面冷，快进来。",
      "pinyin": "Wàimiàn lěng, kuài jìnlái.",
      "meaning": "Ngoài lạnh, mau vào đây.",
      "readingMinutes": 1
    },
    {
      "id": "l209-t3",
      "type": "teaching",
      "title": "进去 · đi vào xa mốc người nói",
      "text": "Người đứng ngoài kể bạn đi vào phòng dùng 进去了; mốc vẫn ở ngoài.",
      "hanzi": "他已经进去了。",
      "pinyin": "Tā yǐjīng jìnqù le.",
      "meaning": "Anh ấy đã đi vào trong rồi.",
      "readingMinutes": 1
    },
    {
      "id": "l209-t4",
      "type": "teaching",
      "title": "回来 · trở về phía mốc người nói",
      "text": "Người ở nhà hỏi 你什么时候回来 là hỏi lúc nào người kia quay về đây.",
      "hanzi": "你什么时候回来？",
      "pinyin": "Nǐ shénme shíhou huílái?",
      "meaning": "Khi nào bạn trở về đây?",
      "readingMinutes": 1
    },
    {
      "id": "l209-t5",
      "type": "teaching",
      "title": "回去 · trở lại xa mốc người nói",
      "text": "Người ở khách sạn nói 明天回去 chỉ ngày mai trở về nơi khác, không về ngay phía người đang đứng.",
      "hanzi": "我明天回去。",
      "pinyin": "Wǒ míngtiān huíqù.",
      "meaning": "Mai tôi trở về.",
      "readingMinutes": 1
    },
    {
      "id": "l209-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "来 và 去 phụ thuộc mốc của người nói. Người đứng trong phòng gọi 进来; nói về người đi vào căn phòng ở chỗ khác có thể dùng 进去. Không chọn chỉ theo nghĩa vào/ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l209-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "我在教室里。小王在门口，我说：外面冷，快进来。他进来，我出去买水。小王问：你什么时候回来？我说：一会儿就回来。",
      "pinyin": "Wǒ zài jiàoshì li. Xiǎo Wáng zài ménkǒu, wǒ shuō: Wàimiàn lěng, kuài jìnlái. Tā jìnlái, wǒ chūqù mǎi shuǐ. Xiǎo Wáng wèn: Nǐ shénme shíhou huílái? Wǒ shuō: Yíhuìr jiù huílái.",
      "meaning": "Tôi ở trong lớp. Tiểu Vương ở cửa, tôi nói: Ngoài lạnh, mau vào đây. Anh ấy vào, tôi ra ngoài mua nước. Anh ấy hỏi: Khi nào bạn quay về đây? Tôi nói: Một lát nữa tôi quay về.",
      "readingMinutes": 2
    },
    {
      "id": "l209-b0",
      "type": "exercise",
      "exerciseVersionId": "l209-v2-e0"
