  "blocks": [
    {
      "id": "l456-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 互相 hùxiāng: lẫn nhau; 尊重 zūnzhòng: tôn trọng; 难得 nándé: hiếm có; 外地 wàidì: nơi khác.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l456-t0",
      "type": "teaching",
      "title": "聚 · tụ lại",
      "text": "聚 là động từ ngắn trong 聚一聚, thường không nhận 餐 làm tân ngữ theo nghĩa tụ họp chung. Nhận diện chữ 聚 trong 聚; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "周末我们聚一聚吧。",
      "pinyin": "Zhōumò wǒmen jù yi jù ba.",
      "meaning": "Cuối tuần mình gặp nhau nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l456-t1",
      "type": "teaching",
      "title": "聚餐 · ăn uống cùng nhau",
      "text": "聚餐 là cùng ăn theo nhóm, không phải mọi cuộc họp đều có ăn.",
      "hanzi": "同学们约好周五聚餐。",
      "pinyin": "Tóngxuémen yuē hǎo Zhōuwǔ jùcān.",
      "meaning": "Các bạn hẹn thứ sáu ăn chung.",
      "readingMinutes": 1
    },
    {
      "id": "l456-t2",
      "type": "teaching",
      "title": "聚会 · buổi tụ họp",
      "text": "聚会 là việc/buổi gặp mặt xã giao; có thể không kèm bữa ăn.",
      "hanzi": "这次聚会在小林家。",
      "pinyin": "Zhè cì jùhuì zài Xiǎo Lín jiā.",
      "meaning": "Buổi tụ họp ở nhà Lâm.",
      "readingMinutes": 1
    },
    {
      "id": "l456-t3",
      "type": "teaching",
      "title": "开玩笑 · nói đùa",
      "text": "开玩笑 là cụm tách được, như 别开他的玩笑; đùa không tự bảo đảm người nghe vui.",
      "hanzi": "请不要拿他的名字开玩笑。",
      "pinyin": "Qǐng bú yào ná tā de míngzi kāi wánxiào.",
      "meaning": "Xin đừng lấy tên anh ấy ra đùa.",
      "readingMinutes": 1
    },
    {
      "id": "l456-t4",
      "type": "teaching",
      "title": "好笑 · buồn cười",
      "text": "好笑 nói điều gây cười; không nhất thiết khen lịch sự hay phù hợp.",
      "hanzi": "这个故事真好笑。",
      "pinyin": "Zhè ge gùshi zhēn hǎoxiào.",
      "meaning": "Chuyện này thật buồn cười.",
      "readingMinutes": 1
    },
    {
      "id": "l456-t5",
      "type": "teaching",
      "title": "陪 · đi cùng, ở bên",
      "text": "陪 + người + hoạt động chỉ có mặt cùng/hỗ trợ, không phải trả tiền thay.",
      "hanzi": "我陪朋友去车站。",
      "pinyin": "Wǒ péi péngyou qù chēzhàn.",
      "meaning": "Tôi đưa bạn đi cùng tới ga.",
      "readingMinutes": 1
    },
    {
      "id": "l456-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "互相 + động từ chỉ hành động qua lại giữa từ hai bên: 大家互相帮助. Chủ ngữ cần có nhiều bên/người; không dùng 我互相帮助 khi chỉ có một mình. Bài luyện hành vi giúp nhau, không áp đặt cảm xúc.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l456-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "同学们周末在小林家聚会，约好一起聚餐。有人讲了一个好笑的故事，大家都笑了。后来有人拿同学的名字开玩笑，对方不高兴。小林提醒：“大家难得聚一聚，要互相尊重。”结束后，他陪外地来的朋友去车站。",
      "pinyin": "Tóngxuémen zhōumò zài Xiǎo Lín jiā jùhuì, yuē hǎo yìqǐ jùcān. Yǒu rén jiǎng le yí ge hǎoxiào de gùshi, dàjiā dōu xiào le. Hòulái yǒu rén ná tóngxué de míngzi kāi wánxiào, duìfāng bù gāoxìng. Xiǎo Lín tíxǐng: “Dàjiā nándé jù yi jù, yào hùxiāng zūnzhòng.” Jiéshù hòu, tā péi wàidì lái de péngyou qù chēzhàn.",
      "meaning": "Nhóm bạn gặp và ăn ở nhà Lâm. Chuyện vui khiến mọi người cười, nhưng đùa tên bạn làm bạn ấy khó chịu. Lâm nhắc tôn trọng nhau rồi đi cùng bạn ở xa tới ga.",
      "readingMinutes": 2
    },
    {
