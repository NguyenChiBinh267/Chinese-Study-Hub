  "blocks": [
    {
      "id": "l162-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Đi theo F01–F05 rồi L001/L002; đọc các bài HSK1 theo thứ tự hiển thị. Có thể luyện nháp khi điều kiện mastery còn thiếu; không tự cấp mastery từ hoàn tất. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l162-t0",
      "type": "teaching",
      "title": "零 · không; số0",
      "text": "零 là số0 khi đếm/đọc số; không dùng nó thay phủ định 不 trong mọi câu.",
      "hanzi": "零、一、二。",
      "pinyin": "Líng, yī, èr.",
      "meaning": "Không, một, hai.",
      "readingMinutes": 1
    },
    {
      "id": "l162-t1",
      "type": "teaching",
      "title": "百 · trăm",
      "text": "百 là trăm; 一百 là100, khác 十 là10.",
      "hanzi": "一百元。",
      "pinyin": "Yì bǎi yuán.",
      "meaning": "Một trăm nguyên trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l162-t2",
      "type": "teaching",
      "title": "千 · nghìn",
      "text": "千 là nghìn; 一千 là1000, không thêm 万 chưa học ở bài này.",
      "hanzi": "一千元。",
      "pinyin": "Yì qiān yuán.",
      "meaning": "Một nghìn nguyên trong ví dụ.",
      "readingMinutes": 1
    },
    {
      "id": "l162-t3",
      "type": "teaching",
      "title": "半 · nửa (dạng một chữ)",
      "text": "半 đứng trước đơn vị ở 半小时; không thay mọi danh từ một nửa bằng cùng một cấu trúc này.",
      "hanzi": "半小时。",
      "pinyin": "Bàn xiǎo shí.",
      "meaning": "Nửa giờ.",
      "readingMinutes": 1
    },
    {
      "id": "l162-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "零=0, 百=100, 千=1000; 一百/一千 là một trăm/một nghìn, không phải lần lượt101/1001. 半 là nửa: 半小时 là nửa giờ, còn 三点半 là3giờ30 trong cách nói đồng hồ. Bài chỉ giới thiệu số/cụm, không suy số tiền thật của người học.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l162-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "A：这本书一百元吗？\nB：不是，是十元。\nA：好，我有十元。",
      "pinyin": "A: Zhè běn shū yì bǎi yuán ma? B: Bú shì, shì shí yuán. A: Hǎo, wǒ yǒu shí yuán.",
      "meaning": "Giá hư cấu được B sửa từ100 xuống10nguyên. Đọc phủ định để không giữ con số trong câu hỏi làm sự thật.",
      "readingMinutes": 2
    },
