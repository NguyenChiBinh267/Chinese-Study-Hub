  "blocks": [
    {
      "id": "l4068-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t0",
      "type": "teaching",
      "title": "对于 · đối với",
      "text": "对于 dẫn đối tượng hoặc phạm vi nhận định.",
      "hanzi": "对于新同事，这份说明很重要。",
      "pinyin": "Duì yú xīn tóng shì, zhè fèn shuō míng hěn zhòng yào.",
      "meaning": "Đối với đồng nghiệp mới, bản hướng dẫn này quan trọng.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t1",
      "type": "teaching",
      "title": "面对 · đối mặt",
      "text": "面对 đặt trước khó khăn/người/tình huống phải tiếp xúc.",
      "hanzi": "我们一起面对困难。",
      "pinyin": "Wǒ men yì qǐ miàn duì kùn nan.",
      "meaning": "Chúng ta cùng đối mặt khó khăn.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t2",
      "type": "teaching",
      "title": "压力 · áp lực",
      "text": "压力 ở đây là cảm giác bị đòi hỏi tiến độ, không phải lực vật lý. Nhận diện chữ 压 trong 压力; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他最近工作压力很大。",
      "pinyin": "Tā zuì jìn gōng zuò yā lì hěn dà.",
      "meaning": "Gần đây áp lực công việc của anh ấy lớn.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t3",
      "type": "teaching",
      "title": "压 · đè; ép",
      "text": "压 trong câu là đặt vật lên để giữ giấy, nghĩa vật lý.",
      "hanzi": "用一本书压住纸。",
      "pinyin": "Yòng yì běn shū yā zhù zhǐ.",
      "meaning": "Dùng quyển sách đè giữ tờ giấy.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t4",
      "type": "teaching",
      "title": "尊重 · tôn trọng",
      "text": "尊重 ý kiến là lắng nghe nghiêm túc, không bắt buộc đồng ý mọi đề xuất.",
      "hanzi": "我们尊重不同的意见。",
      "pinyin": "Wǒ men zūn zhòng bù tóng de yì jiàn.",
      "meaning": "Chúng tôi tôn trọng ý kiến khác nhau.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-t5",
      "type": "teaching",
      "title": "尤其 · đặc biệt là",
      "text": "尤其 nhấn một trường hợp trong phạm vi vừa nêu.",
      "hanzi": "大家都很忙，尤其是新同事。",
      "pinyin": "Dà jiā dōu hěn máng, yóu qí shì xīn tóng shì.",
      "meaning": "Mọi người đều bận, nhất là đồng nghiệp mới.",
      "readingMinutes": 1
    },
    {
      "id": "l4068-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 hạn định một điều đã nói. Đoạn kể lại cách một nhóm phân việc, không suy ra một cách xử lý áp lực phù hợp cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4068-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "风吹乱了纸，小林用书压住纸。对于新同事，清楚的说明尤其重要。大家最近压力很大，不过仍尊重不同意见，决定一起面对困难，把工作分成几项，再确认各自的时间。",
      "pinyin": "Fēng chuī luàn le zhǐ, Xiǎo Lín yòng shū yā zhù zhǐ. Duì yú xīn tóng shì, qīng chu de shuō míng yóu qí zhòng yào. Dà jiā zuì jìn yā lì hěn dà, bú guò réng zūn zhòng bù tóng yì jiàn, jué dìng yì qǐ miàn duì kùn nan, bǎ gōng zuò fēn chéng jǐ xiàng, zài què rèn gè zì de shí jiān.",
      "meaning": "Nhóm chia việc và xác nhận thời gian sau khi trao đổi ý kiến. 压 giấy là nghĩa vật lý.",
      "readingMinutes": 2
    },
    {
