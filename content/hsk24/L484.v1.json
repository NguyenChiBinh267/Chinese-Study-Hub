  "blocks": [
    {
      "id": "l484-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l484-reminder0",
      "type": "teaching",
      "title": "达到 · đạt tới",
      "text": "达到 đi với mức/chỉ tiêu cụ thể, khác 到达 thường nói tới địa điểm. Nhận diện chữ 达 trong 达到; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "他的成绩达到了课程要求。",
      "pinyin": "Tā de chéngjì dádào le kèchéng yāoqiú.",
      "meaning": "Kết quả của anh ấy đã đạt yêu cầu khóa học.",
      "readingMinutes": 1
    },
    {
      "id": "l484-reminder1",
      "type": "teaching",
      "title": "符合 · phù hợp với",
      "text": "符合 nhận tiêu chuẩn/điều kiện, không đi với người theo mọi cách dùng của 合适.",
      "hanzi": "这份申请符合学校的要求。",
      "pinyin": "Zhè fèn shēnqǐng fúhé xuéxiào de yāoqiú.",
      "meaning": "Đơn này phù hợp yêu cầu của trường.",
      "readingMinutes": 1
    },
    {
      "id": "l484-reminder2",
      "type": "teaching",
      "title": "博士 · tiến sĩ",
      "text": "博士 là bậc học/học vị hoặc người có học vị tùy ngữ cảnh; không đồng nghĩa bác sĩ 大夫.",
      "hanzi": "他完成本科后，计划继续读到博士。",
      "pinyin": "Tā wánchéng běnkē hòu, jìhuà jìxù dú dào bóshì.",
