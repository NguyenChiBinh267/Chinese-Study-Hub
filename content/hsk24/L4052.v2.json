  "blocks": [
    {
      "id": "l4052-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. ",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t0",
      "type": "teaching",
      "title": "质量 · chất lượng",
      "text": "质量 chỉ mức độ đáp ứng của sản phẩm, khác số lượng.",
      "hanzi": "我们先检查质量。",
      "pinyin": "Wǒ men xiān jiǎn chá zhì liàng.",
      "meaning": "Chúng tôi kiểm tra chất lượng trước.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t1",
      "type": "teaching",
      "title": "优点 · ưu điểm",
      "text": "优点 là mặt tốt của người/vật, đối lập 缺点.",
      "hanzi": "这款包的优点是轻。",
      "pinyin": "Zhè kuǎn bāo de yōu diǎn shì qīng.",
      "meaning": "Ưu điểm chiếc túi này là nhẹ.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t2",
      "type": "teaching",
      "title": "缺点 · khuyết điểm",
      "text": "缺点 là điểm yếu, không phải thiếu số lượng. Nhận diện chữ 缺 trong 缺点; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "它也有一个缺点。",
      "pinyin": "Tā yě yǒu yí ge quē diǎn.",
      "meaning": "Nó cũng có một khuyết điểm.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t3",
      "type": "teaching",
      "title": "相比 · so với; đem so",
      "text": "相比 thường đi với 跟/与 để nêu đối tượng so sánh.",
      "hanzi": "跟旧款相比，新款更轻。",
      "pinyin": "Gēn jiù kuǎn xiāng bǐ, xīn kuǎn gèng qīng.",
      "meaning": "So với mẫu cũ, mẫu mới nhẹ hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t4",
      "type": "teaching",
      "title": "值得 · đáng để",
      "text": "值得 đi với hành động/việc, khác 值这个价 chỉ giá trị tiền.",
      "hanzi": "这个问题值得讨论。",
      "pinyin": "Zhè ge wèn tí zhí dé tǎo lùn.",
      "meaning": "Vấn đề này đáng thảo luận.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-t5",
      "type": "teaching",
      "title": "假 · giả; không thật",
      "text": "假 đọc jiǎ trong đối lập 真; không đọc jià là nghỉ phép.",
      "hanzi": "不能把假的当成真的。",
      "pinyin": "Bù néng bǎ jiǎ de dàng chéng zhēn de.",
      "meaning": "Không thể coi đồ giả là thật.",
      "readingMinutes": 1
    },
    {
      "id": "l4052-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不过 nối nhận xét giới hạn: món đồ có ưu điểm nhưng vẫn có khuyết điểm. Không hiểu đánh giá nhân vật là chứng nhận chất lượng thật.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l4052-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小李比较两个包的质量。跟旧款相比，新款更轻，这是优点，不过拉链不好拉，是一个缺点。朋友提醒他分清真和假，也想想这些特点是否值得自己多花钱。他们没有把外表当成质量证明。",
      "pinyin": "Xiǎo Lǐ bǐ jiào liǎng ge bāo de zhì liàng. Gēn jiù kuǎn xiāng bǐ, xīn kuǎn gèng qīng, zhè shì yōu diǎn, bú guò lā liàn bù hǎo lā, shì yí ge quē diǎn. Péng you tí xǐng tā fēn qīng zhēn hé jiǎ, yě xiǎng xiang zhè xiē tè diǎn shì fǒu zhí dé zì jǐ duō huā qián. Tā men méi yǒu bǎ wài biǎo dàng chéng zhì liàng zhèng míng.",
      "meaning": "Nhóm so sánh cả điểm tốt lẫn điểm yếu, không suy chất lượng chỉ từ bề ngoài.",
      "readingMinutes": 2
    },
