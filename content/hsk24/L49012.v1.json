  "blocks": [
    {
      "id": "l49012-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ · không phải bài thi",
      "text": "Nên thử nhớ trước khi xem phần nhắc. Các ví dụ và ngữ cảnh được lặp có chủ đích để ôn; không tính thêm từ, không xác nhận năng lực độc lập.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l49012-reminder0",
      "type": "teaching",
      "title": "顺便 · tiện thể",
      "text": "顺便 nói làm thêm việc khi đang làm việc chính.",
      "hanzi": "去图书馆时，我顺便还书。",
      "pinyin": "Qù tú shū guǎn shí, wǒ shùn biàn huán shū.",
      "meaning": "Khi đến thư viện tôi tiện trả sách.",
      "readingMinutes": 1
    },
    {
      "id": "l49012-reminder1",
      "type": "teaching",
      "title": "顺利 · thuận lợi",
      "text": "顺利 mô tả việc tiến triển không gặp trở ngại lớn.",
      "hanzi": "今天的参观很顺利。",
      "pinyin": "Jīn tiān de cān guān hěn shùn lì.",
      "meaning": "Chuyến tham quan hôm nay thuận lợi.",
      "readingMinutes": 1
    },
    {
      "id": "l49012-reminder2",
      "type": "teaching",
      "title": "顺序 · thứ tự",
      "text": "顺序 chỉ việc nào trước sau, không phải tốc độ. Nhận diện chữ 序 trong 顺序; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "请按这个顺序参观。",
      "pinyin": "Qǐng àn zhè ge shùn xù cān guān.",
      "meaning": "Xin tham quan theo thứ tự này.",
      "readingMinutes": 1
    },
    {
      "id": "l49012-reminder3",
      "type": "teaching",
      "title": "首先 · trước tiên",
