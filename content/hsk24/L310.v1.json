  "blocks": [
    {
      "id": "l310-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Nhắc 不/没, 很, số lượng và địa điểm. HSK1/2 chưa hoàn chỉnh; chỉ khám phá DRAFT. 报名 bàomíng: đăng ký; 计划 jìhuà: kế hoạch; 活动 huódòng: hoạt động; 安排 ānpái: sắp xếp (hỗ trợ); 不过 búguò: tuy nhiên. Không tạo hướng dẫn vận động/y khoa.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l310-t0",
      "type": "teaching",
      "title": "锻炼 · rèn luyện/tập luyện",
      "text": "锻炼 chỉ rèn luyện cơ thể hay năng lực tùy tân ngữ. 这次锻炼 dùng trong kế hoạch cá nhân, không là đơn thuốc hay thời lượng khuyến nghị.",
      "hanzi": "我想每天找一点儿时间锻炼。",
      "pinyin": "Wǒ xiǎng měi tiān zhǎo yìdiǎnr shíjiān duànliàn.",
      "meaning": "Tôi muốn tìm một chút thời gian mỗi ngày để tập luyện.",
      "readingMinutes": 1
    },
    {
      "id": "l310-t1",
      "type": "teaching",
      "title": "坚持 · kiên trì/duy trì",
      "text": "坚持 nói tiếp tục làm theo điều đã chọn. Không mặc nhiên diễn tả rằng tiếp tục bất kỳ hoạt động nào cũng phù hợp hoặc tốt.",
      "hanzi": "我想坚持这个学习计划。",
      "pinyin": "Wǒ xiǎng jiānchí zhège xuéxí jìhuà.",
      "meaning": "Tôi muốn duy trì kế hoạch học này.",
      "readingMinutes": 1
    },
    {
      "id": "l310-t2",
      "type": "teaching",
      "title": "必须 · nhất thiết/phải",
      "text": "必须 nhấn việc bắt buộc theo yêu cầu đã nêu. Phải biết ai đặt yêu cầu và phạm vi; không nâng mọi lời khuyên thành luật chung.",
      "hanzi": "老师说，参加活动必须先报名。",
      "pinyin": "Lǎoshī shuō, cānjiā huódòng bìxū xiān bàomíng.",
      "meaning": "Thầy nói tham gia hoạt động phải đăng ký trước.",
      "readingMinutes": 1
    },
    {
      "id": "l310-t3",
      "type": "teaching",
      "title": "不用 · không cần",
      "text": "不用 phủ nhận sự cần thiết, không tự động là cấm. 不用买票 không cần mua vé; khác 不能买票 không được/không thể mua.",
      "hanzi": "这个活动不用买票。",
      "pinyin": "Zhège huódòng búyòng mǎi piào.",
      "meaning": "Hoạt động này không cần mua vé.",
      "readingMinutes": 1
    },
    {
      "id": "l310-t4",
      "type": "teaching",
      "title": "放心 · yên tâm",
      "text": "放心 diễn tả bớt lo vì tin vào điều gì trong ngữ cảnh. Không dùng để bảo đảm rủi ro y tế hoặc điều chưa kiểm chứng.",
      "hanzi": "我到家就给你打电话，你放心吧。",
      "pinyin": "Wǒ dào jiā jiù gěi nǐ dǎ diànhuà, nǐ fàngxīn ba.",
      "meaning": "Tôi về tới nhà sẽ gọi bạn, bạn yên tâm nhé.",
      "readingMinutes": 1
    },
    {
      "id": "l310-t5",
      "type": "teaching",
      "title": "感到 · cảm thấy",
      "text": "感到 đứng trước cảm giác hay nhận xét như 感到累/快乐. Đây là cảm nhận chủ quan, không tự là kết quả đo năng lực hay sức khỏe.",
      "hanzi": "今天我感到有点儿累。",
      "pinyin": "Jīntiān wǒ gǎndào yǒudiǎnr lèi.",
      "meaning": "Hôm nay tôi cảm thấy hơi mệt.",
      "readingMinutes": 1
    },
    {
      "id": "l310-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "不用 là không cần, khác 不能 là không thể/không được. Bài luyện nhánh 不用; 不必 chỉ được đối chiếu như cách nói không cần, chưa có đánh giá riêng.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l310-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小安：我想参加学校的锻炼活动，必须买票吗？小李：不用买票，但必须先报名。小安：我会问清楚活动怎么安排，再决定。小李：这样我就放心了。小安：我希望能坚持，不过今天感到有点儿累。",
      "pinyin": "Xiǎo Ān: Wǒ xiǎng cānjiā xuéxiào de duànliàn huódòng, bìxū mǎi piào ma? Xiǎo Lǐ: Búyòng mǎi piào, dàn bìxū xiān bàomíng. Xiǎo Ān: Wǒ huì wèn qīngchu huódòng zěnme ānpái, zài juédìng. Xiǎo Lǐ: Zhèyàng wǒ jiù fàngxīn le. Xiǎo Ān: Wǒ xīwàng néng jiānchí, búguò jīntiān gǎndào yǒudiǎnr lèi.",
      "meaning": "An hỏi hoạt động luyện tập của trường có cần mua vé. Lý nói không cần vé nhưng phải đăng ký. An sẽ hỏi cách tổ chức rồi quyết định. An muốn duy trì nhưng hôm nay hơi mệt. Chỉ ghi nhận lời kể và quy định của hoạt động hư cấu.",
