  "blocks": [
    {
      "id": "l1155-guide",
      "type": "teaching",
      "title": "Ôn có hỗ trợ",
      "text": "Thử nhớ rồi đọc lại phần nhắc. Đây là ngữ cảnh mới của các nghĩa đã học; hoàn tất luyện không xác nhận mastery. Nhận diện chữ có lựa chọn khác với viết tay. Các từ hỗ trợ đều đã gặp trong nhóm trước.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder0",
      "type": "teaching",
      "title": "您 · ngài; bác; anh/chị (kính trọng)",
      "text": "Từ đã học 您 có 1 chữ. Chữ 您 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 您 với 你 / 悠 / 愁; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "您好！",
      "pinyin": "Nín hǎo!",
      "meaning": "Xin chào bác/anh chị!",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder1",
      "type": "teaching",
      "title": "谢谢 · cảm ơn",
      "text": "Từ đã học 谢谢 có 2 chữ. Chữ 谢 ở vị trí 1, 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 谢 với 射 / 榭 / 讨; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "谢谢您！",
      "pinyin": "Xiè xie nín!",
      "meaning": "Cảm ơn bác/anh chị!",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder2",
      "type": "teaching",
      "title": "不客气 · không có gì; đừng khách sáo",
      "text": "Từ đã học 不客气 có 3 chữ. Chữ 客 ở vị trí 2 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 客 với 各 / 容 / 宫; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "不客气。",
      "pinyin": "Bú kè qi.",
      "meaning": "Không có gì.",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder3",
      "type": "teaching",
      "title": "见 · gặp; thấy (theo ngữ cảnh)",
      "text": "Từ đã học 见 có 1 chữ. Chữ 见 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 见 với 贝 / 觉 / 现; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "我想见老师。",
      "pinyin": "Wǒ xiǎng jiàn lǎo shī.",
      "meaning": "Tôi muốn gặp giáo viên.",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder4",
      "type": "teaching",
      "title": "的 · của; yếu tố nối bổ nghĩa",
      "text": "Từ đã học 的 có 1 chữ. Chữ 的 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 的 với 白 / 约 / 钓; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "这是我的茶。",
      "pinyin": "Zhè shì wǒ de chá.",
      "meaning": "Đây là trà của tôi.",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reminder5",
      "type": "teaching",
      "title": "那 · kia; đó (dạng một chữ)",
      "text": "Từ đã học 那 có 1 chữ. Chữ 那 ở vị trí 1 tính từ trái sang phải; che tất cả vị trí cùng chữ khi tự thử. Giữ nguyên các phần còn lại để nhận đúng từ trong ngữ cảnh. Không suy cách viết tay hay mọi âm của chữ từ một từ này. Đối chiếu hình đầy đủ của chữ 那 với 哪 / 邦 / 人; các chữ khác là phương án nhiễu, không được tính là đã học. Đây là nhận diện sau hướng dẫn; không phải viết tay hoặc nhớ dài hạn độc lập.",
      "hanzi": "那是茶吗？",
      "pinyin": "Nà shì chá ma?",
      "meaning": "Kia là trà phải không?",
      "readingMinutes": 1
    },
    {
      "id": "l1155-reading",
      "type": "teaching",
      "title": "Tình huống ôn mới",
      "text": "Đọc toàn bộ lời đáp, kể cả phần phủ định. Đây là đọc chữ, chưa có audio tham chiếu được duyệt.",
      "hanzi": "A：你买什么？\nB：我买这个杯子。\nA：多少钱？\nB：五元。",
      "pinyin": "A: Nǐ mǎi shén me? B: Wǒ mǎi zhè ge bēi zi. A: Duō shao qián? B: Wǔ yuán.",
      "meaning": "B chọn chiếc cốc này, giá hư cấu5nguyên.",
      "readingMinutes": 2
    },
