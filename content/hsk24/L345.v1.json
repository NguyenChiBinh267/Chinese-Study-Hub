  "blocks": [
    {
      "id": "l345-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn chủ ngữ–động từ–tân ngữ, thời gian trước động từ, 的 nối định ngữ, không có 的 trước tân ngữ thường. HSK1/2 chưa hoàn tất và không tự cấp mastery. 袖子 xiùzi: tay áo; 价格 jiàgé: giá; 试 shì: thử. So kích cỡ khác so giá, không suy ra lựa chọn tối ưu từ một tiêu chí.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l345-t0",
      "type": "teaching",
      "title": "比较 · so sánh; tương đối",
      "text": "比较 trong 比较两件衣服 là so sánh; 比较合适 là tương đối phù hợp. Cần nhìn vị trí để phân biệt chức năng.",
      "hanzi": "我们先比较两件衣服。",
      "pinyin": "Wǒmen xiān bǐjiào liǎng jiàn yīfu.",
      "meaning": "Chúng tôi so sánh hai chiếc áo trước.",
      "readingMinutes": 1
    },
    {
      "id": "l345-t1",
      "type": "teaching",
      "title": "更 · hơn/càng (tăng mức độ)",
      "text": "更 đứng trước tính từ/động từ trạng thái để tăng mức so mốc có sẵn, không đặt sau tính từ như hậu tố.",
      "hanzi": "这件上衣更合适。",
      "pinyin": "Zhè jiàn shàngyī gèng héshì.",
      "meaning": "Chiếc áo này phù hợp hơn.",
      "readingMinutes": 1
    },
    {
      "id": "l345-t2",
      "type": "teaching",
      "title": "合适 · phù hợp/vừa",
      "text": "合适 nói phù hợp người, mục đích hay kích cỡ. 很合适 không có nghĩa giống nhau hay đắt/rẻ.",
      "hanzi": "这双鞋大小很合适。",
      "pinyin": "Zhè shuāng xié dàxiǎo hěn héshì.",
      "meaning": "Đôi giày này có kích cỡ rất vừa.",
      "readingMinutes": 1
    },
    {
      "id": "l345-t3",
      "type": "teaching",
      "title": "满意 · hài lòng",
      "text": "满意 thường đi với 对 để nêu đối tượng: 对…满意. Hài lòng là đánh giá của chủ thể, chưa là đánh giá độc lập.",
      "hanzi": "我对这件衣服很满意。",
      "pinyin": "Wǒ duì zhè jiàn yīfu hěn mǎnyì.",
      "meaning": "Tôi rất hài lòng với chiếc áo này.",
      "readingMinutes": 1
    },
    {
      "id": "l345-t4",
      "type": "teaching",
      "title": "短 · ngắn",
      "text": "短 đối chiếu 长 về độ dài, cũng dùng thời lượng. 袖子短不等于整件衣服小; tiêu chí khác nhau.",
      "hanzi": "这条裤子有点儿短。",
      "pinyin": "Zhè tiáo kùzi yǒudiǎnr duǎn.",
      "meaning": "Chiếc quần này hơi ngắn.",
      "readingMinutes": 1
    },
    {
      "id": "l345-t5",
      "type": "teaching",
      "title": "大小 · kích cỡ/độ lớn",
      "text": "大小 là danh từ kích thước; 鞋的大小 nêu cỡ giày. Không hiểu thành “lớn nhỏ” luôn là hai lựa chọn tách rời.",
      "hanzi": "请看看鞋的大小。",
      "pinyin": "Qǐng kànkan xié de dàxiǎo.",
      "meaning": "Hãy xem kích cỡ giày.",
      "readingMinutes": 1
    },
    {
      "id": "l345-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "比较 có thể là so sánh (động từ) hoặc tương đối (phó từ). 更 + tính từ tăng mức độ so với mốc: 这件更合适. Hợp cỡ chưa đồng nghĩa mọi tiêu chí đều tốt.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l345-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "小林先比较两双鞋的大小。第一双有点儿短，第二双更合适，他很满意。朋友问价格，他说：我只试了大小，还没比较价格，所以现在不能说哪双更便宜。",
      "pinyin": "Xiǎo Lín xiān bǐjiào liǎng shuāng xié de dàxiǎo. Dì yī shuāng yǒudiǎnr duǎn, dì èr shuāng gèng héshì, tā hěn mǎnyì. Péngyou wèn jiàgé, tā shuō: Wǒ zhǐ shì le dàxiǎo, hái méi bǐjiào jiàgé, suǒyǐ xiànzài bù néng shuō nǎ shuāng gèng piányi.",
      "meaning": "Lâm so hai đôi giày. Đôi đầu hơi ngắn, đôi thứ hai vừa hơn nên hài lòng; cậu chưa so giá nên chưa biết đôi nào rẻ hơn.",
      "readingMinutes": 2
    },
    {
