  "blocks": [
    {
      "id": "l479-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 按钮 ànniǔ: nút; 铅笔 qiānbǐ: bút chì; 线条 xiàntiáo: nét; 挡住 dǎng zhù: che; 电子版 diànzǐbǎn: bản điện tử.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l479-t0",
      "type": "teaching",
      "title": "按 · ấn; theo",
      "text": "按 trong 按按钮 là ấn, 按说明 là theo chỉ dẫn; bài dạy cả hai ngữ cảnh tách rõ.",
      "hanzi": "请按这个按钮。",
      "pinyin": "Qǐng àn zhè ge ànniǔ.",
      "meaning": "Hãy ấn nút này.",
      "readingMinutes": 1
    },
    {
      "id": "l479-t1",
      "type": "teaching",
      "title": "擦 · lau, xóa bằng chà",
      "text": "擦 dùng để lau/xóa bằng ma sát, như 擦桌子、擦掉铅笔字.",
      "hanzi": "先把桌子擦干净。",
      "pinyin": "Xiān bǎ zhuōzi cā gānjìng.",
      "meaning": "Hãy lau bàn sạch trước.",
      "readingMinutes": 1
    },
    {
      "id": "l479-t2",
      "type": "teaching",
      "title": "重 · lại, làm lại",
      "text": "重 chóng trong 重写 là lại; khác zhòng nặng. Bài không dạy nghĩa nặng.",
      "hanzi": "写错以后可以重写。",
      "pinyin": "Xiě cuò yǐhòu kěyǐ chóng xiě.",
      "meaning": "Viết sai có thể viết lại.",
      "readingMinutes": 1
    },
    {
      "id": "l479-t3",
      "type": "teaching",
      "title": "粗 · thô, to nét",
      "text": "粗 ở 笔太粗 chỉ nét/ngòi to; khác 粗心 là bất cẩn.",
      "hanzi": "这支笔画出的线很粗。",
      "pinyin": "Zhè zhī bǐ huà chū de xiàn hěn cū.",
      "meaning": "Bút này vẽ nét rất to.",
      "readingMinutes": 1
    },
    {
      "id": "l479-t4",
      "type": "teaching",
      "title": "幅 · bức (lượng từ)",
      "text": "幅 đếm bức tranh/cuộn thư pháp; không phải từ chỉ cái hộp. Nhận diện chữ 幅 trong 幅; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "墙上挂着一幅画。",
      "pinyin": "Qiáng shàng guàzhe yì fú huà.",
      "meaning": "Tường treo một bức tranh.",
      "readingMinutes": 1
    },
    {
      "id": "l479-t5",
      "type": "teaching",
      "title": "棵 · cây (lượng từ)",
      "text": "棵 đếm cây có thân/gốc trong phạm vi này; không dùng đếm bức tranh.",
      "hanzi": "画里有一棵树。",
      "pinyin": "Huà lǐ yǒu yì kē shù.",
      "meaning": "Trong tranh có một cây.",
      "readingMinutes": 1
    },
    {
      "id": "l479-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "幅 đếm tranh/thư pháp: 一幅画; 棵 đếm cây: 一棵树. Không dùng 个 thay mọi lượng từ trong bài mục tiêu. Một tờ giấy 张 giấy có thể mang một bức tranh 幅画, cần xem danh từ theo sau.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l479-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "美术课上，学生按说明画一幅画，画里要有一棵树。小白的笔太粗，线条挡住了树叶。他先擦掉几条线，再重写旁边的说明。老师提醒保存电子版时先按按钮确认，“重写”的“重”读chóng，不读zhòng。",
      "pinyin": "Měishù kè shàng, xuésheng àn shuōmíng huà yì fú huà, huà lǐ yào yǒu yì kē shù. Xiǎo Bái de bǐ tài cū, xiàntiáo dǎng zhù le shùyè. Tā xiān cā diào jǐ tiáo xiàn, zài chóng xiě pángbiān de shuōmíng. Lǎoshī tíxǐng bǎocún diànzǐbǎn shí xiān àn ànniǔ quèrèn, “chóng xiě” de “chóng” dú chóng, bù dú zhòng.",
      "meaning": "Lớp vẽ một tranh có cây. Bạch dùng bút nét to che lá, xóa vài nét rồi viết lại chú thích. Thầy nhắc xác nhận khi lưu bản điện tử và phân biệt chóng làm lại với zhòng nặng.",
      "readingMinutes": 2
    },
    {
