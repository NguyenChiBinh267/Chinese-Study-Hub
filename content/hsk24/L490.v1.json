  "blocks": [
    {
      "id": "l490-prereq",
      "type": "teaching",
      "title": "Kiến thức cần nhắc lại",
      "text": "Ôn L401–404, trật tự chủ ngữ–thời gian–động từ–tân ngữ, 了, 的 và câu 把. HSK1–3 còn thiếu kỹ năng; đây là luyện nháp, không tự cấp mastery. 保持 bǎochí: giữ; 提示 tíshì: lời nhắc; 模仿 mófǎng: bắt chước; 厉害 lìhai: mức độ mạnh/giỏi tùy kết hợp.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l490-t0",
      "type": "teaching",
      "title": "步 · bước",
      "text": "步 chỉ bước đi hoặc bước quy trình, như 第一步; không phải 不 phủ định.",
      "hanzi": "第一步先看示范。",
      "pinyin": "Dì yī bù xiān kàn shìfàn.",
      "meaning": "Bước đầu xem làm mẫu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l490-t1",
      "type": "teaching",
      "title": "功夫 · công phu, võ thuật",
      "text": "功夫 trong bài là võ thuật/khả năng tập luyện; còn nghĩa thời gian chưa luyện.",
      "hanzi": "他学过一年功夫。",
      "pinyin": "Tā xué guo yì nián gōngfu.",
      "meaning": "Anh từng học võ một năm.",
      "readingMinutes": 1
    },
    {
      "id": "l490-t2",
      "type": "teaching",
      "title": "好好 · cho tốt, cẩn thận",
      "text": "好好 bổ nghĩa động từ, chỉ làm nghiêm túc/tốt; không phải hai lời chào.",
      "hanzi": "请先好好看示范。",
      "pinyin": "Qǐng xiān hǎohǎo kàn shìfàn.",
      "meaning": "Hãy xem kỹ phần làm mẫu trước.",
      "readingMinutes": 1
    },
    {
      "id": "l490-t3",
      "type": "teaching",
      "title": "棒 · giỏi, tuyệt",
      "text": "棒 bàng là lời khen trong bài; nghĩa cái gậy chưa dạy. Nhận diện chữ 棒 trong 棒; bài luyện nhận diện có hỗ trợ nghĩa/pinyin, chưa kiểm tra viết tay.",
      "hanzi": "你今天的表现真棒。",
      "pinyin": "Nǐ jīntiān de biǎoxiàn zhēn bàng.",
      "meaning": "Hôm nay bạn thể hiện tuyệt.",
      "readingMinutes": 1
    },
    {
      "id": "l490-t4",
      "type": "teaching",
      "title": "啊 · a, ôi (cảm thán)",
      "text": "啊 mục nguồn ā thể hiện cảm thán ngạc nhiên trong ví dụ; ngữ điệu có biến thể, không học như từ có nghĩa đồ vật.",
      "hanzi": "啊，这里真美！",
      "pinyin": "Ā, zhèlǐ zhēn měi!",
      "meaning": "Ôi, ở đây đẹp thật!",
      "readingMinutes": 1
    },
    {
      "id": "l490-t5",
      "type": "teaching",
      "title": "此 · này (văn viết)",
      "text": "此 đứng trước danh từ như 此处、此事; trang trọng hơn 这 trong ngữ cảnh ghi chú.",
      "hanzi": "此处请保持安静。",
      "pinyin": "Cǐ chù qǐng bǎochí ānjìng.",
      "meaning": "Chỗ này xin giữ yên lặng.",
      "readingMinutes": 1
    },
    {
      "id": "l490-grammar",
      "type": "teaching",
      "title": "Cách nói trong ngữ cảnh",
      "text": "Tính từ + 得厉害 nhấn mạnh mức độ cao: 他累得厉害. Không hiểu 厉害 luôn là giỏi trong mọi kết hợp. Bài chỉ luyện cách tả mệt, không khẳng định mức vận động thích hợp cho mọi người.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l490-reading",
      "type": "teaching",
      "title": "Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "看完功夫表演，小石说：“啊，今天的表现真棒！”他想学一个动作，教练请他第一步先好好看示范。旁边的提示写着“此处请保持安静”。一位队员表演后累得厉害，先坐下休息。小石没有因为动作好看就马上模仿。",
      "pinyin": "Kàn wán gōngfu biǎoyǎn, Xiǎo Shí shuō: “Ā, jīntiān de biǎoxiàn zhēn bàng!” Tā xiǎng xué yí ge dòngzuò, jiàoliàn qǐng tā dì yī bù xiān hǎohǎo kàn shìfàn. Pángbiān de tíshì xiězhe “cǐ chù qǐng bǎochí ānjìng”. Yí wèi duìyuán biǎoyǎn hòu lèi de lìhai, xiān zuò xià xiūxi. Xiǎo Shí méiyǒu yīnwèi dòngzuò hǎokàn jiù mǎshàng mófǎng.",
      "meaning": "Thạch khen biểu diễn võ. Muốn học, cậu được yêu cầu xem mẫu trước. Có bảng nhắc yên lặng. Một đội viên mệt sau diễn nên ngồi nghỉ; cậu chưa bắt chước ngay.",
      "readingMinutes": 2
    },
    {
