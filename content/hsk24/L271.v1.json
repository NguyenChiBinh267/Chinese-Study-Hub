  "blocks": [
    {
      "id": "l271-guide",
      "type": "teaching",
      "title": "Ôn tập sau bài",
      "text": "Hãy nghỉ rồi quay lại làm trước khi mở lại gợi ý. Có thể xem phần nhắc lại, vì vậy đây là luyện tập có hỗ trợ, không phải điểm năng lực độc lập. Nghe, nói và viết tự do chưa được đánh giá.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-prereq",
      "type": "teaching",
      "title": "Nhắc lại · Kiến thức cần nhắc lại",
      "text": "今天/明天 chỉ hôm nay/ngày mai; 来 là đến. Câu có 可能 chưa phải xác nhận chắc chắn sẽ xảy ra.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t0",
      "type": "teaching",
      "title": "Nhắc lại · 可能 · có thể, có khả năng",
      "text": "可能 trong câu là tình thái có thể xảy ra; không đồng nghĩa chắc chắn hoặc được cho phép trong mọi câu.",
      "hanzi": "我明天可能来。",
      "pinyin": "Wǒ míngtiān kěnéng lái.",
      "meaning": "Ngày mai tôi có thể đến.",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t1",
      "type": "teaching",
      "title": "Nhắc lại · 希望 · hy vọng, mong muốn",
      "text": "希望 nêu mong muốn, không bảo đảm kết quả. Tôi mong bạn đến không có nghĩa bạn đã đồng ý đến.",
      "hanzi": "我希望你明天来。",
      "pinyin": "Wǒ xīwàng nǐ míngtiān lái.",
      "meaning": "Tôi mong bạn đến ngày mai.",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t2",
      "type": "teaching",
      "title": "Nhắc lại · 还是 · hay, nối phương án trong câu hỏi",
      "text": "Bài dạy 还是 nối lựa chọn, không dạy nghĩa vẫn/còn trong ngữ cảnh khác. Thường trả lời bằng phương án đã chọn.",
      "hanzi": "你今天来还是明天来？",
      "pinyin": "Nǐ jīntiān lái háishi míngtiān lái?",
      "meaning": "Bạn đến hôm nay hay ngày mai?",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t3",
      "type": "teaching",
      "title": "Nhắc lại · 但 · nhưng",
      "text": "但 là liên từ nối ý tương phản, nghĩa gần 但是 trong ví dụ này. Không mở rộng nghĩa phó từ cấp cao hơn theo chú thích nguồn.",
      "hanzi": "我想来，但今天没有时间。",
      "pinyin": "Wǒ xiǎng lái, dàn jīntiān méiyǒu shíjiān.",
      "meaning": "Tôi muốn đến nhưng hôm nay không có thời gian.",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t4",
      "type": "teaching",
      "title": "Nhắc lại · 等 · đợi",
      "text": "等1 ở đây là động từ đợi ai hoặc đợi một lúc. Không dùng nghĩa giới từ như đến khi thuộc cấp khác để trả lời.",
      "hanzi": "我在门口等你。",
      "pinyin": "Wǒ zài ménkǒu děng nǐ.",
      "meaning": "Tôi đợi bạn ở cửa.",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-t5",
      "type": "teaching",
      "title": "Nhắc lại · 啊 · trợ từ thể hiện giọng hỏi/cảm thán",
      "text": "啊 trong 你明天来啊 bổ sung sắc thái xác nhận/nhắc. Nó không phải mục từ mang nghĩa lịch cụ thể; bài dùng cách ghi a của từ điển, không chấm các biến âm nối lời.",
      "hanzi": "你明天来啊？",
      "pinyin": "Nǐ míngtiān lái a?",
      "meaning": "Bạn đến ngày mai à?",
      "readingMinutes": 1
    },
    {
      "id": "l271-t0-l231-grammar",
      "type": "teaching",
      "title": "Nhắc lại · Cách nói trong ngữ cảnh",
      "text": "可能 biểu đạt khả năng, chưa chắc chắn. Trong lịch hẹn 我可能明天来 không tự biến thành cam kết ngày mai; 还是 trong câu hỏi yêu cầu chọn giữa hai phương án.",
      "hanzi": "",
      "pinyin": "",
      "meaning": "",
      "readingMinutes": 2
    },
    {
      "id": "l271-t0-l231-reading",
      "type": "teaching",
      "title": "Nhắc lại · Đọc và hiểu tình huống",
      "text": "Đọc lời từng người; chỉ trả lời theo thông tin trong đoạn. Chưa có audio tham chiếu, đây là luyện đọc.",
      "hanzi": "甲：你今天来还是明天来？乙：我想今天来，但还有工作。我可能明天来。甲：好，我希望你上午来。我在门口等你。乙：好，明天再说。",
      "pinyin": "Jiǎ: Nǐ jīntiān lái háishi míngtiān lái? Yǐ: Wǒ xiǎng jīntiān lái, dàn hái yǒu gōngzuò. Wǒ kěnéng míngtiān lái. Jiǎ: Hǎo, wǒ xīwàng nǐ shàngwǔ lái. Wǒ zài ménkǒu děng nǐ. Yǐ: Hǎo, míngtiān zài shuō.",
      "meaning": "A: Bạn đến hôm nay hay ngày mai? B: Tôi muốn đến hôm nay nhưng còn việc. Có thể mai tôi đến. A: Được, tôi mong bạn đến buổi sáng. Tôi đợi bạn ở cửa. B: Được, mai nói tiếp.",
      "readingMinutes": 2
    },
