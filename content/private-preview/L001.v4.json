  "blocks": [
    {
      "id": "l001-private-v4-b1",
      "type": "teaching",
      "title": "Gặp nhau và nói tên",
      "text": "Hội thoại gốc: A chào và giới thiệu; B đáp lời chào. 安 là tên riêng minh họa bổ trợ, không được tính vào coverage HSK1. Pinyin ghi dạng từ điển; nghe và phát âm chưa được đánh giá.",
      "hanzi": "A：你好！我叫安。\nB：你好！",
      "pinyin": "A: Nǐ hǎo! Wǒ jiào Ān.\nB: Nǐ hǎo!",
      "meaning": "A: Xin chào! Tôi tên là An.\nB: Xin chào!",
      "readingMinutes": 2
    },
    {
      "id": "l001-private-v4-b2",
      "type": "exercise",
      "exerciseVersionId": "l001-private-v4-e1"
    },
    {
      "id": "l001-private-v4-b3",
      "type": "teaching",
      "title": "Mẫu 我叫 + tên",
      "text": "我 là tôi; 叫 ở đây dùng khi nói tên mình. Thứ tự là người nói + 叫 + tên. Không đảo vị trí tên lên trước 我. Bài tập dùng tên 安 để có một đáp án rõ ràng, không chấm tên riêng tự do.",
      "hanzi": "我叫安。",
      "pinyin": "Wǒ jiào Ān.",
      "meaning": "Tôi tên là An.",
      "readingMinutes": 2
    },
    {
      "id": "l001-private-v4-b4",
      "type": "exercise",
      "exerciseVersionId": "l001-private-v4-e2"
    },
    {
      "id": "l001-private-v4-b5",
      "type": "exercise",
      "exerciseVersionId": "l001-private-v4-e3"
    },
    {
      "id": "l001-private-v4-b6",
      "type": "exercise",
      "exerciseVersionId": "l001-private-v4-e4"
    },
    {
      "id": "l001-private-v4-b7",
      "type": "teaching",
      "title": "Hỏi lại trong cùng ngữ cảnh",
      "text": "Sau khi giới thiệu tên, A hỏi 你呢？ để mời người kia nói về mình. 呢 là trợ từ trong cấu trúc đang học. Câu hỏi này phụ thuộc ngữ cảnh; bản nháp không khẳng định nó dùng giống nhau trong mọi tình huống.",
      "hanzi": "A：我叫安。你呢？",
      "pinyin": "A: Wǒ jiào Ān. Nǐ ne?",
      "meaning": "A: Tôi tên là An. Còn bạn thì sao?",
      "readingMinutes": 2
    },
    {
      "id": "l001-private-v4-b8",
      "type": "exercise",
      "exerciseVersionId": "l001-private-v4-e5"
    },
    {
      "id": "l001-private-v4-b9",
