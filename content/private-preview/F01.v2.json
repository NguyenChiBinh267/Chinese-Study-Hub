  "blocks": [
    {
      "id": "f01-private-v2-b1",
      "type": "teaching",
      "title": "Pinyin là chiếc cầu để đọc chữ",
      "text": "Chữ Hán biểu thị đơn vị ngôn ngữ; pinyin dùng chữ cái Latin và dấu thanh để ghi cách đọc tiếng Phổ thông. Nghĩa tiếng Việt là một phần riêng. Đọc mā không phải đọc theo quy tắc chữ Việt. Trong bài này mình quan sát ký hiệu, chưa kết luận bạn phát âm đúng.",
      "hanzi": "妈",
      "pinyin": "mā",
      "meaning": "mẹ",
      "readingMinutes": 2
    },
    {
      "id": "f01-private-v2-b2",
      "type": "teaching",
      "title": "Tách phần đầu và phần vần",
      "text": "Trong mā, phần đầu viết là m và phần vần là a; dấu ngang đặt trên a. Trong nǐ, phần đầu viết là n và phần vần là i. Không phải âm tiết nào cũng có phụ âm đầu viết ra; ta bắt đầu bằng hai ví dụ đơn giản này.",
      "hanzi": "你",
      "pinyin": "Nǐ",
      "meaning": "bạn",
      "readingMinutes": 2
    },
    {
      "id": "f01-private-v2-e1-block",
      "type": "exercise",
      "exerciseVersionId": "f01-private-v2-e1"
    },
    {
      "id": "f01-private-v2-e2-block",
      "type": "exercise",
      "exerciseVersionId": "f01-private-v2-e2"
    },
    {
      "id": "f01-private-v2-b5",
      "type": "teaching",
      "title": "Đọc cấu tạo thay vì đảo chữ",
      "text": "nǐ có cấu tạo n + i, không phải i + n. Chỉ cần nhận ra thứ tự của ký hiệu trong ví dụ đã học. Chữ 你 có pinyin từ điển nǐ; dấu ǎ/ǐ là dấu thanh 3. Việc nghe và thực hiện thanh sẽ cần mẫu âm được duyệt.",
      "hanzi": "你",
      "pinyin": "Nǐ",
      "meaning": "bạn",
      "readingMinutes": 2
    },
    {
      "id": "f01-private-v2-e3-block",
      "type": "exercise",
      "exerciseVersionId": "f01-private-v2-e3"
    },
    {
      "id": "f01-private-v2-e4-block",
      "type": "exercise",
      "exerciseVersionId": "f01-private-v2-e4"
    },
    {
      "id": "f01-private-v2-b8",
      "type": "teaching",
      "title": "Thử gõ ký hiệu",
      "text": "Bạn có thể nhập nǐ hoặc ni3; server sẽ giữ thông tin thanh, không bỏ dấu để chấm. Chữ ü khác u. Trong ô nhập của ứng dụng, v được nhận như cách gõ thay ü: nv3 tương ứng nǚ. Đây chỉ là quy ước nhập liệu, không phải phát âm chữ v tiếng Việt.",
      "hanzi": "女",
      "pinyin": "nǚ",
      "meaning": "nữ",
      "readingMinutes": 2
    },
    {
      "id": "f01-private-v2-e5-block",
