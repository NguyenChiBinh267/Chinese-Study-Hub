{
  "name": "chinese-study-hub",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "prepare:local": "node benchmarks/cloud-proof/prepare-shared.mjs",
    "pretypecheck": "npm run prepare:local && next typegen",
    "prebuild": "npm run prepare:local",
    "dev": "next dev --no-server-fast-refresh --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint src tests scripts/local-db.mjs scripts/test-local-db.mjs scripts/seed-content.ts scripts/validate-content-assets.ts scripts/verify-content-restart.ts scripts/verify-sprint5-restart.ts scripts/phase4-preserve.mjs scripts/author-phase4.mjs scripts/author-sprint5.ts scripts/sprint5-preserve.mjs scripts/sprint6-preserve.mjs scripts/sprint6-install-check.mjs scripts/seed-curriculum.ts scripts/export-review-packets.ts scripts/pronunciation-preserve.mjs scripts/export-pronunciation-review.ts scripts/sprint8-preserve.mjs playwright*.ts next.config.ts",
    "format": "prettier --write src tests *.ts *.mjs package.json tsconfig.json",
    "format:check": "prettier --check src tests *.ts *.mjs package.json tsconfig.json scripts/auth-technical-db.mjs scripts/auth-technical-db.d.mts scripts/export-release-review.ts scripts/verify-auth-release.mjs scripts/content-release.ts scripts/release-test-db.ts scripts/verify-content-release.mjs",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "db:init": "node scripts/local-db.mjs init",
    "db:start": "node scripts/local-db.mjs start",
    "db:stop": "node scripts/local-db.mjs stop",
    "db:migrate": "node scripts/local-db.mjs migrate",
    "db:rollback": "node scripts/local-db.mjs rollback",
    "test:db": "node scripts/test-local-db.mjs",
    "test:local": "playwright test --config playwright.local.config.ts",
    "test:learning:unit": "tsx --test tests/unit/learning.test.ts",
    "test:learning:browser": "playwright test --config playwright.learning.config.ts",
    "db:content": "tsx scripts/seed-content.ts",
    "test:content:unit": "tsx --test tests/unit/content.test.ts",
    "test:content:browser": "playwright test --config playwright.content.config.ts",
    "test:weekly:unit": "tsx --test tests/unit/weekly-plan.test.ts",
    "test:sprint5:browser": "playwright test --config playwright.sprint5.config.ts",
    "db:curriculum": "tsx scripts/seed-curriculum.ts",
    "test:curriculum:unit": "tsx --test tests/unit/curriculum.test.ts",
    "test:sprint6:browser": "playwright test --config playwright.sprint6.config.ts",
    "review:packets": "tsx scripts/export-review-packets.ts",
    "test:pronunciation:unit": "tsx --test tests/unit/pronunciation.test.ts tests/unit/practice-recorder.test.ts",
    "test:sprint7:browser": "playwright test --config playwright.sprint7.config.ts",
    "review:pronunciation": "tsx scripts/export-pronunciation-review.ts",
    "test:acoustic:unit": "tsx --test tests/unit/acoustic.test.ts tests/unit/acoustic-conditioning.test.ts tests/unit/acoustic-noise.test.ts tests/unit/utterance-playback.test.ts",
    "test:sprint8:browser": "playwright test --config playwright.sprint8.config.ts",
    "test:sprint9:browser": "playwright test --config playwright.sprint9.config.ts",
    "test:pilot:unit": "tsx --test tests/unit/pilot.test.ts",
    "auth:local:start": "node scripts/auth-local.mjs start",
    "auth:local:stop": "node scripts/auth-local.mjs stop",
    "auth:local:preview": "node scripts/auth-local-preview.mjs",
    "test:auth:provider": "node scripts/test-auth-provider.mjs",
    "test:auth:unit": "tsx --test tests/unit/auth.test.ts",
    "test:sprint10:browser": "playwright test --config playwright.sprint10.config.ts",
    "security:preflight": "node --conditions=react-server --import tsx scripts/security-preflight.ts",
    "lint:security": "eslint src/modules/auth src/proxy.ts src/instrumentation.ts scripts/auth-local*.mjs scripts/test-auth-provider.mjs scripts/test-production-startup.mjs scripts/security-preflight.ts scripts/sprint10-preserve.mjs scripts/check-client-isolation.mjs tests/sprint10-browser tests/unit/auth.test.ts",
    "test:production:startup": "node scripts/test-production-startup.mjs",
    "auth:technical:init": "node scripts/auth-technical-db.mjs",
    "auth:technical:preview": "node scripts/auth-local-preview.mjs --technical",
    "test:auth:technical-db": "tsx --test tests/database/auth-technical.test.ts",
    "test:sprint11:browser": "playwright test --config playwright.sprint11.config.ts",
    "test:auth:release": "node scripts/verify-auth-release.mjs",
    "review:release": "tsx scripts/export-release-review.ts",
    "lint:sprint11": "eslint src/modules/auth scripts/auth-technical-db.mjs scripts/export-release-review.ts scripts/verify-auth-release.mjs tests/database/auth-technical.test.ts tests/sprint11-browser playwright.sprint11.config.ts",
    "content:release": "tsx scripts/content-release.ts",
    "content:release:test-init": "tsx scripts/release-test-db.ts",
    "content:release:preview": "node scripts/auth-local-preview.mjs --published-test",
    "test:release:unit": "tsx --test tests/unit/content-release.test.ts",
    "test:release:db": "tsx --test tests/database/content-release.test.ts",
    "test:sprint12:browser": "playwright test --config playwright.sprint12.config.ts",
    "lint:sprint12": "eslint src tests scripts/content-release.ts scripts/release-test-db.ts playwright.sprint12.config.ts scripts/verify-content-release.mjs",
    "test:release:auth": "node scripts/verify-content-release.mjs",
    "private:preview:init": "tsx scripts/private-preview-db.ts",
    "private:preview": "node scripts/private-preview-start.mjs",
    "test:private:unit": "tsx --test tests/unit/private-preview.test.ts",
    "test:private:db": "tsx --test tests/database/private-preview.test.ts",
    "test:private:browser": "playwright test --config playwright.private.config.ts",
    "test:private": "node scripts/verify-private-preview.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "fft.js": "4.0.4",
    "lucide-react": "^0.577.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "pitchy": "4.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "ts-fsrs": "5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
