# npm run db:init generates .env.local with random credentials. Do not commit it.
CSH_LOCAL_DATABASE=1
CSH_APP_ORIGIN=http://127.0.0.1:3000
CSH_LOCAL_OWNER_ID=10000000-0000-4000-8000-000000000001
CSH_LOCAL_SESSION_SECRET=generate_a_random_64_character_secret_locally
DATABASE_URL=postgresql://csh_runtime:LOCAL_GENERATED_PASSWORD@127.0.0.1:5447/csh_local
# This identity is forcibly disabled whenever NODE_ENV is not development.
# Optional explicit local mode. Never use it for a production artifact:
# CSH_APP_MODE=LOCAL_DATABASE_DEV
# Production server-only settings (do not provision cloud before T068/owner approval):
# CSH_APP_MODE=PRODUCTION_AUTHENTICATED
# CSH_APP_ORIGIN=https://your-approved-host.example
# CSH_AUTH_URL=https://your-project.supabase.co
# CSH_AUTH_PUBLISHABLE_KEY=your_publishable_or_anon_key
# OWNER_USER_ID=exact_verified_owner_uuid
# DATABASE_URL=runtime_role_url_with_sslmode_verify_full
# Remove all CSH_LOCAL_* identity flags from the production environment.
# Never add service-role/admin keys or NEXT_PUBLIC server credentials.
